<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.footer_copyright_company_name"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">
                    Copyright © FC Apex</span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="header_social_links" model="ir.ui.view">
        <field name="name">Custom - Header Social Links</field>
        <field name="key">website.header_social_links</field>
        <field name="inherit_id" ref="website.placeholder_header_social_links"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="o_header_social_links #{_div_class}" class="o_header_social_links">
                        <div class="s_social_media o_not_editable oe_unmovable oe_unremovable" data-snippet="s_social_media" data-name="Social Media">
                            <h5 class="s_social_media_title d-none">Follow us</h5>
                            <a href="https://www.facebook.com/fcapex" class="s_social_media_facebook o_nav-link_secondary nav-link m-0 p-0 text-decoration-none" target="_blank" aria-label="Facebook">
                                <i class="fa fa-facebook fa-stack p-1 o_editable_media" style="color: rgb(245, 181, 72);"/>
                            </a>
                            <a href="https://www.instagram.com/fcapex" class="s_social_media_instagram o_nav-link_secondary nav-link m-0 p-0 text-decoration-none" target="_blank" aria-label="Instagram">
                                <i class="fa fa-instagram fa-stack p-1 o_editable_media" style="color: rgb(245, 181, 72);"/>
                            </a>
                        </div>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_mega_links" model="ir.ui.view">
        <field name="name">Custom - Mega Links</field>
        <field name="key">website.template_footer_mega_links</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pb16 pt48" data-snippet="s_text_block" data-name="Top Part" style="position: relative;">
                        <div class="container">
                            <div class="row o_grid_mode" data-row-count="8">
                                <div class="o_colored_level o_grid_item g-col-lg-2 o_grid_item_image col-6 g-height-3 col-lg-2 order-lg-0" style="z-index: 2; grid-area: 1 / 1 / 4 / 3; order: 0;"><img src="/web/image/team_sports_club.img_custom_image_40" alt="" class="img img-fluid o_we_custom_image o_editable_media o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/></div><div class="o_colored_level o_grid_item g-col-lg-2 o_grid_item_image col-6 g-height-3 col-lg-2 order-lg-0" style="z-index: 3; grid-area: 1 / 3 / 4 / 5; order: 1;"><img src="/web/image/team_sports_club.img_custom_image_41" alt="" class="img img-fluid o_we_custom_image o_editable_media o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/></div><div class="o_colored_level o_grid_item g-col-lg-2 o_grid_item_image col-6 g-height-3 col-lg-2 order-lg-0" style="z-index: 4; grid-area: 1 / 5 / 4 / 7; order: 2;"><img src="/web/image/team_sports_club.img_custom_image_42" alt="" class="img img-fluid o_we_custom_image o_editable_media o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/></div><div class="o_colored_level o_grid_item g-col-lg-2 o_grid_item_image col-6 g-height-3 col-lg-2 order-lg-0" style="z-index: 5; grid-area: 1 / 7 / 4 / 9; order: 3;"><img src="/web/image/team_sports_club.img_custom_image_47" alt="" class="img img-fluid o_we_custom_image o_editable_media o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/></div><div class="o_colored_level o_grid_item g-col-lg-2 o_grid_item_image col-6 g-height-3 col-lg-2 order-lg-0" style="z-index: 6; grid-area: 1 / 9 / 4 / 11; order: 4;"><img src="/web/image/team_sports_club.img_custom_image_48" alt="" class="img img-fluid o_we_custom_image o_editable_media o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/></div><div class="o_colored_level o_grid_item g-col-lg-2 o_grid_item_image col-6 g-height-3 col-lg-2 order-lg-0" style="z-index: 7; grid-area: 1 / 11 / 4 / 13; order: 5;"><img src="/web/image/team_sports_club.img_custom_image_49" alt="" class="o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/></div><div class="o_grid_item o_colored_level g-col-lg-4 order-lg-0 g-height-4 col-lg-4" style="z-index: 13; grid-area: 5 / 1 / 9 / 5; order: 10;">
                                    <h5 class="o-float-start-parent"><img src="/web/image/team_sports_club.img_custom_image_46" alt="" class="img img-fluid o_we_custom_image me-auto float-start o_attachment_pending_record_id" style="width: 40.49%; height: auto;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/></h5><h5 style="text-align: left;"><br/><br/><br/><br/>FC Apex Stadium</h5><p><span class="o_small-fs">Chau. de Namur 40, 1367 Ramillies</span><span class="text-o-color-1"><span class="o_small-fs"><br/><span style="font-size: 13px;"><span class="fa fa-street-view"/><a href="https://maps.app.goo.gl/f5W92xmU9a3hVt8Z9" class="o_translate_inline" target="_blank"> Google maps</a></span></span></span></p>
                                </div><div class="o_colored_level o_grid_item g-col-lg-2 col-lg-2 g-height-4 order-lg-0" style="z-index: 10; grid-area: 5 / 5 / 9 / 7; order: 6;">
                                    <h5>Menu</h5><div class="s_hr pb32 o_colored_level pt0" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-50 me-auto" style="border-top-color: var(--o-color-1);"/>
                                    </div>
                                    <ul class="list-unstyled">
                                        <li><a href="/" class="o_translate_inline">Home</a></li><li><a class="o_translate_inline" href="/events">Events &amp;amp; Matches</a></li>
                                        <li><a href="/shop" class="o_translate_inline">Fan Shop</a></li>
                                        <li><a href="/partners" class="o_translate_inline">Teams</a></li><li><a href="/contactus" class="o_translate_inline">Contact us</a></li></ul>
                                </div><div class="o_grid_item g-col-lg-2 o_colored_level col-lg-2 g-height-4 order-lg-0" style="z-index: 11; grid-area: 5 / 7 / 9 / 9; order: 7;">
                                    <h5>Events</h5><div class="s_hr pb32 pt0" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-50 me-auto" style="border-top-color: var(--o-color-1);"/></div>
                                    <ul class="list-unstyled">
                                        <li class="oe-nested"><a href="/events">All Events</a><br/></li>
                                        <li class="oe-nested"><a href="/event/tags/single-match-ticket-7?prevent_redirect=True">Matches</a><br/><a href="/event/tags/season-ticket-8?prevent_redirect=True" class="o_translate_inline">Season Pass</a></li>
                                        <li><a href="/event/tags/youth-camp-9?prevent_redirect=True" class="o_translate_inline">Youth Camps</a></li></ul>
                                </div><div class="o_colored_level o_grid_item g-col-lg-2 g-height-4 col-lg-2 order-lg-0" style="z-index: 9; grid-area: 5 / 9 / 9 / 11; order: 8;">
                                    <h5>Club</h5><div class="s_hr pb32 pt0" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-50 me-auto" style="border-top-color: var(--o-color-1);"/></div>
                                    <ul class="list-unstyled">
                                        <li><a href="/about#Our-history" class="o_translate_inline">History</a><br/><a href="/about#Our-awards" class="o_translate_inline">Awards</a></li>
                                        <li><a href="/about#Our-Executive-Commitee">Executive Commitee</a><br/></li>
                                        <li><a href="/about#Our-values">Our Values</a></li><li><a href="/appointment" class="o_translate_inline">Book a Trial</a></li></ul>
                                </div><div class="o_grid_item g-col-lg-2 o_colored_level g-height-3 col-lg-2 order-lg-0" style="z-index: 12; grid-area: 5 / 11 / 8 / 13; order: 9;">
                                    <h5>Teams</h5><div class="s_hr pb32 pt0" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-50 me-auto" style="border-top-color: var(--o-color-1);"/></div>
                                    <ul class="list-unstyled">
                                        <li><a href="*first_team_grade*">First Team</a><br/></li>
                                        <li><a class="o_translate_inline" href="*women_team_grade*">Women's Team</a></li></ul>
                            </div></div>
                        </div>
                    </section>
                    <section class="s_text_block o_footer_bottom_part pt8 pb8 o_colored_level o_cc o_cc5" style="position: relative;" data-snippet="s_text_block" data-name="Bottom Part">
                        <div class="container">
                            <div class="row">
                                <div class="pt8 o_colored_level pb0 col-lg-6">
                                    <div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <p class="s_social_media_title d-none">Follow us</p>
                                        <a href="/website/social/instagram" class="s_social_media_instagram" target="_blank">
                                            <i class="fa fa-instagram fa-stack o_editable_media"/>
                                        </a>
                                        <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank">
                                            <i class="fa fa-facebook fa-stack o_editable_media"/>
                                        </a>
                                        <a href="/website/social/youtube" class="s_social_media_youtube" target="_blank">
                                            <i class="fa fa-youtube-play fa-stack o_editable_media"/>
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('o_footer_copyright')]//div[hasclass('col-md')]" position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
            <xpath expr="//div[hasclass('o_footer_copyright')]//div[hasclass('col-md')][2]" position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
        </field>
    </record>
    <!-- Header call to action, kept from the module's previous website setup:
    the /appointment menu is removed, so this is the site's booking entry point -->
    <template inherit_id="website.placeholder_header_call_to_action" id="header_call_to_action" name="enrollment_action">
        <xpath expr="//div[hasclass('container')]" position="replace">
            <div class="container">
                <a href="/event" class="oe_unremovable btn btn-primary">Tickets</a>
            </div>
        </xpath>
    </template>
</odoo>
