<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shop page title, kept from the module's previous website setup -->
    <record id="products" model="ir.ui.view">
        <field name="name">Custom - Products</field>
        <field name="inherit_id" ref="website_sale.products"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[hasclass('h4-fs')]" position="replace">
                <h1 class="h4-fs" t-if="not category and not search">Our Fan Shop</h1>
            </xpath>
        </field>
    </record>
</odoo>
