                                            <li><i class="fa fa-phone fa-fw me-2 rounded-circle bg-o-color-1"/><span class="o_force_ltr">+32 81 65 47 20<br/><br/></span></li>
                                            <li><i class="fa fa-1x fa-fw fa-envelope me-2 rounded-circle bg-o-color-1"/><span><a href="mailto:info@fcapex.be" class="o_translate_inline">info@fcapex.be</a></span></li>
                                        </ul><h4><br/>Stadium</h4><div class="s_hr o_colored_level pt8 pb16" data-snippet="s_hr" data-name="Separator">
