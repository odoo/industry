<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- Tags used by the footer shortcuts to filter /event by ticket type -->
  <record id="event_tag_1" model="event.tag">
    <field name="name">Single Match Ticket</field>
    <field name="category_id" ref="event_tag_category_1"/>
  </record>
  <record id="event_tag_2" model="event.tag">
    <field name="name">Season Ticket</field>
    <field name="category_id" ref="event_tag_category_1"/>
  </record>
  <record id="event_tag_3" model="event.tag">
    <field name="name">Youth Camp</field>
    <field name="category_id" ref="event_tag_category_1"/>
  </record>
</odoo>
