#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
msgid ""
"<strong><b>CRM App</b>: </strong>Professionalize your funding by tracking "
"potential sponsors and managing\n"
"                    sponsorship deals effectively.<br/>"
msgstr ""
"<strong><b>CRM-app</b>: </strong>Professionaliseer je financiering door "
"potentiële sponsors te volgen en sponsordeals effectief te beheren.<br/>"

#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
msgid ""
"<strong><b>Events App</b>: </strong>Engage your fanbase by selling match "
"tickets and managing registrations\n"
"                    for tournaments or social events online.<br/>"
msgstr ""
"<strong><b>Evenementen-app</b>: </strong>Betrek je fans door online kaartjes "
"voor wedstrijden te verkopen en inschrijvingen voor toernooien of sociale "
"evenementen te beheren.<br/>"

#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
msgid ""
"<strong><b>Invoicing App</b>: </strong>Keep the club's finances healthy by "
"invoicing members and sponsors\n"
"                    and tracking incoming payments.<br/>"
msgstr ""
"<strong><b>Facturatie-app</b>: </strong>Houd de financiën van de club gezond "
"door leden en sponsors te factureren en inkomende betalingen bij te houden."
"<br/>"

#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
msgid ""
"<strong><b>Planning App</b>: </strong>Optimize your facilities by scheduling "
"field and court bookings to\n"
"                    prevent conflicts between teams.<br/>"
msgstr ""
"<strong><b>Planning-app</b>: </strong>Optimaliseer je faciliteiten door "
"reservaties van velden en banen in te plannen om conflicten tussen teams te "
"voorkomen.<br/>"

#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Run your club's bar or "
"merchandise shop efficiently, handling\n"
"                    sales of drinks, snacks, and team jerseys.<br/>"
msgstr ""
"<strong><b>Kassa-app</b>: </strong>Run de bar of merchandiseshop van je club "
"efficiënt en verwerk de verkoop van drankjes, snacks en teamshirts.<br/>"

#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
msgid ""
"<strong><b>Project App</b>: </strong>Coordinate complex activities like "
"player recruitment drives and trial\n"
"                    days with clear tasks and timelines.<br/>"
msgstr ""
"<strong><b>Project-app</b>: </strong>Coördineer complexe activiteiten zoals "
"campagnes voor rekrutering van spelers en proefdagen met duidelijke taken en "
"tijdschema's.<br/>"

#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
msgid ""
"<strong><b>Sales App</b>: </strong>Generate professional sponsorship offers "
"and formal contribution requests\n"
"                    to secure revenue.<br/>"
msgstr ""
"<strong><b>Verkoop-app</b>: </strong>Genereer professionele "
"sponsorvoorstellen en formele bijdragenverzoeken om inkomsten veilig te "
"stellen.<br/>"

#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
msgid ""
"<strong><b>Teams App</b>: </strong>Organize your club's structure by "
"managing rosters, assigning players to\n"
"                    specific squads, and tracking team compositions.<br/>"
msgstr ""
"<strong><b>Teams-app</b>: </strong>Organiseer de structuur van je club door "
"roosters te beheren, spelers toe te wijzen aan specifieke teams en de "
"samenstelling van teams bij te houden.<br/>"

#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
msgid ""
"<strong><b>Website App</b>: </strong>Build a digital home for your club to "
"showcase team profiles, sell\n"
"                    merchandise, and manage online enrollments.<br/>"
msgstr ""
"<strong><b>Website-app</b>: </strong>Bouw een digitale thuisbasis voor je "
"club om teams te presenteren, merchandise te verkopen en online "
"inschrijvingen te beheren.<br/>"

#. module: team_sports_club
#: model_terms:ir.ui.view,arch_db:team_sports_club.welcome_article_body
