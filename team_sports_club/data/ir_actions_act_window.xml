<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="players_menu_action" model="ir.actions.act_window">
    <field name="name">Players</field>
    <field name="res_model">x_player</field>
    <field name="context">{'search_default_groupby_x_team_id': 1, 'search_default_active_team': 1}</field>
    <field name="domain">['|', ('x_team_id.x_to_date', '=', False), ('x_team_id.x_to_date', '&gt;', context_today())]</field>
  </record>
  <record id="teams_menu_action" model="ir.actions.act_window">
    <field name="name">Teams</field>
    <field name="res_model">x_team</field>
  </record>
  <record id="coaches_menu_action" model="ir.actions.act_window">
    <field name="name">Coaches</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,kanban,form,activity</field>
  </record>
  <record id="staffs_menu_action" model="ir.actions.act_window">
    <field name="name">Staffs</field>
    <field name="res_model">x_staff</field>
    <field name="context">{'search_default_groupby_x_team_id': 1, 'search_default_active_team': 1}</field>
    <field name="domain">['|', ('x_team_id.x_to_date', '=', False), ('x_team_id.x_to_date', '&gt;', context_today())]</field>
  </record>
  <record id="action_res_partner_grade_players" model="ir.actions.act_window">
    <field name="name">Players</field>
    <field name="res_model">x_player</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('x_team_id', '=', active_id)]</field>
    <field name="context">{'default_x_team_id': active_id}</field>
  </record>
  <record id="action_res_partner_grade_staff" model="ir.actions.act_window">
    <field name="name">Staff</field>
    <field name="res_model">x_staff</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('x_team_id', '=', active_id)]</field>
    <field name="context">{'default_x_team_id': active_id}</field>
  </record>
  <record id="action_res_partner_grade_trainings" model="ir.actions.act_window">
    <field name="name">Trainings</field>
    <field name="res_model">project.task</field>
    <field name="view_mode">calendar,list,form</field>
    <field name="view_id" ref="project.view_task_calendar"/>
    <field name="domain">[('state', 'not in', ['1_done', '1_canceled']), ('project_id.x_training', '=', True), ('x_team_ids', 'in', [active_id])]
    </field>
  </record>
  <record id="action_res_partner_grade_games" model="ir.actions.act_window">
    <field name="name">Games</field>
    <field name="res_model">project.task</field>
    <field name="view_mode">calendar,list,form</field>
    <field name="view_id" ref="project.view_task_calendar"/>
    <field name="domain">[('state', 'not in', ['1_done', '1_canceled']), ('project_id.x_game', '=', True), ('x_team_ids', 'in', [active_id])]
    </field>
  </record>
  <record id="action_res_partner_player_teams" model="ir.actions.act_window">
    <field name="name">Teams</field>
    <field name="res_model">x_player</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('x_name', '=', active_id)]</field>
    <field name="context">{'default_x_name': active_id}</field>
  </record>
  <record id="action_res_partner_staff_teams" model="ir.actions.act_window">
    <field name="name">Staff</field>
    <field name="res_model">x_staff</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('x_name', '=', active_id)]</field>
    <field name="context">{'default_x_name': active_id}</field>
  </record>
</odoo>
