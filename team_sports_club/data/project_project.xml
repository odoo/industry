<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
  <record id="project_project_1" model="project.project">
    <field name="name">Players Recruitement</field>
    <field name="type_ids" eval="[(6, 0, [ref('project_task_type_1'), ref('project_task_type_2'), ref('project_task_type_3'), ref('project_task_type_4')])]"/>
    <field name="user_id" ref="base.user_admin"/>
    <field name="x_player_recruitement" eval="True"/>
  </record>
  <record id="project_project_2" model="project.project">
    <field name="name">Games</field>
    <field name="type_ids" eval="[(6, 0, [ref('project_task_type_5'), ref('project_task_type_6')])]"/>
    <field name="user_id" ref="base.user_admin"/>
    <field name="x_game" eval="True"/>
  </record>
  <record id="project_project_3" model="project.project">
    <field name="name">Training</field>
    <field name="type_ids" eval="[(6, 0, [ref('project_task_type_7')])]"/>
    <field name="user_id" ref="base.user_admin"/>
    <field name="allow_recurring_tasks" eval="True"/>
    <field name="x_training" eval="True"/>
  </record>
</odoo>
