<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="res_partner_kanban_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <xpath expr="//kanban[1]" position="attributes">
        <attribute name="default_group_by">grade_id</attribute>
      </xpath>
    </field>
    <field name="inherit_id" ref="base.res_partner_kanban_view"/>
    <field name="mode">extension</field>
    <field name="model">res.partner</field>
    <field name="name">Team Sports Club form view for Partner</field>
    <field name="priority">160</field>
    <field name="type">kanban</field>
    <field name="active" eval="True"/>
  </record>
  <record id="res_partner_grade_list_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <list string="Staff">
        <field name="x_name"/>
        <field name="x_from_date" widget="daterange" string="Dates" options="{'end_date_field': 'x_to_date', 'always_range': true}"/>
        <field name="x_notes"/>
      </list>
    </field>
    <field name="model">x_team</field>
    <field name="name">Team Sports Club list view for Partner Grade</field>
    <field name="priority">99</field>
    <field name="type">list</field>
    <field name="active" eval="True"/>
  </record>
  <record id="project_project_form_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <xpath expr="//field[@name='tag_ids']/.." position="after">
        <field name="x_player_recruitement"/>
        <field name="x_training"/>
        <field name="x_game"/>
      </xpath>
    </field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="mode">extension</field>
    <field name="model">project.project</field>
    <field name="name">Team Sports Club form view for Project Project</field>
    <field name="priority">160</field>
    <field name="type">form</field>
    <field name="active" eval="True"/>
  </record>
  <record id="x_team_form_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Team">
          <div name="button_box" class="oe_button_box">
            <button name="%(action_res_partner_grade_players)d" class="oe_stat_button" icon="fa-users" type="action">
              <div class="o_stat_info">
                <span class="o_stat_text">Players</span>
              </div>
            </button>
            <button name="%(action_res_partner_grade_staff)d" class="oe_stat_button" icon="fa-user-md" type="action">
              <div class="o_stat_info">
                <span class="o_stat_text">Staff</span>
              </div>
            </button>
            <button name="%(action_res_partner_grade_trainings)d" class="oe_stat_button" icon="fa-calendar-check-o" type="action">
                <div class="o_stat_info">
                <span class="o_stat_text">Trainings</span>
              </div>
            </button>
            <button name="%(action_res_partner_grade_games)d" class="oe_stat_button" icon="fa-calendar" type="action">
              <div class="o_stat_info">
                <span class="o_stat_text">Games</span>
              </div>
            </button>
          </div>
          <div class="oe_title">
            <h1>
              <field name="x_name"/>
            </h1>
            <group>
              <field name="x_from_date" widget="daterange" string="Dates" options="{'end_date_field': 'x_to_date', 'always_range': true}"/>
              <field name="x_notes"/>
            </group>
          </div>
        </sheet>
      </form>
    </field>
    <field name="model">x_team</field>
    <field name="name">Team Sports Club form view for Team</field>
    <field name="priority">160</field>
    <field name="type">form</field>
    <field name="active" eval="True"/>
  </record>
  <record id="appointment_type_form_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <xpath expr="//group[@name='left_details']" position="inside">
        <field name="x_team"/>
      </xpath>
    </field>
    <field name="inherit_id" ref="appointment.appointment_type_view_form"/>
    <field name="mode">extension</field>
    <field name="model">appointment.type</field>
    <field name="name">Team Sports Club form view for Appointment Type</field>
    <field name="priority">200</field>
    <field name="type">form</field>
    <field name="active" eval="True"/>
  </record>
  <record id="calender_event_form_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <xpath expr="//field[@name='categ_ids']" position="after">
        <field name="x_team"/>
      </xpath>
      <xpath expr="//page[@name='options']//field[@name='appointment_type_id']" position="attributes">
        <attribute name="invisible">0</attribute>
      </xpath>
      <xpath expr="/form//field[@name='resource_ids']" position="attributes">
        <attribute name="invisible">0</attribute>
      </xpath>
    </field>
    <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
    <field name="mode">extension</field>
    <field name="model">calendar.event</field>
    <field name="name">Team Sports Club Form view for Calendar Event</field>
    <field name="priority">160</field>
    <field name="type">form</field>
    <field name="active" eval="True"/>
  </record>
  <record id="calender_event_list_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <xpath expr="//list[1]" position="attributes">
        <attribute name="default_group_by">x_team,start_date:day</attribute>
        <attribute name="default_order">start_date desc</attribute>
      </xpath>
    </field>
    <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
    <field name="mode">extension</field>
    <field name="model">calendar.event</field>
    <field name="name">Team Sports Club list view for Calendar Event</field>
    <field name="priority">160</field>
    <field name="type">list</field>
    <field name="active" eval="True"/>
  </record>
  <record id="event_registeration_kanban_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <xpath expr="//div[@id='event_ticket_id']" position="replace"/>
      <xpath expr="//kanban[1]" position="attributes">
        <attribute name="default_group_by">event_slot_id</attribute>
      </xpath>
    </field>
    <field name="inherit_id" ref="event.event_registration_view_kanban"/>
    <field name="mode">extension</field>
    <field name="model">event.registration</field>
    <field name="name">Team Sports Club kanban view for Event Registration</field>
    <field name="priority">160</field>
    <field name="type">kanban</field>
    <field name="active" eval="True"/>
  </record>
  <record id="event_registeration_list_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <xpath expr="//field[@name='event_ticket_id']" position="replace"/>
    </field>
    <field name="inherit_id" ref="event.view_event_registration_tree"/>
    <field name="mode">extension</field>
    <field name="model">event.registration</field>
    <field name="name">Team Sports Club list view for Event Registeration</field>
    <field name="priority">160</field>
    <field name="type">list</field>
    <field name="active" eval="True"/>
  </record>
  <record id="res_partner_form_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
        <button name="%(action_res_partner_player_teams)d" class="oe_stat_button" icon="fa-users" type="action">
          <div class="o_stat_info">
            <span class="o_stat_text">Teams</span>
          </div>
        </button>
        <button name="%(action_res_partner_staff_teams)d" class="oe_stat_button" icon="fa-user-md" type="action">
          <div class="o_stat_info">
            <span class="o_stat_text">Staffs</span>
          </div>
        </button>
      </xpath>
      <xpath expr="//field[@name='grade_id']" position="attributes">
        <attribute name="string">Members</attribute>
      </xpath>
      <xpath expr="//div[@name='identifiers']" position="after">
        <field name="x_license_no"/>
        <field name="x_jersey_size"/>
      </xpath>
      <xpath expr="//field[@name='category_id']" position="after">
        <field name="x_status"/>
      </xpath>
      <xpath expr="//page[@name='internal_notes']" position="after">
        <page name="medical_info" string="Medical Info">
          <group>
            <field name="x_height"/>
            <field name="x_weight"/>
            <field name="x_emergency_member_id" invisible="x_emergency_phone_no"/>
            <field name="x_emergency_contact" invisible="x_emergency_member_id"/>
            <field name="x_emergency_phone_no" widget="phone" invisible="x_emergency_member_id"/>
          </group>
        </page>
      </xpath>
    </field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="mode">extension</field>
    <field name="model">res.partner</field>
    <field name="name">Team Sports Club form view for Partner</field>
    <field name="priority">200</field>
    <field name="type">form</field>
    <field name="active" eval="True"/>
  </record>
  <record id="res_partner_search_view" model="ir.ui.view">
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='group_grade']" position="attributes">
        <attribute name="string">Team</attribute>
      </xpath>
    </field>
    <field name="inherit_id" ref="base.view_res_partner_filter"/>
    <field name="mode">extension</field>
    <field name="model">res.partner</field>
    <field name="name">Team Sports Club search view for Partner</field>
    <field name="priority">160</field>
    <field name="type">search</field>
    <field name="active" eval="True"/>
  </record>
  <record id="view_x_player_list_view" model="ir.ui.view">
    <field name="name">x.player.list</field>
    <field name="model">x_player</field>
    <field name="type">list</field>
    <field name="active" eval="True" />
    <field name="arch" type="xml">
      <list string="Players">
        <field name="x_name" widget="many2one_avatar_user"/>
        <field name="x_team_id"/>
        <field name="x_jersey"/>
        <field name="x_role_ids" widget="many2many_tags"/>
      </list>
    </field>
  </record>
  <record id="x_player_form_view" model="ir.ui.view">
    <field name="name">x.player.form</field>
    <field name="model">x_player</field>
    <field name="type">form</field>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
        <form>
          <header/>
          <sheet string="Player">
            <group>
              <field name="x_name"/>
              <field name="x_team_id"/>
              <field name="x_jersey"/>
              <field name="x_role_ids" widget="many2many_tags" domain="[('id', 'in', x_partner_category_ids)]"/>
            </group>
          </sheet>
        </form>
    </field>
  </record>
  <record id="x_player_search_view" model="ir.ui.view">
    <field name="name">x_player.search.view</field>
    <field name="model">x_player</field>
    <field name="active" eval="True"/>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_team_id"/>
        <filter name="groupby_x_team_id" string="Team" context="{'group_by': 'x_team_id'}"/>
        <separator/>
        <filter name="active_team" string="Active Team" domain="['|', ('x_team_id.x_to_date', '=', False), ('x_team_id.x_to_date', '>', context_today())]"/>
      </search>
    </field>
  </record>
  <record id="x_staff_search_view" model="ir.ui.view">
    <field name="name">x_staff.search.view</field>
    <field name="model">x_staff</field>
    <field name="active" eval="True"/>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_team_id"/>
        <filter name="groupby_x_team_id" string="Team" context="{'group_by': 'x_team_id'}"/>
        <separator/>
        <filter name="active_team" string="Active Team" domain="['|', ('x_team_id.x_to_date', '=', False), ('x_team_id.x_to_date', '>', context_today())]"/>
      </search>
    </field>
  </record>
  <record id="x_staff_form_view" model="ir.ui.view">
    <field name="name">x.staff.form</field>
    <field name="model">x_staff</field>
    <field name="type">form</field>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Staff">
          <group>
            <field name="x_name"/>
            <field name="x_team_id"/>
            <field name="x_role_ids" widget="many2many_tags" domain="[('id', 'in', x_partner_category_ids)]"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_x_staff_list_view" model="ir.ui.view">
    <field name="name">x.staff.list</field>
    <field name="model">x_staff</field>
    <field name="type">list</field>
    <field name="active" eval="True" />
    <field name="arch" type="xml">
      <list string="Staff">
        <field name="x_name" widget="many2one_avatar_user"/>
        <field name="x_team_id"/>
        <field name="x_role_ids" widget="many2many_tags"/>
      </list>
    </field>
  </record>
  <record id="project_task_form_customization" model="ir.ui.view">
    <field name="name">project.task.form customization</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2"/>
    <field name="mode">extension</field>
    <field name="type">form</field>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='user_ids']" position="after">
        <field name="x_team_ids" widget="many2many_tags"/>
      </xpath>
      <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="after">
        <field name="x_event_id" invisible="not x_is_game"/>
      </xpath>
    </field>
  </record>
</odoo>
