<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <record id="mailing_mailing_annual_fee" model="mailing.mailing" context="{'mail_auto_subscribe_no_notify': True}">
    <field name="subject">Annual Membership Fee Reminder</field>
    <field name="medium_id" ref="utm.utm_medium_email"/>
    <field name="user_id" ref="base.user_admin"/>
    <field name="mailing_model_id" ref="base.model_res_partner"/>
    <field name="reply_to_mode">new</field>
    <field name="email_from" model="res.users" eval="obj().env.ref('base.user_admin').email or 'club@example.com'"/>
    <field name="mailing_filter_ids" model="mailing.filter" eval="[obj().env.ref('team_sports_club.mailing_filter_players').id]"/>
    <field name="mailing_domain">[('x_player_ids', '!=', False)]</field>
    <field name="body_arch"><![CDATA[<div class="o_layout oe_unremovable oe_unmovable bg-200 o_default_theme" data-name="Mailing"><style id="design-element">.o_mail_wrapper h3 { color: rgb(43, 59, 88); font-size: 18px; font-weight: bolder; }</style><div class="container o_mail_wrapper o_mail_regular oe_unremovable"><div class="row"><div class="col o_mail_no_options o_mail_wrapper_td bg-white oe_structure o_editable theme_selection_done"><div class="s_title o_mail_snippet_general pt32 pb16" data-snippet="s_title" data-name="Title"><div class="container s_allow_columns"><h1 style="text-align: center; color: #1e3a8a;">Annual Membership Fee</h1><p style="text-align: center; color: #64748b; font-size: 16px;">Club Membership</p></div></div><div class="s_text_block o_mail_snippet_general pt16 pb24" style="padding-left: 20px; padding-right: 20px;" data-snippet="s_text_block" data-name="Text"><div class="container s_allow_columns"><p>Dear Player,</p><p>This is a reminder to pay your annual membership fee for the upcoming season. Your support enables our club operations, coaching staff, facility maintenance, and match equipment.</p><p>Please click the button below to pay your annual membership fee.</p></div></div><div class="s_call_to_action o_mail_snippet_general pt16 pb32" style="text-align: center;" data-snippet="s_call_to_action" data-name="Call to Action"><div class="container"><a href="*contribution_product_url*" class="btn btn-primary btn-lg" style="background-color: #1e3a8a; border-color: #1e3a8a; color: #ffffff; padding: 12px 28px; font-weight: bold; text-decoration: none; border-radius: 6px;">Pay Annual Fee</a></div></div><div class="s_hr pt16 pb16" data-snippet="s_hr" data-name="Separator"><hr style="border: 0; border-top: 1px solid #e2e8f0; width: 80%; margin: auto;" /></div><div class="s_footer_social o_mail_block_footer_social o_mail_footer_social_center o_mail_snippet_general bg-200 pt16 pb16" data-snippet="s_mail_block_footer_social" data-name="Footer Center"><div class="container"><div class="row"><div class="col-lg-12 o_mail_footer_links pt8 pb8" style="text-align: center;"><a role="button" href="/unsubscribe_from_list" class="btn btn-link" style="color: #64748b; font-size: 12px;">Unsubscribe</a></div></div><div class="row"><div class="col-lg-12"><p style="text-align: center; color: #94a3b8; font-size: 12px;">Team Sports Club &copy; All Rights Reserved</p></div></div></div></div></div></div></div></div>]]></field>
  </record>
  <function model="mailing.mailing" name="write">
    <value model="mailing.mailing" eval="obj().env.ref('team_sports_club.mailing_mailing_annual_fee').id"/>
    <value model="mailing.mailing" eval="{
        'body_arch': obj().env.ref('team_sports_club.mailing_mailing_annual_fee').body_arch.replace('*contribution_product_url*', obj().env.ref('team_sports_club.product_template_9').website_url or '/shop'),
    }"/>
  </function>
</odoo>
