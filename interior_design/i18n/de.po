#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The CRM App</font>\n"
"      </strong> captures and tracks potential clients, manages site visit scheduling, and monitors lead progress."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Die CRM-App</font>\n"
"      </strong> erfasst und verfolgt potenzielle Kunden, verwaltet die "
"Terminplanung für Besuche vor Ort und überwacht den Fortschritt der Leads."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Document App</font>\n"
"      </strong> will have the designs shared with the customers at a centralised place."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">In der Dokumente-App</font>"
"\n"
"      </strong> werden die Entwürfe an einem zentralen Ort für die Kunden "
"bereitgestellt."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Planning App</font>\n"
"      </strong> to assign the tasks and plan the work for the resources."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Die Planungsapp</font>\n"
"      </strong> dient dazu, die Aufgaben zuzuweisen und die Arbeit für die "
"Ressourcen zu planen."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Project App</font>\n"
"      </strong> organizes and tracks design phases such as Mood Board, Visualization, and Handover."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Die Projekte-App</font>\n"
"      </strong> organisiert und verfolgt Designphasen wie Moodboard, "
"Visualisierung und Übergabe."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Purchase App</font>\n"
"      </strong> manages vendor orders and procures furniture, materials, and fittings for projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">DieEinkaufsapp</font>\n"
"      </strong> verwaltet Bestellungen der Lieferanten und übernimmt die "
"Beschaffung von Möbeln, Materialien und Einrichtungsgegenständen für "
"Projekte."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Sales App</font>\n"
"      </strong> creates and manages quotations and sales orders for design projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Die Verkaufsapp</font>\n"
"      </strong> erstellt und verwaltet Angebote und Verkaufsaufträge für "
"Designprojekte."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Timesheets App</font>\n"
"      </strong> tracks hours spent on creative design work for accurate costing and billing."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Die Zeiterfassungsapp</font>"
"\n"
"      </strong> erfasst die für kreative Designarbeiten aufgewendeten "
"Stunden und ermöglicht so eine genaue Kostenkalkulation und Abrechnung."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Website App</font>\n"
"      </strong> generates leads by showcasing your portfolio and allowing clients to reach out through a contact form."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Die Website-App</font>\n"
"      </strong> generiert Leads, indem sie Ihr Portfolio präsentiert und es "
"Kunden ermöglicht, über ein Kontaktformular Kontakt aufzunehmen."

