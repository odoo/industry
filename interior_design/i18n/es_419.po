#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The CRM App</font>\n"
"      </strong> captures and tracks potential clients, manages site visit scheduling, and monitors lead progress."
msgstr ""
"<strong>\n"
"  <font style=\"color: rgb(198, 123, 165);\">La aplicación CRM</font>\n"
"  </strong> captura y da seguimiento a clientes potenciales, gestiona la "
"programación de visitas al sitio y supervisa el avance de los leads."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Document App</font>\n"
"      </strong> will have the designs shared with the customers at a centralised place."
msgstr ""
"<strong>\n"
"  <font style=\"color: rgb(198, 123, 165);\">La aplicación Documentos</font>"
"\n"
"  </strong> reúne los diseños que compartes con tus clientes en un solo "
"lugar."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Planning App</font>\n"
"      </strong> to assign the tasks and plan the work for the resources."
msgstr ""
"<strong>\n"
"  <font style=\"color: rgb(198, 123, 165);\">La aplicación Planeación</font>"
"\n"
"  </strong> asigna tareas y planifica el trabajo de los recursos."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Project App</font>\n"
"      </strong> organizes and tracks design phases such as Mood Board, Visualization, and Handover."
msgstr ""
"<strong>\n"
"  <font style=\"color: rgb(198, 123, 165);\">La aplicación Proyectos</font>\n"
"  </strong> organiza y da seguimiento a las etapas del diseño, como el "
"tablero de inspiración, la visualización y la entrega."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Purchase App</font>\n"
"      </strong> manages vendor orders and procures furniture, materials, and fittings for projects."
msgstr ""
"<strong>\n"
"  <font style=\"color: rgb(198, 123, 165);\">La aplicación Compras</font>\n"
"  </strong> gestiona las órdenes para proveedores y adquiere muebles, "
"materiales y accesorios para los proyectos."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Sales App</font>\n"
"      </strong> creates and manages quotations and sales orders for design projects."
msgstr ""
"<strong>\n"
"  <font style=\"color: rgb(198, 123, 165);\">La aplicación Ventas</font>\n"
"  </strong> crea y gestiona cotizaciones y órdenes de venta para proyectos "
"de diseño."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Timesheets App</font>\n"
"      </strong> tracks hours spent on creative design work for accurate costing and billing."
msgstr ""
"<strong>\n"
"  <font style=\"color: rgb(198, 123, 165);\">La aplicación Registro de "
"horas</font>\n"
"  </strong> registra las horas dedicadas al trabajo creativo de diseño para "
"calcular costos y facturar con precisión."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Website App</font>\n"
"      </strong> generates leads by showcasing your portfolio and allowing clients to reach out through a contact form."
msgstr ""
"<strong>\n"
"  <font style=\"color: rgb(198, 123, 165);\">La aplicación Sitio web</font>\n"
"  </strong> genera oportunidades al mostrar tu portafolio y permitir que tus "
"clientes te contacten mediante un formulario."

