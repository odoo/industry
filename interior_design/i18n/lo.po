#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The CRM App</font>\n"
"      </strong> captures and tracks potential clients, manages site visit "
"scheduling, and monitors lead progress."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">ແອັບ CRM</font>\n"
"      </strong> ຊ່ວຍເກັບກຳ ແລະ ຕິດຕາມລູກຄ້າທີ່ມຸ່ງຫວັງ, ຈັດການຕາຕະລາງລົງເບິ່ງສະຖານທີ່ ແລະ ຕິດຕ"
"າມຄວາມຄືບໜ້າຂອງລູກຄ້າກຸ່ມເປົ້າໝາຍ."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Document App</font>\n"
"      </strong> will have the designs shared with the customers at a "
"centralised place."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">ແອັບເອກະສານ (Document)</font>"
"\n"
"      </strong> ຈະຮວບຮວມແບບທີ່ແບ່ງປັນໃຫ້ລູກຄ້າໄວ້ໃນບ່ອນດຽວກັນຢ່າງເປັນລະບົບ."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Planning App</font>\n"
"      </strong> to assign the tasks and plan the work for the resources."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">ແອັບວາງແຜນ (Planning)</font>"
"\n"
"      </strong> ເພື່ອມອບໝາຍໜ້າວຽກ ແລະ ວາງແຜນການເຮັດວຽກໃຫ້ແກ່ທີມງານ."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Project App</font>\n"
"      </strong> organizes and tracks design phases such as Mood Board, "
"Visualization, and Handover."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">ແອັບໂຄງການ (Project)</font>\n"
"      </strong> ຈັດລະບຽບ ແລະ ຕິດຕາມແຕ່ລະຂັ້ນຕອນການອອກແບບ ເຊັ່ນ: Mood Board, ການສະແດງ"
"ພາບ 3D (Visualization), ແລະ ການສົ່ງມອບວຽກ (Handover)."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Purchase App</font>\n"
"      </strong> manages vendor orders and procures furniture, materials, and "
"fittings for projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">ແອັບຈັດຊື້ (Purchase)</font>\n"
"      </strong> ຄຸ້ມຄອງການສັ່ງຊື້ຈາກຜູ້ສະໜອງ ແລະ ຈັດຊື້ເຟີນີເຈີ, ວັດສະດຸ, ລວມທັງອຸປະກອນຕ່າງໆສຳລັບ"
"ໂຄງການ."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Sales App</font>\n"
"      </strong> creates and manages quotations and sales orders for design "
"projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">ແອັບການຂາຍ (Sales)</font>\n"
"      </strong> ສ້າງ ແລະ ຄຸ້ມຄອງໃບສະເໜີລາຄາ ພ້ອມທັງໃບສັ່ງຂາຍສຳລັບໂຄງການອອກແບບ."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Timesheets App</font>\n"
"      </strong> tracks hours spent on creative design work for accurate "
"costing and billing."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">ແອັບບັນທຶກເວລາ (Timesheets)</"
"font>\n"
"      </strong> ບັນທຶກຊົ່ວໂມງທີ່ໃຊ້ໃນການອອກແບບ ເພື່ອການຄິດໄລ່ຕົ້ນທຶນ ແລະ ການອອກໃບຮຽກເກັບເງິນຢ່"
"າງຊັດເຈນ."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Website App</font>\n"
"      </strong> generates leads by showcasing your portfolio and allowing "
"clients to reach out through a contact form."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">ແອັບເວັບໄຊຕ໌ (Website)</font>\n"
"      </strong> ສ້າງໂອກາດທາງການຂາຍໂດຍການສະແດງຜົນງານຂອງທ່ານ ແລະ ຊ່ວຍໃຫ້ລູກຄ້າຕິດຕໍ່ຫາຜ່ານ"
"ແບບຟອມຕິດຕໍ່ໄດ້ຢ່າງສະດວກ."

