#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The CRM App</font>\n"
"      </strong> captures and tracks potential clients, manages site visit "
"scheduling, and monitors lead progress."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Aplicația CRM</font>\n"
"      </strong> captează și urmărește potențialii clienți, gestionează "
"programarea vizitelor la locație și monitorizează evoluția oportunităților."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Document App</font>\n"
"      </strong> will have the designs shared with the customers at a "
"centralised place."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Aplicația Documente</font>\n"
"      </strong> păstrează într-un loc central documentele de design "
"partajate cu clienții."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Planning App</font>\n"
"      </strong> to assign the tasks and plan the work for the resources."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Aplicația Planificare</font>"
"\n"
"      </strong> atribuie sarcinile și planifică lucrul resurselor."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Project App</font>\n"
"      </strong> organizes and tracks design phases such as Mood Board, "
"Visualization, and Handover."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Aplicația Proiect</font>\n"
"      </strong> organizează și urmărește etapele de design, precum panoul de "
"inspirație, vizualizarea și predarea proiectului."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Purchase App</font>\n"
"      </strong> manages vendor orders and procures furniture, materials, and "
"fittings for projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Aplicația Achiziții</font>\n"
"      </strong> gestionează comenzile către furnizori și achiziționează "
"mobilier, materiale și accesorii pentru proiecte."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Sales App</font>\n"
"      </strong> creates and manages quotations and sales orders for design "
"projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Aplicația Vânzări</font>\n"
"      </strong> creează și gestionează oferte și comenzi de vânzare pentru "
"proiecte de design."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Timesheets App</font>\n"
"      </strong> tracks hours spent on creative design work for accurate "
"costing and billing."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Aplicația Pontaje</font>\n"
"      </strong> urmărește orele dedicate lucrărilor creative de design "
"pentru calcularea corectă a costurilor și facturării."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Website App</font>\n"
"      </strong> generates leads by showcasing your portfolio and allowing "
"clients to reach out through a contact form."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">Aplicația Site web</font>\n"
"      </strong> atrage clienți potențiali prin prezentarea portofoliului și "
"printr-un formular de contact."

