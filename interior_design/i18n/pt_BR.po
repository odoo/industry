#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The CRM App</font>\n"
"      </strong> captures and tracks potential clients, manages site visit scheduling, and monitors lead progress."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">O aplicativo CRM</font>\n"
"      </strong> captura e rastreia potenciais clientes, gerencia o "
"agendamento de visitas ao local e monitora o progresso dos leads."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Document App</font>\n"
"      </strong> will have the designs shared with the customers at a centralised place."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">O aplicativo Documentos</"
"font>\n"
"      </strong> compartilhará os designs com os clientes em um local "
"centralizado."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Planning App</font>\n"
"      </strong> to assign the tasks and plan the work for the resources."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">O aplicativo Planejamento</"
"font>\n"
"      </strong> serve para atribuir tarefas e planejar o trabalho dos "
"recursos."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Project App</font>\n"
"      </strong> organizes and tracks design phases such as Mood Board, Visualization, and Handover."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">O aplicativo Projetos</font>"
"\n"
"      </strong> organiza e rastreia as fases do design, como Painel de "
"Inspiração (Mood Board), Visualização e Entrega."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Purchase App</font>\n"
"      </strong> manages vendor orders and procures furniture, materials, and fittings for projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">O aplicativo Compras</font>"
"\n"
"      </strong> gerencia pedidos de fornecedores e adquire móveis, materiais "
"e equipamentos para os projetos."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Sales App</font>\n"
"      </strong> creates and manages quotations and sales orders for design projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">O aplicativo Vendas</font>\n"
"      </strong> cria e gerencia cotações e pedidos de venda para projetos de "
"design."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Timesheets App</font>\n"
"      </strong> tracks hours spent on creative design work for accurate costing and billing."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">O aplicativo Planilhas de "
"Horas</font>\n"
"      </strong> rastreia as horas gastas em trabalhos de design criativo "
"para custeio e faturamento precisos."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
