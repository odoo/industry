#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The CRM App</font>\n"
"      </strong> captures and tracks potential clients, manages site visit scheduling, and monitors lead progress."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">De CRM-app</font>\n"
"      </strong> registreert en volgt potentiële klanten, beheert de planning "
"van locatiebezoeken en houdt de voortgang van leads bij."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Document App</font>\n"
"      </strong> will have the designs shared with the customers at a centralised place."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">De Documenten-app</font>\n"
"      </strong> biedt een centrale plek waar de ontwerpen met de klanten "
"kunnen worden gedeeld."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Planning App</font>\n"
"      </strong> to assign the tasks and plan the work for the resources."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">De Planning-app</font>\n"
"      </strong> om de taken toe te wijzen en het werk voor de resources te "
"plannen."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Project App</font>\n"
"      </strong> organizes and tracks design phases such as Mood Board, Visualization, and Handover."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">De Project-app</font>\n"
"      </strong> organiseert en volgt ontwerpfases zoals Moodboard, "
"Visualisatie en Oplevering."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Purchase App</font>\n"
"      </strong> manages vendor orders and procures furniture, materials, and fittings for projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">De Inkoop-app</font>\n"
"      </strong> beheert leveranciersbestellingen en zorgt voor de inkoop van "
"meubilair, materialen en inrichtingsartikelen voor projecten."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Sales App</font>\n"
"      </strong> creates and manages quotations and sales orders for design projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">De Verkoop-app</font>\n"
"      </strong> maakt en beheert offertes en verkooporders voor "
"ontwerpprojecten."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Timesheets App</font>\n"
"      </strong> tracks hours spent on creative design work for accurate costing and billing."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">De Urenstaten-app</font>\n"
"      </strong> houdt de uren bij die aan creatief ontwerpwerk worden "
"besteed, voor een nauwkeurige kostenberekening en facturatie."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
