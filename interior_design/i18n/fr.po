#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The CRM App</font>\n"
"      </strong> captures and tracks potential clients, manages site visit "
"scheduling, and monitors lead progress."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’application CRM</font>\n"
"      </strong> identifie et suit les clients potentiels, gère la "
"planification des visites sur site et surveille la progression des pistes."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Document App</font>\n"
"      </strong> will have the designs shared with the customers at a "
"centralised place."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’application Documents</"
"font>\n"
"      </strong> centralise les aménagements partagés avec les clients."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Planning App</font>\n"
"      </strong> to assign the tasks and plan the work for the resources."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’application "
"Planification</font>\n"
"      </strong> permet d’attribuer des tâches et de planifier le travail des "
"ressources."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Project App</font>\n"
"      </strong> organizes and tracks design phases such as Mood Board, "
"Visualization, and Handover."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’application Projet</font>"
"\n"
"      </strong> organise et suit les phases de conception, comme la planche "
"d’ambiance, la visualisation et la remise du projet."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Purchase App</font>\n"
"      </strong> manages vendor orders and procures furniture, materials, and "
"fittings for projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’application Achats</font>"
"\n"
"      </strong> gère les commandes fournisseurs et l’approvisionnement en "
"mobilier, matériaux et équipements pour les projets."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Sales App</font>\n"
"      </strong> creates and manages quotations and sales orders for design "
"projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’application Ventes</font>"
"\n"
"      </strong> crée et gère les devis et les commandes clients pour les "
"projets d’aménagement."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Timesheets App</font>\n"
"      </strong> tracks hours spent on creative design work for accurate "
"costing and billing."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’application Feuilles de "
"temps</font>\n"
"      </strong> suit le temps consacré au travail de conception afin de "
"calculer précisément les coûts et la facturation."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Website App</font>\n"
"      </strong> generates leads by showcasing your portfolio and allowing "
"clients to reach out through a contact form."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’application Site Web</"
"font>\n"
"      </strong> génère des pistes commerciales en présentant votre portfolio "
"et en permettant aux clients de vous contacter via un formulaire."

