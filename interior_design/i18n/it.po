#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The CRM App</font>\n"
"      </strong> captures and tracks potential clients, manages site visit scheduling, and monitors lead progress."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’app CRM</font>\n"
"      </strong> acquisisce e tiene traccia dei potenziali clienti, gestisce "
"la pianificazione delle visite in loco e monitora lo stato di avanzamento "
"dei lead."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Document App</font>\n"
"      </strong> will have the designs shared with the customers at a centralised place."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’app Documenti</font>\n"
"      </strong> consente di condividere i progetti con i clienti in un unico "
"luogo centralizzato."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Planning App</font>\n"
"      </strong> to assign the tasks and plan the work for the resources."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L'app Pianificazione</font>"
"\n"
"      </strong> è utile per assegnare i compiti e pianificare il lavoro "
"delle risorse."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Project App</font>\n"
"      </strong> organizes and tracks design phases such as Mood Board, Visualization, and Handover."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’app Progetti</font>\n"
"      </strong> consente di organizzare e tenere traccia delle fasi di "
"progettazione quali mood board, visualizzazione e consegna."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Purchase App</font>\n"
"      </strong> manages vendor orders and procures furniture, materials, and fittings for projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’app Acquisti</font>\n"
"      </strong> gestisce gli ordini dei fornitori e si occupa "
"dell’approvvigionamento di mobili, materiali e accessori per i progetti."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Sales App</font>\n"
"      </strong> creates and manages quotations and sales orders for design projects."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L'app Vendite</font>\n"
"      </strong> crea e gestisce preventivi e ordini di vendita per progetti "
"di design."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Timesheets App</font>\n"
"      </strong> tracks hours spent on creative design work for accurate costing and billing."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L’app Fogli ore</font>\n"
"      </strong> tiene traccia delle ore dedicate al lavoro di progettazione "
"creativa per un calcolo accurato dei costi e della fatturazione."

#. module: interior_design
#: model_terms:ir.ui.view,arch_db:interior_design.welcome_article_body
msgid ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">The Website App</font>\n"
"      </strong> generates leads by showcasing your portfolio and allowing clients to reach out through a contact form."
msgstr ""
"<strong>\n"
"      <font style=\"color: rgb(198, 123, 165);\">L'app Sito web</font>\n"
"      </strong> genera contatti mettendo in evidenza il tuo portfolio e "
"consentendo ai clienti di contattarti tramite un modulo di contatto."

