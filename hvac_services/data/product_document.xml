<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="template_document_1" model="product.document" forcecreate="0">
        <field name="name">LG S12ET Brochure.pdf</field>
        <field name="raw" type="bytes" file="hvac_services/static/src/binary/ir_attachment/LG S12ET Brochure.pdf" />
        <field name="res_model">product.template</field>
        <field name="attached_on_sale">quotation</field>
        <field name="res_id" ref="product_template_6"/>
    </record>
    <record id="template_document_2" model="product.document" forcecreate="0">
        <field name="name">LG S12ET Installation Manual.pdf</field>
        <field name="raw" type="bytes" file="hvac_services/static/src/binary/ir_attachment/LG S12ET Installation Manual.pdf" />
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_template_6"/>
    </record>
    <record id="template_document_3" model="product.document" forcecreate="0">
        <field name="name">LG S12ET Maintenance Manual.pdf</field>
        <field name="raw" type="bytes" file="hvac_services/static/src/binary/ir_attachment/LG S12ET Maintenance Manual.pdf" />
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_template_6"/>
    </record>
    <function model="documents.document" name="write">
        <value model="product.document" eval="obj(ref('template_document_1')).document_ids.ids"/>
        <value eval="{'tag_ids': [(6, 0, [ref('documents_tag_3')])]}"/>
    </function>
    <function model="documents.document" name="write">
        <value model="product.document" eval="obj(ref('template_document_2')).document_ids.ids"/>
        <value eval="{'tag_ids': [(6, 0, [ref('documents_tag_1')])]}"/>
    </function>
    <function model="documents.document" name="write">
        <value model="product.document" eval="obj(ref('template_document_3')).document_ids.ids"/>
        <value eval="{'tag_ids': [(6, 0, [ref('documents_tag_2')])]}"/>
    </function>
</odoo>
