#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
#, fuzzy
msgid ""
"<strong><b>Appointments App</b>:</strong> Let families book meetings to "
"discuss camp options easily, reducing no-shows with automatic reminders.<br/>"
msgstr ""
"<strong><b>Aplikacija za sestanke</b>:</strong> Družinam omogočite, da "
"preprosto rezervirajo sestanke za pogovor o možnostih taborov, ter "
"zmanjšajte število neudeležb z avtomatskimi opomniki.<br/>"

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
#, fuzzy
msgid ""
"<strong><b>CRM App</b>: </strong>Capture inquiries from your website, "
"qualify leads in a visual pipeline, and convert interest into confirmed "
"bookings.<br/>"
msgstr ""
"<strong><b>Aplikacija CRM</b>: </strong>Zajemite povpraševanja s svojega "
"spletnega mesta, kvalificirajte potencialne stranke v vizualnem prodajnem "
"toku in pretvorite zanimanje v potrjene rezervacije.<br/>"

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
#, fuzzy
msgid ""
"<strong><b>Events App</b>: </strong>Create and manage every camp session "
"with custom forms, capacity tracking, and automated emails to keep parents "
"informed.<br/>"
msgstr ""
"<strong><b>Aplikacija Dogodki</b>: </strong>Ustvarite in upravljajte vsak "
"termin tabora s prilagojenimi obrazci, spremljanjem zmogljivosti in "
"samodejnimi e-poštnimi sporočili, da bodo starši obveščeni.<br/>"

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
#, fuzzy
msgid ""
"<strong><b>Projects App</b>: </strong>Organize the behind-the-scenes "
"logistics using task lists and deadlines to ensure every activity is "
"prepared to perfection.<br/>"
msgstr ""
"<strong><b>Aplikacija Projekti</b>: </strong>Organizirajte logistiko v "
"ozadju s pomočjo seznamov opravil in rokov, da zagotovite, da je vsaka "
"dejavnost brezhibno pripravljena.<br/>"

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
#, fuzzy
msgid ""
"<strong><b>Sign App</b>: </strong>Collect parental consent securely with "
"reusable digital signature templates, ensuring all legal documents are "
"signed and stored centrally.<br/>"
msgstr ""
"<strong><b>Sign App</b>: </strong>Varno zbirajte soglasja staršev s "
"predlogami za digitalno podpisovanje za večkratno uporabo ter zagotovite, da "
"so vsi pravni dokumenti podpisani in centralno shranjeni.<br/>"

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
#, fuzzy
