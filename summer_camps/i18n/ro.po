msgstr "<strong>Odoo te ajută să:</strong>"

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
msgid ""
"<strong>Organize opportunities by stage</strong> (e.g., New, Contacted, "
"Quotation Sent, Confirmed) using a visual kanban pipeline."
msgstr ""
"<strong>Organizezi oportunitățile pe etape</strong> (de ex., Nouă, "
"Contactată, Ofertă trimisă, Confirmată) folosind un flux vizual kanban."

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
msgid "<strong>Projects 📋</strong>"
msgstr "<strong>Proiecte 📋</strong>"

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
msgid ""
"<strong>Schedule meetings or calls</strong> directly from the CRM and sync "
"with your calendar."
msgstr ""
"<strong>Programezi întâlniri sau apeluri</strong> direct din CRM și le "
"sincronizezi cu calendarul."

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
msgid "<strong>Sign ✍️</strong>"
msgstr "<strong>Semnare ✍️</strong>"

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
msgid ""
"<strong>Social Marketing 💊</strong>: Share updates and stories across "
"social media platforms."
msgstr ""
"<strong>Social Marketing 💊</strong>: Distribuie actualizări și povești pe "
"platformele de socializare."

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
msgid ""
"<strong>Survey 📊</strong>: Collect feedback from parents and campers to "
"improve future sessions."
msgstr ""
"<strong>Sondaj 📊</strong>: Colectează feedback de la părinți și copii "
"pentru a îmbunătăți sesiunile viitoare."

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
msgid ""
"<strong>Sync with Google or Outlook calendars</strong> to prevent conflicts "
"and stay updated."
msgstr ""
"<strong>Sincronizează calendarele Google sau Outlook</strong> pentru a evita "
"conflictele și a rămâne la curent."

#. module: summer_camps
#: model_terms:ir.ui.view,arch_db:summer_camps.welcome_article_body
msgid ""
"<strong>Take notes, log calls, and attach documents</strong> on the "
"opportunity record to centralize communication."
msgstr ""
"<strong>Adaugă note, înregistrează apeluri și atașează documente</strong> la "
"înregistrarea oportunității pentru a centraliza comunicarea."

