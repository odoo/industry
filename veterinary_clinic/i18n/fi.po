#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>\n"
"            Use the Sign App to manage consent forms, employee contracts, "
"and more !<br/>\n"
"            <br/>\n"
"        </strong>"
msgstr ""
"<strong>\n"
"            Käytä Allekirjoita-sovellusta suostumuslomakkeiden, "
"työsopimusten ja muiden asiakirjojen hallinnoimiseen!<br/>\n"
"            <br/>\n"
"        </strong>"

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong><b>Appointments App</b>:</strong> Streamline the booking process for "
"pet owners, allowing them to\n"
"                schedule check-ups and surgeries online 24/7.<br/>"
msgstr ""
"<strong><b>Ajanvaraukset-sovellus</b>:</strong> Suoraviivaista "
"lemmikinomistajien ajanvarausprosessia mahdollistamalla\n"
"                ympärivuorokautisen tarkastuskäyntien ja leikkausten "
"varaamisen verkossa.<br/>"

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong><b>Invoicing App</b>:</strong> Simplify your finances by "
"automatically generating invoices from\n"
"                completed consultations and product sales.<br/>"
msgstr ""
"<strong><b>Laskutus-sovellus</b>:</strong> Yksinkertaista taloudenhoitoasi "
"luomalla automaattisesti laskuja\n"
"                suoritetuista konsultoinneista ja tuotemyynnistä.<br/>"

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong><b>Marketing App</b>: </strong>Engage your community with targeted "
"email campaigns for vaccination\n"
"                reminders and seasonal health check-ups.<br/>"
msgstr ""
"<strong><b>Markkinointi-sovellus</b>: </strong>Sitouta yhteisöäsi "
"kohdennetuilla sähköpostikampanjoilla, joissa muistutetaan rokotuksista\n"
"                ja kausittaisista terveystarkastuksista.<br/>"

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Facilitate a smooth checkout "
"experience by linking consultations and\n"
"                product sales directly to your payment terminal.<br/>"
msgstr ""
"<strong><b>Kassajärjestelmä-sovellus</b>: </strong>Tee maksukokemuksesta "
"sujuva linkittämällä konsultaatiot ja\n"
"                tuotemyynti suoraan maksupäätteeseesi.<br/>"

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong><b>Website App</b>: </strong>Build a professional online presence to "
"market your clinic, share health\n"
"                tips, and attract new pet owners.<br/>"
msgstr ""
"<strong><b>Verkkosivu-sovellus</b>: </strong>Luo ammattimainen "
"verkkonäkyvyys klinikkasi markkinoimiseksi, terveysvinkkien jakamiseksi\n"
"                ja uusien lemmikinomistajien houkuttelemiseksi.<br/>"

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid "<strong><span class=\"h2-fs\">Tips for Success</span></strong>"
msgstr "<strong><span class=\"h2-fs\">Menestysvinkkejä</span></strong>"

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Attachments</strong> store lab results, X‑rays, or referral letters "
"alongside notes in the <strong>Lab Tests &amp; Diagnostics tab</strong>."
msgstr ""
"<strong>Liitteet</strong> tallenna laboratoriotulokset, röntgenkuvat tai "
"lähetteet muistiinpanoineen <strong>Laboratoriotutkimukset &amp; "
"Diagnostiikka -välilehdelle</strong>."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Automate reminders.</strong> SMS or email nudges cut no‑shows and "
"keep vaccinations on schedule."
msgstr ""
"<strong>Automatisoi muistutukset.</strong> Tekstiviestit tai "
"sähköpostiviestit vähentävät peruutuksia ja pitävät rokotukset aikataulussa."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Automatic confirmations &amp; reminders</strong> via email/SMS keep "
"owners informed."
msgstr ""
"<strong>Automaattiset vahvistukset &amp; muistutukset</strong> sähköpostitse/"
"tekstiviestitse pitävät omistajat ajan tasalla."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Barcode &amp; RFID</strong> scanning speeds up product selection."
msgstr ""
"<strong>Viivakoodi- &amp; RFID</strong>-skannaus nopeuttaa tuotteiden "
"valintaa."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Booking widget</strong> automatically links to the Appointment app "
"for real‑time availability."
msgstr ""
"<strong>Varauswidget</strong> linkittyy automaattisesti Ajanvaraukset-"
"sovellukseen, josta näet reaaliaikaisen saatavuuden."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid "<strong>Buffer times</strong> between consults prevent overruns."
msgstr ""
"<strong>Puskuriajat</strong> konsultaatioiden välillä estävät päällekkyydet."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Custom fields</strong> capture weight, insurance, behavior notes, or "
"anything you need."
msgstr ""
"<strong>Mukautettavat kentät</strong> tallentavat painon, vakuutustiedot, "
"käyttäytymistä koskevat huomautukset tai mitä tahansa muut tarvitsemasi "
"tiedot."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Drag‑and‑drop builder</strong> to create service, team, and FAQ "
"pages in minutes."
msgstr ""
"<strong>Raahaa ja pudota -rakennustyökalu</strong> palveluiden, tiimien ja "
"FAQ-sivujen luomiseen minuuteissa."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Electronic signatures</strong> accelerate acceptance for surgeries "
"or long‑term care plans."
msgstr ""
"<strong>Sähköiset allekirjoitukset</strong> nopeuttavat leikkausten tai "
"pitkäaikaishoidon suunnitelmien hyväksymistä."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Experiment ! </strong>Did you know you can create a copy of your "
"database to try things out ? Simply go to"
msgstr ""
"<strong>Testaile!</strong>Tiesitkö, että voit luoda kopion tietokannastasi "
"toimintojen testaamiseksi? Siirry"

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Live chat</strong> answers visitor questions and captures leads 24/7."
msgstr ""
"<strong>Livechat</strong> vastaa kävijöiden kysymyksiin ja kerää liidejä "
"ympäri vuorokauden."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid "<strong>Lot/serial tracking</strong> meets pharmaceutical compliance."
msgstr ""
"<strong>Erä-/sarjanumeroiden seuranta</strong> täyttää lääkealan vaatimukset."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Multiple payment methods</strong> (cash, card, vouchers) in one "
"screen."
msgstr ""
"<strong>Useita maksutapoja</strong> (käteinen, kortti, lahjakortit) yhdellä "
"näytöllä."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Multiple units</strong> (dose, box, bottle) with automatic "
"conversions."
msgstr ""
"<strong>Useita mittayksiköitä</strong> (annos, laatikko, pullo) "
"automaattisine muunnoksineen."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>One‑click product picker</strong> adds vaccines or meds directly to "
"the visit through the <strong>catalog</strong>."
msgstr ""
"<strong>Yhden klikkauksen tuotevalitsin</strong> lisää rokotteet tai "
"lääkkeet suoraan käyntiin <strong>katalogin</strong> kautta."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>One‑click quotation</strong> from consultation converts to invoice "
"or POS ticket."
msgstr ""
"<strong>Yhden klikkauksen konsultaatiotarjous</strong> muuntuu laskuksi tai "
"kassajärjestelmän kuitiksi."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Online calendar</strong> shows real‑time slots for each vet or room."
msgstr ""
"<strong>Verkkokalenteri</strong> näyttää kunkin eläinlääkärin tai huoneen "
"vapaat ajat reaaliajassa."

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Our Appointment app enables self‑service booking, calendar sync, and "
"effortless follow‑ups.</strong>"
msgstr ""
"<strong>Ajanvaraukset-sovelluksemme mahdollistaa itsepalveluvaraukset, "
"kalenterin synkronoinnin ja vaivattomat seurantatoiminnot.</strong>"

#. module: veterinary_clinic
#: model_terms:ir.ui.view,arch_db:veterinary_clinic.welcome_article_body
msgid ""
"<strong>Our Consultation sheets record symptoms, vitals, and actions while "
