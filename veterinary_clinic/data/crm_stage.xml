<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <record id="stage_lead1" model="crm.stage">
    <field name="name">New request</field>
    <field name="sequence">1</field>
  </record>
  <record id="stage_lead2" model="crm.stage">
    <field name="name">Validated</field>
    <field name="sequence">2</field>
  </record>
  <record id="stage_lead4" model="crm.stage">
    <field name="name">Booked</field>
    <field name="fold" eval="False"/>
    <field name="is_won">True</field>
    <field name="sequence">70</field>
  </record>
  <function model="crm.stage" name="unlink">
    <value eval="[ref('crm.stage_lead1'), ref('crm.stage_lead2'), ref('crm.stage_lead4')]"/>
  </function>
</odoo>
