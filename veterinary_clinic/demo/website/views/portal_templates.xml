<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="user_sign_in" model="ir.ui.view">
        <field name="name">Custom - User Sign In</field>
        <field name="inherit_id" ref="portal.user_sign_in"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//a" position="attributes">
                <!-- Inline !important: the home page forces text-o-color-4 on
                #top, which is itself !important and would win over a class. -->
                <attribute name="style">color: #ffffff !important; border-color: #ffffff !important;</attribute>
            </xpath>
        </field>
    </record>
</odoo>
