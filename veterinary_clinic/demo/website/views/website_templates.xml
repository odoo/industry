<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <!-- No key on purpose: sharing the key of the view we inherit makes
        filter_duplicate() drop that parent, which orphans this view. -->
        <field name="inherit_id" ref="website.footer_copyright_company_name"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small">©&amp;nbsp;Victoria Veterinary Clinic Ltd. Registered with the RCVS.</span>
            </xpath>
        </field>
    </record>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-right-width: 0px;">
                    <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="pt24 o_colored_level col-lg-3 pb24">
                                    <h5><img src="/web/image/veterinary_clinic.img_custom_image_23" alt="" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="664" data-mimetype="image/webp" style="width: 50% !important;" loading="lazy"/></h5><p><span style="color: rgba(246, 245, 244, 0.51);">An independent small-animal practice in Pimlico, caring for London's pets since 1998.</span></p><div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h4 class="s_social_media_title d-none">Social Media</h4>
                                        <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="fa fa-facebook o_editable_media rounded-empty-circle shadow-sm"/>
                                        </a>
                                        <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="fa fa-twitter o_editable_media rounded-empty-circle shadow-sm"/>
                                        </a>
                                        <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                            <i class="fa fa-linkedin o_editable_media rounded-empty-circle shadow-sm"/>
                                        </a>
                                    </div>
                                </div><div class="pt24 pb24 o_colored_level col-lg-2 offset-lg-1">
                                    <h5>USEFUL LINKS</h5>
                                    <ul class="list-unstyled">
                                        <li><a href="/">Home</a></li>
                                        <li><a href="/appointment">Appointments</a></li><li><a href="/contactus">Contact us</a></li>
                                    </ul>
                                </div>
                                <div class="pt24 pb24 o_colored_level col-lg-4 offset-lg-1">
                                    <h5>VISIT US</h5>
                                    <div><span style="font-size: 16px; color: rgba(246, 245, 244, 0.51);">42 Warwick Way</span></div><div><span style="font-size: 16px; color: rgba(246, 245, 244, 0.51);">Pimlico, London SW1V 1RY</span></div><div><span style="font-size: 16px; color: rgba(246, 245, 244, 0.51);">020 7946 0812</span></div><p class="lead"><span style="font-size: 16px; color: rgba(246, 245, 244, 0.51);"><a href="http://hello@victoriavets.co.uk" class="o_translate_inline">hello@victoriavets.co.uk</a></span><br/></p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <!-- No key on purpose: see footer_copyright_company_name above. -->
        <field name="inherit_id" ref="website.header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr=".//li" position="replace">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-custom" style="color:rgb(250, 250, 250); background-color: rgb(20, 124, 43); border-width: 0px; border-color: rgb(13, 38, 25); border-style: solid; ">Contact Us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <function model="ir.model.fields" name="formbuilder_whitelist">
      <value eval="'crm.lead'"/>
      <value eval="['tag_ids']"/>
    </function>
</odoo>
