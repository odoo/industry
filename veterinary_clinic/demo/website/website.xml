<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="website_industry" model="website">
        <field name="name">Victoria Vets</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="user_id" ref="base.public_user"/>
        <!-- Salesperson of the leads created by the "Contact Us" form, so they
        show up in the default "My Pipeline" filter. -->
        <field name="crm_default_user_id" ref="base.user_admin"/>
        <field name="logo" type="bytes" file="veterinary_clinic/static/src/img/content/website/logo.webp"/>
        <field name="favicon" type="bytes" file="veterinary_clinic/static/description/favicon.png"/>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[
            ('name', '=', 'default_website'),
            ('module', '=', 'base'),
            ('model', '=', 'website')
        ]"/>
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
</odoo>
