    <!-- Replace the crm.tag placeholders in the "Purpose of the visit" field by
    real ids. Kept outside the noupdate block below so it runs again on every
    module update, after the view arch was reloaded with the placeholders. -->
    <function model="ir.ui.view" name="write">
        <value eval="[ref('veterinary_clinic.view_page_contactus')]"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('veterinary_clinic.view_page_contactus').arch.replace(
                '*surgery_tag*', str(obj().env.ref('veterinary_clinic.crm_tag_1').id)
             ).replace(
                '*first_visit_tag*', str(obj().env.ref('veterinary_clinic.crm_tag_2').id)
             ).replace(
                '*dental_checkup_tag*', str(obj().env.ref('veterinary_clinic.crm_tag_3').id)
             ).replace(
                '*active_treatment_tag*', str(obj().env.ref('veterinary_clinic.crm_tag_4').id)
            )
        }"/>
    </function>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
