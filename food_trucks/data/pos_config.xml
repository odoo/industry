<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <function model="pos.config" name="load_onboarding_restaurant_scenario">
    <value name="with_demo_data" model="ir.module.module" eval="obj().search([('name', '=', 'food_trucks')]).demo"/>
  </function>
  <!-- temporarily close the session to remove the floor plans -->
  <function model="pos.session" name="write">
      <value model="pos.session" eval="ref('pos_restaurant.pos_open_session_2', raise_if_not_found=False)"/>
      <value eval="{'state': 'closed'}"/>
  </function>
  <function model="ir.model.data" name="write">
    <value model="ir.model.data" search="[
        ('name', '=', 'pos_config_main_restaurant'),
        ('module', '=', 'pos_restaurant'),
        ('model', '=', 'pos.config'),
    ]"/>
    <value eval="{'module': 'food_trucks', 'name': 'pos_config_1'}"/>
  </function>
  <record id="pos_config_1" model="pos.config">
    <field name="name">Food Truck</field>
    <field name="floor_ids" eval="False"/>
  </record>
  <function model="pos.session" name="write">
      <value model="pos.session" eval="ref('pos_restaurant.pos_open_session_2', raise_if_not_found=False)"/>
      <value eval="{'state': 'opening_control'}"/>
  </function>
</odoo>
