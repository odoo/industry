#. module: software_reseller
#: model_terms:ir.ui.view,arch_db:software_reseller.welcome_article_body
msgid ""
"<span style=\"font-size: 14px;\">\n"
"                This setup if for IT companies reselling software licenses, "
"and consulting services. The typical sale is a 1 year Oracle Database "
"license that is purchased to Oracle, and resold to client at a margin, with "
"extra services to setup\n"
"                the database.\n"
"            </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"                Тази настройка е за ИТ компании, които препродават софтуерни "
"лицензи и консултантски услуги. Типичната продажба е едногодишен лиценз за "
"Oracle Database, който се купува от Oracle и се препродава на клиента с "
"надценка, заедно с допълнителни услуги за настройка\n"
"                на базата данни.\n"
"            </span>"

#. module: software_reseller
#: model_terms:ir.ui.view,arch_db:software_reseller.welcome_article_body
msgid ""
"<span style=\"font-size: 36px;\">Software Resellers, IT Services</span><br/>"
msgstr ""
"<span style=\"font-size: 36px;\">Дистрибутори на софтуер, ИТ услуги</span>"
"<br/>"

