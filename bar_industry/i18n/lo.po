#. module: bar_industry
#: model_terms:ir.ui.view,arch_db:bar_industry.welcome_article_body
msgid "<span class=\"h1-fs\"><strong>Basics:</strong></span>"
msgstr "<span class=\"h1-fs\"><strong>ພື້ນຖານ:</strong></span>"

#. module: bar_industry
#: model_terms:ir.ui.view,arch_db:bar_industry.welcome_article_body
msgid ""
"<span class=\"h1-fs\"><strong>Do you want to go further?</strong></span>"
msgstr ""
"<span class=\"h1-fs\"><strong>ທ່ານຕ້ອງການຮຽນຮູ້ເພີ່ມເຕີມບໍ່?</strong></span>"

#. module: bar_industry
#: model_terms:ir.ui.view,arch_db:bar_industry.welcome_article_body
msgid "<span class=\"h1-fs\"><strong>Use case:</strong></span>"
msgstr "<span class=\"h1-fs\"><strong>ກໍລະນີການນຳໃຊ້:</strong></span>"

#. module: bar_industry
#: model_terms:ir.ui.view,arch_db:bar_industry.welcome_article_body
msgid ""
"<strong>1. Flow 1:</strong> Most products need a human assessment as the "
"remaining quantity cannot be automatically computed. For those, a Recurring "
"Task is created in the Project App. This task reappears every week, and you "
"can personalize it with a checklist to avoid forgetting anything."
msgstr ""
"<strong>1. ຂັ້ນຕອນ 1:</strong> ສິນຄ້າສ່ວນໃຫຍ່ຕ້ອງມີການກວດກາຕົວຈິງ ເນື່ອງຈາກຈຳນວນທີ່ເຫຼືອບໍ່ສາມາ"
"ດຄຳນວນແບບອັດຕະໂນມັດໄດ້. ສຳລັບສິນຄ້າເຫຼົ່ານັ້ນ, ວຽກທີ່ເກີດຂຶ້ນຊ້ຳ ຈະຖືກສ້າງຂຶ້ນໃນ ແອັບໂຄງການ. ວຽກນີ້ຈະ"
"ສະແດງຂຶ້ນທຸກໆອາທິດ, ແລະ ທ່ານສາມາດປັບແຕ່ງລາຍການກວດສອບໄດ້ ເພື່ອປ້ອງກັນການຕົກຫຼົ່ນ."

#. module: bar_industry
#: model_terms:ir.ui.view,arch_db:bar_industry.welcome_article_body
msgid ""
"<strong>2. Flow 2:</strong> For products that can be tracked, such as "
"bottled beers and sodas, you can use automated purchases. To try it, "
"navigate to your Point of Sale and sell a Blond Beer to a customer."
msgstr ""
"<strong>2. ຂັ້ນຕອນ 2:</strong> ສຳລັບສິນຄ້າທີ່ສາມາດຕິດຕາມສະຕັອກໄດ້ ເຊັ່ນ: ເບຍຂວດ ແລະ ນ້ຳອັດລົ"
"ມ, ທ່ານສາມາດໃຊ້ການສັ່ງຊື້ອັດຕະໂນມັດໄດ້. ເພື່ອທົດລອງໃຊ້, ໃຫ້ເຂົ້າໄປທີ່ ຈຸດຂາຍ (POS) ແລ້ວຂາຍ Blond "
"Beer ໃຫ້ລູກຄ້າ."

#. module: bar_industry
#: model_terms:ir.ui.view,arch_db:bar_industry.welcome_article_body
msgid "<strong><span class=\"display-4-fs\">Bar</span></strong><br/>"
msgstr "<strong><span class=\"display-4-fs\">ບາຣ໌</span></strong><br/>"

#. module: bar_industry
#: model_terms:ir.ui.view,arch_db:bar_industry.welcome_article_body
msgid ""
"A free, personalized, integrated <strong><font class=\"text-o-"
"color-1\">Website</font></strong> in a few clicks. Start receiving orders "
"directly in Odoo or go live with your \n"
"                        <strong><font class=\"text-o-color-1\">E-shop</"
"font></strong> in a few minutes."
msgstr ""
"ສ້າງ <strong><font class=\"text-o-color-1\">ເວັບໄຊທ໌</font></strong> ຟຣີ, ປັບແຕ່ງໄ"
"ດ້ ແລະ ເຊື່ອມໂຍງຄົບວົງຈອນ ພຽງບໍ່ເທົ່າໃດຄລິກ. ເລີ່ມຮັບອໍເດີໂດຍກົງໃນ Odoo ຫຼື ເປີດຮ້ານຄ້າອອນລາຍຂອງທ່າ"
"ນ \n"
"                        <strong><font class=\"text-o-color-1\">E-shop</font>"
"</strong> ໄດ້ພາຍໃນບໍ່ເທົ່າໃດນາທີ."

#. module: bar_industry
#: model:product.template,name:bar_industry.product_product_31_product_template
msgid "Aperol"
msgstr "ອາເປໂຣລ"

#. module: bar_industry
#: model_terms:ir.ui.view,arch_db:bar_industry.welcome_article_body
msgid ""
"As an administrator your pin is 3333. You can edit the pin of your employees "
"in the Employee App, in the Settings tab."
msgstr ""
"ໃນຖານະຜູ້ເບິ່ງແຍງລະບົບ, ລະຫັດ PIN ຂອງທ່ານແມ່ນ 3333. ທ່ານສາມາດແກ້ໄຂ PIN ຂອງພະນັກງານໄດ້ໃນ ແ"
"ອັບພະນັກງານ, ທີ່ແຖບ ການຕັ້ງຄ່າ."

#. module: bar_industry
#: model_terms:ir.ui.view,arch_db:bar_industry.welcome_article_body
msgid ""
"At the end of your service, remember to close your register. To do so, in "
"the Point of Sale App, select \"Close Register\" in the top-right menu. You "
"can then precise your cash amount and validate the closing."
msgstr ""
"ເມື່ອສິ້ນສຸດການບໍລິການ, ຢ່າລືມປິດຮອບການຂາຍ. ໂດຍເຂົ້າໄປທີ່ ແອັບຈຸດຂາຍ (POS), ເລືອກ \"ປິດຮອບການຂາ"
"ຍ\" ຢູ່ເມນູມຸມຂວາເທິງ. ຈາກນັ້ນລະບຸຈຳນວນເງິນສົດ ແລະ ຢືນຢັນການປິດຮອບ."

