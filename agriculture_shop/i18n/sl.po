#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b><font class=\"text-o-color-1\">Inventory App:</font></b> Keep precise "
"track of stock levels for diverse products\n"
"                like pesticides and equipment."
msgstr ""
"<b><font class=\"text-o-color-1\">Aplikacija Zaloga:</font></b> Natančno "
"spremljajte stanje zaloge za različne izdelke\n"
"                kot so pesticidi in oprema."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b><font class=\"text-o-color-1\">Point of Sale App:</font></b> Manage in-"
"store transactions efficiently, handling sales of seeds, tools, and supplies "
"with ease."
msgstr ""
"<b><font class=\"text-o-color-1\">Aplikacija prodajne točke:</font></b> "
"Učinkovito upravljajte transakcije v trgovini in zlahka obravnavajte prodajo "
"semen, orodij in potrebščin."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b><font class=\"text-o-color-1\">Purchase App:</font></b> Streamline the "
"procurement of farming products from suppliers, managing costs and lead "
"times."
msgstr ""
"<b><font class=\"text-o-color-1\">Nakupna aplikacija:</font></b> "
"Poenostavite oskrbo kmetijskih izdelkov od dobaviteljev z upravljanjem "
"stroškov in dobavnih rokov."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b><font class=\"text-o-color-1\">Sales App:</font></b> Handle B2B orders "
"and contracts for large farming clients, ensuring accurate pricing."
msgstr ""
"<b><font class=\"text-o-color-1\">Prodajna aplikacija:</font></b> "
"Upravljajte B2B naročila in pogodbe za velike kmetijske stranke ter "
"zagotavljajte natančno določanje cen."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b><font class=\"text-o-color-1\">Website App:</font></b><font class=\"text-"
"o-color-3\"> Build a professional online presence to showcase your catalog "
"and attract new customers.</font>"
msgstr ""
"<b><font class=\"text-o-color-1\">Aplikacija za spletno stran:</font></b>"
"<font class=\"text-o-color-3\"> Zgradite profesionalno spletno prisotnost za "
"predstavitev vašega kataloga in privabljanje novih strank.</font>"

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b><font class=\"text-o-color-1\">eCommerce App:</font></b> Expand your "
"reach by selling products online, offering convenience to modern farmers."
msgstr ""
"<b><font class=\"text-o-color-1\">Aplikacija za e-trgovino:</font></b> "
"Razširite svoj doseg z prodajo izdelkov na spletu, saj sodobnim kmetom "
"ponudite več udobja."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Accounting:</b> Automatically log payments, close sessions, and generate "
"tax\n"
"                    reports."
msgstr ""
"<b>Računovodstvo:</b> Samodejno beleži plačila, zapira seje in ustvarja "
"davčna\n"
"                    poročila."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Automated Trigger</b> will instantly create a\n"
"                    purchase order."
msgstr ""
"<b>Samodejni sprožilec</b> bo takoj ustvaril\n"
"                    naročilo za nakup."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Automatic Delivery:</b> Once the quote is\n"
"                    accepted, the system automatically creates a linked "
"<b>Delivery Order</b>, just\n"
"                    as it does for a regular e-commerce order."
msgstr ""
"<b>Samodejna dostava:</b> Ko je predračun\n"
"                    sprejet, sistem samodejno ustvari povezan <b>Dobavni "
"nalog</b>, enako\n"
"                    kot to stori za običajno e-trgovinsko naročilo."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Capture Requests:</b> Any submission via the <b>\"Contact\n"
"                    Us\"</b> page instantly generates a new <b>CRM "
"opportunity</b>."
msgstr ""
"<b>Zajem zahtevkov:</b> Vsaka oddaja prek strani <b>\"Kontaktirajte\n"
"                    nas\"</b> takoj ustvari novo <b>CRM priložnost</b>."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Crucial Review:</b> You must review all\n"
"                    e-commerce settings to ensure they align with your "
"internal business policies\n"
"                    (e.g., when invoices are generated, whether a mandatory "
"customer check-in is\n"
"                    required for ordering, etc.)."
msgstr ""
"<b>Ključen pregled:</b> Preglejte vse\n"
"                    nastavitve e-trgovine, da se prepričate, da so usklajene "
"z vašimi notranjimi poslovnimi politikami\n"
"                    (npr. kdaj se izdajo računi, ali je za naročanje obvezna "
"prijava stranke\n"
"                    itd.)."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Define B2B Pricing:</b> Create and assign a <b>dedicated\n"
"                    pricelist</b> to each B2B contact. Ensure this pricelist "
"is active on your\n"
"                    website so the customer sees their agreed-upon prices "
"upon login."
msgstr ""
"<b>Določite B2B cenik:</b> Ustvarite in dodelite <b>poseben\n"
"                    cenik</b> vsakemu B2B kontaktu. Prepričajte se, da je ta "
"cenik aktiven na vaši\n"
"                    spletni strani, da stranka ob prijavi vidi dogovorjene "
"cene."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Delivery Methods:</b> Go to <b>Website &gt;\n"
"                    Configuration &gt; Delivery Methods</b> to define all "
"available options and\n"
"                    their costs."
msgstr ""
"<b>Načini dostave:</b> Pojdite na <b>Spletna stran &gt;\n"
"                    Konfiguracija &gt; Načini dostave</b> za določitev vseh "
"razpoložljivih možnosti in\n"
"                    njihovih stroškov."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>E-commerce Category:</b> For easier product\n"
"                    retrieval by customers on your online store."
msgstr ""
"<b>Kategorija e-trgovine:</b> Za lažje iskanje izdelkov\n"
"                    s strani strank v vaši spletni trgovini."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>External Providers:</b> Check if a\n"
"                            predefined Odoo connection exists if you work "
"with specific shipping\n"
"                            carriers."
msgstr ""
"<b>Zunanji ponudniki:</b> Preverite, ali obstaja\n"
"                            vnaprej določena Odoo povezava, če uporabljate "
"določene\n"
"                            dostavne prevoznike."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Field Service:</b> Implement this module if you <b>offer on-site repair "
"or\n"
"                maintenance services</b>."
msgstr ""
"<b>Terenska storitev:</b> Namestite ta modul, če ponujate <b>popravila na "
"lokaciji ali\n"
"                vzdrževalne storitve</b>."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>In-Store Pickup (Click &amp; Collect):</b>\n"
"                            If you wish to offer this, you must <b>activate "
"the setting</b> within\n"
"                            the <b>Website Settings</b> first."
msgstr ""
"<b>Prevzem v trgovini (Click &amp; Collect):</b>\n"
"                            Če želite to ponuditi, morate najprej <b>"
"aktivirati nastavitev</b> v\n"
"                            <b>Nastavitvah spletnega mesta</b>."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid "<b>Key Product Settings:</b>"
msgstr "<b>Ključne nastavitve izdelka:</b>"

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Layout Settings:</b> Adjust the visual\n"
"                    presentation and layout of products using the <b>website "
"editor</b>."
msgstr ""
"<b>Nastavitve razporeditve:</b> Prilagodite vizualno\n"
"                    predstavitev in postavitev izdelkov z uporabo <b>"
"urejevalnika spletnega mesta</b>."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Loyalty Programs:</b> Implement <b>loyalty cards</b> as a core\n"
"                            strategy to <b>activate customer retention</b> "
"and increase lifetime\n"
"                            value."
msgstr ""
"<b>Programi zvestobe:</b> Uvedite <b>zvestobne kartice</b> kot ključno\n"
"                            strategijo za <b>ohranitev strank</b> in "
"povečanje\n"
"                            življenjske vrednosti strank."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Manual Trigger</b> will display the demand in the\n"
"                    Inventory <b>Replenishment view </b>for you to confirm. "
"<i>(Note:\n"
"                    Reordering rules work in conjunction with defined lead "
"times.)</i>"
msgstr ""
"<b>Ročni sprožilec</b> bo prikazal zahtevo v\n"
"                    Zalogi <b>pogled dopolnjevanja </b>za potrditev. <i>"
"(Opomba:\n"
"                    Pravila za ponovno naročilo delujejo v povezavi z "
"opredeljenimi dobavnimi roki.)</i>"

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Optimal stock management</b> is achieved by <b>combining both the "
"Reordering Rules and\n"
"            Suggested Replenishment</b> to ensure a comprehensive, forecast-"
"aware stock follow-up."
msgstr ""
"<b>Optimalno upravljanje zaloge</b> je doseženo z <b>združevanjem pravil za "
"ponovno naročanje in\n"
"            predlaganega dopolnjevanja</b>, da zagotovimo celovito "
"spremljanje zaloge, ki upošteva napoved."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Payment Providers &amp; Methods:</b> Go to <b>Website\n"
"                    &gt; Configuration &gt; Payment Providers</b> and "
"install <b>all</b> the payment\n"
"                    methods and providers you plan to offer (e.g., credit "
"card processors, PayPal,\n"
"                    etc.)."
msgstr ""
"<b>Ponudniki plačil in metode:</b> Pojdite na <b>Spletna stran\n"
"                    &gt; Nastavitve &gt; Plačilni ponudniki</b> in namestite "
"<b>vse</b> plačilne\n"
"                    metode in ponudnike, ki jih nameravate ponuditi (npr. "
"obdelovalci kreditnih kartic, PayPal,\n"
"                    itd.)."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Payroll:</b> Use this feature to handle <b>employee salaries and manage "
"holiday\n"
"                requests</b>."
msgstr ""
"<b>Plačni seznam:</b> Uporabite to funkcijo za obravnavanje <b>plač kadra in "
"upravljanje zahtevkov za\n"
"                dopust</b>."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Point of Sale Category:</b> For organizing\n"
"                    transactions within your shop system."
msgstr ""
"<b>Kategorija prodajne točke:</b> Za organizacijo\n"
"                    transakcij znotraj vašega trgovinskega sistema."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Pricelist Segmentation:</b> Define multiple pricing structures for the\n"
"                            same product, supporting different business "
"models (e.g., B2B vs. B2C)\n"
"                            and enabling <b>client-specific pricing "
"contracts</b>."
msgstr ""
"<b>Segmentacija cenika:</b> Določite več cenovnih struktur za isti\n"
"                            izdelek, kar omogoča različne poslovne modele "
"(npr. B2B proti B2C)\n"
"                            in omogoča <b>pogodbe o cenah, prilagojene "
"stranki</b>."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Product Category:</b> For internal tracking and\n"
"                    reporting."
msgstr ""
"<b>Kategorija izdelka:</b> Za notranje sledenje in\n"
"                    poročanje."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Product-Level Settings:</b> Define core product\n"
"                    settings directly on the <b>product form</b>."
msgstr ""
"<b>Nastavitve na ravni izdelka:</b> Določite ključne nastavitve\n"
"                    neposredno v <b>obrazcu izdelka</b>."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Promotional Agility:</b> Use <b>discounts and promotions</b> to\n"
"                            quickly adjust pricing for sales events or to "
"give targeted, <b>manual\n"
"                            reductions</b> at the point of sale."
msgstr ""
"<b>Promocijska prilagodljivost:</b> Uporabite <b>popuste in promocije</b> "
"za\n"
"                            hitro prilagajanje cen za prodajne dogodke ali "
"dajete ciljno usmerjene, <b>ročne\n"
"                            znižave</b> na prodajni točki."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Publishing:</b> Each product can be <b>published\n"
"                    independently</b> on your online store."
msgstr ""
"<b>Objavljanje:</b> Vsak izdelek je lahko <b>objavljen\n"
"                    ločeno</b> v vaši spletni trgovini."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Qualify Leads:</b> Engage with the client through\n"
"                    the CRM opportunity to fully understand their request—"
"whether it's a need for a\n"
"                    specific product, a supplier inquiry, or general "
"information."
msgstr ""
"<b>Kvalificirajte potencialne stranke:</b> S stranko komunicirajte prek\n"
"                    priložnosti v CRM, da v celoti razumete njeno zahtevo—"
"naj gre za potrebo po\n"
"                    določenem izdelku, povpraševanje dobavitelja ali splošne "
"informacije."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
msgid ""
"<b>Quote and Confirm:</b> If a specific demand\n"
"                    requires pricing, generate a <b>quotation directly from "
"the opportunity</b>. The\n"
"                    client can then <b>confirm and sign it online</b>."
msgstr ""
"<b>Ponudba in potrditev:</b> Če določeno povpraševanje\n"
"                    potrebuje določitev cene, ustvarite <b>ponudbo "
"neposredno iz priložnosti</b>. Potem lahko\n"
"                    stranka <b>jo potrdi in podpiše na spletu</b>."

#. module: agriculture_shop
#: model_terms:ir.ui.view,arch_db:agriculture_shop.welcome_article_body
#, fuzzy
