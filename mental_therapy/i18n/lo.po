"<span class=\"display-4-fs\"><strong><font class=\"text-800\"><span "
"class=\"h1-fs\">ກໍລະນີການນຳໃຊ້</span></font></strong></span>"

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid "<span class=\"h1-fs\"><strong>Basics</strong></span>"
msgstr "<span class=\"h1-fs\"><strong>ພື້ນຖານ</strong></span>"

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"<span class=\"h1-fs\"><strong>Do you want to go further?</strong></span>"
msgstr ""
"<span class=\"h1-fs\"><strong>ທ່ານຕ້ອງການທີ່ຈະໄປຕໍ່ຕື່ມອີກບໍ່?</strong></span>"

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"<strong><font class=\"text-black\"><span style=\"font-weight: normal;"
"\">Manage your schedule and your availability in the </span></font><font "
"class=\"text-o-color-1\">Calendar App</font><font class=\"text-black\"><span "
"style=\"font-weight: normal;\">.</span></font></strong>"
msgstr ""
"<strong><font class=\"text-black\"><span style=\"font-weight: normal;\">ຈັດການ"
"ຕາຕະລາງເວລາ ແລະ ຄວາມພ້ອມຫວ່າງຂອງທ່ານໄດ້ໃນ </span></font><font class=\"text-o-"
"color-1\">ແອັບປະຕິທິນ</font><font class=\"text-black\"><span style=\"font-"
"weight: normal;\">.</span></font></strong>"

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"<strong><span class=\"display-4-fs\">Odoo for Mental Therapy</span></strong>"
msgstr ""
"<strong><span class=\"display-4-fs\">Odoo ສຳລັບການປິ່ນປົວສຸຂະພາບຈິດ</span></strong>"

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"A free, personalized, integrated<strong><font class=\"text-o-color-1\"> "
"Website </font></strong>in a few clicks. Get new leads or direct appointment "
"online in a few clicks."
msgstr ""
"<strong><font class=\"text-o-color-1\"> ເວັບໄຊຕ໌ </font></strong>ທີ່ຟຣີ, ປັບແຕ່ງໄດ້ຕາ"
"ມໃຈ ແລະ ເຊື່ອມໂຍງຄົບວົງຈອນ ພາຍໃນບໍ່ເທົ່າໃດຄລິກ. ຮັບລູກຄ້າທີ່ມຸ່ງຫວັງໃໝ່ ຫຼື ການນັດໝາຍໂດຍກົງທາງອອນລາ"
"ຍພາຍໃນບໍ່ເທົ່າໃດຄລິກ."

#. module: mental_therapy
#: model:crm.stage,name:mental_therapy.stage_lead4
msgid "Active Patients"
msgstr "ຄົນເຈັບທີ່ກຳລັງປິ່ນປົວ"

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid "Add an upfront payment in your Appointment Type."
msgstr "ເພີ່ມການຊຳລະເງິນລ່ວງໜ້າໃນປະເພດການນັດໝາຍຂອງທ່ານ."

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"Add the Subscription App and invoice automatically based on a subscription "
"type."
msgstr ""
"ເພີ່ມແອັບການສະໝັກສະມາຊິກ ແລະ ອອກໃບແຈ້ງໜີ້ອັດຕະໂນມັດຕາມປະເພດຂອງການສະໝັກສະມາຊິກ."

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"All emails sent and received are automatically recorded in the "
"<strong>Chatter</strong>, giving you a clear history of your communication "
"with the patient. Once the patient books an appointment, it is automatically "
"synchronized across CRM, Appointments, and Calendar, keeping your schedule "
"up to date without manual work."
msgstr ""
"ທຸກໆອີເມວທີ່ສົ່ງອອກ ແລະ ໄດ້ຮັບ ແມ່ນຈະຖືກບັນທຶກໄວ້ໃນ <strong>ຫ້ອງສົນທະນາ (Chatter)</strong> ໂ"
"ດຍອັດຕະໂນມັດ, ເຮັດໃຫ້ທ່ານເຫັນປະຫວັດການຕິດຕໍ່ສື່ສານກັບຄົນເຈັບຢ່າງຈະແຈ້ງ. ເມື່ອຄົນເຈັບຈອງເວລານັດໝາຍແລ້"
"ວ, ມັນຈະຖືກຊິ້ງຄ໌ເຂົ້າຫາກັນໂດຍອັດຕະໂນມັດລະຫວ່າງ CRM, ການນັດໝາຍ ແລະ ປະຕິທິນ, ເຊິ່ງຊ່ວຍໃຫ້ຕາຕະລາງ"
"ຂອງທ່ານອັບເດດຢູ່ສະເໝີໂດຍບໍ່ຕ້ອງເຮັດດ້ວຍຕົນເອງ."

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"As you review her needs, you move the opportunity to Qualified, indicating "
"that a consultation is required."
msgstr ""
"ເມື່ອທ່ານກວດສອບຄວາມຕ້ອງການຂອງລາວແລ້ວ, ທ່ານສາມາດຍ້າຍໂອກາດນັ້ນໄປທີ່ \"ຜ່ານການປະເມີນ "
"(Qualified)\", ເຊິ່ງສະແດງໃຫ້ເຫັນວ່າຈຳເປັນຕ້ອງມີການປຶກສາ."

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid "Auto-post your invoice on a regular basis."
msgstr "ລົງບັນຊີໃບແຈ້ງໜີ້ຂອງທ່ານໂດຍອັດຕະໂນມັດເປັນປະຈຳ."

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"Automated recurring invoicing with the <strong><font class=\"text-o-"
"color-1\">Subscription App</font></strong>."
msgstr ""
"ການອອກໃບແຈ້ງໜີ້ແບບປະຈຳອັດຕະໂນມັດດ້ວຍ <strong><font class=\"text-o-color-1\">ແອັບການສ"
"ະໝັກສະມາຊິກ</font></strong>."

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"Be careful, using the \"Log Note\" in your contact will be displayed only "
"for you and your eventual team. If you select the \"Send message\" option, "
"this will notify your customer (which can be really interesting also)."
msgstr ""
"ກະລຸນາລະວັງ, ການໃຊ້ \"ບັນທຶກຂໍ້ຄວາມ (Log Note)\" ໃນລາຍຊື່ຕິດຕໍ່ຂອງທ່ານ ຈະສະແດງໃຫ້ເຫັນສະເພາະທ່"
"ານ ແລະ ທີມງານຂອງທ່ານເທົ່ານັ້ນ. ຖ້າຫາກທ່ານເລືອກຕົວເລືອກ \"ສົ່ງຂໍ້ຄວາມ\", ສິ່ງນີ້ຈະແຈ້ງເຕືອນໄປຍັງລູກຄ້າ"
"ຂອງທ່ານ (ເຊິ່ງອາດມີປະໂຫຍດຫຼາຍເຊັ່ນກັນ)."

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid "Block time slots for treatments or personal availability"
msgstr "ປິດຊ່ວງເວລາໄວ້ສຳລັບການປິ່ນປົວ ຫຼື ເວລາຫວ່າງສ່ວນຕົວ"

#. module: mental_therapy
#: model:mail.template,name:mental_therapy.booking_suggestion
msgid "Book your next appointment"
msgstr "ຈອງນັດໝາຍຄັ້ງຕໍ່ໄປຂອງທ່ານ"

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"By doing this, the corresponding time slots are automatically reserved and "
"will no longer be available on the public booking link, ensuring your "
"availability remains accurate."
msgstr ""
"ດ້ວຍການເຮັດສິ່ງນີ້, ຊ່ວງເວລາທີ່ກ່ຽວຂ້ອງຈະຖືກຈອງໄວ້ໂດຍອັດຕະໂນມັດ ແລະ ຈະບໍ່ປາກົດໃຫ້ເລືອກໃນລິ້ງການຈອງແ"
"ບບສາທາລະນະອີກຕໍ່ໄປ, ເພື່ອຮັບປະກັນວ່າເວລາຫວ່າງຂອງທ່ານມີຄວາມຖືກຕ້ອງຊັດເຈນ."

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"By installing this package, you gain access to a set of essential "
"applications such as CRM, Appointments, Calendar, and Invoicing, allowing "
"you to focus on your patients/clients while Odoo handles your daily "
"operations."
msgstr ""
"ດ້ວຍການຕິດຕັ້ງແພັກເກດນີ້, ທ່ານຈະສາມາດເຂົ້າເຖິງຊຸດແອັບພລິເຄຊັນທີ່ຈຳເປັນ ເຊັ່ນ CRM, ການນັດໝາຍ, ປະຕິທິ"
"ນ ແລະ ການອອກໃບແຈ້ງໜີ້, ເຊິ່ງຊ່ວຍໃຫ້ທ່ານສາມາດສຸມໃສ່ການດູແລຄົນເຈັບ/ລູກຄ້າຂອງທ່ານ ໃນຂະນະທີ່ Odoo ຊ່"
"ວຍຈັດການວຽກງານປະຈຳວັນໃຫ້ທ່ານ."

#. module: mental_therapy
#: model_terms:ir.ui.view,arch_db:mental_therapy.welcome_article_body
msgid ""
"By uploading this module's demo data, your database has been filled with a "
"few contacts."
msgstr ""
