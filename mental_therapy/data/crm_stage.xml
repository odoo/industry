<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <record id="stage_lead3" model="crm.stage">
    <field name="name">Consultation</field>
    <field name="sequence">3</field>
  </record>
  <record id="stage_lead4" model="crm.stage">
    <field name="name">Active Patients</field>
    <field name="sequence">4</field>
    <field name="is_won" eval="True"/>
  </record>
  <record id="crm_stage_5" model="crm.stage">
    <field name="name">Inactive</field>
    <field name="sequence">5</field>
    <field name="fold" eval="True"/>
  </record>
  <record id="crm_stage_6" model="crm.stage">
    <field name="name">Redirect to Another Practitioner</field>
    <field name="sequence">6</field>
    <field name="fold" eval="True"/>
  </record>
  <function model="crm.stage" name="unlink">
    <value eval="[ref('crm.stage_lead3'), ref('crm.stage_lead4')]"/>
  </function>
</odoo>
