<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">industry_lawyer.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="industry_lawyer.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''),                 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', ''), }" />
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values" />
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_cover o_cc o_colored_level o_cc4 pt176 s_custom_snippet oe_img_bg o_bg_img_center o_bg_img_origin_border_box pb32" data-scroll-background-ratio="0" data-snippet="s_cover" data-format-mimetype="image/webp" data-name="Custom Cover" data-resize-width="1920" data-mimetype="image/webp" style="background-image: url(&quot;/web/image/industry_lawyer.img_custom_image_14&quot;);">
                            <div class="o_we_bg_filter bg-black-50" />
                            <div class="s_allow_columns container">
                                <div class="row o_grid_mode" data-row-count="8">
                                    <div class="o_colored_level o_animate o_anim_fade_in o_animate_both_scroll o_anim_from_bottom o_grid_item o_we_padding_highlight o_visible g-col-lg-12 g-height-6 col-lg-12" style="--wanim-intensity: 5; z-index: 1; grid-area: 3 / 1 / 9 / 13; animation-name: dummy;" data-scroll-background-ratio="0">
                                        <h1 class="display-1">Contact us</h1>
                                        <div class="o_text_columns o-contenteditable-false">
                                            <div class="row">
                                                <div class="o-contenteditable-true o_colored_level pt24 col-lg-7 col-12">
                                                    <p>
                                                        <span class="h4-fs">For any inquiry or to book a consultation, the Whitemore &amp;amp; Sons team is here for you.</span>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_hr pb0 pt32" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" style="border-top-color: rgba(245, 243, 240, 0.67);" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <div class="s_hr o_colored_level pb64 pt56 d-lg-block d-none o_snippet_mobile_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                            <hr class="w-100 mx-auto" style="border-top-width: 0px;" />
                        </div>
                        <section class="s_text_block o_colored_level o_cc o_cc1 pb64 pt0" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="mt-4 mt-lg-0 o_colored_level col-lg-4 order-lg-0 pt16" style="order: 1;">
                                        <p>
                                            <span class="o_rfs text-o-color-2 o_small-fs">
                                                ADDRESS<br />
                                            </span>
                                            <span class="h5-fs">143 Avenue Louise,&amp;nbsp;</span>
                                            <br />
                                            <span class="h5-fs">
                                                1050 Brussels<br />
                                                <br />
                                            </span>
                                        </p>
                                        <p>
                                            <span class="o_small-fs text-o-color-2">
                                                E-MAIL<br />
                                            </span>
                                            <span class="h5-fs">
                                                <a href="mailto:office@whitemoreandsons.be" class="o_translate_inline">office@whitemoreandsons.com</a>
                                                <br /><br />
                                            </span>
                                        </p>
                                        <p>
                                            <span class="o_small-fs text-o-color-2">
                                                PHONE NUMBER<br />
                                            </span>
                                            <span class="h5-fs">
                                                <a href="tel:+3225554712" class="o_translate_inline">+32 2 555 47 12</a>
                                                <br /><br />
                                            </span>
                                        </p>
                                        <p>
                                            <span class="o_small-fs text-o-color-2">
                                                HOURS<br />
                                            </span>
                                            <span class="h5-fs">
                                                Monday -&amp;nbsp;Friday<br />
                                                9:00 AM -&amp;nbsp;6:00 PM
                                            </span>
                                        </p>
                                    </div>
                                    <div class="mt-4 mt-lg-0 o_colored_level o_cc o_cc2 border col-lg-7 offset-lg-1 order-lg-0" style="--box-border-left-width: 30px; --box-border-bottom-width: 30px; --box-border-right-width: 30px; --box-border-top-width: 30px; border-left-color: var(--o-color-3) !important; border-bottom-color: var(--o-color-3) !important; border-right-color: var(--o-color-3) !important; border-top-color: var(--o-color-3) !important; order: 0;">
                                        <p class="small">
                                            <span class="o_rfs o_small-fs text-o-color-2">
                                                CONTACT FORM
                                                <br />
                                                <br />
                                            </span>
                                        </p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div class="s_website_form_field mb-3 col-lg-6 s_website_form_custom s_website_form_required" data-type="char" data-name="Field" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="o4ilnvf9tipr">
                                                                <span class="s_website_form_label_content">First Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="First Name" required="1" placeholder="" id="o4ilnvf9tipr" data-fill-with="name" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom s_website_form_required" data-type="char" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="os80acze3d2">
                                                                <span class="s_website_form_label_content">Last Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="Last Name" placeholder="" id="os80acze3d2" data-fill-with="undefined" required="" />
                                                        </div>
                                                        <div class="mb-3 s_website_form_field s_website_form_required s_website_form_model_required col-lg-12" data-type="email" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact3">
                                                                <span class="s_website_form_label_content">Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact3" type="email" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email" />
                                                        </div>
                                                        <div class="s_website_form_field mb-3 col-lg-12 s_website_form_custom s_website_form_required" data-type="char" data-name="Field" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="o0tc9fuwz7kl">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="phone" placeholder="" id="o0tc9fuwz7kl" data-fill-with="phone" required="" />
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact5">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact5" type="text" class="form-control s_website_form_input" name="subject" required="" />
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required" data-type="text" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact6">
                                                                <span class="s_website_form_label_content">Question</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea id="contact6" class="form-control s_website_form_input" name="description" required="" rows="8" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                                                                    <span class="s_website_form_label_content" />
                                                                    <br />
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input type="hidden" class="form-control s_website_form_input" name="email_to" value="info@yourcompany.example.com" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label">
                                                                <br />
                                                            </div>
                                                            <a href="#" role="button" class="s_website_form_send btn btn-primary">
                                                                <span class="fa fa-circle text-o-color-3" />
                                                                &amp;nbsp; Send message
                                                            </a>
                                                            <span id="s_website_form_result" />
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus" />
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry" />
            <field name="is_published" eval="True" />
            <field name="website_indexed" eval="True" />
            <field name="header_overlay" eval="True" />
            <field name="header_text_color">text-o-color-4</field>
        </record>
    </data>
</odoo>
