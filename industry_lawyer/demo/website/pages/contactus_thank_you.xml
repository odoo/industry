<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus_thank_you" model="ir.ui.view">
        <field name="name">Thank you (Contact us)</field>
        <field name="key">industry_lawyer.page_contactus_thank_you</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Thank you (Contact us)" t-name="industry_lawyer.page_contactus_thank_you">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block o_colored_level o_cc pb120 o_cc2 pt192 o_three_quarter_height" data-snippet="s_text_block" data-name="Thank You Section">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="col-lg-12 o_colored_level" style="text-align: center;">
                                        <h1 class="display-2" style="font-weight: normal;">
                                            <span class="text-o-color-2">Thank You!</span>
                                        </h1>
                                        <p>
                                            <span class="h4-fs">
                                                <br/>Your message has been sent.&amp;nbsp;
                                                We will get back to you shortly.
                                            </span>
                                        </p>
                                        <p>
                                            <br/>
                                        </p>
                                        <p>
                                            <a href="/" class="o_translate_inline btn btn-outline-secondary">Go to Homepage</a></p></div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <input t-if="website.plausible_shared_key" type="hidden" class="js_plausible_push" data-event-name="Lead Generation" data-event-params="{&quot;CTA&quot;: &quot;Contact Us&quot;}"/>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus_thank_you" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus_thank_you"/>
            <field name="url">/contactus-thank-you</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="False"/>
        </record>
    </data>
</odoo>
