<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="appointments_selection_layout_oe_structure_appointments_card_top" model="ir.ui.view">
        <field name="name">Law Firm - Appointment Types Selection (oe_structure_appointments_card_top)</field>
        <field name="key">website_appointment.appointments_selection_layout_oe_structure_appointments_card_top</field>
        <field name="inherit_id" ref="website_appointment.appointments_selection_layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_appointments_card_top']" position="replace">
                <div class="oe_structure" id="oe_structure_appointments_card_top">
                    <section class="s_text_image o_colored_level o_cc s_custom_snippet pt136 pb56 o_cc4" data-snippet="s_text_image" data-name="Custom Text - Image">
                        <div spellcheck="false" data-gramm="false" class="container">
                            <div class="row align-items-end">
                                <div class="pt16 o_colored_level pb16 o_animate o_anim_slide_in o_anim_from_bottom o_animate_both_scroll o_visible col-lg-9" style="--wanim-intensity: 5; animation-name: dummy;">
                                    <h1 class="display-2">Find the right person <font style="color: rgba(245, 243, 240, 0.67);">for your business.</font>
                                    </h1>
                                </div>
                                <div class="pb16 o_animate o_anim_slide_in o_anim_from_bottom o_animate_both_scroll o_colored_level pt24 col-lg-7 o_visible" style="--wanim-intensity: 5; animation-name: dummy;">
                                    <p>
                                        <span class="h4-fs">Tell us what you're facing, and we'll match you with the right person on our team. First conversation, free and confidential, response within 24 hours.</span>
                                        <br />
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
