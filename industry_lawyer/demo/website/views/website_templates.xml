<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Law Firm - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.footer_copyright_company_name"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">
                    Copyright © <span>Whitemore &amp;amp; Sons, 2026</span>
                </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Law Firm - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                        <div class="container" data-lt-tmp-id="lt-967209" spellcheck="false" data-gramm="false">
                            <div class="row">
                                <div class="o_colored_level pt24 pb0 col-lg-3">
                                    <p>
                                        <span class="h3-fs">
                                            <a href="/our-services" class="o_translate_inline">Services</a>
                                        </span>
                                    </p>
                                    <p>
                                        <span class="h3-fs">
                                            <a href="/about-us" class="o_translate_inline">About us</a>
                                        </span>
                                    </p>
                                    <p>
                                        <span class="h3-fs">
                                            <a href="/appointment" class="o_translate_inline">Appointment</a>
                                        </span>
                                    </p>
                                    <p>
                                        <span class="h3-fs">
                                            <a href="/contactus" class="o_translate_inline">Contact</a>
                                        </span>
                                    </p>
                                </div>
                                <div class="o_colored_level col-lg-4 pt24 pb0 col-6">
                                    <p style="text-align: start;">
                                        <span class="h3-fs">LinkedIn</span>
                                    </p>
                                    <p style="text-align: start;">
                                        <span class="h3-fs">
                                            <a href="/privacy" class="o_translate_inline">Privacy policy</a>
                                        </span>
                                    </p>
                                    <p style="text-align: start;">
                                        <span class="h3-fs">
                                            <a href="/cookie-policy" class="o_translate_inline">Cookies</a>
                                        </span>
                                    </p>
                                </div>
                                <div class="o_colored_level pt24 pb0 col-lg-5">
                                    <p style="text-align: end;">
                                        <span class="h3-fs">Where to find us?</span>
                                    </p>
                                    <p style="text-align: end;">
                                        <span class="h5-fs" style="color: rgba(245, 243, 240, 0.67);">
                                            143 Avenue Louise&amp;nbsp;
                                            <br />
                                            1050 Brussels
                                        </span>
                                    </p>
                                    <p style="text-align: end;">
                                        <span class="h5-fs" style="color: rgba(245, 243, 240, 0.67);">+32 2 555 47 12</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="cookies_bar" model="ir.ui.view">
        <field name="name">Law Firm - Cookies Bar</field>
        <field name="key">website.cookies_bar</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><data name="Cookies Bar">
                <xpath expr="//footer" position="after">
                    <div id="website_cookies_bar" t-if="website.cookies_bar" class="s_popup o_snippet_invisible o_no_save d-none" data-name="Cookies Bar" data-vcss="001" data-invisible="1" t-att-data-cookie-policy-url="website.cookie_policy_id.sudo().url or '/cookie-policy'">
                        <div class="modal s_popup_bottom o_cookies_discrete modal_shown s_popup_no_backdrop" data-show-after="500" data-display="afterDelay" data-consents-duration="999" data-bs-focus="false" data-bs-backdrop="false" data-bs-keyboard="false" tabindex="-1" aria-label="Cookie bar" style="display: none;" aria-hidden="true">
                            <div class="modal-dialog d-flex">
                                <div class="modal-content oe_structure">
                                    <section class="o_colored_level o_cc o_cc3">
                                        <div data-lt-tmp-id="lt-204839" spellcheck="false" data-gramm="false" class="container">
                                            <div class="row">
                                                <div class="pt16 o_colored_level col-lg-12 border" style="--box-border-left-width: 20px; --box-border-bottom-width: 0px; --box-border-right-width: 20px; --box-border-top-width: 20px; border-left-color: var(--o-color-2) !important; border-bottom-color: var(--o-color-2) !important; border-right-color: var(--o-color-2) !important; border-top-color: var(--o-color-2) !important;">
                                                    <p>
                                                        <span>We use cookies to provide you a better user experience on this website.</span>
                                                        <a href="/website/cookie-policy" class="o_cookies_bar_text_policy o_translate_inline">Cookie Policy</a>
                                                    </p>
                                                </div>
                                                <div class="text-end pt16 pb16 o_colored_level col-lg-12 border" style="--box-border-left-width: 20px; --box-border-bottom-width: 0px; --box-border-right-width: 20px; --box-border-top-width: 0px; text-align: start !important; border-left-color: var(--o-color-2) !important; border-bottom-color: var(--o-color-2) !important; border-right-color: var(--o-color-2) !important; border-top-color: var(--o-color-2) !important;">
                                                    <a href="#" id="cookies-consent-essential" role="button" class="js_close_popup px-2 mb-2 btn btn-outline-secondary">Only essentials</a>
                                                    <a href="#" id="cookies-consent-all" role="button" class="js_close_popup mb-2 btn btn-outline-secondary">I agree</a>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
