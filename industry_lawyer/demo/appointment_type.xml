<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Appointment types (behind website "Book" buttons) -->
    <record id="appointment_type_1" model="appointment.type">
        <field name="name">Free Initial Consultation</field>
        <field name="image_1920" type="bytes" file="industry_lawyer/static/src/img/content/website/lawyer-image-15.webp"/>
        <field name="category">recurring</field>
        <field name="appointment_duration">0.5</field>
        <field name="appointment_tz" model="res.users" eval="obj().env.ref('base.user_admin').tz or 'Europe/Brussels'"/>
        <field name="location_id" ref="base.main_partner"/>
        <field name="work_hours_activated" eval="True"/>
        <field name="show_avatars" eval="True"/>
        <field name="staff_user_ids" eval="[(6, 0, [ref('res_users_2'), ref('res_users_1')])]"/>
        <field name="min_schedule_hours">48.0</field>
        <field name="max_schedule_days">30</field>
        <field name="min_cancellation_hours">4.0</field>
        <field name="message_intro"><![CDATA[<p>Check our domains of competences on our website.</p>]]></field>
        <field name="message_confirmation"><![CDATA[<p>Thank you for your trust !</p>]]></field>
        <field name="is_published" eval="True"/>
    </record>
    <record id="appointment_type_2" model="appointment.type">
        <field name="name">Contracts &amp; Commercial Agreements</field>
        <field name="category">recurring</field>
        <field name="appointment_duration">0.5</field>
        <field name="appointment_tz" model="res.users" eval="obj().env.ref('base.user_admin').tz or 'Europe/Brussels'"/>
        <field name="location_id" ref="base.main_partner"/>
        <field name="work_hours_activated" eval="True"/>
        <field name="show_avatars" eval="True"/>
        <field name="staff_user_ids" eval="[(6, 0, [ref('res_users_1'), ref('res_users_2')])]"/>
        <field name="min_schedule_hours">24.0</field>
        <field name="max_schedule_days">30</field>
        <field name="min_cancellation_hours">24.0</field>
        <field name="message_intro"><![CDATA[<p>Fee: 100€<br/>The fee includes the opening of the case.</p>]]></field>
        <field name="message_confirmation"><![CDATA[<p>Thank you for your trust !</p>]]></field>
        <field name="is_published" eval="True"/>
    </record>
    <record id="appointment_type_3" model="appointment.type">
        <field name="name">Employment Law for Employers</field>
        <field name="image_1920" type="bytes" file="industry_lawyer/static/src/img/content/website/lawyer-image-16.webp"/>
        <field name="category">recurring</field>
        <field name="appointment_duration">0.5</field>
        <field name="appointment_tz" model="res.users" eval="obj().env.ref('base.user_admin').tz or 'Europe/Brussels'"/>
        <field name="location_id" ref="base.main_partner"/>
        <field name="work_hours_activated" eval="True"/>
        <field name="show_avatars" eval="True"/>
        <field name="staff_user_ids" eval="[(6, 0, [ref('res_users_3')])]"/>
        <field name="min_schedule_hours">24.0</field>
        <field name="max_schedule_days">30</field>
        <field name="min_cancellation_hours">24.0</field>
        <field name="message_intro"><![CDATA[<p>Fee: 100€<br/>The fee includes the opening of the case.</p>]]></field>
        <field name="message_confirmation"><![CDATA[<p>Thank you for your trust !</p>]]></field>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
