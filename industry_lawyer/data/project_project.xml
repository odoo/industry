<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="project_project_3" model="project.project" context="{'mail_auto_subscribe_no_notify': True}">
        <field name="name">Client Matter Template</field>
        <field name="description"><![CDATA[<p>Standard project structure for a new legal matter: intake and KYC, legal analysis, client correspondence, drafting, review, billing and closing.</p>]]></field>
        <field name="allow_billable" eval="True"/>
        <field name="allocated_hours">10.0</field>
        <field name="type_ids" eval="[(6, 0, [ref('project_task_type_1'), ref('project_task_type_2'), ref('project_task_type_3')])]"/>
        <field name="billing_type">manually</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="allow_recurring_tasks" eval="True"/>
        <field name="allow_milestones" eval="True"/>
        <field name="is_template" eval="True"/>
    </record>
    <record id="project_project_5" model="project.project" context="{'mail_auto_subscribe_no_notify': True}">
        <field name="name">Litigation &amp; Filing Matter Template</field>
        <field name="description"><![CDATA[<p>Template for contentious matters requiring procedural work, including evidence review, pleadings, filing deadlines, hearings, client updates and closing steps.</p>]]></field>
        <field name="allow_billable" eval="True"/>
        <field name="type_ids" eval="[(6, 0, [ref('project_task_type_1'), ref('project_task_type_2'), ref('project_task_type_3')])]"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="allow_recurring_tasks" eval="True"/>
        <field name="allow_milestones" eval="True"/>
        <field name="is_template" eval="True"/>
    </record>
</odoo>
