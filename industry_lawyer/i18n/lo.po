#. module: industry_lawyer
#: model_terms:ir.ui.view,arch_db:industry_lawyer.view_page_privacy_policy
msgid ""
"Whitemore &amp;amp; Sons (\"we,\" \"us,\" \"our,\" or \"the firm\") is "
