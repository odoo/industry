#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"You didn't import demo data? You can still do it. Go to Apps &gt; Industries "
"&gt; Upgrade your Beauty\n"
"                  Parlor package and check the related box."
msgstr ""
