msgid "Waxing - Legs & Arms"
msgstr "Depilación - Piernas y brazos"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_services
msgid "Waxing using gentle techniques for smooth skin."
msgstr "Depilación con cera mediante técnicas suaves para una piel tersa."

#. module: beauty_parlor
