#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid "if you need help!<br/>"
msgstr "si necesitas ayuda. <br/>"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_services
msgid "man wearing mud mask"
msgstr "hombre con mascarilla de barro"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_services
msgid "person holding amber glass bottle"
msgstr "una persona sosteniendo una botella de vidrio color ámbar"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid "request a demo"
msgstr "solicita una demostración"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid "slide"
msgstr "diapositiva"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid ""
"“Here, time slows down so you can finally catch up with yourself. Breathe "
"in, let go, and leave the rush at the door.”"
msgstr ""
"\"Aquí, el tiempo pasa más lento para que por fin puedas reconectar contigo. "
"Respira, suelta las preocupaciones y deja las prisas en la puerta\"."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid ""
"“I left having forgotten what day it was. Nobody hurries me here. A lovely "
"experience!”"
msgstr ""
"\"Me fui sin recordar qué día era. Aquí nadie me apura. ¡Una experiencia "
"maravillosa!\""

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid ""
"“No appointments to rush to, no one waiting on you. For the next hour, your "
"only job is to enjoy it.”"
msgstr ""
"\"No hay citas a las que tengas que llegar con prisa ni nadie que te espere. "
"Durante la próxima hora, tu única tarea es disfrutar\"."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid ""
"•    Nails    •    Quiet luxury    •    Facials    •    Massage    •    Slow "
"care"
msgstr ""
"•    Uñas    •    Lujo discreto    •    Tratamientos faciales    •    "
"Masajes    •    Cuidado sin prisas"

