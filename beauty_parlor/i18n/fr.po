#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_services
msgid "man wearing mud mask"
msgstr "homme portant un masque à la boue"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_services
msgid "person holding amber glass bottle"
msgstr "personne tenant une bouteille en verre ambré"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid "request a demo"
msgstr "demander une démo"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid "slide"
msgstr "diapositive"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid ""
"“Here, time slows down so you can finally catch up with yourself. Breathe "
"in, let go, and leave the rush at the door.”"
msgstr ""
"“Ici, le temps ralentit pour vous permettre de vous retrouver. Respirez, "
"lâchez prise et laissez l’agitation derrière la porte.”"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid ""
"“I left having forgotten what day it was. Nobody hurries me here. A lovely "
"experience!”"
msgstr ""
"“Je suis repartie en ayant oublié quel jour nous étions. Ici, personne ne me "
"presse. Une très belle expérience !”"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid ""
"“No appointments to rush to, no one waiting on you. For the next hour, your "
"only job is to enjoy it.”"
msgstr ""
"“Aucun rendez-vous où courir, personne qui vous attend. Pendant l’heure qui "
"vient, votre seule mission est d’en profiter.”"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.view_page_home
msgid ""
"•    Nails    •    Quiet luxury    •    Facials    •    Massage    •    Slow "
"care"
msgstr ""
"•    Ongles    •    Luxe discret    •    Soins du visage    •    Massage    •"
"    Soins tout en douceur"

