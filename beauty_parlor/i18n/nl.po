#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Appointments App</b>: Offer online booking for treatments and services so "
"your clients can schedule\n"
"              sessions 24/7."
msgstr ""
"<b>Afspraken-app</b>: Bied online boekingen aan voor behandelingen en "
"diensten, zodat je klanten 24/7 afspraken kunnen maken."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Calendar App</b>: Manage your daily schedule efficiently, avoid double "
"bookings, and ensure enough\n"
"              preparation time between clients."
msgstr ""
"<b>Agenda-app</b>: Beheer je dagelijkse planning efficiënt, voorkom dubbele "
"boekingen en zorg voor voldoende\n"
"              voorbereidingstijd tussen klanten."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Contacts App</b>: Keep a clean and organized directory of your clients, "
"suppliers, and professional\n"
"              partners."
msgstr ""
"<b>Contacten-app</b>: Houd een overzichtelijk en georganiseerd adresboek bij "
"van je klanten, leveranciers en zakenpartners."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Invoicing App</b>: Generate professional invoices for treatments, "
"packages, and subscriptions,\n"
"              making sure you get paid on time."
msgstr ""
"<b>Facturatie-app</b>: Genereer professionele facturen voor behandelingen, "
"pakketten en abonnementen,\n"
"              zodat je op tijd betaald krijgt."

