#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Appointments App</b>: Offer online booking for treatments and services so your clients can schedule\n"
"              sessions 24/7."
msgstr ""
"<b>Compromissos</b>: Ofereça agendamento online para tratamentos e serviços "
"para que seus clientes possam marcar\n"
"              sessões 24/7."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
#, fuzzy
msgid ""
"<b>Calendar App</b>: Manage your daily schedule efficiently, avoid double bookings, and ensure enough\n"
"              preparation time between clients."
msgstr ""
"<b>Calendário</b>: Gerencie seu calendário diário com eficiência, evite "
"agendamentos conflitantes e garanta tempo suficiente\n"
"              para se preparar entre um cliente e outro."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Contacts App</b>: Keep a clean and organized directory of your clients, suppliers, and professional\n"
"              partners."
msgstr ""
"<b>Contatos</b>: Mantenha uma lista organizada e bem estruturada de seus "
"clientes, fornecedores e\n"
"              parceiros profissionais."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Invoicing App</b>: Generate professional invoices for treatments, packages, and subscriptions,\n"
"              making sure you get paid on time."
msgstr ""
"<b>Faturamento</b>: Gere faturas profissionais para tratamentos, pacotes e "
"assinaturas,\n"
"              garantindo que você receba seus pagamentos em dia."

