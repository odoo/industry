#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Appointments App</b>: Offer online booking for treatments and services so your clients can schedule\n"
"              sessions 24/7."
msgstr ""
"<b>Aplicativo de Compromissos</b>: Ofereça agendamento online para "
"tratamentos e serviços para que seus clientes possam marcar sessões 24 horas "
"por dia, 7 dias por semana."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Calendar App</b>: Manage your daily schedule efficiently, avoid double bookings, and ensure enough\n"
"              preparation time between clients."
msgstr ""
"<b>App de Calendário</b>: Gerencie sua agenda diária com eficiência, evite "
"agendamentos em dobro e garanta tempo de preparação suficiente entre os "
"clientes."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Contacts App</b>: Keep a clean and organized directory of your clients, suppliers, and professional\n"
"              partners."
msgstr ""
"<b>App de Contatos</b>: Mantenha um diretório limpo e organizado de seus "
"clientes, fornecedores e parceiros profissionais."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
msgid ""
"<b>Invoicing App</b>: Generate professional invoices for treatments, packages, and subscriptions,\n"
"              making sure you get paid on time."
msgstr ""
"<b>App de Faturamento</b>: Gere faturas profissionais para tratamentos, "
"pacotes e assinaturas, garantindo que você receba em dia."

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.homepage
