msgstr ""
"Bun venit la <span class=\"text-o-color-1\"><em>Blume</em></span><br/>\n"
"                                            sanctuarul tău de liniște"

#. module: beauty_parlor
#: model_terms:ir.ui.view,arch_db:beauty_parlor.welcome_article_body
