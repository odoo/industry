<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="h-100 container">
                                <a href="/appointment" class="oe_unremovable d-flex align-items-center h-100 rounded-0 btn btn-secondary">Schedule an appointment</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="header_social_links" model="ir.ui.view">
        <field name="name">Custom - Header Social Links</field>
        <field name="key">website.header_social_links</field>
        <field name="inherit_id" ref="website.placeholder_header_social_links"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="o_header_social_links #{_div_class}" class="o_header_social_links">
                        <div class="s_social_media o_not_editable oe_unmovable oe_unremovable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                            <h5 class="s_social_media_title d-none">Follow us</h5>
                            <a href="https://www.facebook.com/your-page" class="s_social_media_facebook o_nav-link_secondary nav-link m-0 p-0 text-decoration-none" target="_blank" aria-label="Facebook">
                                <i class="oi p-1 o_editable_media oi-stack o_sm_custom_size" data-icon="oi_facebook" style="--oi-icon-size: 3.5rem;"/>
                            </a>
                            <a href="https://www.instagram.com/your-page" class="s_social_media_instagram o_nav-link_secondary nav-link m-0 p-0 text-decoration-none" target="_blank" aria-label="Instagram">
                                <i class="oi p-1 o_editable_media oi-stack o_sm_custom_size" data-icon="oi_instagram" style="--oi-icon-size: 3.5rem;"/>
                            </a>
                        </div>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="option_header_disclaimer" model="ir.ui.view">
        <field name="name">Custom - Header Disclaimer</field>
        <field name="key">website.option_header_disclaimer</field>
        <field name="inherit_id" ref="website.placeholder_header_disclaimer"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[@id='o_fake_header_disclaimer']" position="replace">
                <div class="s_headline oe_no_drop_above o_colored_level o_cc o_cc5 pt4 pb4">
                    <div style="text-align: center;">
                        <small>Tue – Sat · Avenue des déportés 48, 1367 Ramillies (Belgium)</small>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="template_footer_centered" model="ir.ui.view">
        <field name="name">Custom - Centered</field>
        <field name="key">website.template_footer_centered</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt32" data-snippet="s_text_block" data-name="Container">
                        <div class="s_allow_columns container">
                            <div class="row">
                                <div class="o_colored_level col-lg-12 order-lg-0" style="order: 0;">
                                    <div class="s_social_media text-center o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi o_editable_media oi-stack" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.instagram.com" target="_blank" aria-label="Instagram" class="s_social_media_instagram">
                                            <i class="oi o_editable_media oi-stack" data-icon="oi_instagram"/>
                                        </a>
                                    </div>
                                    <div class="s_hr pt24 pb24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="o_colored_level col-lg-4 order-lg-0" style="order: 2;">
                                    <p style="text-align: center;">
                                        Avenue des déportés 48<br/>
                                        1367 Ramillies<br/>
                                        Belgium
                                    </p>
                                </div>
                                <div class="o_colored_level order-lg-0 col-lg-4 pb8" style="order: 1;">
                                    <a href="/" class="o_footer_logo logo">
                                        <img src="/beauty_parlor/static/src/img/content/website/logo.svg" alt="" class="img-fluid img d-block mx-auto" style="width: 42.93%; height: auto;" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="o_colored_level col-lg-4 order-lg-0" style="order: 3;">
                                    <ul class="list-unstyled">
                                        <li style="text-align: center;">
                                            <a href="tel:+15555555556" class="o_translate_inline">+1 555-555-5556</a>
                                        </li>
                                        <li style="text-align: center;" class="text-o-color-4">
                                            <a href="mailto:info@blume.example.com">
                                                <span class="text-o-color-4">info@blume.example.com</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="order-lg-0 o_colored_level col-lg-12 pt0" style="order: 4;">
                                    <div class="s_hr pt24 pb24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                    <ul class="list-unstyled">
                                        <li style="text-align: center;" class="o_small-fs text-o-color-4">Copyright © blume</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
