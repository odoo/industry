<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="appointments_selection_layout_oe_structure_appointments_card_top" model="ir.ui.view">
        <field name="name">Appointment Types Selection (oe_structure_appointments_card_top)</field>
        <field name="key">website_appointment.appointments_selection_layout_oe_structure_appointments_card_top</field>
        <field name="inherit_id" ref="website_appointment.appointments_selection_layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_appointments_card_top']" position="replace">
                    <div class="oe_structure" id="oe_structure_appointments_card_top">
                        <div class="s_hr pt32 o_colored_level pb0" data-snippet="s_hr" data-name="Separator">
                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                        </div>
                    </div>
                </xpath>
            </data>
        </field>
    </record>
    <record id="appointment_index_topbar" model="ir.ui.view">
        <field name="name">Topbar</field>
        <field name="key">beauty_parlor.website_calendar_index_topbar</field>
        <field name="inherit_id" ref="website_appointment.website_calendar_index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('d-flex')]/div[hasclass('flex-grow-1')]/h1" position="replace">
                <h1 class="h4 mb-0">
                    <span class="h2-fs">Choose your appointment</span>
                </h1>
            </xpath>
        </field>
    </record>
    <record id="appointments_selection_layout_oe_structure_appointments_card_bottom" model="ir.ui.view">
        <field name="name">Appointment Types Selection (oe_structure_appointments_card_bottom)</field>
        <field name="key">website_appointment.appointments_selection_layout_oe_structure_appointments_card_bottom</field>
        <field name="inherit_id" ref="website_appointment.appointments_selection_layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_appointments_card_bottom']" position="replace">
                <div class="oe_structure" id="oe_structure_appointments_card_bottom">
                    <section class="s_accordion_image o_colored_level o_cc pb0 o_cc1 s_custom_snippet pt48" data-snippet="s_accordion_image" data-name="Custom Accordion Image (2)">
                        <div class="container">
                            <div class="row align-items-start">
                                <div class="col-lg-7 pt16 o_colored_level">
                                    <section class="s_map rounded-3 o_not_editable pb256 pt256" data-map-type="m" data-map-zoom="12" data-snippet="s_map" data-map-address="Avenue des déportés 48, Belgium" data-name="Map" data-vxml="001">
                                        <div class="map_container">
                                            <div class="css_non_editable_mode_hidden">
                                                <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                    An address must be specified for a map to be embedded
                                                </div>
                                            </div>
                                            <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=Avenue%20des%20d%C3%A9port%C3%A9s%2048%2C%20Belgium&amp;t=m&amp;z=12&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                            <div class="s_map_color_filter"/>
                                        </div>
                                    </section>
                                </div>
                                <div class="o_colored_level col-lg-5 pt0">
                                    <div class="s_card o_card_img_top card o_cc o_colored_level o_cc3" data-vxml="001" data-snippet="s_card" data-name="Card">
                                        <div class="card-body">
                                            <h2 class="card-title">
                                                <span class="text-o-color-3">Visit</span>
                                            </h2>
                                            <p>
                                                Avenue des déportés 48<br/>
                                                1367 Ramillies (Belgium)
                                            </p>
                                            <p>
                                                <span class="o_small-fs">
                                                    <em>Second floor, above the florist.Ring the bell marked Blume.</em>
                                                </span>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="s_card o_card_img_top card o_cc o_cc5 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card">
                                        <div class="card-body">
                                            <h2 class="card-title">
                                                <span class="text-o-color-3">Opening hours</span>
                                            </h2>
                                            <div class="o_text_columns o-contenteditable-false">
                                                <div class="row">
                                                    <div class="col-6 o-contenteditable-true">
                                                        <p class="card-text">
                                                            <span class="base-fs">Tuesday – Wednesday</span>
                                                        </p>
                                                    </div>
                                                    <div class="col-6 o-contenteditable-true">
                                                        <p class="card-text" style="text-align: right;">
                                                            <span class="base-fs">9h – 18h</span>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="o_text_columns o-contenteditable-false">
                                                <div class="row">
                                                    <div class="col-6 o-contenteditable-true">
                                                        <p class="card-text">
                                                            <span class="base-fs">Thursday – Friday</span>
                                                        </p>
                                                    </div>
                                                    <div class="col-6 o-contenteditable-true">
                                                        <p class="card-text" style="text-align: right;">
                                                            <span class="base-fs">9h – 19h</span>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="o_text_columns o-contenteditable-false">
                                                <div class="row">
                                                    <div class="col-6 o-contenteditable-true">
                                                        <p class="card-text">
                                                            <span class="base-fs">Saturday</span>
                                                        </p>
                                                    </div>
                                                    <div class="col-6 o-contenteditable-true">
                                                        <p class="card-text" style="text-align: right;">
                                                            <span class="base-fs">10h – 16h</span>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="o_text_columns o-contenteditable-false">
                                                <div class="row">
                                                    <div class="col-6 o-contenteditable-true">
                                                        <p class="card-text">
                                                            <span class="base-fs">Sunday – Monday</span>
                                                        </p>
                                                    </div>
                                                    <div class="col-6 o-contenteditable-true">
                                                        <p class="card-text" style="text-align: right;">
                                                            <span class="base-fs">closed</span>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="s_card o_card_img_top card o_cc o_colored_level o_cc1" data-vxml="001" data-snippet="s_card" data-name="Card">
                                        <div class="card-body">
                                            <h2 class="card-title">
                                                <span>Contact</span>
                                            </h2>
                                            <p class="card-text">
                                                <span class="o_small-fs">
                                                    <span class="base-fs"/>
                                                    <a href="tel:+15555555556" class="o_translate_inline">
                                                        <span class="base-fs">+1 555-555-5556</span>
                                                    </a>
                                                    <br/>
                                                    <span class="base-fs">
                                                        <a href="mailto:info@blume.example.com" class="o_translate_inline">info@blume.example.com</a>
                                                    </span>
                                                    <br/>
                                                    <a href="https://www.instagram.com" class="o_translate_inline">
                                                        <span class="base-fs">@blume.beauty on Instagram</span>
                                                    </a>
                                                </span>
                                                <br/>
                                            </p>
                                        </div>
                                    </div>
                                    <h2 class="h3-fs">
                                        <br/>
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="s_hr pt32 pb32 o_colored_level" data-snippet="s_hr" data-name="Separator">
                        <hr class="w-100 mx-auto"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
