#. module: guest_house
#: model_terms:ir.ui.view,arch_db:guest_house.view_page_home
msgid "See All"
msgstr "Vezi tot"

#. module: guest_house
#: model_terms:ir.ui.view,arch_db:guest_house.view_page_home
msgid "See all<span class=\"oi ms-2\" data-icon=\"arrow_right\"/>"
msgstr "Vezi tot<span class=\"oi ms-2\" data-icon=\"arrow_right\"/>"

#. module: guest_house
#: model_terms:ir.ui.view,arch_db:guest_house.welcome_article_body
msgid ""
"See that for demo purpose we setup typical uplift and discount rules to "
"adjust your prices during key periods."
msgstr ""
"Observați că, pentru demonstrație, am configurat reguli obișnuite de "
"majorare și reducere a prețurilor în perioadele importante."

#. module: guest_house
#: model_terms:ir.ui.view,arch_db:guest_house.welcome_article_body
msgid "See that it contains a rule booking blocker setting price to 0."
msgstr ""
"Verificați că include o regulă de blocare a rezervării, cu prețul setat la 0."

#. module: guest_house
#: model_terms:ir.ui.view,arch_db:guest_house.welcome_article_body
msgid "Select one of your employee."
msgstr "Selectați unul dintre angajați."

#. module: guest_house
#: model_terms:ir.ui.view,arch_db:guest_house.welcome_article_body
msgid "Select or create a customer and then confirm the booking!"
msgstr "Selectați sau creați un client, apoi confirmați rezervarea!"

#. module: guest_house
#: model_terms:ir.ui.view,arch_db:guest_house.welcome_article_body
msgid ""
"Selling local products? Use the <strong>Point of Sales App </strong>for easy "
"sales."
msgstr ""
"Vindeți produse locale? Folosiți aplicația <strong>Punct de vânzare</strong> "
"pentru vânzări rapide."

#. module: guest_house
#: model_terms:ir.ui.view,arch_db:guest_house.view_page_contactus
