<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_sale_products_oe_structure_website_sale_products_1" model="ir.ui.view">
        <field name="name">Custom - Products (oe_structure_website_sale_products_1)</field>
        <field name="key">website_sale.products_oe_structure_website_sale_products_1</field>
        <field name="inherit_id" ref="website_sale.products"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_sale_products_1']" position="replace">
                <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_products_1" data-editor-message-default="true" data-editor-message="Drag blocks here">
                    <section class="s_splash_intro oe_img_bg o_bg_img_center o_bg_img_origin_border_box o_colored_level o_cc pb88 o_three_quarter_height o_cc1 pt80" style="background-image: url(&quot;/web/image/guest_house.img_custom_image_23&quot;);" data-snippet="s_splash_intro" data-name="Splash Intro" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp">
                        <div class="o_we_bg_filter bg-black-25"/>
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-7 o_colored_level offset-1 offset-lg-0 col-10">
                                    <p class="lead text-muted">
                                        <strong>Find the right room for you.</strong>
                                    </p>
                                    <h1 class="display-3">6 rooms. 6&amp;nbsp;different vibes.&amp;nbsp;<br/>All connected to nature.</h1>
                                    <br/>
                                    <p>
                                        <a class="o_translate_inline btn btn-lg rounded-circle btn-fill-primary" href="/about-us">Discover More</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="s_hr pt32 pb32 o_colored_level" data-snippet="s_hr" data-name="Separator">
                        <hr class="w-100 mx-auto" style="border-top-color: rgba(255, 255, 255, 0);"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="website_sale_product_oe_structure_website_sale_product_2" model="ir.ui.view">
        <field name="name">Custom - Product (oe_structure_website_sale_product_2)</field>
        <field name="key">website_sale.product_oe_structure_website_sale_product_2</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_sale_product_2']" position="replace">
                <div class="oe_structure oe_empty oe_structure_not_nearest mt16" id="oe_structure_website_sale_product_2" data-editor-message="Drag blocks here to add them on all products">
                    <section class="s_banner pt96 pb96 o_colored_level s_custom_snippet" data-snippet="s_banner" data-name="Custom Banner">
                        <div class="container">
                            <div class="row o_grid_mode" data-row-count="10">
                                <div class="o_grid_item g-height-10 g-col-lg-5 col-lg-5 o_colored_level" style="z-index: 1; grid-area: 1 / 1 / 11 / 6;">
                                    <h2 class="display-3">
                                        <strong>Over 45 activities to explore nearby.</strong>
                                    </h2>
                                    <p>
                                        <br/>
                                    </p>
                                    <p class="lead">Whether you're into culture, scenic hikes, relaxing retreats, or local crafts, you'll find plenty to do around the guesthouse. Please be sure to book your activities in advance, or feel free to ask our team to help you plan your itinerary!</p>
                                    <p>
                                        <br/>
                                    </p>
                                    <p>
                                        <a class="o_translate_inline btn btn-lg rounded-circle btn-fill-primary" href="/contactus">Contact us&amp;nbsp;<span class="fa fa-angle-right ms-2"/></a>
                                    </p>
                                </div>
                                <div class="o_grid_item o_grid_item_image g-col-lg-4 g-height-10 col-lg-4 d-lg-block d-none o_snippet_mobile_invisible o_colored_level" style="z-index: 2; grid-area: 1 / 8 / 11 / 12;" data-invisible="1">
                                    <img src="/web/image/guest_house.img_custom_image_09" alt="" class="img img-fluid mx-auto rounded o_editable_media o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                </div>
                                <div class="o_grid_item o_grid_item_image g-col-lg-2 g-height-5 col-lg-2 d-lg-block d-none o_snippet_mobile_invisible o_colored_level" style="z-index: 3; grid-area: 2 / 11 / 7 / 13;" data-invisible="1">
                                    <img src="/web/image/guest_house.img_custom_image_03" alt="" class="img img-fluid mx-auto rounded o_editable_media o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                </div>
                                <div class="o_grid_item g-col-lg-5 g-height-4 col-lg-5 o_colored_level" style="z-index: 4; grid-area: 6 / 6 / 10 / 11;">
                                    <blockquote class="s_blockquote o_cc o_cc1 o_animable position-relative d-flex flex-column gap-4 w-100 mx-auto p-4 fst-normal shadow o_colored_level s_blockquote_with_line" data-vcss="001" data-snippet="s_blockquote" data-name="Blockquote">
                                        <div class="s_blockquote_line_elt position-absolute top-0 start-0 bottom-0 bg-o-color-1"/>
                                        <div class="s_blockquote_wrap_icon position-absolute top-0 start-50 translate-middle w-100">
                                            <i class="s_blockquote_icon fa fa-quote-right d-block mx-auto rounded bg-o-color-1" role="img"/>
                                        </div>
                                        <p class="s_blockquote_quote my-auto">"Simply the perfect spot for geologist on vacation. I mixed work and pleasure. Gabi and her&amp;nbsp;wife were so nice!"</p>
                                        <div class="s_blockquote_infos d-flex gap-2 flex-row align-items-start justify-content-start w-100 text-start">
                                            <img src="/web/image/guest_house.img_custom_image_22" alt="" class="s_blockquote_avatar img rounded-circle img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="372" data-mimetype="image/webp" loading="lazy"/>
                                            <div class="s_blockquote_author">
                                                <span class="o_small-fs">
                                                    <strong>Paul&amp;nbsp;</strong><br/> Geologist</span>
                                            </div>
                                        </div>
                                    </blockquote>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="website_sale_product_oe_structure_website_sale_product_1" model="ir.ui.view">
        <field name="name">Custom - Product (oe_structure_website_sale_product_1)</field>
        <field name="key">website_sale.product_oe_structure_website_sale_product_1</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_sale_product_1']" position="replace">
                <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_product_1" data-editor-message="Drag blocks here to add them on all products">
                    <section class="s_cover parallax s_parallax_is_fixed o_cc pt72 pb72 o_colored_level o_cc1" data-scroll-background-ratio="1" data-snippet="s_cover" data-name="Cover">
                        <span class="s_parallax_bg_wrap">
                            <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/guest_house.img_custom_image_21&quot;); background-position: 50% 75%;" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp"/>
                        </span>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="container s_allow_columns">
                            <div class="row">
                                <div class="pt160 pb160 o_colored_level col-lg-9 offset-lg-2">
                                    <h2 style="text-align: center;" class="display-1">Gabi Guesthouse</h2>
                                    <p style="text-align: center;">A hidden gem in the middle of Belgium</p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
