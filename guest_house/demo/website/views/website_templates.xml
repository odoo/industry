<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">&amp;nbsp;<br/>Copyright © Gabi Guesthouse<span>
                        <br/>
                    </span><span class="o_small-fs">&amp;nbsp;</span></span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn rounded-circle btn-fill-primary">Contact Us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="option_footer_scrolltop" model="ir.ui.view">
        <field name="name">Custom - option_footer_scrolltop</field>
        <field name="key">website.option_footer_scrolltop</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="after">
                <div id="o_footer_scrolltop_wrapper" class="container h-0 d-flex align-items-center justify-content-center">
                    <a id="o_footer_scrolltop" role="button" href="#top" title="Scroll To Top" class="d-flex align-items-center justify-content-center btn btn-sm rounded-circle btn-custom bg-o-color-2" style="color: rgb(255, 255, 255); border-style: solid; border-image: none; border-left-color: var(--o-color-3); border-bottom-color: var(--o-color-3); border-right-color: var(--o-color-3); border-top-color: var(--o-color-3); border-width: 8px;">
                        <span class="oi fa-1x oi-chevron-up"/>
                    </a>
                </div>
            </xpath>
        </field>
    </record>
    <record id="template_footer_descriptive" model="ir.ui.view">
        <field name="name">Custom - Descriptive</field>
        <field name="key">website.template_footer_descriptive</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-top-width: 0px; --box-border-left-width: 0px; --box-border-right-width: 0px;">
                    <section class="s_text_block pt48" data-snippet="s_text_block" data-name="Container" style="position: relative;">

                        <div class="s_allow_columns container">
                            <div class="row">

                                <div class="col-lg-5 o_colored_level offset-1 offset-lg-0 col-10 pb16">
                                    <p>
                                        <img src="/web/image/guest_house.img_custom_image_25" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="444" data-mimetype="image/webp" style="width: 10% !important;" data-aspect-ratio="0/0" data-x="73.94048713235294" data-width="294.81824448529414" data-height="444.00000000000006" data-scale-x="1" data-scale-y="1" loading="lazy"/>
                                    </p>
                                    <h4 style="font-weight: normal;">Designed for disconnexion</h4>
                                    <p>Leave the noise behind and find your pace again. Our guesthouse was built as a sanctuary to help you unplug from the everyday world, immerse yourself in nature, and recharge in true peace. Disconnect to truly reconnect.</p>

                                </div>
                                <div class="o_colored_level offset-1 col-10 offset-lg-3 col-lg-4 pt40 pb32">
                                    <p><strong>Gabi Guesthouse</strong><br/>Mellery Boulevard 1<br/> 1495 Villers-la-Ville&amp;nbsp;<br/>Belgium</p>
                                    <ul class="list-unstyled mb-2">
                                        <li>
                                            <i class="fa fa-phone fa-fw me-2"/>
                                            <span class="o_force_ltr">
                                                <a href="tel:+32499847084">+32&amp;nbsp;499 84 70 84</a>
                                            </span>
                                        </li>
                                        <li>
                                            <i class="fa fa-envelope fa-fw me-2"/>
                                            <span>
                                                <a href="mailto:hello@gabiguesthouse.com">hello@gabiguesthouse.com</a>
                                            </span>
                                        </li>
                                    </ul>
                                    <div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank">
                                            <i class="fa fa-facebook rounded-circle shadow-sm o_editable_media o_cc o_cc4"/>
                                        </a>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank">
                                            <i class="fa fa-instagram rounded-circle shadow-sm o_editable_media o_cc o_cc4"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
