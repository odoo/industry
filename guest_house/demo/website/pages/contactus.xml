<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">guest_house.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="guest_house.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email,'name': request.params.get('name', ''),'phone': request.params.get('phone', ''),'email_from': request.params.get('email_from', ''),'company': request.params.get('company', ''),'subject': request.params.get('subject', ''),}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_form_aside pb120 o_colored_level oe_img_bg o_bg_img_center o_bg_img_origin_border_box pt152 o_full_screen_height" data-snippet="s_form_aside" data-name="Form Aside" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/14&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#041913&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" style="position: relative; background-image: url(&quot;/web/image/guest_house.img_custom_image_04&quot;);" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype-before-conversion="image/png" data-mimetype="image/webp">
                            <div class="o_we_shape o_html_builder_Connections_14 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F14.svg?c5=%23041913&quot;);"/>
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="18">
                                    <div class="o_colored_level o_cc o_cc1 rounded offset-1 offset-lg-0 col-10 col-lg-6 order-lg-0 g-height-4 g-col-lg-6 o_grid_item" style="z-index: 2; grid-area: 1 / 1 / 5 / 7; --grid-item-padding-x: 60px; --box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 16px; --box-border-top-left-radius: 16px; --grid-item-padding-y: 24px; order: 0;">
                                        <h1 class="display-1">Contact us</h1>
                                        <p class="lead">
                                            Don't hesitate to reach out about anything related to our guesthouse&amp;nbsp;or services.</p>
                                    </div>
                                    <div class="o_colored_level order-lg-0 offset-1 offset-lg-0 rounded g-height-6 o_grid_item col-10 g-col-lg-5 col-lg-5" style="z-index: 3; grid-area: 13 / 8 / 19 / 13; order: 2; background-color: transparent; background-image: linear-gradient(360deg, rgb(4, 25, 19) 0%, rgba(4, 25, 19, 0.44) 100%); --box-border-bottom-left-radius: 16px; --box-border-bottom-right-radius: 16px; --box-border-top-right-radius: 16px; --box-border-top-left-radius: 16px; --grid-item-padding-y: 16px; --grid-item-padding-x: 24px;">
                                        <h2 style="text-align: center; font-weight: normal;">320+ happy&amp;nbsp;guests&amp;nbsp;</h2>
                                        <h2 style="text-align: center; font-weight: normal;">who recommend our guesthouse.</h2>
                                        <p class="lead" style="text-align: center;">We are committed to delivering hight experience.</p>
                                    </div>
                                    <div class="o_colored_level col-lg-6 rounded offset-1 offset-lg-0 col-10 o_cc o_cc1 order-lg-0 g-height-12 g-col-lg-6 o_grid_item" style="z-index: 1; --grid-item-padding-y: 0px; --grid-item-padding-x: 15px; --box-border-bottom-left-radius: 16px; --box-border-bottom-right-radius: 16px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; grid-area: 5 / 1 / 17 / 7; order: 1;">
                                        <p class="lead">
                                            <br/>
                                        </p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div class="mb-3 s_website_form_field s_website_form_custom s_website_form_required col-lg-5 offset-lg-1" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact1">
                                                                <span class="s_website_form_label_content">Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact1" type="text" placeholder="John Doe" class="form-control s_website_form_input" name="name" required="" data-fill-with="name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-lg-5 s_website_form_custom" data-type="tel" data-translated-name="Phone Number">
                                                            <label class="s_website_form_label" for="contact2" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="Phone Number" value="" placeholder="+1 555-555-5556" id="contact2"/>
                                                        </div>
                                                        <div class="mb-3 s_website_form_field s_website_form_required s_website_form_model_required offset-lg-1 col-lg-5" data-type="email" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact3">
                                                                <span class="s_website_form_label_content">Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact3" type="email" placeholder="example@mail.com" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email"/>
                                                        </div>
                                                        <div class="mb-3 s_website_form_field s_website_form_custom col-lg-5" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact4">
                                                                <span class="s_website_form_label_content">Company</span>
                                                            </label>
                                                            <input id="contact4" type="text" class="form-control s_website_form_input" name="company" data-fill-with="parent_name" placeholder="My company"/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required offset-lg-1 col-lg-10" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact5">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact5" type="text" placeholder="Describe your request" class="form-control s_website_form_input" name="subject" required=""/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required offset-lg-1 col-lg-10" data-type="text" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact6">
                                                                <span class="s_website_form_label_content">Message</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea id="contact6" placeholder="Type your message here..." class="form-control s_website_form_input" name="description" required="" rows="6"/>
                                                            <span class="s_website_form_field_description small form-text text-muted"><br/>We typically respond within 1-2 business days.</span>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="contact7">
                                                                    <span class="s_website_form_label_content">Email To</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input id="contact7" type="hidden" class="form-control s_website_form_input" name="email_to"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end offset-lg-1 col-lg-10" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label">
                                                                <br/>
                                                            </div>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="s_website_form_send btn rounded-circle btn-fill-primary">Send Message</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_faq_list pt120 pb56 o_colored_level" data-snippet="s_faq_list" data-name="FAQ List">
                            <div class="container">
                                <div class="row s_nb_column_fixed">
                                    <div class="col-lg-12 pb24 o_colored_level offset-1 offset-lg-0 col-10">
                                        <h2 style="font-weight: normal;">Any question?</h2>
                                        <p class="lead">In this section, you can address common questions efficiently.</p>
                                    </div>
                                    <div class="col-lg-4 pt16 pb16 o_colored_level offset-1 offset-lg-0 col-10">
                                        <h3 class="h6-fs">
                                            <strong>What makes our guesthouse special?</strong>
                                            <br/>
                                        </h3>
                                        <p>We offer a warm, personal touch you won't find in big hotels; comfortable rooms, homemade breakfasts, and hosts who genuinely care about your stay.</p>
                                    </div>
                                    <div class="col-lg-4 pt16 pb16 o_colored_level offset-1 offset-lg-0 col-10">
                                        <h3 class="h6-fs">
                                            <strong>Is breakfast included?</strong>
                                            <br/>
                                        </h3>
                                        <p>Yes, a freshly prepared breakfast is included every morning, made with local and seasonal ingredients whenever possible.</p>
                                    </div>
                                    <div class="col-lg-4 pt16 pb16 o_colored_level offset-1 offset-lg-0 col-10">
                                        <h3 class="h6-fs">
                                            <strong>What are your check-in and check-out times?</strong>
                                            <br/>
                                        </h3>
                                        <p>Check-in is from 3:00 PM and check-out is until 11:00 AM. Early or late arrangements can often be made on request.</p>
                                    </div>
                                    <div class="col-lg-4 pt16 pb16 o_colored_level offset-1 offset-lg-0 col-10">
                                        <h3 class="h6-fs">
                                            <strong>Do you offer free parking or Wi-Fi?</strong>
                                            <br/>
                                        </h3>
                                        <p>Yes, both free parking and high-speed Wi-Fi are available throughout your stay at no extra cost.</p>
                                    </div>
                                    <div class="col-lg-4 pt16 pb16 o_colored_level offset-1 offset-lg-0 col-10">
                                        <h3 class="h6-fs">
                                            <strong>Is the guesthouse pet-friendly?</strong>
                                            <br/>
                                        </h3>
                                        <p>We welcome well-behaved pets in select rooms;&amp;nbsp;just let us know in advance so we can prepare accordingly.</p>
                                    </div>
                                    <div class="col-lg-4 pt16 pb16 o_colored_level offset-lg-0 offset-1 col-10">
                                        <h3 class="h6-fs">
                                            <strong>How far are you from the town center?</strong>
                                            <br/>
                                        </h3>
                                        <p>We're just a short walk from the town center, close to local restaurants, shops, and public transport.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_accordion_image pt64 pb120 o_colored_level" data-snippet="s_accordion_image" data-name="Accordion Image">
                            <div class="container">
                                <div class="row align-items-start">
                                    <div class="col-lg-7 pt16 o_colored_level offset-1 offset-lg-0 col-10 rounded" style="--box-border-bottom-left-radius: 8px; --box-border-bottom-right-radius: 8px; --box-border-top-right-radius: 8px; --box-border-top-left-radius: 8px;">
                                        <section class="s_map rounded-3 o_not_editable pt256 pb256" data-map-type="m" data-snippet="s_map" data-map-address="rue de mellery 8 " data-name="Map" data-vxml="001" data-map-zoom="13">
                                            <div class="map_container">
                                                <div class="css_non_editable_mode_hidden">
                                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                        An address must be specified for a map to be embedded
                                                    </div>
                                                </div>
                                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=rue%20de%20mellery%208%20&amp;t=m&amp;z=13&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                                <div class="s_map_color_filter" style="background-color: transparent; background-image: linear-gradient(0deg, rgb(4, 25, 19) 0%, rgba(4, 25, 19, 0) 29%, rgba(4, 25, 19, 0) 74%, rgb(4, 25, 19) 100%);"/>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="col-lg-4 offset-lg-1 pt24 o_colored_level offset-1 col-10">
                                        <h2>How to get there ?</h2>
                                        <p class="lead">Easy ways to reach us, no matter your favorite transport.</p>
                                        <div class="s_accordion" data-snippet="s_accordion" data-name="Accordion" data-vcss="000">
                                            <div id="o_contactus_accordion" class="s_accordion_highlight accordion o_custom_icons o_icons_plus_to_minus">
                                                <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                    <button type="button" id="o_contactus_accordion_btn_1" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none" data-bs-target="#o_contactus_accordion_1" aria-controls="o_contactus_accordion_1" data-bs-toggle="collapse" aria-expanded="true">
                                                        <span class="flex-grow-1">
                                                            <span class="base-fs">BY TRAIN&amp;nbsp;</span>
                                                            <br/>
                                                        </span>
                                                        <span class="o_custom_icons_wrap position-relative d-block flex-shrink-0 overflow-hidden"/>
                                                    </button>
                                                    <div id="o_contactus_accordion_1" class="accordion-collapse collapse show" data-bs-parent="#o_contactus_accordion" role="region" aria-labelledby="o_contactus_accordion_btn_1">
                                                        <div class="accordion-body">
                                                            <p>Take BART to Balboa Park Station. From there, board the 29 bus toward Bayview and get off at Executive Park. The building at 250 Executive Park Blvd, Suite 3400, is just a short walk from the stop.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                    <button type="button" id="o_contactus_accordion_btn_2" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none collapsed" data-bs-target="#o_contactus_accordion_2" aria-controls="o_contactus_accordion_2" data-bs-toggle="collapse" aria-expanded="false">
                                                        <span class="flex-grow-1">
                                                            <span class="base-fs">BY CAR</span>
                                                        </span>
                                                        <span class="o_custom_icons_wrap position-relative d-block flex-shrink-0 overflow-hidden"/>
                                                    </button>
                                                    <div id="o_contactus_accordion_2" class="accordion-collapse collapse" data-bs-parent="#o_contactus_accordion" role="region" aria-labelledby="o_contactus_accordion_btn_2">
                                                        <div class="accordion-body">
                                                            <p>From downtown San Francisco, follow US-101 South and exit at Bayshore Boulevard. Turn left onto Executive Park Blvd, then continue straight until you reach 250 Executive Park Blvd. Parking is available on-site near Suite 3400.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                    <button type="button" id="o_contactus_accordion_btn_3" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none collapsed" data-bs-target="#o_contactus_accordion_3" aria-controls="o_contactus_accordion_3" data-bs-toggle="collapse" aria-expanded="false">
                                                        <span class="flex-grow-1">
                                                            <span class="base-fs">BY BIKE</span>
                                                        </span>
                                                        <span class="o_custom_icons_wrap position-relative d-block flex-shrink-0 overflow-hidden"/>
                                                    </button>
                                                    <div id="o_contactus_accordion_3" class="accordion-collapse collapse" data-bs-parent="#o_contactus_accordion" role="region" aria-labelledby="o_contactus_accordion_btn_3">
                                                        <div class="accordion-body">
                                                            <p>Cyclists can follow the Bay Trail south from downtown and connect through Geneva Avenue. Head toward Executive Park Blvd, where bike racks are available at 250 Executive Park Blvd, Suite 3400.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
