<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="website_industry" model="website">
        <field name="name">guest_house</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="user_id" ref="base.public_user"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="logo" type="bytes" file="guest_house/static/src/img/content/website/logo.webp"/>
        <field name="favicon" type="bytes" file="guest_house/static/src/img/content/website/favicon.png"/>
        <field name="show_line_subtotals_tax_selection">tax_included</field>
        <field name="shop_ppr">3</field>
        <field name="product_page_image_layout">grid</field>
        <field name="product_page_image_width">66_pc</field>
        <field name="product_page_grid_columns">1</field>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[
            ('name', '=', 'default_website'),
            ('module', '=', 'base'),
            ('model', '=', 'website')]"/>
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
</odoo>
