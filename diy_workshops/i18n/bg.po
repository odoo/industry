"приложението „Счетоводно отчитане“</strong>."

#. module: diy_workshops
#: model_terms:ir.ui.view,arch_db:diy_workshops.homepage
msgid "Monthly DIY Membership – \"Sewcial Club\""
msgstr "Месечно членство „Направи си сам“ – „Sewcial Club“"

#. module: diy_workshops
#: model:product.template,name:diy_workshops.product_product_12_product_template
msgid "Monthly Membership – Sewcial Club"
msgstr "Месечно членство – Sewcial Club"

