            (DateTime.now().replace(hour=20, minute=30, second=0) + relativedelta(months=1, weekday=0)  + relativedelta(weekday=4)).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)
        "/>
        <field name="user_id" ref="base.user_admin" />
    </record>
</odoo>
