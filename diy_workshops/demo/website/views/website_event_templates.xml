<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="website_event_event_description_dates" model="ir.ui.view">
        <field name="name">Custom - Event Description Dates</field>
        <field name="key">website_event.event_description_dates</field>
        <field name="inherit_id" ref="website_event.event_description_dates"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//a[hasclass('o_wevent_add_to_ical')] | //a[hasclass('o_wevent_add_to_outlook')] | //a[hasclass('o_wevent_add_to_google_calendar')]" position="attributes">
                <attribute name="class" remove="btn btn-light" separator=" "/>
            </xpath>
            <xpath expr="//a[hasclass('o_wevent_add_to_google_calendar')]/img" position="attributes">
                <attribute name="class">rounded</attribute>
            </xpath>
        </field>
    </record>
    <record id="website_event_index_topbar" model="ir.ui.view">
        <field name="name">Custom - Topbar</field>
        <field name="key">website_event.index_topbar</field>
        <field name="inherit_id" ref="website_event.index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[hasclass('mb-0', 'h4-fs')]" position="replace">
                <h1 class="mb-0 display-1">Workshops</h1>
                <p><br/>There are workshops for everyone at YouCraft.</p>
            </xpath>
        </field>
    </record>
    <record id="website_event_opt_event_share_block" model="ir.ui.view">
        <field name="name">Custom - Share</field>
        <field name="key">website_event.opt_event_share_block</field>
        <field name="inherit_id" ref="website_event.event_description_full"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//aside[@id='o_wevent_event_main_sidebar']" position="inside">
                <div t-if="opt_event_share_block" class="o_wevent_sidebar_block" t-ignore="true">
                    <div>
                        <h6 class="o_wevent_sidebar_title">Share</h6>
                        <p>Find out what people see and say about this event, and join the conversation.</p>
                    </div>
                    <div class="s_share text-start o_no_link_popover oe_unremovable o_not_editable no_icon_color" data-snippet="s_share" data-name="Share">
                        <h4 class="s_share_title d-none">Share</h4>
                        <a href="https://www.facebook.com/sharer/sharer.php?u={url}" target="_blank" aria-label="Facebook" class="s_share_facebook ">
                            <i class="fa fa-facebook small_social_icon o_editable_media fa-stack"/>
                        </a>
                        <a href="https://twitter.com/intent/tweet?text={title}&amp;url={url}" target="_blank" aria-label="X" class="s_share_twitter d-none">
                            <i class="fa fa-twitter small_social_icon o_editable_media fa-stack"/>
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url={url}" target="_blank" aria-label="LinkedIn" class="s_share_linkedin ">
                            <i class="fa fa-linkedin small_social_icon o_editable_media fa-stack"/>
                        </a>
                        <a href="https://wa.me/?text={title}" target="_blank" aria-label="WhatsApp" class="s_share_whatsapp ">
                            <i class="fa fa-whatsapp small_social_icon o_editable_media fa-stack"/>
                        </a>
                        <a href="https://pinterest.com/pin/create/button/?url={url}&amp;media={media}&amp;description={title}" target="_blank" aria-label="Pinterest" class="s_share_pinterest d-none">
                            <i class="fa fa-pinterest small_social_icon o_editable_media fa-stack"/>
                        </a>
                        <a href="mailto:?body={url}&amp;subject={title}" aria-label="Email" class="s_share_email d-none">
                            <i class="fa fa-envelope small_social_icon o_editable_media fa-stack"/>
                        </a>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
<record id="website_event_index_oe_structure_we_index_0" model="ir.ui.view">
        <field name="name">Events (oe_structure_we_index_0)</field>
        <field name="key">website_event.index_oe_structure_we_index_0</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_we_index_0']" position="replace">
                <div id="oe_structure_we_index_0" class="oe_structure oe_empty" data-editor-message-default="true" data-editor-message="Drag blocks here">
                    <section class="s_kickoff o_cc o_cc5 parallax s_parallax_is_fixed o_colored_level pt112 pb112" data-scroll-background-ratio="1" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/18&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#ffffff&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" data-snippet="s_kickoff" data-name="Kickoff" style="position: relative;">
                        <span class="s_parallax_bg_wrap">
                            <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/diy_workshops.img_custom_image_11&quot;);" data-format-mimetype="image/webp" data-resize-width="1746" data-mimetype="image/webp"/>
                        </span>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="o_we_shape o_html_builder_Connections_18 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F18.svg?c5=%23ffffff&quot;);"/>
                        <div class="s_allow_columns container">
                            <p class="lead">Workshops for everyone</p>
                            <h2>Let's revive ancient crafts!</h2>
                        </div>
                    </section>
                    <div class="s_hr pt32 pb32 o_colored_level" data-snippet="s_hr" data-name="Separator">
                        <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-4);"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="website_event_index_oe_structure_we_index_2" model="ir.ui.view">
        <field name="name">Events (oe_structure_we_index_2)</field>
        <field name="key">website_event.index_oe_structure_we_index_2</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_we_index_2']" position="replace">
                <div id="oe_structure_we_index_2" class="oe_structure oe_empty" data-editor-message-default="true" data-editor-message="Drag blocks here">
                    <section class="s_big_number o_cc o_colored_level o_cc1 pt32 pb32" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/18&quot;,&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" data-snippet="s_big_number" data-name="Big number" style="position: relative;">
                        <div class="o_we_shape o_html_builder_Connections_18 o_shape_show_mobile"/>
                        <div class="container">
                            <div class="row s_nb_column_fixed">
                                <p>&amp;nbsp;</p>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="website_event_layout_oe_structure_website_event_layout_0" model="ir.ui.view">
        <field name="name">Event (oe_structure_website_event_layout_0)</field>
        <field name="key">website_event.layout_oe_structure_website_event_layout_0</field>
        <field name="inherit_id" ref="website_event.layout"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_event_layout_0']" position="replace">
                <div class="oe_structure oe_empty" id="oe_structure_website_event_layout_0" data-editor-message="Drag blocks here to add them on all events">
                    <section class="s_banner_connected o_cc o_cc5 pt128 pb136 parallax o_colored_level" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/18&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#ffffff&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" data-scroll-background-ratio="0.75" data-parallax-type="zoomOut" data-snippet="s_banner_connected" data-name="Banner connected" style="position: relative;">
                        <span class="s_parallax_bg_wrap">
                            <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/diy_workshops.img_custom_image_13&quot;); background-position: 50% 75%; top: -63.375px; bottom: -63.375px; transform: scale(1.31198);" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp"></span>
                        </span>
                        <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(135deg, rgb(69, 69, 69) 0%, rgba(95, 95, 95, 0.83) 37%, rgba(222, 222, 222, 0) 100%);"></div>
                        <div class="o_we_shape o_html_builder_Connections_18 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F18.svg?c5=%23ffffff&quot;);"></div>
                        <div class="container">
                            <div class="row">
                                <div class="o_colored_level col-lg-5">
                                    <h2>The best DIY workshops of Europe</h2>
                                    <p class="lead">With the best artisans</p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="s_hr pt32 pb32 o_colored_level" data-snippet="s_hr" data-name="Separator">
                        <hr class="w-100 mx-auto" style="border-top-color: rgba(34, 40, 40, 0);"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
