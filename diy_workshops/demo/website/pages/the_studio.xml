<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_page_the_studio" model="ir.ui.view">
        <field name="name">The studio</field>
        <field name="key">diy_workshops.page_the_studio</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <t t-name="diy_workshops.page_the_studio">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_banner_contained oe_img_bg o_bg_img_center o_bg_img_origin_border_box o_colored_level o_cc o_cc5 pt88 pb88 o_full_screen_height" style="background-image: url(&quot;/web/image/diy_workshops.img_custom_image_01&quot;);" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Containers/03&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" data-snippet="s_banner_contained" data-name="Banner Contained" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp">
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(135deg, rgba(0, 0, 0, 0.56) 0%, rgba(0, 0, 0, 0.16) 100%);" />
                            <div class="o_we_shape o_html_builder_Containers_03" style="background-image: url(&quot;/html_editor/shape/html_builder/Containers/03.svg?c5=o-color-4&quot;);" />
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-6 o_colored_level">
                                        <h1 class="display-1">Built to Inspire.</h1>
                                        <h2>
                                            <span class="text-o-color-3">Nature x Craftmanship</span>
                                        </h2>
                                        <p class="lead">In a quiet cabin surrounded by nature, we bring people together to explore, learn, and make with their hands. From <span class="o_text_highlight o_text_highlight_wavy" style="--text-highlight-color: var(--o-color-5); --text-highlight-width: 2px;">sewing</span> to <span class="o_text_highlight o_text_highlight_wavy" style="--text-highlight-color: var(--o-color-5); --text-highlight-width: 2px;">woodworking</span> and <span class="o_text_highlight o_text_highlight_wavy" style="--text-highlight-color: var(--o-color-5); --text-highlight-width: 2px;">ceramics</span>, the studio is a welcoming space where ideas become real.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block_split o_colored_level o_cc o_cc2 pt136 pb176" data-snippet="s_text_block_split" data-name="Text Split" style="background-color: transparent; background-image: linear-gradient(rgb(255, 255, 255) 0%, rgb(245, 240, 240) 100%); position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Miscellaneous/05&quot;,&quot;colors&quot;:{&quot;c3&quot;:&quot;o-color-3&quot;,&quot;c4&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}">
                            <div class="o_we_shape o_html_builder_Miscellaneous_05 o_shape_show_mobile" />
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-2 o_colored_level">
                                        <p class="h5-fs">THE STUDIO</p>
                                    </div>
                                    <div class="col-lg-7 offset-lg-3 o_colored_level">
                                        <p>
                                            <span class="h3-fs">
                                                This cabin was created as a place to <strong>slow down</strong>, focus, and build something meaningful. Every corner invites curiosity, <strong>craft</strong>, and the joy of making with <strong>care</strong>.
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="s_duo_images o_colored_level pb56 pt56" data-snippet="s_duo_images" data-name="Duo Images">
                            <div class="container">
                                <div class="row">
                                    <div class="o_colored_level col-12 pb40">
                                        <h2 style="text-align: center;">The crew</h2>
                                    </div>
                                    <div class="col-lg-6 pt8 pb8 o_colored_level col-6">
                                        <img class="img img-fluid rounded o_animate o_anim_fade_in o_visible" src="/web/image/diy_workshops.img_custom_image_02" alt="" loading="eager" data-shape="html_builder/geometric_round/geo_round_emerald" data-mimetype="image/svg+xml" data-aspect-ratio="1/1" data-file-name="portrait_lg_1.svg" style="animation-duration: 2s; animation-name: dummy;" />
                                        <br />
                                    </div>
                                    <div class="col-lg-6 pt8 pb8 o_colored_level col-6">
                                        <img class="img img-fluid rounded o_animate o_anim_fade_in o_visible" src="/web/image/diy_workshops.img_custom_image_03" alt="" loading="eager" data-shape="html_builder/geometric_round/geo_round_emerald" data-aspect-ratio="1/1" data-mimetype="image/svg+xml" data-file-name="portrait_lg_2.svg" data-shape-flip="x" style="animation-delay: 0.5s; animation-duration: 2s;" />
                                        <br />
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="s_text_block_split o_colored_level o_cc o_cc1 oe_img_bg o_bg_img_center o_bg_img_origin_border_box pb128 pt64" data-snippet="s_text_block_split" data-name="Text Split" data-format-mimetype="image/webp" style="background-image: url(&quot;/web/image/diy_workshops.img_custom_image_04&quot;); position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/18&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#2f2619&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" data-resize-width="1920" data-mimetype="image/webp">
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(0deg, rgb(255, 255, 255) 1%, rgba(255, 255, 255, 0) 41%, rgb(255, 255, 255) 100%, rgba(255, 255, 255, 0) 100%);" />
                            <div class="o_we_shape o_html_builder_Connections_18" />
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="22">
                                    <div class="o_colored_level o_grid_item g-col-lg-4 border g-height-7 col-lg-4" style="z-index: 1; grid-area: 2 / 1 / 9 / 5; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; --grid-item-padding-x: 16px; --grid-item-padding-y: 16px;">
                                        <p class="h5-fs">
                                            <span class="h3-fs">Meet Sasha and Joe, the core <strong>creative forces</strong> behind YouCraft Studio.</span>
                                        </p>
                                    </div>
                                    <div class="o_grid_item o_colored_level g-height-5 g-col-lg-6 col-lg-6" style="z-index: 3; grid-area: 11 / 1 / 16 / 7;">
                                        <h3>
                                            <b>Joe&amp;nbsp;</b>
                                        </h3>
                                        <p>
                                            <span class="h5-fs">
                                                <b>Woodworker &amp;amp; Edible Plant Expert</b>
                                            </span>
                                        </p>
                                        <p>Joe bridges the gap between the natural forest and the handcraft workshop. A skilled woodworker with a deep reverence for reclaimed timber, he brings precision and structural design to every project. When he’s not at the workbench, Joe draws on his deep knowledge of foraging and botany, blending ancient woodworking traditions with a passion for sustainable, nature-led living.</p>
                                    </div>
                                    <div class="o_colored_level o_grid_item g-height-6 g-col-lg-6 col-lg-6" style="z-index: 2; grid-area: 2 / 7 / 8 / 13;">
                                        <h3>
                                            <b>Sasha&amp;nbsp;</b>
                                        </h3>
                                        <p>
                                            <span class="h5-fs">
                                                <b>Nature Guide &amp;amp; Ceramist</b>
                                            </span>
                                        </p>
                                        <p>Sasha brings a deep, grounding connection to the natural world into every workshop. As both an experienced nature guide and a master ceramist, she helps makers slow down and draw inspiration directly from the environment around them. Whether she’s leading a mindful walk through the surrounding woods or teaching you to shape raw clay, Sasha’s focus is on reconnecting with natural elements and rediscovering the beauty of slow, tactile creation.</p>
                                    </div>
                                    <div class="o_grid_item o_colored_level g-height-4 g-col-lg-6 col-lg-6" style="z-index: 4; grid-area: 19 / 7 / 23 / 13;">
                                        <h3>
                                            <b>Collaborative Craft</b>
                                        </h3>
                                        <p>Together, Sasha and Joe host immersive, hands-on workshops in our nature studio. To keep the learning experience rich and diverse, they regularly collaborate with <strong>renowned guest artisans</strong>; bringing master weavers, blacksmiths, and traditional craftspeople into the studio to share their specialized techniques with our community</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_the_studio" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_the_studio" />
            <field name="url">/the-studio</field>
            <field name="website_id" ref="website_industry" />
            <field name="is_published" eval="True" />
            <field name="website_indexed" eval="True" />
        </record>
    </data>
</odoo>
