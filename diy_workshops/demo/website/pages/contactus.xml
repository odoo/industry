<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">diy_workshops.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="diy_workshops.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'name': request.params.get('name', ''),'phone': request.params.get('phone', ''),'email_from': request.params.get('email_from', ''),'contact_name': request.params.get('contact_name', ''),'description': request.params.get('description', ''),}" />
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values" />
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_website_form_bold pt24 o_colored_level pb80 oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-snippet="s_website_form_bold" data-name="Form Bold" data-format-mimetype="image/webp" style="background-image: url(&quot;/web/image/diy_workshops.img_custom_image_05&quot;); position: relative;" data-scroll-background-ratio="0" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/18&quot;,&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" data-resize-width="1920" data-mimetype="image/webp">
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(181deg, rgb(255, 255, 255) 0%, rgb(255, 255, 255) 13%, rgba(255, 255, 255, 0) 33%, rgba(255, 255, 255, 0) 52%, rgba(255, 255, 255, 0.42) 100%);" />
                            <div class="o_we_shape o_html_builder_Connections_18" />
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="18">
                                    <div class="o_colored_level o_grid_item g-col-lg-5 g-height-8 col-lg-5 o_cc o_cc1 rounded" style="z-index: 1; grid-area: 3 / 1 / 11 / 6; --grid-item-padding-y: 16px; --grid-item-padding-x: 16px; --box-border-bottom-left-radius: 16px; --box-border-bottom-right-radius: 16px; --box-border-top-right-radius: 16px; --box-border-top-left-radius: 16px;" data-scroll-background-ratio="0">
                                        <h1 class="display-1">
                                            <span class="text-o-color-5">Contact us.</span>
                                        </h1>
                                        <p>
                                            <br />
                                        </p>
                                        <p>
                                            <span class="text-o-color-5">
                                                <strong>YouCraft</strong>
                                                <br />
                                                Rue du Laid Burniat 5<br />
                                                1348 Louvain-la-Neuve<br />
                                                Belgium
                                            </span>
                                        </p>
                                        <p>
                                            <br />
                                        </p>
                                        <p>
                                            <span class="text-o-color-5">
                                                hello@youcraftstudio.com<br />
                                                +32(0)499 123 456
                                            </span>
                                        </p>
                                    </div>
                                    <div class="o_colored_level o_grid_item g-col-lg-6 g-height-14 col-lg-6" style="z-index: 3; grid-area: 5 / 7 / 19 / 13;" data-scroll-background-ratio="0">
                                        <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container-fluid">
                                                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name">
                                                            <label class="s_website_form_label" for="o24lt2zulf32j" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Name</span>
                                                                <span class="s_website_form_mark">    *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="John Doe" id="o24lt2zulf32j" data-fill-with="name" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 " data-type="tel" data-translated-name="Phone Number">
                                                            <label class="s_website_form_label" for="ofxxa4ybtlfb" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="phone" placeholder="+32 22 903 490" id="ofxxa4ybtlfb" data-fill-with="phone" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="email" data-translated-name="Your Email">
                                                            <label class="s_website_form_label" for="oz7e41z1i26" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Email</span>
                                                                <span class="s_website_form_mark">    *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="example@mail.com" id="oz7e41z1i26" data-fill-with="email" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject">
                                                            <label class="s_website_form_label" for="ohu1uvs8cuwg" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark">    *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="Describe your request" id="ohu1uvs8cuwg" data-fill-with="undefined" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="Your Question">
                                                            <label class="s_website_form_label" for="o8vc4bmx5y1d" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Question</span>
                                                                <span class="s_website_form_mark">    *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="" placeholder="Write your message here" id="o8vc4bmx5y1d" rows="5" />
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-end s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label" />
                                                            <span id="s_website_form_result" />
                                                            <a href="#" role="button" class="s_website_form_send o_translate_inline btn btn-lg btn-primary">Submit</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus" />
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry" />
            <field name="is_published" eval="True" />
            <field name="website_indexed" eval="True" />
        </record>
    </data>
</odoo>
