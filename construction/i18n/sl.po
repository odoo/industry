#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
#, fuzzy
msgid ""
"<b>Documents App</b>: Centralize blueprints, contracts, and permits, "
"ensuring that the latest versions are\n"
"                    always available to the team."
msgstr ""
"<b>Aplikacija dokumentov</b>: Centralizirajte načrte, pogodbe in dovoljenja "
"ter zagotovite, da so najnovejše različice\n"
"                    vedno na voljo ekipi."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
#, fuzzy
msgid ""
"<b>Field Service App</b>: Schedule and dispatch specialized crews for "
"specific interventions, tracking their\n"
"                    location and job status in real-time."
msgstr ""
"<b>Aplikacija za terenske storitve</b>: Načrtujte in razporedite "
"specializirane ekipe za specifične intervencije, spremljajte njihovo\n"
"                    lokacijo in status opravila v realnem času."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
#, fuzzy
msgid ""
"<b>Fleet App</b>: Manage your heavy machinery and vehicle fleet, tracking "
"maintenance schedules, fuel costs,\n"
"                    and driver assignments."
msgstr ""
"<b>Aplikacija Vozni park</b>: Upravljajte svojo težko mehanizacijo in vozni "
"park, spremljajte urnike vzdrževanja, stroške goriva,\n"
"                    in razporeditve voznikov."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
#, fuzzy
msgid ""
"<b>Inventory App</b>: Keep track of tools, equipment, and consumables across "
"multiple sites or warehouses,\n"
"                    reducing loss and theft."
msgstr ""
"<b>Aplikacija Zaloga</b>: Spremljajte orodja, opremo in potrošne materiale "
"na več lokacijah ali skladiščih,\n"
"                    s čimer zmanjšate izgubo in krajo."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
#, fuzzy
msgid ""
"<b>Invoicing App</b>: Handle complex billing scenarios like milestone "
"invoicing, down payments, and\n"
"                    retention based on project progress."
msgstr ""
"<b>Aplikacija za izdajo računov</b>: Obvladuje kompleksne scenarije "
"fakturiranja, kot so fakturiranje po mejnikih, predplačila in\n"
"                    zadrževanje glede na napredek projekta."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
#, fuzzy
msgid ""
"<b>Project App</b>: Manage construction sites as projects, organizing tasks "
"into stages like \"Foundation,\"\n"
"                    \"Framing,\" and \"Finishing\" with clear deadlines."
msgstr ""
"<b>Projektna aplikacija</b>: Upravljajte gradbišča kot projekte, "
"organizirajte opravila v faze, kot so \"Temelj,\" \n"
"                    \"Okvir,\" in \"Zakljucek\" z jasnimi roki."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
#, fuzzy
msgid ""
"<b>Purchase App</b>: Automate the procurement of building materials, "
"managing RFQs and purchase orders to\n"
"                    ensure timely delivery to the site."
msgstr ""
"<b>Aplikacija za nabavo</b>: Avtomatizirajte oskrbo gradbenih materialov z "
"upravljanjem RFQ-jev in nabavnih naročil za\n"
"                    zagotovitev pravočasne dobave na gradbišče."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
#, fuzzy
msgid ""
"<b>Timesheets App</b>: Track labour hours accurately with a mobile app that "
"allows workers to log time\n"
"                    against specific tasks or cost codes on-site."
msgstr ""
"<b>Aplikacija Časovnice</b>: Natančno spremljajte delovne ure z mobilno "
"aplikacijo, ki omogoča delavcem vnos časa\n"
"                    za določena opravila ali stroškovne kode na terenu."

