msgid "10kW reversible system"
msgstr "10千瓦可逆系统"

#. module: construction
#: model_terms:sale.order.template,note:construction.sale_order_template_1
msgid "30% deposit, 20% down payments up to completion"
msgstr "30% 定金，20% 预付款，直至竣工"

#. module: construction
#: model:sale.order.template.line,name:construction.sale_order_template_line_45
msgid "300L electric tank"
msgstr "300升电热水箱"

