#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Access Control:</strong> Limit sensitive files to relevant team "
"members."
msgstr ""
"<strong>Erişim Kontrolü:</strong> Hassas dosyalara erişimi ilgili ekip "
"üyeleriyle sınırlayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr "<strong>Muhasebe</strong> – İleri düzey finansal yönetim ve raporlama."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Alerts &amp; Notifications:</strong> Ensure deadlines are met."
msgstr ""
"<strong>Uyarılar &amp; Bildirimler:</strong> Son teslim tarihlerine "
"uyulduğundan emin olun."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>As a worksite manager,</strong> I decide the timing of onsite "
"deliveries."
msgstr ""
"<strong>Bir şantiye yöneticisi olarak,</strong> şantiye teslimatlarının "
"zamanlamasına karar veririm."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>As an inventory manager,</strong> I ensure just in time supplies."
msgstr ""
"<strong>Bir stok yöneticisi olarak,</strong> tedariklerin tam zamanında "
"yapılmasını sağlarım."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Assignments:</strong> Allocate engineers, site managers, and "
"subcontractors."
msgstr ""
"<strong>Görevler:</strong> Mühendisleri, şantiye yöneticilerini ve alt "
"yüklenicileri atayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Billing:</strong> Invoice based on work completion or project "
"milestones."
msgstr ""
"<strong>Faturalama:</strong> İş tamamlanmasına veya proje kilometre "
"taşlarına göre faturalandırın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Calendar Views:</strong> Visualize overlapping tasks and adjust "
"workloads."
msgstr ""
"<strong>Takvim Görünümleri:</strong> Çakışan görevleri görselleştirin ve iş "
"yüklerini ayarlayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Chatter &amp; Communication:</strong> Collaborate internally using "
"notes and messages linked to opportunities."
msgstr ""
"<strong>Chatter &amp; İletişim:</strong> Fırsatlara bağlı notları ve "
"mesajları kullanarak şirket içinde iş birliği yapın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Client Portal:</strong> Allow customers to track the status of their "
"requests."
msgstr ""
"<strong>Müşteri Portalı:</strong> Müşterilerin taleplerinin durumunu takip "
"etmelerini sağlayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Construction Builder</strong>"
msgstr "<strong>Yapı Oluşturucu</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Construction Developer</strong>"
msgstr "<strong>İnşaat Geliştiricisi</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Cost Analysis:</strong> Link labour to project expenses."
msgstr ""
"<strong>Maliyet Analizi:</strong> İşgücü maliyetlerini proje masraflarıyla "
"ilişkilendirin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Daily Logs:</strong> Employees enter hours per task."
msgstr ""
"<strong>Günlük Kayıtlar:</strong> Çalışanlar görev başına çalışma saatlerini "
"girer."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Document Requests:</strong> Send requests with follow up activities."
msgstr ""
"<strong>Belge Talepleri:</strong> Taleplerinizi takip faaliyetleriyle "
"birlikte gönderin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Employees</strong> – Manage workforce, skills, and certifications."
msgstr ""
"<strong></strong> 'daki Çalışanlar – İşgücünü, becerileri ve sertifikaları "
"yönetin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Fleet</strong> – Track machinery, vehicles, and maintenance "
"schedules."
msgstr ""
"<strong></strong> Filo Yönetimi – Makine, araç ve bakım programlarını takip "
"edin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Helpdesk App</strong> provides responsive customer service, tracks "
"inquiries, and resolves issues efficiently."
msgstr ""
"<strong>Yardım Masası uygulaması</strong> duyarlı müşteri hizmeti sağlar, "
"talepleri takip eder ve sorunları verimli bir şekilde çözer."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>How to use it:</strong>"
msgstr "<strong>Nasıl kullanılır</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and "
"then to create a new one for your own usage.</strong>"
msgstr ""
"<strong>Böyle bir durumda, bu veritabanını denemekten ve daha sonra kendi "
"kullanımınız için yeni bir veritabanı oluşturmaktan çekinmeyin.</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Inventory App</strong> manages materials, tracks deliveries, and "
"monitors site stock to prevent delays or shortages."
msgstr ""
"<strong>Stok uygulaması</strong> malzemeleri yönetir, teslimatları takip "
"eder ve gecikmeleri veya eksiklikleri önlemek için şantiye stokunu izler."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Invoice from Quotation:</strong> Convert approved quotes into "
"invoices."
msgstr ""
"<strong>Tekliften Fatura Oluşturma:</strong> Onaylanmış teklifleri faturaya "
"dönüştürün."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Invoicing App</strong> ensures timely billing, automates recurring "
"invoices, and integrates with project milestones."
msgstr ""
"<strong>Faturalama uygulaması</strong> zamanında faturalandırmayı sağlar, "
"yinelenen faturaları otomatikleştirir ve proje kilometre taşlarıyla entegre "
"olur."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Keep documentation organized:</strong> Centralize contracts, "
"drawings, and permits for easy access."
msgstr ""
"<strong>Belgeleri düzenli tutun:</strong> Kolay erişim için sözleşmeleri, "
"çizimleri ve izinleri merkezileştirin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Leads &amp; Opportunities:</strong> Record incoming inquiries from "
"emails, forms, or calls."
msgstr ""
"<strong>Aday Müşteriler &amp; Fırsatlar:</strong> E-postalardan, formlardan "
"veya aramalardan gelen talepleri kaydedin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Milestones:</strong> Define major project achievements."
msgstr ""
"<strong>Kilometre Taşları:</strong> Projenin başlıca başarılarını tanımlayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Monitor stock proactively:</strong> Avoid project delays by tracking "
"inventory in real-time."
msgstr ""
"<strong>Stoku proaktif bir şekilde izleyin:</strong> Stoğu gerçek zamanlı "
"olarak takip ederek proje gecikmelerinden kaçının."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Online Approval:</strong> Enable online customer approval."
msgstr ""
"<strong>Çevrimiçi Onay:</strong> Çevrimiçi müşteri onayını etkinleştirin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>PDF Output:</strong> Send branded quotations for client approval."
msgstr ""
"<strong>PDF Çıktısı:</strong> Müşterinin onayına sunmak üzere markalı "
"teklifler gönderin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Payment Tracking:</strong> Monitor outstanding client payments."
msgstr ""
"<strong>Ödeme Takibi:</strong> Ödenmemiş müşteri ödemelerini takip edin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Pipeline Management:</strong> Visualize lead stages and prioritize "
"follow-ups."
msgstr ""
"<strong>Huni Yönetimi:</strong> Aday müşteri aşamalarını görselleştirin ve "
"takip işlemlerine öncelik verin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Pricing &amp; Discounts:</strong> Adjust based on project size or "
"client agreements."
msgstr ""
"<strong>Fiyatlandırma &amp; İndirimler:</strong> Proje büyüklüğüne veya "
"müşteri anlaşmalarına göre ayarlayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Prioritization:</strong> Assign critical tickets to senior staff."
msgstr ""
"<strong>Önceliklendirme:</strong> Kritik biletleri kıdemli personele atayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Product Prices:</strong> Capture prices by suppliers to make the "
"best moves."
msgstr ""
"<strong>Ürün Fiyatları:</strong> En iyi hamleleri yapmak için "
"tedarikçilerden fiyatları alın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Progress Reporting:</strong> Compare actual time vs planned."
msgstr ""
"<strong>İlerleme Raporlaması:</strong> Gerçek süre ile planlanan süreyi "
"karşılaştırın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Project Files:</strong> Attach blueprints, permits, and contracts."
msgstr ""
"<strong>Proje Dosyaları:</strong> İnşaat planlarını, izin belgelerini ve "
"sözleşmeleri ekleyin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Project Updates</strong>: Capture project snapshots along the way "
"from the dashboard."
msgstr ""
"<strong>Proje Güncellemeleri</strong>: Gösterge Paneli’nden proje sürecine "
"ait anlık görüntüleri yakalayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Purchase App </strong>helps you managing requests for proposal, your "
"suppliers and contractors."
msgstr ""
"<strong>Satınalma uygulaması </strong>teklif taleplerinizi, "
"tedarikçilerinizi ve yüklenicilerinizi yönetmenize yardımcı olur."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Purchase Orders:</strong> Create purchase order for needed products "
"and services."
msgstr ""
"<strong>Satınalma Siparişleri:</strong> İhtiyaç duyulan ürün ve hizmetler "
"için satınalma siparişi oluşturun."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Quotation Templates:</strong> Predefine templates for recurrent "
"offers."
msgstr ""
"<strong>Teklif Şablonları:</strong> Tekrarlayan teklifler için şablonları "
"önceden tanımlayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Reordering:</strong> Automate purchase orders for low-stock items."
msgstr ""
"<strong>Yeniden Sipariş Verme:</strong> Stoku azalan ürünler için satınalma "
"siparişlerini otomatikleştirin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Resource Allocation:</strong> Assign workers, subcontractors, and "
"machinery."
msgstr ""
"<strong>Kaynak Ataması:</strong> İşçileri, taşıronları ve makineleri atayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Roles:</strong> Assign roles to workers and leverage the auto-assign "
"capability."
msgstr ""
"<strong>Roller:</strong> İşçilere roller atayın ve otomatik atama "
"yeteneğinden yararlanın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Sales App</strong>: Quickly generate detailed construction estimates "
"using reusable quotation templates, section templates and bill of materials, "
"enabling online client sign-offs and seamless conversion into sales orders."
msgstr ""
"<strong>Satış Uygulaması</strong>: Yeniden kullanılabilir teklif şablonları, "
"bölüm şablonları ve malzeme listelerini kullanarak hızlıca ayrıntılı inşaat "
"tahminleri oluşturun; çevrim içi müşteri onaylarını ve satış siparişlerine "
"sorunsuz dönüşümü etkinleştirin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Section Templates:</strong> Predefine templates for recurrent offer "
"sections."
msgstr ""
"<strong>Bölüm şablonları:</strong> Tekrarlayan teklif bölümleri için "
"şablonları önceden tanımlayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Sign</strong> – Collect digital signatures for contracts and "
"approvals."
msgstr ""
"<strong></strong> 'da İmzala – Sözleşmeler ve Onaylamalar için dijital "
"imzalar toplayın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Site Transfers:</strong> Allocate materials to specific construction "
"sites."
msgstr ""
"<strong>Saha Transferleri:</strong> Malzemeleri belirli inşaat sahalarına "
"tahsis edin."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Standardize templates:</strong> Use quotation and project templates "
"to save time and maintain consistency."
msgstr ""
"<strong>Şablonları standartlaştırın:</strong> Zamandan tasarruf etmek ve "
"tutarlılığı korumak için teklif ve proje şablonlarını kullanın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Stock Monitoring:</strong> Check available materials and reserve "
"them for projects."
msgstr ""
"<strong>Stok Takibi:</strong> Mevcut malzemeleri kontrol edin ve projeler "
"için ayırın."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Task Creation:</strong> Break down construction phases into "
"actionable items."
msgstr ""
"<strong>Görev Oluşturma:</strong> İnşa aşamalarını uygulanabilir alt "
"görevlere bölün."

#. module: construction
