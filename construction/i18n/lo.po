#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Access Control:</strong> Limit sensitive files to relevant team "
"members."
msgstr ""
"<strong>ການຄວບຄຸມການເຂົ້າເຖິງ:</strong> ຈຳກັດເອກະສານສຳຄັນໃຫ້ສະເພາະສະມາຊິກທີມທີ່ກ່ຽວຂ້ອງ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr "<strong>ບັນຊີ</strong> – ການຄຸ້ມຄອງການເງິນ ແລະ ການລາຍງານຂັ້ນສູງ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Alerts &amp; Notifications:</strong> Ensure deadlines are met."
msgstr "<strong>ການເຕືອນ ແລະ ແຈ້ງເຕືອນ:</strong> ຮັບປະກັນໃຫ້ທັນຕາມກຳນົດເວລາ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>As a worksite manager,</strong> I decide the timing of onsite "
"deliveries."
msgstr ""
"<strong>ໃນຖານະຜູ້ຈັດການສະໜາມ,</strong> ຂ້າພະເຈົ້າເປັນຜູ້ກຳນົດເວລາໃນການຈັດສົ່ງເຄື່ອງເຂົ້າສະໜາມ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>As an inventory manager,</strong> I ensure just in time supplies."
msgstr ""
"<strong>ໃນຖານະຜູ້ຈັດການສາງ,</strong> ຂ້າພະເຈົ້າຮັບປະກັນການສະໜອງເຄື່ອງໃຫ້ທັນເວລາພໍດີ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Assignments:</strong> Allocate engineers, site managers, and "
"subcontractors."
msgstr ""
"<strong>ການມອບໝາຍວຽກ:</strong> ຈັດສັນວິສະວະກອນ, ຜູ້ຄຸ້ມຄອງສະໜາມ ແລະ ຜູ້ຮັບເໝົາຊ່ວງ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Billing:</strong> Invoice based on work completion or project "
"milestones."
msgstr ""
"<strong>ການຮຽກເກັບເງິນ:</strong> ອອກໃບແຈ້ງໜີ້ຕາມຄວາມສຳເລັດຂອງວຽກ ຫຼື ຕາມໄລຍະຂອງໂຄງກາ"
"ນ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Calendar Views:</strong> Visualize overlapping tasks and adjust "
"workloads."
msgstr ""
"<strong>ມຸມມອງປະຕິທິນ:</strong> ເບິ່ງເຫັນວຽກທີ່ທັບຊ້ອນກັນ ແລະ ປັບປ່ຽນປະລິມານວຽກໄດ້ງ່າຍ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Chatter &amp; Communication:</strong> Collaborate internally using "
"notes and messages linked to opportunities."
msgstr ""
"<strong>ຊ່ອງສົນທະນາ ແລະ ການສື່ສານ:</strong> ຮ່ວມມືພາຍໃນໂດຍໃຊ້ບັນທຶກ ແລະ ຂໍ້ຄວາມທີ່ເຊື່ອມໂຍງກັ"
"ບໂອກາດທາງທຸລະກິດ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Client Portal:</strong> Allow customers to track the status of their "
"requests."
msgstr ""
"<strong>ພອດທັລລູກຄ້າ:</strong> ອະນຸຍາດໃຫ້ລູກຄ້າສາມາດຕິດຕາມສະຖານະຄຳຮ້ອງຂໍຂອງຕົນເອງໄດ້."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Construction Builder</strong>"
msgstr "<strong>ຜູ້ກໍ່ສ້າງອາຄານ</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Construction Developer</strong>"
msgstr "<strong>ຜູ້ພັດທະນາໂຄງການກໍ່ສ້າງ</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Cost Analysis:</strong> Link labour to project expenses."
msgstr ""
"<strong>ການວິເຄາະຕົ້ນທຶນ:</strong> ເຊື່ອມໂຍງຄ່າແຮງງານເຂົ້າກັບລາຍຈ່າຍໂຄງການ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Daily Logs:</strong> Employees enter hours per task."
msgstr ""
"<strong>ບັນທຶກປະຈຳວັນ:</strong> ພະນັກງານປ້ອນຊົ່ວໂມງເຮັດວຽກຕາມແຕ່ລະໜ້າວຽກ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Document Requests:</strong> Send requests with follow up activities."
msgstr ""
"<strong>ການຮ້ອງຂໍເອກະສານ:</strong> ສົ່ງຄຳຮ້ອງຂໍພ້ອມກິດຈະກຳຕິດຕາມຕໍ່ເນື່ອງ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Employees</strong> – Manage workforce, skills, and certifications."
msgstr ""
"<strong>ພະນັກງານ</strong> – ຄຸ້ມຄອງກຳລັງຄົນ, ທັກສະ ແລະ ໃບຢັ້ງຢືນວິຊາຊີບ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Fleet</strong> – Track machinery, vehicles, and maintenance "
"schedules."
msgstr ""
"<strong>ພາຫະນະ</strong> – ຕິດຕາມເຄື່ອງຈັກ, ພາຫະນະ ແລະ ຕາຕະລາງການບຳລຸງຮັກສາ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Helpdesk App</strong> provides responsive customer service, tracks "
"inquiries, and resolves issues efficiently."
msgstr ""
"<strong>ແອັບສູນຊ່ວຍເຫຼືອ</strong> ໃຫ້ບໍລິການລູກຄ້າຢ່າງວ່ອງໄວ, ຕິດຕາມການສອບຖາມ ແລະ ແກ້ໄຂບັນຫາ"
"ຢ່າງມີປະສິດທິພາບ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>How to use it:</strong>"
msgstr "<strong>ວິທີການນຳໃຊ້:</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and "
"then to create a new one for your own usage.</strong>"
msgstr ""
"<strong>ໃນກໍລະນີດັ່ງກ່າວ, ທ່ານສາມາດທົດລອງນຳໃຊ້ຖານຂໍ້ມູນນີ້ໄດ້ຢ່າງເຕັມທີ່ ແລ້ວຈຶ່ງສ້າງຖານຂໍ້ມູນໃໝ່ສຳລັບກາ"
"ນນຳໃຊ້ຕົວຈິງຂອງທ່ານ.</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Inventory App</strong> manages materials, tracks deliveries, and "
"monitors site stock to prevent delays or shortages."
msgstr ""
"<strong>ແອັບສາງສິນຄ້າ</strong> ຄຸ້ມຄອງວັດສະດຸ, ຕິດຕາມການຈັດສົ່ງ ແລະ ກວດກາສະຕັອກຢູ່ໜ້າວຽກ ເພື່ອ"
"ປ້ອງກັນຄວາມຊັກຊ້າ ຫຼື ການຂາດແຄນ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Invoice from Quotation:</strong> Convert approved quotes into "
"invoices."
msgstr ""
"<strong>ອອກໃບແຈ້ງໜີ້ຈາກໃບສະເໜີລາຄາ:</strong> ປ່ຽນໃບສະເໜີລາຄາທີ່ອະນຸມັດແລ້ວໃຫ້ເປັນໃບແຈ້ງໜີ້."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Invoicing App</strong> ensures timely billing, automates recurring "
"invoices, and integrates with project milestones."
msgstr ""
"<strong>ແອັບໃບແຈ້ງໜີ້</strong> ຮັບປະກັນການອອກບິນທັນເວລາ, ສ້າງໃບແຈ້ງໜີ້ແບບປະຈຳອັດຕະໂນມັດ ແລ"
"ະ ເຊື່ອມໂຍງກັບແຕ່ລະໄລຍະຂອງໂຄງການ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Keep documentation organized:</strong> Centralize contracts, "
"drawings, and permits for easy access."
msgstr ""
"<strong>ຈັດລະບຽບເອກະສານ:</strong> ຮວບຮວມສັນຍາ, ແບບແຕ້ມ ແລະ ໃບອະນຸຍາດໄວ້ບ່ອນດຽວເພື່ອໃຫ້"
"ເຂົ້າເຖິງງ່າຍ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Leads &amp; Opportunities:</strong> Record incoming inquiries from "
"emails, forms, or calls."
msgstr ""
"<strong>ລູກຄ້າມຸ່ງຫວັງ ແລະ ໂອກາດ:</strong> ບັນທຶກການສອບຖາມທີ່ເຂົ້າມາຈາກອີເມວ, ແບບຟອມ ຫຼື ສາ"
"ຍໂທລະສັບ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Milestones:</strong> Define major project achievements."
msgstr "<strong>ໄລຍະສຳຄັນ:</strong> ກຳນົດເປົ້າໝາຍຜົນສຳເລັດຫຼັກຂອງໂຄງການ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Monitor stock proactively:</strong> Avoid project delays by tracking "
"inventory in real-time."
msgstr ""
"<strong>ຕິດຕາມສະຕັອກຢ່າງຕັ້ງໜ້າ:</strong> ຫຼີກລ່ຽງຄວາມຊັກຊ້າຂອງໂຄງການໂດຍການຕິດຕາມສາງສິນຄ້າແ"
"ບບເວລາຈິງ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Online Approval:</strong> Enable online customer approval."
msgstr "<strong>ການອະນຸມັດອອນລາຍ:</strong> ເປີດໃຊ້ການອະນຸມັດອອນລາຍສຳລັບລູກຄ້າ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>PDF Output:</strong> Send branded quotations for client approval."
msgstr ""
"<strong>ເອກະສານ PDF:</strong> ສົ່ງໃບສະເໜີລາຄາທີ່ມີຮູບແບບສະເພາະຂອງບໍລິສັດເພື່ອໃຫ້ລູກຄ້າອະນຸມັດ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Payment Tracking:</strong> Monitor outstanding client payments."
msgstr "<strong>ການຕິດຕາມການຊຳລະ:</strong> ຕິດຕາມຍອດເງິນຄ້າງຊຳລະຂອງລູກຄ້າ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Pipeline Management:</strong> Visualize lead stages and prioritize "
"follow-ups."
msgstr ""
"<strong>ການຄຸ້ມຄອງຂະບວນການຂາຍ:</strong> ເບິ່ງເຫັນຂັ້ນຕອນຂອງລູກຄ້າມຸ່ງຫວັງ ແລະ ຈັດລຳດັບຄວາມສ"
"ຳຄັນໃນການຕິດຕາມ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Pricing &amp; Discounts:</strong> Adjust based on project size or "
"client agreements."
msgstr ""
"<strong>ລາຄາ ແລະ ສ່ວນຫຼຸດ:</strong> ປັບປ່ຽນຕາມຂະໜາດໂຄງການ ຫຼື ຂໍ້ຕົກລົງກັບລູກຄ້າ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Prioritization:</strong> Assign critical tickets to senior staff."
msgstr ""
"<strong>ການຈັດລຳດັບຄວາມສຳຄັນ:</strong> ມອບໝາຍໃບແຈ້ງບັນຫາທີ່ຮີບດ່ວນໃຫ້ພະນັກງານຂັ້ນອາວຸໂສ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Product Prices:</strong> Capture prices by suppliers to make the "
"best moves."
msgstr ""
"<strong>ລາຄາສິນຄ້າ:</strong> ບັນທຶກລາຄາຈາກຜູ້ສະໜອງເພື່ອຕັດສິນໃຈໃຫ້ດີທີ່ສຸດ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Progress Reporting:</strong> Compare actual time vs planned."
msgstr ""
"<strong>ການລາຍງານຄວາມຄືບໜ້າ:</strong> ປຽບທຽບເວລາຕົວຈິງກັບເວລາທີ່ວາງແຜນໄວ້."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Project Files:</strong> Attach blueprints, permits, and contracts."
msgstr ""
"<strong>ເອກະສານໂຄງການ:</strong> ແນບແບບແຕ້ມກໍ່ສ້າງ, ໃບອະນຸຍາດ ແລະ ສັນຍາຕ່າງໆ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Project Updates</strong>: Capture project snapshots along the way "
"from the dashboard."
msgstr ""
"<strong>ການອັບເດດໂຄງການ</strong>: ບັນທຶກພາບລວມສະຖານະໂຄງການໄດ້ຕະຫຼອດເວລາຜ່ານໜ້າກະດານຂໍ້"
"ມູນ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Purchase App </strong>helps you managing requests for proposal, your "
"suppliers and contractors."
msgstr ""
"<strong>ແອັບຈັດຊື້ </strong>ຊ່ວຍທ່ານຄຸ້ມຄອງໃບຮ້ອງຂໍລາຄາ, ຜູ້ສະໜອງ ແລະ ຜູ້ຮັບເໝົາຂອງທ່ານ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Purchase Orders:</strong> Create purchase order for needed products "
"and services."
msgstr ""
"<strong>ໃບສັ່ງຊື້:</strong> ສ້າງໃບສັ່ງຊື້ສຳລັບສິນຄ້າ ແລະ ບໍລິການທີ່ຈຳເປັນ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Quotation Templates:</strong> Predefine templates for recurrent "
"offers."
msgstr ""
"<strong>ຮ່າງໃບສະເໜີລາຄາ:</strong> ກຳນົດແບບຮ່າງໄວ້ລ່ວງໜ້າສຳລັບຂໍ້ສະເໜີທີ່ໃຊ້ເລື້ອຍໆ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Reordering:</strong> Automate purchase orders for low-stock items."
msgstr ""
"<strong>ການສັ່ງຊື້ຄືນ:</strong> ສ້າງໃບສັ່ງຊື້ອັດຕະໂນມັດສຳລັບສິນຄ້າທີ່ໃກ້ຈະໝົດສາງ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Resource Allocation:</strong> Assign workers, subcontractors, and "
"machinery."
msgstr ""
"<strong>ການຈັດສັນຊັບພະຍາກອນ:</strong> ມອບໝາຍຄົນງານ, ຜູ້ຮັບເໝົາຊ່ວງ ແລະ ເຄື່ອງຈັກ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Roles:</strong> Assign roles to workers and leverage the auto-assign "
"capability."
msgstr ""
"<strong>ບົດບາດ:</strong> ກຳນົດໜ້າທີ່ໃຫ້ແກ່ຄົນງານ ແລະ ນຳໃຊ້ລະບົບການມອບໝາຍວຽກອັດຕະໂນມັດ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Sales App</strong>: Quickly generate detailed construction estimates "
"using reusable quotation templates, section templates and bill of materials, "
"enabling online client sign-offs and seamless conversion into sales orders."
msgstr ""
"<strong>ແອັບການຂາຍ</strong>: ສ້າງໃບປະເມີນລາຄາກໍ່ສ້າງລະອຽດໄດ້ຢ່າງວ່ອງໄວ ໂດຍໃຊ້ຮ່າງໃບສະເໜີລ"
"າຄາ, ຮ່າງໝວດໝູ່ວຽກ ແລະ ລາຍການວັດສະດຸທີ່ນຳມາໃຊ້ຄືນໄດ້, ຮອງຮັບການເຊັນອະນຸມັດອອນລາຍ ແລະ ປ່ຽນເປັນ"
"ໃບສັ່ງຂາຍໄດ້ຢ່າງສະດວກ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Section Templates:</strong> Predefine templates for recurrent offer "
"sections."
msgstr ""
"<strong>ຮ່າງໝວດໝູ່ວຽກ:</strong> ກຳນົດແບບຮ່າງໄວ້ລ່ວງໜ້າສຳລັບໝວດໝູ່ວຽກທີ່ໃຊ້ເລື້ອຍໆ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Sign</strong> – Collect digital signatures for contracts and "
"approvals."
msgstr ""
"<strong>ລາຍເຊັນ</strong> – ເກັບກຳລາຍເຊັນດິຈິຕອນສຳລັບສັນຍາ ແລະ ການອະນຸມັດຕ່າງໆ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Site Transfers:</strong> Allocate materials to specific construction "
"sites."
msgstr ""
"<strong>ການໂອນຍ້າຍລະຫວ່າງສະໜາມ:</strong> ແຈກຢາຍວັດສະດຸໄປຍັງສະຖານທີ່ກໍ່ສ້າງສະເພາະ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Standardize templates:</strong> Use quotation and project templates "
"to save time and maintain consistency."
msgstr ""
"<strong>ສ້າງມາດຕະຖານແບບຮ່າງ:</strong> ໃຊ້ຮ່າງໃບສະເໜີລາຄາ ແລະ ຮ່າງໂຄງການເພື່ອປະຢັດເວລາ "
"ແລະ ຮັກສາຄວາມສະໝ່ຳສະເໝີ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Stock Monitoring:</strong> Check available materials and reserve "
"them for projects."
msgstr ""
"<strong>ການຕິດຕາມສະຕັອກ:</strong> ກວດສອບວັດສະດຸທີ່ມີ ແລະ ຈອງໄວ້ສຳລັບແຕ່ລະໂຄງການ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Task Creation:</strong> Break down construction phases into "
"actionable items."
msgstr ""
"<strong>ການສ້າງໜ້າວຽກ:</strong> ແບ່ງຂັ້ນຕອນການກໍ່ສ້າງອອກເປັນລາຍການວຽກຕົວຈິງ."

#. module: construction
#: model_terms:sale.order.template,note:construction.sale_order_template_1
msgid "<strong>Terms</strong>"
msgstr "<strong>ເງື່ອນໄຂ</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Ticket Management:</strong> Record issues or change requests."
msgstr ""
"<strong>ການຄຸ້ມຄອງໃບແຈ້ງບັນຫາ:</strong> ບັນທຶກບັນຫາ ຫຼື ຄຳຮ້ອງຂໍປ່ຽນແປງ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Timesheets App</strong> helps track time spent, enabling managers to "
"measure performance and costs in real-time."
msgstr ""
"<strong>ແອັບບັນທຶກເວລາ</strong> ຊ່ວຍຕິດຕາມເວລາທີ່ໃຊ້ໄປ, ເຮັດໃຫ້ຜູ້ຈັດການສາມາດວັດແທກປະສິດທິພາ"
"ບ ແລະ ຕົ້ນທຶນໄດ້ແບບເວລາຈິງ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Tips for success</strong>"
msgstr "<strong>ເຄັດລັບສູ່ຄວາມສຳເລັດ</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Track progress daily:</strong> Encourage teams to log time and "
"update task status regularly."
msgstr ""
"<strong>ຕິດຕາມຄວາມຄືບໜ້າປະຈຳວັນ:</strong> ຊຸກຍູ້ໃຫ້ທີມງານບັນທຶກເວລາ ແລະ ອັບເດດສະຖານະວຽກຢ່າ"
"ງສະໝ່ຳສະເໝີ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Use dashboards:</strong> Set up reporting dashboards to monitor "
"costs, schedules, and client satisfaction."
msgstr ""
"<strong>ນຳໃຊ້ໜ້າກະດານຂໍ້ມູນ:</strong> ຕັ້ງຄ່າໜ້າລາຍງານເພື່ອຕິດຕາມຕົ້ນທຶນ, ຕາຕະລາງເວລາ ແລະ ຄວ"
"າມເພິ່ງພໍໃຈຂອງລູກຄ້າ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Version Control:</strong> Track updates to important documents."
msgstr "<strong>ການຄວບຄຸມເວີຊັນ:</strong> ຕິດຕາມການປ່ຽນແປງຂອງເອກະສານສຳຄັນ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Website</strong> – Publish projects, showcase services, and capture "
"leads."
msgstr ""
"<strong>ເວັບໄຊ</strong> – ເຜີຍແຜ່ໂຄງການ, ສະແດງຜົນງານການບໍລິການ ແລະ ດຶງດູດລູກຄ້າມຸ່ງຫວັງ."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"A complete solution tailored for construction companies overseeing "
"<strong>complex and multi-trade projects</strong>."
msgstr ""
"ທາງອອກທີ່ສົມບູນແບບ ເໝາະສຳລັບບໍລິສັດກໍ່ສ້າງທີ່ຄຸ້ມຄອງ <strong>ໂຄງການທີ່ຊັບຊ້ອນ ແລະ ມີຫຼາຍຂະແໜງຊ່າງ</"
"strong>."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"A link to reach the online quotation from where the customer can confirm and "
