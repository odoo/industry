#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<b>Documents App</b>: Centralize blueprints, contracts, and permits, "
"ensuring that the latest versions are\n"
"                    always available to the team."
msgstr ""
"<b>Aplikasi Dokumen</b>: Kumpulkan cetak biru, kontrak, dan izin di satu "
"tempat untuk memastikan versi terbaru\n"
"                    selalu tersedia bagi tim."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<b>Fleet App</b>: Manage your heavy machinery and vehicle fleet, tracking "
"maintenance schedules, fuel costs,\n"
"                    and driver assignments."
msgstr ""
"<b>Aplikasi Armada</b>: Kelola armada alat berat dan kendaraan, lacak jadwal "
"maintenance, biaya bahan bakar,\n"
"                    dan penugasan pengemudi."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<b>Inventory App</b>: Keep track of tools, equipment, and consumables across "
"multiple sites or warehouses,\n"
"                    reducing loss and theft."
msgstr ""
"<b>Aplikasi Inventaris</b>: Pantau alat, perlengkapan, dan bahan habis pakai "
"di berbagai lokasi atau gudang\n"
"                    untuk mengurangi risiko kehilangan dan pencurian."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<b>Invoicing App</b>: Handle complex billing scenarios like milestone "
"invoicing, down payments, and\n"
"                    retention based on project progress."
msgstr ""
"<b>Aplikasi Faktur</b>: Tangani skenario faktur kompleks seperti faktur "
"berbasis milestone, uang muka, dan\n"
"                    retensi berdasarkan progres project."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<b>Project App</b>: Manage construction sites as projects, organizing tasks "
"into stages like \"Foundation,\"\n"
"                    \"Framing,\" and \"Finishing\" with clear deadlines."
msgstr ""
"<b>Aplikasi Project</b>: Kelola lokasi konstruksi sebagai project, atur "
"tugas dengan membuat tahapan seperti \"Fondasi,\"\n"
"                    \"Rangka,\" dan \"Penyelesaian\" dengan batas waktu yang "
"jelas."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<b>Purchase App</b>: Automate the procurement of building materials, "
"managing RFQs and purchase orders to\n"
"                    ensure timely delivery to the site."
msgstr ""
"<b>Aplikasi Purchase</b>: Otomatiskan pengadaan bahan bangunan, kelola "
"permintaan penawaran dan order pembelian agar\n"
"                    pengiriman selalu tepat waktu ke lokasi."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<b>Timesheets App</b>: Track labour hours accurately with a mobile app that "
"allows workers to log time\n"
"                    against specific tasks or cost codes on-site."
msgstr ""
"<b>Aplikasi Timesheet</b>: Pantau jam kerja secara akurat dengan aplikasi "
"mobile yang memungkinkan pekerja mencatat waktu\n"
"                    untuk tugas atau kode biaya tertentu di lokasi kerja."

