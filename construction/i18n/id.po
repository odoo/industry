#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Access Control:</strong> Limit sensitive files to relevant team "
"members."
msgstr ""
"<strong>Kontrol Akses:</strong> Batasi akses file sensitif hanya untuk "
"anggota tim yang berkepentingan."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr ""
"<strong>Akuntansi</strong> – Manajemen keuangan dan pelaporan tingkat lanjut."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Alerts &amp; Notifications:</strong> Ensure deadlines are met."
msgstr ""
"<strong>Peringatan &amp; Notifikasi:</strong> Pastikan batas waktu terpenuhi."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Assignments:</strong> Allocate engineers, site managers, and "
"subcontractors."
msgstr ""
"<strong>Penugasan:</strong> Tugaskan insinyur, site manager, dan "
"subkontraktor."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Billing:</strong> Invoice based on work completion or project\n"
"                    milestones."
msgstr ""
"<strong>Penagihan:</strong> Faktur didasarkan pada penyelesaian pekerjaan "
"atau\n"
"                    milestone project."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Calendar Views:</strong> Visualize overlapping tasks and adjust\n"
"                    workloads."
msgstr ""
"<strong>Tampilan Kalender:</strong> Visualisasikan tugas yang tumpang tindih "
"dan sesuaikan\n"
"                    beban kerja."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Chatter &amp; Communication:</strong> Collaborate internally using "
"notes\n"
"                    and messages linked to opportunities."
msgstr ""
"<strong>Chatter &amp; Komunikasi:</strong> Bekerja sama secara internal "
"menggunakan catatan\n"
"                    dan pesan yang terhubung dengan peluang."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Client Portal:</strong> Allow customers to track the status of "
"their\n"
"                    requests."
msgstr ""
"<strong>Portal Klien:</strong> Memungkinkan pelanggan melacak status\n"
"                    permintaannya."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Construction Builder</strong>"
msgstr "<strong>Kontraktor Bangunan</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Construction Developer</strong>"
msgstr "<strong>Pengembang Properti</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Cost Analysis:</strong> Link labour to project expenses."
msgstr ""
"<strong>Analisis Biaya:</strong> Hubungkan tukang dengan pengeluaran project."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Daily Logs:</strong> Employees enter hours per task."
msgstr "<strong>Log Harian:</strong> Karyawan memasukkan jam kerja per tugas."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Document Requests:</strong> Send requests with follow up activities."
msgstr ""
"<strong>Permintaan Dokumen:</strong> Kirimkan permintaan beserta aktivitas "
"follow-up."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Employees</strong> – Manage workforce, skills, and certifications."
msgstr ""
"<strong>Karyawan</strong> – Kelola tenaga kerja, keterampilan, dan "
"sertifikasi."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Fleet</strong> – Track machinery, vehicles, and maintenance "
"schedules."
msgstr ""
"<strong>Armada</strong> – Lacak mesin, kendaraan, dan jadwal maintenance."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Helpdesk App</strong> provides responsive customer service, tracks "
"inquiries,\n"
"            and resolves issues efficiently."
msgstr ""
"<strong>Aplikasi Helpdesk</strong> menyediakan layanan pelanggan yang "
"responsif, melacak pertanyaan,\n"
"            dan menyelesaikan masalah secara efisien."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>How to use it:</strong>"
msgstr "<strong>Cara menggunakannya:</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and "
"then\n"
"                        to create a new one for your own usage.</strong>"
msgstr ""
"<strong>Di situasi tersebut, jangan ragu untuk berkesperimentasi dengan "
"database ini dan lalu\n"
"                        buat database baru untuk penggunaan Anda sendiri.</"
"strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Inventory App</strong> manages materials, tracks deliveries, and "
"monitors site\n"
"            stock to prevent delays or shortages."
msgstr ""
"<strong>Aplikasi Inventaris</strong> mengelola material, melacak pengiriman, "
"dan memantau\n"
"            stok di lokasi untuk mencegah keterlambatan atau kekurangan stok."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Invoice from Quotation:</strong> Convert approved quotes into "
"invoices."
msgstr ""
"<strong>Faktur dari Penawaran:</strong> Ubah penawaran yang telah disetujui "
"menjadi faktur."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Invoicing App</strong> ensures timely billing, automates recurring "
"invoices, and\n"
"            integrates with project milestones."
msgstr ""
"<strong>Aplikasi Faktur</strong> memastikan penagihan tepat waktu, "
"mengotomatiskan faktur berulang, dan\n"
"            terintegrasi dengan milestone project."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Keep documentation organized:</strong>\n"
"                            Centralize contracts, drawings, and permits for "
"easy access."
msgstr ""
"<strong>Jaga keteraturan dokumentasi:</strong>\n"
"                            Pusatkan kontrak, gambar, dan izin agar mudah "
"diakses."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Leads &amp; Opportunities:</strong> Record incoming inquiries from\n"
"                    emails, forms, or calls."
msgstr ""
"<strong>Prospek &amp; Peluang:</strong> Catat pertanyaan yang masuk dari\n"
"                    email, formulir, atau panggilan telepon."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Milestones:</strong> Define major project achievements."
msgstr "<strong>Milestone:</strong> Tentukan pencapaian utama project."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Monitor stock proactively:</strong> Avoid\n"
"                            project delays by tracking inventory in real-"
"time."
msgstr ""
"<strong>Pantau stok secara proaktif:</strong> Hindari\n"
"                            penundaan proyej dengan melacak inventaris "
"secara real-time."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Online Approval:</strong> Enable online customer approval."
msgstr ""
"<strong>Persetujuan Online:</strong> Aktifkan persetujuan pelanggan secara "
"online."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>PDF Output:</strong> Send branded quotations for client approval."
msgstr ""
"<strong>Output PDF:</strong> Kirimkan penawaran bermerek untuk disetujui "
"klien."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Payment Tracking:</strong> Monitor outstanding client payments."
msgstr ""
"<strong>Pelacakan Pembayaran:</strong> Pantau pembayaran klien yang belum "
"lunas."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Pipeline Management:</strong> Visualize lead stages and prioritize\n"
"                    follow-ups."
msgstr ""
"<strong>Manajemen Pipeline:</strong> Visualisasikan tahapan prospek dan "
"prioritaskan\n"
"                    follow-up."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Pricing &amp; Discounts:</strong> Adjust based on project size or "
"client\n"
"                    agreements."
msgstr ""
"<strong>Harga &amp; Diskon:</strong> Sesuaikan berdasarkan ukuran project "
"atau\n"
"                    kesepakatan dengan klien."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Prioritization:</strong> Assign critical tickets to senior staff."
msgstr "<strong>Prioritas:</strong> Tugaskan tiket kritis kepada staf senior."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Product Prices:</strong> Capture prices by suppliers to make the\n"
"                    best moves."
msgstr ""
"<strong>Harga Produk:</strong> Catat harga dari pemasok untuk mengambil\n"
"                    langkah terbaik."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Progress Reporting:</strong> Compare actual time vs planned."
msgstr ""
"<strong>Laporan Progres:</strong> Bandingkan waktu aktual dengan waktu yang "
"direncanakan."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Project Files:</strong> Attach blueprints, permits, and contracts."
msgstr "<strong>File Project:</strong> Lampirkan cetak biru, izin, dan kontrak."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Project Updates</strong>: Capture project snapshots along the way "
"from the dashboard."
msgstr ""
"<strong>Update Project</strong>: Ambil cuplikan proyek secara berkala dari "
"dashboard."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Purchase App </strong>helps you managing requests for proposal, your "
"suppliers\n"
"            and contractors."
msgstr ""
"<strong>Aplikasi Purchase </strong>membantu Anda mengelola permintaan "
"penawaran, pemasok,\n"
"            dan kontraktor."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Purchase Orders:</strong> Create purchase order for needed products\n"
"                    and services."
msgstr ""
"<strong>Order Pembelian:</strong> Buat order pembelian untuk produk\n"
"                    dan layanan yang dibutuhkan."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Quotation Templates:</strong> Predefine templates for recurrent\n"
"                    offers."
msgstr ""
"<strong>Template Penawaran:</strong> Template yang sudah diaturkan untuk "
"penawaran\n"
"                     berulang."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Reordering:</strong> Automate purchase orders for low-stock items."
msgstr ""
"<strong>Pemesanan Ulang:</strong> Otomatiskan order pembelian untuk barang "
"yang hampir habis."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Resource Allocation:</strong> Assign workers, subcontractors, and\n"
"                    machinery."
msgstr ""
"<strong>Alokasi Sumber Daya:</strong> Tugaskan pekerja, subkontraktor, dan\n"
"                    permesinan."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Roles:</strong> Assign roles to workers and leverage the auto-"
"assign\n"
"                    capability."
msgstr ""
"<strong>Peran:</strong> Tetapkan peran untuk pekerja dan manfaatkan fitur "
"penugasan\n"
"                     otomatis."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Sign</strong> – Collect digital signatures for contracts and "
"approvals."
msgstr ""
"<strong>Tanda Tangan</strong> – Kumpulkan tanda tangan digital untuk kontrak "
"dan persetujuan."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Site Transfers:</strong> Allocate materials to specific "
"construction\n"
"                    sites."
msgstr ""
"<strong>Transfer Lokasi:</strong> Alokasikan material ke lokasi konstruksi\n"
"                    tertentu."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Standardize templates:</strong> Use\n"
"                            quotation and project templates to save time and "
"maintain consistency."
msgstr ""
"<strong>Standardisasi template:</strong> Gunakan\n"
"                            template penawaran dan project untuk menghemat "
"waktu dan menjaga konsistensi."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Stock Monitoring:</strong> Check available materials and reserve "
"them for\n"
"                    projects."
msgstr ""
"<strong>Pemantauan Stok:</strong> Periksa material yang tersedia dan "
"reservasi untuk\n"
"                    project mendatang."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Task Creation:</strong> Break down construction phases into "
"actionable items."
msgstr ""
"<strong>Pembuatan Tugas:</strong> Bagi tahapan konstruksi menjadi item-item "
"yang dapat ditindaklanjuti."

#. module: construction
#: model_terms:sale.order.template,note:construction.sale_order_template_1
msgid "<strong>Terms</strong>"
msgstr "<strong>Termin</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
