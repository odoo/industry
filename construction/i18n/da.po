#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Access Control:</strong> Limit sensitive files to relevant team "
"members."
msgstr ""
"<strong>Adgangskontrol:</strong> Begræns adgangen til følsomme filer til "
"relevante teammedlemmer."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr "<strong>Regnskab</strong> – Avanceret økonomistyring og rapportering."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Alerts &amp; Notifications:</strong> Ensure deadlines are met."
msgstr ""
"<strong>Meddelelser og notifikationer:</strong> Sørg for, at fristerne "
"overholdes."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Assignments:</strong> Allocate engineers, site managers, and "
"subcontractors."
msgstr ""
"<strong>Opgaver:</strong> Fordel ingeniører, byggeledere og "
"underentreprenører."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Billing:</strong> Invoice based on work completion or project\n"
"                    milestones."
msgstr ""
"<strong>Fakturering:</strong> Faktura baseret på færdiggjort arbejde eller "
"projektets\n"
"                    milepæle."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Calendar Views:</strong> Visualize overlapping tasks and adjust\n"
"                    workloads."
msgstr ""
"<strong>Kalendervisninger:</strong> Få et overblik over overlappende opgaver "
"og\n"
"                    justér arbejdsbyrden."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Chatter &amp; Communication:</strong> Collaborate internally using "
"notes\n"
"                    and messages linked to opportunities."
msgstr ""
"<strong>Chatter og kommunikation:</strong> Samarbejd internt ved hjælp af "
"noter\n"
"                    og beskeder knyttet til salgsmuligheder."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Client Portal:</strong> Allow customers to track the status of "
"their\n"
"                    requests."
msgstr ""
"<strong>Kundeportal:</strong> Giv kunderne mulighed for at se status på "
"deres\n"
"                    anmodninger."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Construction Builder</strong>"
msgstr "<strong>Entreprenør</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Construction Developer</strong>"
msgstr "<strong>Byggeentreprenør</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Cost Analysis:</strong> Link labour to project expenses."
msgstr ""
"<strong>Omkostningsanalyse:</strong> Knyt arbejdsindsatsen til "
"projektomkostningerne."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Daily Logs:</strong> Employees enter hours per task."
msgstr ""
"<strong>Daglige logfiler:</strong> Medarbejderne indtaster timerne pr. "
"opgave."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Document Requests:</strong> Send requests with follow up activities."
msgstr ""
"<strong>Anmodninger om dokumenter:</strong> Send anmodninger med opfølgende "
"handlinger."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Employees</strong> – Manage workforce, skills, and certifications."
msgstr ""
"<strong>Medarbejdere</strong> – Administrér personale, kompetencer og "
"certificeringer."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Fleet</strong> – Track machinery, vehicles, and maintenance "
"schedules."
msgstr ""
"<strong>Flåde</strong> – Hold styr på maskiner, køretøjer og "
"vedligeholdelsesplaner."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Helpdesk App</strong> provides responsive customer service, tracks "
"inquiries,\n"
"            and resolves issues efficiently."
msgstr ""
"<strong>Kundeserviceappen </strong> tilbyder hurtig kundeservice, holder "
"styr på henvendelser og\n"
"            løser problemer effektivt."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>How to use it:</strong>"
msgstr "<strong>Anvendelse:</strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and "
"then\n"
"                        to create a new one for your own usage.</strong>"
msgstr ""
"<strong>I sådanne tilfælde er du velkommen til at eksperimentere med denne "
"database og\n"
"                        derefter oprette en ny database til eget brug.</"
"strong>"

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Inventory App</strong> manages materials, tracks deliveries, and "
"monitors site\n"
"            stock to prevent delays or shortages."
msgstr ""
"<strong>Lagerappen</strong> administrerer materialer, sporer leverancer og "
"overvåger lagerbeholdningen på stedet\n"
"            for at undgå forsinkelser eller flaskehalse."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Invoice from Quotation:</strong> Convert approved quotes into "
"invoices."
msgstr ""
"<strong>Faktura baseret på tilbud:</strong> Omdan godkendte tilbud til "
"fakturaer."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Invoicing App</strong> ensures timely billing, automates recurring "
"invoices, and\n"
"            integrates with project milestones."
msgstr ""
"<strong>Faktureringsappen </strong> sikrer hurtig fakturering, automatiserer "
"tilbagevendende fakturaer og\n"
"            kan integreres i projektmilepæle."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Keep documentation organized:</strong>\n"
"                            Centralize contracts, drawings, and permits for "
"easy access."
msgstr ""
"<strong>Hold orden i dokumentationen:</strong>\n"
"                            Saml kontrakter, tegninger og godkendelser ét "
"sted for at gøre det nemmere at få adgang til dem."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Leads &amp; Opportunities:</strong> Record incoming inquiries from\n"
"                    emails, forms, or calls."
msgstr ""
"<strong>Leads og salgsmuligheder:</strong> Registrér indkommende "
"henvendelser fra\n"
"e-mails, formularer eller opkald."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Milestones:</strong> Define major project achievements."
msgstr "<strong>Milepæle:</strong> Definér de vigtigste resultater i projektet."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Monitor stock proactively:</strong> Avoid\n"
"                            project delays by tracking inventory in real-"
"time."
msgstr ""
"<strong>Proaktiv overvågning af lageret:</strong> Undgå\n"
"                            projektforsinkelser ved at spore dit lager i "
"realtid."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Online Approval:</strong> Enable online customer approval."
msgstr ""
"<strong>Online-godkendelse:</strong> Aktivér online-godkendelse af kunder."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>PDF Output:</strong> Send branded quotations for client approval."
msgstr ""
"<strong>PDF-filer:</strong> Send tilbud med jeres logo til kunden til "
"godkendelse."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Payment Tracking:</strong> Monitor outstanding client payments."
msgstr ""
"<strong>Betalingsoversigt:</strong> Hold øje med udestående kundebetalinger."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Pipeline Management:</strong> Visualize lead stages and prioritize\n"
"                    follow-ups."
msgstr ""
"<strong>Styring af pipeline:</strong> Visualisér lead-faser, og prioritér\n"
"opfølgende handlinger."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Pricing &amp; Discounts:</strong> Adjust based on project size or "
"client\n"
"                    agreements."
msgstr ""
"<strong>Pris og rabatter:</strong> Tilpas priserne alt efter projektets "
"omfang eller\n"
"aftaler med kunderne."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Prioritization:</strong> Assign critical tickets to senior staff."
msgstr ""
"<strong>Prioritering:</strong> Tildel kritiske sager til de ansvarlige "
"ledere."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Product Prices:</strong> Capture prices by suppliers to make the\n"
"                    best moves."
msgstr ""
"<strong>Produktpriser:</strong> Registrér leverandørernes priser for at "
"kunne\n"
"                    træffe de bedste beslutninger."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid "<strong>Progress Reporting:</strong> Compare actual time vs planned."
msgstr ""
"<strong>Statusrapportering:</strong> Sammenlign den faktiske tid med den "
"planlagte tid."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Project Files:</strong> Attach blueprints, permits, and contracts."
msgstr ""
"<strong>Projektfiler:</strong> Vedhæft byggetegninger, tilladelser og "
"kontrakter."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Project Updates</strong>: Capture project snapshots along the way "
"from the dashboard."
msgstr ""
"<strong>Projektopdateringer</strong>: Få et overblik over projektet via "
"dashboardet gennem hele processen."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Purchase App </strong>helps you managing requests for proposal, your "
"suppliers\n"
"            and contractors."
msgstr ""
"<strong>Med indkøbsappen</strong> kan du administrere tilbudsanmodninger, "
"dine leverandører\n"
"            og underleverandører."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Purchase Orders:</strong> Create purchase order for needed products\n"
"                    and services."
msgstr ""
"<strong>Bestillinger:</strong> Opret bestillinger på de produkter\n"
"og tjenester, du har brug for."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Quotation Templates:</strong> Predefine templates for recurrent\n"
"                    offers."
msgstr ""
"<strong>Tilbudsskabeloner:</strong> Opret foruddefinerede skabeloner til "
"tilbagevendende\n"
"                    tilbud."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Reordering:</strong> Automate purchase orders for low-stock items."
msgstr ""
"<strong>Genbestilling:</strong> Automatisér bestillinger af varer med lav "
"lagerbeholdning."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Resource Allocation:</strong> Assign workers, subcontractors, and\n"
"                    machinery."
msgstr ""
"<strong>Ressourcefordeling:</strong> Tildel arbejdere, underentreprenører "
"og\n"
"                    maskiner."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Roles:</strong> Assign roles to workers and leverage the auto-"
"assign\n"
"                    capability."
msgstr ""
"<strong>Roller:</strong> Tildel medarbejderne roller, og benyt den "
"automatiske\n"
"                     tildelingsfunktion."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Sign</strong> – Collect digital signatures for contracts and "
"approvals."
msgstr ""
"<strong>E-signatur</strong> – Indsaml digitale underskrifter til kontrakter "
"og godkendelser."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Site Transfers:</strong> Allocate materials to specific "
"construction\n"
"                    sites."
msgstr ""
"<strong>Overførsler til byggepladser:</strong> Tildel materialer til "
"bestemte\n"
"                    byggepladser."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Standardize templates:</strong> Use\n"
"                            quotation and project templates to save time and "
"maintain consistency."
msgstr ""
"<strong>Standardisér skabeloner:</strong> Brug\n"
"                            tilbuds- og projektskabeloner for at spare tid "
"og sikre ensartethed."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Stock Monitoring:</strong> Check available materials and reserve "
"them for\n"
"                    projects."
msgstr ""
"<strong>Overvågning af lager:</strong> Kontrollér de tilgængelige "
"materialer, og reservér dem til\n"
"                    projekter."

#. module: construction
#: model_terms:ir.ui.view,arch_db:construction.welcome_article_body
msgid ""
"<strong>Task Creation:</strong> Break down construction phases into "
"actionable items."
msgstr ""
"<strong>Opgaveformulering:</strong> Opdel byggefaserne i gennemførlige "
"enkelttrin."

#. module: construction
