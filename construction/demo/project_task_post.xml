<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1" auto_sequence="1" context="{'mail_auto_subscribe_no_notify': True}">
<!-- 
    These tasks are copies of the tasks from the project template that 
    were created by confirming the sale order.
    Assigns them an id to be used in other files.
-->

<!-- S00001 -->
    <!-- S00001: Architect -->
    <function model="ir.model.data" name="_update_xmlids">
        <value model="project.task" eval="[{
            'xml_id': 'construction.project_task_9', 
            'record': obj().search([('project_id', '=', ref('construction.project_project_4')), ('name', '=', 'Architect')], limit=1)}]"/>
    </function>
    <record id="project_task_9" model="project.task">
        <field name="name">Architect</field>
        <field name="project_id" ref="project_project_4"/>
        <field name="stage_id" ref="planning_project_stage_3"/>
        <field name="state">1_done</field>
    </record>

