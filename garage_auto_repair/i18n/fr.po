#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<i>Example:</i> If you send a 3-hour appointment link on October 1st, Odoo "
"will propose an\n"
"                                    appointment starting October 15th based "
"on resource availability. The customer can adjust\n"
"                                    the date sooner or later based on open "
"slots. This buffer prevents same-day auto-bookings\n"
"                                    that clients might miss."
msgstr ""
"<i>Exemple :</i> Si vous envoyez un lien de rendez-vous de 3 heures le 1er "
"octobre, Odoo proposera un\n"
"                                    rendez-vous à partir du 15 octobre en "
"fonction de la disponibilité des ressources. Le client peut choisir\n"
"                                    une date antérieure ou ultérieure selon "
"les créneaux disponibles. Ce délai évite les réservations automatiques le "
"jour même\n"
"                                    que les clients risqueraient de manquer."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<i>Prerequisites:</i> The customer’s email and vehicle must be assigned "
"before moving a task to this\n"
"                            stage."
msgstr ""
"<i>Prérequis :</i> L'adresse e-mail du client et son véhicule doivent être "
"renseignés avant de déplacer une tâche vers cette\n"
"                            étape."

