#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Automatic Identification:</b> Plate and chassis numbers automatically "
"placed on every quotation, sales\n"
"                    order, and invoice"
msgstr ""
"<b>Identification automatique :</b> Numéros de plaque d'immatriculation et "
"de châssis automatiquement ajoutés à chaque devis, commande\n"
"                    client et facture"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Booking Lead Time (Options Tab):</b> Sets the minimum notice period "
"before a proposed booking\n"
"                            date."
msgstr ""
"<b>Délai de réservation (onglet Options) :</b> Définit le délai minimum à "
"respecter avant une date de rendez-vous\n"
"                            proposée."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Clarification:</b> If you need additional details, use the <b>Chatter</b> "
"to message the client directly."
msgstr ""
"<b>Clarification :</b> Si vous avez besoin de précisions, utilisez le "
"<b>chatter</b> pour contacter directement le client."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Consumables:</b> Treat items as consumables for straightforward pricing, "
"cost tracking, and simplified\n"
"                    traceability."
msgstr ""
"<b>Consommables :</b> Traitez les articles comme des consommables pour "
"simplifier la tarification, le suivi des coûts et la\n"
"                    traçabilité."

#. module: garage_auto_repair
#: model_terms:appointment.type,message_intro:garage_auto_repair.appointment_type_1
msgid "<b>Dear Customer,</b>"
msgstr "<b>Cher client,</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Done:</b> After the client picks up their vehicle, drag the task here and "
"mark the\n"
"                <b>Vehicle Checked Out</b> box."
msgstr ""
"<b>Terminé :</b> Une fois que le client a récupéré son véhicule, faites "
"glisser la tâche ici et cochez la case\n"
"                <b>Véhicule récupéré</b>."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.homepage
msgid "<b>Emergency Repairs</b>"
msgstr "<b>Réparations d'urgence</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Existing Customer:</b> Select the correct customer profile and their "
"vehicle."
msgstr ""
"<b>Client existant :</b> Sélectionnez la fiche du client concerné et son "
"véhicule."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>Explore Free Apps</b>"
msgstr "<b>Découvrez les applications gratuites</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Handling Emergencies &amp; Long Interventions: </b>Use the "
"<b>Intervention </b>appointment type (in demo data)\n"
"                for urgent repairs or multi-day jobs. Follow the standard "
"web form flow, which blocks out the initial day. If\n"
"                the repair takes longer, manually extend the appointment "
"duration on the calendar."
msgstr ""
"<b>Gestion des urgences &amp; des interventions longues : </b>Utilisez le "
"type de rendez-vous <b>Intervention </b>(dans les données de démonstration)\n"
"                pour les réparations urgentes ou les travaux sur plusieurs "
"jours. Suivez le processus habituel du formulaire web, qui réserve la "
"première journée. Si\n"
"                la réparation prend plus de temps, prolongez manuellement la "
"durée du rendez-vous dans le calendrier."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Handling Phone Appointments: </b> If a customer calls and wants to book "
"directly:"
msgstr ""
"<b>Gestion des rendez-vous téléphoniques : </b> Si un client appelle et "
"souhaite réserver directement :"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Initial Contact:</b> The customer submits a contact form on the website "
"with details and optional photo\n"
"                    attachments."
msgstr ""
"<b>Premier contact :</b> Le client soumet un formulaire de contact sur le "
"site web avec des détails et éventuellement des photos\n"
"                    en pièces jointes."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Link Sent:</b> Contains tasks where an appointment link has been sent to "
"the client."
msgstr ""
"<b>Lien envoyé :</b> Contient les tâches pour lesquelles un lien de prise de "
"rendez-vous a été envoyé au client."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.ir_ui_view_3368
msgid ""
"<b>My Company</b><br/>8000 Marina Blvd, Suite 300 <br/> Brisbane CA 94005 "
"<br/>United States"
msgstr ""
"<b>Ma Société</b><br/>8000 Marina Blvd, Suite 300 <br/> Brisbane CA 94005 "
"<br/>États-Unis"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>New Customer:</b> Create the customer, add their vehicle, and link it to "
"the task."
msgstr ""
"<b>Nouveau client :</b> Créez la fiche du client, ajoutez son véhicule et "
"associez-le à la tâche."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>New Requests:</b> Houses all incoming intervention requests that need "
"qualification."
msgstr ""
"<b>Nouvelles demandes :</b> Regroupe toutes les demandes d'intervention "
"reçues qui doivent être qualifiées."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Resources:</b> Resources can be team members or physical equipment. In "
"our demo data, we use\n"
"                            available car lifts (<i>Car Lift 1</i> and "
"<i>Car Lift 2</i>) to set maximum concurrent capacity."
msgstr ""
"<b>Ressources :</b> Les ressources peuvent être des membres de l'équipe ou "
"des équipements physiques. Dans nos données de démonstration, nous "
"utilisons\n"
"                            les ponts élévateurs disponibles (<i>Pont "
"élévateur 1</i> et <i>Pont élévateur 2</i>) pour définir la capacité "
"maximale d'interventions simultanées."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Scheduling:</b> Once the request is qualified, select the appropriate "
"appointment type and move the task\n"
"                    to the next stage. Odoo will automatically email the "
"client a proposed time slot, which they can reschedule\n"
"                    if necessary."
msgstr ""
"<b>Planification :</b> Une fois la demande qualifiée, sélectionnez le type "
"de rendez-vous approprié et déplacez la tâche\n"
"                    vers l'étape suivante. Odoo enverra automatiquement au "
"client un e-mail proposant un créneau horaire, qu'il pourra modifier\n"
"                    si nécessaire."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Status &amp; Usage:</b> Vehicle status (Active or Downgraded) &amp; "
"latest odometer reading"
msgstr ""
"<b>Statut &amp; utilisation :</b> Statut du véhicule (Actif ou Déclassé) "
"&amp; dernier relevé du compteur kilométrique"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Task Creation:</b> This automatically creates a new task in the "
"<b>Intervention</b> project."
msgstr ""
"<b>Création de tâche :</b> Cette action crée automatiquement une nouvelle "
"tâche dans le projet <b>Intervention</b>."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Technical Info:</b> Tire specs, motor block references, and other "
"technical data"
msgstr ""
"<b>Informations techniques :</b> Dimensions des pneus, références du bloc "
"moteur et autres données techniques"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>The Sales app offers a variety of flexible features, including:</b>"
msgstr ""
"<b>L'application Ventes offre de nombreuses fonctionnalités flexibles, "
"notamment :</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>To Be Taken:</b> Once repairs are complete, move the task here. An "
"automated email will notify the client\n"
"                that their vehicle is ready for pickup."
msgstr ""
"<b>À récupérer :</b> Une fois les réparations terminées, déplacez la tâche "
"ici. Un e-mail automatique informera le client\n"
"                que son véhicule est prêt à être récupéré."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>To Do:</b> Holds all intervention tasks scheduled to be performed today."
msgstr ""
"<b>À faire :</b> Regroupe toutes les tâches d'intervention prévues pour "
"aujourd'hui."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Tracked Products:</b> Track exact stock quantities and inventory "
"movements."
msgstr ""
"<b>Produits suivis :</b> Suivez les quantités exactes en stock et les "
"mouvements de stock."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>Vehicle Specs:</b> Brand, model, model year, type, etc."
msgstr ""
"<b>Caractéristiques du véhicule :</b> Marque, modèle, année du modèle, type, "
"etc."

#. module: garage_auto_repair
#: model:mail.template,body_html:garage_auto_repair.mail_template_task_appointment_booking
msgid ""
"<div>\n"
"        <p>Dear <t t-out=\"object.x_vehicle_id.x_owner_id.name or "
"'Customer'\"></t>,</p>\n"
"        <p>Your vehicle <strong><t t-"
"out=\"object.x_vehicle_id.license_plate\"></t></strong> is due for its "
"scheduled service.</p>\n"
"        <p>We’ve scheduled a <strong>proposed appointment</strong> for you "
"on <t t-out=\"object.x_appointment_date\" t-options=\"{&quot;widget&quot;: "
"&quot;datetime&quot;, &quot;tz_name&quot;: "
"object.x_appointment_type_id.appointment_tz, &quot;format&quot;: "
"&quot;medium&quot;}\"></t></p>\n"
"        <p>Please confirm this appointment by clicking the link below:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_accept_url }}\">Accept Suggested "
