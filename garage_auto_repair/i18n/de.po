#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Automatic Identification:</b> Plate and chassis numbers automatically "
"placed on every quotation, sales\n"
"                    order, and invoice"
msgstr ""
"<b>Automatische Identifizierung:</b> Kennzeichen- und Fahrgestellnummern "
"werden automatisch auf jedem Angebot, jedem\n"
"                    Verkaufsauftrag und jeder Rechnung angegeben"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Booking Lead Time (Options Tab):</b> Sets the minimum notice period "
"before a proposed booking\n"
"                            date."
msgstr ""
"<b>Buchungsvorlaufzeit (Reiter „Optionen“):</b> Legt die Mindestvorlaufzeit "
"vor einem vorgeschlagenen Buchungstermin fest\n"
"                            ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Clarification:</b> If you need additional details, use the <b>Chatter</b> "
"to message the client directly."
msgstr ""
"<b>Erläuterung:</b> Wenn Sie weitere Informationen benötigen, nutzen Sie den "
"<b>Chatter</b>, um dem Kunden direkt eine Nachricht zu senden."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Consumables:</b> Treat items as consumables for straightforward pricing, "
"cost tracking, and simplified\n"
"                    traceability."
msgstr ""
"<b>Verbrauchsmaterialien:</b> Behandeln Sie Artikel als "
"Verbrauchsmaterialien, um eine übersichtliche Preisgestaltung, "
"Kostenverfolgung und vereinfachte\n"
"                    Rückverfolgbarkeit zu gewährleisten."

#. module: garage_auto_repair
#: model_terms:appointment.type,message_intro:garage_auto_repair.appointment_type_1
msgid "<b>Dear Customer,</b>"
msgstr "<b>Sehr geehrter Kunde,</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Done:</b> After the client picks up their vehicle, drag the task here and "
"mark the\n"
"                <b>Vehicle Checked Out</b> box."
msgstr ""
"<b>Erledigt:</b> Nachdem der Kunde sein Fahrzeug abgeholt hat, ziehen Sie "
"die Aufgabe hierher und markieren Sie das Kästchen\n"
"               <b>Fahrzeug zurückgegeben</b>."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.homepage
msgid "<b>Emergency Repairs</b>"
msgstr "<b>Notfall-Reparaturen</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Existing Customer:</b> Select the correct customer profile and their "
"vehicle."
msgstr ""
"<b>Bestehender Kunde:</b> Wählen Sie das richtige Kundenprofil und dessen "
"Fahrzeug aus."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>Explore Free Apps</b>"
msgstr "<b>Kostenlose Apps erkunden</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Handling Emergencies &amp; Long Interventions: </b>Use the "
"<b>Intervention </b>appointment type (in demo data)\n"
"                for urgent repairs or multi-day jobs. Follow the standard "
"web form flow, which blocks out the initial day. If\n"
"                the repair takes longer, manually extend the appointment "
"duration on the calendar."
msgstr ""
"<b>Umgang mit Notfällen &amp; langen Arbeiten: </b>Verwenden Sie die "
"Terminart <b>Einsatz </b>(in den Demodaten)\n"
"                für dringende Reparaturen oder mehrtägige Arbeiten. Folgen "
"Sie dem standardmäßigen Webformular-Ablauf, der den ersten Tag blockiert. "
"Wenn\n"
"                die Reparatur länger dauert, verlängern Sie die Termindauer "
"manuell im Kalender."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Handling Phone Appointments: </b> If a customer calls and wants to book "
"directly:"
msgstr ""
"<b>Telefonische Termine bearbeiten: </b> Wenn ein Kunde anruft und direkt "
"buchen möchte:"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Initial Contact:</b> The customer submits a contact form on the website "
"with details and optional photo\n"
"                    attachments."
msgstr ""
"<b>Erstkontakt:</b> Der Kunde reicht ein Kontaktformular auf der Website mit "
"Details und optionalen Fotoanhängen\n"
"                    ein."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Link Sent:</b> Contains tasks where an appointment link has been sent to "
"the client."
msgstr ""
"<b>Link gesendet:</b> Enthält Aufgaben, bei denen ein Terminlink an den "
"Kunden gesendet wurde."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.ir_ui_view_3368
msgid ""
"<b>My Company</b><br/>8000 Marina Blvd, Suite 300 <br/> Brisbane CA 94005 "
"<br/>United States"
msgstr ""
"<b>Mein Unternehmen</b><br/>8000 Marina Blvd, Suite 300 <br/> Brisbane CA "
"94005 <br/>Vereinigte Staaten"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>New Customer:</b> Create the customer, add their vehicle, and link it to "
"the task."
msgstr ""
"<b>Neuer Kunde:</b> Erstellen Sie den Kunden, fügen Sie sein Fahrzeug hinzu "
"und verknüpfen Sie es mit der Aufgabe."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>New Requests:</b> Houses all incoming intervention requests that need "
"qualification."
msgstr ""
"<b>Neue Anfragen:</b> Enthält alle eingehenden Interventionsanfragen, die "
"qualifiziert werden müssen."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Resources:</b> Resources can be team members or physical equipment. In "
"our demo data, we use\n"
"                            available car lifts (<i>Car Lift 1</i> and "
"<i>Car Lift 2</i>) to set maximum concurrent capacity."
msgstr ""
"<b>Ressourcen:</b> Ressourcen können Teammitglieder oder physische Geräte "
"sein. In unseren Demodaten verwenden wir\n"
"                            verfügbare Hebebühnen (<i>Hebebühne 1</i> und <i>"
"Hebebühne 2</i>), um die maximale gleichzeitige Kapazität festzulegen."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Scheduling:</b> Once the request is qualified, select the appropriate "
"appointment type and move the task\n"
"                    to the next stage. Odoo will automatically email the "
"client a proposed time slot, which they can reschedule\n"
"                    if necessary."
msgstr ""
"<b>Terminplanung:</b> Sobald die Anfrage qualifiziert ist, wählen Sie die "
"passende Terminart aus und verschieben die Aufgabe\n"
"                    in die nächste Phase. Odoo sendet dem Kunden automatisch "
"einen Terminvorschlag per E-Mail, den dieser bei Bedarf\n"
"                    umplanen kann."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Status &amp; Usage:</b> Vehicle status (Active or Downgraded) &amp; "
"latest odometer reading"
msgstr ""
"<b>Status &amp; Nutzung:</b> Fahrzeugstatus (Aktiv oder Herabgestuft) &amp; "
"letzter Kilometerstand"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Task Creation:</b> This automatically creates a new task in the "
"<b>Intervention</b> project."
msgstr ""
"<b>Aufgabenerstellung:</b> Dadurch wird automatisch eine neue Aufgabe im "
"Projekt <b>Einsatz</b> erstellt."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Technical Info:</b> Tire specs, motor block references, and other "
"technical data"
msgstr ""
"<b>Technische Daten:</b> Reifenspezifikationen, Motorblockreferenzen und "
"sonstige technische Daten"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>The Sales app offers a variety of flexible features, including:</b>"
msgstr ""
"<b>Die Verkaufsapp bietet eine Vielzahl flexibler Funktionen, darunter:</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>To Be Taken:</b> Once repairs are complete, move the task here. An "
"automated email will notify the client\n"
"                that their vehicle is ready for pickup."
msgstr ""
"<b>Abholbereit:</b> Sobald die Reparaturen abgeschlossen sind, verschieben "
"Sie die Aufgabe hierher. Eine automatische E-Mail benachrichtigt den "
"Kunden,\n"
"                dass sein Fahrzeug abholbereit ist."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>To Do:</b> Holds all intervention tasks scheduled to be performed today."
msgstr ""
"<b>To-do:</b> Enthält alle Aaufgaben, deren Durchführung für heute geplant "
"ist."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Tracked Products:</b> Track exact stock quantities and inventory "
"movements."
msgstr ""
"<b>Verfolgte Produkte:</b> Verfolgen Sie genaue Lagerbestände und "
"Lagerbewegungen."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>Vehicle Specs:</b> Brand, model, model year, type, etc."
msgstr "<b>Fahrzeugdaten:</b> Marke, Modell, Baujahr, Typ usw."

#. module: garage_auto_repair
#: model:mail.template,body_html:garage_auto_repair.mail_template_task_appointment_booking
msgid ""
"<div>\n"
"        <p>Dear <t t-out=\"object.x_vehicle_id.x_owner_id.name or "
"'Customer'\"></t>,</p>\n"
"        <p>Your vehicle <strong><t t-"
"out=\"object.x_vehicle_id.license_plate\"></t></strong> is due for its "
"scheduled service.</p>\n"
"        <p>We’ve scheduled a <strong>proposed appointment</strong> for you "
"on <t t-out=\"object.x_appointment_date\" t-options=\"{&quot;widget&quot;: "
"&quot;datetime&quot;, &quot;tz_name&quot;: "
"object.x_appointment_type_id.appointment_tz, &quot;format&quot;: "
"&quot;medium&quot;}\"></t></p>\n"
"        <p>Please confirm this appointment by clicking the link below:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_accept_url }}\">Accept Suggested "
"Timeslot</a></p>\n"
"        <p>If this time doesn’t work for you, you can choose another date "
"and time that is more convenient:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_reschedule_url }}\">Reschedule Your "
"Timeslot</a></p>\n"
"        <p>Thank you for choosing us to keep your vehicle in top shape.</p>\n"
"        <p>Best regards,<br>The Service Team</p>\n"
"    </div>"
msgstr ""
"<div>\n"
"        <p>Guten Tag <t t-out=\"object.x_vehicle_id.x_owner_id.name or "
"'lieber Kunde bzw. liebe Kundin'\"></t>,</p>\n"
"        <p>für Ihr Fahrzeug <strong><t t-"
"out=\"object.x_vehicle_id.license_plate\"></t></strong> steht der planmäßige "
"Service an.</p>\n"
"        <p>Wir haben einen <strong>Terminvorschlag</strong> für Sie am <t t-"
"out=\"object.x_appointment_date\" t-options=\"{&quot;widget&quot;: "
"&quot;datetime&quot;, &quot;tz_name&quot;: "
"object.x_appointment_type_id.appointment_tz, &quot;format&quot;: "
"&quot;medium&quot;}\"></t> geplant.</p>\n"
"        <p>Bitte bestätigen Sie diesen Termin, indem Sie auf den unten "
"stehenden Link klicken:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_accept_url }}\">Vorgeschlagenes "
"Zeitfenster annehmen</a></p>\n"
"        <p>Falls Ihnen dieser Termin nicht passt, können Sie ein anderes "
"Datum und eine andere Uhrzeit wählen, die Ihnen besser passen:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_reschedule_url }}\">Zeitfenster "
"verschieben</a></p>\n"
"        <p>Vielen Dank, dass Sie uns Ihr Fahrzeugs anvertrauen.</p>\n"
"        <p>Mit freundlichen Grüßen<br>Das Service-Team</p>\n"
"    </div>"

