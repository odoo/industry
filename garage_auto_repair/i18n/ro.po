#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Automatic Identification:</b> Plate and chassis numbers automatically "
"placed on every quotation, sales\n"
"                    order, and invoice"
msgstr ""
"<b>Identificare automată:</b> Numerele de înmatriculare și de șasiu sunt "
"adăugate automat pe fiecare ofertă,\n"
"                    comandă de vânzare și factură"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Booking Lead Time (Options Tab):</b> Sets the minimum notice period "
"before a proposed booking\n"
"                            date."
msgstr ""
"<b>Timp minim înainte de programare (fila Opțiuni):</b> Stabilește perioada "
"minimă de notificare înainte de data\n"
"                            propusă pentru programare."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Clarification:</b> If you need additional details, use the <b>Chatter</b> "
"to message the client directly."
msgstr ""
"<b>Clarificare:</b> Dacă ai nevoie de detalii suplimentare, folosește <b>"
"Chatter</b> pentru a-i trimite direct un mesaj clientului."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Consumables:</b> Treat items as consumables for straightforward pricing, "
"cost tracking, and simplified\n"
"                    traceability."
msgstr ""
"<b>Consumabile:</b> Consideră articolele drept consumabile pentru a "
"simplifica stabilirea prețurilor, urmărirea costurilor și\n"
"                    trasabilitatea."

#. module: garage_auto_repair
#: model_terms:appointment.type,message_intro:garage_auto_repair.appointment_type_1
msgid "<b>Dear Customer,</b>"
msgstr "<b>Stimate client,</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Done:</b> After the client picks up their vehicle, drag the task here and "
"mark the\n"
"                <b>Vehicle Checked Out</b> box."
msgstr ""
"<b>Finalizat:</b> După ce clientul își ridică vehiculul, mută sarcina aici "
"și bifează\n"
"                <b>Vehicul predat</b> box."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.homepage
msgid "<b>Emergency Repairs</b>"
msgstr "<b>Reparații de urgență</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Existing Customer:</b> Select the correct customer profile and their "
"vehicle."
msgstr ""
"<b>Client existent:</b> Selectează fișa clientului și vehiculul acestuia."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>Explore Free Apps</b>"
msgstr "<b>Descoperă aplicațiile gratuite</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Handling Emergencies &amp; Long Interventions: </b>Use the "
"<b>Intervention </b>appointment type (in demo data)\n"
"                for urgent repairs or multi-day jobs. Follow the standard "
"web form flow, which blocks out the initial day. If\n"
"                the repair takes longer, manually extend the appointment "
"duration on the calendar."
msgstr ""
"<b>Gestionarea urgențelor și a intervențiilor de durată: </b>Folosește <b>"
"Intervention </b>tipul de programare (din datele demonstrative)\n"
"                pentru reparații urgente sau lucrări de mai multe zile. "
"Urmează fluxul obișnuit al formularului web, care blochează prima zi. Dacă\n"
"                reparația durează mai mult, prelungește manual programarea "
"în calendar."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Handling Phone Appointments: </b> If a customer calls and wants to book "
"directly:"
msgstr ""
"<b>Gestionarea programărilor telefonice: </b> Dacă un client sună și dorește "
"să facă o programare direct:"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Initial Contact:</b> The customer submits a contact form on the website "
"with details and optional photo\n"
"                    attachments."
msgstr ""
"<b>Contact inițial:</b> Clientul trimite pe site un formular de contact cu "
"detalii și, opțional,\n"
"                    fotografii atașate."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Link Sent:</b> Contains tasks where an appointment link has been sent to "
"the client."
msgstr ""
"<b>Link trimis:</b> Conține sarcinile pentru care a fost trimis clientului "
"un link de programare."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.ir_ui_view_3368
msgid ""
"<b>My Company</b><br/>8000 Marina Blvd, Suite 300 <br/> Brisbane CA 94005 "
"<br/>United States"
msgstr ""
"<b>Compania Mea</b><br/>8000 Marina Blvd, Suite 300 <br/> Brisbane CA 94005 "
"<br/>Statele Unite"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>New Customer:</b> Create the customer, add their vehicle, and link it to "
"the task."
msgstr ""
"<b>Client nou:</b> Creează clientul, adaugă vehiculul acestuia și asociază-l "
"sarcinii."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>New Requests:</b> Houses all incoming intervention requests that need "
"qualification."
msgstr ""
"<b>Solicitări noi:</b> Conține toate solicitările de intervenție primite "
"care trebuie evaluate."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Resources:</b> Resources can be team members or physical equipment. In "
"our demo data, we use\n"
"                            available car lifts (<i>Car Lift 1</i> and "
"<i>Car Lift 2</i>) to set maximum concurrent capacity."
msgstr ""
"<b>Resurse:</b> Resursele pot fi membri ai echipei sau echipamente fizice. "
"În datele demonstrative, folosim\n"
"                            elevatoarele auto disponibile (<i>Car Lift 1</i> "
"and <i>Car Lift 2</i>) pentru a stabili capacitatea maximă simultană."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Scheduling:</b> Once the request is qualified, select the appropriate "
"appointment type and move the task\n"
"                    to the next stage. Odoo will automatically email the "
"client a proposed time slot, which they can reschedule\n"
"                    if necessary."
msgstr ""
"<b>Programare:</b> După evaluarea solicitării, selectează tipul de "
"programare potrivit și mută sarcina\n"
"                    în etapa următoare. Odoo va trimite automat clientului "
"prin e-mail un interval orar propus, pe care îl poate reprograma\n"
"                    dacă este necesar."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Status &amp; Usage:</b> Vehicle status (Active or Downgraded) &amp; "
"latest odometer reading"
msgstr ""
"<b>Stare și utilizare:</b> Starea vehiculului (activ sau retras din uz) și "
"ultima valoare a odometrului"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Task Creation:</b> This automatically creates a new task in the "
"<b>Intervention</b> project."
msgstr ""
"<b>Crearea sarcinii:</b> Aceasta creează automat o sarcină nouă în proiectul "
"<b>Intervenție</b> project."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Technical Info:</b> Tire specs, motor block references, and other "
"technical data"
msgstr ""
"<b>Informații tehnice:</b> Specificații despre anvelope, identificatorul "
"motorului și alte date tehnice"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>The Sales app offers a variety of flexible features, including:</b>"
msgstr ""
"<b>Aplicația Vânzări oferă o varietate de funcții flexibile, inclusiv:</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>To Be Taken:</b> Once repairs are complete, move the task here. An "
"automated email will notify the client\n"
"                that their vehicle is ready for pickup."
msgstr ""
"<b>De preluat:</b> După terminarea reparațiilor, mută sarcina aici. Un e-"
"mail automat va anunța clientul\n"
"                că vehiculul este gata de ridicare."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>To Do:</b> Holds all intervention tasks scheduled to be performed today."
msgstr ""
"<b>De făcut:</b> Conține toate sarcinile de intervenție programate pentru "
"astăzi."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Tracked Products:</b> Track exact stock quantities and inventory "
"movements."
msgstr ""
"<b>Produse urmărite:</b> Urmărește cantitățile exacte din stoc și mișcările "
"de inventar."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>Vehicle Specs:</b> Brand, model, model year, type, etc."
msgstr "<b>Specificații vehicul:</b> Marcă, model, an de fabricație, tip etc."

#. module: garage_auto_repair
#: model:mail.template,body_html:garage_auto_repair.mail_template_task_appointment_booking
msgid ""
"<div>\n"
"        <p>Dear <t t-out=\"object.x_vehicle_id.x_owner_id.name or "
"'Customer'\"></t>,</p>\n"
"        <p>Your vehicle <strong><t t-"
"out=\"object.x_vehicle_id.license_plate\"></t></strong> is due for its "
"scheduled service.</p>\n"
"        <p>We’ve scheduled a <strong>proposed appointment</strong> for you "
"on <t t-out=\"object.x_appointment_date\" t-options=\"{&quot;widget&quot;: "
"&quot;datetime&quot;, &quot;tz_name&quot;: "
"object.x_appointment_type_id.appointment_tz, &quot;format&quot;: "
"&quot;medium&quot;}\"></t></p>\n"
"        <p>Please confirm this appointment by clicking the link below:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_accept_url }}\">Accept Suggested "
"Timeslot</a></p>\n"
"        <p>If this time doesn’t work for you, you can choose another date "
"and time that is more convenient:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_reschedule_url }}\">Reschedule Your "
"Timeslot</a></p>\n"
"        <p>Thank you for choosing us to keep your vehicle in top shape.</p>\n"
"        <p>Best regards,<br>The Service Team</p>\n"
"    </div>"
msgstr ""
"<div>\n"
"        <p>Stimate <t t-out=\"object.x_vehicle_id.x_owner_id.name or "
"'Customer'\"></t>,</p>\n"
"        <p>Vehiculul tău <strong><t t-"
"out=\"object.x_vehicle_id.license_plate\"></t></strong> trebuie să efectueze "
"revizia programată.</p>\n"
"        <p>Am programat o <strong>programare propusă</strong> pentru <t t-"
"out=\"object.x_appointment_date\" t-options=\"{&quot;widget&quot;: "
"&quot;datetime&quot;, &quot;tz_name&quot;: "
"object.x_appointment_type_id.appointment_tz, &quot;format&quot;: "
"&quot;medium&quot;}\"></t></p>\n"
"        <p>Confirmă această programare apăsând linkul de mai jos:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_accept_url }}\">Acceptă intervalul "
"orar propus</a></p>\n"
"        <p>Dacă acest interval nu ți se potrivește, poți alege o altă dată "
"și oră mai convenabile:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_reschedule_url }}\">Reprogramează "
"intervalul orar</a></p>\n"
"        <p>Îți mulțumim că ne-ai ales pentru a-ți menține vehiculul în stare "
"excelentă.</p>\n"
"        <p>Cu stimă,<br>Echipa de service</p>\n"
"    </div>"

