"appointment\">ນັດໝາຍຮັບບໍລິການຂອງທ່ານ</a>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Automatic Identification:</b> Plate and chassis numbers automatically "
"placed on every quotation, sales\n"
"                    order, and invoice"
msgstr ""
"<b>ການລະບຸຕົວຕົນອັດຕະໂນມັດ:</b> ເລກທະບຽນ ແລະ ເລກກົງຊີຈະຖືກໃສ່ໃນທຸກໆ ໃບສະເໜີລາຄາ, ໃບສັ່ງຂາ"
"ຍ,\n"
"                    ແລະ ໃບແຈ້ງໜີ້ໂດຍອັດຕະໂນມັດ"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Booking Lead Time (Options Tab):</b> Sets the minimum notice period "
"before a proposed booking\n"
"                            date."
msgstr ""
"<b>ໄລຍະເວລາຈອງລ່ວງໜ້າ (ແຖບຕົວເລືອກ):</b> ກຳນົດໄລຍະເວລາແຈ້ງລ່ວງໜ້າຂັ້ນຕ່ຳ ກ່ອນຮອດວັນທີນັດໝາ"
"ຍ\n"
"                            ທີ່ສະເໜີ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Clarification:</b> If you need additional details, use the <b>Chatter</b> "
"to message the client directly."
msgstr ""
"<b>ຄວາມຊັດເຈນ:</b> ຖ້າທ່ານຕ້ອງການລາຍລະອຽດເພີ່ມເຕີມ, ໃຫ້ໃຊ້ <b>Chatter</b> ເພື່ອສົ່ງຂໍ້ຄວາມຫາ"
"ລູກຄ້າໂດຍກົງ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Consumables:</b> Treat items as consumables for straightforward pricing, "
"cost tracking, and simplified\n"
"                    traceability."
msgstr ""
"<b>ວັດສະດຸສິ້ນເປືອງ:</b> ຈັດການລາຍການເປັນວັດສະດຸສິ້ນເປືອງ ເພື່ອຄວາມສະດວກໃນການຕັ້ງລາຄາ, ການຕິດຕ"
"າມຕົ້ນທຶນ ແລະ ການຕິດຕາມກວດສອບທີ່\n"
"                    ງ່າຍດາຍ."

#. module: garage_auto_repair
#: model_terms:appointment.type,message_intro:garage_auto_repair.appointment_type_1
msgid "<b>Dear Customer,</b>"
msgstr "<b>ຮຽນ ລູກຄ້າທີ່ນັບຖື,</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Done:</b> After the client picks up their vehicle, drag the task here and "
"mark the\n"
"                <b>Vehicle Checked Out</b> box."
msgstr ""
"<b>ສຳເລັດ:</b> ຫຼັງຈາກລູກຄ້າມາຮັບລົດແລ້ວ, ໃຫ້ລາກໜ້າວຽກມານີ້ ແລະ ໝາຍໃສ່ຫ້ອງ\n"
"                <b>ນຳລົດອອກແລ້ວ</b>."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.homepage
msgid "<b>Emergency Repairs</b>"
msgstr "<b>ການສ້ອມແປງສຸກເສີນ</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Existing Customer:</b> Select the correct customer profile and their "
"vehicle."
msgstr "<b>ລູກຄ້າເກົ່າ:</b> ເລືອກຂໍ້ມູນລູກຄ້າ ແລະ ລົດຂອງພວກເຂົາໃຫ້ຖືກຕ້ອງ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>Explore Free Apps</b>"
msgstr "<b>ສຳຫຼວດແອັບຟຣີ</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Handling Emergencies &amp; Long Interventions: </b>Use the "
"<b>Intervention </b>appointment type (in demo data)\n"
"                for urgent repairs or multi-day jobs. Follow the standard "
"web form flow, which blocks out the initial day. If\n"
"                the repair takes longer, manually extend the appointment "
"duration on the calendar."
msgstr ""
"<b>ການຈັດການກໍລະນີສຸກເສີນ &amp; ການສ້ອມແປງໄລຍະຍາວ: </b>ໃຊ້ປະເພດການນັດໝາຍ <b>ການສ້ອມແປ"
"ງ </b>(ໃນຂໍ້ມູນຕົວຢ່າງ)\n"
"                ສຳລັບການສ້ອມແປງດ່ວນ ຫຼື ວຽກທີ່ໃຊ້ເວລາຫຼາຍມື້. ດຳເນີນຕາມແບບຟອມເວັບມາດຕະຖານ "
"ເຊິ່ງຈະຈອງວັນທຳອິດໄວ້. ຖ້າ\n"
"                ການສ້ອມແປງໃຊ້ເວລາດົນກວ່ານັ້ນ, ໃຫ້ຂະຫຍາຍໄລຍະເວລານັດໝາຍໃນປະຕິທິນດ້ວຍຕົນເອງ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Handling Phone Appointments: </b> If a customer calls and wants to book "
"directly:"
msgstr ""
"<b>ການຈັດການການນັດໝາຍທາງໂທລະສັບ: </b> ຖ້າລູກຄ້າໂທມາ ແລະ ຕ້ອງການຈອງໂດຍກົງ:"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Initial Contact:</b> The customer submits a contact form on the website "
"with details and optional photo\n"
"                    attachments."
msgstr ""
"<b>ການຕິດຕໍ່ເບື້ອງຕົ້ນ:</b> ລູກຄ້າສົ່ງແບບຟອມຕິດຕໍ່ຜ່ານເວັບໄຊ ພ້ອມລາຍລະອຽດ ແລະ ຮູບພາບຕິດຄັດ\n"
"                    (ຖ້າມີ)."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Link Sent:</b> Contains tasks where an appointment link has been sent to "
"the client."
msgstr "<b>ສົ່ງລິ້ງແລ້ວ:</b> ລວມໜ້າວຽກທີ່ໄດ້ສົ່ງລິ້ງນັດໝາຍໃຫ້ລູກຄ້າແລ້ວ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.ir_ui_view_3368
msgid ""
"<b>My Company</b><br/>8000 Marina Blvd, Suite 300 <br/> Brisbane CA 94005 "
"<br/>United States"
msgstr ""
"<b>ບໍລິສັດຂອງຂ້ອຍ</b><br/>8000 Marina Blvd, Suite 300 <br/> Brisbane CA 94005 "
"<br/>United States"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>New Customer:</b> Create the customer, add their vehicle, and link it to "
"the task."
msgstr ""
"<b>ລູກຄ້າໃໝ່:</b> ສ້າງຂໍ້ມູນລູກຄ້າ, ເພີ່ມລົດຂອງພວກເຂົາ, ແລະ ເຊື່ອມໂຍງໃສ່ໜ້າວຽກ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>New Requests:</b> Houses all incoming intervention requests that need "
"qualification."
msgstr ""
"<b>ຄຳຮ້ອງຂໍໃໝ່:</b> ລວມທຸກຄຳຮ້ອງຂໍສ້ອມແປງທີ່ເຂົ້າມາ ເຊິ່ງຕ້ອງການການກວດສອບ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Resources:</b> Resources can be team members or physical equipment. In "
"our demo data, we use\n"
"                            available car lifts (<i>Car Lift 1</i> and "
"<i>Car Lift 2</i>) to set maximum concurrent capacity."
msgstr ""
"<b>ຊັບພະຍາກອນ:</b> ຊັບພະຍາກອນສາມາດເປັນສະມາຊິກໃນທີມ ຫຼື ອຸປະກອນຕົວຈິງ. ໃນຂໍ້ມູນຕົວຢ່າງຂອງພວກເ"
"ຮົາ, ພວກເຮົາໃຊ້\n"
"                            ຮາວົກຍົກລົດທີ່ມີ (<i>ຮາວົກຍົກລົດ 1</i> ແລະ <i>ຮາວົກຍົກລົດ 2</"
"i>) ເພື່ອກຳນົດຄວາມສາມາດຮອງຮັບສູງສຸດພ້ອມກັນ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Scheduling:</b> Once the request is qualified, select the appropriate "
"appointment type and move the task\n"
"                    to the next stage. Odoo will automatically email the "
"client a proposed time slot, which they can reschedule\n"
"                    if necessary."
msgstr ""
"<b>ການກຳນົດເວລາ:</b> ເມື່ອກວດສອບຄຳຮ້ອງຂໍແລ້ວ, ໃຫ້ເລືອກປະເພດການນັດໝາຍທີ່ເໝາະສົມ ແລະ ຍ້າຍໜ້າວ"
"ຽກ\n"
"                    ໄປຂັ້ນຕອນຕໍ່ໄປ. Odoo ຈະສົ່ງອີເມວຫາລູກຄ້າອັດຕະໂນມັດພ້ອມຊ່ວງເວລາທີ່ສະເໜີ, ເ"
"ຊິ່ງລູກຄ້າສາມາດເລື່ອນເວລາໃໝ່ໄດ້\n"
"                    ຖ້າຈຳເປັນ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Status &amp; Usage:</b> Vehicle status (Active or Downgraded) &amp; "
"latest odometer reading"
msgstr ""
"<b>ສະຖານະ &amp; ການນຳໃຊ້:</b> ສະຖານະຂອງລົດ (ເປີດໃຊ້ງານ ຫຼື ຫຼຸດລະດັບ) &amp; ຄ່າໄລຍະທາງກິ"
"ໂລແມັດຫຼ້າສຸດ"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Task Creation:</b> This automatically creates a new task in the "
"<b>Intervention</b> project."
msgstr ""
"<b>ການສ້າງໜ້າວຽກ:</b> ສິ່ງນີ້ຈະສ້າງໜ້າວຽກໃໝ່ໂດຍອັດຕະໂນມັດໃນໂຄງການ <b>ການສ້ອມແປງ</b>."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Technical Info:</b> Tire specs, motor block references, and other "
"technical data"
msgstr ""
"<b>ຂໍ້ມູນດ້ານເຕັກນິກ:</b> ຂໍ້ມູນສະເພາະຂອງຢາງລົດ, ເລກອ້າງອີງເຄື່ອງຈັກ, ແລະ ຂໍ້ມູນເຕັກນິກອື່ນໆ"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>The Sales app offers a variety of flexible features, including:</b>"
msgstr "<b>ແອັບການຂາຍມີຄຸນສົມບັດຫຼາກຫຼາຍທີ່ປັບປ່ຽນໄດ້, ລວມທັງ:</b>"

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>To Be Taken:</b> Once repairs are complete, move the task here. An "
"automated email will notify the client\n"
"                that their vehicle is ready for pickup."
msgstr ""
"<b>ລໍຖ້າຮັບເອົາ:</b> ເມື່ອສ້ອມແປງແລ້ວ, ໃຫ້ຍ້າຍໜ້າວຽກມານີ້. ອີເມວອັດຕະໂນມັດຈະແຈ້ງເຕືອນລູກຄ້າ\n"
"                ວ່າລົດຂອງພວກເຂົາພ້ອມທີ່ຈະມາຮັບແລ້ວ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>To Do:</b> Holds all intervention tasks scheduled to be performed today."
msgstr "<b>ສິ່ງທີ່ຕ້ອງເຮັດ:</b> ລວມທຸກໜ້າວຽກສ້ອມແປງທີ່ມີກຳນົດເຮັດໃນມື້ນີ້."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid ""
"<b>Tracked Products:</b> Track exact stock quantities and inventory "
"movements."
msgstr "<b>ສິນຄ້າທີ່ຕິດຕາມ:</b> ຕິດຕາມຈຳນວນສະຕັອກທີ່ແນ່ນອນ ແລະ ການເຄື່ອນໄຫວສາງ."

#. module: garage_auto_repair
#: model_terms:ir.ui.view,arch_db:garage_auto_repair.welcome_article_body
msgid "<b>Vehicle Specs:</b> Brand, model, model year, type, etc."
