#. module: garage_auto_repair
#: model:mail.template,body_html:garage_auto_repair.mail_template_task_appointment_booking
msgid ""
"<div>\n"
"        <p>Dear <t t-out=\"object.x_vehicle_id.x_owner_id.name or "
"'Customer'\"/>,</p>\n"
"        <p>Your vehicle <strong><t t-"
"out=\"object.x_vehicle_id.license_plate\"/></strong> is due for its "
"scheduled service.</p>\n"
"        <p>We’ve scheduled a <strong>proposed appointment</strong> for you "
"on <t t-out=\"object.x_appointment_date\" t-options=\"{&quot;widget&quot;: "
"&quot;datetime&quot;, &quot;tz_name&quot;: "
"object.x_appointment_type_id.appointment_tz, &quot;format&quot;: "
"&quot;medium&quot;}\"/></p>\n"
"        <p>Please confirm this appointment by clicking the link below:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_accept_url }}\">Accept Suggested "
"Timeslot</a></p>\n"
"        <p>If this time doesn’t work for you, you can choose another date "
"and time that is more convenient:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_reschedule_url }}\">Reschedule Your "
"Timeslot</a></p>\n"
"        <p>Thank you for choosing us to keep your vehicle in top shape.</p>\n"
"        <p>Best regards,<br/>The Service Team</p>\n"
"    </div>"
msgstr ""
"<div>\n"
"        <p>ຮຽນ <t t-out=\"object.x_vehicle_id.x_owner_id.name or "
"'Customer'\"/>,</p>\n"
"        <p>ລົດຂອງທ່ານ <strong><t t-out=\"object.x_vehicle_id.license_plate\"/>"
"</strong> ຮອດກຳນົດເວລາກວດເຊັກຕາມກຳນົດແລ້ວ.</p>\n"
"        <p>ພວກເຮົາໄດ້ກຳນົດ <strong>ເວລານັດໝາຍທີ່ສະເໜີ</strong> ໃຫ້ທ່ານໃນວັນທີ <t t-"
"out=\"object.x_appointment_date\" t-options=\"{&quot;widget&quot;: "
"&quot;datetime&quot;, &quot;tz_name&quot;: "
"object.x_appointment_type_id.appointment_tz, &quot;format&quot;: "
"&quot;medium&quot;}\"/></p>\n"
"        <p>ກະລຸນາຢືນຢັນການນັດໝາຍນີ້ ໂດຍການກົດລິ້ງຂ້າງລຸ່ມ:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_accept_url }}\">ຍອມຮັບຊ່ວງເວລາທີ່ສະເໜີ</a>"
"</p>\n"
"        <p>ຖ້າເວລານີ້ບໍ່ສະດວກສຳລັບທ່ານ, ທ່ານສາມາດເລືອກວັນທີ ແລະ ເວລາອື່ນທີ່ສະດວກກວ່າໄດ້:</p>\n"
"        <p><a t-attf-href=\"{{ object.x_reschedule_url }}\">ປ່ຽນເວລານັດໝາຍຂອງທ່າ"
"ນໃໝ່</a></p>\n"
"        <p>ຂອບໃຈທີ່ເລືອກພວກເຮົາໃຫ້ດູແລລົດຂອງທ່ານໃຫ້ຢູ່ໃນສະພາບດີເລີດ.</p>\n"
"        <p>ດ້ວຍຄວາມນັບຖື,<br/>ທີມງານບໍລິການ</p>\n"
"    </div>"

