<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">Copyright © <t t-out="company.name"/></span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="option_footer_scrolltop" model="ir.ui.view">
        <field name="name">Custom - option_footer_scrolltop</field>
        <field name="key">website.option_footer_scrolltop</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="after">
                <div id="o_footer_scrolltop_wrapper" class="container h-0 d-flex align-items-center justify-content-end">
                    <a id="o_footer_scrolltop" role="button" href="#top" title="Scroll To Top" class="d-flex align-items-center justify-content-center btn btn-custom bg-o-color-2 text-o-color-5" style="border: 0px solid rgba(255, 255, 255, 0.5);"><span class="oi" data-icon="keyboard_arrow_up"/></a>
                </div>
            </xpath>
        </field>
    </record>
    <record id="template_footer_centered" model="ir.ui.view">
        <field name="name">Custom - Centered</field>
        <field name="key">website.template_footer_centered</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt32" data-snippet="s_text_block" data-name="Container">
                        <div class="s_allow_columns container">
                            <div class="row">
                                <div class="col-lg-12 order-lg-0 o_colored_level" style="order: 0;">
                                    <div class="s_social_media text-center o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="#" class="s_social_media_facebook" target="_blank" aria-label="Facebook"><i class="oi o_editable_media rounded-empty-circle shadow-sm text-o-color-2" data-icon="oi_facebook"/></a>
                                        <a href="#" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn"><i class="oi o_editable_media text-o-color-2 rounded-empty-circle shadow-sm" data-icon="oi_linkedin"/></a>
                                    </div>
                                    <div class="s_hr pt24 pb24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="order-lg-0 o_colored_level col-lg-2" style="order: 2;">
                                    <h6 style="text-align: start;">Navigation</h6>
                                    <ul class="list-unstyled" style="text-align: start;">
                                        <li>
                                            <a href="/" class="o_translate_inline"><strong>Home</strong></a>
                                        </li>
                                        <li>
                                            <a href="/our-services" class="o_translate_inline"><strong>Services</strong></a>
                                        </li>
                                        <li>
                                            <a href="/about-us" class="o_translate_inline"><strong>About Us</strong></a>
                                        </li>
                                        <li>
                                            <a href="/contactus" class="o_translate_inline"><strong>Contact Us</strong></a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="order-lg-0 pb24 o_colored_level offset-lg-1 col-lg-6" style="order: 1; text-align: center;">
                                    <img src="/web/image/surveyor.img_surveyor_image_35" alt="Logo of Altitude" class="img-fluid d-block mx-auto img o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" style="width: 41% !important;" loading="lazy"/>
                                    <span class="text-o-color-2"><span class="o_animated_text o_animate o_anim_fade_in">Your Surveying &amp; Mapping Partner</span></span>
                                </div>
                                <div class="order-lg-0 o_colored_level col-lg-3" style="order: 3;">
                                    <h6>Get In Touch</h6>
                                    <ul class="list-unstyled">
                                        <li style="text-align: start;">
                                            <img src="/web/image/surveyor.img_surveyor_image_33" alt="" class="img img-fluid o_we_custom_image" loading="lazy" style="padding-bottom: 10px; padding-right: 10px; padding-top: 10px;"/>
                                            <a href="tel:+15555555556"><span class="text-o-color-4"> <span class="o_force_ltr">+1 555-555-5556</span> </span></a>
                                        </li>
                                        <li style="text-align: start;">
                                            <img src="/web/image/surveyor.img_surveyor_image_34" alt="" class="img img-fluid o_we_custom_image" loading="lazy" style="padding-bottom: 10px; padding-right: 10px; padding-top: 10px;"/>
                                            <a href="mailto:info@altitude.example.com"><span class="text-o-color-4">info@altitude.example.com</span></a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
