#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.about-us
#: model_terms:ir.ui.view,arch_db:surveyor.homepage
msgid "<b>ABOUT US</b>"
msgstr "<b>SOBRE NÓS</b>"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Accounting Integration:</b> Automatically reconcile incoming bank "
"payments with open survey project invoices."
msgstr ""
"<b>Integração Financeira:</b> Concilie automaticamente pagamentos bancários "
"recebidos com faturas de projetos de levantamento em aberto."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Automated Payment Follow-ups:</b> Set automated email reminders and SMS "
"notifications for unpaid invoices."
msgstr ""
"<b>Acompanhamentos de Pagamento Automatizados:</b> Defina lembretes de e-"
"mail e notificações SMS automatizados para faturas não pagas."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Automated Task Generation:</b> Setting up service lines (e.g., "
"<i>Topographic Fieldwork</i>,\n"
"                <i>CAD Drafting &amp; Feature Extraction</i>) automatically "
"generates dedicated project tasks upon Sales Order\n"
"                confirmation."
msgstr ""
"<b>Geração Automatizada de Tarefas:</b> Configurar linhas de serviço (por "
"exemplo, <i>Trabalho de Campo Topográfico</i>,\n"
"                <i>Desenho em CAD &amp; Extração de Recursos</i>) gera "
"automaticamente tarefas de projeto dedicadas mediante a confirmação do "
"Pedido de venda."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Avoid Field Bottlenecks</b> Always assign both the <b>Lead Surveyor</b> "
"and the required\n"
"                    <b>Equipment Unit</b> to the same Planning shift to "
"ensure field teams arrive on-site fully equipped."
msgstr ""
"<b>Evite Gargalos de Campo</b> Sempre atribua tanto o <b>Agrimensor Líder</"
"b> quanto a <b>Unidade de Equipamento</b> necessária ao mesmo turno de "
"Planejamento para garantir que as equipes de campo cheguem ao local "
"totalmente equipadas."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>CRM App</b>: Manage client inquiries from web forms or phone calls, track "
"ongoing bidding opportunities, and\n"
"                maintain client history in a visual pipeline."
msgstr ""
"<b>Aplicativo de CRM</b>: Gerencie consultas de clientes via formulários da "
"web ou chamadas telefônicas, rastreie oportunidades de licitação em "
"andamento e mantenha o histórico do cliente em um pipeline visual."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Combined Invoicing:</b> Consolidate billable timesheet hours, mileage/"
"expenses, and delivered physical goods\n"
"                (e.g., <i>Printed Maps</i>) onto a single clear statement."
msgstr ""
"<b>Faturamento Combinado:</b> Consolide horas faturáveis de planilha de "
"horas, quilometragem/despesas e bens físicos entregues (por exemplo, <i>"
"Mapas Impressos</i>) em um único extrato claro."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Communication Logs:</b> Send emails, schedule site visits, and log call "
"notes directly within the pipeline\n"
"                card."
msgstr ""
"<b>Registros de Comunicação:</b> Envie e-mails, agende visitas ao local e "
"registre notas de chamadas diretamente no cartão do pipeline."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Crew &amp; Skill Management:</b> Assign shifts based on certifications "
"(e.g., Licensed Professional Land\n"
"                Surveyor, FAA Part 107 Drone Operator, Bathymetric "
"Specialist)."
msgstr ""
"<b>Crew &amp; Gestão de Competências:</b> Atribua turnos com base em "
"certificações (por exemplo, Agrimensor Profissional Licenciado, Operador de "
"Drone FAA Parte 107, Especialista em Batimetria)."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Custom Field Worksheets:</b> Create tailored digital worksheets for each "
"intervention (e.g.,\n"
"                <i>Site Safety Assessment</i>, <i>Control Point Log</i>, "
"<i>Instrument Calibration Checklist</i>)."
msgstr ""
"<b>Planilhas de Campo Personalizadas:</b> Crie planilhas digitais sob medida "
"para cada intervenção (por exemplo, <i>Avaliação de Segurança do Local</i>, "
"<i>Registro de Ponto de Controle</i>, <i>Lista de Verificação de Calibração "
"de Instrumentos</i>)."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Demo Data Notice</b> If you want to safely explore every feature of this "
"package, download the Demo Data.\n"
"                    You can do this by upgrading your package in <b>Apps</"
"b>. Demo data cannot be easily deleted once loaded;\n"
"                    reset with a fresh database on"
msgstr ""
"<b>Aviso de Dados de Demonstração</b> Se você deseja explorar com segurança "
"todos os recursos deste pacote, baixe os Dados de Demonstração. Você pode "
"fazer isso atualizando seu pacote em <b>Aplicativos</b>. Os dados de "
"demonstração não podem ser facilmente excluídos depois de carregados; "
"redefina com um novo banco de dados em"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Direct Work Order Updates:</b> Field personnel mark interventions as "
"<i>In Progress</i> or <i>Completed</i>,\n"
"                immediately notifying the office CAD team."
msgstr ""
"<b>Atualizações Diretas de Ordens de Serviço:</b> O pessoal de campo marca "
"as intervenções como <i>Em Progresso</i> ou <i>Concluído</i>, notificando "
"imediatamente a equipe de CAD do escritório."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Equipment Tracking:</b> Schedule high-value equipment assets (e.g., Leica "
"Total Stations, Trimble RTK Units,\n"
"                LiDAR Drones) alongside field crews to prevent resource "
"overlap."
msgstr ""
"<b>Rastreamento de Equipamentos:</b> Agende ativos de equipamentos de alto "
"valor (por exemplo, Estações Totais Leica, Unidades RTK Trimble, Drones "
"LiDAR) junto com as equipes de campo para evitar a sobreposição de recursos."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Expense Logging:</b> Capture site-related expenses (e.g., toll fees, "
"monumentation materials, satellite\n"
"                imagery purchase) directly against the project card."
msgstr ""
"<b>Registro de Despesas:</b> Capture despesas relacionadas ao local (por "
"exemplo, taxas de pedágio, materiais de monumentação, compra de imagens de "
"satélite) diretamente no cartão do projeto."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Field Service &amp; Project App</b>: Dispatch field technicians, execute "
"custom digital worksheets, and\n"
"                capture site sign-offs directly from tablet or mobile."
msgstr ""
"<b>Serviço de Campo &amp; Aplicativo de Projetos</b>: Despache técnicos de "
"campo, execute planilhas digitais personalizadas e capture aprovações de "
"local diretamente do tablet ou celular."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Gantt View Scheduling:</b> Reorganize schedules via drag-and-drop based "
"on changing weather conditions or\n"
"                site access delays."
msgstr ""
"<b>Agendamento de Visualização de Gantt:</b> Reorganize cronogramas via "
"arrastar e soltar com base nas mudanças nas condições climáticas ou atrasos "
"no acesso ao local."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Goods &amp; Physical Deliverables:</b> Add non-service items such as "
"<i>Physical Boundary Stakes</i>,\n"
"                <i>Hardcopy Plats</i>, or <i>3D Printed Topo Models</i> "
"directly as deliverable products on the same quotation."
msgstr ""
"<b>Goods &amp; Entregáveis Físicos:</b> Adicione itens que não são de "
"serviço, como <i>Marcos de Limite Físicos</i>,\n"
"                <i>Plantas Impressas</i>, ou <i>Modelos Topográficos "
"Impressos em 3D</i> diretamente como produtos entregáveis na mesma cotação."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Invoicing App</b>: Bill milestone deposits, billable time, travel "
"expenses, and tangible goods (e.g., printed\n"
"                blueprints, USB survey data drives)."
msgstr ""
"<b>Aplicativo de Faturamento</b>: Fature depósitos de marcos, horas "
"faturáveis, despesas de viagem e bens tangíveis (por exemplo, plantas "
"impressas, unidades USB de dados de levantamento)."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Lead Qualification:</b> Capture crucial site metadata early (e.g., parcel "
"numbers, site access conditions,\n"
"                required accuracy standards)."
msgstr ""
"<b>Qualificação de Leads:</b> Capture metadados cruciais do local "
"antecipadamente (por exemplo, números de parcela, condições de acesso ao "
"local, padrões de precisão necessários)."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Leverage incoming leads from your website</b> Configure your website's\n"
"                    <b>\"Request a Survey Quote\"</b> form to automatically "
"feed incoming inquiries into the CRM pipeline and\n"
"                    auto-assign them based on region or survey type."
msgstr ""
"<b>Aproveite os leads recebidos do seu site</b> Configure o formulário <b>"
"\"Solicitar um Orçamento de Levantamento\"</b> do seu site para alimentar "
"automaticamente as consultas recebidas no pipeline de CRM e atribuí-las "
"automaticamente com base na região ou tipo de levantamento."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Milestone Billing Setup:</b> Define upfront deposits (e.g., 30% upon "
"booking) and remaining balances upon\n"
"                final CAD delivery."
msgstr ""
"<b>Configuração de Faturamento por Marco:</b> Defina depósitos iniciais (por "
"exemplo, 30% u no agendamento) e saldos restantes mediante a entrega final "
"do CAD."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Mobile Timer:</b> Field crews start/stop timers directly from their "
"mobile devices while on-site or during\n"
"                travel."
msgstr ""
"<b>Cronômetro Móvel:</b> As equipes de campo iniciam/param os cronômetros "
"diretamente de seus dispositivos móveis enquanto estão no local ou durante o "
"deslocamento."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Multi-Channel Lead Capture:</b> Ingest inquiries automatically from your "
"website’s quotation form or manually\n"
"                enter incoming phone calls."
msgstr ""
"<b>Captura de Leads Multicanal:</b> Receba consultas automaticamente a "
"partir do formulário de cotação do seu site ou insira manualmente as "
"chamadas telefônicas recebidas."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Offline Access:</b> Field technicians can fill out worksheets, attach geo-"
"tagged site photos, and collect\n"
"                client signatures even in remote areas without cellular "
"coverage."
msgstr ""
"<b>Acesso Offline:</b> Os técnicos de campo podem preencher planilhas, "
"anexar fotos georreferenciadas do local e coletar assinaturas de clientes "
"mesmo em áreas remotas sem cobertura celular."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Pipeline Tracking:</b> Move opportunities through stages such as <i>New "
"Inquiry</i>,\n"
"                <i>Site Scope &amp; Feasibility</i>, <i>Proposal Sent</i>, "
"and <i>Won</i>."
msgstr ""
"<b>Rastreamento do Pipeline:</b> Mova oportunidades através de estágios como "
"<i>Nova Consulta</i>,\n"
"                <i>Escopo do Local &amp; Viabilidade</i>, <i>Proposta "
"Enviada</i>, e <i>Ganho</i>."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Planning App</b>: Schedule field crews, drone pilots, and high-value "
"equipment (Total Stations, GNSS RTK\n"
"                Receivers, Scanners) without double-booking."
msgstr ""
"<b>Aplicativo de Planejamento</b>: Agende equipes de campo, pilotos de drone "
"e equipamentos de alto valor (Estações Totais, Receptores GNSS RTK, "
"Scanners) sem agendamentos duplicados."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Product Service Rules</b> Set your survey product line items to\n"
"                    <b>\"Create a task in an existing project\"</b> or "
"<b>\"Create a new project per order\"</b> to organize\n"
"                    deliverables seamlessly between fieldwork and office "
"drafting."
msgstr ""
"<b>Regras de Serviço de Produto</b> Defina seus itens de linha de produto de "
"pesquisa para\n"
"                    <b>\"Criar uma tarefa em um projeto existente\"</b> ou "
"<b>\"Criar um novo projeto por pedido\"</b> para organizar as entregas "
"perfeitamente entre o trabalho de campo e o desenho no escritório."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Sales App</b>: Generate detailed scope estimates (e.g., Topographic "
"Surveys, Boundary Staking, UAV Mapping)\n"
"                with automated task generation upon confirmation."
msgstr ""
"<b>Aplicativo de Vendas</b>: Gere estimativas de escopo detalhadas (por "
"exemplo, Levantamentos Topográficos, Demarcação de Limites, Mapeamento UAV) "
"com geração automática de tarefas após a confirmação."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Seamless Billable Hours</b> Approved timesheet hours automatically flow "
"into the corresponding customer\n"
"                    Sales Order for effortless billing."
msgstr ""
"<b>Horas Faturáveis Contínuas</b> As horas aprovadas na planilha fluem "
"automaticamente para o Pedido de venda do cliente correspondente para um "
"faturamento sem esforço."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Task Allocation:</b> Differentiate time spent on <i>Field Data "
"Collection</i>, <i>Travel Time</i>,\n"
"                <i>Raw Data Processing</i>, and <i>Final CAD Drafting</i>."
msgstr ""
"<b>Alocação de Tarefas:</b> Diferencie o tempo gasto em <i>Coleta de Dados "
"de Campo</i>, <i>Tempo de Deslocamento</i>,\n"
"                <i>Processamento de Dados Brutos</i>, e <i>Desenho Final em "
"CAD</i>."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Timesheet App</b>: Track field hours, travel time, and CAD processing "
"time against specific project tasks for\n"
"                accurate billing."
msgstr ""
"<b>Aplicativo de Planilha de Horas</b>: Rastreie horas de campo, tempo de "
"deslocamento e tempo de processamento em CAD em relação a tarefas "
"específicas do projeto para um faturamento preciso."

