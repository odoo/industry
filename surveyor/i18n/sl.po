#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
#, fuzzy
msgid ""
"<b>CRM App</b>: Track potential projects and manage relationships with "
"developers, construction firms, and\n"
"                private property owners."
msgstr ""
"<b>Aplikacija CRM</b>: Spremljajte potencialne projekte in upravljajte "
"odnose z razvijalci, gradbenimi podjetji in\n"
"                zasebnimi lastniki nepremičnin."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
#, fuzzy
msgid ""
"<b>Documents App</b>: Securely store, organize, and share heavy files such "
"as topographic maps, CAD drawings,\n"
"                and compliance reports."
msgstr ""
"<b>Aplikacija Dokumenti</b>: Varno shranjujte, organizirajte in delite "
"velike datoteke, kot so topografski zemljevidi, risbe CAD,\n"
"                in poročila o skladnosti."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
#, fuzzy
msgid ""
"<b>Invoicing App</b>: Bill clients accurately based on project milestones or "
"time spent on site, maintaining\n"
"                healthy cash flow."
msgstr ""
"<b>Aplikacija za izdajanje računov</b>: Strankam izdajajte natančne račune "
"glede na mejnike projekta ali čas, porabljen na lokaciji, ter ohranjajte\n"
"                zdrav denarni tok."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
#, fuzzy
msgid ""
"<b>Knowledge App</b>: Create a central repository for internal procedures, "
"safety guidelines, and technical\n"
"                standards accessible to all staff."
msgstr ""
"<b>Aplikacija Znanje</b>: Ustvarite osrednji repozitorij za notranje "
"postopke, varnostne smernice in tehnične\n"
"                standarde, dostopen vsem zaposlenim."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
#, fuzzy
msgid ""
"<b>Planning App</b>: Optimize your field operations by visually scheduling "
"surveyors and equipment to specific\n"
"                locations and times."
msgstr ""
"<b>Aplikacija za načrtovanje</b>: Optimizirajte svoje terenske operacije z "
"vizualnim razporejanjem geodetov in opreme na določene\n"
"                lokacije in ob določenih časih."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
#, fuzzy
msgid ""
"<b>Project App</b>: Manage complex surveying sites as distinct projects, "
"tracking tasks like initial\n"
"                measurements, data processing, and report generation."
msgstr ""
"<b>Aplikacija Projekti</b>: Upravljajte kompleksna geodetska območja kot "
"ločene projekte ter spremljajte opravila, kot so začetne\n"
"                meritve, obdelava podatkov in priprava poročila."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
#, fuzzy
msgid ""
"<b>Sales App</b>: Generate detailed proposals and contracts for surveying "
"services, ensuring clear scope and\n"
"                pricing agreements."
msgstr ""
"<b>Prodajna aplikacija</b>: Ustvarjajte podrobne ponudbe in pogodbe za "
"geodetske storitve ter zagotovite jasno opredeljen obseg in\n"
"                cenovne dogovore."

