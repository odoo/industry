#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.view_page_services
msgid ""
"<span class=\"h6-fs\">Capture accurate information about the land, from "
"elevations and contours to detailed 3D terrain data. Our mapping services "
"provide reliable site information for planning, design, engineering, and "
"construction projects.</span><br/>"
msgstr ""

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.view_page_services
msgid ""
"<span class=\"h6-fs\">Establish clear and accurate property boundaries with "
"professional land surveys. We provide reliable measurements and "
"documentation to help property owners, developers, and professionals protect "
"land rights and make informed decisions.</span>"
msgstr ""

