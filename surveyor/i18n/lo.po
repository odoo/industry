#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.about-us
#: model_terms:ir.ui.view,arch_db:surveyor.homepage
msgid "<b>ABOUT US</b>"
msgstr "<b>ກ່ຽວກັບພວກເຮົາ</b>"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Accounting Integration:</b> Automatically reconcile incoming bank "
"payments with open survey project invoices."
msgstr ""
"<b>ການເຊື່ອມໂຍງກັບບັນຊີ:</b> ກວດສອບຍອດເງິນທີ່ໄດ້ຮັບຜ່ານທະນາຄານໂດຍອັດຕະໂນມັດກັບໃບແຈ້ງໜີ້ໂຄງການສ"
"ຳຫຼວດທີ່ຄ້າງຊຳລະ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Automated Payment Follow-ups:</b> Set automated email reminders and SMS "
"notifications for unpaid invoices."
msgstr ""
"<b>ການຕິດຕາມການຊຳລະເງິນອັດຕະໂນມັດ:</b> ຕັ້ງຄ່າອີເມວເຕືອນ ແລະ ການແຈ້ງເຕືອນຜ່ານ SMS ແບບອັດຕະ"
"ໂນມັດສຳລັບໃບແຈ້ງໜີ້ທີ່ຍັງບໍ່ໄດ້ຊຳລະ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Automated Task Generation:</b> Setting up service lines (e.g., "
"<i>Topographic Fieldwork</i>,\n"
"                <i>CAD Drafting &amp; Feature Extraction</i>) automatically "
"generates dedicated project tasks upon Sales Order\n"
"                confirmation."
msgstr ""
"<b>ການສ້າງໜ້າວຽກອັດຕະໂນມັດ:</b> ການຕັ້ງຄ່າລາຍການບໍລິການ (ເຊັ່ນ: <i>ວຽກພາກສະໜາມດ້ານພູມສັນຖາ"
"ນ</i>,\n"
"                <i>ການແຕ້ມແບບ CAD &amp; ການສະກັດຂໍ້ມູນລັກສະນະ</i>) ຈະສ້າງໜ້າວຽກໂຄງການ"
"ສະເພາະໂດຍອັດຕະໂນມັດ ເມື່ອມີການຢືນຢັນ\n"
"                ໃບສັ່ງຂາຍ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Avoid Field Bottlenecks</b> Always assign both the <b>Lead Surveyor</b> "
"and the required\n"
"                    <b>Equipment Unit</b> to the same Planning shift to "
"ensure field teams arrive on-site fully equipped."
msgstr ""
"<b>ຫຼີກລ່ຽງການຕິດຂັດໃນພາກສະໜາມ:</b> ມອບໝາຍວຽກໃຫ້ທັງ <b>ຫົວໜ້າທີມສຳຫຼວດ</b> ແລະ <b>ອຸປະກອນ"
"ທີ່ຈຳເປັນ</b>\n"
"                    ໃນຜຽນວຽກວາງແຜນດຽວກັນສະເໝີ ເພື່ອຮັບປະກັນວ່າທີມງານພາກສະໜາມມີອຸປະກອນຄົບ"
"ຖ້ວນເມື່ອໄປຮອດໜ້າວຽກ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>CRM App</b>: Manage client inquiries from web forms or phone calls, track "
"ongoing bidding opportunities, and\n"
"                maintain client history in a visual pipeline."
msgstr ""
"<b>ແອັບ CRM</b>: ຈັດການການສອບຖາມຂອງລູກຄ້າຈາກຟອມເທິງເວັບໄຊ ຫຼື ສາຍໂທ, ຕິດຕາມໂອກາດການປະມູ"
"ນທີ່ກຳລັງດຳເນີນຢູ່, ແລະ\n"
"                ບັນທຶກປະຫວັດລູກຄ້າໃນລະບົບຂັ້ນຕອນການຂາຍທີ່ເຫັນໄດ້ຊັດເຈນ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Combined Invoicing:</b> Consolidate billable timesheet hours, mileage/"
"expenses, and delivered physical goods\n"
"                (e.g., <i>Printed Maps</i>) onto a single clear statement."
msgstr ""
"<b>ການອອກໃບແຈ້ງໜີ້ລວມ:</b> ລວບລວມຊົ່ວໂມງເຮັດວຽກທີ່ຄິດໄລ່ເງິນໄດ້, ໄລຍະທາງ/ຄ່າໃຊ້ຈ່າຍ, ແລະ ສິນຄ້"
"າຕົວຈິງທີ່ສົ່ງມອບແລ້ວ\n"
"                (ເຊັ່ນ: <i>ແຜນທີ່ພິມອອກ</i>) ໄວ້ໃນໃບລາຍງານດຽວຢ່າງຈະແຈ້ງ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Communication Logs:</b> Send emails, schedule site visits, and log call "
"notes directly within the pipeline\n"
"                card."
msgstr ""
"<b>ບັນທຶກການຕິດຕໍ່ສື່ສານ:</b> ສົ່ງອີເມວ, ນັດໝາຍເວລາລົງພື້ນທີ່, ແລະ ບັນທຶກການໂທໂດຍກົງໃນກາດຂັ້ນຕອນກາ"
"ນຂາຍ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Crew &amp; Skill Management:</b> Assign shifts based on certifications "
"(e.g., Licensed Professional Land\n"
"                Surveyor, FAA Part 107 Drone Operator, Bathymetric "
"Specialist)."
msgstr ""
"<b>ການຈັດການທີມງານ &amp; ທັກສະ:</b> ມອບໝາຍຜຽນວຽກຕາມໃບຢັ້ງຢືນວິຊາຊີບ (ເຊັ່ນ: ນັກສຳຫຼວດທີ່ດິນມື"
"ອາຊີບທີ່ມີໃບອະນຸຍາດ,\n"
"                ຜູ້ບັງຄັບໂດຣນ FAA Part 107, ຜູ້ຊ່ຽວຊານດ້ານການວັດແທກຄວາມເລິກຂອງນ້ຳ)."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Custom Field Worksheets:</b> Create tailored digital worksheets for each "
"intervention (e.g.,\n"
"                <i>Site Safety Assessment</i>, <i>Control Point Log</i>, "
"<i>Instrument Calibration Checklist</i>)."
msgstr ""
"<b>ໃບງານພາກສະໜາມແບບກຳນົດເອງ:</b> ສ້າງໃບງານດິຈິທັລທີ່ເໝາະສົມກັບແຕ່ລະວຽກ (ເຊັ່ນ:\n"
"                <i>ການປະເມີນຄວາມປອດໄພຂອງສະຖານທີ່</i>, <i>ບັນທຶກຈຸດຄວບຄຸມ</i>, <i>ລາຍ"
"ການກວດສອບການປັບທຽບເຄື່ອງມື</i>)."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Demo Data Notice</b> If you want to safely explore every feature of this "
"package, download the Demo Data.\n"
"                    You can do this by upgrading your package in <b>Apps</"
"b>. Demo data cannot be easily deleted once loaded;\n"
"                    reset with a fresh database on"
msgstr ""
"<b>ແຈ້ງເຕືອນກ່ຽວກັບຂໍ້ມູນທົດລອງ:</b> ຖ້າທ່ານຕ້ອງການທົດລອງໃຊ້ທຸກຄຸນສົມບັດຂອງແພັກເກດນີ້ຢ່າງປອດໄພ, ໃຫ້"
"ດາວໂຫຼດຂໍ້ມູນທົດລອງ.\n"
"                    ທ່ານສາມາດເຮັດໄດ້ໂດຍການອັບເກຣດແພັກເກດຂອງທ່ານໃນ <b>ແອັບ</b>. ເມື່ອໂຫຼ"
"ດຂໍ້ມູນທົດລອງແລ້ວຈະບໍ່ສາມາດລຶບອອກໄດ້ງ່າຍ;\n"
"                    ຕັ້ງຄ່າໃໝ່ດ້ວຍຖານຂໍ້ມູນໃໝ່ໄດ້ທີ່"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Direct Work Order Updates:</b> Field personnel mark interventions as "
"<i>In Progress</i> or <i>Completed</i>,\n"
"                immediately notifying the office CAD team."
msgstr ""
"<b>ອັບເດດໃບສັ່ງວຽກໂດຍກົງ:</b> ພະນັກງານພາກສະໜາມໝາຍສະຖານະວຽກເປັນ <i>ກຳລັງດຳເນີນການ</i> "
"ຫຼື <i>ສຳເລັດແລ້ວ</i>,\n"
"                ເຊິ່ງຈະແຈ້ງເຕືອນທີມງານ CAD ຢູ່ຫ້ອງການໃນທັນທີ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Equipment Tracking:</b> Schedule high-value equipment assets (e.g., Leica "
"Total Stations, Trimble RTK Units,\n"
"                LiDAR Drones) alongside field crews to prevent resource "
"overlap."
msgstr ""
"<b>ການຕິດຕາມອຸປະກອນ:</b> ຈັດຕາຕະລາງອຸປະກອນທີ່ມີມູນຄ່າສູງ (ເຊັ່ນ: ກ້ອງປະມວນຜົນລວມ Leica "
"Total Station, ຊຸດ Trimble RTK,\n"
"                ໂດຣນ LiDAR) ໄປພ້ອມກັບທີມງານພາກສະໜາມ ເພື່ອປ້ອງກັນການນຳໃຊ້ອຸປະກອນຊ້ອນກັນ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Expense Logging:</b> Capture site-related expenses (e.g., toll fees, "
"monumentation materials, satellite\n"
"                imagery purchase) directly against the project card."
msgstr ""
"<b>ການບັນທຶກລາຍຈ່າຍ:</b> ບັນທຶກລາຍຈ່າຍທີ່ກ່ຽວຂ້ອງກັບພື້ນທີ່ (ເຊັ່ນ: ຄ່າຜ່ານທາງ, ວັດສະດຸຫຼັກໝາຍເຂດ, ກ"
"ານຊື້ພາບຖ່າຍດາວທຽມ)\n"
"                ເຂົ້າໃນກາດໂຄງການໂດຍກົງ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Field Service &amp; Project App</b>: Dispatch field technicians, execute "
"custom digital worksheets, and\n"
"                capture site sign-offs directly from tablet or mobile."
msgstr ""
"<b>ແອັບການບໍລິການພາກສະໜາມ &amp; ໂຄງການ</b>: ສົ່ງຊ່າງເຕັກນິກພາກສະໜາມ, ນຳໃຊ້ໃບງານດິຈິທັລທີ່ກຳ"
"ນົດເອງ, ແລະ\n"
"                ຮັບລາຍເຊັນຢືນຢັນໜ້າວຽກໂດຍກົງຈາກແທັບເລັດ ຫຼື ໂທລະສັບມືຖື."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Gantt View Scheduling:</b> Reorganize schedules via drag-and-drop based "
"on changing weather conditions or\n"
"                site access delays."
msgstr ""
"<b>ການຈັດຕາຕະລາງແບບມຸມມອງແກນທ໌ (Gantt View):</b> ປັບປ່ຽນຕາຕະລາງເວລາດ້ວຍການລາກ ແລະ ວ"
"າງ ຕາມສະພາບອາກາດທີ່ປ່ຽນແປງ ຫຼື\n"
"                ຄວາມຊັກຊ້າໃນການເຂົ້າເຖິງພື້ນທີ່."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Goods &amp; Physical Deliverables:</b> Add non-service items such as "
"<i>Physical Boundary Stakes</i>,\n"
"                <i>Hardcopy Plats</i>, or <i>3D Printed Topo Models</i> "
"directly as deliverable products on the same quotation."
msgstr ""
"<b>ສິນຄ້າ &amp; ສິ່ງທີ່ສົ່ງມອບຕົວຈິງ:</b> ເພີ່ມລາຍການທີ່ບໍ່ແມ່ນການບໍລິການ ເຊັ່ນ: <i>ຫຼັກໝາຍເຂດແດນຕົວຈິ"
"ງ</i>,\n"
"                <i>ແຜນຜັງເຈ້ຍ</i>, ຫຼື <i>ແບບຈຳລອງພູມສັນຖານພິມ 3D</i> ເປັນສິນຄ້າສົ່ງມອບໃນ"
"ໃບສະເໜີລາຄາດຽວກັນໄດ້ໂດຍກົງ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Invoicing App</b>: Bill milestone deposits, billable time, travel "
"expenses, and tangible goods (e.g., printed\n"
"                blueprints, USB survey data drives)."
msgstr ""
"<b>ແອັບການອອກໃບແຈ້ງໜີ້</b>: ອອກໃບຮຽກເກັບເງິນມັດຈຳຕາມໄລຍະວຽກ, ເວລາທີ່ຄິດໄລ່ເງິນໄດ້, ຄ່າໃຊ້ຈ່າຍ"
"ໃນການເດີນທາງ, ແລະ ສິນຄ້າຕົວຈິງ (ເຊັ່ນ: ແຜນຜັງພິມ,\n"
"                ແຟລດໄດຣຟ໌ USB ບັນຈຸຂໍ້ມູນການສຳຫຼວດ)."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Lead Qualification:</b> Capture crucial site metadata early (e.g., parcel "
"numbers, site access conditions,\n"
"                required accuracy standards)."
msgstr ""
"<b>ການປະເມີນຄຸນນະພາບຜູ້ສົນໃຈ:</b> ເກັບກຳຂໍ້ມູນສຳຄັນຂອງພື້ນທີ່ແຕ່ຫົວທີ (ເຊັ່ນ: ເລກຕອນດິນ, ເງື່ອນໄຂກາ"
"ນເຂົ້າເຖິງພື້ນທີ່,\n"
"                ມາດຕະຖານຄວາມຖືກຕ້ອງທີ່ຕ້ອງການ)."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Leverage incoming leads from your website</b> Configure your website's\n"
"                    <b>\"Request a Survey Quote\"</b> form to automatically "
"feed incoming inquiries into the CRM pipeline and\n"
"                    auto-assign them based on region or survey type."
msgstr ""
"<b>ນຳໃຊ້ຜູ້ສົນໃຈທີ່ເຂົ້າມາຈາກເວັບໄຊຂອງທ່ານ:</b> ຕັ້ງຄ່າຟອມ\n"
"                    <b>\"ຂໍໃບສະເໜີລາຄາການສຳຫຼວດ\"</b> ເທິງເວັບໄຊຂອງທ່ານ ເພື່ອສົ່ງຂໍ້ມູນການ"
"ສອບຖາມເຂົ້າສູ່ຂັ້ນຕອນການຂາຍຂອງ CRM ໂດຍອັດຕະໂນມັດ ແລະ\n"
"                    ມອບໝາຍວຽກອັດຕະໂນມັດຕາມພາກພື້ນ ຫຼື ປະເພດຂອງການສຳຫຼວດ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Milestone Billing Setup:</b> Define upfront deposits (e.g., 30% upon "
"booking) and remaining balances upon\n"
"                final CAD delivery."
msgstr ""
"<b>ການຕັ້ງຄ່າຮຽກເກັບເງິນຕາມງວດວຽກ:</b> ກຳນົດເງິນມັດຈຳລ່ວງໜ້າ (ເຊັ່ນ: 30% ເມື່ອຈອງ) ແລະ ສ່ວນທີ່"
"ເຫຼືອເມື່ອ\n"
"                ສົ່ງມອບໄຟລ໌ CAD ຂັ້ນສຸດທ້າຍ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Mobile Timer:</b> Field crews start/stop timers directly from their "
"mobile devices while on-site or during\n"
"                travel."
msgstr ""
"<b>ໂມງຈັບເວລາເທິງມືຖື:</b> ທີມງານພາກສະໜາມສາມາດເລີ່ມ/ຢຸດໂມງຈັບເວລາໄດ້ໂດຍກົງຈາກອຸປະກອນມືຖື ໃນ"
"ຂະນະທີ່ຢູ່ໜ້າວຽກ ຫຼື ໃນລະຫວ່າງ\n"
"                ການເດີນທາງ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Multi-Channel Lead Capture:</b> Ingest inquiries automatically from your "
"website’s quotation form or manually\n"
"                enter incoming phone calls."
msgstr ""
"<b>ການຮັບຂໍ້ມູນຜູ້ສົນໃຈຫຼາຍຊ່ອງທາງ:</b> ດຶງຂໍ້ມູນການສອບຖາມໂດຍອັດຕະໂນມັດຈາກຟອມຂໍໃບສະເໜີລາຄາເທິງເ"
"ວັບໄຊຂອງທ່ານ ຫຼື ປ້ອນຂໍ້ມູນ\n"
"                ສາຍໂທເຂົ້າມາດ້ວຍຕົນເອງ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Offline Access:</b> Field technicians can fill out worksheets, attach geo-"
"tagged site photos, and collect\n"
"                client signatures even in remote areas without cellular "
"coverage."
msgstr ""
"<b>ການເຂົ້າເຖິງແບບອອບລາຍ:</b> ຊ່າງເຕັກນິກພາກສະໜາມສາມາດຕື່ມໃບງານ, ແນບຮູບຖ່າຍພື້ນທີ່ພ້ອມພິກັດທີ່ຕັ້"
"ງ, ແລະ ຮັບ\n"
"                ລາຍເຊັນລູກຄ້າໄດ້ ແມ່ນແຕ່ຢູ່ໃນເຂດຫ່າງໄກສອກຫຼີກທີ່ບໍ່ມີສັນຍານໂທລະສັບ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Pipeline Tracking:</b> Move opportunities through stages such as <i>New "
"Inquiry</i>,\n"
"                <i>Site Scope &amp; Feasibility</i>, <i>Proposal Sent</i>, "
"and <i>Won</i>."
msgstr ""
"<b>ການຕິດຕາມຂັ້ນຕອນການຂາຍ:</b> ຍ້າຍໂອກາດການຂາຍຜ່ານຂັ້ນຕອນຕ່າງໆ ເຊັ່ນ: <i>ການສອບຖາມໃໝ່</"
"i>,\n"
"                <i>ຂອບເຂດ &amp; ຄວາມເປັນໄປໄດ້ຂອງພື້ນທີ່</i>, <i>ສົ່ງຂໍ້ສະເໜີແລ້ວ</i>, ແລ"
"ະ <i>ປິດການຂາຍໄດ້</i>."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Planning App</b>: Schedule field crews, drone pilots, and high-value "
"equipment (Total Stations, GNSS RTK\n"
"                Receivers, Scanners) without double-booking."
msgstr ""
"<b>ແອັບການວາງແຜນ</b>: ຈັດຕາຕະລາງທີມງານພາກສະໜາມ, ນັກບິນໂດຣນ, ແລະ ອຸປະກອນມູນຄ່າສູງ "
"(Total Stations, ເຄື່ອງຮັບສັນຍານ GNSS RTK,\n"
"                ເຄື່ອງສະແກນ) ໂດຍບໍ່ມີການຈອງຊ້ອນກັນ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Product Service Rules</b> Set your survey product line items to\n"
"                    <b>\"Create a task in an existing project\"</b> or "
"<b>\"Create a new project per order\"</b> to organize\n"
"                    deliverables seamlessly between fieldwork and office "
"drafting."
msgstr ""
"<b>ກົດລະບຽບບໍລິການສິນຄ້າ:</b> ຕັ້ງຄ່າລາຍການສິນຄ້າບໍລິການສຳຫຼວດຂອງທ່ານເປັນ\n"
"                    <b>\"ສ້າງໜ້າວຽກໃນໂຄງການທີ່ມີຢູ່\"</b> ຫຼື <b>\"ສ້າງໂຄງການໃໝ່ຕໍ່ໃບສັ່ງ"
"ຊື້\"</b> ເພື່ອຈັດການ\n"
"                    ຜົນງານສົ່ງມອບລະຫວ່າງວຽກພາກສະໜາມ ແລະ ການແຕ້ມແບບໃນຫ້ອງການຢ່າງຕໍ່ເນື່ອ"
"ງ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Sales App</b>: Generate detailed scope estimates (e.g., Topographic "
"Surveys, Boundary Staking, UAV Mapping)\n"
"                with automated task generation upon confirmation."
msgstr ""
"<b>ແອັບການຂາຍ</b>: ສ້າງການປະເມີນຂອບເຂດວຽກຢ່າງລະອຽດ (ເຊັ່ນ: ການສຳຫຼວດພູມສັນຖານ, ການໝາຍຫຼັ"
"ກເຂດແດນ, ການເຮັດແຜນທີ່ດ້ວຍ UAV)\n"
"                ພ້ອມສ້າງໜ້າວຽກອັດຕະໂນມັດເມື່ອຢືນຢັນ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Seamless Billable Hours</b> Approved timesheet hours automatically flow "
"into the corresponding customer\n"
"                    Sales Order for effortless billing."
msgstr ""
"<b>ຊົ່ວໂມງຄິດໄລ່ເງິນໄດ້ແບບຕໍ່ເນື່ອງ:</b> ຊົ່ວໂມງບັນທຶກເວລາທີ່ໄດ້ຮັບການອະນຸມັດຈະຖືກສົ່ງເຂົ້າໄປຍັງໃບສັ່ງຂາຍ"
"ຂອງລູກຄ້າທີ່ກ່ຽວຂ້ອງ\n"
"                    ໂດຍອັດຕະໂນມັດເພື່ອການອອກໃບແຈ້ງໜີ້ທີ່ສະດວກສະບາຍ."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Task Allocation:</b> Differentiate time spent on <i>Field Data "
"Collection</i>, <i>Travel Time</i>,\n"
"                <i>Raw Data Processing</i>, and <i>Final CAD Drafting</i>."
msgstr ""
"<b>ການຈັດສັນໜ້າວຽກ:</b> ແຍກເວລາທີ່ໃຊ້ໃນການ <i>ເກັບກຳຂໍ້ມູນພາກສະໜາມ</i>, <i>ເວລາເດີນທາງ</"
"i>,\n"
"                <i>ການປະມວນຜົນຂໍ້ມູນດິບ</i>, ແລະ <i>ການແຕ້ມແບບ CAD ຂັ້ນສຸດທ້າຍ</i>."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Timesheet App</b>: Track field hours, travel time, and CAD processing "
"time against specific project tasks for\n"
"                accurate billing."
msgstr ""
"<b>ແອັບບັນທຶກເວລາ</b>: ຕິດຕາມຊົ່ວໂມງເຮັດວຽກພາກສະໜາມ, ເວລາເດີນທາງ, ແລະ ເວລາປະມວນຜົນ "
"CAD ຕາມໜ້າວຽກໂຄງການສະເພາະ ເພື່ອການ\n"
"                ຄິດໄລ່ເງິນທີ່ຖືກຕ້ອງ."

