#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.about-us
#: model_terms:ir.ui.view,arch_db:surveyor.homepage
msgid "<b>ABOUT US</b>"
msgstr "<b>CHI SIAMO</b>"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Accounting Integration:</b> Automatically reconcile incoming bank "
"payments with open survey project invoices."
msgstr ""
"<b>Integrazione con Contabilità:</b> riconcilia automaticamente i pagamenti "
"bancari in entrata con le fatture aperte dei progetti."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Automated Payment Follow-ups:</b> Set automated email reminders and SMS "
"notifications for unpaid invoices."
msgstr ""
"<b>Solleciti di pagamento automatici:</b> imposta promemoria e-mail "
"automatici e notifiche SMS per le fatture non saldate;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Automated Task Generation:</b> Setting up service lines (e.g., "
"<i>Topographic Fieldwork</i>,\n"
"                <i>CAD Drafting &amp; Feature Extraction</i>) automatically "
"generates dedicated project tasks upon Sales Order\n"
"                confirmation."
msgstr ""
"<b>Generazione automatizzata lavori:</b> la configurazione di righe di "
"servizio (ad es. <i>Lavoro sul campo topografico</i>,\n"
"                <i>Disegno CAD ed estrazione funzionalità</i>) genera "
"automaticamente lavori di progetto dedicati alla conferma dell'ordine di "
"vendita;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Avoid Field Bottlenecks</b> Always assign both the <b>Lead Surveyor</b> "
"and the required\n"
"                    <b>Equipment Unit</b> to the same Planning shift to "
"ensure field teams arrive on-site fully equipped."
msgstr ""
"<b>Evita colli di bottiglia sul campo</b>. Assegna sempre sia un <b>"
"topografo responsabile</b> che una <b>unità per l'attrezzatura</b> richiesta "
"allo stesso turno di pianificazione per garantire che le squadre arrivino "
"sul campo completamente attrezzate."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>CRM App</b>: Manage client inquiries from web forms or phone calls, track "
"ongoing bidding opportunities, and\n"
"                maintain client history in a visual pipeline."
msgstr ""
"<b>app CRM</b>: gestisci le richieste dei clienti provenienti da moduli web "
"o telefonate, tieni traccia delle opportunità di offerta in corso e mantieni "
"lo storico dei clienti in una pipeline visiva;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Combined Invoicing:</b> Consolidate billable timesheet hours, mileage/"
"expenses, and delivered physical goods\n"
"                (e.g., <i>Printed Maps</i>) onto a single clear statement."
msgstr ""
"<b>Fatturazione combinata:</b> consolida le ore fatturabili dei fogli ore, "
"il chilometraggio/note spese e i beni fisici consegnati\n"
"                (ad es. <i>mappe stampate</i>) in un unico estratto conto "
"chiaro;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Communication Logs:</b> Send emails, schedule site visits, and log call "
"notes directly within the pipeline\n"
"                card."
msgstr ""
"<b>Registri di comunicazione:</b> invia e-mail, pianifica sopralluoghi e "
"registra le note delle chiamate direttamente all'interno della scheda della "
"pipeline."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Crew &amp; Skill Management:</b> Assign shifts based on certifications "
"(e.g., Licensed Professional Land\n"
"                Surveyor, FAA Part 107 Drone Operator, Bathymetric "
"Specialist)."
msgstr ""
"<b>Gestione team di lavoro e competenze:</b> assegna i turni in base alle "
"certificazioni (ad es. geometra professionista abilitato, operatore di droni "
"FAA Part 107, specialista batimetrico);"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Custom Field Worksheets:</b> Create tailored digital worksheets for each "
"intervention (e.g.,\n"
"                <i>Site Safety Assessment</i>, <i>Control Point Log</i>, "
"<i>Instrument Calibration Checklist</i>)."
msgstr ""
"<b>Fogli di lavoro personalizzati per il campo:</b> crea fogli di lavoro "
"digitali su misura per ogni intervento (ad es. <i>Valutazione sicurezza "
"sito</i>, <i>Registro punti di controllo</i>, <i>Lista di controllo "
"calibrazione strumenti</i>);"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Demo Data Notice</b> If you want to safely explore every feature of this "
"package, download the Demo Data.\n"
"                    You can do this by upgrading your package in <b>Apps</"
"b>. Demo data cannot be easily deleted once loaded;\n"
"                    reset with a fresh database on"
msgstr ""
"<b>Avviso dati demo</b>. Se desideri esplorare in sicurezza ogni "
"funzionalità di questo pacchetto, scarica i dati demo. Puoi farlo "
"aggiornando il pacchetto in <b>Applicazioni</b>. I dati demo non possono "
"essere facilmente eliminati una volta caricati. Ricomincia con un nuovo "
"database su"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Direct Work Order Updates:</b> Field personnel mark interventions as "
"<i>In Progress</i> or <i>Completed</i>,\n"
"                immediately notifying the office CAD team."
msgstr ""
"<b>Aggiornamenti diretti ordini di lavoro:</b> il personale sul campo "
"contrassegna gli interventi come <i>In corso</i> o <i>Completato</i>\n"
"                notificando immediatamente il team CAD dell'ufficio."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Equipment Tracking:</b> Schedule high-value equipment assets (e.g., Leica "
"Total Stations, Trimble RTK Units,\n"
"                LiDAR Drones) alongside field crews to prevent resource "
"overlap."
msgstr ""
"<b>Tracciamento attrezzature:</b> pianifica l'utilizzo delle attrezzature di "
"alto valore (ad es. Stazioni totali Leica, unità RTK Trimble, droni LiDAR) "
"insieme alle squadre sul campo per evitare sovrapposizioni di risorse;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Expense Logging:</b> Capture site-related expenses (e.g., toll fees, "
"monumentation materials, satellite\n"
"                imagery purchase) directly against the project card."
msgstr ""
"<b>Registrazione note spese:</b> acquisisci le spese relative al sito (ad "
"es. pedaggi, materiali per monumentazione, acquisto di immagini satellitari) "
"direttamente nella scheda dei progetti."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Field Service &amp; Project App</b>: Dispatch field technicians, execute "
"custom digital worksheets, and\n"
"                capture site sign-offs directly from tablet or mobile."
msgstr ""
"<b>Assistenza sul campo e Progetti</b>: assegna tecnici sul campo, esegui "
"fogli di lavoro digitali personalizzati e\n"
"                raccogli le autorizzazioni in loco direttamente da un tablet "
"o da un dispositivo mobile;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Gantt View Scheduling:</b> Reorganize schedules via drag-and-drop based "
"on changing weather conditions or\n"
"                site access delays."
msgstr ""
"<b>Pianificazione vista Gantt:</b> riorganizza le pianificazioni tramite "
"trascinamento in base alle mutevoli condizioni meteorologiche o ai ritardi "
"di accesso al sito."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Goods &amp; Physical Deliverables:</b> Add non-service items such as "
"<i>Physical Boundary Stakes</i>,\n"
"                <i>Hardcopy Plats</i>, or <i>3D Printed Topo Models</i> "
"directly as deliverable products on the same quotation."
msgstr ""
"<b>Beni e consegne fisiche:</b> aggiungi articoli non di servizio come <i>"
"picchetti di confine fisici</i>,\n"
"                <i>piantine cartacee</i> o <i>modelli topografici stampati "
"in 3D</i> direttamente come prodotti consegnabili nello stesso preventivo;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Invoicing App</b>: Bill milestone deposits, billable time, travel "
"expenses, and tangible goods (e.g., printed\n"
"                blueprints, USB survey data drives)."
msgstr ""
"<b>Fatturazione</b>: fattura gli acconti in base alle milestone, al tempo "
"fatturabile, alle spese di viaggio e ai beni fisici (ad es.\n"
"                piantine stampate, supporti USB per dati di sondaggi)."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Lead Qualification:</b> Capture crucial site metadata early (e.g., parcel "
"numbers, site access conditions,\n"
"                required accuracy standards)."
msgstr ""
"<b>Qualifica lead:</b> raccogli sin da subito metadati importanti del luogo "
"(ad es. numeri di parcella, condizioni di accesso al sito,\n"
"                standard di precisione richiesti);"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Leverage incoming leads from your website</b> Configure your website's\n"
"                    <b>\"Request a Survey Quote\"</b> form to automatically "
"feed incoming inquiries into the CRM pipeline and\n"
"                    auto-assign them based on region or survey type."
msgstr ""
"<b>Approfitta dei lead che arrivano dal tuo sito web.</b> Configura il "
"modulo\n"
"                    <b>\"Richiedi preventivo\"</b> affinché le richieste in "
"entrata vengano indirizzate direttamente al CRM e\n"
"                    autoassegnate in base alla regione o al tipo di "
"intervento topografico."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Milestone Billing Setup:</b> Define upfront deposits (e.g., 30% upon "
"booking) and remaining balances upon\n"
"                final CAD delivery."
msgstr ""
"<b>Configurazione fatturazione milestone:</b> definisci gli acconti (ad es. "
"30% al momento della prenotazione) e i saldi restanti\n"
"                al momento della consegna dei file CAD."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Mobile Timer:</b> Field crews start/stop timers directly from their "
"mobile devices while on-site or during\n"
"                travel."
msgstr ""
"<b>Timer per dispositivi mobili:</b> i team in loco posso avviare e "
"interrompere il timer direttamente dai propri dispositivi mobili mentre "
"lavorano in loco o viaggiano;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Multi-Channel Lead Capture:</b> Ingest inquiries automatically from your "
"website’s quotation form or manually\n"
"                enter incoming phone calls."
msgstr ""
"<b>Acquisizione lead da più canali:</b> ricevi richieste automaticamente dal "
"modulo di preventivo del sito web oppure registra manualmente le chiamate "
"telefoniche in entrata;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Offline Access:</b> Field technicians can fill out worksheets, attach geo-"
"tagged site photos, and collect\n"
"                client signatures even in remote areas without cellular "
"coverage."
msgstr ""
"<b>Accesso offline:</b> i tecnici possono compilare i fogli di lavoro, "
"allegare foto del sito con geolocalizzazione e raccogliere le firme dei "
"clienti anche in aree remote prive di copertura;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Pipeline Tracking:</b> Move opportunities through stages such as <i>New "
"Inquiry</i>,\n"
"                <i>Site Scope &amp; Feasibility</i>, <i>Proposal Sent</i>, "
"and <i>Won</i>."
msgstr ""
"<b>Monitoraggio pipeline:</b> muovi le opportunità nelle varie fasi come <i>"
"Nuova richiesta</i>,\n"
"                <i>Ambito progetto e fattibilità</i>, <i>Proposta inviata</"
"i> e <i>Vinta</i>;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Planning App</b>: Schedule field crews, drone pilots, and high-value "
"equipment (Total Stations, GNSS RTK\n"
"                Receivers, Scanners) without double-booking."
msgstr ""
"<b>Pianificazione</b>: programma i team in loco, i piloti di droni e "
"l'attrezzatura di alto valore (stazioni totali, ricevitori GNSS RTK e "
"scanner) così da evitare doppie prenotazioni;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Product Service Rules</b> Set your survey product line items to\n"
"                    <b>\"Create a task in an existing project\"</b> or "
"<b>\"Create a new project per order\"</b> to organize\n"
"                    deliverables seamlessly between fieldwork and office "
"drafting."
msgstr ""
"<b>Regole dei servizi di prodotto</b>. Imposta le voci della riga di "
"prodotto di rilevazione su <b>\"Crea un lavoro in un progetto esistente\"</"
"b> o <b>\"Crea un nuovo progetto per ordine\"</b> per organizzare i "
"risultati in modo fluido tra il lavoro sul campo e la redazione in ufficio."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Sales App</b>: Generate detailed scope estimates (e.g., Topographic "
"Surveys, Boundary Staking, UAV Mapping)\n"
"                with automated task generation upon confirmation."
msgstr ""
"<b>Vendite</b>: genera stime dettagliate dell'ambito di applicazione (ad es. "
"rilievi topografici, picchettamenti di confine, mappatura UAV) con "
"generazione automatica dei lavori alla conferma;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Seamless Billable Hours</b> Approved timesheet hours automatically flow "
"into the corresponding customer\n"
"                    Sales Order for effortless billing."
msgstr ""
"<b>Ore fatturabili senza complicazioni</b>. Le ore dei fogli ore approvati "
"confluiscono automaticamente nel corrispondente ordine di vendita del "
"cliente per una fatturazione più semplice."

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Task Allocation:</b> Differentiate time spent on <i>Field Data "
"Collection</i>, <i>Travel Time</i>,\n"
"                <i>Raw Data Processing</i>, and <i>Final CAD Drafting</i>."
msgstr ""
"<b>Assegnazione lavori:</b> differenzia il tempo speso in <i>Raccolta dati "
"sul campo</i>, <i>Tempo di viaggio</i>,\n"
"                <i>Elaborazione dati grezzi</i> e <i>Disegno CAD finale</i>;"

#. module: surveyor
#: model_terms:ir.ui.view,arch_db:surveyor.welcome_article_body
msgid ""
"<b>Timesheet App</b>: Track field hours, travel time, and CAD processing "
"time against specific project tasks for\n"
"                accurate billing."
msgstr ""
"<b>Fogli ore</b>: registra le ore sul campo, il tempo di viaggio e il tempo "
"di elaborazione dei file CAD in lavori di progetti specifici per una "
"fatturazione più accurata;"

