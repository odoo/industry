<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="worksheet_template_1" model="worksheet.template">
        <field name="name">On site Measurement</field>
        <field name="res_model">planning.slot</field>
        <field name="worksheet_properties_definition" eval="[{
        'name': 'notes', 'type': 'char', 'string': 'Notes', 'default': ''}, {
        'name': 'weather_condition', 'type': 'char', 'string': 'Wheather condition', 'default': ''}, {
        'name': 'measurement_tool', 'type': 'char', 'string': 'Measurement tool', 'default': ''
        }]"/>
    </record>

    <function name="unlink" model="worksheet.template" eval="[ref('planning_field_service_worksheet.fsm_worksheet_template', raise_if_not_found=False)]"/>
</odoo>
