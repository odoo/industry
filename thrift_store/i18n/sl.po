#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid "<strong>Accounting:</strong> Full financial tracking and reporting."
msgstr ""
"<strong>Računovodstvo:</strong> Celovito finančno sledenje in poročanje."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Contacts:</strong> Maintain donor, community partner and customer\n"
"                    information."
msgstr ""
"<strong>Stiki:</strong> Vzdržujte informacije o donatorjih, partnerjih "
"skupnosti in strankah\n"
"                    ."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Employees App:</strong>  Centralize information for all your staff "
"members and volunteers in one secure directory."
msgstr ""
"<strong>Aplikacija Zaposleni:</strong>  Centralizirajte informacije o vseh "
"svojih zaposlenih in prostovoljcih v enem varnem imeniku."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Inventory:</strong> Gain deeper insight into donation stock and "
"turnover."
msgstr ""
"<strong>Zaloga:</strong> Pridobite podrobnejši vpogled v zalogo donacij in "
"njeno obračanje."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Keep shifts balanced:</strong> Plan employee coverage across peak "
"hours\n"
"                    (weekends, donation drive days)."
msgstr ""
"<strong>Poskrbite za uravnotežene izmene:</strong> Načrtujte razpored "
"zaposlenih v času največje obremenitve\n"
"                    (ob koncih tedna, na dneve zbiranja donacij)."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Leaves:</strong> Easily manage employee's time off and plan work\n"
"                    accordingly."
msgstr ""
"<strong>Odsotnosti:</strong> Preprosto upravljajte odsotnosti zaposlenih in "
"ustrezno načrtujte delo\n"
"                    ."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Leverage promotions:</strong> Use Odoo POS’s discount and pricing "
"rules\n"
"                    for events like “fill a bag” sales."
msgstr ""
"<strong>Izkoristite promocije:</strong> Uporabite pravila za popuste in cene "
"v Odoo POS-u\n"
"                    za dogodke, kot so akcije »napolni vrečko«."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Planning App:</strong> Organize shifts and schedules easily, "
"ensuring you always have enough hands on deck for sorting and sales."
msgstr ""
"<strong>Aplikacija za načrtovanje:</strong> Preprosto organizirajte izmene "
"in urnike ter poskrbite, da boste vedno imeli dovolj ljudi za razvrščanje in "
"prodajo."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Point of Sale App:</strong> Process transactions quickly with a "
"flexible checkout system that supports sales by product, fixed amount, or "
"weight."
msgstr ""
"<strong>Aplikacija za prodajno mesto:</strong> Hitro obdelujte transakcije s "
"prilagodljivim sistemom blagajne, ki podpira prodajo po izdelku, fiksnem "
"znesku ali teži."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Purchase:</strong> Manage store supply needs (bags, hangers, "
"cleaning\n"
"                    supplies)."
msgstr ""
"<strong>Nabava:</strong> Upravljajte potrebe trgovine po zalogah (vrečke, "
"obešalniki, čistilni\n"
"                    pripomočki)."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Standardize categories:</strong> Use consistent product categories "
"(e.g.,\n"
"                    clothing, books, household) to keep reporting clear."
msgstr ""
"<strong>Standardizirajte kategorije:</strong> Uporabljajte dosledne "
"kategorije izdelkov (npr.,\n"
"                    oblačila, knjige, gospodinjski izdelki), da bo poročanje "
"jasno."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>Train your staff:</strong> Volunteers and part-time staff pick up "
"faster\n"
"                    with Odoo’s intuitive POS interface."
msgstr ""
"<strong>Usposobite svoje osebje:</strong> Prostovoljci in zaposleni za "
"krajši delovni čas se hitreje znajdejo\n"
"                    z intuitivnim vmesnikom POS sistema Odoo."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid "<strong>Website:</strong> Showcase your mission and events online."
msgstr ""
"<strong>Spletna stran:</strong> Predstavite svoje poslanstvo in dogodke na "
"spletu."

#. module: thrift_store
#: model_terms:ir.ui.view,arch_db:thrift_store.welcome_article_body
#, fuzzy
msgid ""
"<strong>eCommerce:</strong> Sell select high-value items online to reach "
"wider\n"
"                    audiences."
msgstr ""
"<strong>E-trgovina:</strong> Prodajajte izbrane visokovredne izdelke prek "
"spleta, da dosežete širše\n"
"                    občinstvo."

