<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-right-width: 0px;" data-contains-ai-content="true">
                    <section class="s_text_cover o_cc o_cc4 pt64 pb32" data-snippet="s_text_cover" data-name="Footer" style="background: linear-gradient(rgba(255, 255, 255, 0.03), rgba(0, 0, 0, 0.08));">
                        <div class="container">
                            <div class="row align-items-start">
                                <div class="col-lg-4 o_colored_level pb16">
                                    <h5 class="mb16" style="font-size: 1.8rem;">Adèle</h5>
                                    <p style="max-width: 22rem;">Timeless clothing, curated with care for modern wardrobes. Discover pieces designed to last beyond the season.</p>
                                </div>
                                <div class="col-lg-2 pb24 o_colored_level">
                                    <h5 class="mb16">Collection</h5>
                                    <ul class="list-unstyled m-0">
                                        <li class="pb8">
                                            <a href="/shop" class="text-decoration-none text-o-color-3">All products</a>
                                        </li>
                                        <li class="pb8">
                                            <a href="*product_public_category_15_url*" class="o_translate_inline text-o-color-3">Tops</a>
                                        </li>
                                        <li class="pb8">
                                            <a href="*product_public_category_14_url*" class="o_translate_inline text-o-color-3">Knits</a>
                                        </li>
                                        <li class="pb8">
                                            <a href="*product_public_category_16_url*" class="o_translate_inline text-o-color-3">Shoes</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-lg-3 pb24 o_colored_level">
                                    <h5 class="mb16">Contact</h5>
                                    <ul class="list-unstyled m-0">
                                        <li class="pb8">Customer care: info@adele.example.com</li>
                                        <li class="pb8">Mon-Fri: 8.00am-6.00pm</li>
                                        <li class="pb8">
                                            <br/>
                                            Shipping Worldwide
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-lg-3 o_colored_level pb24">
                                    <h5 class="mb16">Follow us</h5>
                                    <div class="s_social_media o_not_editable text-start no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h4 class="s_social_media_title d-none">Social Media</h4>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi o_editable_media small_social_icon rounded-circle shadow-sm" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank" aria-label="Instagram">
                                            <i class="oi o_editable_media small_social_icon rounded-circle shadow-sm" data-icon="oi_instagram"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <hr class="my24"/>
                            <div class="row align-items-center">
                                <div class="col-lg-6 pb16 o_colored_level">© Adèle. All rights reserved.</div>
                                <div class="col-lg-6 pb16 text-lg-end o_colored_level">
                                    <a href="/privacy" class="me16 text-decoration-none text-o-color-3">Privacy</a>
                                    <a href="/terms" class="me16 text-decoration-none text-o-color-3">Terms</a>
                                    <a href="/contactus" class="text-decoration-none text-o-color-3">Help</a>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value eval="[ref('footer_custom')]"/>
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('clothing_boutique.footer_custom').arch
            .replace('*product_public_category_15_url*', obj().env.ref('clothing_boutique.product_public_category_15').website_url)
            .replace('*product_public_category_14_url*', obj().env.ref('clothing_boutique.product_public_category_14').website_url)
            .replace('*product_public_category_16_url*', obj().env.ref('clothing_boutique.product_public_category_16').website_url)
        }"/>
    </function>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/shop" class="oe_unremovable w-100 btn btn-primary">
                                    Our Collection
                                </a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="header_text_element_mail" model="ir.ui.view">
        <field name="name">Custom - Header Text element</field>
        <field name="key">clothing_boutique.header_text_element_mail</field>
        <field name="inherit_id" ref="website.header_text_element"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-elif=&quot;_txt_elt_content == 'phone_mail'&quot;]//a[starts-with(@href, 'mailto:')]" position="replace">
                <a href="mailto:info@adele.example.com" class="nav-link o_nav-link_secondary">
                    <small>
                        <i class="oi oi-fw oi-filled me-1" data-icon="mail"/>
                        info@adele.example.com
                    </small>
                </a>
            </xpath>
        </field>
    </record>
    <record id="option_header_brand_name" model="ir.ui.view">
        <field name="name">Custom - Header Brand Name</field>
        <field name="key">website.option_header_brand_name</field>
        <field name="inherit_id" ref="website.placeholder_header_brand"/>
        <field name="website_id" ref="website_industry"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//*[@id='o_fake_navbar_brand']" position="replace">
                <a href="/" t-attf-class="navbar-brand #{_link_class}" class="navbar-brand mw-100 mx-auto" style="text-align: center;">
                    <span class="display-4-fs text-o-color-1">Adèle</span>
                </a>
            </xpath>
        </field>
    </record>
</odoo>
