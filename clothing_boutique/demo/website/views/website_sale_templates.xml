<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="products_title" model="ir.ui.view">
        <field name="name">Custom - Products Title</field>
        <field name="key">clothing_boutique.products_title</field>
        <field name="inherit_id" ref="website_sale.products"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_wsale_shop_title')]/h1" position="replace">
                <h1 class="h4-fs" style="font-weight: normal;">
                    <span class="display-2-fs">
                        <em>All</em> products</span>
                </h1>
            </xpath>
        </field>
    </record>
    <record id="product_wishlist_title" model="ir.ui.view">
        <field name="name">Custom - Wishlist Title</field>
        <field name="key">clothing_boutique.product_wishlist_title</field>
        <field name="inherit_id" ref="website_sale.product_wishlist"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_wishlist_products_header')]/h1" position="replace">
                <div class="s_hr pt32 pb32 o_colored_level d-lg-block d-none o_snippet_mobile_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                    <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                </div>
                <h1 class="h4-fs mb-0" style="font-weight: normal;">
                    <span class="display-1-fs">
                        <em>My</em> Wishlist</span>
                </h1>
                <div class="s_hr pt32 o_colored_level pb24" data-snippet="s_hr" data-name="Separator">
                    <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
