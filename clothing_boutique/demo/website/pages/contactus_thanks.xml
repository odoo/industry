<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus_thanks" model="ir.ui.view">
        <field name="name">Thanks (Contact us)</field>
        <field name="key">clothing_boutique.page_contactus_thanks</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Thanks (Contact us)" t-name="clothing_boutique.page_contactus_thanks">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block pt80 pb80 o_colored_level o_three_quarter_height" data-snippet="s_text_block" data-name="Thank You Section">
                            <div class="s_allow_columns container">
                                <div class="row o_grid_mode" data-row-count="7">
                                    <div class="o_colored_level o_grid_item g-col-lg-12 g-height-7 col-lg-12" style="text-align: center; grid-area: 1 / 1 / 8 / 13; z-index: 1;">
                                        <i class="oi oi-3x oi-filled mb-3" data-icon="send" role="presentation"/>
                                        <br/>
                                        <h1 class="display-1">Thank You</h1>
                                        <p class="lead">
                                            Your message has been sent.<br/>
                                            We will get back to you shortly.<br/>
                                            <br/>
                                        </p>
                                        <p class="lead">
                                            <a href="/" class="o_translate_inline btn btn-lg btn-primary">Back to Home</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <input t-if="website.plausible_shared_key" type="hidden" class="js_plausible_push" data-event-name="Lead Generation" data-event-params="{&quot;CTA&quot;: &quot;Contact Us&quot;}"/>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus_thanks" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus_thanks"/>
            <field name="url">/contactus-thank-you</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="False"/>
        </record>
    </data>
</odoo>
