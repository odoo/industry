<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_tradition" model="ir.ui.view">
        <field name="name">Tradition</field>
        <field name="key">clothing_boutique.page_tradition</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="clothing_boutique.page_tradition">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty" data-contains-ai-content="true">
                        <section class="s_hero_about o_colored_level pt80 pb64" data-snippet="s_hero_about" data-name="Hero" style="position: relative;">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-6 o_colored_level o_animate o_anim_fade_in order-lg-0 pt48 pb104" style="order: 0;">
                                        <p class="text-uppercase letter-spacing-2 text-muted mb8">French Tradition</p>
                                        <h1 class="display-1 mb24">The <em>heritage</em> behind our collections</h1>
                                        <p class="lead mb32">We honor tradition by blending timeless craftsmanship, thoughtful details, and a sense of continuity across every piece we create.<br/>
                                        <br/>
                                    </p>
                                    <div class="d-flex flex-wrap gap-3">
                                        <a class="o_translate_inline btn btn-lg btn-secondary" href="/shop">Discover the collection</a>
                                        <br/>
                                        <a href="/contactus" class="o_translate_inline btn btn-lg btn-outline-secondary">Talk to us</a>
                                    </div>
                                </div>
                                <div class="pt24 pb24 o_colored_level o_anim_fade_in o_anim_from_bottom o_animate d-lg-block d-none o_snippet_mobile_invisible col-lg-5 offset-lg-1 order-lg-0" style="--wanim-intensity: 1; order: 1;" data-invisible="1">
                                    <img src="/web/image/clothing_boutique.img_clothing_boutique_image_07" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id shadow" style="object-fit: cover; min-height: 420px;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy" data-aspect-ratio="0/0" data-y="276.4096153846153" data-width="768" data-height="985.3596153846153" data-scale-x="1" data-scale-y="1"/>
                                </div>
                                <div class="pt24 pb24 col-lg-5 o_anim_fade_in o_anim_from_bottom o_animate o_colored_level d-lg-none o_snippet_desktop_invisible order-lg-0" style="--wanim-intensity: 1; order: 2;" data-invisible="1">
                                    <img src="/web/image/clothing_boutique.img_clothing_boutique_image_07" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="object-fit: cover; min-height: 420px;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy" data-aspect-ratio="0/0" data-y="276.4096153846153" data-width="768" data-height="985.3596153846153" data-scale-x="1" data-scale-y="1"/>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_closer_look o_colored_level pb32 pt104" data-snippet="s_closer_look" data-name="Tradition details">
                        <div class="container">
                            <h2 class="display-2-fs text-center" style="font-weight: normal;">
                                <span class="o_animated_text o_animate o_anim_fade_in">What tradition means here</span>
                            </h2>
                            <p class="lead text-center mx-auto" style="max-width: 920px;">
                                <span class="o_animated_text o_animate o_anim_fade_in">Tradition is not about standing still. It is about preserving the values that make our business meaningful: quality, consistency, respect for know-how, and the confidence that comes from doing things well, season after season.</span>
                            </p>

                        </div>
                    </section>
                    <section class="s_three_columns o_cc o_cc2 pb32 o_colored_level pt64" data-vxml="001" data-vcss="001" data-snippet="s_three_columns" data-name="Columns">
                        <div class="container">
                            <div class="row d-flex align-items-stretch">
                                <div data-name="Card" class="col-lg-4 pt16 pb16 o_animate o_anim_fade_in">
                                    <div class="s_card o_card_img_top card h-100 o_cc o_cc1 my-0 o_colored_level rounded" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px;">
                                        <figure class="o_card_img_wrapper ratio ratio-16x9 mb-0">
                                            <img src="/web/image/clothing_boutique.img_clothing_boutique_image_08" alt="" class="o_card_img card-img-top o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                        </figure>
                                        <div class="card-body">
                                            <h3 class="h4 mb16">Crafted with care</h3>
                                            <p class="mb0">Each detail is chosen with intention, from fabrics and finishes to the overall silhouette, so the result feels refined and lasting.</p>
                                        </div>
                                    </div>
                                </div>
                                <div data-name="Card" class="col-lg-4 pt16 pb16 o_animate o_anim_fade_in">
                                    <div class="s_card o_card_img_top card h-100 o_cc o_cc1 my-0 o_colored_level rounded" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px;">
                                        <figure class="o_card_img_wrapper ratio ratio-16x9 mb-0">
                                            <img src="/web/image/clothing_boutique.img_clothing_boutique_image_09" alt="" class="o_card_img card-img-top o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                        </figure>
                                        <div class="card-body">
                                            <h3 class="h4 mb16">Rooted in French identity</h3>
                                            <p class="card-text">Our work reflects a clear style language that stays true to who we are, while still feeling relevant and fresh today.</p>
                                        </div>
                                    </div>
                                </div>
                                <div data-name="Card" class="col-lg-4 pt16 pb16 o_animate o_anim_fade_in">
                                    <div class="s_card card h-100 o_cc o_cc1 my-0 o_colored_level o_card_img_top rounded" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px;">
                                        <figure class="o_card_img_wrapper mb-0 ratio ratio-16x9">
                                            <img src="/web/image/clothing_boutique.img_clothing_boutique_image_10" alt="" class="o_card_img o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id card-img-top" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                        </figure>
                                        <div class="card-body">
                                            <h3 class="h4 mb16">Made to endure</h3>
                                            <p class="card-text">Tradition gives our customers something reliable to return to: pieces and values that remain meaningful over time.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>



                    <section class="s_motto pt160 pb160 o_cc o_cc1 o_colored_level" data-snippet="s_motto" data-name="Closing statement">

                        <div class="container">
                            <div class="row">

                                <div class="o_colored_level o_animate o_anim_fade_in offset-lg-2 col-lg-8">
                                    <blockquote class="s_blockquote o_cc o_cc2 o_animable position-relative d-flex flex-column gap-4 w-100 mx-auto p-4 fst-normal o_colored_level s_blockquote_with_icon" data-vcss="001" data-snippet="s_blockquote" data-name="Blockquote">
                                        <div class="s_blockquote_line_elt position-absolute top-0 start-0 bottom-0 bg-o-color-1">
                                            <br/>
                                        </div>
                                        <div class="s_blockquote_wrap_icon position-absolute top-0 start-50 translate-middle w-100">
                                            <i class="oi oi-2x s_blockquote_icon d-block mx-auto rounded bg-o-color-4" data-icon="format_quote" role="img"/>
                                        </div>
                                        <p class="s_blockquote_quote my-auto" style="text-align: center;">
                                            <span class="display-3-fs text-800">
                                                <em>Tradition</em> gives our company its <em>voice</em>, and our customers their <em>trust</em>.
                                            </span>
                                        </p>
                                        <p class="s_blockquote_quote my-auto" style="text-align: center;">
                                            <br/>
                                        </p>
                                        <div class="s_blockquote_infos gap-2 w-100 text-center align-items-center flex-column d-flex">
                                            <img src="/web/image/website.set_avatars_square_md_2" class="s_blockquote_avatar img rounded-circle" alt="" loading="lazy"/>
                                            <div class="s_blockquote_author">
                                                <span class="o_small-fs">
                                                    <strong>Paul Dawson</strong>
                                                    <br/>
                                                    <span class="text-muted">Adèle's founder</span>
                                                </span>
                                            </div>
                                        </div>
                                    </blockquote>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </t>
    </field>
</record>
<data noupdate="1">
    <record id="page_tradition" model="website.page" forcecreate="0">
        <field name="view_id" ref="view_page_tradition"/>
        <field name="url">/tradition</field>
        <field name="website_id" ref="website_industry"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>
</data>
</odoo>
