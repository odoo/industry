#. module: clothing_boutique
#: model_terms:ir.ui.view,arch_db:clothing_boutique.welcome_article_body
msgid ""
"<b>E-Commerce &amp; Website App</b>: Create a stunning online storefront to "
"sell your fashion collections\n"
"                    globally, offering features like \"shop by look\" or "
"dynamic filters."
msgstr ""
"<b>Aplikasi E-Commerce &amp; Website</b>: Buat etalase online menawan untuk "
"menjual koleksi busana Anda\n"
"                    secara global, dengan fitur seperti \"belanja "
"berdasarkan penampilan\" atau filter dinamis."

#. module: clothing_boutique
#: model_terms:ir.ui.view,arch_db:clothing_boutique.welcome_article_body
msgid ""
"<b>Email Marketing App</b>: Engage your customers with personalized "
"newsletters about new collections,\n"
"                    sales, and exclusive style advice."
msgstr ""
"<b>Aplikasi Email Marketing</b>: Jaga komunikasi dengan pelanggan lewat "
"surat kabar khusus tentang koleksi baru,\n"
"                    penjualan, dan saran gaya yang eksklusif."

#. module: clothing_boutique
#: model_terms:ir.ui.view,arch_db:clothing_boutique.welcome_article_body
msgid ""
"<b>Inventory App</b>: Manage complex product matrices (sizes, colors, fits) "
"and use barcode/RFID\n"
"                    scanning for rapid stock counts and transfers."
msgstr ""
"<b>Aplikasi Inventaris</b>: Kelola matriks produk yang kompleks (ukuran, "
"warna, model) dan gunakan pemindaian barcode/RFID\n"
"                    untuk penghitungan stok dan pemindahan stok yang cepat."

#. module: clothing_boutique
#: model_terms:ir.ui.view,arch_db:clothing_boutique.welcome_article_body
msgid ""
"<b>Point of Sale App</b>: Speed up checkout with an intuitive interface that "
"handles product variants,\n"
"                    returns, and customer loyalty program seamlessly."
msgstr ""
"<b>Aplikasi POS</b>: Percepat proses pembayaran dengan antarmuka intuitif "
"yang siap menangani varian produk,\n"
"                    pengembalian barang, dan program loyalitas pelanggan "
"dengan mulus."

#. module: clothing_boutique
#: model_terms:ir.ui.view,arch_db:clothing_boutique.welcome_article_body
msgid ""
"<b>Purchase App</b>: Automate replenishment based on seasonal demand, "
"ensuring you have the right mix of\n"
"                    sizes and styles in stock."
msgstr ""
"<b>Aplikasi Purchase</b>: Otomatiskan pengisian stok berdasarkan permintaan "
"musiman, pastikan Anda memiliki stok yang tepat untuk\n"
"                    kombinasi ukuran dan model."

#. module: clothing_boutique
#: model_terms:ir.ui.view,arch_db:clothing_boutique.welcome_article_body
msgid ""
"<b>Website App</b>: Design a visually appealing brand site that showcases "
"your latest arrivals,\n"
"                    lookbooks, and store locations."
msgstr ""
"<b>Aplikasi Website</b>: Rancang situs brand yang menarik secara visual yang "
"menampilkan produk terbaru,\n"
"                    koleksi penampilan, dan lokasi toko."

