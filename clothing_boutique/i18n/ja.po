#. module: clothing_boutique
#: model_terms:ir.ui.view,arch_db:clothing_boutique.welcome_article_body
msgid ""
"<strong>Centralize document handling:</strong> Use the Documents and Sign "
"apps to manage supplier\n"
"                    agreements."
msgstr ""
"<strong>ドキュメント管理を一元化:</strong> ドキュメントアプリと署名アプリを使"
"って、仕入先との契約書を\n"
"                    管理します。"

#. module: clothing_boutique
#: model_terms:ir.ui.view,arch_db:clothing_boutique.welcome_article_body
msgid "<strong>Click or tap the three dot menu to display features</strong>"
msgstr ""
