<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <record id="sale_order_spreadsheet_2" model="sale.order.spreadsheet">
    <field name="order_id" ref="sale_order_1"/>
    <field name="spreadsheet_binary_data" type="bytes" file="carpenter/static/src/binary/sale_order_spreadsheet/Standard-calculator.osheet.json"/>
    <field name="name">Standard calculator</field>
  </record>
  <function name="write" model="sale.order.spreadsheet">
    <value eval="[ref('carpenter.sale_order_spreadsheet_2', raise_if_not_found=False)]"/>
    <value model="sale.order.spreadsheet" eval="{'spreadsheet_data': obj().env.ref('carpenter.sale_order_spreadsheet_2').spreadsheet_data
      .replace('*product_supplierinfo_1*', str(ref('product_supplierinfo_1')))
    }"/>
  </function>
</odoo>
