        <field name="model_id" ref="crm.model_crm_lead" />
        <field name="ttype">boolean</field>
        <field name="related">company_id.x_crm_checkout_logs</field>
        <field name="readonly" eval="True" />
    </record>
    <record id="field_planning_slot_x_opportunity_name" model="ir.model.fields">
        <field name="name">x_opportunity_name</field>
        <field name="field_description">Opportunity Name</field>
        <field name="model_id" ref="planning.model_planning_slot" />
        <field name="ttype">many2one</field>
        <field name="relation">crm.lead</field>
        <field name="depends">project_id,partner_id</field>
        <field name="compute"><![CDATA[
for record in self:
    p = record.project_id
    lead = p and (p.sale_line_id.order_id.opportunity_id or p.sale_order_id.opportunity_id)
    if not lead and record.partner_id:
        lead = self.env['crm.lead'].search([('partner_id', '=', record.partner_id.id)], limit=1)
    record['x_opportunity_name'] = lead or False
]]>        </field>
    </record>
    <record id="field_sale_order_line_x_select" model="ir.model.fields">
