<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_get_a_quote" model="ir.ui.view">
        <field name="name">Get a Quote</field>
        <field name="key">solar_installation.page_get_a_quote</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="solar_installation.page_get_a_quote">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title o_colored_level pb40 pt136" data-vcss="001" data-snippet="s_title" data-name="Title">
                            <div class="s_allow_columns container">
                                <h2 class="display-3-fs text-center">Request a quote<br/>from Solart Systems</h2>
                                <p class="text-center">
                                    <span class="h5-fs">we usually respond within 24h</span>
                                </p>
                            </div>
                        </section>
                        <section class="s_website_form pt16 o_colored_level pb0" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                            <div class="o_container_small">
                                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-model_name="crm.lead">
                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                        <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name">
                                            <label class="s_website_form_label" style="width: 200px" for="input-name">
                                                <span class="s_website_form_label_content">Name</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="text" name="contact_name" placeholder="" id="input-name" data-fill-with="name" required=""/>
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="tel" data-translated-name="Phone Number">
                                            <label class="s_website_form_label" style="width: 200px" for="input-phone">
                                                <span class="s_website_form_label_content">Phone Number</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="tel" name="phone" value="" placeholder="" id="input-phone" data-fill-with="phone" required=""/>
                                        </div>
                                        <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="email" data-translated-name="Your Email">
                                            <label class="s_website_form_label" style="width: 200px" for="input-email">
                                                <span class="s_website_form_label_content">Email</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="input-email" data-fill-with="email"/>
                                        </div>
                                        <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12" data-type="char" data-translated-name="Your Company">
                                            <label class="s_website_form_label" style="width: 200px" for="input-company">
                                                <span class="s_website_form_label_content">Company name</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="text" name="partner_name" value="" placeholder="" id="input-company" data-fill-with="commercial_company_name"/>
                                            <div class="s_website_form_field_description small form-text text-muted">
                                                <p>Optional</p>
                                            </div>
                                        </div>
                                        <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Your Requirement">
                                            <label class="s_website_form_label" style="width: 200px" for="input-requirement">
                                                <span class="s_website_form_label_content">Your Requirement</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="I want to install 2 kW solar system" id="input-requirement" data-fill-with="undefined"/>
                                        </div>
                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                            <div style="width: 200px;" class="s_website_form_label"/>
                                            <a href="#" role="button" class="btn btn-primary btn-lg s_website_form_send o_default_snippet_text">
                                                <strong>
                                                    <span class="text-gradient" style="background-image: linear-gradient(135deg, rgb(247, 197, 38) 0%, rgb(255, 51, 0) 100%);">Request a quote</span>
                                                </strong>
                                            </a>
                                            <span id="s_website_form_result"/>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level pb96 pt16" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns o_container_small">
                                <p>
                                    <span class="o_small-fs">* Required fields</span>
                                </p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_get_a_quote" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_get_a_quote"/>
            <field name="url">/get-a-quote</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
