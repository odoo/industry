<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="team_form" model="ir.ui.view">
        <field name="name" eval="'website_helpdesk.team_form_%s' % ref('helpdesk_team_1')"/>
        <field name="key" eval="'website_helpdesk.team_form_%s' % ref('helpdesk_team_1')"/>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Helpdesk: Submit a Ticket Form" t-name="website_helpdesk.ticket_submit_form">
                <div class="container">
                    <h2>
                        Submit a Ticket
                        <t t-if="multiple_teams"> - <t t-out="team.name"/></t>
                    </h2>
                    <div class="oe_structure" id="oe_structure_whelpdesk_form_1"/>
                    <span class="hidden" data-for="helpdesk_ticket_form" t-att-data-values="{'team_id': team and team.id or ''}"/>
                    <div id="helpdesk_section" class="">
                        <section class="s_website_form pt16 pb16 o_colored_level" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                            <div class="container">
                                <form id="helpdesk_ticket_form" action="/website/form/" method="post" enctype="multipart/form-data" data-mark="*" data-pre-fill="true" data-success-mode="redirect" data-success-page="/your-ticket-has-been-submitted" data-model_name="helpdesk.ticket" hide-change-model="true" class="o_mark_required">
                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Full Name"><label class="s_website_form_label" style="width: 200px" for="helpdesk1"><span class="s_website_form_label_content">Full Name</span><span class="s_website_form_mark"> *</span></label><input class="form-control s_website_form_input" type="text" name="partner_name" required="" value="" placeholder="" id="helpdesk1" data-fill-with="name"/></div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Phone Number"><label class="s_website_form_label" style="width: 200px" for="helpdesk2"><span class="s_website_form_label_content">Phone Number</span><span class="s_website_form_mark"> *</span></label><input class="form-control s_website_form_input" type="text" name="partner_phone" required="" value="" placeholder="" id="helpdesk2"/></div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="email" data-translated-name="Email Address"><label class="s_website_form_label" style="width: 200px" for="helpdesk3"><span class="s_website_form_label_content">Email Address</span><span class="s_website_form_mark"> *</span></label><input class="form-control s_website_form_input" type="email" name="partner_email" required="" value="" placeholder="" id="helpdesk3" data-fill-with="email"/></div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="char" data-translated-name="Company Name"><label class="s_website_form_label" style="width: 200px" for="helpdesk4"><span class="s_website_form_label_content">Company Name</span></label><input class="form-control s_website_form_input" type="text" name="partner_company_name" value="" placeholder="" id="helpdesk4" data-fill-with="commercial_company_name"/></div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Message Subject"><label class="s_website_form_label" style="width: 200px" for="helpdesk5"><span class="s_website_form_label_content">Message Subject</span><span class="s_website_form_mark"> *</span></label><input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="helpdesk5" data-fill-with="undefined"/></div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="text" data-translated-name="Ask Your Question"><label class="s_website_form_label" style="width: 200px" for="helpdesk6"><span class="s_website_form_label_content">Ask Your Question</span></label><textarea class="form-control s_website_form_input" name="Ask Your Question" placeholder="" id="helpdesk6" rows="3"/></div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="binary" data-translated-name="Attachment"><label class="s_website_form_label" style="width: 200px" for="helpdesk7"><span class="s_website_form_label_content">Attachment</span></label><input type="file" class="form-control s_website_form_input" name="Attachment" id="helpdesk7" data-max-files-number="1" data-max-file-size="1" data-fill-with="undefined"/></div>
                                        <div class="mb-0 py-2 s_website_form_field col-12 s_website_form_dnone" data-name="Field" data-type="record" data-model="helpdesk.team">
                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                                                    <span class="s_website_form_label_content">Helpdesk Team</span>
                                                </label>
                                                <div class="col-sm">
                                                    <input type="hidden" class="form-control s_website_form_input" name="team_id" id="helpdesk8"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                            <div style="width: 200px;" class="s_website_form_label"/>
                                            <a href="#" role="button" class="btn btn-primary btn-lg s_website_form_send">Submit Ticket</a>
                                            <span id="s_website_form_result"/>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </section><p><span class="o_small-fs">* Required fields</span></p>
                    </div>
                </div>
            </t>
        </field>
    </record>

    <record id="team_oe_structure_website_helpdesk_team_3" model="ir.ui.view">
        <field name="name">Custom - Helpdesk Team (oe_structure_website_helpdesk_team_3)</field>
        <field name="key">website_helpdesk.team_oe_structure_website_helpdesk_team_3</field>
        <field name="inherit_id" ref="website_helpdesk.team"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_helpdesk_team_3']" position="replace">
                    <div class="oe_structure" id="oe_structure_website_helpdesk_team_3">
                        <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <p>Fill in the form to ask us anything regarding your past installation or your future project, we'll make sure to help you the best we can!</p><p>Or contact us directly to <a href="mailto:info@solartsystems.odoo.com" class="o_translate_inline">info@solartsystems.odoo.com</a></p>
                            </div>
                        </section>
                    </div>
                </xpath>
        </field>
    </record>
</odoo>
