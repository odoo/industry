<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <!-- No key on purpose: sharing the key of the view we inherit makes
        filter_duplicate() drop that parent, which orphans this view. -->
        <field name="inherit_id" ref="website.footer_copyright_company_name"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2">Copyright © Solart Systems</span>
            </xpath>
        </field>
    </record>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 30px; --box-border-bottom-width: 0px; --box-border-right-width: 30px; --box-border-top-width: 0px; border-left-color: var(--o-color-4) !important; border-bottom-color: var(--o-color-4) !important; border-right-color: var(--o-color-4) !important; border-top-color: var(--o-color-4) !important;">
                    <section class="s_text_block pb16 pt32" data-snippet="s_text_block" data-name="Text">
                        <div class="container">
                            <div class="row">
                                <div class="pb24 o_colored_level col-lg-6 pt8 col-12">
                                    <p class="mb-3">
                                        <a class="me-auto o-float-start-parent" href="/">
                                            <img src="/web/image/solar_installation.img_solar_installation_image_02" alt="" class="img img-fluid o_we_custom_image me-auto float-start" loading="lazy"/>
                                        </a>
                                    </p>
                                </div>
                                <div class="pt24 pb24 o_colored_level col-12 col-lg-2">
                                    <p class="mb-3 small">
                                        <strong>Useful links<br/><br/></strong>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li>
                                            <a href="/products-and-services">Products &amp; Services</a>
                                        </li>
                                        <li>
                                            <a href="/helpdesk">Help</a>
                                        </li>
                                        <li>
                                            <a href="/get-a-quote" class="o_translate_inline">Request a quote</a>
                                        </li>
                                    </ul>
                                </div>
                                <div id="connect" class="pt24 pb24 o_colored_level col-12 col-lg-4">
                                    <p class="mb-3 small">
                                        <strong>Connect with us<br/><br/></strong>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li>
                                            <img src="/web/image/solar_installation.img_solar_installation_image_20" alt="" class="me-2 img img-fluid o_we_custom_image" loading="lazy"/>
                                            <a href="mailto:info@solartsystems.odoo.com">info@solartsystems.odoo.com</a>
                                        </li>
                                        <li>
                                            <img src="/web/image/solar_installation.img_solar_installation_image_21" alt="" class="me-2 img img-fluid o_we_custom_image" loading="lazy"/>
                                            <span class="o_force_ltr">
                                                <a href="tel:+1(079)400-5001" data-bs-original-title="">+1 (079) 400-5001</a>
                                            </span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <!-- No key on purpose: see footer_copyright_company_name -->
        <field name="inherit_id" ref="website.header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr=".//li" position="replace">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/get-a-quote" class="oe_unremovable w-100 oe_edited_link btn btn-primary" data-bs-original-title="">
                                    <span class="text-gradient" style="background-image: linear-gradient(135deg, rgb(247, 197, 38) 0%, rgb(255, 51, 0) 100%);">
                                        <strong>Request a Quote</strong>
                                    </span>
                                </a>
                                <br/>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="header_text_element" model="ir.ui.view">
        <field name="name">Custom - Header Text element</field>
        <!-- No key on purpose: see footer_copyright_company_name -->
        <field name="inherit_id" ref="website.header_text_element"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr=".//li" position="replace">
                <li t-attf-class="#{_item_class}">
                    <t t-if="_txt_elt_content == 'sentence'">
                        <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                            <small>Free Returns and Standard Shipping</small>
                        </div>
                    </t>
                    <t t-elif="_txt_elt_content == 'list'">
                        <div t-attf-class="s_text_block d-flex flex-column flex-lg-row gap-1 gap-lg-4 align-items-lg-center #{_div_class}" data-name="Text">
                            <small class="d-flex align-items-center">
                                <i class="fa fa-1x fa-fw fa-usd fa-stack me-1"/> Low Price Guarantee </small>
                            <small class="d-flex align-items-center">
                                <i class="fa fa-1x fa-fw fa-shopping-basket fa-stack me-1"/> 30 Days Online Returns </small>
                            <small class="d-flex align-items-center">
                                <i class="fa fa-1x fa-fw fa-truck fa-stack me-1"/> Standard Shipping </small>
                        </div>
                    </t>
                    <t t-elif="_txt_elt_content == 'phone_mail'">
                        <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                            <a href="tel:+1 555-555-5556" class="nav-link o_nav-link_secondary">
                                <small>
                                    <img src="/web/image/solar_installation.img_solar_installation_image_21" alt="" class="me-1 img img-fluid o_we_custom_image" loading="lazy"/>
                                    <span class="o_force_ltr">+1 555-555-5556</span>
                                </small>
                            </a>
                            <a href="mailto:info@yourcompany.example.com" class="nav-link o_nav-link_secondary">
                                <small><img src="/web/image/solar_installation.img_solar_installation_image_20" alt="" class="me-1 img img-fluid o_we_custom_image" loading="lazy"/> info@yourcompany.example.com</small>
                            </a>
                        </div>
                    </t>
                    <t t-elif="_txt_elt_content == 'mail'">
                        <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                            <a href="mailto:info@yourcompany.example.com" class="nav-link o_nav-link_secondary">
                                <small><img src="/web/image/solar_installation.img_solar_installation_image_20" alt="" class="me-1 img img-fluid o_we_custom_image" loading="lazy"/> info@yourcompany.example.com</small>
                            </a>
                        </div>
                    </t>
                    <t t-elif="_txt_elt_content == 'mail_stretched'">
                        <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                            <a href="tel:+1 555-555-5556" class="nav-link o_nav-link_secondary p-2 o_navlink_background_hover d-flex align-items-center h-100 text-reset">
                                <img src="/web/image/solar_installation.img_solar_installation_image_21" alt="" class="me-1 img img-fluid o_we_custom_image" loading="lazy"/>
                                <span class="o_force_ltr">
                                    <small>+1 555-555-5556</small>
                                </span>
                            </a>
                        </div>
                    </t>
                    <t t-else="">
                        <div t-attf-class="s_text_block #{_div_class}" data-name="Text" class="s_text_block">
                            <a href="tel:+1(079)400-5001" class="nav-link o_nav-link_secondary p-2">
                                <img src="/web/image/solar_installation.img_solar_installation_image_21" alt="" class="me-1 img img-fluid o_we_custom_image" loading="lazy"/>
                                <span class="o_force_ltr">
                                    <small>
                                        <strong>+1 (079) 400-5001</strong>
                                    </small>
                                </span>
                            </a>
                        </div>
                    </t>
                </li>
            </xpath>
        </field>
    </record>
</odoo>
