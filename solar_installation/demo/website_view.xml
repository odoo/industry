<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="homepage" model="ir.ui.view">
        <field name="name">Home</field>
        <field name="key">solar_installation.homepage</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="arch" type="xml">
            <t name="Homepage" t-name="website.homepage">
                <t t-call="website.layout" pageName.f="homepage">
                    <div id="wrap" class="oe_structure">
                        <section
                            class="s_cover parallax o_cc o_cc5 oe_img_bg pt96 pb48 o_colored_level"
                            data-scroll-background-ratio="0"
                            style="background-image: url('/web/image/solar_installation.ir_attachment_solar_cover');"
                            data-oe-shape-data="{' shape':' html_builder/ Connections/ 01','colors':{'c5':'#FAF0F1'},'flip':[],'showOnMobile':false,'shapeAnimationSpeed':'0','selectedColor':true}"
                            data-snippet="s_cover" data-name="Cover">
                            <div class="o_we_bg_filter bg-black-50" />
                            <div
                                class="o_we_shape o_html_builder_Connections_01 o_header_extra_shape_mapping"
                                style="background-image: url('/html_editor/shape/html_builder/Connections/01.svg?c5=%23FAF0F1');" />
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-7 pb56 o_colored_level">
                                        <h1 class="fw-bold display-4">Making a sustainable difference.</h1>
                                        <p class="lead"> Our mission is to provide customers with
                                            the best renewable energy solutions. <br />
                                            Comprehensive resources &amp; guides, an engaged
                                            community, <br /> 24/7 support make it a pleasure to
                                            work with us. </p>
                                        <p>
                                            <a class="btn btn-primary btn-lg rounded-0 o_translate_inline"
                                                href="/contact_us">Contact us</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_image pb96 pt0 o_colored_level"
                            data-oe-shape-data="{' shape':'html_builder/ Bold/ 15','colors':{'c5':'#FAF0F1'},'flip':[],'showOnMobile':false,'shapeAnimationSpeed':'0','selectedColor':true}"
                            data-snippet="s_text_image"
                            data-name="Text - Image">
                            <div class="o_we_shape o_html_builder_Bold_15"
                                style="background-image: url('/html_editor/shape/html_builder/Bold/15.svg?c5=%23FAF0F1');" />
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-5 pt16 pb16 offset-lg-1 o_colored_level">
                                        <h2>Unique experiences to promote renewable energy</h2>
                                        <div class="s_hr pt16 pb0" data-snippet="s_hr"
                                            data-name="Separator">
                                            <hr class="w-100 mx-auto"
                                                style="border-top-color: rgba(0, 0, 0, 0) !important;" />
                                        </div>
                                        <p> Users are eager to adopt green energy solutions. <br />
                                            We empower our teams to create impactful initiatives. </p>
                                        <p>We have one goal in mind, environmental sustainability.</p>
                                    </div>
                                    <div class="offset-lg-1 pt16 pb16 col-lg-4 o_colored_level">
                                        <img
                                            src="/web/image/solar_installation.ir_attachment_iphone_svg"
                                            class="img img-fluid mx-auto rounded" alt=""
                                            data-shape="html_builder/devices/iphone_3d_portrait_02"
                                            data-shape-colors=";;;;#FAF0F1" loading="lazy" />
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_mockup_image o_cc o_cc1 pt96 pb96 o_colored_level"
                            data-oe-shape-data="{' shape':'html_builder/ Bold/ 13','colors':{'c5':'#FAF0F1'},'flip':[],'showOnMobile':false,'shapeAnimationSpeed':'0','selectedColor':true}"
                            data-snippet="s_mockup_image"
                            data-name="Mockup Image">
                            <div class="o_we_shape o_html_builder_Bold_13"
                                style="background-image: url('/html_editor/shape/html_builder/Bold/13.svg?c5=%23FAF0F1');" />
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="pt16 pb16 col-lg-5 o_colored_level">
                                        <h2>The Innovation Behind Our Renewable Services</h2>
                                        <p>We offer a range of renewable energy services, from solar
                                            panel installations to energy efficiency consulting. Our
                                            goal is to help you transition to a sustainable future.</p>
                                        <p>Start with the environment – find out what it needs and
                                            provide it with sustainable energy.</p>
                                    </div>
                                    <div class="pt16 pb16 offset-lg-1 col-lg-6 o_colored_level">
                                        <img
                                            src="/web_editor/image_shape/solar_installation.ir_attachment_solar_cover/web_editor/devices/macbook_front.svg"
                                            class="img-fluid ms-auto o_we_custom_image"
                                            data-shape="web_editor/devices/macbook_front"
                                            data-shape-colors=";;#F3F2F2;;"
                                            data-format-mimetype="image/svg+xml"
                                            data-original-src="/web/image/solar_installation.ir_attachment_solar_cover"
                                            alt="" loading="lazy" />
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_references o_cc o_cc1 pt96 pb96 o_colored_level"
                            data-oe-shape-data="{' shape':'html_builder/ Bold/ 13','colors':{'c5':'#FAF0F1'},'flip':[],'showOnMobile':false,'shapeAnimationSpeed':'0','selectedColor':true}"
                            data-snippet="s_references"
                            data-name="References">
                            <div
                                class="o_we_shape o_html_builder_Bold_13 o_footer_extra_shape_mapping"
                                style="background-image: url('/html_editor/shape/html_builder/Bold/13.svg?c5=%23FAF0F1&amp;flip=xy'); background-position: 50% 0%;" />
                            <div class="container">
                                <h2 style="text-align: center;">Partners</h2>
                                <p>
                                    <br />
                                </p>
                                <div class="row">
                                    <div class="col-6 col-lg-2 pt16 pb16 o_colored_level">
                                        <img src="/web/image/website.s_reference_demo_image_1"
                                            class="img img-fluid mx-auto" alt="" loading="lazy" />
                                    </div>
                                    <div class="col-6 col-lg-2 pt16 pb16 o_colored_level">
                                        <img src="/web/image/website.s_reference_demo_image_2"
                                            class="img img-fluid mx-auto" alt="" loading="lazy" />
                                    </div>
                                    <div class="col-6 col-lg-2 pt16 pb16 o_colored_level">
                                        <img src="/web/image/website.s_reference_demo_image_3"
                                            class="img img-fluid mx-auto" alt="" loading="lazy" />
                                    </div>
                                    <div class="col-6 col-lg-2 pt16 pb16 o_colored_level">
                                        <img src="/web/image/website.s_reference_demo_image_4"
                                            class="img img-fluid mx-auto" alt="" loading="lazy" />
                                    </div>
                                    <div class="col-6 col-lg-2 pt16 pb16 o_colored_level">
                                        <img src="/web/image/website.s_reference_demo_image_5"
                                            class="img img-fluid mx-auto" alt="" loading="lazy" />
                                    </div>
                                    <div class="col-6 col-lg-2 pt16 pb16 o_colored_level">
                                        <img src="/web/image/website.s_reference_default_image_6"
                                            class="img img-fluid mx-auto" alt="" loading="lazy" />
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <record id="ir_ui_view_3356" model="ir.ui.view">
        <field name="name">Header Call to Action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="key">website.header_call_to_action</field>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="arch" type="xml">
            <data inherit_id="website.placeholder_header_call_to_action" name="Header Call to Action" active="True">
                <xpath expr="." position="inside">
                    <li t-attf-class="#{_item_class}">
                        <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                            <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text" style="background-image: none;">
                                <div class="container">
                                    <a href="/contact_us" class="oe_unremovable btn_cta w-100 oe_edited_link btn btn-primary rounded-0" data-bs-original-title="">Contact Us</a>
                                    <br/>
                                </div>
                            </section>
                        </div>
                    </li>
                </xpath>
            </data>
        </field>
    </record>
    <record id="ir_ui_view_2702" model="ir.ui.view">
        <field name="name">Default</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="key">website.footer_custom</field>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="arch" type="xml">
            <data inherit_id="website.layout" name="Default" active="True">
                <xpath expr="//div[@id='footer']" position="replace">
                    <div id="footer" class="oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer">
                        <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Text" style="background-image: none;">
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-2 pt24 pb24 o_colored_level">
                                        <h5 class="mb-3">Useful Links</h5>
                                        <ul class="list-unstyled">
                                            <li>
                                                <a href="/">Home</a>
                                            </li>
                                            <li>
                                                <a href="/contactus">Contact us</a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="col-lg-5 pt24 pb24 o_colored_level">
                                        <h5 class="mb-3">About us</h5>
                                        <p>We are a team of passionate people whose goal is to improve everyone's life through disruptive products. We build great products to solve your business problems.</p>
                                    </div>
                                    <div id="connect" class="col-lg-4 offset-lg-1 pt24 pb24 o_colored_level">
                                        <h5 class="mb-3">Connect with us</h5>
                                        <ul class="list-unstyled">
                                            <li>
                                                <i class="fa fa-comment fa-fw me-2"/>
                                                <span>
                                                    <a href="/contactus">Contact us</a>
                                                </span>
                                            </li>
                                            <li>
                                                <i class="fa fa-envelope fa-fw me-2"/>
                                                <span>
                                                    <span style="color: rgb(55, 65, 81);font-size: 14px;font-style: normal;font-weight: 400;background-color: rgb(255, 255, 255)">info@yourcompany.example.com</span>
                                                </span>
                                            </li>
                                            <li>
                                                <i class="fa fa-phone fa-fw me-2"/>
                                                <span class="o_force_ltr">
                                                    <a href="tel:+1(079)400-5001" data-bs-original-title="">+1 (079) 400-5001</a>
                                                </span>
                                            </li>
                                        </ul>
                                        <div class="s_social_media text-start o_not_editable" data-snippet="s_social_media" data-name="Social Media">
                                            <h5 class="s_social_media_title d-none">Follow us</h5>
                                            <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank">
                                                <i class="fa fa-facebook rounded-circle shadow-sm"/>
                                            </a>
                                            <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank">
                                                <i class="fa fa-twitter rounded-circle shadow-sm"/>
                                            </a>
                                            <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank">
                                                <i class="fa fa-linkedin rounded-circle shadow-sm"/>
                                            </a>
                                            <a href="/" class="text-800">
                                                <i class="fa fa-home rounded-circle shadow-sm"/>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </xpath>
            </data>
        </field>
    </record>
    <record id="template_footer_centered" model="ir.ui.view">
        <field name="name">Centered Logo</field>
        <field name="inherit_id" ref="website.template_footer_centered"/>
        <field name="key">solar_installation.template_footer_centered_logo</field>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="arch" type="xml">
            <xpath expr="//a[hasclass('o_footer_logo')]/img" position="replace">
                <img src="/solar_installation/static/description/icon.png" class="img-fluid d-block mx-auto" aria-label="Logo of MyCompany" title="MyCompany" role="img"/>
            </xpath>
        </field>
    </record>
    <record id="ir_ui_view_2704" model="ir.ui.view">
        <field name="name">footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="arch" type="xml">
            <data inherit_id="website.layout">
                <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                    <span class="o_footer_copyright_name me-2">Copyright ©&amp; Sun Power Solar Services</span>
                </xpath>
            </data>
        </field>
    </record>
    <record id="ir_ui_view_3265" model="ir.ui.view">
        <field name="name">Helpdesk Team (oe_structure_website_helpdesk_team_3)</field>
        <field name="inherit_id" ref="website_helpdesk.team"/>
        <field name="key">website_helpdesk.team_oe_structure_website_helpdesk_team_3</field>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_helpdesk_team_3']" position="replace">
                    <div class="oe_structure" id="oe_structure_website_helpdesk_team_3">
                        <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block" data-name="Text" style="background-image: none;">
                            <div class="s_allow_columns container">
                                <p>Mail to&amp; </p>
                                <table class="table table-bordered">
                                    <tbody>
                                        <tr>
                                            <td>
                                                <a href="mailto:info@yourcompany.example.com">info@yourcompany.example.com</a>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </div>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
