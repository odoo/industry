<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="helpdesk_team_1" model="helpdesk.team">
        <field name="name">Solart Systems Support</field>
        <field name="use_credit_notes" eval="True"/>
        <field name="use_product_returns" eval="True"/>
        <field name="use_product_repairs" eval="True"/>
        <field name="website_id" ref="website_industry"/>
    </record>
    <!-- Superseded by helpdesk_team_1 above: deactivate the generic default
         team so it doesn't clutter the Helpdesk app or steal ticket/alias
         routing meant for the industry-specific team. -->
    <record id="helpdesk.helpdesk_team1" model="helpdesk.team" forcecreate="0">
        <field name="active" eval="False"/>
    </record>
</odoo>
