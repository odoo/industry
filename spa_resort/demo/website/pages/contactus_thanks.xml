<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus_thanks" model="ir.ui.view">
        <field name="name">Thanks (Contact us)</field>
        <field name="key">spa_resort.page_contactus_thanks</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Thanks (Contact us)" t-name="spa_resort.page_contactus_thanks">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_adventure o_cc o_cc1 oe_img_bg o_bg_img_center o_colored_level o_bg_img_origin_border_box pt136 pb56 s_custom_snippet" style="background-image: url(&quot;/web/image/spa_resort.img_spa_resort_image_01&quot;);" data-snippet="s_adventure" data-format-mimetype="image/webp" data-resize-width="1500" data-mimetype="image/webp" data-name="Custom Adventure">
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(rgb(13, 34, 24) 0%, rgba(13, 34, 24, 0.9) 50%, rgb(13, 34, 24) 100%);"/>
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-12">
                                        <h1 class="display-1" style="text-align: center;"><span class="display-4-fs">thank you</span></h1>
                                        <h2 style="text-align: center;">We received your message</h2>
                                    </div>
                                    <div class="o_colored_level col-lg-6 offset-lg-3">
                                        <p class="lead" style="text-align: center;">We will get back to you as soon as possible.</p>
                                        <p class="lead" style="text-align: center;"><br/></p>
                                        <p class="lead" style="text-align: center;"><a href="/" class="o_translate_inline btn btn-secondary">Back to Home</a></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <input t-if="website.plausible_shared_key" type="hidden" class="js_plausible_push" data-event-name="Lead Generation" data-event-params="{&quot;CTA&quot;: &quot;Contact Us&quot;}"/>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus_thanks" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus_thanks"/>
            <field name="url">/contactus-thank-you</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="False"/>
        </record>
    </data>
</odoo>
