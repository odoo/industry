<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_wellness_access" model="ir.ui.view">
        <field name="name">Wellness Access</field>
        <field name="key">spa_resort.page_wellness_access</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="spa_resort.page_wellness_access">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_adventure o_cc o_cc1 oe_img_bg o_bg_img_center o_colored_level o_bg_img_origin_border_box pt136 pb56" style="background-image: url(&quot;/web/image/spa_resort.img_spa_resort_image_01&quot;);" data-snippet="s_adventure" data-name="Adventure" data-format-mimetype="image/webp" data-resize-width="1500" data-mimetype="image/webp">
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(rgb(13, 34, 24) 0%, rgba(13, 34, 24, 0.9) 50%, rgb(13, 34, 24) 100%);"/>
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-12">
                                        <h1 class="display-1" style="text-align: center;"><span class="display-4-fs">thermal escapes</span></h1>
                                        <h2 style="text-align: center;">SUSPENDED IN WARMTH, WATER &amp;amp; STILLNESS</h2>
                                    </div>
                                    <div class="o_colored_level col-lg-6 offset-lg-3">
                                        <p class="lead" style="text-align: center;">From day escapes to secluded lodge stays, with unrestricted thermal bath access, private linen lounges, and slow botanical refreshments.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_key_benefits pt48 o_colored_level s_custom_snippet pb80" data-snippet="s_key_benefits" data-name="Custom Key benefits">
                            <div class="container">
                                <div class="row o_grid_mode" style="gap: 20px 30px;" data-row-count="13">
                                    <div class="o_grid_item o_colored_level order-lg-0 g-height-2 offset-1 offset-lg-0 col-10 g-col-lg-12 col-lg-12" style="grid-area: 1 / 1 / 3 / 13; z-index: 1; order: 0;">
                                        <h2>THE 3 THERMAL STAYS</h2>
                                    </div>
                                    <div class="o_colored_level o_grid_item g-col-lg-4 border rounded o_cc o_cc3 o_animate o_anim_fade_in o_anim_from_right col-lg-4 g-height-11 offset-1 offset-lg-0 col-10 order-lg-0" style="grid-area: 3 / 1 / 14 / 5; z-index: 2; --grid-item-padding-y: 30px; --grid-item-padding-x: 30px; --box-border-bottom-left-radius: 30px; --box-border-bottom-right-radius: 30px; --box-border-top-right-radius: 30px; --box-border-top-left-radius: 30px; background-image: linear-gradient(200deg, rgb(15, 42, 29) 15%, rgb(13, 34, 24) 45%, rgb(15, 42, 29) 90%); --wanim-intensity: 10; animation-delay: 0.1s; order: 1; border-color: rgba(214, 193, 156, 0.2) !important;">
                                        <p class="small"><span class="text-o-color-3"><img src="/web/image/spa_resort.img_spa_resort_image_23" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id o_animate_on_hover" data-hover-effect="image_zoom_in" data-hover-effect-color="rgba(0, 0, 0, 0)" data-hover-effect-intensity="20" data-format-mimetype="image/webp" data-resize-width="64" data-mimetype="image/svg+xml" loading="lazy" src.translate="/web/image/spa_resort.img_spa_resort_image_23"/></span></p>
                                        <p class="small"><span class="text-o-color-3">&amp;nbsp;</span></p>
                                        <p class="small"><span class="text-o-color-3">THERMAL ESCAPE</span></p>
                                        <h3>THE THERMAL IMMERSION<br/>
                    </h3>
                                        <p>A gentle initiation into high-mineral waters and aromatic steam chambers. Designed to unclutter mental static and soothe muscular tension.</p>
                                        <div class="s_hr pt24 pb32" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <ul>
                                            <li>Access to hot springs, cold plunge, thermal bathhouse &amp;amp; infrared stone benches</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Eucalyptus botanical vapor inhalation suite</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Organic artisanal herbal infusions</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Heated thermal linen robe &amp;amp; slipper ritual</li>
                                        </ul>
                                        <div class="s_hr pt80 pb24" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <p class="lead"><span class="h3-fs text-white">45€</span><span class="h4-fs"> </span><span class="h6-fs">/ guest</span></p>
                                        <p style="text-align: end;"><a href="/appointment/*appointment_type_4*" class="o_translate_inline btn btn-secondary">BOOK STAY</a></p>
                                    </div>
                                    <div class="o_grid_item o_colored_level o_animate o_anim_fade_in order-lg-0 g-height-2 col-lg-4 g-col-lg-2 col-lg-2" style="z-index: 6; grid-area: 3 / 7 / 5 / 9; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; order: 2; text-align: end;">
                                        <span class="s_badge badge text-bg-secondary o_animable o_rfs" data-name="Badge" data-vxml="001" data-snippet="s_badge" style="font-size: clamp(8px, 1em + -0.2770vw, 400px);">&amp;nbsp; SANCTUARY SIGNATURE&amp;nbsp;&amp;nbsp;</span>
                                    </div>
                                    <div class="o_grid_item g-col-lg-4 border rounded o_cc o_cc3 o_colored_level o_animate o_anim_fade_in col-lg-4 offset-1 offset-lg-0 col-10 order-lg-0 g-height-11" style="z-index: 5; --grid-item-padding-y: 30px; --grid-item-padding-x: 30px; --box-border-bottom-left-radius: 30px; --box-border-bottom-right-radius: 30px; --box-border-top-right-radius: 30px; --box-border-top-left-radius: 30px; background-image: linear-gradient(200deg, rgb(15, 42, 29) 15%, rgb(13, 34, 24) 45%, rgb(15, 42, 29) 90%); grid-area: 3 / 5 / 14 / 9; order: 3; border-left-color: var(--o-color-3) !important; border-bottom-color: var(--o-color-3) !important; border-right-color: var(--o-color-3) !important; border-top-color: var(--o-color-3) !important;">
                                        <p class="small"><span class="text-o-color-3"><img src="/web/image/spa_resort.img_spa_resort_image_24" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id o_animate_on_hover" data-hover-effect="image_zoom_in" data-hover-effect-color="rgba(0, 0, 0, 0)" data-hover-effect-intensity="20" data-format-mimetype="image/webp" data-resize-width="64" data-mimetype="image/svg+xml" loading="lazy" src.translate="/web/image/spa_resort.img_spa_resort_image_24"/></span></p>
                                        <p class="small"><span class="text-o-color-3">&amp;nbsp;</span></p>
                                        <p class="small"><span class="text-o-color-3">DEEP GRAVITATIONAL RESTORATION</span><br/></p>
                                        <h3>THE SENSORY FLOATATION<br/>
                    </h3>
                                        <p>Centering on zero-gravity magnesium Epsom pools. Enter a state of pure weightlessness where physical tension and time peacefully disconnect.</p>
                                        <div class="s_hr pt24 pb32" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <ul>
                                            <li>60-min private magnesium float pod session</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Access to hot springs, cold plunge, thermal bathhouse &amp;amp; infrared stone benches</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Eucalyptus botanical vapor inhalation suite</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Organic artisanal herbal infusions</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Heated thermal linen robe &amp;amp; slipper ritual</li>
                                        </ul>
                                        <div class="s_hr pb24 pt40" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <p class="lead"><span class="h3-fs text-white">60€</span><span class="h4-fs"> </span><span class="h6-fs">/ guest</span></p>
                                        <p style="text-align: end;"><a href="/appointment/*appointment_type_5*" class="o_translate_inline btn btn-primary">BOOK STAY</a></p>
                                    </div>
                                    <div class="o_grid_item g-col-lg-4 border rounded o_cc o_cc3 o_colored_level o_animate o_anim_fade_in o_anim_from_left col-lg-4 offset-1 offset-lg-0 col-10 order-lg-0 g-height-11" style="z-index: 4; --grid-item-padding-y: 30px; --grid-item-padding-x: 30px; --box-border-bottom-left-radius: 30px; --box-border-bottom-right-radius: 30px; --box-border-top-right-radius: 30px; --box-border-top-left-radius: 30px; background-image: linear-gradient(200deg, rgb(15, 42, 29) 15%, rgb(13, 34, 24) 45%, rgb(15, 42, 29) 90%); grid-area: 3 / 9 / 14 / 13; --wanim-intensity: 10; animation-delay: 0.1s; order: 4; border-color: rgba(214, 193, 156, 0.2) !important;">
                                        <p class="small"><span class="text-o-color-3"><img src="/web/image/spa_resort.img_spa_resort_image_25" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id o_animate_on_hover" data-hover-effect="image_zoom_in" data-hover-effect-color="rgba(0, 0, 0, 0)" data-hover-effect-intensity="20" data-format-mimetype="image/webp" data-resize-width="64" data-mimetype="image/svg+xml" loading="lazy" src.translate="/web/image/spa_resort.img_spa_resort_image_25"/></span></p>
                                        <p class="small"><span class="text-o-color-3">&amp;nbsp;</span></p>
                                        <p class="small"><span class="text-o-color-3">PRIVATE OASIS LODGE</span><br/></p>
                                        <h3>THE NIGHTFALL SANCTUARY<br/>
                    </h3>
                                        <p>An intimate lodge retreat. Unhindered access to cedar hot springs, a private lodge suite, and sensory pool.</p>
                                        <div class="s_hr pt24 pb32" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <ul>
                                            <li>Secluded lodge with its own sensory pool</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Access to the entire spa all your stay</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Candlelit access to the outdoor thermal spring</li>
                                            <li class="oe-nested"><br/></li>
                                            <li>Heated thermal linen robe &amp;amp; slipper ritual</li>
                                        </ul>
                                        <div class="s_hr pb24 pt40" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <p class="lead"><span class="h3-fs text-white">190€</span><span class="h4-fs"> </span><span class="h6-fs">/ stay</span></p>
                                        <p style="text-align: end;"><a href="/appointment/*appointment_type_6*" class="o_translate_inline btn btn-secondary">BOOK STAY</a></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_call_to_action o_cc pt64 pb64 o_colored_level o_cc1 s_custom_snippet" data-snippet="s_call_to_action" data-name="Custom Call to Action">
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="3">
                                    <div class="o_colored_level o_grid_item g-height-3 g-col-lg-5 col-lg-5 offset-1 offset-lg-0 col-10" style="grid-area: 1 / 3 / 4 / 8; z-index: 1;">
                                        <h3><span style="font-size: 32px;">10-ENTRY PASS<br/>THERMAL IMMERSION</span></h3>
                                        <p>Make stillness a sacred habit. Enjoy 10 restorative thermal escapes at your own pace.</p>
                                    </div>
                                    <div class="o_colored_level o_grid_item g-height-2 g-col-lg-3 col-lg-3 col-11" style="grid-area: 2 / 9 / 4 / 12; z-index: 2;">
                                        <p style="text-align: right;">
                                            <a class="o_translate_inline btn btn-primary" href="*product_product_21_url*">GET THE 10-ENTRY PASS</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <div class="s_hr o_colored_level pb0 pt88" data-snippet="s_hr" data-name="Separator">
                            <hr class="w-100 mx-auto" style="border-top-color: rgba(214, 193, 156, 0.2);"/>
                        </div>
                        <section class="s_text_block pt96 o_colored_level o_cc o_cc4 pb56" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <div class="row o_grid_mode" data-row-count="5">
                                    <div class="o_grid_item o_grid_item_image o_colored_level g-col-lg-2 g-height-1 col-lg-2 o_grid_item_image_contain order-lg-0 offset-lg-0 offset-5 col-2" style="z-index: 2; grid-area: 1 / 6 / 2 / 8; --grid-item-padding-y: 5px; order: 0; --grid-item-padding-x: 30px;">
                                        <img src="/web/image/spa_resort.img_spa_resort_image_26" alt="" class="img img-fluid o_we_custom_image o_editable_media" data-format-mimetype="image/webp" data-resize-width="64" data-mimetype="image/webp" loading="lazy" src.translate="/web/image/spa_resort.img_spa_resort_image_26"/>
                                    </div>
                                    <div class="o_colored_level o_grid_item g-col-lg-6 g-height-4 col-12 col-lg-6 order-lg-0" style="z-index: 1; grid-area: 2 / 4 / 6 / 10; order: 1;">
                                        <p class="small" style="text-align: center;"><br/></p>
                                        <p style="text-align: center;"><span class="h4-fs">"In the suspension of warm mist and mineral brine, the body ceases to resist, and the passage of time becomes an echo."</span></p>
                                        <p style="text-align: center;"><br/></p>
                                        <p style="text-align: center;"><span class="base-fs"><span class="text-o-color-3">HAZE SPRINGS SANCTUARY ETHOS</span></span><br/></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value eval="[ref('view_page_wellness_access')]"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('spa_resort.view_page_wellness_access').arch.replace(
                '*appointment_type_4*', str(obj().env.ref('spa_resort.appointment_type_4').id)).replace(
                '*appointment_type_5*', str(obj().env.ref('spa_resort.appointment_type_5').id)).replace(
                '*appointment_type_6*', str(obj().env.ref('spa_resort.appointment_type_6').id)).replace(
                '*product_product_21_url*', obj().env.ref('spa_resort.product_product_21').website_url)
            }"/>
    </function>
    <data noupdate="1">
        <record id="page_wellness_access" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_wellness_access"/>
            <field name="url">/wellness-access</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
