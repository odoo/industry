<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/wellness-access" class="oe_unremovable btn btn-secondary">BOOK NOW</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action_large" model="ir.ui.view">
        <field name="name">Header Call to Action - Large</field>
        <field name="key">website.header_call_to_action_large</field>
        <field name="inherit_id" ref="header_call_to_action"/>
        <field name="mode">primary</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//a[hasclass('oe_unremovable')]" position="attributes">
                <attribute name="class" add="w-100" separator=" "/>
            </xpath>
            <xpath expr="." position="attributes">
                <attribute name="t-name">website.header_call_to_action_large</attribute>
            </xpath>
        </field>
    </record>
    <record id="template_footer_minimalist" model="ir.ui.view">
        <field name="name">Minimalist</field>
        <field name="key">website.template_footer_minimalist</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; border-color: rgba(214, 193, 156, 0.2) !important;">
                    <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                        <div class="container-fluid">
                            <div class="row o_grid_mode" data-row-count="4">
                                <div class="o_colored_level o_grid_item o_grid_item_image g-col-lg-2 g-height-3 col-lg-2 o_grid_item_image_contain order-lg-0 offset-lg-0 col-4 offset-4" style="z-index: 2; grid-area: 1 / 6 / 4 / 8; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; order: 0;">
                                    <a href="/" class="o_footer_logo logo">
                                        <img src="/web/image/spa_resort.img_spa_resort_image_07" alt="Haze Springs" class="img-fluid d-block mx-auto o_editable_media img o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="1000" data-mimetype="image/webp" data-aspect-ratio="0/0" data-y="111.16977267795139" data-width="1000" data-height="657.1148681640625" data-scale-x="1" data-scale-y="1" loading="lazy" src.translate="/web/image/spa_resort.img_spa_resort_image_07"/>
                                    </a>
                                </div>
                                <div class="o_colored_level o_grid_item g-col-lg-2 g-height-1 col-lg-2 order-lg-0 col-12" style="z-index: 4; grid-area: 4 / 6 / 5 / 8; order: 1; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px;">
                                    <div class="s_social_media o_not_editable no_icon_color text-center" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi oi-stack o_editable_media" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="oi oi-stack o_editable_media" data-icon="oi_x"/>
                                        </a>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank" aria-label="Instagram">
                                            <i class="oi oi-stack o_editable_media" data-icon="oi_instagram"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_grid_item g-height-2 o_colored_level g-col-lg-2 col-lg-2 col-12 d-lg-block d-none o_snippet_mobile_invisible order-lg-0" style="z-index: 6; grid-area: 3 / 2 / 5 / 4; order: 2;" data-invisible="1">
                                    <div>Rue des Bourlottes 9,</div>
                                    <p>1367 Ramillies</p>
                                    <p>+1 555-555-5556</p>
                                </div>
                                <div class="o_grid_item g-col-lg-2 col-lg-2 o_colored_level col-12 d-lg-block d-none o_snippet_mobile_invisible g-height-2 order-lg-0" style="z-index: 7; grid-area: 3 / 10 / 5 / 12; order: 3;" data-invisible="1">
                                    <p class="text-end">Monday - Friday: 10 AM - 10 PM</p>
                                    <p class="text-end">Weekends: 9 AM - 11 PM</p>
                                </div>
                                <div class="o_grid_item g-col-lg-1 g-height-1 col-lg-1 o_colored_level order-lg-0 col-6" style="z-index: 9; grid-area: 4 / 5 / 5 / 6; order: 4; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px;">
                                    <p class="text-center"><a href="/wellness-access" class="o_translate_inline">WELLNESS</a></p>
                                </div>
                                <div class="o_grid_item o_colored_level g-col-lg-1 g-height-1 col-lg-1 order-lg-0 col-6" style="z-index: 8; grid-area: 4 / 8 / 5 / 9; order: 5; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px;">
                                    <p class="text-center"><a href="/massages-treatments" class="o_translate_inline">MASSAGES</a></p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
