<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="appointment_info" model="ir.ui.view">
        <field name="name">Haze Springs - Appointment Info</field>
        <field name="inherit_id" ref="appointment.appointment_info" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_appointments_info_1']" position="replace">
                <div class="oe_structure oe_empty" id="oe_structure_appointments_info_1" data-editor-message="Drag blocks here to add them on all appointments">
                    <section class="s_adventure o_cc o_cc1 oe_img_bg o_bg_img_center o_colored_level o_bg_img_origin_border_box s_custom_snippet pt112 pb72" style="background-image: url(&quot;/web/image/spa_resort.img_spa_resort_image_01&quot;);" data-snippet="s_adventure" data-format-mimetype="image/webp" data-resize-width="1500" data-mimetype="image/webp" data-name="Custom Adventure">
                        <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(rgb(13, 34, 24) 0%, rgba(13, 34, 24, 0.9) 50%, rgb(13, 34, 24) 100%);" />
                        <div class="s_allow_columns container">
                            <div class="row o_grid_mode" data-row-count="3">
                                <div class="o_grid_item o_colored_level g-height-3 g-col-lg-6 col-lg-6" style="grid-area: 1 / 4 / 4 / 10; z-index: 1;">
                                    <p class="small text-center">
                                        <span class="base-fs text-o-color-3">RESERVE YOUR SANCTUARY EXPERIENCE</span>
                                    </p>
                                    <p class="lead text-center">
                                        <span class="text-white">
                                            <span class="h4-fs">Time slows where water meets mist. From thermal escapes and zero-gravity floatation to deeply grounding massage rituals, schedule your visit below.</span>
                                        </span>
                                        <br />
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_appointments_info_3']" position="replace">
                <div class="oe_structure oe_empty" id="oe_structure_appointments_info_3" data-editor-message="Drag blocks here to add them on all appointments">
                    <div class="s_hr o_colored_level o_cc o_cc1 pt128 d-lg-block d-none o_snippet_mobile_invisible pb24" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                        <hr class="w-75 mx-auto" />
                    </div>
                    <section class="s_key_benefits o_colored_level s_custom_snippet o_cc o_cc1 pb104 pt72" data-snippet="s_key_benefits" data-name="Custom Custom Key benefits (2)">
                        <div class="container">
                            <div class="row o_grid_mode" style="gap: 20px 30px;" data-row-count="5">
                                <div class="o_grid_item o_colored_level g-col-lg-12 col-lg-12 g-height-2" style="grid-area: 1 / 1 / 3 / 13; z-index: 1;">
                                    <p class="small text-center">
                                        <span class="text-o-color-3">PEACE OF MIND</span>
                                    </p>
                                    <h2 class="text-center">PREPARING FOR YOUR JOURNEY</h2>
                                </div>
                                <div class="o_colored_level o_grid_item border rounded g-col-lg-3 g-height-3 col-lg-3 offset-1 offset-lg-0 col-10" style="z-index: 2; --box-border-bottom-left-radius: 30px; --box-border-bottom-right-radius: 30px; --box-border-top-right-radius: 30px; --box-border-top-left-radius: 30px; --grid-item-padding-x: 15px; --grid-item-padding-y: 15px; grid-area: 3 / 1 / 6 / 4; border-color: rgba(214, 193, 156, 0.2) !important;">
                                    <p class="small">
                                        <img src="/web/image/spa_resort.img_spa_resort_image_03" alt="" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="64" data-mimetype="image/webp" style="width: 15.67%; height: auto;" loading="lazy" />
                                    </p>
                                    <h3>
                                        <span class="h4-fs">15-MINUTE QUIET ARRIVAL</span>
                                    </h3>
                                    <p>
                                        <span style="color: rgba(229, 217, 197, 0.8);">Please arrive 15 minutes prior to appointment time to settle into your suite unhurried.</span>
                                    </p>
                                </div>
                                <div class="o_grid_item border rounded g-col-lg-3 o_colored_level col-lg-3 g-height-3 offset-1 offset-lg-0 col-10" style="z-index: 3; --box-border-bottom-left-radius: 30px; --box-border-bottom-right-radius: 30px; --box-border-top-right-radius: 30px; --box-border-top-left-radius: 30px; --grid-item-padding-y: 15px; --grid-item-padding-x: 15px; border-color: rgba(214, 193, 156, 0.2) !important; grid-area: 3 / 4 / 6 / 7;">
                                    <p class="small">
                                        <img src="/web/image/spa_resort.img_spa_resort_image_27" alt="" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="64" data-mimetype="image/webp" style="width: 15.67%; height: auto;" loading="lazy" />
                                    </p>
                                    <h3>
                                        <span class="h4-fs">LINEN ROBES &amp; SLIPPERS</span>
                                    </h3>
                                    <p>
                                        <span style="color: rgba(229, 217, 197, 0.8);">Heated organic linen robes, plush footwear, and private secure dressing quarters are provided.</span>
                                    </p>
                                </div>
                                <div class="o_grid_item border rounded g-col-lg-3 o_colored_level g-height-3 col-lg-3 offset-1 offset-lg-0 col-10" style="z-index: 4; --box-border-bottom-left-radius: 30px; --box-border-bottom-right-radius: 30px; --box-border-top-right-radius: 30px; --box-border-top-left-radius: 30px; --grid-item-padding-y: 15px; --grid-item-padding-x: 15px; border-color: rgba(214, 193, 156, 0.2) !important; grid-area: 3 / 7 / 6 / 10;">
                                    <p class="small">
                                        <img src="/web/image/spa_resort.img_spa_resort_image_02" alt="" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="64" data-mimetype="image/webp" style="width: 15.67%; height: auto;" loading="lazy" />
                                    </p>
                                    <h3>
                                        <span class="h4-fs">DIGITAL DISCONNECTION</span>
                                    </h3>
                                    <p>
                                        <span style="color: rgba(229, 217, 197, 0.8);">To maintain sanctuary tranquility, portable devices are checked in your lockboxes.</span>
                                    </p>
                                </div>
                                <div class="o_grid_item border rounded g-col-lg-3 o_colored_level g-height-3 col-lg-3 offset-1 offset-lg-0 col-10" style="z-index: 5; --box-border-bottom-left-radius: 30px; --box-border-bottom-right-radius: 30px; --box-border-top-right-radius: 30px; --box-border-top-left-radius: 30px; --grid-item-padding-y: 15px; --grid-item-padding-x: 15px; border-color: rgba(214, 193, 156, 0.2) !important; grid-area: 3 / 10 / 6 / 13;">
                                    <p class="small">
                                        <img src="/web/image/spa_resort.img_spa_resort_image_28" alt="" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="64" data-mimetype="image/webp" style="width: 15.67%; height: auto;" loading="lazy" />
                                    </p>
                                    <h3>
                                        <span class="h4-fs">FLEXIBLE 24H POLICY</span>
                                    </h3>
                                    <p>
                                        <span style="color: rgba(229, 217, 197, 0.8);">Reschedule or modify your booking with no friction up to 24 hours.</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
