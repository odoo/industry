msgstr "<strong>بطاقات الولاء</strong> "

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong>Maintenance</strong> schedules and monitors upkeep for spa equipment "
"such as saunas, massage tables, pools, and other installations."
msgstr ""
"يساعدك تطبيق <strong>الصيانة</strong> على جدولة ومراقبة أعمال الصيانة لمعدات "
"المنتجع الصحي مثل الساونا وطاولات التدليك والمسابح وغيرها من المرافق."

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Manage Purchases</strong>"
msgstr "<strong>إدارة المشتريات</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Point of Sale (POS) at Reception</strong>"
msgstr "<strong>نقطة البيع (POS) عند الاستقبال</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
