"<span style=\"font-size: 30px;\">Noțiuni de bază</span><span class=\"h1-fs\">"
"\n"
"        </span>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.homepage
msgid ""
"<strong>\n"
"                        <font class=\"text-o-color-1\">OUR PHILOSOPHY</"
"font>\n"
"                      </strong>"
msgstr ""
"<strong>\n"
"                        <font class=\"text-o-color-1\">FILOSOFIA NOASTRĂ</"
"font>\n"
"                      </strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong> Plan Shifts</strong>"
msgstr "<strong> Planifică turele</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Appointment App</b>: </strong>Manage bookings for spa entrances "
"and massages with a clear, flexible schedule that prevents double-booking."
"<br/>"
msgstr ""
"<strong><b>Aplicația Programări</b>: </strong>Gestionează rezervările pentru "
"accesul la spa și masaje cu un program clar și flexibil, care previne "
"rezervările duble.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Inventory App</b>: </strong>Monitor the consumption of wellness "
"products like essential oils and towels to ensure you are always prepared."
"<br/>"
msgstr ""
"<strong><b>Aplicația Inventar</b>: </strong>Urmărește consumul de produse "
"wellness, precum uleiuri esențiale și prosoape, ca să fii mereu "
"pregătit.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Planning App</b>: </strong>Organize your therapists' schedules "
"efficiently to match staff availability with treatment bookings.<br/>"
msgstr ""
"<strong><b>Aplicația Planificare</b>: </strong>Organizează eficient "
"programul terapeuților pentru a corela disponibilitatea personalului cu "
"rezervările pentru tratamente.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Upsell relaxation by selling "
"tickets, cosmetics, and accessories like bathrobes directly at the reception."
"<br/>"
msgstr ""
"<strong><b>Aplicația Punct de vânzare</b>: </strong>Crește valoarea "
"vânzărilor oferind bilete, cosmetice și accesorii precum halate direct la "
"recepție.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Sales App</b>: </strong>Handle complex bookings like group offers "
"and special spa packages by sending professional quotations.<br/>"
msgstr ""
"<strong><b>Aplicația Vânzări</b>: </strong>Gestionează rezervările complexe, "
"precum ofertele de grup și pachetele spa speciale, trimițând oferte "
"profesionale.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Website &amp; eCommerce App</b>: </strong>Showcase your wellness "
"menu online, allowing guests to book treatments and buy gift cards 24/7.<br/>"
msgstr ""
"<strong><b>Aplicația Site web și comerț electronic</b>: </strong>Prezintă "
"online oferta wellness și permite oaspeților să rezerve tratamente și să "
"cumpere carduri cadou non-stop.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong>Accounting</strong> helps you manage all finances, payments, and "
"reconciliations in one integrated system."
msgstr ""
"<strong>Contabilitate</strong> te ajută să gestionezi toate finanțele, "
"plățile și reconcilierile într-un singur sistem integrat."

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Coupons</strong>"
msgstr "<strong>Cupoane</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Define Hours &amp; Roles</strong>"
msgstr "<strong>Definește programul și rolurile</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong>Events</strong> lets you create and manage workshops, wellness "
"weekends, or private retreats with online registration and ticketing."
msgstr ""
"<strong>Evenimente</strong> îți permite să creezi și să gestionezi ateliere, "
"weekenduri wellness sau retrageri private, cu înscriere și bilete online."

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Gift Cards</strong>"
msgstr "<strong>Carduri cadou</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Link Appointments to Products</strong>"
msgstr "<strong>Asociază programările cu produsele</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Loyalty Cards, Gift Cards, Coupons &amp; Promo Codes</strong>"
msgstr ""
"<strong>Carduri de fidelitate, carduri cadou, cupoane și coduri "
"promoționale</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Loyalty Cards</strong>"
msgstr "<strong>Carduri de fidelitate</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong>Maintenance</strong> schedules and monitors upkeep for spa equipment "
"such as saunas, massage tables, pools, and other installations."
msgstr ""
"<strong>Mentenanță</strong> programează și urmărește întreținerea "
"echipamentelor spa, precum saune, mese de masaj, piscine și alte instalații."

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
