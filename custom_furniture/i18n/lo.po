#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid "<strong><span class=\"h4-fs\">Services</span></strong>"
msgstr "<strong><span class=\"h4-fs\">ບໍລິການ</span></strong>"

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Based on timesheets, subcontracted</strong> (Design presentation "
"&amp; revisions, this config will create a new Purchase Order to buy this "
"prestation and create a task in the dedicated project)."
msgstr ""
"<strong>ອີງຕາມໃບບັນທຶກເວລາ, ຈ້າງຜູ້ຮັບເໝົາຊ່ວງ</strong> (ການນຳສະເໜີການອອກແບບ &amp; ການດັ"
"ດແກ້, ການຕັ້ງຄ່ານີ້ຈະສ້າງໃບສັ່ງຊື້ໃໝ່ເພື່ອຊື້ການບໍລິການນີ້ ແລະ ສ້າງໜ້າວຽກໃນໂຄງການສະເພາະ)."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Based on timesheets</strong> (Concept Development and 3D renderings, "
"this one will create a specific task in the existing \"3D Renderings\" "
"Project)"
msgstr ""
"<strong>ອີງຕາມໃບບັນທຶກເວລາ</strong> (ການພັດທະນາແນວຄວາມຄິດ ແລະ ການສະແດງພາບ 3D, ສ່ວນນີ້"
"ຈະສ້າງໜ້າວຽກສະເພາະໃນໂຄງການ \"3D Renderings\" ທີ່ມີຢູ່ແລ້ວ)"

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Based on timesheets</strong> - Field services (Delivery and "
"installation &amp; Electrical and lighting installation) will automatically "
"create a task in the Field Service App."
msgstr ""
"<strong>ອີງຕາມໃບບັນທຶກເວລາ</strong> - ບໍລິການພາກສະໜາມ (ການຈັດສົ່ງ ແລະ ການຕິດຕັ້ງ &amp; ກ"
"ານຕິດຕັ້ງລະບົບໄຟຟ້າ ແລະ ແສງສະຫວ່າງ) ຈະສ້າງໜ້າວຽກໂດຍອັດຕະໂນມັດໃນແອັບບໍລິການພາກສະໜາມ."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid "<strong>Basics:</strong>"
msgstr "<strong>ພື້ນຖານ:</strong>"

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Components </strong>that will serve to create manufactured products."
msgstr "<strong>ສ່ວນປະກອບ </strong>ທີ່ຈະນຳໃຊ້ເຂົ້າໃນການຜະລິດສິນຄ້າ."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Consumable goods:</strong> These will not be tracked (Such as bolts, "
"finish painting, and sandpaper)."
msgstr ""
"<strong>ສິນຄ້າສິ້ນເປືອງ:</strong> ສິນຄ້າເຫຼົ່ານີ້ຈະບໍ່ມີການຕິດຕາມສະຕັອກ (ເຊັ່ນ: ໄລກຽວ, ສີທາເຄືອບເງົ"
"າ, ແລະ ເຈ້ຍຊາຍ)."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Field Service Automation:</strong> Certain products trigger the "
"creation of Field Service tasks specifically for onsite installation."
msgstr ""
"<strong>ລະບົບອັດຕະໂນມັດຂອງບໍລິການພາກສະໜາມ:</strong> ສິນຄ້າບາງລາຍການຈະສັ່ງໃຫ້ສ້າງໜ້າວຽກບໍລິກ"
"ານພາກສະໜາມໂດຍສະເພາະ ສຳລັບການຕິດຕັ້ງຢູ່ໜ້າວຽກຕົວຈິງ."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Jane Design</strong>: She is your subcontractor for Design "
"presentations and revisions."
msgstr ""
"<strong>Jane Design</strong>: ລາວແມ່ນຜູ້ຮັບເໝົາຊ່ວງຂອງທ່ານ ສຳລັບການນຳສະເໜີການອອກແບບ ແລ"
"ະ ການດັດແກ້."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Manufactured Goods </strong>will be manufactured based on a Bill of "
"Material."
msgstr ""
"<strong>ສິນຄ້າທີ່ຜະລິດ </strong>ຈະຖືກຜະລິດຂຶ້ນຕາມໂຄງສ້າງລາຍການວັດສະດຸ (BOM)."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>My Chairs Vendor</strong>: Will provide you Conference chairs to "
"complete your order."
msgstr ""
"<strong>My Chairs Vendor</strong>: ຈະສະໜອງຕັ່ງຫ້ອງປະຊຸມໃຫ້ທ່ານ ເພື່ອເຮັດໃຫ້ລາຍການສັ່ງຊື້ຂອງ"
"ທ່ານສົມບູນ."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>My Metal Vendor</strong>: Will provide the Conference Table Metal "
"Legs you need to manufacture the conference table."
msgstr ""
"<strong>My Metal Vendor</strong>: ຈະສະໜອງຂາໂຕະປະຊຸມເຫຼັກ ທີ່ທ່ານຕ້ອງການໃຊ້ໃນການຜະລິດໂຕ"
"ະປະຊຸມ."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>My Rug Vendor</strong>: Will provide you the custom area rug in "
"sufficient square meters."
msgstr ""
"<strong>My Rug Vendor</strong>: ຈະສະໜອງພົມປູພື້ນຕາມຂະໜາດ ໃຫ້ພຽງພໍກັບເນື້ອທີ່ຕາຕະລາງແມັດຂອ"
"ງທ່ານ."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>My Wood Vendor</strong>: Will send you the Oak Wood Panels you need "
"to create the tables."
msgstr ""
"<strong>My Wood Vendor</strong>: ຈະຈັດສົ່ງແຜ່ນໄມ້ໂອ໊ກ ທີ່ທ່ານຕ້ອງການໃຊ້ເພື່ອເຮັດໂຕະ."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Prepaid services, fixed price</strong> (Initial design consultation "
"&amp; Final Inspection. Note that the first one will also create a new "
"project for each confirmed order to ensure Project follow-up)."
msgstr ""
"<strong>ບໍລິການຈ່າຍລ່ວງໜ້າ, ລາຄາຄົງທີ່</strong> (ການໃຫ້ຄຳປຶກສາການອອກແບບເບື້ອງຕົ້ນ &amp; ການ"
"ກວດກາຂັ້ນສຸດທ້າຍ. ໝາຍເຫດ: ລາຍການທຳອິດຍັງຈະສ້າງໂຄງການໃໝ່ ສຳລັບແຕ່ລະໃບສັ່ງຊື້ທີ່ຢືນຢັນແລ້ວ ເພື່ອຮັບປະ"
"ກັນການຕິດຕາມໂຄງການ)."

#. module: custom_furniture
#: model_terms:ir.ui.view,arch_db:custom_furniture.welcome_article_body
msgid ""
"<strong>Project Templates</strong>: Create reusable models with pre-set "
"tasks and dates."
msgstr ""
"<strong>ແບບຮ່າງໂຄງການ</strong>: ສ້າງຮູບແບບທີ່ສາມາດນຳໃຊ້ຄືນໄດ້ ພ້ອມກຳນົດໜ້າວຽກ ແລະ ວັນທີໄວ້ລ່"
"ວງໜ້າ."

#. module: custom_furniture
