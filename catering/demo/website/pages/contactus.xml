<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">catering.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="catering.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'contact_name': request.params.get('contact_name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'partner_name': request.params.get('partner_name', ''), 'name': request.params.get('name', ''), 'description': request.params.get('description', '')}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_images_constellation o_cc pb48 o_full_screen_height pt0 o_colored_level o_cc1" data-snippet="s_images_constellation" style="min-height: 965.5px !important;" data-name="Images Constellation">
                            <div class="container-fluid">
                                <div class="row o_grid_mode" data-row-count="16">
                                    <div class="o_grid_item o_colored_level g-height-3 g-col-lg-8 col-lg-8" style="z-index: 9; --grid-item-padding-x: 16px; --grid-item-padding-y: 16px; grid-area: 7 / 3 / 10 / 11;">
                                        <div class="text-center">
                                            <h1 class="display-1"><span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom o_rfs" style="--wanim-intensity: 10; font-size: clamp(8px, 1em + 3.2529vw, 400px);">GET IN TOUCH</span></h1>
                                        </div>
                                    </div>
                                    <div class="o_grid_item g-col-lg-12 o_colored_level o_animate o_animate_on_scroll o_anim_fade_in o_animate_out o_anim_from_bottom g-height-2 col-lg-12" style="z-index: 11; --grid-item-padding-x: 16px; --grid-item-padding-y: 16px; grid-area: 15 / 1 / 17 / 13;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <p style="text-align: center;" class="lead"><span class="o_small-fs text-o-color-1"><a href="/contactus#contact" class="o_translate_inline">DISCOVER MORE<br/><img src="/web/image/catering.img_catering_image_01" alt="" class="img img-fluid o_we_custom_image" loading="lazy"/></a></span></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_title o_colored_level o_cc pt0 pb0 o_cc1" data-vcss="001" data-snippet="s_title" data-name="Title">
                            <div class="s_allow_columns container-fluid">
                                <div class="row o_grid_mode" data-row-count="8">
                                    <div class="o_colored_level rounded o_grid_item o_animate o_animate_on_scroll o_anim_fade_in g-height-8 g-col-lg-4 col-lg-4" style="--box-border-bottom-left-radius: 5px; --box-border-bottom-right-radius: 5px; --box-border-top-right-radius: 5px; --box-border-top-left-radius: 5px; z-index: 2; grid-area: 1 / 1 / 9 / 5;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <img src="/web/image/catering.img_catering_image_24" alt="" class="img img-fluid mx-auto d-block o_animate o_animate_on_scroll o_anim_rotate_in" data-scroll-zone-start="0" data-scroll-zone-end="100" data-mimetype="image/svg+xml" loading="lazy"/>
                                    </div>
                                    <div class="o_grid_item g-col-lg-12 o_colored_level g-height-1 col-lg-12 o_animate o_animate_on_scroll o_anim_fade_in border o_anim_from_left" style="z-index: 1; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; border-left-color: var(--o-color-1) !important; border-bottom-color: var(--o-color-1) !important; border-right-color: var(--o-color-1) !important; border-top-color: var(--o-color-1) !important; grid-area: 6 / 1 / 7 / 13; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 2px;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <p style="text-align: center;"><br/></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_form_aside pt48 o_colored_level pb0" data-snippet="s_form_aside" data-name="Form Aside" style="position: relative;" id="contact" data-anchor="true">
                            <div class="container-fluid">
                                <div class="row o_grid_mode" data-row-count="20">
                                    <div class="order-lg-0 o_colored_level o_grid_item g-height-20 col-lg-4 g-col-lg-3 col-lg-3" style="order: 1; grid-area: 1 / 2 / 21 / 5; z-index: 1;">
                                        <h2>
                                            <span class="display-3-fs">
                                                <span class="o_animated_text o_anim_fade_in o_animate o_animate_on_scroll o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                                    <em>Contact</em> Us
                                                </span>
                                            </span>
                                        </h2>
                                        <p class="lead"><br/></p>
                                        <p class="lead">
                                            <span class="o_animated_text o_anim_fade_in o_anim_from_bottom o_animate o_animate_on_scroll" data-scroll-zone-start="0" data-scroll-zone-end="100">Planning a wedding, a corporate dinner or a private celebration? Tell us about your event and we will craft a bespoke menu around it.</span>
                                        </p>
                                        <p class="lead"><br/></p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div class="mb-3 s_website_form_field s_website_form_required col-lg-12 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-type="char" data-name="Field" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact1">
                                                        <span class="s_website_form_label_content">Name</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                            <input id="contact1" type="text" placeholder="John Doe" class="form-control s_website_form_input" name="contact_name" required="" data-fill-with="name"/>
                                                        </div>
                                                        <div class="mb-3 s_website_form_field col-lg-12 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-type="tel" data-name="Field" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact2">
                                                        <span class="s_website_form_label_content">Phone Number</span>
                                                    </label>
                                                            <input id="contact2" type="tel" placeholder="+1 555-555-5556" class="form-control s_website_form_input" name="phone" data-fill-with="phone"/>
                                                        </div>
                                                        <div class="mb-3 s_website_form_field s_website_form_required s_website_form_model_required col-lg-12 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-type="email" data-name="Field" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact3">
                                                        <span class="s_website_form_label_content">Email</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                            <input id="contact3" type="email" placeholder="example@mail.com" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email"/>
                                                        </div>
                                                        <div class="mb-3 s_website_form_field col-lg-12 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-type="char" data-name="Field" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact4">
                                                        <span class="s_website_form_label_content">Company</span>
                                                    </label>
                                                            <input id="contact4" type="text" placeholder="ACME Corp" class="form-control s_website_form_input" name="partner_name" data-fill-with="parent_name"/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-type="char" data-name="Field" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact5">
                                                        <span class="s_website_form_label_content">Subject</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                            <input id="contact5" type="text" placeholder="Describe your request" class="form-control s_website_form_input" name="name" required=""/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-type="text" data-name="Field" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact6">
                                                        <span class="s_website_form_label_content">Message</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                            <textarea id="contact6" placeholder="Write down your message" class="form-control s_website_form_input" name="description" required="" rows="6"/>
                                                            <span class="s_website_form_field_description small form-text text-muted">We typically respond within 1-2 business days.</span>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-center s_website_form_no_submit_label pt24" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"/>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send">SEND US A MESSAGE</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="order-lg-0 o_colored_level o_grid_item o_grid_item_image g-height-20 g-col-lg-7 col-lg-7 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" style="order: 0; grid-area: 1 / 6 / 21 / 13; z-index: 2; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <img src="/web/image/catering.img_catering_image_04" alt="" class="img img-fluid o_editable_media o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="1280" data-mimetype="image/webp" loading="lazy"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
