<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="appointment_info_2" model="ir.ui.view">
        <field name="name">La Table - Appointment Info</field>
        <field name="inherit_id" ref="appointment.appointment_info" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_appointments_info_2']" position="replace">
                <div class="oe_structure oe_empty" id="oe_structure_appointments_info_2" data-editor-message="Drag blocks here to add them on all appointments">
                    <section class="s_animated_cover o_cc o_colored_level o_cc1 pt40" data-snippet="s_animated_cover" data-scroll-background-ratio="0" data-name="Animated Cover">
                        <div class="oe_structure oe_empty">
                            <section class="s_announcement_scroll w-100 pt0 s_announcement_scroll_direction_left o_colored_level pb0" style="--marquee-item-font-size: 40; --marquee-animation-speed: 1s;" role="marquee" data-snippet="s_announcement_scroll" data-name="Announcement Scroll">
                                <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                                    <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">*</div>
                                </div>
                            </section>
                            <section class="s_announcement_scroll w-100 s_announcement_scroll_direction_right o_colored_level pt0 pb8" style="--marquee-item-font-size: 40; --marquee-animation-speed: 1s;" role="marquee" data-snippet="s_announcement_scroll" data-name="Announcement Scroll">
                                <div class="s_announcement_scroll_marquee_container d-flex">
                                    <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">BOOK AN EXPERIENCE</div>
                                </div>
                            </section>
                            <section class="s_announcement_scroll w-100 pb16 s_announcement_scroll_direction_left o_colored_level pt4" style="--marquee-item-font-size: 40; --marquee-animation-speed: 1s;" role="marquee" data-snippet="s_announcement_scroll" data-name="Announcement Scroll">
                                <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                                    <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">*</div>
                                </div>
                            </section>
                        </div>
                    </section>
                    <section class="s_text_image pb80 o_colored_level pt0" data-snippet="s_text_image" data-name="Text - Image">
                        <div class="container">
                            <div class="row align-items-start">
                                <div class="pb16 o_colored_level col-lg-12 pt0">
                                    <img src="/web/image/catering.img_catering_image_10" alt="" class="img img-fluid mx-auto rounded o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="1024" data-mimetype="image/webp" loading="lazy" />
                                </div>
                                <div class="col-lg-5 pb16 o_colored_level pt32 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                    <h2>
                                        Our<br />
                                    <em>Commitment</em>
                                </h2>
                            </div>
                            <div class="o_colored_level col-lg-12 pt0 pb0 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_left" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                <div class="s_hr pt32 pb32" data-snippet="s_hr" data-name="Separator">
                                    <hr class="w-100 mx-auto" style="border-top-width: 2px; border-top-color: var(--o-color-1);" />
                                </div>
                            </div>
                            <div class="col-lg-5 pt16 pb16 o_colored_level o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                <p class="lead">
                                    <span class="text-o-color-5">We work with local artisans and producers we know by name, so every dish we serve carries the true character of our region.</span>
                                    <br />
                                </p>
                            </div>
                            <div class="pt16 pb16 o_colored_level col-lg-7">
                                <img src="/web/image/catering.img_catering_image_26" alt="" class="img d-block mb-2 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100" data-mimetype="image/svg+xml" loading="lazy" />
                                <p>
                                    <span class="text-o-color-5">
                                        <span class="o_animated_text o_anim_fade_in o_animate o_animate_on_scroll o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100">We focus on direct sourcing and expert craftsmanship to create a sophisticated atmosphere that reflects the true story of our terroir.</span>
                                    </span>
                                    <br />
                                </p>
                                <p>
                                    <br />
                                </p>
                                <img src="/web/image/catering.img_catering_image_26" alt="" class="img d-block mb-2 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100" data-mimetype="image/svg+xml" loading="lazy" />
                                <p>
                                    <span class="text-o-color-5">
                                        <span class="o_animated_text o_anim_fade_in o_animate o_animate_on_scroll o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100">We harmonize our commitment to authenticity with your unique requirements to deliver a precisely curated result.</span>
                                    </span>
                                </p>
                                <p>
                                    <br />
                                </p>
                                <img src="/web/image/catering.img_catering_image_26" alt="" class="img d-block mb-2 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100" data-mimetype="image/svg+xml" loading="lazy" />
                                <p>
                                    <span class="text-o-color-5">
                                        <span class="o_animated_text o_anim_fade_in o_animate o_animate_on_scroll o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100">Every service is built on exclusive local partnerships, blending genuine regional heritage with meticulous precision.</span>
                                    </span>
                                    <br />
                                </p>
                                <p>
                                    <br />
                                </p>
                                <img src="/web/image/catering.img_catering_image_26" alt="" class="img d-block mb-2 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100" data-mimetype="image/svg+xml" loading="lazy" />
                                <p>
                                    <span class="text-o-color-5">
                                        <span class="o_animated_text o_anim_fade_in o_anim_from_bottom o_animate o_animate_on_scroll" data-scroll-zone-start="0" data-scroll-zone-end="100">We partner directly with the region's most dedicated artisans and farmers to source seasonal ingredients and handcrafted goods at their peak.</span>
                                    </span>
                                    <br />
                                </p>
                                <p>
                                    <br />
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </field>
</record>
