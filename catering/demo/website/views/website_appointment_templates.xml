<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="appointments_card_top" model="ir.ui.view">
        <field name="name">La Table - Appointments Card Top</field>
        <field name="inherit_id" ref="website_appointment.appointments_selection_layout" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_appointments_card_top']" position="replace">
                <div class="oe_structure" id="oe_structure_appointments_card_top">
                    <section class="s_images_constellation o_cc pb48 o_full_screen_height pt0 o_colored_level o_cc1" data-snippet="s_images_constellation" style="min-height: 965.5px !important;" data-name="Images Constellation">
                        <div class="container-fluid">
                            <div class="row o_grid_mode" data-row-count="16">
                                <div class="o_grid_item o_colored_level g-height-3 g-col-lg-12 col-lg-12" style="z-index: 9; --grid-item-padding-x: 16px; --grid-item-padding-y: 16px; grid-area: 7 / 1 / 10 / 13;">
                                    <div class="text-center">
                                        <h1 class="display-1">
                                            <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom o_rfs" style="--wanim-intensity: 10; font-size: clamp(8px, 1em + 2.2113vw, 400px);">BOOK AN EXPERIENCE</span>
                                        </h1>
                                    </div>
                                </div>
                                <div class="o_grid_item g-col-lg-12 o_colored_level o_animate o_animate_on_scroll o_anim_fade_in o_animate_out o_anim_from_bottom g-height-2 col-lg-12" style="z-index: 11; --grid-item-padding-x: 16px; --grid-item-padding-y: 16px; grid-area: 15 / 1 / 17 / 13;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                    <p style="text-align: center;" class="lead">
                                        <span class="o_small-fs text-o-color-1">
                                            <a href="/appointment#experience" class="o_translate_inline">
                                                DISCOVER MORE<br />
                                                <img src="/web/image/catering.img_catering_image_01" alt="" class="img img-fluid o_we_custom_image" loading="lazy" />
                                            </a>
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_parallax parallax o_colored_level s_parallax_is_fixed pt48 pb48 o_full_screen_height" data-scroll-background-ratio="3" data-snippet="s_parallax" style="position: relative;" data-name="Parallax">
                        <span class="s_parallax_bg_wrap">
                            <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/catering.img_catering_image_10&quot;); background-position: 50% 75%;" data-format-mimetype="image/webp" data-resize-width="1024" data-mimetype="image/webp" />
                        </span>
                        <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(rgb(255, 255, 255) 0%, rgba(255, 255, 255, 0) 99%);" />
                        <div class="oe_structure oe_empty" />
                    </section>
                    <section class="s_title o_colored_level o_cc pt0 pb0 o_cc1" data-vcss="001" data-snippet="s_title" data-name="Title" id="experience" data-anchor="true">
                        <div class="s_allow_columns container-fluid">
                            <div class="row o_grid_mode" data-row-count="8">
                                <div class="o_colored_level rounded o_grid_item o_animate o_animate_on_scroll o_anim_fade_in g-col-lg-4 col-lg-4 g-height-8 d-lg-block d-none o_snippet_mobile_invisible" style="--box-border-bottom-left-radius: 5px; --box-border-bottom-right-radius: 5px; --box-border-top-right-radius: 5px; --box-border-top-left-radius: 5px; z-index: 2; grid-area: 1 / 9 / 9 / 13;" data-scroll-zone-start="0" data-scroll-zone-end="100" data-invisible="1">
                                    <img src="/web/image/catering.img_catering_image_24" alt="" class="img img-fluid mx-auto d-block o_animate o_animate_on_scroll o_anim_rotate_in" data-scroll-zone-start="0" data-scroll-zone-end="100" data-mimetype="image/svg+xml" loading="lazy" />
                                </div>
                                <div class="o_grid_item g-col-lg-12 o_colored_level g-height-1 col-lg-12 o_animate o_animate_on_scroll o_anim_fade_in o_anim_from_right border" style="z-index: 1; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; border-left-color: var(--o-color-1) !important; border-bottom-color: var(--o-color-1) !important; border-right-color: var(--o-color-1) !important; border-top-color: var(--o-color-1) !important; grid-area: 6 / 1 / 7 / 13; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 2px;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                    <p style="text-align: center;">
                                        <br />
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="website_calendar_index_topbar" model="ir.ui.view">
        <field name="name">La Table - Appointments Topbar</field>
        <field name="inherit_id" ref="website_appointment.website_calendar_index_topbar" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//h1" position="replace">
                <h2 class="mb-0">
                    <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 10;">Choose</span>
                    <br />
                    <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 10; animation-delay: 0.25s;">Your</span>
                    <br />
                    <em>
                        <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 10; animation-delay: 0.5s;">Experience</span>
                    </em>
                </h2>
                <p>
                    <br />
                    <br />
                </p>
            </xpath>
        </field>
    </record>

    <record id="appointments_card_bottom" model="ir.ui.view">
        <field name="name">La Table - Appointments Card Bottom</field>
        <field name="inherit_id" ref="website_appointment.appointments_selection_layout" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_appointments_card_bottom']" position="replace">
                <div class="oe_structure" id="oe_structure_appointments_card_bottom">
                    <section class="s_title pt40 pb40 o_colored_level" data-vcss="001" data-snippet="s_title" data-name="Title">
                        <div class="container s_allow_columns">
                            <div class="s_hr pt16 pb24" data-snippet="s_hr" data-name="Separator">
                                <hr class="w-100 mx-auto" style="border-top-width: 0px;" />
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
