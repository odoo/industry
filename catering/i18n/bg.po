msgstr "Вегетарианско"

#. module: catering
#: model:product.template,name:catering.product_product_95_product_template
msgid "Wait Staff Service (per hour)"
msgstr "Сервитьорско обслужване (на час)"

#. module: catering
#: model_terms:ir.ui.view,arch_db:catering.welcome_article_body
msgid "Wait for client approval. They can sign the quotation online."
msgstr "Изчакайте одобрение от клиента. Той може да подпише офертата онлайн."

#. module: catering
#: model:planning.role,name:catering.planning_role_1
msgid "Waiter"
msgstr "Сервитьор"

#. module: catering
#: model_terms:ir.ui.view,arch_db:catering.welcome_article_body
msgid "Want to create a stunning quotation? Explore the"
msgstr "Искате да създадете впечатляваща оферта? Разгледайте"

