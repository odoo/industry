<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus_thanks" model="ir.ui.view">
        <field name="name">Thanks (Contact us)</field>
        <field name="key">metal_fabricator.page_contactus_thanks</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Thanks (Contact us)" t-name="metal_fabricator.page_contactus_thanks">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block pt80 pb80 o_colored_level o_cc o_cc5 o_three_quarter_height" data-snippet="s_text_block" data-name="Thank You Section">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="col-lg-12 o_colored_level" style="text-align: center;">
                                        <i class="oi oi-filled mb-3 rounded-circle text-bg-success oi-2x" data-icon="send" role="presentation"/>
                                        <h1 class="fw-bolder">Thank You</h1>
                                        <p class="lead">Your request has been sent. <br/>We will get back to you shortly.<br/><br/></p>
                                        <p class="lead"><a href="/" class="o_translate_inline btn btn-primary">Back to Home</a></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <input t-if="website.plausible_shared_key" type="hidden" class="js_plausible_push" data-event-name="Lead Generation" data-event-params="{&quot;CTA&quot;: &quot;Contact Us&quot;}"/>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus_thanks" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus_thanks"/>
            <field name="url">/contactus-thank-you</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="False"/>
        </record>
    </data>
</odoo>
