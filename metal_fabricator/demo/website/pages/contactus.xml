<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">metal_fabricator.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="metal_fabricator.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'name': request.params.get('name', ''), 'contact_name': request.params.get('contact_name', ''), 'partner_name': request.params.get('partner_name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'description': request.params.get('description', '')}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title_split o_colored_level o_cc o_cc5 s_custom_snippet pb0 pt168" data-snippet="s_title_split" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Blurry/12&quot;,&quot;colors&quot;:{&quot;c1&quot;:&quot;#0262E766&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;" data-name="Custom Title Split">
                            <div class="o_we_shape o_html_builder_Blurry_12" style="background-image: url(&quot;/html_editor/shape/html_builder%2FBlurry%2F12.svg?c1=%230262E766&amp;flip=y&quot;); background-position: 50% 0%;"/>
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-6 pt16">
                                        <h1 class="display-3-fs">Contact Us</h1>
                                        <div class="s_hr pb32 o_colored_level pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-1); border-top-width: 2px;"/>
                                        </div>
                                        <p class="lead">Planning a custom metalwork project or need a quote? Tell us about your needs and our team will get back to you as soon as possible.</p>
                                    </div>
                                    <div class="o_colored_level col-lg-5 offset-lg-1 pt0 o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 2;">
                                        <div class="s_card o_card_img_top card o_colored_level rounded border" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; border-color: rgba(2, 98, 231, 0.37) !important; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                                            <div class="card-body">
                                                <div class="s_hr pt32 o_colored_level d-lg-block d-none o_snippet_mobile_invisible pb32" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-5);"/>
                                                </div>
                                                <p class="card-title">
                                                    <a href="tel:+15555555556" class="o_translate_inline">
                                                        <span style="font-weight: normal;" class="o_small-fs text-o-color-4">
                                                            <span class="oi oi-filled img-thumbnail text-o-color-4 bg-o-color-2" data-icon="phone" style="border-color: rgba(2, 98, 231, 0.54);"/>
                                                        </span>
                                                        <span class="text-o-color-4">
                                                            &amp;nbsp;<span class="h5-fs">+1 555-555-5556</span>
                                                        </span>
                                                    </a>
                                                </p>
                                                <p class="card-title">
                                                    <a href="mailto:info@fabriq.example.be" class="o_translate_inline">
                                                        <span class="o_small-fs">
                                                            <span class="oi oi-filled img-thumbnail text-o-color-4 bg-o-color-2" data-icon="mail" style="border-color: rgba(2, 98, 231, 0.54) !important;"/>
                                                        </span>
                                                        <span class="text-o-color-4">
                                                            &amp;nbsp;<span class="h5-fs">info@fabriq.example.be</span>
                                                        </span>
                                                    </a>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level o_cc pt8 o_cc5 pb0" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-6 order-lg-0 o_cc o_cc3 border" style="order: 0; --box-border-left-width: 10px; --box-border-bottom-width: 10px; --box-border-right-width: 10px; --box-border-top-width: 10px; border-left-color: var(--o-color-2) !important; border-bottom-color: var(--o-color-2) !important; border-right-color: var(--o-color-2) !important; border-top-color: var(--o-color-2) !important;">
                                        <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container-fluid">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" style="--form-label-required-mark-color: var(--o-color-1);">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char">
                                                            <label class="s_website_form_label" for="o4ay2cngf0ao" style="width: 200px;">
                                                                <span class="s_website_form_label_content text-400">Subject</span>
                                                                <span class="s_website_form_mark">   *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="o4ay2cngf0ao"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_required" data-type="char">
                                                            <label class="s_website_form_label" for="oza6xj797ofj" style="width: 200px;">
                                                                <span class="s_website_form_label_content text-400">Your Name</span>
                                                                <span class="s_website_form_mark">   *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="" id="oza6xj797ofj" data-fill-with="name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="char">
                                                            <label class="s_website_form_label" for="ojp82wuc43al" style="width: 200px;">
                                                                <span class="s_website_form_label_content text-400">Your Company</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="partner_name" value="" placeholder="" id="ojp82wuc43al" data-fill-with="parent_name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="tel">
                                                            <label class="s_website_form_label" for="ohqb521pbel" style="width: 200px;">
                                                                <span class="s_website_form_label_content text-400">Your Phone</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="phone" placeholder="" id="ohqb521pbel" data-fill-with="phone"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_model_required" data-type="email">
                                                            <label class="s_website_form_label" for="o7m2iyrbiggu" style="width: 200px;">
                                                                <span class="s_website_form_label_content text-400">Your Email</span>
                                                                <span class="s_website_form_mark">   *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="o7m2iyrbiggu" data-fill-with="email"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="many2one">
                                                            <label class="s_website_form_label" for="og64mjrgztyn" style="width: 200px;">
                                                                <span class="s_website_form_label_content text-400">Type of Inquiry</span>
                                                            </label>
                                                            <select class="form-select s_website_form_input" name="Type of Inquiry" id="og64mjrgztyn">
                                                                <option id="og64mjrgztyn0" value="Request a Quote" selected="selected">Request a Quote</option>
                                                                <option id="og64mjrgztyn1" value="General Inquiry">General Inquiry</option>
                                                                <option id="og64mjrgztyn2" value="Job Application">Job Application</option>
                                                            </select>
                                                        </div>
                                                        <div data-visibility-dependency="Type of Inquiry" data-visibility-condition="Request a Quote" data-visibility-comparator="selected" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_field_hidden_if d-none" data-type="many2one">
                                                            <label class="s_website_form_label" for="ospklsn0upd" style="width: 200px;">
                                                                <span class="s_website_form_label_content text-400">Material Required</span>
                                                            </label>
                                                            <select class="form-select s_website_form_input" name="tag_ids" id="ospklsn0upd">
                                                                <option id="ospklsn0upd0" value="*steel_tag*" selected="selected">Steel</option>
                                                                <option id="ospklsn0upd1" value="*stainless_steel_tag*">Stainless Steel</option>
                                                                <option id="ospklsn0upd2" value="*aluminum_tag*">Aluminum</option>
                                                                <option id="ospklsn0upd3" value="*other_material_tag*">Other / Not Sure Yet</option>
                                                            </select>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text">
                                                            <label class="s_website_form_label" for="oq88hprt6kh8" style="width: 200px;">
                                                                <span class="s_website_form_label_content text-400">Your Message</span>
                                                                <span class="s_website_form_mark">   *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="oq88hprt6kh8" rows="5"/>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-end s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label">
                                                                <br/>
                                                            </div>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send o_translate_inline">Send My Request</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="o_colored_level col-lg-5 offset-lg-1 order-lg-0 pt0 o_animate o_anim_fade_in o_anim_from_bottom" style="order: 1; --wanim-intensity: 2; animation-delay: 0.2s;">
                                        <div class="s_hr o_colored_level d-lg-none o_snippet_desktop_invisible pt16 pb16" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                            <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-5);"/>
                                        </div>
                                        <p class="o-float-end-parent">
                                            <img src="/web/image/metal_fabricator.img_metal_fabricator_image_16" alt="A smiling secretary from the Fabriq company wearing a headset, ready to answer questions, with arms crossed" class="img img-fluid o_we_custom_image ms-auto float-end" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_hours_and_place o_cc pt80 pb80 o_colored_level o_cc5 oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-snippet="s_hours_and_place" data-name="Hours and Place" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Blurry/11&quot;,&quot;colors&quot;:{&quot;c1&quot;:&quot;#0262E766&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" style="position: relative; background-image: url(&quot;/web/image/metal_fabricator.img_metal_fabricator_image_11&quot;);" data-format-mimetype="image/webp" data-resize-width="1672" data-mimetype="image/webp">
                            <div class="o_we_shape o_html_builder_Blurry_11" style="background-image: url(&quot;/html_editor/shape/html_builder%2FBlurry%2F11.svg?c1=%230262E766&quot;);"/>
                            <div class="container">
                                <h2 style="font-weight: normal;">
                                    <span class="display-4-fs">
                                        <span class="text-o-color-1">
                                            <strong>Office &amp;amp; Workshop</strong>
                                        </span>
                                    </span>
                                </h2>
                                <p>
                                    <br/>
                                </p>
                                <div class="row s_nb_column_fixed">
                                    <div class="o_colored_level o_cc col-lg-3 pt24 pb24 o_cc3 rounded" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px;">
                                        <h3 class="h5-fs">Office Hours</h3>
                                        <div class="s_hr pb32 o_colored_level pt4" data-snippet="s_hr" data-name="Separator">
                                            <hr class="me-auto w-100" style="border-top-color: var(--o-color-1);"/>
                                        </div>
                                        <p class="o_small-fs">
                                            Monday - Tuesday: <span style="color: rgb(206, 198, 206);">8:00 - 18:00</span>
                                        </p>
                                        <p class="o_small-fs">
                                            Wednesday: <span style="color: rgb(206, 198, 206);">8:00 - 12:00</span>
                                        </p>
                                        <p class="o_small-fs">
                                            Thursday - Friday: <span style="color: rgb(206, 198, 206);">8:00 - 18:00</span>
                                            <br/><br/>
                                        </p>
                                        <h3 class="h5-fs">Workshop Visits</h3>
                                        <div class="s_hr pb32 o_colored_level pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-1);"/>
                                        </div>
                                        <p class="small">
                                            <span class="h6-fs" style="color: rgb(206, 198, 206);">
                                                <span class="oi oi-filled text-o-color-4" data-icon="error"/>
                                                Visits and project discussions</span>
                                            <span class="h6-fs o_text_highlight o_text_highlight_underline" style="color: rgb(206, 198, 206);"> by appointment</span><span class="h6-fs" style="color: rgb(206, 198, 206);">.</span>
                                        </p>
                                        <p class="small">
                                            <br/>
                                            <br/>
                                        </p>
                                    </div>
                                    <div class="col-lg-9 o_colored_level">
                                        <section class="s_map rounded-3" data-map-type="m" data-map-zoom="12" data-vxml="001" style="--GoogleMap-height: 432px" data-map-address="Rue du Laid Burniat 5, 1348 Ottignies-Louvain-la-Neuve, Belgium" data-snippet="s_map" data-name="Map">
                                            <div class="map_container">
                                                <div class="css_non_editable_mode_hidden">
                                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                        An address must be specified for a map to be embedded
                                                    </div>
                                                </div>
                                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=Rue%20du%20Laid%20Burniat%205%2C%201348%20Ottignies-Louvain-la-Neuve%2C%20Belgique&amp;t=m&amp;z=12&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                                <div class="s_map_color_filter" style="background-color: rgb(0, 38, 92);"/>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env.ref('metal_fabricator.view_page_contactus').id"/>
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('metal_fabricator.view_page_contactus').arch.replace(
            '*steel_tag*', str(obj().env.ref('metal_fabricator.crm_tag_1').id)).replace(
            '*stainless_steel_tag*', str(obj().env.ref('metal_fabricator.crm_tag_2').id)).replace(
            '*aluminum_tag*', str(obj().env.ref('metal_fabricator.crm_tag_3').id)).replace(
            '*other_material_tag*', str(obj().env.ref('metal_fabricator.crm_tag_4').id))
        }"/>
    </function>
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value eval="'crm.lead'"/>
        <value eval="['tag_ids']"/>
    </function>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
            <field name="header_text_color">text-o-color-4</field>
        </record>
    </data>
</odoo>
