<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta">Get in Touch</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="option_footer_scrolltop" model="ir.ui.view">
        <field name="name">Custom - Scroll To Top</field>
        <field name="key">website.option_footer_scrolltop</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="after">
                <div id="o_footer_scrolltop_wrapper" class="container h-0 d-flex align-items-center justify-content-end">
                    <a id="o_footer_scrolltop" role="button" href="#top" title="Scroll To Top" class="d-flex align-items-center justify-content-center btn btn-custom bg-o-color-1" style="color: rgba(255, 255, 255, 0.5); border: 0px solid rgba(255, 255, 255, 0.5);">
                        <span class="oi text-o-color-4" data-icon="keyboard_arrow_up"/>
                    </a>
                </div>
            </xpath>
        </field>
    </record>
    <record id="template_footer_minimalist" model="ir.ui.view">
        <field name="name">Custom - Minimalist</field>
        <field name="key">website.template_footer_minimalist</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 2px; border-left-color: var(--o-color-1) !important; border-bottom-color: var(--o-color-1) !important; border-right-color: var(--o-color-1) !important; border-top-color: var(--o-color-1) !important;">
                    <section class="s_text_block pt40 pb40" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="o_colored_level pb16 pt16 col-lg-3">
                                    <div class="s_social_media o_not_editable text-center" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow Us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank">
                                            <i class="oi o_editable_media oi-stack o_sm_custom_size text-o-color-4" data-icon="oi_facebook" style="--oi-icon-size: 4rem;"/>
                                        </a>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank">
                                            <i class="oi o_editable_media oi-stack o_sm_custom_size text-o-color-4" data-icon="oi_x" style="--oi-icon-size: 4rem;"/>
                                        </a>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank">
                                            <i class="oi o_editable_media oi-stack o_sm_custom_size text-o-color-4" data-icon="oi_instagram" style="--oi-icon-size: 4rem;"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_colored_level pb16 pt4 col-lg-6">
                                    <nav class="nav align-items-center justify-content-center flex-column flex-lg-row">
                                        <a class="nav-link" href="/">Home</a>
                                        <a class="nav-link" href="/about-us">About</a>
                                        <a class="nav-link" href="/services">Services</a>
                                        <a class="btn btn-sm btn-primary" href="/contactus">Get in Touch</a>
                                    </nav>
                                </div>
                                <div class="col-8 offset-2 o_colored_level pb16 pt24 col-lg-3 offset-lg-0">
                                    <p class="small">
                                        <img src="/web/image/metal_fabricator.img_metal_fabricator_image_24" alt="Fabriq" class="img img-fluid o_we_custom_image mx-auto d-block" loading="lazy" style="width: 68% !important;"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
