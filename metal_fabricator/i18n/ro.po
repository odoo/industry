msgstr ""
"Sudor care lucrează la componente metalice mari în atelier, înconjurat de "
"scântei."

#. module: metal_fabricator
#: model_terms:ir.ui.view,arch_db:metal_fabricator.view_page_home
msgid ""
"Welder lifting the visor of their helmet and smiling at us, equipped with "
"gloves and wearing an apron featuring the 'Fabriq' logo"
msgstr ""
