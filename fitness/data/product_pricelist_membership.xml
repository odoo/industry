<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="pricelist_item_default_yearly" model="product.pricelist.item">
        <field name="pricelist_id" model="product.pricelist" search="[('item_ids', '=', False), ('company_id', '=', ref('base.main_company'))]"/>
        <field name="applied_on">0_product_variant</field>
        <field name="product_id" ref="product_product_8"/>
        <field name="plan_id" ref="sale_subscription.subscription_plan_year"/>
        <field name="min_quantity">1</field>
        <field name="compute_price">fixed</field>
        <field name="fixed_price">350</field>
    </record>
    <record id="pricelist_item_default_monthly" model="product.pricelist.item">
        <field name="pricelist_id" model="product.pricelist.item" eval="obj(ref('pricelist_item_default_yearly')).pricelist_id.id"/>
        <field name="applied_on">0_product_variant</field>
        <field name="product_id" ref="product_product_8"/>
        <field name="plan_id" ref="sale_subscription.subscription_plan_month"/>
        <field name="min_quantity">1</field>
        <field name="compute_price">fixed</field>
        <field name="fixed_price">35</field>
    </record>
</odoo>
