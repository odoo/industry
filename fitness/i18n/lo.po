#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_about_us
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">\n"
"                                        <span class=\"o_animated_text "
"o_animate o_anim_fade_in o_visible o_anim_from_bottom\" style=\"--wanim-"
"intensity: 14; animation-duration: 0.5s;\">There's a qualified coach on the "
"floor every hour we're open.&amp;nbsp;<br/>Competitive lifters who actually "
"watch your sets, not staff who watch the front desk.</span>\n"
"                                    </span>\n"
"                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">\n"
"                                        <span class=\"o_animated_text "
"o_animate o_anim_fade_in o_visible o_anim_from_bottom\" style=\"--wanim-"
"intensity: 14; animation-duration: 0.5s;\">ມີຄູເຝິກທີ່ມີຄຸນວຸດທິປະຈຳຢູ່ສະເໝີຕະຫຼອດເວລາເປີດບໍ"
"ລິການ.&amp;nbsp;<br/>ນັກຍົກນ້ຳໜັກລະດັບແຂ່ງຂັນທີ່ຈະຄອຍເບິ່ງແຍງການເຝິກຂອງທ່ານແທ້ໆ, ບໍ່ແມ່ນພຽງພະນັກ"
"ງານທີ່ເຝົ້າໂຕະຕ້ອນຮັບ.</span>\n"
"                                    </span>\n"
"                                    <br/>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_contactus
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">\n"
"                                        <span class=\"o_animated_text "
"o_animate o_anim_fade_in o_visible o_anim_from_bottom\" style=\"--wanim-"
"intensity: 15; animation-duration: 0.5s;\">Visit the club&amp;nbsp;for a "
"private fitting, or request a virtual walkthrough.&amp;nbsp;<br/>Tell us a "
"little about your space and practice and we'll be in touch within one "
"business day.</span>\n"
"                                    </span>\n"
"                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">\n"
"                                        <span class=\"o_animated_text "
"o_animate o_anim_fade_in o_visible o_anim_from_bottom\" style=\"--wanim-"
"intensity: 15; animation-duration: 0.5s;\">ມາຢ້ຽມຊົມສະໂມສອນ&amp;nbsp;ເພື່ອທົດລອງໃຊ້"
"ອຸປະກອນສ່ວນຕົວ, ຫຼື ຂໍຮັບການພາຊົມສະຖານທີ່ແບບອອນລາຍ.&amp;nbsp;<br/>ບອກໃຫ້ພວກເຮົາຮູ້ກ່ຽວກັບພື້ນທີ່ "
"ແລະ ການເຝິກຂອງທ່ານ ແລ້ວພວກເຮົາຈະຕິດຕໍ່ກັບພາຍໃນໜຶ່ງວັນລັດຖະການ.</span>\n"
"                                    </span>\n"
"                                    <br/>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">A comprehensive path to "
"teaching — anatomy, cueing, programming and supervised practicum hours.</"
"span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ເສັ້ນທາງສູ່ການເປັນຄູເຝິກແບບຄົບວົງຈອ"
"ນ — ກາຍະວິພາກສາດ, ເທັກນິກການແນະນຳທ່າທາງ, ການວາງແຜນໂຄງການ ແລະ ຊົ່ວໂມງເຝິກປະຕິບັດພາຍໃຕ້ກາ"
"ນຊີ້ນຳ.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">A deep dive into the "
"trapeze table — push-through, tower and full-body suspension work.</span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ເຈາະລຶກການໃຊ້ອຸປະກອນ trapeze "
"table — ການອອກແຮງຍູ້ (push-through), ລະບົບຫໍຄອຍ (tower) ແລະ ການເຝິກແບບໂຈະຕົວທົ່ວຮ່າງກາ"
"ຍ.</span>\n"
"                                                    <br/>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_about_us
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
#: model_terms:ir.ui.view,arch_db:fitness.view_page_eventsss
#: model_terms:ir.ui.view,arch_db:fitness.view_page_home
#: model_terms:ir.ui.view,arch_db:fitness.website_sale_products_oe_structure_website_sale_products_2
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Book a free intro session "
"and we'll build the plan with you.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ຈອງຮອບແນະນຳຟຣີ ແລ້ວພວກເຮົາຈະຮ່ວ"
"ມວາງແຜນໄປພ້ອມກັບທ່ານ.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Build a confident base — "
"alignment, breath and the core reformer repertoire, at an unhurried pace.</"
"span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ສ້າງພື້ນຖານທີ່ໝັ້ນໃຈ — ການຈັດວາງສະລີ"
"ລະ, ການຫາຍໃຈ ແລະ ທ່າເຝິກຫຼັກເທິງຣີຟອມເມີ, ໄປຕາມຈັງຫວະທີ່ສະບາຍບໍ່ຮີບຮ້ອນ.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Choose a machine, select a "
"term at checkout (0% APR over 12 months, or up to 36 months), and a soft "
"credit check confirms your plan. Delivery, installation and warranty are "
"always included.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ເລືອກເຄື່ອງອອກກຳລັງກາຍ, ເລືອກໄລຍ"
"ະເວລາຜ່ອນຊຳລະໃນຂັ້ນຕອນການຊຳລະເງິນ (ດອກເບ້ຍ 0% ດົນ 12 ເດືອນ, ຫຼື ສູງສຸດ 36 ເດືອນ), ແລະ ການ"
"ກວດສອບສິນເຊື່ອເບື້ອງຕົ້ນຈະຢືນຢັນແຜນຂອງທ່ານ. ລວມການຈັດສົ່ງ, ການຕິດຕັ້ງ ແລະ ການຮັບປະກັນສະເໝີ.</"
"span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Every frame carries a 14-"
"year workshop warranty. Springs, upholstery and moving parts are covered for "
"three years, with servicing available through your membership.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ໂຄງສ້າງທຸກຊິ້ນມີການຮັບປະກັນຈາກໂຮງງ"
"ານ 14 ປີ. ສະປິງ, ເບາະຫຸ້ມ ແລະ ຊິ້ນສ່ວນເຄື່ອນໄຫວໄດ້ຮັບການຮັບປະກັນ 3 ປີ, ພ້ອມບໍລິການບຳລຸງຮັກສາຜ່ານກ"
"ານເປັນສະມາຊິກຂອງທ່ານ.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Home members get the full "
"on-demand library. Studio and Atelier members also get every live course "
"included at no extra cost, plus priority booking.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ສະມາຊິກແບບ Home ຈະໄດ້ຮັບສິດເຂົ້າເ"
"ບິ່ງຄັງວິດີໂອຕາມຄວາມຕ້ອງການທັງໝົດ. ສະມາຊິກແບບ Studio ແລະ Atelier ຍັງໄດ້ຮັບສິດເຂົ້າຮ່ວມທຸກຫຼັກສູດສົ"
"ດໂດຍບໍ່ມີຄ່າໃຊ້ຈ່າຍເພີ່ມເຕີມ, ພ້ອມທັງສິດຈອງກ່ອນ.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Load, tempo and control. "
"Progress your practice with heavier spring work and standing sequences.</"
"span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ນ້ຳໜັກ, ຈັງຫວະ ແລະ ການຄວບຄຸມ. ຍົ"
"ກລະດັບການເຝິກຊ້ອມຂອງທ່ານດ້ວຍການໃຊ້ສະປິງທີ່ໜັກຂຶ້ນ ແລະ ທ່າເຝິກແບບຢືນ.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Stability, proprioception "
"and mobility work drawn from the barrel and corrector repertoire.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ການສ້າງຄວາມໝັ້ນຄົງ, ການຮັບຮູ້ຕຳແໜ່ງ"
"ຮ່າງກາຍ ແລະ ຄວາມຢືດຢຸ່ນ ຈາກທ່າເຝິກດ້ວຍ barrel ແລະ spine corrector.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Twenty on-demand sessions "
"to get the most from a home reformer — watch, follow, repeat.</span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">20 ຮອບຮຽນອອນລາຍຕາມຄວາມຕ້ອງກາ"
"ນ ເພື່ອໃຫ້ເກີດປະໂຫຍດສູງສຸດຈາກຣີຟອມເມີຢູ່ບ້ານ — ເບິ່ງ, ເຮັດຕາມ, ເຮັດຊ້ຳ.</span>\n"
"                                                    <br/>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Yes. All memberships are "
"billed monthly and you can upgrade, downgrade or cancel at any time from "
"your account — changes take effect at the start of the next cycle.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">ແມ່ນແລ້ວ. ສະມາຊິກທຸກຮູບແບບຈະຮຽກເ"
"ກັບເງິນເປັນລາຍເດືອນ ແລະ ທ່ານສາມາດອັບເກຣດ, ດາວເກຣດ ຫຼື ຍົກເລີກໄດ້ຕະຫຼອດເວລາຈາກບັນຊີຂອງທ່ານ — "
"ການປ່ຽນແປງຈະມີຜົນໃນຮອບບິນຖັດໄປ.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_home
msgid ""
"<span style=\"font-size: 28px;\">Certified &amp;amp; Experienced coaches</"
"span>"
msgstr ""
"<span style=\"font-size: 28px;\">ຄູເຝິກທີ່ໄດ້ຮັບໃບຢັ້ງຢືນ &amp;amp; ມີປະສົບການ</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_home
msgid ""
"<span style=\"font-size: 28px;\">Flexible training times</span>\n"
"                                            <br/>"
msgstr ""
"<span style=\"font-size: 28px;\">ເວລາເຝິກຊ້ອມທີ່ຍືດຢຸ່ນ</span>\n"
"                                            <br/>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_home
msgid ""
"<span style=\"font-size: 28px;\">Modern equipment &amp;amp; clean "
"facilities</span>"
msgstr ""
"<span style=\"font-size: 28px;\">ອຸປະກອນທັນສະໄໝ &amp;amp; ສະຖານທີ່ສະອາດ</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_home
