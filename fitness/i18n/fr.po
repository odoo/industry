#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
#: model_terms:ir.ui.view,arch_db:fitness.view_page_eventsss
#: model_terms:ir.ui.view,arch_db:fitness.view_page_home
#: model_terms:ir.ui.view,arch_db:fitness.website_sale_products_oe_structure_website_sale_products_2
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Book a free intro session "
"and we'll build the plan with you.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Réservez une séance "
"d'initiation gratuite et nous élaborerons votre programme ensemble.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Build a confident base — "
"alignment, breath and the core reformer repertoire, at an unhurried pace.</"
"span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Construisez des bases "
"solides en toute confiance : alignement, respiration et exercices "
"fondamentaux sur Reformer, à votre rythme.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Choose a machine, select a "
"term at checkout (0% APR over 12 months, or up to 36 months), and a soft "
"credit check confirms your plan. Delivery, installation and warranty are "
"always included.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Choisissez une machine, "
"sélectionnez une durée lors du paiement (TAEG de 0 % sur 12 mois, ou jusqu'à "
"36 mois), puis une vérification de solvabilité simplifiée confirme votre "
"financement. La livraison, l'installation et la garantie sont toujours "
"incluses.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Every frame carries a 14-"
"year workshop warranty. Springs, upholstery and moving parts are covered for "
"three years, with servicing available through your membership.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Chaque structure bénéficie "
"d'une garantie atelier de 14 ans. Les ressorts, les revêtements et les "
"pièces mobiles sont couverts pendant trois ans, avec un service d'entretien "
"accessible dans le cadre de votre adhésion.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Home members get the full "
"on-demand library. Studio and Atelier members also get every live course "
"included at no extra cost, plus priority booking.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Les membres Home "
"bénéficient d'un accès complet à la bibliothèque de cours à la demande. Les "
"membres Studio et Atelier profitent également de tous les cours en direct "
"sans frais supplémentaires, ainsi que d'une réservation prioritaire.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Load, tempo and control. "
"Progress your practice with heavier spring work and standing sequences.</"
"span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Résistance, rythme et "
"contrôle. Progressez grâce à des exercices avec des ressorts plus résistants "
"et des enchaînements debout.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Stability, proprioception "
"and mobility work drawn from the barrel and corrector repertoire.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Des exercices de "
"stabilité, de proprioception et de mobilité issus du répertoire du Barrel et "
"du Corrector.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Twenty on-demand sessions "
"to get the most from a home reformer — watch, follow, repeat.</span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Vingt séances à la demande "
"pour tirer le meilleur parti de votre Reformer à domicile : regardez, "
"reproduisez, recommencez.</span>\n"
"                                                    <br/>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Yes. All memberships are "
"billed monthly and you can upgrade, downgrade or cancel at any time from "
"your account — changes take effect at the start of the next cycle.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Oui. Toutes les adhésions "
"sont facturées mensuellement et vous pouvez passer à une formule supérieure "
"ou inférieure, ou résilier à tout moment depuis votre compte. Les "
"modifications prennent effet au début du cycle suivant.</span>"

