#: model_terms:ir.ui.view,arch_db:fitness.view_page_home
#: model_terms:ir.ui.view,arch_db:fitness.website_sale_products_oe_structure_website_sale_products_2
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Book a free intro session "
"and we'll build the plan with you.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Programează o sesiune "
"introductivă gratuită și vom crea împreună un plan.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Build a confident base — "
"alignment, breath and the core reformer repertoire, at an unhurried pace.</"
"span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Construiește o bază solidă "
"— aliniere, respirație și exercițiile de bază pe Reformer, într-un ritm "
"relaxat.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Choose a machine, select a "
"term at checkout (0% APR over 12 months, or up to 36 months), and a soft "
"credit check confirms your plan. Delivery, installation and warranty are "
"always included.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Alege aparatul și perioada "
"la finalizarea comenzii (dobândă anuală de 0% pentru 12 luni sau până la 36 "
"de luni). O verificare preliminară a creditului confirmă planul. Livrarea, "
"instalarea și garanția sunt incluse.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Every frame carries a 14-"
"year workshop warranty. Springs, upholstery and moving parts are covered for "
"three years, with servicing available through your membership.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Fiecare cadru are o "
"garanție de 14 ani oferită de atelier. Arcurile, tapițeria și piesele mobile "
"sunt acoperite timp de trei ani, iar service-ul este disponibil prin "
"abonamentul tău.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Home members get the full "
"on-demand library. Studio and Atelier members also get every live course "
"included at no extra cost, plus priority booking.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Abonații Home au acces la "
"întreaga bibliotecă de sesiuni la cerere. Abonații Studio și Atelier "
"beneficiază și de toate cursurile live fără costuri suplimentare, plus "
"prioritate la rezervări.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Load, tempo and control. "
"Progress your practice with heavier spring work and standing sequences.</"
"span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Rezistență, ritm și "
"control. Avansează în antrenament cu arcuri mai puternice și serii de "
"exerciții în picioare.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Stability, proprioception "
"and mobility work drawn from the barrel and corrector repertoire.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.65);\">Exerciții de stabilitate, "
"propriocepție și mobilitate inspirate din repertoriul cu barrel și "
"corrector.</span>"

#. module: fitness
#: model_terms:ir.ui.view,arch_db:fitness.view_page_courses
