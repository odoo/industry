    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('fitness.website_industry').id).viewref('fitness.view_page_courses').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('fitness.view_page_courses').arch.replace(
                '*reformer_foundations_appointment_type*', str(obj().env.ref('fitness.appointment_type_3').id)).replace(
                '*strenght_springs_appointment_type*', str(obj().env.ref('fitness.appointment_type_4').id)).replace(
                '*balance_control_appointment_type*', str(obj().env.ref('fitness.appointment_type_5').id)).replace(
                '*cadillac_intensive_appointment_type*', str(obj().env.ref('fitness.appointment_type_6').id)).replace(
                '*home_practice_kickstart_appointment_type*', str(obj().env.ref('fitness.appointment_type_7').id)).replace(
                '*instructor_certification_appointment_type*', str(obj().env.ref('fitness.appointment_type_8').id)
            )}"/>
    </function>

    <data noupdate="1">
        <record id="page_courses" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_courses"/>
            <field name="url">/courses</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
            <field name="header_text_color">text-o-color-4</field>
        </record>
    </data>
</odoo>
