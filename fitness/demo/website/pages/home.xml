    </record>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('fitness.website_industry').id).viewref('fitness.view_page_home').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('fitness.view_page_home').arch.replace(
                '*reformer_foundations_appointment_type*', str(obj().env.ref('fitness.appointment_type_3').id)).replace(
                '*cadillac_intensive_appointment_type*', str(obj().env.ref('fitness.appointment_type_6').id)).replace(
                '*instructor_certification_appointment_type*', str(obj().env.ref('fitness.appointment_type_8').id)).replace(
                '*basic_plan_product*', obj().env.ref('fitness.product_template_4').website_url).replace(
                '*pro_plan_product*', obj().env.ref('fitness.product_template_5').website_url).replace(
                '*elite_plan_product*', obj().env.ref('fitness.product_template_6').website_url)
            }"/>
    </function>

    <data noupdate="1">
        <record id="page_home" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_home"/>
            <field name="url">/</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
            <field name="header_text_color">text-o-color-4</field>
        </record>
    </data>
