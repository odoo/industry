<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="appointments_card_top" model="ir.ui.view">
        <field name="name">Fitness Center - Appointment Types Selection (oe_structure_appointments_card_top)</field>
        <field name="inherit_id" ref="website_appointment.appointments_selection_layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_appointments_card_top']" position="inside">
                <section class="s_picture o_colored_level pb0 pt4" data-snippet="s_picture" data-name="Title - Image">
                    <div class="o_container_small">
                        <h2 style="text-align: center;">Courses Schedule</h2>
                        <div class="row">
                            <div class="col-lg-12 pt24 o_colored_level" style="text-align: center;">
                                <figure class="figure w-100">
                                    <img src="/web/image/fitness.img_custom_fitness_image_31" class="figure-img img-fluid rounded img o_we_custom_image" loading="lazy"/>
                                </figure>
                            </div>
                        </div>
                    </div>
                </section>
            </xpath>
        </field>
    </record>
</odoo>
