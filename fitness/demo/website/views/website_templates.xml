<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom Fitness - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-right-width: 0px; border-color: rgba(255, 255, 255, 0.21) !important;">
                    <section class="s_text_block pb16 s_parallax_no_overflow_hidden pt64" data-snippet="s_text_block" data-name="Container" data-scroll-background-ratio="0">
                        <div class="container">
                            <div class="row">
                                <div class="pt24 pb24 o_colored_level s_parallax_no_overflow_hidden col-lg-3" data-scroll-background-ratio="0">
                                    <p>
                                        <img src="/web/image/fitness.img_custom_fitness_image_30" alt="Pulse logo" class="img img-fluid o_we_custom_image" style="width: 50% !important;" loading="lazy"/>
                                    </p>
                                    <p style="color: rgba(255, 255, 255, 0.65);">Find your strength</p>
                                </div>
                                <div class="pt24 pb24 s_parallax_no_overflow_hidden o_colored_level offset-lg-3 col-lg-2" data-scroll-background-ratio="0">
                                    <p>
                                        <span class="o_small-fs">
                                            <font class="text-o-color-1">EXPLORE</font>
                                        </span>
                                        <br/>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li>
                                            <a href="/">Home</a>
                                        </li>
                                        <li>
                                            <a href="/about-us">About</a>
                                        </li>
                                        <li>
                                            <a href="/shop">Products</a>
                                        </li>
                                        <li>
                                            <a href="/courses">Courses</a>
                                        </li>
                                        <li>
                                            <a href="/our-events" class="o_translate_inline">Events</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-lg-2 pt24 pb24 s_parallax_no_overflow_hidden o_colored_level" data-scroll-background-ratio="0">
                                    <p>
                                        <span class="o_small-fs">
                                            <font class="text-o-color-1">VISIT</font>
                                        </span>
                                        <br/>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li>412 Ironside Ave</li>
                                        <li>Portland, OR 97204</li>
                                        <li>
                                            <br/>
                                        </li>
                                        <li>Mon–Sun · 6am–11pm</li>
                                    </ul>
                                </div>
                                <div class="col-lg-2 pt24 pb24 s_parallax_no_overflow_hidden o_colored_level" data-scroll-background-ratio="0">
                                    <p>
                                        <span class="o_small-fs">
                                            <font class="text-o-color-1">CONTACT</font>
                                        </span>
                                        <br/>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li>
                                            <a href="mailto:hello@pulse.fit" class="o_translate_inline">hello@pulse.fit</a>
                                        </li>
                                        <li>
                                            <a href="tel:+15035550142" class="o_translate_inline">+1 (503) 555-0142</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="pt24 pb24 o_colored_level col-lg-12 border s_parallax_no_overflow_hidden" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; border-color: rgba(255, 255, 255, 0.21) !important;" data-scroll-background-ratio="0">
                                    <p>
                                        <span class="o_small-fs">
                                            <font style="color: rgba(255, 255, 255, 0.47);">© 2026 Pulse fitness club</font>
                                        </span>
                                    </p>

                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom Fitness - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-primary">Book a free session</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
</odoo>
