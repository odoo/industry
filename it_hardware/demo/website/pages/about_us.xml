        <field name="arch" type="xml">
            <t t-name="it_hardware.page_about_us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_image pt80 o_colored_level pb56" data-snippet="s_text_image" data-name="Text - Image">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="pt16 pb16 o_colored_level col-lg-6 o_animate o_anim_fade_in o_visible o_anim_from_left" style="--wanim-intensity: 5; animation-name: dummy;">
                                        <h1 class="display-4-fs">
                                            <span class="text-white">The</span> <span class="o_text_highlight o_text_highlight_underline text-o-color-1" style="--text-highlight-color: #ef692e; --text-highlight-width: 2px;">OctoCore</span><span class="text-white"> Spark</span>
                                        </h1>
                                        <p>
                                            <br/>
                                        </p>
                                        <p class="lead">
                                            <span class="h3-fs">It all started with a simple realization: hardware should never be a bottleneck to your passion or productivity.</span>
                                        </p>
                                    </div>
                                    <div class="offset-lg-1 pt16 pb16 o_colored_level col-lg-5 o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 10; animation-name: dummy;">
                                        <p>
                                            <img src="/web/image/it_hardware.img_it_hardware_image_24" alt="Inside of a gaming PC lit by red RGB lighting" class="img img-fluid o_we_custom_image rounded" data-format-mimetype="image/webp" data-resize-width="1280" data-mimetype="image/webp" data-aspect-ratio="0/0" data-y="444.37301587301585" data-width="1280" data-height="1094.7063492063492" data-scale-x="1" data-scale-y="1" loading="lazy"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_about_bold o_colored_level pb96 pt48" data-snippet="s_about_bold" data-name="About Bold">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_animate o_anim_fade_in o_visible o_anim_from_bottom o_colored_level offset-lg-3 col-lg-6" style="--wanim-intensity: 10; animation-name: dummy;">
                                        <p class="lead">
                                            <span class="h5-fs">Founded in 2020 by a team of passionate hardware engineers and seasoned gamers, OctoCore was born with a clear mission: to create perfectly balanced, reliable, and high-performance custom machines. Tired of pre-built systems with hidden bottlenecks and impersonal customer support, we decided to rebuild the tech buying experience from the ground up.</span>
                                        </p>
                                        <p class="lead">
                                            <span class="h5-fs">What began as a specialized build lab for the local eSports scene quickly evolved into a leading destination for precision hardware. Today, OctoCore equips thousands of gamers, content creators, developers, and businesses seeking uncompromised performance.</span>
                                        </p>
                                        <p>
                                            <br/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_features o_colored_level o_cc o_cc3 pb88 pt72" data-snippet="s_features" data-name="Features">
