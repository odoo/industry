<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="signup_separators" model="ir.ui.view">
        <field name="name">Custom - Sign up separators</field>
        <field name="key">it_hardware.signup_separators</field>
        <field name="inherit_id" ref="auth_signup.signup"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_signup_top']" position="inside">
                <section class="s_text_block o_colored_level pt0 pb0" data-snippet="s_text_block" data-name="Text">
                    <div class="container s_allow_columns">
                        <div class="s_hr o_colored_level pb16 pt16" data-snippet="s_hr" data-name="Separator">
                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                        </div>
                    </div>
                </section>
            </xpath>
            <xpath expr="//div[@id='oe_structure_signup_bottom']" position="inside">
                <section class="s_text_block pt0 pb0 o_colored_level" data-snippet="s_text_block" data-name="Text">
                    <div class="container s_allow_columns">
                        <div class="s_hr pt32 pb32" data-snippet="s_hr" data-name="Separator">
                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                        </div>
                    </div>
                </section>
            </xpath>
        </field>
    </record>
</odoo>
