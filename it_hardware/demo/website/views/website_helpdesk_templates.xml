<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_team" model="ir.ui.view">
        <field name="name">Custom - Helpdesk Team</field>
        <field name="key">it_hardware.helpdesk_team</field>
        <field name="inherit_id" ref="website_helpdesk.team"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[@id='team-page']/.." position="attributes">
                <attribute name="class" add="col-lg-12" separator=" "/>
            </xpath>
            <xpath expr="//div[@id='oe_structure_website_helpdesk_team_4']" position="inside">
                <div class="s_hr pb32 o_colored_level pt48" data-snippet="s_hr" data-name="Separator">
                    <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                </div>
            </xpath>
        </field>
    </record>
    <record id="helpdesk_team_form" model="ir.ui.view">
        <field name="name">Custom - Helpdesk: Submit a Ticket Form</field>
        <field name="type">qweb</field>
        <field name="key">it_hardware.helpdesk_team_form</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Helpdesk: Submit a Ticket Form" t-name="it_hardware.helpdesk_team_form">
                <div class="container">
                    <h2>
                        Submit a Ticket
                        <t t-if="multiple_teams"> - <t t-out="team.name"/></t>
                    </h2>
                    <div class="oe_structure" id="oe_structure_whelpdesk_form_1">
                        <div class="s_hr pb32 o_colored_level pt16" data-snippet="s_hr" data-name="Separator">
                            <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-1);"/>
                        </div>
                    </div>
                    <span class="hidden" data-for="helpdesk_ticket_form" t-att-data-values="{'team_id': team and team.id or ''}"/>
                    <div id="helpdesk_section" class="">
                        <p class="lead">Encountering a technical issue, a bug, or need help optimizing your system? Fill out the form below to reach our dedicated tech team. Provide as much detail as possible so we can diagnose your problem and get you back in the game fast.</p>
                        <div class="s_hr pb32 o_colored_level pt0" data-snippet="s_hr" data-name="Separator">
                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                        </div>
                        <section class="s_website_form pt16 pb16 o_colored_level" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                            <div class="container">
                                <form id="helpdesk_ticket_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-success-mode="redirect" data-success-page="/your-ticket-has-been-submitted" data-model_name="helpdesk.ticket" hide-change-model="true">
                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char">
                                            <label class="s_website_form_label" for="helpdesk1" style="width: 200px;">
                                                <span class="s_website_form_label_content">Full Name</span>
                                                <span class="s_website_form_mark">  *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="text" name="partner_name" required="" value="" placeholder="" id="helpdesk1" data-fill-with="name" />
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="char">
                                            <label class="s_website_form_label" for="helpdesk2" style="width: 200px;">
                                                <span class="s_website_form_label_content">Phone Number</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="tel" name="partner_phone" value="" placeholder="" id="helpdesk2" data-fill-with="phone" />
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_required" data-type="email">
                                            <label class="s_website_form_label" for="helpdesk3" style="width: 200px;">
                                                <span class="s_website_form_label_content">Email Address</span>
                                                <span class="s_website_form_mark">  *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="email" name="partner_email" required="" value="" placeholder="" id="helpdesk3" data-fill-with="email" />
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="char">
                                            <label class="s_website_form_label" for="helpdesk4" style="width: 200px;">
                                                <span class="s_website_form_label_content">Company Name</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="text" name="partner_company_name" value="" placeholder="" id="helpdesk4" data-fill-with="parent_name" />
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char">
                                            <label class="s_website_form_label" for="helpdesk5" style="width: 200px;">
                                                <span class="s_website_form_label_content">Message Subject</span>
                                                <span class="s_website_form_mark">  *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="helpdesk5" data-fill-with="undefined" />
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text">
                                            <label class="s_website_form_label" for="helpdesk6" style="width: 200px;">
                                                <span class="s_website_form_label_content">Ask Your Question</span>
                                                <span class="s_website_form_mark">   *</span>
                                            </label>
                                            <textarea class="form-control s_website_form_input" name="description" required="1" id="helpdesk6" rows="5" />
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="binary">
                                            <label class="s_website_form_label" for="helpdesk7" style="width: 200px;">
                                                <span class="s_website_form_label_content">Attachment</span>
                                            </label>
                                            <input type="file" class="form-control s_website_form_input" name="Attachment" id="helpdesk7" data-max-files-number="1" data-max-file-size="64" data-fill-with="undefined" />
                                        </div>
                                        <div class="mb-0 py-2 s_website_form_field col-12 s_website_form_dnone" data-name="Field" data-type="record" data-model="helpdesk.team">
                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                                            <span class="s_website_form_label_content">Helpdesk Team</span>
                                        </label>
                                                <div class="col-sm">
                                                    <input type="hidden" class="form-control s_website_form_input" name="team_id" id="helpdesk8"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                            <div style="width: 200px;" class="s_website_form_label"/>
                                            <a href="#" role="button" class="btn btn-primary btn-lg s_website_form_send">Send your request</a><span id="s_website_form_result"/>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </section>
                    </div>
                </div>
            </t>
        </field>
    </record>
</odoo>
