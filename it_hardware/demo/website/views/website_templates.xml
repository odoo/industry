<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="template_footer_descriptive" model="ir.ui.view">
        <field name="name">Custom - Descriptive</field>
        <field name="key">website.template_footer_descriptive</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="border-left-color: var(--o-color-1) !important; border-bottom-color: var(--o-color-1) !important; border-right-color: var(--o-color-1) !important; border-top-color: var(--o-color-1) !important; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pt40" data-snippet="s_text_block" data-name="Container" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Blurry/10&quot;,&quot;colors&quot;:{&quot;c1&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[&quot;y&quot;,&quot;x&quot;],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                        <div class="o_we_shape o_html_builder_Blurry_10 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FBlurry%2F10.svg?c1=%230D1322&amp;flip=xy&quot;); background-position: 50% 0%;"/>
                        <div class="s_allow_columns container">
                            <div class="row">
                                <div class="o_colored_level col-lg-3 col-7 pb24 pt0">
                                    <p>
                                        <img src="/web/image/it_hardware.img_it_hardware_image_32" alt="Logo of OctoCore" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="1024" data-mimetype="image/webp" style="width: 50% !important;" loading="lazy" data-quality="0"/>
                                    </p>
                                </div>
                                <div class="o_colored_level offset-lg-3 col-lg-3 pb0 pt0">
                                    <p>
                                        <span class="h5-fs">
                                            <strong>
                                                <span class="text-o-color-1">WHERE TO FIND US</span>
                                            </strong>
                                        </span>
                                        <br/>
                                        Rue du Laid Burniat 5<br/>
                                        1348 Ottignies-Louvain-la-Neuve<br/>
                                        Belgium
                                    </p>
                                </div>
                                <div class="pb48 o_colored_level col-lg-3 pt8">
                                    <ul class="list-unstyled mb-2">
                                        <li>
                                            <i class="oi oi-filled oi-fw me-2" data-icon="phone"/><span class="o_force_ltr"><a href="tel:+15555555556"><span class="text-o-color-1">+1 555-555-5556</span></a></span>
                                            <br/>
                                        </li>
                                        <li>
                                            <i class="oi oi-filled oi-fw me-2" data-icon="mail"/><span><a href="mailto:contact@octocore.example.com"><span class="text-o-color-1">contact@octocore.example.com</span></a></span>
                                            <br/>
                                        </li>
                                    </ul>
                                    <div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="#" class="s_social_media_facebook" target="_blank">
                                            <i class="oi o_editable_media rounded shadow-sm o_cc o_cc1" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="#" class="s_social_media_twitter" target="_blank">
                                            <i class="oi o_editable_media rounded shadow-sm o_cc o_cc1" data-icon="oi_x"/>
                                        </a>
                                        <a href="#" class="s_social_media_instagram" target="_blank">
                                            <i class="oi o_editable_media rounded shadow-sm o_cc o_cc1" data-icon="oi_instagram"/>
                                        </a>
                                        <a href="#" class="s_social_media_linkedin" target="_blank">
                                            <i class="oi o_editable_media rounded shadow-sm o_cc o_cc1" data-icon="oi_linkedin"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
