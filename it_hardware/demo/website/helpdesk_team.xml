<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Customer Care stays on the website it was created on: the demo website
         gets its own team, using the ticket form of the design. -->
    <record id="helpdesk_team_website" model="helpdesk.team">
        <field name="name">Online Support</field>
        <field name="use_product_returns" eval="True"/>
        <field name="use_product_repairs" eval="True"/>
        <field name="use_website_helpdesk_form" eval="True"/>
        <field name="website_id" ref="website_industry"/>
        <field name="website_form_view_id" ref="helpdesk_team_form"/>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
