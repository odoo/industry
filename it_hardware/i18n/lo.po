#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_9
msgid ""
"<b>Acoustic &amp; Feel:</b> Gasket-Mounted Structure with Dual-Layer "
"Silicone &amp; PORON Sound Dampening Foam"
msgstr ""
"<b>ສຽງ ແລະ ສຳຜັດ:</b> ໂຄງສ້າງແບບ Gasket-Mounted ພ້ອມຊີລິໂຄນສອງຊັ້ນ &amp; ໂຟມຊັບສຽງ "
"PORON"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_20
msgid ""
"<b>Active Noise Cancellation:</b> Hybrid Dual-Chamber ANC (-38dB attenuation "
"with Transparency Mode)"
msgstr ""
"<b>ລະບົບຕັດສຽງລົບກວນແບບ Active:</b> Hybrid Dual-Chamber ANC (ຫຼຸດສຽງລົບກວນ -38dB ພ້ອ"
"ມໂໝດ Transparency ຮັບສຽງພາຍນອກ)"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_19
msgid ""
"<b>Adaptive Sync:</b> NVIDIA® G-SYNC® Compatible &amp; AMD FreeSync™ Premium "
"Pro"
msgstr ""
"<b>Adaptive Sync:</b> ຮອງຮັບ NVIDIA® G-SYNC® &amp; AMD FreeSync™ Premium Pro"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_16
msgid "<b>Architecture:</b> Zen 4 (5nm FinFET)"
msgstr "<b>ສະຖາປັດຕະຍະກຳ:</b> Zen 4 (5nm FinFET)"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_18
msgid ""
"<b>Audio:</b> SupremeFX 7.1 Surround Sound High-Definition Audio Codec with "
"ESS SABRE DAC"
msgstr ""
"<b>ລະບົບສຽງ:</b> ລະບົບສຽງຮອບທິດທາງ SupremeFX 7.1 High-Definition Audio Codec ພ້ອມ"
"ຊິບ ESS SABRE DAC"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_9
msgid ""
"<b>Battery Life:</b> Up to 200 Hours (RGB Off) / 40 Hours (RGB On) via "
"4000mAh Rechargeable Battery"
msgstr ""
"<b>ອາຍຸການໃຊ້ງານແບັດເຕີຣີ:</b> ສູງສຸດ 200 ຊົ່ວໂມງ (ປິດ RGB) / 40 ຊົ່ວໂມງ (ເປີດ RGB) ດ້ວຍແບັດ"
"ເຕີຣີ 4000mAh ທີ່ສາມາດສາກໄດ້"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_20
msgid ""
"<b>Battery Life:</b> Up to 60 Hours (ANC Off) / 45 Hours (ANC On) | Fast USB-"
"C Charge (15 min = 6 hrs)"
msgstr ""
"<b>ອາຍຸການໃຊ້ງານແບັດເຕີຣີ:</b> ສູງສຸດ 60 ຊົ່ວໂມງ (ປິດ ANC) / 45 ຊົ່ວໂມງ (ເປີດ ANC) | ສາກໄວ"
"ຜ່ານ USB-C (15 ນາທີ = 6 ຊົ່ວໂມງ)"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_8
msgid ""
"<b>Battery Life:</b> Up to 80 hours (2.4GHz Wireless) / Fast USB-C Charging"
msgstr ""
"<b>ອາຍຸການໃຊ້ງານແບັດເຕີຣີ:</b> ສູງສຸດ 80 ຊົ່ວໂມງ (ໄຮ້ສາຍ 2.4GHz) / ສາກໄວຜ່ານ USB-C"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_16
msgid "<b>Cache:</b> 104MB Total (L2+L3 with 3D V-Cache™)"
msgstr "<b>ແຄຊ (Cache):</b> ທັງໝົດ 104MB (L2+L3 ພ້ອມ 3D V-Cache™)"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_17
msgid "<b>Capacity:</b> 16GB Kit (2x 8GB Dual-Channel)"
msgstr "<b>ຄວາມຈຸ:</b> ຊຸດ 16GB (2x 8GB Dual-Channel)"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_16
msgid "<b>Clock Speeds:</b> 4.2 GHz Base / 5.0 GHz Max Boost"
msgstr "<b>ຄວາມໄວໂມງ:</b> ພື້ນຖານ 4.2 GHz / ສູງສຸດ 5.0 GHz Max Boost"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_19
msgid ""
"<b>Color &amp; HDR:</b> 10-bit (1.07 Billion colors), 99.3% DCI-P3, VESA "
"DisplayHDR True Black 400"
msgstr ""
"<b>ສີສັນ &amp; HDR:</b> 10-ບິດ (1.07 ຕື້ສີ), 99.3% DCI-P3, VESA DisplayHDR True "
"Black 400"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_19
msgid ""
"<b>Connectivity:</b> 2x HDMI 2.1, 1x DisplayPort 1.4a, 1x USB-C (90W Power "
"Delivery + DP Alt Mode), USB Hub"
msgstr ""
"<b>ການເຊື່ອມຕໍ່:</b> 2x HDMI 2.1, 1x DisplayPort 1.4a, 1x USB-C (ຈ່າຍໄຟ 90W Power "
"Delivery + DP Alt Mode), USB Hub"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_8
msgid ""
"<b>Connectivity:</b> Tri-Mode (2.4GHz Wireless, Bluetooth 5.2, Paracord "
"Wired)"
msgstr "<b>ການເຊື່ອມຕໍ່:</b> 3 ໂໝດ (ໄຮ້ສາຍ 2.4GHz, Bluetooth 5.2, ສາຍ Paracord)"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_9
msgid ""
"<b>Connectivity:</b> Tri-Mode Connectivity (Ultra-fast 2.4GHz Wireless, "
"Bluetooth 5.1, Detachable USB-C)"
msgstr ""
"<b>ການເຊື່ອມຕໍ່:</b> ການເຊື່ອມຕໍ່ 3 ໂໝດ (ໄຮ້ສາຍຄວາມໄວສູງ 2.4GHz, Bluetooth 5.1, ສາຍ "
"USB-C ແບບຖອດໄດ້)"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_19
msgid ""
"<b>Contrast Ratio:</b> 1,500,000:1 (Infinite Contrast &amp; Deep Blacks)"
msgstr ""
"<b>ອັດຕາສ່ວນຄວາມຄົມຊັດ:</b> 1,500,000:1 (ຄວາມຄົມຊັດບໍ່ຈຳກັດ &amp; ດຳສະໜິດ)"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_9
msgid ""
"<b>Control Features:</b> Programmable CNC Aluminum Rotary Knob for Volume/"
"Brightness Control"
msgstr ""
"<b>ຄຸນສົມບັດການຄວບຄຸມ:</b> ປຸ່ມໝຸນອາລູມີນຽມ CNC ຕັ້ງຄ່າໄດ້ ສຳລັບຄວບຄຸມລະດັບສຽງ/ຄວາມສະຫວ່າງ"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_24
msgid ""
"<b>Cooling &amp; Case:</b> OctoCore CryoLoop 360mm ARGB Liquid Cooler &amp; "
"Full-Tower High-Airflow Showcase Chassis"
msgstr ""
"<b>ລະບົບລະບາຍຄວາມຮ້ອນ &amp; ເຄສ:</b> ຊຸດນ້ຳປິດ OctoCore CryoLoop 360mm ARGB &amp; "
"ເຄສ Full-Tower ລະບາຍອາກາດດີພ້ອມຝາຂ້າງໃສ"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_22
msgid ""
"<b>Cooling &amp; Case:</b> OctoCore Pulse Mid-Tower with Tempered Glass "
"&amp; Dual ARGB Fans"
msgstr ""
"<b>ລະບົບລະບາຍຄວາມຮ້ອນ &amp; ເຄສ:</b> ເຄສ OctoCore Pulse Mid-Tower ພ້ອມແວ່ນ "
"Tempered Glass &amp; ພັດລົມ ARGB ຄູ່"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_21
msgid ""
"<b>Cooling &amp; Case:</b> OctoCore Stealth Micro-ATX Tower with Airflow "
"Mesh &amp; Addressable RGB Intake"
msgstr ""
"<b>ລະບົບລະບາຍຄວາມຮ້ອນ &amp; ເຄສ:</b> ເຄສ OctoCore Stealth Micro-ATX ພ້ອມຕາໜ່າງລະບ"
"າຍອາກາດ &amp; ພັດລົມດູດເຂົ້າ Addressable RGB"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_23
msgid ""
"<b>Cooling &amp; Case:</b> OctoCore ThermalArmor AIO Liquid Cooler (240mm) "
"&amp; High-Airflow Mid-Tower with Dual Tempered Glass"
msgstr ""
"<b>ລະບົບລະບາຍຄວາມຮ້ອນ &amp; ເຄສ:</b> ຊຸດນ້ຳປິດ OctoCore ThermalArmor AIO (240mm) "
"&amp; ເຄສ Mid-Tower ລະບາຍອາກາດດີ ພ້ອມແວ່ນ Tempered Glass ສອງດ້ານ"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_16
msgid "<b>Cores / Threads:</b> 8 Cores / 16 Threads"
msgstr "<b>ຄໍຣ໌ / ເທຣດ:</b> 8 ຄໍຣ໌ / 16 ເທຣດ"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_19
msgid ""
"<b>Display Size &amp; Panel:</b> 34″ UWQHD (3440 x 1440) Curved 1800R QD-OLED"
msgstr ""
"<b>ຂະໜາດຈໍ &amp; ແຜງໜ້າຈໍ:</b> 34″ UWQHD (3440 x 1440) ຈໍໂຄ້ງ 1800R QD-OLED"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_20
msgid "<b>Drivers:</b> Custom 50mm Neodymium Graphene Drivers"
msgstr "<b>ໄດຣເວີ:</b> ໄດຣເວີ Graphene Neodymium 50 ມມ ແບບກຳນົດເອງ"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_20
msgid ""
"<b>Earpads &amp; Build:</b> Breathable Memory Foam with Cooling Gel Layer "
"&amp; Lightweight Steel Frame"
msgstr ""
"<b>ຟອງນ້ຳຄອບຫູ &amp; ໂຄງສ້າງ:</b> Memory Foam ລະບາຍອາກາດໄດ້ ພ້ອມຊັ້ນເຈວເຢັນ &amp; ໂຄງ"
"ເຫຼັກນ້ຳໜັກເບົາ"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_19
msgid ""
"<b>Ergonomics &amp; Design:</b> Height, Tilt &amp; Swivel Adjustable, "
"Integrated OLED Care Cooling System, Custom RGB Halo Backlight"
msgstr ""
"<b>ການອອກແບບຕາມຫຼັກສະຣີລະສາດ:</b> ປັບຄວາມສູງ, ກົ້ມເງີຍ &amp; ໝຸນຊ້າຍຂວາໄດ້, ມີລະບົບລະບາຍຄວ"
"າມຮ້ອນປ້ອງກັນ OLED ໃນຕົວ, ໄຟຫຼັງ RGB Halo ແບບກຳນົດເອງ"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_18
msgid ""
"<b>Expansion Slots:</b> 2x PCIe 5.0 x16 (Supports x16 or x8/x8), 1x PCIe 4.0 "
"x16"
msgstr ""
"<b>ຊ່ອງສຽບຂະຫຍາຍ:</b> 2x PCIe 5.0 x16 (ຮອງຮັບ x16 ຫຼື x8/x8), 1x PCIe 4.0 x16"

#. module: it_hardware
#: model_terms:product.template,description_ecommerce:it_hardware.product_template_9
msgid ""
"<b>Form Factor &amp; Layout:</b> Compact 75% Layout (84 Keys) with CNC "
