#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>1. Recruitment: Finding the Right Talent</b>"
msgstr "<b>1. Recrutare: găsirea talentelor potrivite</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>2. Employee Setup: Defining Roles</b>"
msgstr "<b>2. Configurarea angajaților: definirea rolurilor</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>3. Planning: The Three-Step Workflow</b>"
msgstr "<b>3. Planificare: fluxul de lucru în trei pași</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Access Settings:</b> Navigate to <b>Settings</b> &gt; <b>Calendar</b> "
"&gt; <b>Sync External Calendar</b>."
msgstr ""
"<b>Accesați setările:</b> mergeți la <b>Setări</b> &gt; <b>Calendar</b> &gt; "
"<b>Sincronizare calendar extern</b>."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Attendee Management:</b> Track your guest list in real-time and send "
"digital tickets/badges via email\n"
"                automatically."
msgstr ""
"<b>Gestionarea participanților:</b> urmăriți lista de invitați în timp real "
"și trimiteți automat bilete/ecusoane digitale prin e-mail."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Automated Booking:</b> Enable online registration to let attendees book "
"their spots instantly."
msgstr ""
"<b>Rezervare automată:</b> activați înscrierea online pentru ca "
"participanții să-și poată rezerva imediat locurile."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Automated Stock Transfers</b>"
msgstr "<b>Transferuri automate de stoc</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Automatic Conflict Prevention:</b> If you have already scheduled an "
"internal event or a staff\n"
"                        \"Montage\" (setup) in the <b>Planning app</b> for "
"that location, Odoo will automatically gray out\n"
"                        those dates on your website."
msgstr ""
"<b>Prevenirea automată a conflictelor:</b> dacă ați programat deja un "
"eveniment intern sau o tură de „montaj” în aplicația <b>Planificare</b> "
"pentru locația respectivă, Odoo va dezactiva automat acele date pe site-ul "
"web."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Centralized Documentation</b>"
msgstr "<b>Documentație centralizată</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Centralized Logistics Overview</b>"
msgstr "<b>Vedere de ansamblu centralizată asupra logisticii</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Client Rentals:</b> Standard orders with specific pricing and automated "
"invoicing. (like Jessica Martinez in the demo data)"
msgstr ""
"<b>Închirieri pentru clienți:</b> comenzi standard cu prețuri specifice și "
"facturare automată (de exemplu, Jessica Martinez din datele demonstrative)."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Complex Project Management: </b>Open the \"City Festival – Summer in the "
"Square – Brussels\" opportunity."
msgstr ""
"<b>Gestionarea proiectelor complexe: </b>deschideți oportunitatea „"
"Festivalul orașului – Vară în piață – Bruxelles”."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Conflict Alerts:</b> When creating a rental quotation, a <b>red icon</b> "
"will appear next to a line item\n"
"                if Odoo detects a stock shortage for those dates."
msgstr ""
"<b>Alerte de conflict:</b> la crearea unei oferte de închiriere, lângă o "
"linie va apărea o <b>pictogramă roșie</b> dacă Odoo detectează lipsă de stoc "
"pentru datele respective."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Consumable Products:</b> Items that appear on your picking lists but do "
"not require strict inventory\n"
"                tracking."
msgstr ""
"<b>Produse consumabile:</b> articole care apar pe listele de ridicare, dar "
"nu necesită urmărirea strictă a stocului."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Custom Stages:</b> Tailor project and task stages to align perfectly with "
"your team’s specific internal\n"
"                processes."
msgstr ""
"<b>Etape personalizate:</b> adaptați etapele proiectelor și activităților la "
"procesele interne ale echipei."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Delivery:</b> From your Warehouse to the Client."
msgstr "<b>Livrare:</b> din depozitul dvs. către client."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Direct-to-Event (Dropshipping):</b> For items that should go straight to "
"the venue, change the\n"
"                <b>\"Deliver To\"</b> field to <b>\"Dropship\"</b> and "
"select the event location as the address."
msgstr ""
"<b>Livrare directă la eveniment (dropshipping):</b> pentru articolele "
"livrate direct la locație, setați câmpul <b>„Livrare către”</b> la <b>„"
"Dropshipping”</b> și alegeți adresa locației evenimentului."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Discounts:</b> Apply price adjustments directly to line items."
msgstr "<b>Reduceri:</b> ajustați prețurile direct pe liniile de comandă."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Easy Sharing:</b> Simply copy the <b>Share Link</b> for any document and "
"send it to your team along with\n"
"                their schedule (see planning section)"
msgstr ""
"<b>Partajare simplă:</b> copiați <b>linkul de partajare</b> al unui document "
"și trimiteți-l echipei împreună cu programul (consultați secțiunea "
"Planificare)."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Establish the Connection:</b> Link each user’s external account to the "
"Odoo Calendar app."
msgstr ""
"<b>Stabiliți conexiunea:</b> conectați contul extern al fiecărui utilizator "
"la aplicația Calendar din Odoo."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>External Calendar Synchronization</b>"
msgstr "<b>Sincronizarea calendarului extern</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Flexible Delivery &amp; Dropshipping</b>"
msgstr "<b>Livrare flexibilă și dropshipping</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Flexible Rental Management</b>"
msgstr "<b>Gestionarea flexibilă a închirierilor</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Flexible Ticketing:</b> Configure multiple ticket tiers (e.g., Early "
"Bird, VIP, or General Admission)\n"
"                with custom pricing."
msgstr ""
"<b>Bilete flexibile:</b> configurați mai multe categorii de bilete (de "
"exemplu, Early Bird, VIP sau acces general) cu prețuri personalizate."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Granular Control:</b> Manage deadlines, assignees, internal notes, and "
"sub-tasks for every stage of the\n"
"                project."
msgstr ""
"<b>Control detaliat:</b> gestionați termenele, responsabilii, notele interne "
"și subactivitățile pentru fiecare etapă a proiectului."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>How it Works in Practice</b>"
msgstr "<b>Cum funcționează în practică</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Install eCommerce:</b> Ensure the <b>eCommerce app</b> is active."
msgstr ""
"<b>Instalați Comerț electronic:</b> asigurați-vă că aplicația <b>Comerț "
"electronic</b> este activă."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Integrated Budgeting:</b> Launch a <b>Request for Quotation (RFQ)</b> "
"directly from the project’s smart\n"
"                buttons to ensure all costs are automatically factored into "
"your <b>Project Profitability</b>."
msgstr ""
"<b>Bugetare integrată:</b> lansați o <b>cerere de ofertă (RFQ)</b> direct "
"din butoanele inteligente ale proiectului, astfel încât toate costurile să "
"fie incluse automat în <b>rentabilitatea proiectului</b>."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Internal Maintenance:</b> Blocks off equipment for repairs or quality "
"checks so it isn't accidentally\n"
"                booked."
msgstr ""
"<b>Întreținere internă:</b> blocați echipamentele pentru reparații sau "
"verificări de calitate, ca să nu fie rezervate din greșeală."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Internal Picking Lists:</b> For items not covered by rentals (like "
"consumables), you can manually create\n"
"                a <b>Picking List</b>. Simply set the <i>Destination</i> to "
"the event location, select your products, and\n"
"                set the date."
msgstr ""
"<b>Liste interne de ridicare:</b> pentru articolele care nu sunt acoperite "
"de închirieri (precum consumabilele), puteți crea manual o <b>listă de "
"ridicare</b>. Setați <i>Destinația</i> la locația evenimentului, selectați "
"produsele și indicați data."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Internal Warehouse:</b> By default, Odoo assumes items (like new stock) "
"are coming to your warehouse."
msgstr ""
"<b>Depozit intern:</b> implicit, Odoo presupune că articolele (de exemplu, "
"stocul nou) sunt livrate la depozitul dvs."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Large-Scale Events:</b> Rentals bundled into a larger project at $0 "
"(since the cost is already covered in\n"
"                the overall package)."
msgstr ""
"<b>Evenimente de amploare:</b> închirieri incluse într-un proiect mai mare "
"la prețul de 0, deoarece costul este deja acoperit de pachetul general."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Live Availability:</b> Customers can only book the dates where the venue "
"is free."
msgstr ""
"<b>Disponibilitate în timp real:</b> clienții pot rezerva doar datele în "
"care locația este liberă."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Logistics Overview</b>"
msgstr "<b>Prezentare generală a logisticii</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Managing Your Own Venue &amp; Location Bookings: </b>If you own the venue "
"where your events take place, you can\n"
"            use Odoo to manage its availability and even allow external "
"clients to book the space online when you aren't\n"
"            using it."
msgstr ""
"<b>Gestionarea propriei locații și a rezervărilor: </b>dacă dețineți spațiul "
"în care au loc evenimentele, puteți folosi Odoo pentru a-i gestiona "
"disponibilitatea și pentru a permite clienților externi să-l rezerve online "
"atunci când nu îl utilizați."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Official Paperwork:</b> Contracts and legal authorizations (City, Police, "
"etc.)."
msgstr ""
"<b>Documente oficiale:</b> contracte și autorizații legale (primărie, "
"poliție etc.)."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Online Presence:</b> Create beautiful event pages and publish them "
"directly to your website."
msgstr ""
"<b>Prezență online:</b> creați pagini atractive pentru evenimente și "
"publicați-le direct pe site-ul web."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Pipeline Management:</b> Track applications, conduct interviews, and hire "
"your team in one centralized\n"
"                dashboard."
msgstr ""
"<b>Gestionarea fluxului de recrutare:</b> urmăriți candidaturile, organizați "
"interviuri și recrutați echipa dintr-un singur tablou de bord."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Post &amp; Publish:</b> Create job openings and publish them directly to "
"your Odoo website."
msgstr ""
"<b>Publicare:</b> creați posturi vacante și publicați-le direct pe site-ul "
"Odoo."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Predefined Templates:</b> Speed up your process with standard layouts."
msgstr ""
"<b>Șabloane predefinite:</b> accelerați procesul folosind machete standard."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Purchases &amp; Dropshipping:</b> Transfers coming from suppliers."
msgstr "<b>Achiziții și dropshipping:</b> transferuri primite de la furnizori."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Rapid Entry:</b> Use Odoo’s built-in <b>scanning feature</b> to manage "
"high-traffic entrances and check\n"
"                in attendees in seconds."
msgstr ""
"<b>Acces rapid:</b> utilizați <b>funcția de scanare</b> integrată în Odoo "
"pentru a gestiona intrările aglomerate și a înregistra participanții în "
"câteva secunde."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Rentals:</b> Equipment moving to and from the client."
msgstr "<b>Închirieri:</b> echipamente transportate către și de la client."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Resources:</b> Set the number of resources that can be booked "
"simultaneously (e.g., if\n"
"                                you have two conference rooms, create two "
"resources)."
msgstr ""
"<b>Resurse:</b> setați numărul de resurse care pot fi rezervate simultan (de "
"exemplu, creați două resurse dacă aveți două săli de conferințe)."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Return:</b> From the Client back to your Warehouse."
msgstr "<b>Retur:</b> de la client înapoi la depozitul dvs."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Sections &amp; Notes:</b> Organize your offer and add context for the "
"client."
msgstr ""
"<b>Secțiuni și note:</b> organizați oferta și adăugați context pentru client."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>See it for yourself!</b> (Requires demo data)"
msgstr "<b>Convingeți-vă!</b> (Necesită date demonstrative)"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Service Products:</b> Used for high-level quoting or purchasing."
msgstr ""
"<b>Produse de servicii:</b> utilizate pentru oferte sau achiziții la nivel "
"general."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Services:</b> Link the specific service product you want to track as "
"\"rented\" within the\n"
"                                <b>Rental</b> app."
msgstr ""
"<b>Servicii:</b> conectați produsul de servicii pe care doriți să-l urmăriți "
"ca „închiriat” în aplicația <b>Închirieri</b>."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Setup Guide</b>"
msgstr "<b>Ghid de configurare</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Smart Comparisons:</b> Add alternative products or vendors to a single "
"RFQ. Once you select the best\n"
"                offer, Odoo automatically cancels the other options for you."
msgstr ""
"<b>Comparații inteligente:</b> adăugați produse sau furnizori alternativi la "
"aceeași cerere de ofertă. După ce selectați oferta optimă, Odoo anulează "
"automat celelalte opțiuni."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Sourcing &amp; Comparison</b>"
msgstr "<b>Aprovizionare și comparare</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Staff Resources:</b> Site plans, emergency contact lists, and event "
"agendas."
msgstr ""
"<b>Resurse pentru personal:</b> planurile locației, listele de contacte de "
"urgență și agendele evenimentelor."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Step 1: Define the Shifts</b> Create all necessary time slots (e.g., 6 "
"staff for \"Setup\" from 07:00 to\n"
"                15:00, 4 for \"Security\" from 10:00 to 16:00)."
msgstr ""
"<b>Pasul 1: Definiți turele</b> creați intervalele necesare (de exemplu, 6 "
"persoane pentru „Pregătire” între 07:00 și 15:00, 4 pentru „Securitate” "
"între 10:00 și 16:00)."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Step 2: Assign the Team</b> You can manually drag and drop employees into "
"slots or use the\n"
"                <b>\"Auto-Assign\"</b> button. Odoo will automatically match "
"staff based on their defined <b>Roles</b> and\n"
"                <b>Availability</b>."
msgstr ""
"<b>Pasul 2: Atribuiți echipa</b> puteți trage manual angajații în intervale "
"sau folosi butonul <b>„Atribuire automată”</b>. Odoo va repartiza personalul "
"în funcție de <b>rolurile</b> și <b>disponibilitatea</b> definite."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Step 3: Publish &amp; Sync</b> Once the schedule is finalized, click "
"<b>\"Publish.\"</b> Your team will\n"
"                receive:"
msgstr ""
"<b>Pasul 3: Publicați și sincronizați</b> după finalizarea programului, "
"faceți clic pe <b>„Publică”</b>. Echipa va primi:"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Step-by-Step Integration Guides</b>"
msgstr "<b>Ghiduri de integrare pas cu pas</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Storable (Traced) Products:</b> Strategic assets that require exact stock "
"counts at all times."
msgstr ""
"<b>Produse stocabile (cu trasabilitate):</b> bunuri importante pentru care "
"trebuie să cunoașteți permanent cantitatea exactă din stoc."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Sync:</b> Enable <b>Sync Shifts and Rental Orders</b> to activate the "
"integration between\n"
"                                the two modules."
msgstr ""
"<b>Sincronizare:</b> activați <b>Sincronizarea turelor și comenzilor de "
"închiriere</b> pentru a integra cele două module."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Task Management &amp; Custom Workflows</b>"
msgstr "<b>Gestionarea activităților și fluxuri de lucru personalizate</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Terms &amp; Conditions:</b> Ensure legal clarity on every deal."
msgstr ""
"<b>Termeni și condiții:</b> asigurați claritatea juridică a fiecărei "
"tranzacții."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>The Schedule View:</b> Click on <b>\"Schedule\"</b> for a timeline of "
"your equipment."
msgstr ""
"<b>Vizualizarea Program:</b> faceți clic pe <b>„Program”</b> pentru a vedea "
"cronologia echipamentelor."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Tip:</b> Remove the <i>\"Confirmed Orders\"</i> filter to see pending "
"quotations. This allows you to\n"
"                    spot potential conflicts before they happen."
msgstr ""
"<b>Sfat:</b> eliminați filtrul <i>„Comenzi confirmate”</i> pentru a vedea "
"ofertele în așteptare și a identifica eventualele conflicte înainte să apară."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Visualizing Availability</b>"
msgstr "<b>Vizualizarea disponibilității</b>"

