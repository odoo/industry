#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>1. Recruitment: Finding the Right Talent</b>"
msgstr "<b>1. ການສັນຫາ: ຊອກຫາບຸກຄະລາກອນທີ່ເໝາະສົມ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>2. Employee Setup: Defining Roles</b>"
msgstr "<b>2. ການຕັ້ງຄ່າພະນັກງານ: ກຳນົດບົດບາດໜ້າທີ່</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>3. Planning: The Three-Step Workflow</b>"
msgstr "<b>3. ການວາງແຜນ: ຂັ້ນຕອນການເຮັດວຽກສາມຂັ້ນຕອນ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Access Settings:</b> Navigate to <b>Settings</b> &gt; <b>Calendar</b> "
"&gt; <b>Sync External Calendar</b>."
msgstr ""
"<b>ເຂົ້າເຖິງການຕັ້ງຄ່າ:</b> ໄປທີ່ <b>ການຕັ້ງຄ່າ</b> &gt; <b>ປະຕິທິນ</b> &gt; <b>ຊິ້ງປະຕິທິນພາຍ"
"ນອກ</b>."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Attendee Management:</b> Track your guest list in real-time and send "
"digital tickets/badges via email\n"
"                automatically."
msgstr ""
"<b>ການຈັດການຜູ້ເຂົ້າຮ່ວມ:</b> ຕິດຕາມລາຍຊື່ແຂກແບບທັນທີ ແລະ ສົ່ງປີ້ດິຈິຕອນ/ບັດເຂົ້າຮ່ວມງານຜ່ານອີເມວ\n"
"                ໂດຍອັດຕະໂນມັດ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Automated Booking:</b> Enable online registration to let attendees book "
"their spots instantly."
msgstr ""
"<b>ການຈອງແບບອັດຕະໂນມັດ:</b> ເປີດໃຊ້ການລົງທະບຽນອອນລາຍ ເພື່ອໃຫ້ຜູ້ເຂົ້າຮ່ວມຈອງບ່ອນໄດ້ທັນທີ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Automated Stock Transfers</b>"
msgstr "<b>ການໂອນຍ້າຍສາງອັດຕະໂນມັດ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Automatic Conflict Prevention:</b> If you have already scheduled an "
"internal event or a staff\n"
"                        \"Montage\" (setup) in the <b>Planning app</b> for "
"that location, Odoo will automatically gray out\n"
"                        those dates on your website."
msgstr ""
"<b>ການປ້ອງກັນການຊໍ້າຊ້ອນອັດຕະໂນມັດ:</b> ຖ້າທ່ານໄດ້ຈັດຕາຕະລາງງານພາຍໃນ ຫຼື ການຕິດຕັ້ງໂດຍພະນັກງາ"
"ນ\n"
"                        ໃນ <b>ແອັບວາງແຜນ (Planning)</b> ສຳລັບສະຖານທີ່ນັ້ນໄວ້ແລ້ວ, "
"Odoo ຈະປ່ຽນສີວັນທີເຫຼົ່ານັ້ນ\n"
"                        ໃຫ້ເປັນສີເທົາໂດຍອັດຕະໂນມັດໃນເວັບໄຊທ໌ຂອງທ່ານ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Centralized Documentation</b>"
msgstr "<b>ເອກະສານແບບລວມສູນ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Centralized Logistics Overview</b>"
msgstr "<b>ພາບລວມການຂົນສົ່ງ ແລະ ສາງແບບລວມສູນ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Client Rentals:</b> Standard orders with specific pricing and automated "
"invoicing. (like Jessica Martinez in the demo data)"
msgstr ""
"<b>ການເຊົ່າຂອງລູກຄ້າ:</b> ລາຍການສັ່ງຊື້ມາດຕະຖານພ້ອມລາຄາສະເພາະ ແລະ ການອອກໃບເກັບເງິນອັດຕະໂນ"
"ມັດ. (ເຊັ່ນ Jessica Martinez ໃນຂໍ້ມູນຕົວຢ່າງ)"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Complex Project Management: </b>Open the \"City Festival – Summer in the "
"Square – Brussels\" opportunity."
msgstr ""
"<b>ການຈັດການໂຄງການທີ່ຊັບຊ້ອນ: </b>ເປີດໂອກາດ \"City Festival – Summer in the Square "
"– Brussels\"."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Conflict Alerts:</b> When creating a rental quotation, a <b>red icon</b> "
"will appear next to a line item\n"
"                if Odoo detects a stock shortage for those dates."
msgstr ""
"<b>ການແຈ້ງເຕືອນຂໍ້ຂັດແຍ່ງ:</b> ເມື່ອສ້າງໃບສະເໜີລາຄາເຊົ່າ, <b>ໄອຄອນສີແດງ</b> ຈະປະກົດຂຶ້ນຖັດຈາກລ"
"າຍການ\n"
"                ຖ້າ Odoo ກວດພົບວ່າສິນຄ້າໃນສາງບໍ່ພຽງພໍສຳລັບວັນທີເຫຼົ່ານັ້ນ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Consumable Products:</b> Items that appear on your picking lists but do "
"not require strict inventory\n"
"                tracking."
msgstr ""
"<b>ສິນຄ້າຊົມໃຊ້:</b> ສິນຄ້າທີ່ສະແດງຢູ່ໃນລາຍການເບີກເຄື່ອງ ແຕ່ບໍ່ຈຳເປັນຕ້ອງຕິດຕາມສະຕັອກຢ່າງເຂັ້ມງວດ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Custom Stages:</b> Tailor project and task stages to align perfectly with "
"your team’s specific internal\n"
"                processes."
msgstr ""
"<b>ຂັ້ນຕອນກຳນົດເອງ:</b> ປັບແຕ່ງຂັ້ນຕອນຂອງໂຄງການ ແລະ ວຽກງານໃຫ້ສອດຄ່ອງກັບຂະບວນການພາຍໃນສະເ"
"ພາະຂອງທີມງານທ່ານ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Delivery:</b> From your Warehouse to the Client."
msgstr "<b>ການຈັດສົ່ງ:</b> ຈາກສາງຂອງທ່ານໄປຫາລູກຄ້າ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Direct-to-Event (Dropshipping):</b> For items that should go straight to "
"the venue, change the\n"
"                <b>\"Deliver To\"</b> field to <b>\"Dropship\"</b> and "
"select the event location as the address."
msgstr ""
"<b>ສົ່ງກົງຮອດງານ (Dropshipping):</b> ສຳລັບສິນຄ້າທີ່ຄວນສົ່ງກົງໄປຍັງສະຖານທີ່ຈັດງານ, ໃຫ້ປ່ຽນຫ້ອງ\n"
"                <b>\"ສົ່ງເຖິງ\"</b> ເປັນ <b>\"Dropship\"</b> ແລະ ເລືອກສະຖານທີ່ຈັດງານເ"
"ປັນທີ່ຢູ່ຈັດສົ່ງ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Discounts:</b> Apply price adjustments directly to line items."
msgstr "<b>ສ່ວນຫຼຸດ:</b> ນຳໃຊ້ການປັບລາຄາໃສ່ລາຍການສິນຄ້າໂດຍກົງ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Easy Sharing:</b> Simply copy the <b>Share Link</b> for any document and "
"send it to your team along with\n"
"                their schedule (see planning section)"
msgstr ""
"<b>ການແບ່ງປັນທີ່ງ່າຍດາຍ:</b> ພຽງແຕ່ສຳເນົາ <b>ລິ້ງແບ່ງປັນ</b> ສຳລັບເອກະສານໃດໜຶ່ງ ແລ້ວສົ່ງໃຫ້ທີມງາ"
"ນຂອງທ່ານ\n"
"                ພ້ອມກັບຕາຕະລາງເວລາຂອງພວກເຂົາ (ເບິ່ງພາກສ່ວນການວາງແຜນ)"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Establish the Connection:</b> Link each user’s external account to the "
"Odoo Calendar app."
msgstr ""
"<b>ສ້າງການເຊື່ອມຕໍ່:</b> ເຊື່ອມໂຍງບັນຊີພາຍນອກຂອງຜູ້ໃຊ້ແຕ່ລະຄົນເຂົ້າກັບແອັບ ປະຕິທິນ ຂອງ Odoo."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>External Calendar Synchronization</b>"
msgstr "<b>ການຊິ້ງປະຕິທິນພາຍນອກ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Flexible Delivery &amp; Dropshipping</b>"
msgstr "<b>ການຈັດສົ່ງທີ່ຍືດຫຍຸ່ນ &amp; Dropshipping</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Flexible Rental Management</b>"
msgstr "<b>ການຈັດການການເຊົ່າທີ່ຍືດຫຍຸ່ນ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Flexible Ticketing:</b> Configure multiple ticket tiers (e.g., Early "
"Bird, VIP, or General Admission)\n"
"                with custom pricing."
msgstr ""
"<b>ລະບົບບັດເຂົ້າຮ່ວມທີ່ຍືດຫຍຸ່ນ:</b> ກຳນົດລາຄາບັດໄດ້ຫຼາຍລະດັບ (ເຊັ່ນ: Early Bird, VIP, ຫຼື ປີ້ທົ່ວໄ"
"ປ)\n"
"                ພ້ອມກຳນົດລາຄາເອງໄດ້."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Granular Control:</b> Manage deadlines, assignees, internal notes, and "
"sub-tasks for every stage of the\n"
"                project."
msgstr ""
"<b>ການຄວບຄຸມລະອຽດ:</b> ຈັດການກຳນົດເວລາ, ຜູ້ຮັບຜິດຊອບ, ບັນທຶກພາຍໃນ ແລະ ວຽກຍ່ອຍສຳລັບທຸກໆຂັ້ນຕ"
"ອນຂອງໂຄງການ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>How it Works in Practice</b>"
msgstr "<b>ວິທີການເຮັດວຽກຕົວຈິງ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Install eCommerce:</b> Ensure the <b>eCommerce app</b> is active."
msgstr ""
"<b>ຕິດຕັ້ງ eCommerce:</b> ກວດສອບໃຫ້ແນ່ໃຈວ່າ <b>ແອັບ eCommerce</b> ເປີດໃຊ້ງານຢູ່."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Integrated Budgeting:</b> Launch a <b>Request for Quotation (RFQ)</b> "
"directly from the project’s smart\n"
"                buttons to ensure all costs are automatically factored into "
"your <b>Project Profitability</b>."
msgstr ""
"<b>ງົບປະມານແບບປະສົມປະສານ:</b> ສ້າງ <b>ຄຳຮ້ອງຂໍໃບສະເໜີລາຄາ (RFQ)</b> ໂດຍກົງຈາກປຸ່ມອັດສະລິ"
"ຍະຂອງໂຄງການ ເພື່ອຮັບປະກັນວ່າຕົ້ນທຶນທັງໝົດຈະຖືກຄິດໄລ່ເຂົ້າໃນ <b>ກຳໄລຂອງໂຄງການ</b> ໂດຍອັດຕະໂນມັ"
"ດ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Internal Maintenance:</b> Blocks off equipment for repairs or quality "
"checks so it isn't accidentally\n"
"                booked."
msgstr ""
"<b>ການບຳລຸງຮັກສາພາຍໃນ:</b> ລັອກອຸປະກອນໄວ້ສຳລັບການສ້ອມແປງ ຫຼື ກວດສອບຄຸນນະພາບ ເພື່ອບໍ່ໃຫ້ມີການຈ"
"ອງຊໍ້າຊ້ອນໂດຍບໍ່ໄດ້ຕັ້ງໃຈ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Internal Picking Lists:</b> For items not covered by rentals (like "
"consumables), you can manually create\n"
"                a <b>Picking List</b>. Simply set the <i>Destination</i> to "
"the event location, select your products, and\n"
"                set the date."
msgstr ""
"<b>ໃບເບີກສິນຄ້າພາຍໃນ:</b> ສຳລັບສິນຄ້າທີ່ບໍ່ໄດ້ລວມຢູ່ໃນການເຊົ່າ (ເຊັ່ນ: ສິນຄ້າຊົມໃຊ້), ທ່ານສາມາດສ້າ"
"ງ\n"
"                <b>ໃບເບີກສິນຄ້າ</b> ດ້ວຍຕົນເອງ. ພຽງແຕ່ກຳນົດ <i>ປາຍທາງ</i> ເປັນສະຖານທີ່ຈັ"
"ດງານ, ເລືອກສິນຄ້າ, ແລະ\n"
"                ກຳນົດວັນທີ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Internal Warehouse:</b> By default, Odoo assumes items (like new stock) "
"are coming to your warehouse."
msgstr ""
"<b>ສາງພາຍໃນ:</b> ໂດຍເລີ່ມຕົ້ນ, Odoo ຈະຖືວ່າສິນຄ້າ (ເຊັ່ນ: ສິນຄ້າໃໝ່) ຈະເຂົ້າມາທີ່ສາງຂອງທ່ານ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Large-Scale Events:</b> Rentals bundled into a larger project at $0 "
"(since the cost is already covered in\n"
"                the overall package)."
msgstr ""
"<b>ງານຂະໜາດໃຫຍ່:</b> ລວມລາຍການເຊົ່າເຂົ້າໃນໂຄງການໃຫຍ່ໃນລາຄາ $0 (ເນື່ອງຈາກຄ່າໃຊ້ຈ່າຍໄດ້ລວມຢູ່"
"ໃນແພັກເກດລວມແລ້ວ)."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Live Availability:</b> Customers can only book the dates where the venue "
"is free."
msgstr ""
"<b>ສະຖານະຫວ່າງຕົວຈິງ:</b> ລູກຄ້າສາມາດຈອງໄດ້ສະເພາະວັນທີທີ່ສະຖານທີ່ຍັງຫວ່າງເທົ່ານັ້ນ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Logistics Overview</b>"
msgstr "<b>ພາບລວມການຂົນສົ່ງ ແລະ ສາງ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Managing Your Own Venue &amp; Location Bookings: </b>If you own the venue "
"where your events take place, you can\n"
"            use Odoo to manage its availability and even allow external "
"clients to book the space online when you aren't\n"
"            using it."
msgstr ""
"<b>ການຈັດການສະຖານທີ່ຂອງທ່ານເອງ &amp; ການຈອງສະຖານທີ່: </b>ຖ້າທ່ານເປັນເຈົ້າຂອງສະຖານທີ່ຈັດງາ"
"ນ, ທ່ານສາມາດ\n"
"            ໃຊ້ Odoo ເພື່ອຈັດການສະຖານະຫວ່າງ ແລະ ອະນຸຍາດໃຫ້ລູກຄ້າພາຍນອກຈອງພື້ນທີ່ອອນລາຍໄດ້ ເ"
"ມື່ອທ່ານບໍ່ໄດ້ໃຊ້ງານ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Official Paperwork:</b> Contracts and legal authorizations (City, Police, "
"etc.)."
msgstr ""
"<b>ເອກະສານທາງການ:</b> ສັນຍາ ແລະ ໜັງສືອະນຸຍາດທາງກົດໝາຍ (ເທດສະບານ, ເຈົ້າໜ້າທີ່ຕຳຫຼວດ, ແລະ "
"ອື່ນໆ)."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Online Presence:</b> Create beautiful event pages and publish them "
"directly to your website."
msgstr ""
"<b>ການສະແດງຕົນອອນລາຍ:</b> ສ້າງໜ້າເວັບກິດຈະກຳທີ່ສວຍງາມ ແລະ ເຜີຍແຜ່ລົງໃນເວັບໄຊທ໌ຂອງທ່ານໂດຍກົ"
"ງ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Pipeline Management:</b> Track applications, conduct interviews, and hire "
"your team in one centralized\n"
"                dashboard."
msgstr ""
"<b>ການຈັດການສາຍຂະບວນການຮັບສະໝັກ:</b> ຕິດຕາມໃບສະໝັກ, ດຳເນີນການສຳພາດ, ແລະ ຮັບພະນັກງານເຂົ້"
"າເຮັດວຽກໃນກະດານຄວບຄຸມດຽວ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Post &amp; Publish:</b> Create job openings and publish them directly to "
"your Odoo website."
msgstr ""
"<b>ປະກາດ &amp; ເຜີຍແຜ່:</b> ສ້າງຕຳແໜ່ງງານຫວ່າງ ແລະ ເຜີຍແຜ່ໂດຍກົງລົງໃນເວັບໄຊທ໌ Odoo ຂອງທ່າ"
"ນ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Predefined Templates:</b> Speed up your process with standard layouts."
msgstr ""
"<b>ແມ່ແບບທີ່ກຳນົດໄວ້ລ່ວງໜ້າ:</b> ເລັ່ງຂະບວນການເຮັດວຽກຂອງທ່ານໃຫ້ໄວຂຶ້ນດ້ວຍໂຄງຮ່າງມາດຕະຖານ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Purchases &amp; Dropshipping:</b> Transfers coming from suppliers."
msgstr "<b>ການຈັດຊື້ &amp; Dropshipping:</b> ການໂອນຍ້າຍສິນຄ້າທີ່ມາຈາກຜູ້ສະໜອງ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Rapid Entry:</b> Use Odoo’s built-in <b>scanning feature</b> to manage "
"high-traffic entrances and check\n"
"                in attendees in seconds."
msgstr ""
"<b>ການເຂົ້າງານຢ່າງວ່ອງໄວ:</b> ໃຊ້ <b>ລະບົບສະແກນ</b> ທີ່ມີໃນ Odoo ເພື່ອຈັດການທາງເຂົ້າທີ່ມີຄົນແໜ້ນ"
"ໜາ ແລະ ກວດສອບການເຂົ້າງານຂອງຜູ້ຮ່ວມງານໄດ້ພາຍໃນບໍ່ເທົ່າໃດວິນາທີ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Rentals:</b> Equipment moving to and from the client."
msgstr "<b>ການເຊົ່າ:</b> ອຸປະກອນທີ່ຍ້າຍໄປຫາ ແລະ ກັບຄືນມາຈາກລູກຄ້າ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Resources:</b> Set the number of resources that can be booked "
"simultaneously (e.g., if\n"
"                                you have two conference rooms, create two "
"resources)."
msgstr ""
"<b>ຊັບພະຍາກອນ:</b> ກຳນົດຈຳນວນຊັບພະຍາກອນທີ່ສາມາດຈອງພ້ອມກັນໄດ້ (ຕົວຢ່າງ: ຖ້າ\n"
"                                ທ່ານມີຫ້ອງປະຊຸມສອງຫ້ອງ, ໃຫ້ສ້າງສອງຊັບພະຍາກອນ)."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Return:</b> From the Client back to your Warehouse."
msgstr "<b>ການສົ່ງຄືນ:</b> ຈາກລູກຄ້າກັບຄືນມາທີ່ສາງຂອງທ່ານ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Sections &amp; Notes:</b> Organize your offer and add context for the "
"client."
msgstr ""
"<b>ໝວດໝູ່ &amp; ໝາຍເຫດ:</b> ຈັດລະບຽບຂໍ້ສະເໜີຂອງທ່ານ ແລະ ເພີ່ມລາຍລະອຽດໃຫ້ແກ່ລູກຄ້າ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>See it for yourself!</b> (Requires demo data)"
msgstr "<b>ລອງເບິ່ງດ້ວຍຕົວທ່ານເອງ!</b> (ຕ້ອງການຂໍ້ມູນຕົວຢ່າງ)"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Service Products:</b> Used for high-level quoting or purchasing."
msgstr "<b>ສິນຄ້າປະເພດບໍລິການ:</b> ໃຊ້ສຳລັບການສະເໜີລາຄາ ຫຼື ການຈັດຊື້ຂັ້ນສູງ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Services:</b> Link the specific service product you want to track as "
"\"rented\" within the\n"
"                                <b>Rental</b> app."
msgstr ""
"<b>ການບໍລິການ:</b> ເຊື່ອມໂຍງສິນຄ້າບໍລິການສະເພາະທີ່ທ່ານຕ້ອງການຕິດຕາມເປັນ \"ຖືກເຊົ່າ\" ພາຍໃນ\n"
"                                ແອັບ <b>ການເຊົ່າ (Rental)</b>."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Setup Guide</b>"
msgstr "<b>ຄູ່ມືການຕິດຕັ້ງ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Smart Comparisons:</b> Add alternative products or vendors to a single "
"RFQ. Once you select the best\n"
"                offer, Odoo automatically cancels the other options for you."
msgstr ""
"<b>ການປຽບທຽບອັດສະລິຍະ:</b> ເພີ່ມສິນຄ້າ ຫຼື ຜູ້ສະໜອງທາງເລືອກເຂົ້າໃນ RFQ ດຽວ. ເມື່ອທ່ານເລືອກຂໍ້ສະເ"
"ໜີທີ່ດີທີ່ສຸດແລ້ວ,\n"
"                Odoo ຈະຍົກເລີກຕົວເລືອກອື່ນໆໃຫ້ທ່ານໂດຍອັດຕະໂນມັດ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Sourcing &amp; Comparison</b>"
msgstr "<b>ການຈັດຫາແຫຼ່ງສະໜອງ &amp; ການປຽບທຽບ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Staff Resources:</b> Site plans, emergency contact lists, and event "
"agendas."
msgstr ""
"<b>ແຫຼ່ງຂໍ້ມູນສຳລັບພະນັກງານ:</b> ແຜນຜັງສະຖານທີ່, ລາຍຊື່ຕິດຕໍ່ສຸກເສີນ, ແລະ ກຳນົດການງານ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Step 1: Define the Shifts</b> Create all necessary time slots (e.g., 6 "
"staff for \"Setup\" from 07:00 to\n"
"                15:00, 4 for \"Security\" from 10:00 to 16:00)."
msgstr ""
"<b>ຂັ້ນຕອນທີ 1: ກຳນົດກະວຽກ</b> ສ້າງຊ່ວງເວລາທີ່ຈຳເປັນທັງໝົດ (ຕົວຢ່າງ: ພະນັກງານ 6 ຄົນ ສຳລັບ \"ຈັ"
"ດສະຖານທີ່\" ເວລາ 07:00 ຫາ\n"
"                15:00, 4 ຄົນ ສຳລັບ \"ຮັກສາຄວາມປອດໄພ\" ເວລາ 10:00 ຫາ 16:00)."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Step 2: Assign the Team</b> You can manually drag and drop employees into "
"slots or use the\n"
"                <b>\"Auto-Assign\"</b> button. Odoo will automatically match "
"staff based on their defined <b>Roles</b> and\n"
"                <b>Availability</b>."
msgstr ""
"<b>ຂັ້ນຕອນທີ 2: ມອບໝາຍທີມງານ</b> ທ່ານສາມາດລາກ ແລະ ວາງພະນັກງານໃສ່ຊ່ອງເວລາດ້ວຍຕົນເອງ ຫຼື ໃຊ້"
"ປຸ່ມ\n"
"                <b>\"ມອບໝາຍອັດຕະໂນມັດ\"</b>. Odoo ຈະຈັບຄູ່ພະນັກງານໂດຍອັດຕະໂນມັດຕາມ "
"<b>ບົດບາດ</b> ແລະ\n"
"                <b>ຄວາມພ້ອມໃນການເຮັດວຽກ</b> ທີ່ກຳນົດໄວ້."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Step 3: Publish &amp; Sync</b> Once the schedule is finalized, click "
"<b>\"Publish.\"</b> Your team will\n"
"                receive:"
msgstr ""
"<b>ຂັ້ນຕອນທີ 3: ເຜີຍແຜ່ &amp; ຊິ້ງຂໍ້ມູນ</b> ເມື່ອຕາຕະລາງສຳເລັດແລ້ວ, ໃຫ້ຄລິກ <b>\"ເຜີຍແຜ່\".</"
"b> ທີມງານຂອງທ່ານຈະໄດ້ຮັບ:"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Step-by-Step Integration Guides</b>"
msgstr "<b>ຄູ່ມືການເຊື່ອມໂຍງລະບົບເທື່ອລະຂັ້ນຕອນ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Storable (Traced) Products:</b> Strategic assets that require exact stock "
"counts at all times."
msgstr ""
"<b>ສິນຄ້າທີ່ສາມາດເກັບຮັກສາໄດ້ (ມີການຕິດຕາມ):</b> ຊັບສິນສຳຄັນທີ່ຕ້ອງມີການນັບຈຳນວນສະຕັອກຢ່າງແນ່ນອນຕ"
"ະຫຼອດເວລາ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Sync:</b> Enable <b>Sync Shifts and Rental Orders</b> to activate the "
"integration between\n"
"                                the two modules."
msgstr ""
"<b>ການຊິ້ງ:</b> ເປີດໃຊ້ງານ <b>ຊິ້ງກະວຽກ ແລະ ລາຍການສັ່ງເຊົ່າ</b> ເພື່ອເປີດໃຊ້ການເຊື່ອມໂຍງລະຫວ່າ"
"ງ\n"
"                                ສອງໂມດູນ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Task Management &amp; Custom Workflows</b>"
msgstr "<b>ການຈັດການວຽກ &amp; ຂັ້ນຕອນການເຮັດວຽກທີ່ກຳນົດເອງ</b>"

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid "<b>Terms &amp; Conditions:</b> Ensure legal clarity on every deal."
msgstr ""
"<b>ເງື່ອນໄຂ &amp; ຂໍ້ກຳນົດ:</b> ຮັບປະກັນຄວາມຊັດເຈນທາງກົດໝາຍໃນທຸກໆຂໍ້ຕົກລົງ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>The Schedule View:</b> Click on <b>\"Schedule\"</b> for a timeline of "
"your equipment."
msgstr ""
"<b>ມຸມມອງຕາຕະລາງເວລາ:</b> ຄລິກໃສ່ <b>\"ຕາຕະລາງເວລາ\"</b> ເພື່ອເບິ່ງກຳນົດເວລາການໃຊ້ອຸປະກ"
"ອນຂອງທ່ານ."

#. module: event_management
#: model_terms:ir.ui.view,arch_db:event_management.welcome_article_body
msgid ""
"<b>Tip:</b> Remove the <i>\"Confirmed Orders\"</i> filter to see pending "
"quotations. This allows you to\n"
"                    spot potential conflicts before they happen."
msgstr ""
"<b>ຄຳແນະນຳ:</b> ລຶບຕົວກັ່ນຕອງ <i>\"ລາຍການສັ່ງຊື້ທີ່ຢືນຢັນແລ້ວ\"</i> ອອກ ເພື່ອເບິ່ງໃບສະເໜີລາຄາທີ່ລໍ"
"ຖ້າການຢືນຢັນ. ສິ່ງນີ້ຈະຊ່ວຍໃຫ້ທ່ານ\n"
"                    ກວດພົບຂໍ້ຂັດແຍ່ງທີ່ອາດເກີດຂຶ້ນກ່ອນທີ່ມັນຈະເກີດ."

