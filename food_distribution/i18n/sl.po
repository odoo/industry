#. module: food_distribution
#: model_terms:ir.ui.view,arch_db:food_distribution.welcome_article_body
#, fuzzy
msgid ""
"<b>Documents App</b>: Centralize supplier certificates, quality control "
"reports, and shipping manifests for easy\n"
"          retrieval during audits."
msgstr ""
"<b>Dokumenti</b>: Centralizirajte certifikate dobaviteljev, poročila nadzora "
"kakovosti in transportne manifeste za enostavno\n"
"          iskanje med revizijami."

#. module: food_distribution
#: model_terms:ir.ui.view,arch_db:food_distribution.welcome_article_body
#, fuzzy
msgid ""
"<b>Fleet App</b>: Manage your delivery trucks and vans, tracking fuel logs, "
"maintenance schedules, and driver\n"
"          assignments in one place."
msgstr ""
"<b>Vozni park</b>: Upravite svoje dostavne tovornjake in kombije, "
"spremljajte dnevnike porabe goriva, urnike vzdrževanja in dodelitve "
"voznikov\n"
"          na enem mestu."

#. module: food_distribution
#: model_terms:ir.ui.view,arch_db:food_distribution.welcome_article_body
#, fuzzy
msgid ""
"<b>Inventory App</b>: Master your stock with advanced features like Lots "
"&amp; Serial Numbers for traceability\n"
"          and Expiration Dates to enforce FEFO (First Expired, First Out) "
"removal strategies."
msgstr ""
"<b>Aplikacija Zaloga</b>: Obvladujte svojo zalogo z naprednimi funkcijami, "
"kot so loti &amp; serijske številke za sledljivost\n"
"          in datumi poteka za izvajanje strategij odstranjevanja FEFO (First "
"Expired, First Out)."

#. module: food_distribution
#: model_terms:ir.ui.view,arch_db:food_distribution.welcome_article_body
#, fuzzy
msgid ""
"<b>Invoicing App</b>: Streamline your billing with automated invoicing based "
"on delivered quantities, ensuring\n"
"          accurate financial records."
msgstr ""
"<b>Aplikacija za fakturiranje</b>: Poenostavite obračunavanje z "
"avtomatiziranim fakturiranjem na podlagi dostavljenih količin, s čimer "
"zagotavljate\n"
"          natančne finančne evidence."

#. module: food_distribution
#: model_terms:ir.ui.view,arch_db:food_distribution.welcome_article_body
#, fuzzy
msgid ""
"<b>Purchase App</b>: Automate your procurement process with reordering rules "
"that account for vendor lead times\n"
"          and seasonal demand spikes."
msgstr ""
"<b>Nakupna aplikacija</b>: Avtomatizirajte postopek oskrbe s pravili "
"ponovnega naročanja, ki upoštevajo dobavne roke dobaviteljev\n"
"          in sezonske skoke povpraševanja."

#. module: food_distribution
#: model_terms:ir.ui.view,arch_db:food_distribution.welcome_article_body
#, fuzzy
msgid ""
"<b>Sales App</b>: Manage complex pricing structures with Pricelists, "
"allowing you to offer specific deals to\n"
"          restaurants, retailers, or wholesalers."
msgstr ""
"<b>Prodajna aplikacija</b>: Upravite zapletene cenovne strukture s ceniki, "
"ki vam omogočajo, da ponudite posebne ponudbe\n"
"          restavracijam, maloprodajalcem ali veletrgovcem."

