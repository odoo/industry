<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_text_element" model="ir.ui.view">
        <field name="name">Custom Star Brew - Header Text element</field>
        <field name="key">website.header_text_element</field>
        <field name="inherit_id" ref="website.header_text_element" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//t[@t-elif=&quot;_txt_elt_content == 'phone_mail'&quot;]//a[@href='tel:+1 555-555-5556']" position="replace">
                <a href="tel:+32470000000" class="nav-link o_nav-link_secondary">
                    <small>
                        <i class="fa fa-1x fa-fw fa-phone me-1" />
                        <span class="o_force_ltr">+32 470 00 00 00</span>
                    </small>
                </a>
            </xpath>
            <xpath expr="//t[@t-elif=&quot;_txt_elt_content == 'phone_mail'&quot;]//a[@href='mailto:info@yourcompany.example.com']" position="replace">
                <a href="mailto:info@starbrew.com" class="nav-link o_nav-link_secondary">
                    <small>
                        <i class="fa fa-1x fa-fw fa-envelope me-1" />
                    info@starbrew.com
                    </small>
                </a>
            </xpath>
        </field>
    </record>
    <record id="template_footer_minimalist" model="ir.ui.view">
        <field name="name">Custom Star Brew - Minimalist</field>
        <field name="key">website.template_footer_minimalist</field>
        <field name="inherit_id" ref="website.layout" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt40 pb40" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-2 offset-lg-0 col-8 offset-2 pt16 pb16 o_colored_level">
                                    <a href="/" class="o_footer_logo logo">
                                        <img src="/web/image/micro_brewery.img_custom_star_brew_image_14" alt="" class="img-fluid d-block mx-auto img o_we_custom_image o_attachment_pending_record_id" style="width: 48% !important;" data-format-mimetype="image/webp" data-resize-width="344" data-mimetype="image/webp" loading="lazy" />
                                    </a>
                                </div>
                                <div class="col-lg-8 pt16 pb16 o_colored_level">
                                    <nav class="nav align-items-center justify-content-center flex-column flex-lg-row">
                                        <a class="nav-link" href="/">Home</a>
                                        <a class="nav-link" href="/about-us">About us</a>
                                        <a class="nav-link" href="/shop">Products</a>
                                        <a class="btn btn-primary" href="/contactus">Get in touch</a>
                                    </nav>
                                </div>
                                <div class="col-lg-2 pt16 pb16 o_colored_level">
                                    <div class="s_social_media no_icon_color o_not_editable text-center" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="#" class="s_social_media_facebook" target="_blank">
                                            <i class="fa fa-facebook fa-stack o_editable_media" />
                                        </a>
                                        <a href="#" class="s_social_media_twitter" target="_blank">
                                            <i class="fa fa-twitter fa-stack o_editable_media" />
                                        </a>
                                        <a href="#" class="s_social_media_instagram" target="_blank">
                                            <i class="fa fa-instagram fa-stack o_editable_media" />
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
