<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_about-us" model="ir.ui.view">
        <field name="name">about-us</field>
        <field name="key">micro_brewery.page_about-us</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="micro_brewery.page_about-us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_banner overflow-hidden o_colored_level pb0 pt184 s_custom_snippet parallax" data-snippet="s_banner" style="background-image: linear-gradient(rgb(248, 248, 246) 22%, rgb(255, 255, 255) 100%);" data-format-mimetype="image/webp" data-name="Custom Banner" data-scroll-background-ratio="-1.5">
                            <span class="s_parallax_bg_wrap"><span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/micro_brewery.img_custom_star_brew_image_29&quot;); background-size: cover;" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp"/></span>
                            <div class="o_we_bg_filter" style="background-color: rgba(0, 0, 0, 0.25);"/>
                            <div class="container-fluid">
                                <div class="row o_grid_mode" data-row-count="8">
                                    <div class="o_grid_item o_colored_level g-col-lg-8 g-height-3 col-lg-8" data-name="Box" style="z-index: 1; grid-area: 2 / 3 / 5 / 11;">
                                        <h1 style="text-align: center;"><span class="display-1-fs"><strong><span class="text-white">Abous us.</span></strong></span></h1>
                                        <div class="s_hr pt8 pb16" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                        </div>
                                    </div>
                                    <div class="o_grid_item o_grid_item_image d-lg-block d-none o_snippet_mobile_invisible o_colored_level g-height-5 g-col-lg-12 col-lg-12" style="z-index: 6; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; grid-area: 4 / 1 / 9 / 13;" data-invisible="1"><img src="/web/image/micro_brewery.img_custom_star_brew_image_03" alt="" class="img img-fluid mx-auto o_editable_media o_we_custom_image o_attachment_pending_record_id" style="visibility: visible; animation-delay: -0.502552s;" data-format-mimetype="image/webp" data-resize-width="1164" data-mimetype="image/webp" srcset="/web/image/micro_brewery.img_custom_star_brew_image_30 750w, /web/image/micro_brewery.img_custom_star_brew_image_31 900w, /web/image/micro_brewery.img_custom_star_brew_image_03 1164w"/></div>
                                </div>
                            </div>
                        </section>
                        <section class="s_title o_colored_level pb24 pt48" data-vcss="001" data-snippet="s_title" data-name="Title">
                            <div class="s_allow_columns o_container_small">
                                <h2 style="text-align: start;">Brewed where <strong>the tide meets the city</strong>.</h2>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level pt0 pb48" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns o_container_small">
                                <p><span class="h5-fs">Ant Brew started with a simple idea: beer should taste like summer, no matter what month it is. <strong>We're a small, independent brewery</strong> set at the edge of the water, where salt air and slow brewing come together in every batch. From crisp pilsners to hazy IPAs, everything we make is built to be shared — on the beach, on the porch, or wherever good company gathers.</span></p>
                                <p><span class="h5-fs"><strong>We keep things honest</strong>: small batches, quality ingredients, and a rotating lineup that always has something new to try alongside the year-round favorites you can count on. Whether you're stopping by the brewery for a visit or cracking one open at home, we hope every can feels like a little piece of the coast.<br/><br/></span></p>
                                <p><span class="h5-fs"><a href="/shop" class="o_translate_inline btn btn-lg btn-primary">Shop Now</a></span></p>
                            </div>
                        </section>
                        <section class="s_company_team_spotlight o_colored_level o_cc o_cc1 pt48 pb48" data-snippet="s_company_team_spotlight" data-name="Team Spotlight">
                            <div class="container-fluid">
                                <h2 style="text-align: center;">Our <strong>Team</strong></h2>
                                <p><br/></p>
                                <div class="row">
                                    <div data-name="Team Member" class="col-6 col-lg-3">
                                        <div class="s_card o_card_img_top card o_cc o_cc1 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0"><img src="/web/image/micro_brewery.img_custom_star_brew_image_32" alt="" class="o_card_img card-img-top o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="950" data-mimetype="image/webp" srcset="/web/image/micro_brewery.img_custom_star_brew_image_33 750w, /web/image/micro_brewery.img_custom_star_brew_image_32 950w"/></figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Tony Fred</h3>
                                                <p class="card-text">Head Brewer</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Team Member" class="col-6 col-lg-3">
                                        <div class="s_card o_card_img_top card o_cc o_cc1 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0"><img src="/web/image/micro_brewery.img_custom_star_brew_image_26" alt="" class="o_card_img card-img-top o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="950" data-mimetype="image/webp" srcset="/web/image/micro_brewery.img_custom_star_brew_image_34 750w, /web/image/micro_brewery.img_custom_star_brew_image_26 950w"/></figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Mich Stark</h3>
                                                <p class="card-text">Taproom Manager</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Team Member" class="col-6 col-lg-3">
                                        <div class="s_card o_card_img_top card o_cc o_cc1 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0"><img src="/web/image/micro_brewery.img_custom_star_brew_image_35" alt="" class="o_card_img card-img-top o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="950" data-mimetype="image/webp" srcset="/web/image/micro_brewery.img_custom_star_brew_image_36 750w, /web/image/micro_brewery.img_custom_star_brew_image_35 950w"/></figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Aline Turner</h3>
                                                <p class="card-text">Distribution Coordinator</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Team Member" class="col-6 col-lg-3">
                                        <div class="s_card o_card_img_top card o_cc o_cc1 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0"><img src="/web/image/micro_brewery.img_custom_star_brew_image_37" alt="" class="o_card_img card-img-top o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="950" data-mimetype="image/webp" srcset="/web/image/micro_brewery.img_custom_star_brew_image_38 750w, /web/image/micro_brewery.img_custom_star_brew_image_37 950w"/></figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Toby Joe</h3>
                                                <p class="card-text">Community Manager</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_timeline pt48 pb48 o_colored_level" data-vcss="002" data-snippet="s_timeline" data-name="Timeline">
                            <div class="container">
                                <h2 style="text-align: center;">Our <strong>Story</strong></h2>
                                <p style="text-align: center;" class="lead">From a homebrew hobby to your favorite spot on the sand.</p>
                                <p><br/></p>
                                <div class="position-relative pt-3">
                                    <div class="s_timeline_row position-relative d-flex gap-md-5 flex-column flex-md-row pb-4" data-name="Milestone">
                                        <div class="o_dot_line position-absolute top-0 bottom-0 w-0 mb-1 border-start pe-none"/>
                                        <span class="o_dot o_not_editable position-absolute translate-middle-x rounded-circle pe-none"/>
                                        <div class="s_timeline_content w-100 ps-4 ps-md-0">
                                            <div class="s_timeline_card s_card card my-0 ms-auto text-md-end o_colored_level" style="border-width: 0px !important;" data-vxml="001" data-snippet="s_card" data-name="Milestone Event">
                                                <div class="card-body">
                                                    <small class="text-muted">13/06/2019</small>
                                                    <h3 class="h4-fs card-title">First Batch</h3>
                                                    <p class="card-text">Star Brew started in a garage two blocks from the water, with one kettle, a lot of trial and error, and a recipe for a crisp lager built for hot days and bare feet.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_timeline_content w-0 w-md-100 h-0"/>
                                    </div>
                                    <div class="s_timeline_row position-relative d-flex flex-column flex-md-row gap-md-5 pb-4" data-name="Milestone">
                                        <div class="o_dot_line position-absolute top-0 bottom-0 w-0 mb-1 border-start pe-none"/>
                                        <span class="o_dot o_not_editable position-absolute translate-middle-x rounded-circle pe-none"/>
                                        <div class="s_timeline_content w-0 w-md-100 h-0"/>
                                        <div class="s_timeline_content w-100 ps-4 ps-md-0">
                                            <div class="s_timeline_card s_card card my-0 ms-auto o_colored_level" style="border-width: 0px !important;" data-vxml="001" data-snippet="s_card" data-name="Milestone Event">
                                                <div class="card-body">
                                                    <small class="text-muted">25/12/2024</small>
                                                    <h3 class="h4-fs card-title">The Taproom Opens</h3>
                                                    <p class="card-text">We poured our first pint at the beach taproom, bringing friends, surfers, and sunset chasers together over fresh, small-batch beer brewed steps from the shore.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="s_timeline_row position-relative d-flex gap-md-5 flex-column flex-md-row pb-4" data-name="Milestone">
                                        <div class="o_dot_line position-absolute top-0 bottom-0 w-0 mb-1 border-start pe-none"/>
                                        <span class="o_dot o_not_editable position-absolute translate-middle-x rounded-circle pe-none"/>
                                        <div class="s_timeline_content w-100 ps-4 ps-md-0">
                                            <div class="s_timeline_card s_card card my-0 ms-auto text-md-end o_colored_level" style="border-width: 0px !important;" data-vxml="001" data-snippet="s_card" data-name="Milestone Event">
                                                <div class="card-body">
                                                    <small class="text-muted">13/06/2019</small>
                                                    <h3 class="h4-fs card-title">Brewed for the Coast</h3>
                                                    <p class="card-text">Our lineup grew to include hazy IPAs, salted golds, and fruited sours, each one designed to taste like a day at the beach in a glass.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_timeline_content w-0 w-md-100 h-0"/>
                                    </div>
                                    <div class="s_timeline_row position-relative d-flex flex-column flex-md-row gap-md-5 pb-4" data-name="Milestone">
                                        <div class="o_dot_line position-absolute top-0 bottom-0 w-0 mb-1 border-start pe-none"/>
                                        <span class="o_dot o_not_editable position-absolute translate-middle-x rounded-circle pe-none"/>
                                        <div class="s_timeline_content w-0 w-md-100 h-0"/>
                                        <div class="s_timeline_content w-100 ps-4 ps-md-0">
                                            <div class="s_timeline_card s_card card my-0 ms-auto o_colored_level" style="border-width: 0px !important;" data-vxml="001" data-snippet="s_card" data-name="Milestone Event">
                                                <div class="card-body">
                                                    <small class="text-muted">25/12/2024</small>
                                                    <h3 class="h4-fs card-title">Now Pouring</h3>
                                                    <div>Today, Star Brew is a local favorite with a full taproom, beachside patio, and year-round small-batch releases — still brewed with the same love for the coast we started with.</div>
                                                    <div><br/></div>
                                                    <p class="card-text">Want me to adjust the tone (more playful/casual vs. polished/premium), tighten the word count to fit your layout better, or draft a couple alternate versions for A/B testing?</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_announcement_scroll s_announcement_scroll_parallax s_announcement_scroll_hover_pause w-100 o_colored_level pt48 pb48 s_announcement_scroll_direction_left o_cc o_cc4" style="--marquee-animation-speed: 5s; --marquee-item-font-size: 80;" role="marquee" data-snippet="s_announcement_scroll" data-name="Announcement Scroll">
                            <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                                <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">We brew it. The tide inspires it. You drink it.</div>
                            </div>
                        </section>
                        <div class="s_hr o_colored_level pb0 pt0" data-snippet="s_hr" data-name="Separator">
                            <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-4);"/>
                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_about-us" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_about-us"/>
            <field name="url">/about-us</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
