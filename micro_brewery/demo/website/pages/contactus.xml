<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">micro_brewery.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="micro_brewery.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{                         'email_to': res_company.email,                         'name': request.params.get('name', ''),                         'phone': request.params.get('phone', ''),                         'email_from': request.params.get('email_from', ''),                         'company': request.params.get('company', ''),                         'subject': request.params.get('subject', ''),                     }"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_banner overflow-hidden o_colored_level pb0 pt184 s_custom_snippet parallax" data-snippet="s_banner" style="background-image: linear-gradient(rgb(248, 248, 246) 22%, rgb(255, 255, 255) 100%);" data-format-mimetype="image/webp" data-scroll-background-ratio="-1.5" data-name="Custom Custom Banner">
                            <span class="s_parallax_bg_wrap"><span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/micro_brewery.img_custom_star_brew_image_39&quot;); background-size: cover;" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp"/></span>
                            <div class="o_we_bg_filter" style="background-color: rgba(0, 0, 0, 0.25);"/>
                            <div class="container-fluid">
                                <div class="row o_grid_mode" data-row-count="8">
                                    <div class="o_grid_item o_colored_level g-col-lg-8 g-height-3 col-lg-8" data-name="Box" style="z-index: 1; grid-area: 2 / 3 / 5 / 11;">
                                        <h1 style="text-align: center;"><span class="display-1-fs"><strong><span class="text-white">Contact us.</span></strong></span></h1>
                                        <div class="s_hr pt8 pb16" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                        </div>
                                    </div>
                                    <div class="o_grid_item o_grid_item_image d-lg-block d-none o_snippet_mobile_invisible o_colored_level g-height-5 g-col-lg-12 col-lg-12" style="z-index: 6; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; grid-area: 4 / 1 / 9 / 13;" data-invisible="1"><img src="/web/image/micro_brewery.img_custom_star_brew_image_03" alt="" class="img img-fluid mx-auto o_editable_media o_we_custom_image o_attachment_pending_record_id" style="visibility: visible; animation-delay: -0.502552s;" data-format-mimetype="image/webp" data-resize-width="1164" data-mimetype="image/webp" srcset="/web/image/micro_brewery.img_custom_star_brew_image_30 750w, /web/image/micro_brewery.img_custom_star_brew_image_31 900w, /web/image/micro_brewery.img_custom_star_brew_image_03 1164w"/></div>
                                </div>
                            </div>
                        </section>
                        <section class="s_form_aside pt48 pb120 o_colored_level" data-snippet="s_form_aside" data-name="Form Aside" style="position: relative;">
                            <div class="container">
                                <div class="row">
                                    <div class="col-12 order-lg-0 o_colored_level col-lg-8 offset-lg-2" style="order: 0;">
                                        <p class="lead">Contact us about anything related to our company or services.
                                </p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name"><label class="s_website_form_label" style="width: 200px" for="opqo1gipw68c"><span class="s_website_form_label_content">Your Name</span><span class="s_website_form_mark">  *</span></label><input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="" id="opqo1gipw68c" data-fill-with="name"/></div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="tel" data-translated-name="Phone Number"><label class="s_website_form_label" style="width: 200px" for="obd62nkdsomw"><span class="s_website_form_label_content">Phone Number</span></label><input class="form-control s_website_form_input" type="tel" name="phone" placeholder="" id="obd62nkdsomw" data-fill-with="phone"/></div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="email" data-translated-name="Your Email"><label class="s_website_form_label" style="width: 200px" for="ozrapsokf9ri"><span class="s_website_form_label_content">Your Email</span><span class="s_website_form_mark">  *</span></label><input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="ozrapsokf9ri" data-fill-with="email"/></div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="char" data-translated-name="Your Company"><label class="s_website_form_label" style="width: 200px" for="oze94gwkgdsi"><span class="s_website_form_label_content">Your Company</span></label><input class="form-control s_website_form_input" type="text" name="partner_name" value="" placeholder="" id="oze94gwkgdsi" data-fill-with="undefined"/></div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject"><label class="s_website_form_label" style="width: 200px" for="ola4oqv3m09q"><span class="s_website_form_label_content">Subject</span><span class="s_website_form_mark">  *</span></label><input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="ola4oqv3m09q" data-fill-with="undefined"/></div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="Your Question"><label class="s_website_form_label" style="width: 200px" for="ofurqul46j4"><span class="s_website_form_label_content">Your Question</span><span class="s_website_form_mark">  *</span></label><textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="ofurqul46j4" rows="3"/></div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"><br/></div>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="s_website_form_send btn btn-lg btn-primary">Send Message</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
