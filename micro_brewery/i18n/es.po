#: model_terms:ir.ui.view,arch_db:micro_brewery.welcome_article_body
msgid "Yeast - Goods, inventory tracking by lot."
msgstr "Levadura - Producto, seguimiento de inventario por lote."

#. module: micro_brewery
#: model:product.template,name:micro_brewery.product_template_5
msgid "Yeast Slurry"
msgstr ""

#. module: micro_brewery
