{
    "name": "Industry",
    "vars": {
        "module_filter": "-*,industry/*"
    },
    "steps": [
        {
            "name": "Install template database",
            "db_name": "industry",
            "job_type": "odoo",
            "demo_mode": "without_demo",
            "install_modules": "base_import_module,industry/test_*"
        },
        {
            "name": "Test all Industries",
            "job_type": "command",
            "db_name": "industry",
            "command": "odoo/odoo-bin --addons-path={{addons_path}} test_industry -d {{db_name}} --data-dir {{data_dir}} --industries industry_real_estate,property_listing,real_estate --test-enable --log-db runbot_logs --log-db-level=26 --industry-demo",
            "check_logs": ["ERROR", "WARNING"],
            "expected_logs": ["Initiating shutdown", "Starting post tests"]
        }
    ]
}
