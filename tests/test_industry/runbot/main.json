{
    "name": "Industry",
    "vars": {
        "module_filter": "-*,industry/*"
    },
    "steps": [
        {
            "name": "Install template database",
            "db_name": "industry",
            "job_type": "odoo",
            "demo_mode": "without_demo",
            "install_modules": "appointment,base_import_module,calendar,crm,documents_account,helpdesk,hr_timesheet,hr_work_entry,knowledge,link_tracker,mass_mailing,mrp,partnership,payment_demo,planning_field_service_sale_worksheet,point_of_sale,pos_loyalty,pos_sale,pos_self_order,product_expiry,project_forecast,quality_control,sale_loyalty_delivery,sale_planning,sale_project,sale_purchase_stock,sale_renting,sale_subscription,sale_timesheet,sign,social,survey,timesheet_grid,web_hierarchy,web_studio,website_event_sale,website_partner,website_sale_loyalty,industry/test_*"
        },
        {
            "name": "Test all Industries",
            "job_type": "command",
            "db_name": "industry",
            "command": "odoo/odoo-bin --addons-path={{addons_path}} test_industry -d {{db_name}} --data-dir {{data_dir}} --all --test-enable --log-db runbot_logs --log-db-level=26 --industry-demo",
            "check_logs": ["ERROR", "WARNING"],
            "expected_logs": ["Initiating shutdown", "Starting post tests"]
        }
    ]
}
