<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="hazardous_products_inventory_menuitem" model="ir.ui.menu">
        <field name="name">Hazardous Products</field>
        <field name="parent_id" ref="stock.menu_stock_config_settings"/>
        <field name="sequence">60</field>
    </record>
    <record id="hazardous_categories_inventory_menuitem" model="ir.ui.menu">
        <field name="name">Hazardous Product Categories</field>
        <field name="parent_id" ref="hazardous_products_inventory_menuitem"/>
        <field name="action" ref="action_hazardous_category_list_view"/>
    </record>
    <record id="hazardous_recipients_inventory_menuitem" model="ir.ui.menu">
        <field name="name">Hazardous Product Recipients</field>
        <field name="parent_id" ref="hazardous_products_inventory_menuitem"/>
        <field name="action" ref="action_hazardous_recipient_list_view"/>
    </record>
    <record id="hazardous_transactions_menuitem" model="ir.ui.menu">
        <field name="name">Hazardous Product Transactions</field>
        <field name="parent_id" ref="planning.planning_menu_reporting"/>
        <field name="action" ref="action_hazardous_product_transaction_list_view"/>
    </record>
</odoo>
