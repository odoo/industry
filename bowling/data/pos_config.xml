<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <function model="pos.config" name="load_onboarding_bar_scenario">
    <value name="with_demo_data" model="ir.module.module" eval="obj().search([('name', '=', 'bowling')]).demo"/>
  </function>

  <function model="ir.model.data" name="write">
    <value model="ir.model.data" search="[
        ('name', '=', 'pos_config_main_bar'),
        ('module', '=', 'pos_restaurant'),
        ('model', '=', 'pos.config'),
    ]"/>
    <value eval="{'module': 'bowling', 'name': 'pos_config_1'}"/>
  </function>

  <record id="pos_config_1" model="pos.config">
    <field name="name">Bowling Lanes &amp; Dinner</field>
  </record>
</odoo>
