                                                <p><br/>info@bowlingcenter.example.com</p>
                                            </div>
                                        </div>
                                    </div><div class="s_attributes_horizontal_col pt24 pb24 o_colored_level border col-lg-4 s_parallax_no_overflow_hidden" data-name="Column" style="background-color: rgb(9, 11, 29); --box-border-left-width: 0px; --box-border-right-width: 0px; border-color: rgba(0, 255, 254, 0.09) !important;" data-scroll-background-ratio="0">
