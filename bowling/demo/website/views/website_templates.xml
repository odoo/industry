<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="template_footer_mega_links" model="ir.ui.view">
        <field name="name">Bowling Center - Mega Links</field>
        <field name="key">website.template_footer_mega_links</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pb24 pt112" data-snippet="s_text_block" data-name="Top Part">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-12 o_colored_level pb24 order-lg-0" style="order: 0;">
                                    <div class="s_hr pb24 pt24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto" style="border-top-color: rgba(203, 9, 251, 0.31);"/>
                                    </div>
                                </div>
                                <div class="o_colored_level col-lg-3 pb32 order-lg-0" style="order: 1;">
                                    <p><img src="/web/image/bowling.img_custom_bowling_center_image_16" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/><span class="o_small-fs" style="color: rgba(255, 255, 255, 0.91);">More than a bowling center, it's a place to have fun, connect, and create unforgettable memories!</span><span style="color: rgba(255, 255, 255, 0.91);"><br/><br/></span></p><div class="s_social_media o_not_editable text-start" data-snippet="s_social_media" data-name="Social Media">
                                        <h4 class="s_social_media_title d-none"><span class="h5-fs">Social Media</span></h4>
                                        <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="fa fa-facebook o_editable_media rounded-empty-circle shadow-sm text-o-color-2" style="border-left-color: var(--o-color-2); border-bottom-color: var(--o-color-2); border-right-color: var(--o-color-2); border-top-color: var(--o-color-2);"/>
                                        </a>
                                        <a href="/website/social/instagram" class="s_social_media_instagram" target="_blank" aria-label="Instagram">
                                            <i class="fa fa-instagram o_editable_media rounded-empty-circle shadow-sm text-o-color-2"/>
                                        </a>
                                        <a href="/website/social/tiktok" class="s_social_media_tiktok" target="_blank" aria-label="TikTok">
                                            <i class="fa o_editable_media fa-tiktok rounded-empty-circle shadow-sm text-o-color-2"/>
                                        </a>
                                    </div>
                                </div><div class="pb16 o_colored_level col-lg-3 order-lg-0" style="order: 2;">
                                    <p><span style="font-size: 16px;"><strong>USEFUL INFO</strong></span></p>
                                    <p><span style="color: rgba(255, 255, 255, 0.91);"><span class="o_small-fs"><strong>Mon – Thu    </strong>2:00 PM – 11:00 PM&amp;nbsp;</span></span><br/><span style="color: rgba(255, 255, 255, 0.91);"><span class="o_small-fs"><strong>Friday       </strong>2:00 PM – 2:00 AM&amp;nbsp;</span></span><br/><span style="color: rgba(255, 255, 255, 0.91);"><span class="o_small-fs"><strong>Sunday</strong> 02:00 PM&amp;nbsp;– 10:00 PM<br/><br/><span class="fa fa-phone"/>&amp;nbsp;+1 650-691-3277<br/><span class="fa fa-envelope-o"/>&amp;nbsp;info@bowlingcenter.example.com</span></span></p>
                                </div>
                                <div class="pb16 o_colored_level rounded col-lg-3 order-lg-0" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; order: 4;">
                                    <p><span style="font-size: 16px;"><strong>FIND US</strong></span></p>
                                    <div class="container">
                                        <div class="row">
                                            <div class="o-contenteditable-true o_colored_level col-lg-10 col-12 pb8">
                                                <p><span class="o_small-fs" style="color: rgba(255, 255, 255, 0.91);"><img src="/web/image/bowling.img_custom_bowling_center_image_17" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/></span></p><p><span class="h6-fs" style="color: rgb(206, 198, 206);"><span class="o_small-fs"><a href="https://www.google.com/maps/search/?api=1&amp;query=Avenue+des+D%C3%A9port%C3%A9s+48,+1367+Ramillies,+Belgium" class="o_translate_inline btn btn-sm btn-outline-custom" style="color: rgb(206, 198, 206); background-color: rgba(0, 0, 0, 0); border-width: 1px; border-style: solid; border-image: none; border-left-color: var(--o-color-4); border-bottom-color: var(--o-color-4); border-right-color: var(--o-color-4); border-top-color: var(--o-color-4);" target="_blank"><span class="fa fa-external-link"/>&amp;nbsp;Google Maps</a></span></span></p></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 pb16 o_colored_level order-lg-0" style="order: 3;">
                                    <p><span style="font-size: 16px;"><strong>QUICK LINKS</strong></span></p>
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-6 o-contenteditable-true o_colored_level">
                                                <ul class="list-unstyled">
                                                    <li><a href="/">Home</a></li><li><a class="o_translate_inline" href="/food-drinks">Food &amp;amp; Drinks</a></li><li class="oe-nested"><a class="o_translate_inline" href="/appointment">Book Your Lane</a><br/><a class="o_translate_inline" href="/about#OUR-SERVICES">Our Services</a><br/><a class="o_translate_inline" href="/contactus">Contact us</a></li>
                                                    <li><a href="/terms">Terms of Service</a></li></ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('o_footer_copyright')]//div[hasclass('col-md')]" position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
            <xpath expr="//div[hasclass('o_footer_copyright')]//div[hasclass('col-md')][2]" position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Bowling Center - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/appointment" class="oe_unremovable btn btn-primary">Book Your Lane</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
</odoo>
