"<span style=\"color: rgba(255, 255, 255, 0.91);\"><em>Fuel your fun with our "
"delicious selection of food and beverages.</em></span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.91);"
"\"><em>ເຕີມເຕັມຄວາມມ່ວນຊື່ນຂອງທ່ານດ້ວຍອາຫານ ແລະ ເຄື່ອງດື່ມຫຼາກຫຼາຍຊະນິດທີ່ແຊບຊ້ອຍ.</em></span>"

#. module: bowling
#: model_terms:ir.ui.view,arch_db:bowling.view_page_about_us
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.91);\">Celebrate unforgettable "
"birthdays with all-inclusive packages.</span>\n"
"                                            <br/>\n"
"                                            <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.91);"
"\">ສະເຫຼີມສະຫຼອງວັນເກີດທີ່ໜ້າຈົດຈໍາດ້ວຍແພັກເກດຄົບວົງຈອນ.</span>\n"
"                                            <br/>\n"
"                                            <br/>"

#. module: bowling
#: model_terms:ir.ui.view,arch_db:bowling.view_page_about_us
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.91);\">Enjoy delicious meals, "
"snacks, cocktails, and refreshing drinks before or after your game.</span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.91);\">ເພີດເພີນກັບອາຫານແຊບໆ, "
"ຂອງກິນຫຼິ້ນ, ຄັອກເທວ, ແລະ ເຄື່ອງດື່ມທີ່ສົດຊື່ນ ກ່ອນ ຫຼື ຫຼັງເກມຂອງທ່ານ.</span>"

#. module: bowling
#: model_terms:ir.ui.view,arch_db:bowling.view_page_about_us
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.91);\">From birthday parties and "
"team-building events to private celebrations and family fun, we provide "
"complete entertainment experiences tailored to every occasion.<br/><br/><br/"
"></span>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.91);\">ຕັ້ງແຕ່ງານລ້ຽງວັນເກີດ ແລະ "
"ກິດຈະກໍາສ້າງທີມ ຈົນເຖິງການສະເຫຼີມສະຫຼອງສ່ວນຕົວ ແລະ ຄວາມມ່ວນຊື່ນໃນຄອບຄົວ, "
"ພວກເຮົາພ້ອມມອບປະສົບການຄວາມບັນເທີງຄົບວົງຈອນທີ່ເໝາະສົມກັບທຸກໂອກາດ.<br/><br/><br/></span>"

#. module: bowling
#: model_terms:ir.ui.view,arch_db:bowling.view_page_about_us
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.91);\">Host birthdays, "
"celebrations, weddings, or private parties in a unique and entertaining "
"venue.</span>\n"
"                                            <br/>\n"
"                                            <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.91);\">ຈັດງານວັນເກີດ, ງານສະເຫຼີມສະຫຼອງ, "
"ງານດອງ, ຫຼື ງານລ້ຽງສ່ວນຕົວ ໃນສະຖານທີ່ທີ່ໂດດເດັ່ນ ແລະ ເຕັມໄປດ້ວຍຄວາມມ່ວນຊື່ນ.</span>\n"
"                                            <br/>\n"
"                                            <br/>"

#. module: bowling
#: model_terms:ir.ui.view,arch_db:bowling.view_page_about_us
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.91);\">Strengthen your team's "
"spirit with fun challenges, tournaments, and corporate activities.</span>\n"
"                                            <br/>\n"
"                                            <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.91);"
"\">ເສີມສ້າງຄວາມສາມັກຄີໃນທີມດ້ວຍການທ້າທາຍທີ່ມ່ວນຊື່ນ, ການແຂ່ງຂັນ, ແລະ ກິດຈະກໍາສໍາລັບບໍລິສັດ.</"
"span>\n"
"                                            <br/>\n"
"                                            <br/>"

#. module: bowling
#: model_terms:ir.ui.view,arch_db:bowling.view_page_food_drinks
msgid ""
"<span style=\"font-size: 16px;\" class=\"text-white\">\n"
"                                        All burgers are served with French "
"fries and your choice of sauce and&amp;nbsp;all pasta dishes are served with "
"freshly grated Parmesan cheese!\n"
"                                    </span>"
msgstr ""
