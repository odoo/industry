#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Appointments App</b>: </strong>Organize and book winery tours and "
"tastings, enhancing the visitor\n"
"                    experience."
msgstr ""
"<strong><b>Aplicația Programări</b>: </strong>Organizează și rezervă tururi "
"și degustări la cramă, îmbunătățind experiența\n"
"                    vizitatorilor."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>CRM App</b>: </strong>Cultivate relationships with distributors "
"and private clients, tracking leads\n"
"                    to close more deals effectively.<br/>"
msgstr ""
"<strong><b>Aplicația CRM</b>: </strong>Dezvoltă relațiile cu distribuitorii "
"și clienții privați, urmărind pistele de vânzare\n"
"                    pentru a încheia mai eficient mai multe contracte.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Field Service App</b>: </strong>Coordinate vineyard operations, "
"assigning tasks to teams for pruning,\n"
"                    spraying, and harvesting.<br/>"
msgstr ""
"<strong><b>Aplicația Servicii pe teren</b>: </strong>Coordonează "
"activitățile din podgorie, atribuind echipelor sarcini de tăiere,\n"
"                    stropire și recoltare.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Manufacturing App</b>: </strong>Manage the art of winemaking by "
"overseeing pressing, fermentation,\n"
"                    and blending processes with precision.<br/>"
msgstr ""
"<strong><b>Aplicația Producție</b>: </strong>Gestionează arta vinificației, "
"supraveghind cu precizie procesele de presare, fermentare\n"
"                    și cupajare.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>PLM App</b>: </strong>Innovate your wine portfolio by iterating "
"on blend recipes and managing product\n"
"                    lifecycle changes.<br/>"
msgstr ""
"<strong><b>Aplicația PLM</b>: </strong>Inovează gama de vinuri, "
"perfecționând rețetele de cupaj și gestionând modificările\n"
"                    ciclului de viață al produselor.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Manage direct sales at the cellar "
"door with an easy-to-use interface\n"
"                    for visitors and tourists.<br/>"
msgstr ""
"<strong><b>Aplicația Punct de vânzare</b>: </strong>Gestionează vânzările "
"directe la cramă cu o interfață ușor de folosit\n"
"                    de vizitatori și turiști.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Quality App</b>: </strong>Ensure every bottle meets your "
"standards by tracking quality control points\n"
"                    throughout production.<br/>"
msgstr ""
"<strong><b>Aplicația Calitate</b>: </strong>Asigură-te că fiecare sticlă "
"respectă standardele, urmărind punctele de control al calității\n"
"                    pe tot parcursul producției.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Website App</b>: </strong>Sell your wines globally with a fully "
"integrated eCommerce platform that\n"
"                    manages inventory in real-time.<br/>"
msgstr ""
"<strong><b>Aplicația Website</b>: </strong>Vinde vinurile în întreaga lume "
"printr-o platformă eCommerce integrată, care\n"
"                    gestionează stocul în timp real.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
