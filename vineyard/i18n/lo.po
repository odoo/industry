#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Appointments App</b>: </strong>Organize and book winery tours and "
"tastings, enhancing the visitor\n"
"                    experience."
msgstr ""
"<strong><b>ແອັບນັດໝາຍ</b>: </strong>ຈັດຕາຕະລາງ ແລະ ຈອງການທ່ຽວຊົມໂຮງບົ່ມວາຍລວມທັງການຊີມ"
"ລົດຊາດ ເພື່ອຍົກລະດັບປະສົບການ\n"
"                    ຂອງຜູ້ມາຢ້ຽມຊົມ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>CRM App</b>: </strong>Cultivate relationships with distributors "
"and private clients, tracking leads\n"
"                    to close more deals effectively.<br/>"
msgstr ""
"<strong><b>ແອັບ CRM</b>: </strong>ສ້າງສາຍພົວພັນກັບຕົວແທນຈຳໜ່າຍ ແລະ ລູກຄ້າສ່ວນບຸກຄົນ, ຕິດຕາ"
"ມລູກຄ້າທີ່ມຸ່ງຫວັງ\n"
"                    ເພື່ອປິດການຂາຍໄດ້ຢ່າງມີປະສິດທິພາບຫຼາຍຂຶ້ນ.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Field Service App</b>: </strong>Coordinate vineyard operations, "
"assigning tasks to teams for pruning,\n"
"                    spraying, and harvesting.<br/>"
msgstr ""
"<strong><b>ແອັບບໍລິການພາກສະໜາມ</b>: </strong>ປະສານງານການດຳເນີນງານໃນສວນອະງຸ່ນ, ມອບໝາ"
"ຍວຽກໃຫ້ທີມງານໃນການຕັດແຕ່ງກິ່ງ,\n"
"                    ການສີດພົ່ນ ແລະ ການເກັບກ່ຽວ.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Manufacturing App</b>: </strong>Manage the art of winemaking by "
"overseeing pressing, fermentation,\n"
"                    and blending processes with precision.<br/>"
msgstr ""
"<strong><b>ແອັບການຜະລິດ</b>: </strong>ຄຸ້ມຄອງສິລະປະການຜະລິດວາຍ ໂດຍການຄວບຄຸມການຄັ້ນ, ກາ"
"ນໝັກ,\n"
"                    ແລະ ຂະບວນການປະສົມວາຍຢ່າງລະອຽດຊັດເຈນ.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>PLM App</b>: </strong>Innovate your wine portfolio by iterating "
"on blend recipes and managing product\n"
"                    lifecycle changes.<br/>"
msgstr ""
"<strong><b>ແອັບ PLM</b>: </strong>ສ້າງນະວັດຕະກຳໃຫ້ແກ່ວາຍຂອງທ່ານ ໂດຍການພັດທະນາສູດປະສົມ "
"ແລະ ຄຸ້ມຄອງການປ່ຽນແປງ\n"
"                    ວົງຈອນຊີວິດຂອງຜະລິດຕະພັນ.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Manage direct sales at the cellar "
"door with an easy-to-use interface\n"
"                    for visitors and tourists.<br/>"
msgstr ""
"<strong><b>ແອັບຈຸດຂາຍ (POS)</b>: </strong>ຄຸ້ມຄອງການຂາຍໂດຍກົງຢູ່ໜ້າຫ້ອງບົ່ມວາຍ ດ້ວຍໜ້າຕ່າງກ"
"ານໃຊ້ງານທີ່ງ່າຍດາຍ\n"
"                    ສຳລັບຜູ້ມາຢ້ຽມຊົມ ແລະ ນັກທ່ອງທ່ຽວ.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Quality App</b>: </strong>Ensure every bottle meets your "
"standards by tracking quality control points\n"
"                    throughout production.<br/>"
msgstr ""
"<strong><b>ແອັບຄຸນນະພາບ</b>: </strong>ຮັບປະກັນໃຫ້ທຸກຂວດໄດ້ມາດຕະຖານຂອງທ່ານ ໂດຍການຕິດຕາມ"
"ຈຸດກວດກາຄຸນນະພາບ\n"
"                    ຕະຫຼອດຂະບວນການຜະລິດ.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Website App</b>: </strong>Sell your wines globally with a fully "
"integrated eCommerce platform that\n"
"                    manages inventory in real-time.<br/>"
msgstr ""
"<strong><b>ແອັບເວັບໄຊ</b>: </strong>ຂາຍວາຍຂອງທ່ານໄປທົ່ວໂລກ ດ້ວຍລະບົບ eCommerce ທີ່ເຊື່ອມ"
"ໂຍງຄົບວົງຈອນ ເຊິ່ງ\n"
"                    ຄຸ້ມຄອງສາງສິນຄ້າແບບເວລາຈິງ.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Accept multiple payment methods</strong> (cash, card)."
msgstr "<strong>ຮັບການຊຳລະເງິນຫຼາຍຮູບແບບ</strong> (ເງິນສົດ, ບັດ)."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Manage finances, track profitability by "
"product line, and automate reporting."
msgstr ""
"<strong>ການບັນຊີ</strong> – ຄຸ້ມຄອງການເງິນ, ຕິດຕາມຜົນກຳໄລຕາມກຸ່ມຜະລິດຕະພັນ, ແລະ ອອກລາຍງາ"
"ນແບບອັດຕະໂນມັດ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Add products</strong> to POS catalog."
msgstr "<strong>ເພີ່ມສິນຄ້າ</strong> ເຂົ້າໃນລາຍການ POS."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Analyze trends</strong> for planning through reporting."
msgstr "<strong>ວິເຄາະທ່າອ່ຽງ</strong> ສຳລັບການວາງແຜນຜ່ານລາຍງານ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Apply taxes</strong> automatically on invoices."
msgstr "<strong>ຄິດໄລ່ອາກອນ</strong> ໃສ່ໃບແຈ້ງໜີ້ແບບອັດຕະໂນມັດ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Appointments 📅</strong>"
msgstr "<strong>ການນັດໝາຍ 📅</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Approve only if tests pass</strong>."
msgstr "<strong>ອະນຸມັດສະເພາະເມື່ອຜ່ານການທົດສອບເທົ່ານັ້ນ</strong>."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Assign checks</strong> to manufacturing steps."
msgstr "<strong>ກຳນົດການກວດສອບ</strong> ໃສ່ຂັ້ນຕອນການຜະລິດ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Assign lot numbers</strong> to batches."
msgstr "<strong>ກຳນົດເລກຊຸດ (Lot)</strong> ໃຫ້ກັບແຕ່ລະຊຸດ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Assign to workers</strong> or external partners."
msgstr "<strong>ມອບໝາຍໃຫ້ແກ່ກຳມະກອນ</strong> ຫຼື ຄູ່ຮ່ວມງານພາຍນອກ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Attach related quality points</strong> to ECO."
msgstr "<strong>ແນບຈຸດກວດກາຄຸນນະພາບທີ່ກ່ຽວຂ້ອງ</strong> ໃສ່ ECO."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Basics</strong>"
msgstr "<strong>ພື້ນຖານ</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>CRM 🎯</strong>"
msgstr "<strong>CRM 🎯</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Capture leads</strong> from website forms or direct outreach."
msgstr ""
"<strong>ເກັບກຳລູກຄ້າທີ່ມຸ່ງຫວັງ</strong> ຈາກແບບຟອມເວັບໄຊ ຫຼື ການຕິດຕໍ່ໂດຍກົງ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Collaborate internally</strong> through chatter notes and file "
"attachments."
msgstr "<strong>ຮ່ວມມືພາຍໃນ</strong> ຜ່ານບັນທຶກຂໍ້ຄວາມສົນທະນາ ແລະ ໄຟລ໌ແນບ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Compare yield ratios</strong> to expectations."
msgstr "<strong>ປຽບທຽບອັດຕາຜົນຜະລິດ</strong> ກັບການຄາດຄະເນ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Configure excise rates</strong> in products."
msgstr "<strong>ກຳນົດອັດຕາອາກອນຊົມໃຊ້</strong> ຢູ່ໃນສິນຄ້າ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Create appointment types</strong> (e.g., tour &amp; tasting, private "
"tour)."
msgstr ""
"<strong>ສ້າງປະເພດການນັດໝາຍ</strong> (ຕົວຢ່າງ: ທ່ຽວຊົມ &amp; ຊີມລົດຊາດ, ທ່ຽວຊົມແບບສ່ວນຕົວ)"
"."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Create engineering change orders</strong> in PLM."
msgstr "<strong>ສ້າງໃບສັ່ງປ່ຽນແປງທາງວິສະວະກຳ (ECO)</strong> ໃນ PLM."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Create manufacturing orders</strong> for specific grapes, musts and "
"assemblages."
msgstr ""
"<strong>ສ້າງໃບສັ່ງຜະລິດ</strong> ສຳລັບໝາກອະງຸ່ນ, ນ້ຳອະງຸ່ນຄັ້ນ ແລະ ສູດປະສົມສະເພາະ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Create product pages</strong> with tasting notes and vintage details."
msgstr "<strong>ສ້າງໜ້າສິນຄ້າ</strong> ພ້ອມລາຍລະອຽດລົດຊາດ ແລະ ປີຜະລິດ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Create tasks</strong> with location, date, and description."
msgstr "<strong>ສ້າງວຽກ</strong> ພ້ອມສະຖານທີ່, ວັນທີ, ແລະ ຄຳອະທິບາຍ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Define bills of materials</strong> with grape types and quantities."
msgstr "<strong>ກຳນົດໂຄງສ້າງສິນຄ້າ (BOM)</strong> ພ້ອມຊະນິດອະງຸ່ນ ແລະ ຈຳນວນ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Define quality control points</strong> (acidity, sugar content, "
"clarity)."
msgstr ""
"<strong>ກຳນົດຈຸດກວດກາຄຸນນະພາບ</strong> (ຄວາມສົ້ມ, ປະລິມານນ້ຳຕານ, ຄວາມໃສ)."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Detailed usage:</strong>"
msgstr "<strong>ການນຳໃຊ້ລະອຽດ:</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Do You Want to Go Further?</strong>"
msgstr "<strong>ທ່ານຕ້ອງການຮຽນຮູ້ເພີ່ມຕື່ມບໍ່?</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Enable online payments</strong> and automated invoicing."
msgstr ""
"<strong>ເປີດໃຊ້ການຊຳລະເງິນອອນລາຍ</strong> ແລະ ການອອກໃບແຈ້ງໜີ້ອັດຕະໂນມັດ."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Events</strong> – Organize wine festivals, promotional events, or "
"launch parties."
msgstr ""
