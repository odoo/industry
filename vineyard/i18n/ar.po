msgstr "<strong>حدد نقاط مراقبة الجودة</strong> (الحموضة، محتوى السكر، الوضوح)."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Detailed usage:</strong>"
msgstr "<strong>الاستخدام التفصيلي:</strong>"

