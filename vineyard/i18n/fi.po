#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Appointments App</b>: </strong>Organize and book winery tours and "
"tastings, enhancing the visitor\n"
"                    experience."
msgstr ""
"<strong><b>Ajanvaraukset-sovellus</b>: </strong>Järjestä ja varaa "
"viinitilakierroksia ja maisteluita vierailijakokemuksen\n"
"                    parantamiseksi."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>CRM App</b>: </strong>Cultivate relationships with distributors "
"and private clients, tracking leads\n"
"                    to close more deals effectively.<br/>"
msgstr ""
"<strong><b>CRM-sovellus</b>: </strong>Vaali suhteita jakelijoihin ja "
"yksityisasiakkaisiin sekä seuraa liidejä\n"
"                    solmiaksesi enemmän kauppoja.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
