msgid "<span class=\"display-4-fs\"><strong>Vineyard</strong></span>"
msgstr "<span class=\"display-4-fs\"><strong>Лозе</strong></span>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Appointments App</b>: </strong>Organize and book winery tours and "
"tastings, enhancing the visitor\n"
"                    experience."
msgstr ""
"<strong><b>Приложение „Срещи“</b>: </strong>Организирайте и резервирайте "
"обиколки на винарната и дегустации, като подобрявате преживяването на\n"
"                    посетителите."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>CRM App</b>: </strong>Cultivate relationships with distributors "
"and private clients, tracking leads\n"
"                    to close more deals effectively.<br/>"
msgstr ""
"<strong><b>Приложение CRM</b>: </strong>Развивайте отношенията с "
"дистрибутори и частни клиенти, като проследявате потенциалните клиенти\n"
"                    и приключвате повече сделки успешно.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Field Service App</b>: </strong>Coordinate vineyard operations, "
"assigning tasks to teams for pruning,\n"
"                    spraying, and harvesting.<br/>"
msgstr ""
"<strong><b>Приложение „Обслужване на място“</b>: </strong>Координирайте "
"дейностите в лозето, като възлагате на екипите задачи за резитба,\n"
"                    пръскане и гроздобер.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Manufacturing App</b>: </strong>Manage the art of winemaking by "
"overseeing pressing, fermentation,\n"
"                    and blending processes with precision.<br/>"
msgstr ""
"<strong><b>Приложение „Производство“</b>: </strong>Управлявайте изкуството "
"на винопроизводството, като следите прецизно пресоването, ферментацията\n"
"                    и асамблирането.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>PLM App</b>: </strong>Innovate your wine portfolio by iterating "
"on blend recipes and managing product\n"
"                    lifecycle changes.<br/>"
msgstr ""
"<strong><b>Приложение PLM</b>: </strong>Обновявайте портфолиото си от вина, "
"като работите итеративно върху рецептите за асамблажи и управлявате "
"промените в жизнения цикъл на продукта.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Manage direct sales at the cellar "
"door with an easy-to-use interface\n"
"                    for visitors and tourists.<br/>"
msgstr ""
"<strong><b>Приложение „Център за продажби“</b>: </strong>Управлявайте "
"директните продажби на входа на избата с лесен за ползване интерфейс\n"
"                    за посетители и туристи.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Quality App</b>: </strong>Ensure every bottle meets your "
"standards by tracking quality control points\n"
"                    throughout production.<br/>"
msgstr ""
"<strong><b>Приложение „Качество“</b>: </strong>Гарантирайте, че всяка "
"бутилка отговаря на стандартите ви, като следите контролните точки за "
"качество\n"
"                    през цялото производство.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong><b>Website App</b>: </strong>Sell your wines globally with a fully "
"integrated eCommerce platform that\n"
"                    manages inventory in real-time.<br/>"
msgstr ""
"<strong><b>Приложение „Уебсайт“</b>: </strong>Продавайте вината си по целия "
"свят чрез напълно интегрирана платформа за електронна търговия, която\n"
"                    управлява наличностите в реално време.<br/>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Accept multiple payment methods</strong> (cash, card)."
msgstr ""
"<strong>Приемайте различни начини на плащане</strong> (в брой, с карта)."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Manage finances, track profitability by "
"product line, and automate reporting."
msgstr ""
"<strong>Счетоводство</strong> – Управлявайте финансите, следете "
"рентабилността по продуктова линия и автоматизирайте отчитането."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Add products</strong> to POS catalog."
msgstr "<strong>Добавяйте продукти</strong> в каталога на POS."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Analyze trends</strong> for planning through reporting."
msgstr "<strong>Анализирайте тенденциите</strong> за планиране чрез отчетите."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Apply taxes</strong> automatically on invoices."
msgstr "<strong>Прилагайте данъците</strong> автоматично във фактурите."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Appointments 📅</strong>"
msgstr "<strong>Срещи 📅</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Approve only if tests pass</strong>."
msgstr "<strong>Одобрявайте само ако тестовете са успешни</strong>."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Assign checks</strong> to manufacturing steps."
msgstr "<strong>Присвоявайте проверки</strong> към производствените стъпки."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Assign lot numbers</strong> to batches."
msgstr ""
"<strong>Присвоявайте партидни номера</strong> на производствените партиди."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Assign to workers</strong> or external partners."
msgstr "<strong>Възлагайте на работници</strong> или на външни партньори."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Attach related quality points</strong> to ECO."
msgstr "<strong>Прикачвайте свързаните точки за качество</strong> към ECO."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Basics</strong>"
msgstr "<strong>Основи</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>CRM 🎯</strong>"
msgstr "<strong>CRM 🎯</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Capture leads</strong> from website forms or direct outreach."
msgstr ""
"<strong>Събирайте потенциални клиенти</strong> от формулярите на уебсайта "
"или чрез директен контакт."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Collaborate internally</strong> through chatter notes and file "
"attachments."
msgstr ""
"<strong>Сътрудничете си вътрешно</strong> чрез бележки в чатъра и прикачени "
"файлове."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Compare scrap over time</strong> to measure progress."
msgstr ""
"<strong>Сравнявайте скрапа във времето</strong>, за да измервате напредъка."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Compare yield ratios</strong> to expectations."
msgstr "<strong>Сравнявайте добивите</strong> с очакванията."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Configure excise rates</strong> in products."
msgstr "<strong>Конфигурирайте акцизните ставки</strong> в продуктите."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Create appointment types</strong> (e.g., tour &amp; tasting, private "
"tour)."
msgstr ""
"<strong>Създавайте типове срещи</strong> (напр. обиколка &amp; дегустация, "
"частна обиколка)."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Create engineering change orders</strong> in PLM."
msgstr "<strong>Създавайте заявки за инженерна промяна</strong> в PLM."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Create manufacturing orders</strong> for specific grapes, musts and "
"assemblages."
msgstr ""
"<strong>Създавайте производствени поръчки</strong> за конкретни сортове "
"грозде, мъст и асамблажи."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Create product pages</strong> with tasting notes and vintage details."
msgstr ""
"<strong>Създавайте продуктови страници</strong> с дегустационни бележки и "
"данни за реколтата."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Create tasks</strong> with location, date, and description."
msgstr "<strong>Създавайте задачи</strong> с местоположение, дата и описание."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Define bills of materials</strong> with grape types and quantities."
msgstr ""
"<strong>Дефинирайте списъци с материали</strong> със сортовете грозде и "
"количествата."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Define quality control points</strong> (acidity, sugar content, "
"clarity)."
msgstr ""
"<strong>Дефинирайте контролни точки за качество</strong> (киселинност, "
"съдържание на захар, прозрачност)."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Detailed usage:</strong>"
msgstr "<strong>Подробна употреба:</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Do You Want to Go Further?</strong>"
msgstr "<strong>Искате ли да отидете по-далеч?</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Enable online payments</strong> and automated invoicing."
msgstr ""
"<strong>Активирайте онлайн плащанията</strong> и автоматичното фактуриране."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Events</strong> – Organize wine festivals, promotional events, or "
"launch parties."
msgstr ""
"<strong>Събития</strong> – Организирайте винени фестивали, промоционални "
"събития или партита за представяне."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Excise Management 💰</strong>"
msgstr "<strong>Управление на акцизи 💰</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Field Service 🚜</strong>"
msgstr "<strong>Обслужване на място 🚜</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Follow up </strong>your plan from the planning"
msgstr "<strong>Проследявайте </strong>плана си от планирането"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Generate excise reports</strong> for submission."
msgstr "<strong>Генерирайте акцизни отчети</strong> за подаване."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Generate lot numbers</strong> for traceability."
msgstr "<strong>Генерирайте партидни номера</strong> за проследимост."

#. module: vineyard
#: model_terms:product.template,description:vineyard.product_product_16_product_template
#: model_terms:product.template,description:vineyard.product_product_25_product_template
#: model_terms:product.template,description:vineyard.product_product_26_product_template
#: model_terms:product.template,description:vineyard.product_product_27_product_template
msgid ""
"<strong>Goal</strong>: Aromatic complexity, age-worthiness, firm tannins"
msgstr ""
"<strong>Цел</strong>: ароматна сложност, потенциал за отлежаване, стегнати "
"танини"

#. module: vineyard
#: model_terms:product.template,description:vineyard.product_product_17_product_template
msgid "<strong>Goal</strong>: Deep color, spice, aging potential"
msgstr "<strong>Цел</strong>: наситен цвят, подправки, потенциал за отлежаване"

#. module: vineyard
#: model_terms:product.template,description:vineyard.product_product_15_product_template
msgid "<strong>Goal</strong>: Round mouthfeel, fruit-forward, soft tannins"
msgstr ""
"<strong>Цел</strong>: заоблено усещане в устата, плодов профил, меки танини"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Harvest Management 🌾</strong>"
msgstr "<strong>Управление на гроздобера 🌾</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.ir_ui_view_4048
msgid ""
"<strong>Includes:</strong> Vineyard walk, cellar visit, guided tasting of 3 "
"wines"
msgstr ""
"<strong>Включва:</strong> разходка в лозето, посещение на избата, дегустация "
"с водач на 3 вина"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Integrate your apps</strong> so sales, production, and quality data "
"flow seamlessly."
msgstr ""
"<strong>Интегрирайте приложенията си</strong>, така че данните за "
"продажбите, производството и качеството да се обменят безпроблемно."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.ir_ui_view_4048
msgid "<strong>Languages:</strong> EN / CH / FR"
msgstr "<strong>Езици:</strong> EN / CH / FR"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Log grape harvests</strong> in Inventory."
msgstr "<strong>Записвайте гроздоберите</strong> в „Инвентар“."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Log results</strong> for each lot."
msgstr "<strong>Записвайте резултатите</strong> за всяка партида."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Log time and materials</strong> used."
msgstr "<strong>Записвайте вложеното време и материали</strong>."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Manufacturing 🛠</strong>"
msgstr "<strong>Производство 🛠</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Mark complete</strong> once the work is done."
msgstr ""
"<strong>Отбелязвайте като завършено</strong>, след като работата е "
"приключена."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Monitor yields</strong> and scrap quantities."
msgstr "<strong>Следете добивите</strong> и количествата скрап."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Move opportunities</strong> across pipeline stages until closing."
msgstr ""
"<strong>Придвижвайте възможностите</strong> през етапите на процеса до "
"приключване."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>PLM 🧪</strong>"
msgstr "<strong>PLM 🧪</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Point of Sale 🏷</strong>"
msgstr "<strong>Център за продажби 🏷</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Prepare guest experiences</strong> based on booking notes."
msgstr ""
"<strong>Подготвяйте преживяването на гостите</strong> според бележките от "
"резервацията."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Print or email receipts</strong>."
msgstr ""
"<strong>Отпечатвайте касовите бележки или ги изпращайте по имейл</strong>."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Promote offers</strong> through banners and newsletters."
msgstr "<strong>Популяризирайте офертите</strong> чрез банери и бюлетини."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Publish booking links</strong> on your website."
msgstr "<strong>Публикувайте връзки за резервация</strong> на своя уебсайт."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Qualify prospects</strong> by checking interest level, wine "
"preferences, and budget."
msgstr ""
"<strong>Квалифицирайте потенциалните клиенти</strong>, като проверявате "
"нивото на интерес, предпочитанията за вино и бюджета."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Quality ✅</strong>"
msgstr "<strong>Качество ✅</strong>"

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid "<strong>Receive notifications</strong> for new bookings."
msgstr "<strong>Получавайте известия</strong> за нови резервации."

#. module: vineyard
#: model_terms:ir.ui.view,arch_db:vineyard.welcome_article_body
msgid ""
"<strong>Record production steps</strong> such as fermentation and blending."
