#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>\n"
"                    Sign</strong> – Collect digital signatures for placement mandates and approvals."
msgstr ""
"<strong>\n"
"                    Assinatura de Documentos</strong> – Colete assinaturas "
"digitais para mandatos de colocação e aprovações."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr "<strong>Financeiro</strong> – Gestão financeira e relatórios avançados."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and then\n"
"                        to create a new one for your own usage.</strong>"
msgstr ""
"<strong>Nesta situação, sinta-se à vontade para experimentar esta base de "
"dados e depois criar uma nova para seu próprio uso.</strong>"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Purchase</strong> – Manage your suppliers, request for quotations and\n"
"                orders."
msgstr ""
"<strong>Compras</strong> – Gerencie seus fornecedores, solicitações de "
"cotação e pedidos."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
