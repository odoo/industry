#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>\n"
"                    Sign</strong> – Collect digital signatures for placement mandates and approvals."
msgstr ""
"<strong>\n"
"                   E-Signatur</strong> – Erfassen Sie digitale "
"Unterschriften für Betreuungsvereinbarungen und Genehmigungen."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr ""
"<strong>Buchhaltungs-</strong> – Fortgeschrittenes Finanzmanagement und "
"Berichterstattung."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and then\n"
"                        to create a new one for your own usage.</strong>"
msgstr ""
"<strong>In einem solchen Fall können Sie gerne mit dieser Datenbank "
"experimentieren und\n"
"                        anschließend eine neue Datenbank für Ihren eigenen "
"Gebrauch erstellen.</strong>"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Purchase</strong> – Manage your suppliers, request for quotations and\n"
"                orders."
msgstr ""
"<strong>Einkauf</strong> – Verwalten Sie Ihre Lieferanten, Angebotsanfragen "
"und Bestellungen."

