#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>\n"
"                    Sign</strong> – Collect digital signatures for placement mandates and approvals."
msgstr ""
"<strong>\n"
"                   Tanda Tangan</strong> – Kumpulkan tanda tangan digital "
"untuk mandat penempatan dan persetujuan."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr ""
"<strong>Akuntansi</strong> – Manajemen keuangan dan pelaporan tingkat lanjut."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and then\n"
"                        to create a new one for your own usage.</strong>"
msgstr ""
"<strong>Di situasi tersebut, jangan ragu untuk berkesperimentasi dengan "
"database ini dan lalu\n"
"                        buat database baru untuk penggunaan Anda sendiri.</"
"strong>"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Purchase</strong> – Manage your suppliers, request for quotations and\n"
"                orders."
msgstr ""
"<strong>Purchase</strong> – Kelola pemasok, permintaan penawaran, dan\n"
"                order."

