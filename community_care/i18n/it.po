#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>\n"
"                    Sign</strong> – Collect digital signatures for placement mandates and approvals."
msgstr ""
"<strong>\n"
"                    Firma</strong>: raccogli firme digitali per mandati di "
"collocamento e approvazioni;"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr ""
"<strong>Contabilità</strong>: gestisci le tue finanze e sfrutta gli "
"strumenti per la reportistica;"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and then\n"
"                        to create a new one for your own usage.</strong>"
msgstr ""
"<strong>In situazioni del genere, non esitare a testare questo database e\n"
"                        a crearne un altro in seguito per la tua attività.</"
"strong>"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Purchase</strong> – Manage your suppliers, request for quotations and\n"
"                orders."
msgstr ""
"<strong>Acquisti</strong>: gestisci i fornitori, le richieste di preventivo "
"e\n"
"                gli ordini;"

