msgstr "<span class=\"o_stat_text\">Documente</span>"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>\n"
"                    Sign</strong> – Collect digital signatures for placement "
"mandates and approvals."
msgstr ""
"<strong>\n"
"                    Semnare</strong> – colectați semnături digitale pentru "
"mandate de plasament și aprobări."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr ""
"<strong>Contabilitate</strong> – gestiune financiară și raportare avansate."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and "
"then\n"
"                        to create a new one for your own usage.</strong>"
msgstr ""
"<strong>În această situație, puteți testa această bază de date și apoi crea "
"una nouă pentru uzul propriu.</strong>"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Purchase</strong> – Manage your suppliers, request for quotations "
"and\n"
"                orders."
msgstr ""
"<strong>Achiziții</strong> – gestionați furnizorii, cererile de ofertă și "
"comenzile."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
