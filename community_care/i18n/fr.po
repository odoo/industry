msgstr "<span class=\"o_stat_text\">Documents</span>"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>\n"
"                    Sign</strong> – Collect digital signatures for placement "
"mandates and approvals."
msgstr ""
"<strong>\n"
"                   Signature</strong> – Recueillez des signatures "
"électroniques pour les mandats de placement et les approbations."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Accounting</strong> – Advanced financial management and reporting."
msgstr "<strong>Comptabilité</strong> – Gestion financière avancée et rapports."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and "
"then\n"
"                        to create a new one for your own usage.</strong>"
msgstr ""
"<strong>Dans ce cas, n'hésitez pas à expérimenter avec cette base de "
"données, puis\n"
"                        à en créer une nouvelle pour votre propre "
"utilisation.</strong>"

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
msgid ""
"<strong>Purchase</strong> – Manage your suppliers, request for quotations "
"and\n"
"                orders."
msgstr ""
"<strong>Achats</strong> – Gérez vos fournisseurs, vos demandes de prix et "
"vos\n"
"                commandes."

#. module: community_care
#: model_terms:ir.ui.view,arch_db:community_care.welcome_article_body
