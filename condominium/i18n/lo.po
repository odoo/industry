msgid ""
"<strong>\n"
"\t\t\t\t\t\t\t\tGENERAL MEETING REPORT\n"
"\t\t\t\t\t\t\t</strong>"
msgstr ""
"<strong>\n"
"\t\t\t\t\t\t\t\tບົດລາຍງານກອງປະຊຸມໃຫຍ່\n"
"\t\t\t\t\t\t\t</strong>"

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid "<strong><u>onboarding tour</u></strong>"
msgstr "<strong><u>ການນໍາທ່ຽວຊົມເລີ່ມຕົ້ນໃຊ້ງານ</u></strong>"

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Accounting:</strong> Manage shared expenses, distribute costs by "
"owner, and maintain owner-specific balance sheets."
msgstr ""
"<strong>ການບັນຊີ:</strong> ຈັດການຄ່າໃຊ້ຈ່າຍສ່ວນລວມ, ປັນສ່ວນຕົ້ນທຶນຕາມເຈົ້າຂອງ, ແລະ ຮັກສາໃບສະ"
"ຫຼຸບຊັບສົມບັດສະເພາະຂອງແຕ່ລະເຈົ້າຂອງ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Automate recurring tasks</strong>, like meter reading imports or "
"expense allocation."
msgstr ""
"<strong>ເຮັດໃຫ້ໜ້າວຽກທີ່ເກີດຂຶ້ນຊໍ້າໆເປັນອັດຕະໂນມັດ</strong>, ເຊັ່ນ: ການນໍາເຂົ້າຄ່າອ່ານໝໍ້ວັດແທກ ຫຼື ກ"
"ານປັນສ່ວນຄ່າໃຊ້ຈ່າຍ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>CRM:</strong> Track and manage incoming leads and communications "
"with potential new condominiums."
msgstr ""
"<strong>CRM:</strong> ຕິດຕາມ ແລະ ຈັດການຜູ້ຕິດຕໍ່ສົນໃຈໃໝ່ ແລະ ການສື່ສານກັບອາຄານຊຸດໃໝ່ທີ່ມີທ່າແຮ"
"ງ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Calendar:</strong> Schedule and organize association meetings, "
"collecting votes during general assemblies and share the report."
msgstr ""
"<strong>ປະຕິທິນ:</strong> ກໍານົດເວລາ ແລະ ຈັດຕັ້ງກອງປະຊຸມນິຕິບຸກຄົນ, ເກັບກໍາສຽງລົງຄະແນນໃນລະຫວ່"
"າງກອງປະຊຸມໃຫຍ່ ແລະ ແບ່ງປັນບົດລາຍງານ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Condominium:</strong> Define buildings, properties, owner and tenant "
"histories, meter readings and distribution keys."
msgstr ""
"<strong>ອາຄານຊຸດ:</strong> ກໍານົດອາຄານ, ຫ້ອງຊຸດ/ອະສັງຫາລິມະຊັບ, ປະຫວັດເຈົ້າຂອງ ແລະ ຜູ້ເຊົ່"
"າ, ຄ່າອ່ານໝໍ້ວັດແທກ ແລະ ຫຼັກເກນການປັນສ່ວນ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Contacts:</strong> Manage contacts turning prospects into "
"condominiums, as well as owners, tenants and suppliers."
msgstr ""
"<strong>ຜູ້ຕິດຕໍ່:</strong> ຈັດການລາຍຊື່ຜູ້ຕິດຕໍ່ ໂດຍປ່ຽນຜູ້ມີທ່າແຮງໃຫ້ກາຍເປັນອາຄານຊຸດ, ລວມທັງເຈົ້າຂອ"
"ງ, ຜູ້ເຊົ່າ ແລະ ຜູ້ສະໜອງ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Define a chart of accounts template for condominiums</strong> to "
"save time setting up accounting aspects. Don't hesitate to contact us if "
"needed!"
msgstr ""
"<strong>ກໍານົດແບບແຜນຜັງບັນຊີສໍາລັບອາຄານຊຸດ</strong> ເພື່ອປະຢັດເວລາໃນການຕັ້ງຄ່າດ້ານບັນຊີ. ຢ່າລັງເ"
"ລທີ່ຈະຕິດຕໍ່ຫາພວກເຮົາຫາກຕ້ອງການຄວາມຊ່ວຍເຫຼືອ!"

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid "<strong>Documents App: </strong>Request and share documents."
msgstr "<strong>ແອັບເອກະສານ: </strong>ຮ້ອງຂໍ ແລະ ແບ່ງປັນເອກະສານ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and "
"then to create a new one for your own usage.</strong>"
msgstr ""
"<strong>ໃນກໍລະນີດັ່ງກ່າວ, ທ່ານສາມາດທົດລອງໃຊ້ງານຖານຂໍ້ມູນນີ້ໄດ້ຢ່າງເຕັມທີ່ ແລ້ວຈຶ່ງສ້າງຖານຂໍ້ມູນໃໝ່ສໍາລັບກ"
"ານນໍາໃຊ້ຕົວຈິງຂອງທ່ານ.</strong>"

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Keep contact data up-to-date</strong> to ensure seamless "
"communication during meetings, billing and accounting."
msgstr ""
"<strong>ຮັກສາຂໍ້ມູນຜູ້ຕິດຕໍ່ໃຫ້ເປັນປັດຈຸບັນຢູ່ສະເໝີ</strong> ເພື່ອຮັບປະກັນການຕິດຕໍ່ສື່ສານທີ່ສະດວກໃນລະຫວ່າງ"
"ການປະຊຸມ, ການອອກໃບບິນ ແລະ ການບັນຊີ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Leverage tags and filters</strong> in Contacts and CRM to segment "
"your audience (owners, tenants, suppliers, condominiums...)."
msgstr ""
"<strong>ນໍາໃຊ້ປ້າຍກໍາກັບ ແລະ ຕົວກັ່ນຕອງ</strong> ໃນຜູ້ຕິດຕໍ່ ແລະ CRM ເພື່ອແບ່ງກຸ່ມເປົ້າໝາຍຂອງທ່ານ "
"(ເຈົ້າຂອງ, ຜູ້ເຊົ່າ, ຜູ້ສະໜອງ, ອາຄານຊຸດ...)."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.report_calendar_event_general_meeting_document
msgid "<strong>Motions</strong>"
msgstr "<strong>ຍັດຕິ</strong>"

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Sales:</strong> Send quotations, confirm orders, and invoice shared "
"expenses to owners."
msgstr ""
"<strong>ການຂາຍ:</strong> ສົ່ງໃບສະເໜີລາຄາ, ຢືນຢັນຄໍາສັ່ງຊື້, ແລະ ອອກໃບຮຽກເກັບເງິນຄ່າໃຊ້ຈ່າຍສ່ວ"
"ນລວມໄປຍັງເຈົ້າຂອງ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Sign</strong> <strong>App: </strong>Send digital property "
"reservation contracts."
msgstr ""
"<strong>ແອັບ</strong> <strong>ເຊັນເອກະສານ (Sign): </strong>ສົ່ງສັນຍາຈອງອະສັງຫາລິມະຊັບ"
"ແບບດິຈິຕອນ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Use quotation templates</strong> in the Sales app to standardize "
"quotes and reduce manual errors."
msgstr ""
"<strong>ນໍາໃຊ້ແບບຟອມໃບສະເໜີລາຄາ</strong> ໃນແອັບການຂາຍ ເພື່ອສ້າງມາດຕະຖານໃຫ້ແກ່ໃບສະເໜີລາຄ"
"າ ແລະ ຫຼຸດຜ່ອນຂໍ້ຜິດພາດ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>VoIP Integration:</strong> Organize online meetings directly from "
"Odoo with integrated call capabilities."
msgstr ""
"<strong>ການເຊື່ອມຕໍ່ VoIP:</strong> ຈັດກອງປະຊຸມອອນລາຍໂດຍກົງຈາກ Odoo ດ້ວຍລະບົບການໂທໃນຕົ"
"ວ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"<strong>Website Builder:</strong> Build a professional website with lead "
"capture forms and member areas."
msgstr ""
"<strong>ລະບົບສ້າງເວັບໄຊ:</strong> ສ້າງເວັບໄຊແບບມືອາຊີບ ພ້ອມຟອມເກັບກໍາຂໍ້ມູນຜູ້ສົນໃຈ ແລະ ພື້ນທີ່ສະ"
"ເພາະສໍາລັບສະມາຊິກ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.report_calendar_event_general_meeting_document
msgid "<strong>and delegating</strong>"
msgstr "<strong>ແລະ ມອບສິດ</strong>"

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"A condominium works like a company. It gets revenues from the owners. These "
"are collected in two bank accounts that can be directly integrated with the "
"bank:"
msgstr ""
"ອາຄານຊຸດດໍາເນີນງານຄືກັນກັບບໍລິສັດ. ເຊິ່ງມີລາຍຮັບຈາກບັນດາເຈົ້າຂອງຫ້ອງຊຸດ. ລາຍຮັບເຫຼົ່ານີ້ຖືກເກັບເຂົ້າບັນຊີທະ"
"ນາຄານສອງບັນຊີ ທີ່ສາມາດເຊື່ອມຕໍ່ກັບທະນາຄານໄດ້ໂດຍກົງ:"

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"A distribution key is needed for several actions.<br/>\n"
"                    Defining a distribution key is efficient by populating "
"defined properties in a click."
msgstr ""
"ຫຼັກເກນການປັນສ່ວນແມ່ນຈໍາເປັນສໍາລັບຫຼາຍໆຂັ້ນຕອນ.<br/>\n"
"                    ການກໍານົດຫຼັກເກນການປັນສ່ວນມີປະສິດທິພາບສູງ ໂດຍການດຶງຂໍ້ມູນອະສັງຫາລິມະຊັບທີ່ກໍາ"
"ນົດໄວ້ໄດ້ພຽງຄລິກດຽວ."

#. module: condominium
#: model_terms:ir.ui.view,arch_db:condominium.welcome_article_body
msgid ""
"A name to identify the property, for example the post box or the "
"identification code."
msgstr "ຊື່ເພື່ອລະບຸອະສັງຫາລິມະຊັບ, ຕົວຢ່າງ: ຕູ້ໄປສະນີ ຫຼື ລະຫັດກໍານົດຕົວຕົນ."

