<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_info" model="ir.ui.view">
        <field name="name">INFO</field>
        <field name="key">gallery.page_info</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="gallery.page_info">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section
                            class="s_announcement_scroll s_announcement_scroll_direction_left w-100 o_colored_level s_announcement_scroll_parallax o_cc o_cc4 pb16 pt208 s_custom_snippet"
                            style="--marquee-animation-speed: 5s; position: relative; --marquee-item-font-size: 320;"
                            role="marquee" data-snippet="s_announcement_scroll"
                            data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Bold/16&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[&quot;x&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}"
                            data-name="Custom Announcement Scroll">
                            <div class="o_we_shape o_html_builder_Bold_16" style="background-image: url(&quot;/html_editor/shape/html_builder%2FBold%2F16.svg?c5=%23FFFFFF&amp;flip=x&quot;); background-position: 50% 50%;"/>
                            <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                                <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">[ INFO ]</div>
                            </div>
                        </section>
                        <section class="s_text_block_split pt80 pb80 o_colored_level" data-snippet="s_text_block_split" data-name="Text Split">
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-2 o_colored_level">
                                        <p class="h5-fs">WE ARE VALLEVERDE</p>
                                    </div>
                                    <div class="o_colored_level col-lg-6 offset-lg-4">
                                        <h2>Founded as a platform for radical artistic expression, we&amp;nbsp;champion works that challenge convention and invite deep contemplation.&amp;nbsp;</h2>
                                        <p class="h2-fs"><br/></p>
                                        <h2>Through rigorous curatorial standards, research-based publications, and international fair participation, we&amp;nbsp;supports artists at every stage of their practice while providing collectors and institutions access to defining contemporary masterworks.</h2>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_opening_hours_alt o_colored_level o_three_quarter_height parallax s_parallax_is_fixed" data-snippet="s_opening_hours_alt" data-name="Opening Hours Alt" data-format-mimetype="image/webp" data-scroll-background-ratio="1">
                            <span class="s_parallax_bg_wrap">
                                <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/gallery.img_custom_gallery_image_02&quot;); background-size: cover;"/>
                            </span>
                            <div class="container-fluid">
                                <div class="row o_grid_mode" data-row-count="14">
                                    <div class="o_grid_item o_cc o_cc5 g-height-4 g-col-lg-4 col-lg-4 o_colored_level" style="grid-area: 4 / 9 / 8 / 13; z-index: 1; --grid-item-padding-y: 50px; --grid-item-padding-x: 50px;">
                                        <h2 class="h3-fs">GET IN TOUCH</h2>
                                        <p class="lead">
                                            <br/>
                                        </p>
                                        <p class="lead">
                                            <a href="mailto:info@valleverde.com" class="o_translate_inline">info@valleverde.com</a>
                                        </p>
                                    </div>
                                    <div class="o_grid_item o_cc o_cc1 g-height-7 g-col-lg-4 col-lg-4 o_colored_level" style="grid-area: 8 / 9 / 15 / 13; z-index: 2; --grid-item-padding-y: 32px; --grid-item-padding-x: 32px;">
                                       <div class="row s_col_no_bgcolor">
                                            <div class="col-6 col-lg-6">
                                                <p class="h5-fs">BRUSSELS</p>
                                                <p class="small">
                                                    <span class="o_small-fs">18&amp;nbsp;Rue de Flandre</span>
                                                    <br />
                                                    <span class="o_small-fs">1000 Brussels</span>
                                                    <br />
                                                    <span class="o_small-fs">Belgium</span>
                                                </p>
                                                <p class="small">
                                                    <span class="o_small-fs">+32 2 450 11 22</span>
                                                    <span class="o_small-fs o_rfs">
                                                        <br />
                                                    </span>
                                                    <span class="o_small-fs">
                                                        <a href="mailto:brussels@valleverde.com" class="o_translate_inline">brussels@valleverde.com</a>
                                                    </span>
                                                </p>
                                                <p class="small">
                                                    <span class="o_small-fs">TUE - SAT / 10:00 — 18:30</span>
                                                </p>
                                            </div>
                                            <div class="col-6 col-lg-6">
                                                <p class="h5-fs">NEW YORK</p>
                                                <p class="small">
                                                    <span class="o_small-fs">44 Valley Street</span>
                                                    <br />
                                                    <span class="o_small-fs">10013 New York</span>
                                                    <span class="o_small-fs o_rfs">
                                                        <br />
                                                    </span>
                                                    <span class="o_small-fs">USA</span>
                                                    <span class="o_o_small-fs rfs" />
                                                </p>
                                                <p class="small">
                                                    <span class="o_small-fs">+1 212 222&amp;nbsp;9999</span>
                                                    <span class="o_small-fs o_rfs">
                                                        <br />
                                                    </span>
                                                    <span class="o_small-fs">nyc@valleverde.com</span>
                                                </p>
                                                <p class="o_small-fs">
                                                    <span class="o_small-fs">TUE - SAT / 10:00 — 18:30</span>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_info" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_info"/>
            <field name="url">/info</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
