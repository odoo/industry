<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_sale_cta_wrapper" model="ir.ui.view">
        <field name="name">Custom Valleverde - CTA Wrapper</field>
        <field name="key">website_sale.cta_wrapper</field>
        <field name="inherit_id" ref="website_sale.cta_wrapper"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='add_to_cart']" position="replace">
                <button name="add_to_cart" t-attf-class="btn btn-primary flex-grow-1"
                    data-action="add_to_cart" data-animation-selector=".o_wsale_product_images"
                    t-att-data-product-category-id="product.public_categ_ids.ids and product.public_categ_ids.ids[0]"
                    t-att-data-product-id="product_variant.id"
                    t-att-data-product-template-id="product.id"
                    t-att-data-product-type="product.type"
                    t-att-data-show-quantity="is_view_active('website_sale.product_quantity')">
                    ADD TO CART
                </button>
            </xpath>
        </field>
    </record>
    <record id="website_sale_product_add_to_wishlist" model="ir.ui.view">
        <field name="name">Custom Valleverde - Wishlist Button</field>
        <field name="key">website_sale.product_add_to_wishlist</field>
        <field name="inherit_id" ref="website_sale.cta_wrapper"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='product_option_block']" position="inside">
                <t t-set="product_variant" t-value="product_variant or product._create_first_product_variant()"/>
                <t t-set="_button_classes" t-valuef="o_add_wishlist_dyn btn btn-outline-primary text-nowrap"/>
                <t t-if="website.product_page_image_width == '50_pc' and not (is_view_active('website_sale.cta_wrapper_boxed') or is_view_active('website_sale.cta_wrapper_large'))" t-set="_button_classes" t-value="_button_classes + ' flex-grow-1 flex-sm-grow-0'"/>
                <t t-else="" t-set="_button_classes" t-value="_button_classes + ' flex-grow-1'"/>
                <t t-if="is_view_active('website_sale.cta_wrapper_large')" t-set="_button_classes" t-value="_button_classes + ' btn-lg px-lg-0'"/>
                <button t-if="product_variant" t-att-class="_button_classes" t-att-disabled="product_variant._is_in_wishlist()" t-att-data-product-id="product_variant.id" t-att-data-product-template-id="product.id" title="Add to wishlist">
                    <i class="fa fa-heart-o me-2 me-lg-0" role="img" aria-label="Add to wishlist"/>
                    <t t-set="_span_classes" t-valuef="d-inline"/>
                    <t t-if="website.product_page_image_width == '50_pc' and not (is_view_active('website_sale.cta_wrapper_boxed') or is_view_active('website_sale.cta_wrapper_large'))" t-set="_span_classes" t-value="_span_classes + ' d-lg-none'"/>
                    <span t-att-class="_span_classes">ADD TO WISHLIST</span>
                </button>
            </xpath>
        </field>
    </record>
    <record id="website_sale_product_oe_structure_website_sale_product_2" model="ir.ui.view">
        <field name="name">Custom Valleverde - Product (oe_structure_website_sale_product_2)</field>
        <field name="key">website_sale.product_oe_structure_website_sale_product_2</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_sale_product_2']" position="replace">
                <div class="oe_structure oe_empty oe_structure_not_nearest mt16" id="oe_structure_website_sale_product_2" data-editor-message="Drag blocks here to add them on all products">
                    <section
                        class="s_announcement_scroll s_announcement_scroll_direction_left w-100 o_colored_level s_announcement_scroll_parallax pb16 s_custom_snippet pt48"
                        style="--marquee-animation-speed: 5s; position: relative; --marquee-item-font-size: 320;"
                        role="marquee" data-snippet="s_announcement_scroll"
                        data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Bold/16&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-1&quot;},&quot;flip&quot;:[&quot;x&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}"
                        data-name="Custom Custom Announcement Scroll">
                        <div class="o_we_shape o_html_builder_Bold_16 bg-o-color-5"
                            style="background-image: url(&quot;/html_editor/shape/html_builder%2FBold%2F16.svg?c5=%2300A57A&amp;flip=x&quot;); background-position: 50% 50%;"/>
                        <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                            <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">[ CONTACT ]</div>
                        </div>
                    </section>
                    <section class="s_newsletter_block s_newsletter_list o_cc o_colored_level pb64 o_cc4 pt72 s_custom_snippet" data-list-id="1" data-snippet="s_newsletter_block" data-scroll-background-ratio="0" data-name="Custom Newsletter Block">
                        <div class="container">
                            <div class="row">
                                <div class="o_colored_level col-lg-3">
                                    <h2>JOIN THE MAILING LIST</h2>
                                </div>
                                <div class="o_colored_level o_cc o_cc1 border col-lg-9" style="--box-border-left-width: 25px; --box-border-bottom-width: 25px; --box-border-right-width: 25px; --box-border-top-width: 25px; border-color: rgba(255, 255, 255, 0) !important;">
                                    <div data-vxml="001" data-list-id="0" data-name="Newsletter Form" class="s_newsletter_subscribe_form s_newsletter_list js_subscribe" data-snippet="s_newsletter_subscribe_form">
                                        <div class="js_subscribed_wrap d-none">
                                            <p class="h4-fs text-center text-success">
                                                <i class="fa fa-check-circle-o" role="img"/> Thanks for registering!
                                            </p>
                                        </div>
                                        <div class="js_subscribe_wrap">
                                            <div class="input-group">
                                                <input type="email" name="email" placeholder="Email" class="s_newsletter_subscribe_form_input js_subscribe_value form-control "/>
                                                <a role="button" href="#" class="js_subscribe_btn o_submit o_translate_inline btn btn-primary">SUBSCRIBE</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>

    <record id="website_sale_product_terms_and_conditions" model="ir.ui.view">
        <field name="name">Custom Valleverde - Terms and Conditions</field>
        <field name="key">website_sale.product_terms_and_conditions</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><div id="o_wsale_product_cta_section" position="inside">
                <small class="text-muted mb-0">
                    <a href="/terms" class="o_translate_inline text-muted"><u>TERMS AND CONDITIONS</u></a>
                </small>
            </div>
        </field>
    </record>

