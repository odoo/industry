<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom Valleverde - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pb16 pt0" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="o_colored_level col-lg-3 pt24 pb24">
                                    <p class="lead">
                                        <span class="h4-fs bg-o-color-5">
                                            <a href="/" class="o_translate_inline">
                                                <span class="h5-fs">&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;</span>
                                                <br />
                                                <span class="h5-fs">&amp;nbsp; VALLEVERDE&amp;nbsp;&amp;nbsp;</span>
                                                <br />
                                                <span class="h5-fs">&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;</span>
                                            </a>
                                        </span>
                                    </p>
                                </div>
                                <div class="o_colored_level col-lg-2 pt24 pb24">
                                    <p>BRUSSELS</p>
                                    <p class="small">
                                        <span style="font-size: 12px;" class="o_rfs">18&amp;nbsp;Rue de Flandre</span>
                                        <br />
                                        <span style="font-size: 12px;" class="o_rfs">1000 Brussels</span>
                                        <br />
                                        <span style="font-size: 12px;" class="o_rfs">Belgium</span>
                                    </p>
                                    <p class="small">
                                        <span style="font-size: 12px;" class="o_rfs">
                                            +32 2 450 11 22<br />
                                            brussels@valleverde.com
                                        </span>
                                    </p>
                                </div>
                                <div class="o_colored_level col-lg-2 pt24 pb24">
                                    <p>NEW YORK</p>
                                    <p class="small">
                                        <span style="font-size: 12px;" class="o_rfs">44 Valley Street</span>
                                        <br />
                                        <span style="font-size: 12px;" class="o_rfs">
                                            10013 New York
                                        </span>
                                        <br />
                                        <span style="font-size: 12px;" class="o_rfs">
                                            USA
                                        </span>
                                    </p>
                                    <p class="small">
                                        <span style="font-size: 12px;" class="o_rfs">
                                            +1 212 222&amp;nbsp;9999<br />
                                            nyc@valleverde.com
                                        </span>
                                    </p>
                                </div>
                                <div class="pt24 pb24 o_colored_level offset-lg-2 col-lg-2">
                                    <ul class="list-unstyled">
                                        <li>
                                            <a href="/contactus" class="o_translate_inline">
                                                <span class="o_small-fs">Contact</span>
                                            </a>
                                        </li>
                                        <li class="o_small-fs">
                                            <a href="/artists" class="o_translate_inline">Artists</a>
                                        </li>
                                        <li class="o_small-fs">
                                            <a href="/info" class="o_translate_inline">Info</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="o_colored_level pt24 pb24 col-lg-1">
                                    <div class="s_social_media o_not_editable no_icon_color text-end" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.instagram.com/your-page" target="_blank" aria-label="Instagram" class="s_social_media_instagram">
                                            <i class="fa o_editable_media shadow-sm rounded-circle o_cc o_cc5 fa-instagram" />
                                        </a>
                                        <a href="https://www.facebook.com/your-page" target="_blank" aria-label="Facebook" class="s_social_media_facebook">
                                            <i class="fa o_editable_media shadow-sm rounded-circle o_cc o_cc5 fa-facebook" />
                                        </a>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="fa fa-twitter o_editable_media shadow-sm rounded-circle o_cc o_cc5" />
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" target="_blank" aria-label="LinkedIn" class="s_social_media_linkedin">
                                            <i class="fa o_editable_media shadow-sm rounded-circle o_cc o_cc5 fa-linkedin" />
                                        </a>
                                    </div>
                                </div>
                                <div class="o_colored_level col-lg-12 pt0 pb0">
                                    <p class="small">
                                        <span style="font-size: 10px;" class="o_rfs">COPYRIGHT © VALLEVERDE&amp;nbsp;</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="option_header_brand_name" model="ir.ui.view">
        <field name="name">Custom Valleverde - Header Brand Name</field>
        <field name="key">website.option_header_brand_name</field>
        <field name="inherit_id" ref="website.placeholder_header_brand" />
        <field name="website_id" ref="website_industry" />
        <field name="active" eval="False" />
        <field name="arch" type="xml">
            <xpath expr="//*[@id='o_fake_navbar_brand']" position="replace">
                <a href="/" t-attf-class="navbar-brand #{_link_class}" class="navbar-brand me-4">
                    <span><span><span data-text-effect="{&quot;preset&quot;:&quot;blurred_black&quot;,&quot;shadows&quot;:[{&quot;shadowBlur&quot;:&quot;10px&quot;}]}" style="text-shadow: rgba(0, 0, 0, 0.5) 2px 2px 10px;" class="bg-o-color-5">&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;<br/>&amp;nbsp; </span><span data-text-effect="{&quot;preset&quot;:&quot;blurred_black&quot;,&quot;shadows&quot;:[{&quot;shadowBlur&quot;:&quot;10px&quot;}]}" style="text-shadow: rgba(0, 0, 0, 0.5) 2px 2px 10px;" class="bg-o-color-5">VALLEVERDE</span><span data-text-effect="{&quot;preset&quot;:&quot;blurred_black&quot;,&quot;shadows&quot;:[{&quot;shadowBlur&quot;:&quot;10px&quot;}]}" style="text-shadow: rgba(0, 0, 0, 0.5) 2px 2px 10px;" class="bg-o-color-5">&amp;nbsp;&amp;nbsp;<br/>&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;</span></span></span>
                </a>
            </xpath>
        </field>
    </record>
</odoo>
