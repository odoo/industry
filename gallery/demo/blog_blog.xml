<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <!-- Repurpose the default blog: its name is what the /blog page and the post
         URLs use, and website_blog's own demo data would otherwise rename it to
         "Travel". The header marquee is not a view - website_blog renders the
         blog's own `content` field in #o_wblog_blog_top. -->
    <record id="website_blog.blog_blog_1" model="blog.blog" forcecreate="1">
        <field name="name">NEWS</field>
        <field name="subtitle" eval="False"/>
        <field name="cover_properties">{"background-image": "url('/website_blog/static/src/img/cover_5.jpg')", "resize_class": "o_record_has_cover o_half_screen_height", "opacity": "0.4"}</field>
        <field name="content"><![CDATA[<section class="s_announcement_scroll s_announcement_scroll_direction_left w-100 o_colored_level s_announcement_scroll_parallax o_cc o_cc4 pb16 pt208 s_custom_snippet" style="--marquee-animation-speed: 5s; position: relative; --marquee-item-font-size: 320;" role="marquee" data-snippet="s_announcement_scroll" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Bold/16&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[&quot;x&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" data-name="Custom Announcement Scroll"><div class="o_we_shape o_html_builder_Bold_16" style="background-image: url(&quot;/html_editor/shape/html_builder%2FBold%2F16.svg?c5=%23FFFFFF&amp;flip=x&quot;); background-position: 50% 50%;"></div>
        <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
            <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">[ NEWS ]</div>
        </div>
    </section>]]></field>
    </record>
</odoo>
