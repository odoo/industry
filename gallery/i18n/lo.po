#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>Email &amp; Social Marketing</strong>: Promote upcoming exhibitions "
"and special sales across different platforms"
msgstr ""
"<strong>ການຕະຫຼາດຜ່ານອີເມວ &amp; ໂຊຊຽວ</strong>: ໂປຣໂມດງານວາງສະແດງທີ່ກຳລັງຈະມາເຖິງ "
"ແລະ ການຂາຍພິເສດຜ່ານຫຼາຍແພລັດຟອມ"

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>Events</strong>: Organize art exhibitions, artist meet-ups, and "
"gallery openings."
msgstr ""
"<strong>ອີເວັ້ນ</strong>: ຈັດງານວາງສະແດງສິລະປະ, ງານພົບປະສິລະປິນ ແລະ ງານເປີດຫໍສິລະປະ."

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid "<strong>Extending the Workflow with Studio</strong>"
msgstr "<strong>ການຂະຫຍາຍຂັ້ນຕອນການເຮັດວຽກດ້ວຍ Studio</strong>"

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid "<strong>Manage Online Visibility</strong>:"
msgstr "<strong>ຄຸ້ມຄອງການສະແດງຜົນອອນລາຍ</strong>:"

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid "<strong>Manage your agreements 📝</strong>"
msgstr "<strong>ຄຸ້ມຄອງຂໍ້ຕົກລົງຂອງທ່ານ 📝</strong>"

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid "<strong>Managing Commissions  👩‍🎨</strong>"
msgstr "<strong>ການຄຸ້ມຄອງຄ່ານາຍໜ້າ  👩‍🎨</strong>"

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>Marketing Automation</strong>: Engage potential buyers with "
"personalized campaigns and newsletters."
msgstr ""
"<strong>ລະບົບການຕະຫຼາດອັດຕະໂນມັດ</strong>: ເຂົ້າເຖິງຜູ້ຊື້ທີ່ມີແວວດ້ວຍແຄມເປນ ແລະ "
"ຈົດໝາຍຂ່າວແບບສະເພາະບຸກຄົນ."

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>Memberships &amp; Subscriptions</strong>: Offer exclusive content, "
"VIP access, and limited-event participation."
msgstr ""
"<strong>ລະບົບສະມາຊິກ &amp; ການສະໝັກໃຊ້</strong>: ນຳສະເໜີເນື້ອຫາພິເສດ, "
"ສິດການເຂົ້າເຖິງລະດັບ VIP ແລະ ການເຂົ້າຮ່ວມອີເວັ້ນສະເພາະກຸ່ມ."

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>POS</strong>: Enables fast, in-store transactions for walk-in "
"customers."
msgstr "<strong>POS</strong>: ຊ່ວຍໃຫ້ການເຮັດທຸລະກຳໜ້າຮ້ານວ່ອງໄວ ສຳລັບລູກຄ້າທີ່ເຂົ້າມາຊື້ໂດຍກົງ."

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>Projects</strong>: Manage large-scale exhibitions or arts festivals, "
"integrating planning, tasks, and team collaboration."
msgstr ""
"<strong>ໂຄງການ</strong>: ຄຸ້ມຄອງງານວາງສະແດງຂະໜາດໃຫຍ່ ຫຼື ເທສະການສິລະປະ "
"ໂດຍລວມການວາງແຜນ, ໜ້າວຽກ ແລະ ການຮ່ວມມືພາຍໃນທີມເຂົ້າກັນ."

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
