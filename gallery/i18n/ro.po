#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>Accounting</strong>: Easily generate tax reports and other financial "
"documents thanks to our localization packages."
msgstr ""
"<strong>Contabilitate</strong>: generează cu ușurință rapoarte fiscale și "
"alte documente financiare cu ajutorul pachetelor de localizare."

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid "<strong>Add Images &amp; Categorization</strong>:"
msgstr "<strong>Adaugă imagini și categorii</strong>:"

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>CRM</strong>: Manages customer relationships, tracks leads and "
"inquiries, and boosts sales potential."
msgstr ""
"<strong>CRM</strong>: gestionează relațiile cu clienții, urmărește pistele "
"și solicitările și sporește potențialul de vânzări."

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>Contacts</strong>: Organizes and stores client information for "
"personalized follow-ups."
msgstr ""
"<strong>Contacte</strong>: organizează și stochează informațiile clienților "
"pentru urmăriri personalizate."

