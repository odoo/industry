#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>Email &amp; Social Marketing</strong>: Promote upcoming exhibitions "
"and special sales across different platforms"
msgstr ""
"<strong>E-mail și marketing pe rețele sociale</strong>: promovează "
"expozițiile viitoare și ofertele speciale pe diverse platforme."

#. module: gallery
#: model_terms:ir.ui.view,arch_db:gallery.welcome_article_body
msgid ""
"<strong>Events</strong>: Organize art exhibitions, artist meet-ups, and "
"gallery openings."
msgstr ""
"<strong>Evenimente</strong>: organizează expoziții de artă, întâlniri cu "
"artiști și inaugurări de galerii."

