msgstr "Ventilator"

#. module: campsite
#: model_terms:ir.ui.view,arch_db:campsite.view_page_home
msgid "Fill your days with raw wonder"
msgstr "Umple-ți zilele cu aventuri în natură"

#. module: campsite
#: model_terms:ir.ui.view,arch_db:campsite.view_page_home
msgid ""
"Focus, steady your hand, and learn the focus of classic target archery from "
"certified safety instructors."
msgstr ""
"Concentrează-te, țintește cu calm și învață tirul cu arcul clasic sub "
"îndrumarea instructorilor autorizați."

#. module: campsite
#: model_terms:ir.ui.view,arch_db:campsite.header_social_links
msgid "Follow us"
msgstr "Urmărește-ne"

