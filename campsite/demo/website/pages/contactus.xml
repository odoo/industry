                                                            <label class="s_website_form_label" for="oplwji2esd8p" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="phone" placeholder="" id="oplwji2esd8p" data-fill-with="phone"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required col-lg-6" data-type="email" data-translated-name="Your Email">
                                                            <label class="s_website_form_label" for="oreaaw9538u9" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="oreaaw9538u9" data-fill-with="email"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject">
                                                            <label class="s_website_form_label" for="ot10dtph6pum" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="subject" required="" value="" placeholder="" id="ot10dtph6pum" data-fill-with="undefined"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="text" data-translated-name="Your Question">
                                                            <label class="s_website_form_label" for="ohnx1aglloqp" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Question</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="ohnx1aglloqp" rows="6" />
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label pb32" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label">
                                                                <br/>
                                                            </div>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send o_translate_inline">Send</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <div class="s_hr pt32 pb32 o_colored_level o_cc o_cc2 d-lg-block d-none o_snippet_mobile_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                        </div>
                        <section class="s_cta_box o_colored_level o_cc o_cc3 parallax s_parallax_is_fixed s_custom_snippet pb0 pt0" data-snippet="s_cta_box" data-format-mimetype="image/webp" style="position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/14&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#F0F6F2&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" data-scroll-background-ratio="1" data-name="Custom Box Call to Action">
                            <span class="s_parallax_bg_wrap">
                                <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/campsite.img_campsite_image_06&quot;); background-size: cover;" data-resize-width="1920" data-mimetype="image/webp"/>
                            </span>
                            <div class="o_we_bg_filter" style="background-color: rgba(40, 62, 86, 0.59);"/>
                            <div class="o_we_shape o_html_builder_Connections_14" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F14.svg?c5=%23F0F6F2&quot;);"/>
                            <div class="o_container_small container">
                                <div class="s_card card o_colored_level o_card_img_horizontal flex-lg-row-reverse" data-snippet="s_card" data-vxml="001" data-name="Card" style="--card-spacer-x: 64px; --card-spacer-y: 64px; border-width: 0px !important; position: relative;">
                                    <div class="card-body" style="text-align: center;">
                                        <h2 class="card-title" style="text-align: center;">
                                            <span class="display-2-fs">
                                                <em>A summer</em><br />
                                            </span>
                                            <span class="display-2-fs">
                                                <em>you'll never forget</em>
                                            </span>
                                        </h2>
                                        <p class="card-text lead" style="text-align: center;">
                                            <br/>
                                        </p>
                                        <p class="card-text lead" style="text-align: center;">Spot bookings are filled sequentially. Save your place early and get ready for canoeing under clear skies, crackling logs, and lifelong campfire laughter.</p>
                                        <p>
                                            <br/>
                                        </p>
                                        <a class="o_translate_inline btn btn-primary" href="/contactus">Secure your spot</a>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
