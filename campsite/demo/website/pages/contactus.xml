                                        <img src="/web/image/campsite.img_campsite_image_05" alt="" class="img img-fluid o_we_custom_image o_editable_media" loading="lazy" data-mimetype="undefined"/>
                                    </div>
                                    <div class="o_colored_level d-lg-block d-none o_snippet_mobile_invisible col-lg-2 g-height-3 g-col-lg-2 o_grid_item_image_contain o_grid_item_image o_grid_item" style="z-index: 13; grid-area: 2 / 10 / 5 / 12;" data-invisible="1">
