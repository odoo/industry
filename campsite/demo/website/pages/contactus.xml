                                                <p><strong><br/>From Monday to Friday<br/></strong>8.00 am - 6.00 pm</p>
                                                <p><strong>Saturday &amp;amp; Sunday<br/></strong>8.00 am - 10.00 pm</p>
                                            </div>
                                        </div>
                                        <div class="s_card o_card_img_top card o_cc border rounded o_colored_level o_cc5" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; --box-border-bottom-left-radius: 24px; --box-border-bottom-right-radius: 24px; --box-border-top-right-radius: 24px; --box-border-top-left-radius: 24px;">
