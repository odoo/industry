<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small text-center" t-ignore="true">
                    Copyright © <t t-out="company.name"/>
                </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="header_social_links" model="ir.ui.view">
        <field name="name">Custom - Header Social Links</field>
        <field name="key">website.header_social_links</field>
        <field name="inherit_id" ref="website.placeholder_header_social_links"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="o_header_social_links #{_div_class}">
                        <div class="s_social_media o_not_editable oe_unmovable oe_unremovable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                            <h5 class="s_social_media_title d-none">Follow us</h5>
                            <a href="https://www.facebook.com/Odoo" class="s_social_media_facebook o_nav-link_secondary nav-link m-0 p-0 text-decoration-none" target="_blank" aria-label="Facebook">
                                <i class="oi p-1 o_editable_media rounded-circle shadow-sm" data-icon="oi_facebook"/>
                            </a>
                            <a href="https://www.instagram.com/explore/tags/odoo/" class="s_social_media_instagram o_nav-link_secondary nav-link m-0 p-0 text-decoration-none" target="_blank" aria-label="Instagram">
                                <i class="oi p-1 o_editable_media rounded-circle shadow-sm" data-icon="oi_instagram"/>
                            </a>
                        </div>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="header_text_element" model="ir.ui.view">
        <field name="name">Custom - Header Text element</field>
        <field name="inherit_id" ref="website.header_text_element"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-elif=&quot;_txt_elt_content == 'phone_mail'&quot;]/div" position="replace">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <a href="tel:+16506913277" class="nav-link o_nav-link_secondary">
                        <small>
                            <i class="oi oi-filled oi-1x oi-fw me-1" data-icon="phone"/>͏
                            <span class="o_force_ltr">+1 650-691-3277</span>
                        </small>
                    </a>
                    <a href="mailto:hello@coconutcamp.example.com" class="nav-link o_nav-link_secondary">
                        <small>
                            <i class="oi oi-filled oi-1x oi-fw me-1" data-icon="mail"/>
                            hello@coconutcamp.example.com
                        </small>
                    </a>
                </div>
            </xpath>
        </field>
    </record>
    <record id="template_footer_contact" model="ir.ui.view">
        <field name="name">Custom - Contact</field>
        <field name="key">website.template_footer_contact</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt32 pb32" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row o_grid_mode" style="gap: 16px;" data-row-count="2">
                                <div class="o_grid_item g-height-2 offset-1 offset-lg-0 o_cc o_cc3 rounded pt16 pb16 o_colored_level col-lg-5 g-col-lg-6 col-lg-6 col-10" style="z-index: 1; grid-area: 1 / 1 / 3 / 7; --grid-item-padding-y: 30px; --grid-item-padding-x: 30px; border-radius: 24px !important;">
                                    <h4>Visit us</h4>
                                    <p>250 Executive Park Blvd, Suite 3400&amp;nbsp; San Francisco, CA 94134 USA</p>
                                </div>
                                <div class="col-lg-3 o_grid_item g-col-lg-3 g-height-2 offset-1 offset-lg-0 col-10 o_cc o_cc1 rounded pt16 pb16 o_colored_level" style="z-index: 2; --grid-item-padding-x: 30px; --grid-item-padding-y: 30px; border-radius: 24px !important; grid-area: 1 / 7 / 3 / 10;">
                                    <h4>Call us</h4>
                                    <p><a href="tel:+16506913277" class="o_translate_inline">+1 650-691-3277</a></p>
                                </div>
                                <div class="col-lg-3 o_grid_item g-col-lg-3 g-height-2 offset-1 offset-lg-0 col-10 o_cc o_cc1 rounded pt16 pb16 o_colored_level" style="z-index: 3; --grid-item-padding-x: 30px; --grid-item-padding-y: 30px; border-radius: 24px !important; grid-area: 1 / 10 / 3 / 13;">
                                    <h4>Send us a message</h4>
                                    <p><a href="mailto:hello@coconutcamp.example.com">hello@coconutcamp.example.com</a></p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
