                                        <div>
                                            <h2 class="h3">Latest Stories</h2>
                                            <p class="lead">Explore fresh ideas and updates from our editorial team.</p>
                                        </div>
                                        <div>
                                            <a href="/blog" class="o_translate_inline">Voir tout <i class="fa fa-long-arrow-right ms-2" role="img"/></a>
                                        </div>
