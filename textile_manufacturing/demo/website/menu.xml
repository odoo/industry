<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Website menus - parent_id via search on root (url=#) -->
    <!-- Default menu (rename/reorder): Home -->
    <function name="write" model="website.menu">
      <value model="website.menu" search="[('url', '=', '/'), ('website_id', '=', ref('textile_manufacturing.website_industry'))]"/>
      <value eval="{'name': 'Home', 'sequence': 10, 'is_visible': True}"/>
    </function>
    <!-- Default menu (rename/reorder): Fabric Samples -->
    <function name="write" model="website.menu">
      <value model="website.menu" search="[('url', '=', '/shop'), ('website_id', '=', ref('textile_manufacturing.website_industry'))]"/>
      <value eval="{'name': 'Fabric Samples', 'sequence': 1, 'is_visible': True}"/>
    </function>
    <!-- Custom menu: Fabric Journal -->
    <record id="menu_fabric_journal" model="website.menu">
      <field name="name">Fabric Journal</field>
      <field name="url">/blog</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('textile_manufacturing.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="3"/>
      <field name="is_visible" eval="True"/>
    </record>
    <!-- Custom menu: About Us -->
    <record id="menu_about_us" model="website.menu">
      <field name="name">About Us</field>
      <field name="url">/about-us</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('textile_manufacturing.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="2"/>
      <field name="is_visible" eval="True"/>
    </record>
  </data>
</odoo>
