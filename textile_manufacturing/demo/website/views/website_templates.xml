<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom Armadale - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-lg-2 pt24 pb24 o_colored_level">
                                    <p>
                                        <span class="h5-fs text-o-color-1">
                                            <b>Useful Links</b>
                                        </span>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li>
                                            <a href="/" class="o_translate_inline">Home</a>
                                        </li>
                                        <li>
                                            <a href="/shop">Fabric Samples</a>
                                        </li>
                                        <li>
                                            <a href="/about-us" class="o_translate_inline">About Us</a>
                                        </li>
                                        <li>
                                            <a href="/contactus">Contact Us</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-lg-5 pt24 pb24 o_colored_level">
                                    <p>
                                        <span class="h5-fs text-o-color-1">
                                            <b>About Us</b>
                                        </span>
                                    </p>
                                    <p>Every fabric has a history — and ours is rooted in Scotland's textile heritage. We source, curate, and share vintage and classical floral fabrics inspired by the mills, moorlands, and pattern books that shaped Scottish design for over two centuries.</p>
                                    <p>What started as a personal collection grew into something we wanted to share: a place where makers, collectors, and lovers of textile history could find fabric that simply isn't made anymore.</p>
                                </div>
                                <div class="col-lg-4 offset-lg-1 pt24 pb24 o_colored_level">
                                    <p>
                                        <span class="h5-fs text-o-color-1">
                                            <b>Join Us</b>
                                        </span>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li>
                                            <a href="/contactus">Contact Us</a>
                                        </li>
                                        <li>
                                            <a href="mailto:info@armadale.com">info@armadale.com</a>
                                        </li>
                                        <li>
                                            <a href="tel:+3226168002">+32 2 616 80 02<span class="o_force_ltr" data-oe-zws-empty-inline="" />
                                            </a>
                                        </li>
                                    </ul>
                                    <div class="s_hr pt8 pb16" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto" />
                                    </div>
                                    <div class="s_social_media text-start o_not_editable" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow Us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="fa fa-facebook rounded-circle shadow-sm o_editable_media text-o-color-1" />
                                        </a>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="fa fa-twitter rounded-circle shadow-sm o_editable_media text-o-color-1" />
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                            <i class="fa fa-linkedin rounded-circle shadow-sm o_editable_media text-o-color-1" />
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom Armadale - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.header_call_to_action" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//li" position="replace">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta w-100">Contact Us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="header_text_element" model="ir.ui.view">
        <field name="name">Custom Armadale - Header Text element</field>
        <field name="key">website.header_text_element</field>
        <field name="inherit_id" ref="website.header_text_element" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//t[@t-elif=&quot;_txt_elt_content == 'phone_mail'&quot;]" position="replace">
                <t t-elif="_txt_elt_content == 'phone_mail'">
                    <div t-attf-class="s_text_block #{_div_class}" data-name="Text" class="s_text_block mt-2">
                        <a href="tel:+3226168002" class="nav-link o_nav-link_secondary">
                            <small>
                                <i class="fa fa-1x fa-fw fa-phone me-1" />
                                +32 2 616 80 02<span class="o_force_ltr" data-oe-zws-empty-inline="" />
                            </small>
                        </a>
                        <a href="mailto:info@armadale.com" class="nav-link o_nav-link_secondary">
                            <small>
                                <i class="fa fa-1x fa-fw fa-envelope me-1" />
                                info@armadale.com
                            </small>
                        </a>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
