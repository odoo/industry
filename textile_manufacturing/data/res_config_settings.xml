<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="1">
        <record id="res_config_setting_textile_manufacturing" model="res.config.settings">
            <field name="group_mrp_routings" eval="1"/>
            <field name="group_project_stages" eval="1"/>
            <field name="group_stock_production_lot" eval="1"/>
        </record>
        <function name="execute" model="res.config.settings">
            <value eval="[ref('res_config_setting_textile_manufacturing')]"/>
        </function>
    </data>

    <record id="x_setting_field_module_product_conversion" model="ir.model.fields">
        <field name="ttype">boolean</field>
        <field name="field_description">Product Conversion</field>
        <field name="name">x_module_product_conversion</field>
        <field name="store" eval="True"/>
        <field name="model_id" ref="base_setup.model_res_config_settings"/>
        <field name="compute"><![CDATA[
self['x_module_product_conversion'] = self.env['ir.config_parameter'].get_bool('textile_manufacturing.x_setting_product_conversion', False)
]]>        </field>
    </record>
    <record id="action_product_conversion" model="ir.actions.server">
        <field name="code"><![CDATA[
if not (env.context.get('install_module') == 'product_conversion' and env.context.get('install_mode')):
    if record.x_module_product_conversion:
        # First, import the Product Conversion industry module because it is not available in ir_module_module.
        import_action = env['ir.module.module'].with_context(module_name='product_conversion').button_immediate_install_app()
        env['base.import.module'].browse(import_action['res_id']).import_module()
    else:
        module = env['ir.module.module']._get('product_conversion')
        if module: module.button_immediate_uninstall()
]]>        </field>
        <field name="model_id" ref="base_setup.model_res_config_settings"/>
        <field name="state">code</field>
        <field name="name">Action Install/Uninstall Product Conversion From Settings</field>
    </record>
    <!-- Keep Product Conversion Setting Synced When The Industry Is Installed/Uninstalled From Apps -->
    <record id="action_sync_with_product_conversion_setting" model="ir.actions.server">
        <field name="name">Sync Product Conversion Setting</field>
        <field name="model_id" ref="base.model_ir_module_module"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
env['ir.config_parameter'].set_bool('textile_manufacturing.x_setting_product_conversion', record.state == 'installed')
    ]]>        </field>
    </record>
    <record id="base_automation_on_product_conversion_module_state" model="base.automation">
        <field name="name">Sync Product Conversion Setting</field>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_sync_with_product_conversion_setting')])]"/>
        <field name="model_id" ref="base.model_ir_module_module"/>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('base.field_ir_module_module__state')])]"/>
        <field name="filter_domain">[('name', '=', 'product_conversion')]</field>
        <field name="trigger">on_create_or_write</field>
    </record>
    <record id="action_enable_product_conversion_attribute" model="ir.actions.server">
        <field name="name">Enable Product Conversion Attribute</field>
        <field name="model_id" ref="base.model_ir_model_fields"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
attribute = env.ref('textile_manufacturing.product_attribute_1', raise_if_not_found=False)
if attribute: attribute.x_is_convert_attribute = True
    ]]></field>
    </record>
    <record id="base_automation_on_product_conversion_attribute_field" model="base.automation">
        <field name="name">Enable Product Conversion Attribute</field>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_enable_product_conversion_attribute')])]"/>
        <field name="model_id" ref="base.model_ir_model_fields"/>
        <field name="filter_domain">[('name', '=', 'x_is_convert_attribute'), ('model', '=', 'product.attribute')]</field>
        <field name="trigger">on_create</field>
    </record>
    <record id="base_automation_on_product_conversion_setting" model="base.automation">
        <field name="name">Automation For Install/Uninstall Product Conversion from Settings</field>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_product_conversion')])]"/>
        <field name="model_id" ref="base_setup.model_res_config_settings"/>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('x_setting_field_module_product_conversion')])]"/>
        <field name="trigger">on_create_or_write</field>
    </record>
</odoo>
