<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="mail_template_mandate_request_completion" model="mail.template">
        <field name="name">Mandate: Request Completion</field>
        <field name="model_id" ref="x_customer_mandate_model"/>
        <field name="subject">Mandate request to {{ object.x_mandate_id.x_name|||external portal }}</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="partner_to">{{ object.x_mandated.id }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="lang">{{ object.x_mandated.lang }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="object.x_mandated.name or ''"/>,</p>
                <p>You are kindly invited to complete the mandate request for <strong t-out="object.x_mandate_id.x_name or ''"/>.</p>
                <p>Best regards,</p>
                <div t-out="user.name if is_html_empty(user.signature) else user.signature"/>
            </div>
        </field>
    </record>
</odoo>
