<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <!-- Mandates created before x_mail_template_id existed have no template yet -->
    <function model="x_mandate" name="write">
        <value model="x_mandate" eval="obj().with_context(active_test=False).search([('x_mail_template_id', '=', False)]).ids"/>
        <value eval="{'x_mail_template_id': ref('mail_template_mandate_request_completion')}"/>
    </function>
</odoo>
