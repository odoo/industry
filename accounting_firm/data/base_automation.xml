<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="base_automation_confirm_sale_order_on_signature" model="base.automation">
        <field name="name">Accounting Firm: Confirm Quotation on Signature</field>
        <field name="model_id" ref="sign.model_sign_request"/>
        <field name="trigger">on_state_set</field>
        <field name="trg_selection_field_id" ref="sign.selection__sign_request__state__signed"/>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('sign.field_sign_request__state')])]"/>
        <field name="filter_domain">[('state', '=', 'signed'), ('template_tags.x_confirm_so', '=', True), ('x_sale_order_id.state', 'in', ['draft', 'sent'])]</field>
    </record>
</odoo>
