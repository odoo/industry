    <!-- Res Partner -->
    <record id="x_identity_document_expiration_field_res_partner" model="ir.model.fields">
        <field name="name">x_identity_document_expiration</field>
        <field name="field_description">Identity Document Expiration</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="ttype">date</field>
        <field name="readonly" eval="1"/>
        <field name="depends">document_ids, document_ids.x_id_expiration_date, document_ids.x_is_identity_document_request</field>
        <field name="compute"><![CDATA[
for record in self:
    record['x_identity_document_expiration'] = max((doc.x_id_expiration_date for doc in record.document_ids if doc.x_id_expiration_date and doc.x_is_identity_document_request), default=False)
        ]]></field>
    </record>

