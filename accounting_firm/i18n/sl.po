#. module: accounting_firm
#: model_terms:ir.ui.view,arch_db:accounting_firm.welcome_article_body
#, fuzzy
msgid ""
"<b>Accounting App</b>: Streamline your billing cycle and manage the firm's "
"own financials with robust invoicing tools."
msgstr ""
"<b>Računovodska aplikacija</b>: Poenostavite svoj obračunski cikel in "
"upravljajte lastne finance podjetja z zmogljivimi orodji za izdajanje "
"računov."

#. module: accounting_firm
#: model_terms:ir.ui.view,arch_db:accounting_firm.welcome_article_body
#, fuzzy
msgid ""
"<b>Contacts App</b>: Centralize all client data and maintain a clean, "
"organized directory of customers and contacts."
msgstr ""
"<b>Aplikacija za stike</b>: Centralizirajte vse podatke o strankah in "
"ohranite čist in urejen imenik strank in stikov."

#. module: accounting_firm
#: model_terms:ir.ui.view,arch_db:accounting_firm.welcome_article_body
#, fuzzy
msgid ""
"<b>Databases App</b>: Access and interact with your clients' Odoo databases "
"instantly from a single dashboard."
msgstr ""
"<b>Aplikacija Podatkovne zbirke</b>: Takoj dostopajte do podatkovnih zbirk "
"Odoo svojih strank in delajte z njimi z ene same nadzorne plošče."

#. module: accounting_firm
#: model_terms:ir.ui.view,arch_db:accounting_firm.welcome_article_body
#, fuzzy
msgid ""
"<b>Documents App</b>: Automate the request, collection, and management of "
"client files for a paperless office."
msgstr ""
"<b>Aplikacija Dokumenti</b>: Avtomatizirajte zahtevanje, zbiranje in "
"upravljanje strankinih datotek za brezpapirno pisarno."

#. module: accounting_firm
#: model_terms:ir.ui.view,arch_db:accounting_firm.welcome_article_body
#, fuzzy
msgid ""
"<b>Equity App</b>: Simplify compliance by gathering and visualizing Ultimate "
"Beneficial Owners (UBOs) structures."
msgstr ""
"<b>Equity App</b>: Poenostavite skladnost z zbiranjem in vizualizacijo "
"struktur končnih dejanskih lastnikov (UBO)."

#. module: accounting_firm
#: model_terms:ir.ui.view,arch_db:accounting_firm.welcome_article_body
#, fuzzy
msgid ""
"<b>Project App</b>: Organize client files, track tasks, and manage your "
"team's workload to meet every deadline."
msgstr ""
"<b>Aplikacija Projekti</b>: Organizirajte datoteke strank, spremljajte "
"opravila in upravljajte obremenitev svoje ekipe, da boste izpolnili vsak rok."

#. module: accounting_firm
#: model_terms:ir.ui.view,arch_db:accounting_firm.welcome_article_body
#, fuzzy
msgid ""
"<b>Sign App</b>: Accelerate approvals and agreements by capturing secure "
"electronic document signatures instantly."
msgstr ""
"<b>Podpis</b>: Pospešite odobritve in pogodbe z zajemanjem varnih "
"elektronskih podpisov dokumentov takoj."

#. module: accounting_firm
#: model_terms:ir.ui.view,arch_db:accounting_firm.welcome_article_body
#, fuzzy
msgid ""
"<b>Timesheets App</b>: Track billable hours with precision and analyze your "
"team's efforts for better profitability."
msgstr ""
"<b>Aplikacija za časovne liste</b>: Natančno spremljajte obračunljive ure in "
"analizirajte prizadevanja svoje ekipe za večjo dobičkonosnost."

