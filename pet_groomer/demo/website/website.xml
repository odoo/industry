<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="website_industry" model="website">
        <field name="name">Wooof</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="user_id" ref="base.public_user"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="show_line_subtotals_tax_selection">tax_excluded</field>
        <field name="cart_recovery_mail_template_id" eval="False"/>
        <field name="logo" type="bytes" file="pet_groomer/static/src/img/content/website/logo.webp"/>
        <field name="favicon" type="bytes" file="pet_groomer/static/description/favicon.png"/>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[
            ('name', '=', 'default_website'),
            ('module', '=', 'base'),
            ('model', '=', 'website')]"
        />
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
</odoo>
