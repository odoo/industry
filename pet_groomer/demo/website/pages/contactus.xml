<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">pet_groomer.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="pet_groomer.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', ''), 'contact_name': request.params.get('contact_name', ''), 'partner_name': request.params.get('partner_name', ''), 'description': request.params.get('description', '')}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_empowerment o_colored_level o_cc o_cc3 pt72 pb96 s_custom_snippet" data-snippet="s_empowerment" style="position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/17&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#FFF9F1&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" data-name="Custom Empowerment"><div class="o_we_shape o_html_builder_Connections_17 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F17.svg?c5=%23FFF9F1&quot;);"/>
                            <div class="container">
                                <div class="row">
                                    <div class="o_colored_level pt64 col-lg-12">
                                        <h1 class="display-3" style="text-align: center;">
                                            <strong>
                                                <span class="text-o-color-5">Curious </span><span class="text-o-color-1"><em>Paws</em></span><span class="text-o-color-5"> Welcome</span>
                                            </strong>
                                        </h1>
                                        <p style="text-align: center;" class="lead"><br/>Want to know more about our grooming services, the breeds and sizes we work with, or how we care for your pet?</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_form_aside pt48 o_colored_level pb64" data-snippet="s_form_aside" data-name="Form Aside" style="position: relative;">
                            <div class="container">
                                <div class="row">
                                    <div class="col-12 o_colored_level col-lg-4 order-lg-0 pt32" style="order: 1;">
                                        <p>
                                            <i class="oi oi-fw" data-icon="mail" role="img"/> <strong>Email</strong>
                                            <br/>
                                            <a href="mailto:info@wooof.example.com" class="o_translate_inline">info@wooof.example.com</a>
                                            <br/>
                                            <br/>
                                            <i class="oi oi-fw" data-icon="phone" role="img"/> <strong>Phone</strong>
                                            <span class="o_force_ltr">
                                                <br/>
                                                <a href="tel:+1 555-555-5556" class="o_translate_inline">+1 555-555-5556</a>
                                                <br/>
                                            </span>
                                            <br/>
                                            <i class="oi oi-fw" data-icon="location_on" role="img"/> <strong>Address</strong>
                                            <br/>
                                            250 Executive Park Blvd, Suite 3400
                                            <br/>
                                            San Francisco CA 94134
                                            <br/>
                                            United States
                                        </p>
                                    </div>
                                    <div class="col-12 o_colored_level offset-lg-1 col-lg-7 order-lg-0" style="order: 0;">
                                        <h2>Send us an email</h2>
                                        <p class="lead">
                                            Fill out the form below and we'll be glad to tell you everything you need to know.
                                        </p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div class="mb-3 s_website_form_field s_website_form_required col-lg-12" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact1">
                                                                <span class="s_website_form_label_content">Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact1" type="text" placeholder="John Doe" class="form-control s_website_form_input" name="contact_name" required="" data-fill-with="name"/>
                                                        </div>
                                                        <div class="mb-3 col-lg-6 s_website_form_field" data-type="tel" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact2">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input id="contact2" type="tel" placeholder="+1 555-555-5556" class="form-control s_website_form_input" name="phone" data-fill-with="phone"/>
                                                        </div>
                                                        <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required" data-type="email" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact3">
                                                                <span class="s_website_form_label_content">Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact3" type="email" placeholder="example@mail.com" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email"/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact5">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact5" type="text" placeholder="Describe your request" class="form-control s_website_form_input" name="name" required=""/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required" data-type="text" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact6">
                                                                <span class="s_website_form_label_content">Message</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea id="contact6" placeholder="Write down your message" class="form-control s_website_form_input" name="description" required="" rows="6"/>
                                                            <span class="s_website_form_field_description small form-text text-muted">We typically respond within 1-2 business days.</span>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"/>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send">Send Message</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_hours_and_place o_cc o_colored_level s_custom_snippet o_cc1 pt0 pb88" data-snippet="s_hours_and_place" style="position: relative;" data-name="Custom Hours and Place">
                            <div class="container">
                                <h2 style="text-align: center;">
                                    <span class="text-o-color-5">Where to</span> <span class="text-o-color-1">find us ?</span>
                                    <br/><br/>
                                </h2>
                                <div class="row s_nb_column_fixed">
                                    <div class="o_colored_level o_cc col-lg-3 rounded pt24 pb24 o_cc3 order-lg-0" style="border-radius: 9.6px !important; order: 1;">
                                        <h3>
                                            <span class="h3-fs">Opening hours</span>
                                        </h3>
                                        <p class="o_small-fs">
                                            <u><br/>Monday</u>
                                            <br/>
                                            8.00am-6.00pm
                                        </p>
                                        <p class="o_small-fs">
                                            <u>Tuesday</u>
                                            <br/>
                                            8.00am-6.00pm
                                        </p>
                                        <p class="o_small-fs">
                                            <u>Wednesday</u>
                                            <br/>
                                            8.00am-12.00pm
                                        </p>
                                        <p class="o_small-fs">
                                            <u>Thursday</u>
                                            <br/>
                                            8.00am-6.00pm
                                        </p>
                                        <p>
                                            <a class="btn btn-primary o_translate_inline" href="/contactus">Get directions</a>
                                        </p>
                                    </div>
                                    <div class="col-lg-9 o_colored_level order-lg-0" style="order: 0;">
                                        <section data-map-type="m" data-vxml="001" class="s_map pt216 pb216 rounded-3 o_not_editable" data-map-address="250 Executive Park Blvd, Suite 3400 • San Francisco CA 94134 • United States" data-snippet="s_map" data-name="Map" data-map-zoom="13">
                                            <div class="map_container">
                                                <div class="css_non_editable_mode_hidden">
                                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                        An address must be specified for a map to be embedded
                                                    </div>
                                                </div>
                                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=250%20Executive%20Park%20Blvd%2C%20Suite%203400%20%E2%80%A2%20San%20Francisco%20CA%2094134%20%E2%80%A2%20United%20States&amp;t=m&amp;z=13&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                                <div class="s_map_color_filter"><br/></div>
                                            </div>
                                        </section>
                                        <div class="s_hr pt32 pb32 d-lg-none o_snippet_desktop_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level o_cc pb72 pt80 o_cc3" data-snippet="s_text_block" data-name="Text" style="position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/17&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}"><div class="o_we_shape o_html_builder_Connections_17" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F17.svg?c5=%23FFF9F1&amp;flip=y&quot;); background-position: 50% 0%;"/>
                            <div class="s_allow_columns container">
                                <p style="text-align: center;">
                                    <img src="/web/image/pet_groomer.img_pet_groomer_image_01" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="750" data-mimetype="image/webp" style="width: 20% !important;" data-aspect-ratio="0/0" data-x="179.52" data-width="375.08" data-height="415.36" data-scale-x="1" data-scale-y="1" data-y="25.14" loading="lazy"/>
                                </p>
                                <h2 style="text-align: center;">
                                    <span class="text-o-color-5">Let the</span> <span class="text-o-color-1">groom</span><span class="text-o-color-5"> begin!</span>
                                </h2>
                                <p><br/></p>
                                <p style="text-align: center;">
                                    <a href="/appointment" class="o_translate_inline btn btn-primary">Book an appointment</a>
                                </p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
