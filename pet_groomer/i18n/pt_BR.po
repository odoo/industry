msgstr ""
"<strong>Vendas</strong> – Crie pedidos de venda, gerencie preços e prepare "
"transações antes do pagamento."

#. module: pet_groomer
#: model_terms:appointment.type,message_intro:pet_groomer.appointment_type_animal_wellness
msgid ""
"<strong>Seasonal Packages</strong> – “Summer cut” or “Winter coat "
"maintenance.”"
msgstr ""
"<strong>Pacotes sazonais</strong> – “Corte de verão” ou “Manutenção de "
"pelagem de inverno”."

#. module: pet_groomer
#: model_terms:ir.ui.view,arch_db:pet_groomer.welcome_article_body
msgid ""
"<strong>Sign</strong> – Digitally manage consent forms, liability waivers, "
"and service approvals."
msgstr ""
"<strong>Assinar</strong> – Gerencie digitalmente formulários de "
"consentimento, isenções de responsabilidade e aprovações de serviços."

#. module: pet_groomer
#: model_terms:ir.ui.view,arch_db:pet_groomer.welcome_article_body
msgid ""
"<strong>Survey</strong> - Track client satisfaction &amp; feedback using "
