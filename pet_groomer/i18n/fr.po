msgstr ""
"<strong>Ventes</strong> - Créez des commandes de services, gérez les prix et "
"préparez les transactions avant le paiement."

#. module: pet_groomer
#: model_terms:appointment.type,message_intro:pet_groomer.appointment_type_animal_wellness
msgid ""
"<strong>Seasonal Packages</strong> – “Summer cut” or “Winter coat "
"maintenance.”"
msgstr ""
"<strong>Forfaits saisonniers</strong> - “Coupe d’été” ou “Entretien du "
"pelage d’hiver.”"

#. module: pet_groomer
#: model_terms:ir.ui.view,arch_db:pet_groomer.welcome_article_body
