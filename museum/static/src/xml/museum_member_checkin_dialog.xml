<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="museum.MuseumMemberCheckinDialog">
        <Dialog size="'md'" title.translate="Member Check-In">
            <div class="row">
                <div class="col-12 fs-2">
                    <div class="alert alert-success d-flex align-items-center justify-content-center" role="alert">
                        <i class="oi oi-filled me-2" data-icon="check_circle"/>
                        <span>Member verified!</span>
                    </div>
                </div>
            </div>
            <div class="row fs-1 mt-2">
                <div class="col-12 d-flex align-items-baseline gap-3 fw-bold">
                    <t t-out="this.props.member.name"/>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-12">
                    <table class="table table-striped fs-4">
                        <tr t-if="this.props.member.company">
                            <td>Company</td>
                            <td><t t-out="this.props.member.company"/></td>
                        </tr>
                        <tr t-if="this.props.member.email">
                            <td>Email</td>
                            <td><t t-out="this.props.member.email"/></td>
                        </tr>
                        <tr t-if="this.props.member.phone">
                            <td>Phone</td>
                            <td><t t-out="this.props.member.phone"/></td>
                        </tr>
                    </table>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.props.close">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
