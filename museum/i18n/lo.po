#. module: museum
#: model_terms:ir.ui.view,arch_db:museum.exhibitions
msgid "<strong>Stories in Space, Time, and Image</strong>"
msgstr "<strong>ເລື່ອງລາວໃນພື້ນທີ່, ກາລະເວລາ, ແລະ ພາບພົດ</strong>"

#. module: museum
#: model_terms:ir.ui.view,arch_db:museum.donations
msgid ""
