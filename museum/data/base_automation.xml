<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="automation_check_partner_barcode_conflict" model="base.automation">
        <field name="name">Validate Partner Barcode Uniqueness</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="trigger">on_create_or_write</field>
        <field name="trigger_field_ids" eval="[(4, ref('base.field_res_partner__barcode'))]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_check_partner_barcode_conflict')])]"/>
    </record>
    <record id="automation_generate_event_registration_barcode" model="base.automation">
        <field name="name">Generate Event Registration Barcode</field>
        <field name="model_id" ref="event.model_event_registration"/>
        <field name="trigger">on_create</field>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_generate_event_registration_barcode')])]"/>
    </record>
</odoo>
