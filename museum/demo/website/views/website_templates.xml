<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/donations" class="oe_unremovable btn_cta btn btn-primary">Support us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px;">
                    <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-5 pt24 pb24 o_colored_level">
                                    <ul class="list-unstyled">
                                        <li>Sunday to Tuesday: 10 AM - 5 PM</li>
                                        <li>Wednesday to Saturday: Closed</li>
                                    </ul>
                                </div>
                                <div class="col-lg-2 pt24 pb24 o_colored_level">
                                    <ul class="list-unstyled">
                                        <li><a href="/">Home</a></li>
                                        <li><a href="/exhibitions">Exhibitions</a></li>
                                        <li><a href="/contactus">Contact us</a></li>
                                    </ul>
                                </div>
                                <div class="col-lg-2 pt24 pb24 o_colored_level">
                                    <ul class="list-unstyled">
                                        <li><a href="*event_event_4_url*/register">Visit</a></li>
                                        <li><a href="/donations#Frequently-asked-questions">FAQs</a></li>
                                        <li><a href="/donations" class="o_translate_inline">Support us</a></li>
                                    </ul>
                                </div>
                                <div class="pt24 pb24 o_colored_level col-lg-3">
                                    <h5>Connect with us</h5>
                                    <div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi rounded-circle shadow-sm o_editable_media o_cc o_cc5" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="oi rounded-circle shadow-sm o_editable_media o_cc o_cc5" data-icon="oi_x"/>
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                            <i class="oi rounded-circle shadow-sm o_editable_media o_cc o_cc5" data-icon="oi_linkedin"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value eval="[ref('footer_custom')]"/>
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('museum.footer_custom').arch
            .replace('*event_event_4_url*', obj().env.ref('museum.event_event_4').website_url)
        }"/>
    </function>
</odoo>
