<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_donations" model="ir.ui.view">
        <field name="name">Donations</field>
        <field name="key">museum.page_donations</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="museum.page_donations">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block o_colored_level oe_img_bg o_bg_img_center o_bg_img_origin_border_box o_cc o_half_screen_height o_cc2" data-snippet="s_text_block" data-name="Text" data-format-mimetype="image/webp" data-resize-width="1860" data-mimetype="image/webp" style="background-image: url(&quot;/web/image/museum.img_museum_image_21&quot;);">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="col-lg-12 o_colored_level d-lg-none o_snippet_desktop_invisible pt160" data-invisible="1">
                                        <h1 class="text-center"><span data-text-effect="{&quot;preset&quot;:&quot;custom&quot;,&quot;shadows&quot;:[{&quot;shadowColor&quot;:&quot;rgba(0, 0, 0, 0.5)&quot;,&quot;shadowOffsetX&quot;:&quot;0px&quot;,&quot;shadowOffsetY&quot;:&quot;0px&quot;,&quot;shadowBlur&quot;:&quot;30px&quot;}],&quot;presetHash&quot;:&quot;18374705&quot;}" style="text-shadow: rgba(0, 0, 0, 0.5) 0px 0px 30px;">Support Us</span></h1>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level o_cc o_cc5 pt48 pb56" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_colored_level offset-lg-2 col-lg-8">
                                        <p class="text-center">Preserve. Share. Inspire.</p>
                                        <h2 class="text-center"><span class="h3-fs">Your contribution helps us keep the museum open and accessible to everyone: students, families, researchers, and curious visitors of all ages. Whether it’s a one-time gift or ongoing support, your donation becomes part of the museum’s story—and part of what we pass on to future generations.</span></h2>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="o_cc o_colored_level pt48 o_cc1 pb56" data-snippet="s_donation" data-name="Donation">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="pb16 o_colored_level col-lg-7 pt0">
                                        <h2>Make a Donation</h2>
                                        <p class="lead"><span class="base-fs"><em>Small or large, your contribution is essential.</em></span></p>
                                        <p/>
                                        <p class="lead"><span class="base-fs"><strong>Support a Cause</strong> — Donate to fund cause-related exhibitions.</span></p>
                                        <div class="s_hr o_colored_level pt0 pb0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <p class="lead"/>
                                        <p class="lead"><span class="base-fs"><strong>Adopt an Artwork</strong> — Fund the conservation of a specific artwork.</span></p>
                                        <div class="s_hr pt0 pb0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <p class="lead"/>
                                        <p class="lead"><span class="base-fs"><strong>Fund Accessible Entry</strong> — Help us offer reduced admission to underprivileged groups.</span></p>
                                        <div class="s_hr pt0 pb0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <p class="lead"/>
                                        <p class="lead"><span class="base-fs"><strong>Monthly Ally</strong> — Join our core donors with a monthly contribution.</span></p>
                                        <p><br/></p>
                                        <div class="s_donation" data-snippet="s_donation_form" data-name="Donation Form" data-custom-amount="slider" data-display-options="true" data-descriptions="true" data-donation-amounts="[&quot;100&quot;, &quot;50&quot;]" data-minimum-amount="5" data-maximum-amount="300" data-slider-step="1" data-default-amount="25">
                                            <div class="s_donation_form">
                                                <div class="s_donation_prefilled_buttons mb-2"/>
                                                <div id="s_donation_description_inputs" class="d-none"/>
                                                <div class="s_donation_range_slider_wrap mb-2 position-relative">
                                                    <label for="s_donation_range_slider">Choose Your Amount</label>
                                                    <input type="range" class="form-range" min="5" max="300" step="1" id="s_donation_range_slider" contenteditable="false"/>
                                                    <output class="s_range_bubble" contenteditable="false">25</output>
                                                </div>
                                                <a href="#" type="button" class="s_donation_donate_btn btn btn-primary mb-2">Donate now</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="pb16 d-none d-md-block o_colored_level col-lg-4 offset-lg-1 pt0">
                                        <img src="/web/image/museum.img_museum_image_22" alt="" class="img img-fluid mx-auto o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="0/0" data-width="1280" data-height="1701.3" data-scale-x="1" data-scale-y="1"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_faq_collapse pt32 o_colored_level pb64" data-vcss="001" data-snippet="s_faq_collapse" data-name="FAQ Block" id="Frequently-asked-questions" data-anchor="true">
                            <div class="container">
                                <div class="row s_nb_column_fixed align-items-start">
                                    <div class="col-lg-4 pt16 o_colored_level">
                                        <h2 class="h3-fs">Frequently asked questions</h2>
                                        <p class="lead"><span class="base-fs">Here are some common questions about supporting the museum.</span></p>
                                    </div>
                                    <div class="col-lg-7 offset-lg-1 s_col_no_bgcolor" data-name="Accordion Box">
                                        <div data-name="Accordion" class="s_accordion">
                                            <div id="myCollapse" class="accordion-flush accordion">
                                                <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none" data-bs-toggle="collapse" aria-expanded="true" id="accordion-button494749_1" data-bs-target="#myCollapseTab494749_1" aria-controls="myCollapseTab494749_1"><span class="flex-grow-1">How is my donation used?</span></button>
                                                    <div class="accordion-collapse collapse show" data-bs-parent="#myCollapse" role="region" id="myCollapseTab494749_1" aria-labelledby="accordion-button494749_1">
                                                        <div class="accordion-body">
                                                            <p>Every donation goes directly to the museum: it funds new exhibitions, the conservation and restoration of our collection, and the educational programs we offer to schools and families.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none collapsed" data-bs-toggle="collapse" aria-expanded="false" id="accordion-button494749_2" data-bs-target="#myCollapseTab494749_2" aria-controls="myCollapseTab494749_2"><span class="flex-grow-1">Can I choose what my donation supports?</span></button>
                                                    <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab494749_2" aria-labelledby="accordion-button494749_2">
                                                        <div class="accordion-body">
                                                            <p>Yes. You can support a cause-related exhibition, adopt an artwork to fund its conservation, help us offer reduced admission to underprivileged groups, or become a Monthly Ally. Simply tell us your choice through our contact page or by emailing info@crownfineart.example.org.</p>
                                                            <p>Without any indication, your gift goes where it is needed most.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none collapsed" data-bs-toggle="collapse" aria-expanded="false" id="accordion-button494749_3" data-bs-target="#myCollapseTab494749_3" aria-controls="myCollapseTab494749_3"><span class="flex-grow-1">Will I receive a confirmation of my donation?</span></button>
                                                    <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab494749_3" aria-labelledby="accordion-button494749_3">
                                                        <div class="accordion-body">
                                                            <p>Yes. As soon as your payment is completed, you receive a confirmation email with the details of your donation. For any question, our team is happy to help at info@crownfineart.example.org or +44 1632 960123.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_donations" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_donations"/>
            <field name="url">/donations</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
