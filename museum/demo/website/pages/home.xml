<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_home" model="ir.ui.view">
        <field name="name">Home</field>
        <field name="key">museum.page_home</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Homepage" t-name="museum.page_home">
                <t t-call="website.layout" pageName.f="homepage">
                    <div id="wrap" class="oe_structure">
                        <section class="s_banner o_cc s_parallax_no_overflow_hidden pt40 pb64 o_colored_level o_cc1" data-snippet="s_banner" data-name="Banner" data-format-mimetype="image/webp" data-scroll-background-ratio="0">
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="18">
                                    <div class="o_grid_item o_grid_item_image s_parallax_no_overflow_hidden border g-height-5 g-col-lg-3 col-lg-3 col-5 d-lg-block d-none o_snippet_mobile_invisible o_animate o_anim_fade_in o_colored_level order-lg-0" style="z-index: 2; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; grid-area: 14 / 1 / 19 / 4; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px; animation-duration: 1.2s; animation-delay: 0.3s; order: 0;" data-scroll-background-ratio="0" data-invisible="1">
                                        <img src="/web/image/museum.img_museum_image_01" alt="" class="img img-fluid mx-auto o_we_custom_image o_editable_media" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp"/>
                                    </div>
                                    <div class="o_grid_item o_grid_item_image s_parallax_no_overflow_hidden border g-col-lg-6 col-lg-6 g-height-5 o_animate o_anim_fade_in o_colored_level order-lg-0 col-6" style="z-index: 12; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; grid-area: 14 / 7 / 19 / 13; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px; animation-duration: 1.2s; animation-delay: 0.5s; order: 5;" data-scroll-background-ratio="0">
                                        <img src="/web/image/museum.img_museum_image_02" alt="" class="img img-fluid mx-auto o_we_custom_image o_editable_media" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp"/>
                                    </div>
                                    <div class="o_grid_item o_animate o_anim_fade_in o_anim_from_right o_colored_level g-col-lg-9 g-height-10 col-lg-9 order-lg-0" style="--wanim-intensity: 5; z-index: 14; grid-area: 1 / 1 / 11 / 10; order: 1;">
                                        <h1 class="display-1"><span class="o_animated_text o_animate o_anim_fade_in o_anim_from_left"><strong>The Crown Fine</strong> <img src="/web/image/museum.img_museum_image_03" alt="" class="img img-fluid o_we_custom_image" data-shape="html_builder/geometric/geo_tear" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/svg+xml" data-aspect-ratio="1/1" style="width: 17.1%; height: auto;" loading="lazy"/> <i><span class="text-o-color-1"><strong>Art</strong></span></i> <strong>Museum</strong></span></h1>
                                    </div>
                                    <div class="o_grid_item g-height-2 g-col-lg-3 col-lg-3 o_animate o_anim_fade_in o_anim_from_bottom o_colored_level order-lg-0" style="z-index: 10; --wanim-intensity: 10; animation-delay: 0.3s; grid-area: 11 / 1 / 13 / 4; order: 2;">
                                        <p class="lead"><span class="base-fs">MASTERPIECES ACROSS CENTURIES. TIMELESS INSPIRATION</span></p>
                                    </div>
                                    <div class="o_grid_item g-col-lg-5 g-height-2 col-lg-5 o_animate o_anim_fade_in o_anim_from_top o_colored_level order-lg-0" style="z-index: 5; --wanim-intensity: 10; animation-delay: 0.2s; grid-area: 8 / 8 / 10 / 13; order: 3;">
                                        <p class="lead"><em>Discover world-class classical paintings, European sculptures, and rare historical portraiture in the heart of the city.</em></p>
                                    </div>
                                    <div class="o_grid_item o_grid_item_image s_parallax_no_overflow_hidden border g-height-5 g-col-lg-3 col-5 o_animate o_anim_fade_in o_colored_level order-lg-0 col-lg-3" style="z-index: 15; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px; animation-duration: 1.2s; grid-area: 14 / 4 / 19 / 7; animation-delay: 0.4s; order: 4;" data-scroll-background-ratio="0">
                                        <img src="/web/image/museum.img_museum_image_04" alt="" class="img img-fluid mx-auto o_we_custom_image o_editable_media" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/svg+xml" data-shape="html_builder/geometric/geo_slanted" data-aspect-ratio="1/1" data-file-name="custom-image-37.svg"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level o_cc o_cc3 pt56 pb64" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-8 offset-lg-2">
                                        <p class="text-center">A Tradition of Preserving Fine Art</p>
                                        <h2 class="text-center">
                                            <span class="h3-fs">
                                                Established in 1894, The Crown Fine Art Museum houses over 15,000 works of art spanning eight centuries. Our mission is to preserve and showcase exceptional visual art for visitors of all ages. From quiet gallery halls to interactive educational workshops, we invite you to experience human creativity at its finest.
                                            </span>
                                        </h2>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_key_images pt72 o_cc o_colored_level pb56 o_cc1" data-snippet="s_key_images" data-name="Key Images">
                            <div class="container">
                                <h2 style="text-align: left;">Explore our <em><span class="text-o-color-1">Collection</span></em></h2>
                                <p>
                                    <a href="/exhibitions">
                                        <span class="text-o-color-1">Explore more</span>
                                    </a> <span class="oi text-o-color-1" data-icon="keyboard_double_arrow_right"/>
                                </p>
                                <div class="row">
                                    <div class="o_colored_level col-lg-5 offset-lg-7 pt0 col-12">
                                        <p class="lead"><span class="base-fs">The Crown Fine Art Museum houses a world-renowned permanent collection of over 15,000 objects. From sweeping canvas landscapes and intimate portraits to monumental sculptures, our holdings represent the finest achievements in classical art. Explore our core departments below.</span></p>
                                    </div>
                                    <div class="col-6 col-lg-3 o_colored_level pt56">
                                        <p>
                                            <img src="/web/image/museum.img_museum_image_05" alt="Portrait of a woman in a white dress seated in a drawing room" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="2/3" data-x="30.999999999999993" data-width="1280" data-height="1920.0000000000002" data-scale-x="1" data-scale-y="1"/>
                                        </p>
                                        <h3 class="h4-fs">Portraits</h3>
                                    </div>
                                    <div class="col-6 col-lg-3 o_colored_level pt56">
                                        <p>
                                            <img src="/web/image/museum.img_museum_image_06" alt="Still life painting of a bouquet of flowers in a vase" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="16/9" data-y="130.99999999999997" data-width="1920" data-height="1080" data-scale-x="1" data-scale-y="1"/>
                                        </p>
                                        <h3 class="h4-fs">Still Life</h3>
                                    </div>
                                    <div class="col-6 col-lg-3 o_colored_level pt56">
                                        <p>
                                            <img src="/web/image/museum.img_museum_image_07" alt="Marble sculpture of two embracing figures" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="2/3" data-width="1280" data-height="1920" data-scale-x="1" data-scale-y="1"/>
                                        </p>
                                        <h3 class="h4-fs">Sculptures</h3>
                                    </div>
                                    <div class="col-6 col-lg-3 o_colored_level pt56">
                                        <p>
                                            <img src="/web/image/museum.img_museum_image_08" alt="Autumn landscape painting of a river valley" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="16/9" data-x="-1.0727802088927001e-13" data-y="37.49999999999997" data-width="1919.9999999999998" data-height="1080" data-scale-x="1" data-scale-y="1"/>
                                        </p>
                                        <h3 class="h4-fs">Landscapes</h3>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_faq_list pt56 pb48 o_colored_level bg-white" data-snippet="s_faq_list" data-name="FAQ List">
                            <div class="container">
                                <h2>
                                    Current &amp;amp; Upcoming <em><span class="text-o-color-1">Exhibitions</span></em>
                                </h2>
                                <p><br/></p>
                                <div class="row">
                                    <div class="o_colored_level col-lg-2 pt16 pb0">
                                        <h3>I.</h3>
                                    </div>
                                    <div class="o_colored_level col-lg-3 pt0 pb0">
                                        <p>
                                            <img src="/web/image/museum.img_museum_image_09" alt="" class="img img-fluid o_we_custom_image" style="width: 50% !important;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="16/9" data-width="1536" data-height="864" data-scale-x="1" data-scale-y="1"/>
                                        </p>
                                    </div>
                                    <div class="o_colored_level pt24 pb0 col-lg-5">
                                        <h3><span class="h4-fs">Light &amp;amp; Shadow: Renaissance Masters</span></h3>
                                    </div>
                                    <div class="o_colored_level pt24 pb0 col-lg-2">
                                        <p class="lead" style="text-align: left;"><span class="base-fs">Oct 12 – Jan 28</span></p>
                                    </div>
                                    <div class="o_colored_level col-lg-12 pt0 pb0">
                                        <div class="s_hr pb32 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                    </div>
                                    <div class="o_colored_level col-lg-2 pt16 pb0">
                                        <h3>II.</h3>
                                    </div>
                                    <div class="o_colored_level col-lg-3 pt0 pb0">
                                        <p>
                                            <img src="/web/image/museum.img_museum_image_10" alt="" class="img img-fluid o_we_custom_image" style="width: 50% !important;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="16/9" data-x="-7.142628547954934e-14" data-y="600" data-width="1280" data-height="720" data-scale-x="1" data-scale-y="1"/>
                                        </p>
                                    </div>
                                    <div class="o_colored_level pt24 pb0 col-lg-5">
                                        <h3><span class="h4-fs">Marble &amp;amp; Grace: European Form</span></h3>
                                    </div>
                                    <div class="o_colored_level pt24 pb0 col-lg-2">
                                        <p class="lead" style="text-align: left;"><span class="base-fs">Opens Nov 15</span></p>
                                    </div>
                                    <div class="o_colored_level col-lg-12 pt0 pb0">
                                        <div class="s_hr pb32 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                    </div>
                                    <div class="o_colored_level col-lg-2 pt16 pb0">
                                        <h3>III.</h3>
                                    </div>
                                    <div class="o_colored_level col-lg-3 pt0 pb0">
                                        <p>
                                            <img src="/web/image/museum.img_museum_image_11" alt="" class="img img-fluid o_we_custom_image" style="width: 50% !important;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="16/9" data-x="-8.072438181416522e-14" data-y="553.3124999999999" data-width="1446" data-height="813.3750000000001" data-scale-x="1" data-scale-y="1"/>
                                        </p>
                                    </div>
                                    <div class="o_colored_level pt24 pb0 col-lg-5">
                                        <h3><span class="h4-fs">The Golden Age of Portraiture</span></h3>
                                    </div>
                                    <div class="o_colored_level pt24 pb0 col-lg-2">
                                        <p class="lead" style="text-align: left;"><span class="base-fs">Permanent Collection</span></p>
                                    </div>
                                    <div class="o_colored_level col-lg-12 pt0 pb0">
                                        <div class="s_hr pb32 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                    </div>
                                    <div class="o_colored_level col-lg-2 pt16 pb0">
                                        <h3>IV.</h3>
                                    </div>
                                    <div class="o_colored_level col-lg-3 pt0 pb0">
                                        <p>
                                            <img src="/web/image/museum.img_museum_image_12" alt="" class="img img-fluid o_we_custom_image" style="width: 50% !important;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="16/9" data-y="203.49999999999994" data-width="1919.9999999999998" data-height="1080" data-scale-x="1" data-scale-y="1"/>
                                        </p>
                                    </div>
                                    <div class="o_colored_level pt24 pb0 col-lg-5">
                                        <h3><span class="h4-fs">Horizons of Gold: European Landscapes</span></h3>
                                    </div>
                                    <div class="o_colored_level pt24 pb0 col-lg-2">
                                        <p class="lead" style="text-align: left;"><span class="base-fs">Dec 01 – Mar 15</span></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_image o_colored_level o_cc pt40 pb0 o_cc1" data-snippet="s_text_image" data-name="Text - Image">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-5 pt16 pb16 o_colored_level">
                                        <h2 style="text-align: left;">Art is not what you see, but what you make others see.</h2>
                                        <p style="text-align: left;" class="lead"><em>— Edgar Degas</em></p>
                                    </div>
                                    <div class="pt16 pb16 o_colored_level col-lg-5 offset-lg-2">
                                        <img src="/web/image/museum.img_museum_image_13" alt="" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/svg+xml" data-shape="html_builder/geometric/geo_door" data-aspect-ratio="1/1" data-file-name="custom-image-39.svg"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_home" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_home"/>
            <field name="url">/</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
