<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="event_event_4" model="event.event">
        <field name="name">Museum entry</field>
        <field name="cover_properties"><![CDATA[{"background-image":"url('/web/image/museum.ir_attachment_837')","background_color_class":"o_cc o_cc3","opacity":"0.2","resize_class":"o_half_screen_height o_record_has_cover"}]]></field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="description"><![CDATA[
            <section class="s_text_block o_colored_level pb40" data-name="Text">
                <h3>Visiting Hours</h3>
                <p class="lead"><span class="base-fs">Sunday to Tuesday: 10 AM - 5 PM</span></p>
                <p class="lead"><span class="base-fs">Wednesday to Saturday: Closed</span></p>
                <div class="s_hr o_colored_level pt4 pb24" data-snippet="s_hr" data-name="Separator">
                    <hr class="w-100 mx-auto"/>
                </div>
                <p class="lead"><span class="base-fs">We recommend booking your tickets online in advance to make your visit as smooth as possible.</span></p>
                <p class="lead"><span class="base-fs">Walk-ins are also welcome. Same-day tickets may be available at the front desk; please note there may be a short wait during busy periods.</span></p>
            </section>
            <section class="s_text_block o_colored_level pb40" data-name="Text">
                <h3>Reduced &amp; Free Admission</h3>
                <p class="lead"><span class="base-fs">Discounted or free tickets are available for eligible visitors, including partners, educators, and youth card holders.</span></p>
                <p class="lead"><span class="base-fs">Reduced rates also apply to seniors aged 65 and over, young visitors aged 12 to 25, and children under 12 (Kids ticket).</span></p>
                <p class="lead"><span class="base-fs">Please select the appropriate <strong>ticket type</strong> when booking online. Proof of eligibility will be required at the front desk when you arrive.</span></p>
            </section>
            <section class="s_text_block pb40 o_colored_level" data-name="Text">
                <h3>Modified Hours &amp; Closures</h3>
                <ul class="lead">
                    <li class="base-fs">Early closure at 3:00 PM on August 1 and October 8</li>
                    <li class="base-fs">The museum will be closed on October 9</li>
                </ul>
            </section>]]>
        </field>
        <field name="is_multi_slots" eval="True"/>
        <field name="date_tz">Europe/London</field>
        <field name="date_begin" model="res.users" eval="
                (DateTime.now().replace(hour=8, minute=0) + relativedelta(months=-6, weekday=6)).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)
        "/>
        <field name="date_end" model="res.users" eval="
                (DateTime.now().replace(hour=16, minute=0) + relativedelta(months=5, weekday=4)).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)
        "/>
        <field name="image_1024" type="bytes" file="museum/static/src/binary/event_event/4-image_1024"/>
        <field name="is_published" eval="1"/>
    </record>
</odoo>
