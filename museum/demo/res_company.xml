<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="base.main_company" model="res.company" forcecreate="0">
        <field name="email">info@crownfineart.example.org</field>
        <field name="logo" type="bytes" file="museum/static/description/icon.png"/>
        <field name="partner_id" ref="base.main_partner"/>
        <field name="name">Crown Fine Art Museum</field>
        <field name="phone">+44 1632 960123</field>
        <field name="street">Abington St 15</field>
        <field name="zip" eval="False"/>
        <field name="city">Northampton</field>
        <field name="country_id" ref="base.uk"/>
        <field name="currency_id" ref="base.GBP"/>
    </record>
    <function model="product.pricelist" name="write">
        <value model="product.pricelist" search="[('name', '=', 'Default')]"/>
        <value eval="{'currency_id': ref('base.GBP')}"/>
    </function>
</odoo>
