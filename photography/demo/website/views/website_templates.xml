<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-right-width: 0px;">
                    <section class="s_text_block pb0 pt0" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="border col-lg-3 o_colored_level pt48 pb48 o_animate o_anim_fade_in o_visible" style="--box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; animation-name: dummy;">
                                    <p>
                                        <a href="#top" class="o_translate_inline">Instagram</a>
                                    </p>
                                </div>
                                <div class="o_colored_level border col-lg-5 pt48 pb48 o_animate o_anim_fade_in o_visible" style="--box-border-bottom-width: 0px; --box-border-top-width: 0px; animation-name: dummy;">
                                    <p>
                                        <span class="h3-fs">
                                            <a href="/about" class="o_translate_inline">About</a>
                                        </span>
                                    </p>
                                    <p>
                                        <span class="h3-fs">
                                            <a href="/services" class="o_translate_inline">Services</a>
                                        </span>
                                    </p>
                                    <p>
                                        <span class="h3-fs">
                                            <a href="/portfolio" class="o_translate_inline">Portfolio</a>
                                        </span>
                                    </p>
                                    <p>
                                        <span class="h3-fs">
                                            <a href="/contactus" class="o_translate_inline">Contact</a>
                                        </span>
                                    </p>
                                </div>
                                <div class="o_colored_level border col-lg-4 pt48 pb48 o_animate o_anim_fade_in o_visible" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-top-width: 0px; animation-name: dummy;">
                                    <p>
                                        <span class="h4-fs">Email</span>
                                    </p>
                                    <p>
                                        <a href="mailto:eva@lamdba.com" class="o_translate_inline">eva@lamdba.com</a>
                                    </p>
                                    <p>
                                        <span class="h4-fs">Phone</span>
                                    </p>
                                    <p>+1 (617) 292-2740</p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>

    <record id="option_header_brand_name" model="ir.ui.view">
        <field name="name">Custom - Header Brand Name</field>
        <field name="key">website.option_header_brand_name</field>
        <field name="inherit_id" ref="website.placeholder_header_brand" />
        <field name="website_id" ref="website_industry" />
        <field name="active" eval="False" />
        <field name="arch" type="xml">
            <xpath expr="//*[@id='o_fake_navbar_brand']" position="replace">
                <a href="/" t-attf-class="navbar-brand #{_link_class}" class="navbar-brand me-4">
                    <span class="h5-fs">
                        <strong>
                            <font class="text-o-color-5">EVA LAMBDA</font>
                        </strong>
                    </span>
                </a>
            </xpath>
        </field>
    </record>

    <record id="header_call_to_action_text" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action_text</field>
        <field name="inherit_id" ref="website.header_call_to_action" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//a[hasclass('btn_cta')]" position="replace">
                <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta">Contact</a>
            </xpath>
        </field>
    </record>
</odoo>
