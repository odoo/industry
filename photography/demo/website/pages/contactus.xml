<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact</field>
        <field name="key">photography.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="photography.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{
                        'tag_ids': request.params.get('tag_ids', ''),
                        'email_to': res_company.email,
                        'name': request.params.get('name', ''),
                        'phone': request.params.get('phone', ''),
                        'email_from': request.params.get('email_from', ''),
                        'company': request.params.get('company', ''),
                        'subject': request.params.get('subject', '')}"/>

                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title_split o_colored_level pt136 pb40 s_custom_snippet" data-snippet="s_title_split" data-name="Custom Title Split">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="o_colored_level o_animate o_visible o_anim_fade_in col-lg-12" style="animation-name: dummy;">
                                        <h1 class="display-3-fs" style="text-align: center;">Let's connect</h1>
                                    </div>

                                </div>
                            </div>
                        </section>

                        <section class="s_title_form o_cc o_colored_level o_cc1 pb88 pt32" data-snippet="s_title_form" data-name="Title - Form" style="position: relative;">
                            <div class="o_container_small">
                                <section class="s_website_form" data-snippet="s_website_form" data-name="Form">
                                    <div class="container">
                                        <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name">
                                                    <label class="s_website_form_label" for="oy42nnq8ej4" style="width: 200px;">
                                                        <span class="s_website_form_label_content">Your Name</span>
                                                        <span class="s_website_form_mark">  *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="" id="oy42nnq8ej4" data-fill-with="name" />
                                                </div>

                                                <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="many2one" data-translated-name="Type of session">
                                                    <label class="s_website_form_label" for="opb2lkhzpe0a" style="width: 200px;">
                                                        <span class="s_website_form_label_content">Type of session</span>
                                                    </label>
                                                    <select class="form-select s_website_form_input" name="tag_ids" id="opb2lkhzpe0a">
                                                        <option id="opb2lkhzpe0a0" value="*wedding_tag*">Wedding</option>
                                                        <option id="opb2lkhzpe0a1" value="*portrait_tag*" selected="selected">Personal or Family Portraits</option>
                                                        <option id="opb2lkhzpe0a2" value="*baby_tag*">Baby portraits</option>
                                                        <option id="opb2lkhzpe0a3" value="*pregnancy_tag*">Pregnancy</option>
                                                        <option id="opb2lkhzpe0a4" value="*pro_event_tag*">Professional Event</option>
                                                        <option id="opb2lkhzpe0a5" value="*other_tag*">Other</option>
                                                    </select>
                                                </div>

                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="tel" data-translated-name="Phone Number">
                                                    <label class="s_website_form_label" for="oeectok4vmgr" style="width: 200px;">
                                                        <span class="s_website_form_label_content">Phone Number</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="tel" name="phone" placeholder="" id="oeectok4vmgr" data-fill-with="phone" />
                                                </div>

                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_required" data-type="email" data-translated-name="Your Email">
                                                    <label class="s_website_form_label" for="ohqikiq5aj2s" style="width: 200px;">
                                                        <span class="s_website_form_label_content">Your Email</span>
                                                        <span class="s_website_form_mark">  *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="ohqikiq5aj2s" data-fill-with="email" />
                                                </div>

                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Interested in...">
                                                    <label class="s_website_form_label" for="o4u82g6tk19" style="width: 200px;">
                                                        <span class="s_website_form_label_content">Interested in...</span>
                                                        <span class="s_website_form_mark">  *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="o4u82g6tk19" data-fill-with="undefined" />
                                                </div>

                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="Your Question">
                                                    <label class="s_website_form_label" for="on4qxk6i20h" style="width: 200px;">
                                                        <span class="s_website_form_label_content">Your Question</span>
                                                        <span class="s_website_form_mark">  *</span>
                                                    </label>
                                                    <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="on4qxk6i20h" rows="4" />
                                                </div>

                                                <input type="hidden" name="team_id" value="*sales_team_team_sales_department*"/>
                                                <input type="hidden" name="user_id" value="*base_user_admin*"/>

                                                <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                    <div style="width: 200px;" class="s_website_form_label"><br/></div>
                                                    <a href="#" role="button" class="s_website_form_send btn btn-primary">Submit</a>
                                                    <span id="s_website_form_result"/>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </section>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('photography.website_industry').id).viewref('photography.view_page_contactus').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('photography.view_page_contactus').arch.replace(
                '*wedding_tag*', str(obj().env.ref('photography.crm_tag_wedding').id)).replace(
                '*portrait_tag*', str(obj().env.ref('photography.crm_tag_portrait').id)).replace(
                '*baby_tag*', str(obj().env.ref('photography.crm_tag_baby').id)).replace(
                '*pregnancy_tag*', str(obj().env.ref('photography.crm_tag_pregnancy').id)).replace(
                '*pro_event_tag*', str(obj().env.ref('photography.crm_tag_pro_event').id)).replace(
                '*other_tag*', str(obj().env.ref('photography.crm_tag_other').id)).replace(
                '*sales_team_team_sales_department*', str(obj().env.ref('sales_team.team_sales_department').id)).replace(
                '*base_user_admin*', str(obj().env.ref('base.user_admin').id))
        }"/>
    </function>
</odoo>
