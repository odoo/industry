<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_services" model="ir.ui.view">
        <field name="name">Services</field>
        <field name="key">photography.page_services</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="photography.page_services">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty"><section class="s_title_split o_colored_level pt136 pb40 s_custom_snippet" data-snippet="s_title_split" data-name="Custom Title Split">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-6 o_colored_level o_animate o_visible o_anim_fade_in" style="animation-name: dummy;">
                                        <h1 class="display-3-fs">Services</h1>
                                    </div>
                                    <div class="col-lg-5 offset-lg-1 o_colored_level pt24 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p>I preserve the heartbeat of your home through timeless imagery. My collection celebrates the laughter, the quiet moments, and the unique bonds that make your family's story worth telling for generations.</p>
                                    </div>
                                </div>
                            </div>
                        </section><section data-snippet="s_appointments" class="s_appointments s_dynamic s_appointment_type_picture o_colored_level pt0 pb0 o_dynamic_snippet_loading" data-custom-template-data="{}" data-number-of-records="3" data-name="Appointments" data-filter-id="__EXPORT_FILTER_XMLID__website_appointment.website_snippet_filter_appointments__EXPORT_FILTER_XMLID__" data-template-key="website_appointment.dynamic_filter_template_appointment_type_picture" data-extra-classes="g-3" data-column-classes="col-12 col-md-6 col-xl-4">
                            <div class="s_dynamic_snippet_container container-fluid">
                                <div class="row s_nb_column_fixed">
                    
                                    <section class="s_dynamic_snippet_holder d-none px-4 placeholder-glow o_colored_level">
                                        <div class="row">
                                            <span class="placeholder col-3 rounded"/>
                                            <span class="placeholder col-2 offset-7 rounded"/>
                                            <span class="placeholder mt-3 col-6 rounded"/>
                                        </div>
                                        <div class="row mt-4">
                                            <span class="placeholder col-12 rounded" style="height: 250px;"/>
                                        </div>
                                    </section>
                                    <section class="flex-column flex-md-row s_dynamic_snippet_title oe_unremovable oe_unmovable mb-lg-0 pb-3 pb-md-0 s_col_no_resize o_colored_level d-none">
                                        <div>
                                            <h2>Schedule a Visit</h2>
                                            <p class="lead">Browse open slots and reserve your appointment easily.</p>
                                        </div>
                                        <div>
                            &amp;nbsp;<br/></div>
                                    </section>
                                    <section class="s_dynamic_snippet_content oe_unremovable oe_unmovable o_not_editable col s_col_no_resize o_colored_level">
                                        <div class="css_non_editable_mode_hidden">
                                            <div class="missing_option_warning alert alert-info fade show d-none d-print-none rounded-0">
                                Your Dynamic Snippet will be displayed here... This message is displayed because you did not provide enough options to retrieve its content.<br/>
                                            </div>
                                        </div>
                                        <div class="dynamic_snippet_template"/>
                                    </section>
                                </div>
                            </div>
                        </section><section class="s_cta_centered pt80 pb80 o_colored_level s_custom_snippet" data-snippet="s_cta_centered" data-name="Custom Centered Call to Action">
                            <div class="container">
                                <div class="s_card card border-0 o_cc o_colored_level rounded o_cc2 o_animate o_anim_fade_in o_visible" data-snippet="s_card" data-vxml="001" data-name="Card" style="--card-spacer-x: 64px; --card-spacer-y: 64px; --box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; animation-name: dummy;"><a class="stretched-link o_translate_inline" href="/contactus"/>
                                    <div class="card-body">
                                        <h2 class="card-title" style="text-align: center;">Ready to capture <em>your story</em> together?</h2><div style="text-align: center;"><p class="lead"/><p>I’d love to hear from you</p></div>
                                        <p style="text-align: center;">
                                            <a class="o_translate_inline btn btn-lg btn-primary" href="/contactus">Contact me</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section></div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_services" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_services"/>
            <field name="url">/services</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
