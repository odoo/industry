<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_portfolio" model="ir.ui.view">
        <field name="name">Portfolio</field>
        <field name="key">photography.page_portfolio</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <t t-name="photography.page_portfolio">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title_split o_colored_level pt136 pb40" data-snippet="s_title_split" data-name="Title Split">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-6 o_colored_level o_animate o_visible o_anim_fade_in" style="animation-name: dummy;">
                                        <h1 class="display-3-fs">Family souvenirs</h1>
                                    </div>
                                    <div class="col-lg-5 offset-lg-1 o_colored_level pt24 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p>Preserving the heartbeat of your home through timeless imagery. This collection celebrates the laughter, the quiet moments, and the unique bonds that make your family's story worth telling for generations.<br />
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="s_image_gallery pb24 o_image_popup o_colored_level o_spc-medium o_masonry pt0" data-vcss="002" data-columns="2" style="overflow: hidden;" data-snippet="s_images_wall" data-name="Images Wall">
                            <div class="container-fluid">
                                <div class="row s_nb_column_fixed">
                                    <div class="o_masonry_col o_snippet_not_selectable col-lg-6">
                                        <img src="/web/image/photography.img_custom_image_12" alt="Family picture" class="img img-fluid o_we_custom_image d-block mh-100 mw-100 mx-auto object-fit-cover o_editable_media rounded o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="1818" data-mimetype="image/webp" data-index="0" loading="eager" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; animation-name: dummy;" />
                                        <img src="/web/image/photography.img_custom_image_02" alt="Family picture" class="img img-fluid o_we_custom_image d-block mh-100 mw-100 mx-auto object-fit-cover o_editable_media rounded o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="1527" data-mimetype="image/webp" data-index="2" loading="eager" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; animation-name: dummy;" />
                                        <img src="/web/image/photography.img_custom_image_03" alt="Family picture" class="img img-fluid o_we_custom_image d-block mh-100 mw-100 mx-auto object-fit-cover o_editable_media rounded o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="1818" data-mimetype="image/webp" data-index="4" loading="eager" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; animation-name: dummy;" />
                                    </div>
                                    <div class="o_masonry_col o_snippet_not_selectable col-lg-6">
                                        <img src="/web/image/photography.img_custom_image_13" alt="Family picture" class="img img-fluid o_we_custom_image d-block mh-100 mw-100 mx-auto object-fit-cover o_editable_media rounded o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="1818" data-mimetype="image/webp" data-index="1" loading="eager" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; animation-name: dummy;" />
                                        <img src="/web/image/photography.img_custom_image_01" alt="Family picture" class="img img-fluid o_we_custom_image d-block mh-100 mw-100 mx-auto object-fit-cover o_editable_media rounded o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="1280" data-mimetype="image/webp" data-index="3" loading="eager" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; animation-name: dummy;" />
                                        <img src="/web/image/photography.img_custom_image_14" alt="Family picture" class="img img-fluid o_we_custom_image d-block mh-100 mw-100 mx-auto object-fit-cover o_editable_media rounded o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="1818" data-mimetype="image/webp" data-index="5" loading="eager" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; animation-name: dummy;" />
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="s_cta_centered pt80 pb80 o_colored_level" data-snippet="s_cta_centered" data-name="Centered Call to Action">
                            <div class="container">
                                <div class="s_card card border-0 o_cc o_colored_level rounded o_cc2 o_animate o_anim_fade_in o_visible" data-snippet="s_card" data-vxml="001" data-name="Card" style="--card-spacer-x: 64px; --card-spacer-y: 64px; --box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; animation-name: dummy;">
                                    <a class="stretched-link" href="/contactus" />
                                    <div class="card-body">
                                        <h2 class="card-title" style="text-align: center;">Ready to capture <em>your story</em> together?</h2>
                                        <div style="text-align: center;">
                                            <p class="lead" />
                                            <p>I’d love to hear from you</p>
                                        </div>
                                        <p style="text-align: center;">
                                            <a class="o_translate_inline btn btn-lg btn-primary" href="/contactus">Contact me</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <data noupdate="1">
        <record id="page_portfolio" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_portfolio" />
            <field name="url">/portfolio</field>
            <field name="website_id" ref="website_industry" />
            <field name="is_published" eval="True" />
            <field name="website_indexed" eval="True" />
        </record>
    </data>
</odoo>
