<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_about" model="ir.ui.view">
        <field name="name">About</field>
        <field name="key">photography.page_about</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="photography.page_about">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title_split o_colored_level pt136 pb40 s_custom_snippet" data-snippet="s_title_split" data-name="Custom Title Split">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-6 o_colored_level o_animate o_visible o_anim_fade_in" style="animation-name: dummy;">
                                        <h1 class="display-3-fs">My story</h1>
                                    </div>
                                    <div class="col-lg-5 offset-lg-1 o_colored_level pt24 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p>I'm a dedicated&amp;nbsp;<strong>lifestyle photographer</strong>&amp;nbsp;specializing in capturing authentic family moments with heart and artistry. Drawing on a unique background&amp;nbsp;<strong>from Tokyo to Boston</strong>, I focus on natural, candid interactions that reflect the true spirit of your loved ones.</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="s_parallax parallax s_parallax_is_fixed pt48 pb48 o_colored_level o_three_quarter_height" data-scroll-background-ratio="3" data-snippet="s_parallax" data-name="Parallax">
                            <span class="s_parallax_bg_wrap">
                                <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/photography.img_custom_image_04&quot;); background-position: 50% 75%;" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp" />
                            </span>
                            <div class="o_we_bg_filter bg-black-25" />
                            <div class="oe_structure oe_empty" />
                        </section>

                        <section class="s_text_bold pt112 o_colored_level pb80" data-snippet="s_text_bold" data-name="Text Bold">
                            <div class="container s_allow_columns">
                                <h2 style="text-align: center;">
                                    <span class="o_animated_text o_animate o_anim_fade_in o_visible">Dedicated to capturing the <em>authentic beauty</em> of your family's story with heart, artistry, and a global perspective.</span>
                                </h2>
                            </div>
                        </section>

                        <section class="s_key_benefits o_colored_level pt0 pb88" data-snippet="s_key_benefits" data-name="Key benefits">
                            <div class="container">
                                <div class="row">
                                    <div class="pb24 o_colored_level pt24 col-lg-12 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <span class="display-3-fs " style="color: rgba(0, 0, 0, 0.17);">01</span>
                                        <div class="s_hr pt8 pb24" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" />
                                        </div>
                                        <h3 class="h4-fs">Patience</h3>
                                        <p>The decisive moment rarely announce itself. I arrive early, stay late and resist the impulse to manufacture what should emerge naturally.</p>
                                    </div>
                                    <div class="pb24 o_colored_level pt24 col-lg-12 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <span class="display-3-fs " style="color: rgba(0, 0, 0, 0.17);">02</span>
                                        <div class="s_hr pt8 pb24" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" />
                                        </div>
                                        <h3 class="h4-fs">Restraint</h3>
                                        <p>Editing means removing what distracts rather than adding what impresses. The subject should outlast the technique.</p>
                                    </div>
                                    <div class="pb24 o_colored_level pt24 col-lg-12 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <span class="display-3-fs " style="color: rgba(0, 0, 0, 0.17);">03</span>
                                        <div class="s_hr pt8 pb24" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" />
                                        </div>
                                        <h3 class="h4-fs">Collaboration</h3>
                                        <p>The best images come from genuine trust. I invest in knowing you before I pick up the camera.</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="s_references_social o_cc o_colored_level o_cc1 pt88 pb16" data-snippet="s_references_social" data-name="References Social" style="background-color: rgb(247, 247, 247);">
                            <div class="container">
                                <h2 style="text-align: center;">
                                    <span class="h3-fs">
                                        <span class="o_animated_text o_animate o_anim_fade_in o_visible">As featured in</span>
                                    </span>
                                </h2>
                                <div class="row">
                                    <div class="col-6 col-lg-3 pt16 pb16 o_colored_level">
                                        <img src="/web/image/photography.img_custom_image_08" alt="logo" class="img img-fluid mx-auto o_we_custom_image o_attachment_pending_record_id o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="424" data-mimetype="image/webp" loading="eager" style="animation-name: dummy;" />
                                    </div>
                                    <div class="col-6 col-lg-3 pt16 pb16 o_colored_level">
                                        <img src="/web/image/photography.img_custom_image_09" alt="logo" class="img img-fluid mx-auto o_we_custom_image o_attachment_pending_record_id o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="424" data-mimetype="image/webp" loading="eager" style="animation-name: dummy;" />
                                    </div>
                                    <div class="col-6 col-lg-3 pt16 pb16 o_colored_level">
                                        <img src="/web/image/photography.img_custom_image_10" alt="logo" class="img img-fluid mx-auto o_we_custom_image o_attachment_pending_record_id o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="424" data-mimetype="image/webp" loading="eager" style="animation-name: dummy;" />
                                    </div>
                                    <div class="col-6 col-lg-3 pt16 pb16 o_colored_level">
                                        <img src="/web/image/photography.img_custom_image_11" alt="logo" class="img img-fluid mx-auto o_we_custom_image o_attachment_pending_record_id o_animate o_anim_fade_in o_visible" data-format-mimetype="image/webp" data-resize-width="424" data-mimetype="image/webp" loading="eager" style="animation-name: dummy;" />
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="s_cta_centered pt80 pb80 o_colored_level s_custom_snippet" data-snippet="s_cta_centered" data-name="Custom Centered Call to Action">
                            <div class="container">
                                <div class="s_card card border-0 o_cc o_colored_level rounded o_cc2 o_animate o_anim_fade_in o_visible" data-snippet="s_card" data-vxml="001" data-name="Card" style="--card-spacer-x: 64px; --card-spacer-y: 64px; --box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; animation-name: dummy;">
                                    <a class="stretched-link o_translate_inline" href="/contactus" />
                                    <div class="card-body">
                                        <h2 class="card-title" style="text-align: center;">Ready to capture <em>your story</em> together?</h2>
                                        <div style="text-align: center;">
                                            <p class="lead" />
                                            <p>I’d love to hear from you</p>
                                        </div>
                                        <p style="text-align: center;">
                                            <a class="o_translate_inline btn btn-lg btn-primary" href="/contactus">Contact me</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <data noupdate="1">
        <record id="page_about" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_about"/>
            <field name="url">/about</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
