<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Appointment types (behind website "Book" buttons) -->
    <record id="appointment_type_lifestyle" model="appointment.type">
        <field name="name">Lifestyle family sessions</field>
        <field name="location_id" ref="base.main_partner"/>
        <field name="staff_user_ids" eval="[(4, ref('base.user_admin'))]" />
        <field name="image_1920" type="bytes" file="photography/static/src/img/content/website/website-image-14.webp" />
        <field name="appointment_duration" eval="1.5" />
        <field name="category">recurring</field>
        <field name="schedule_based_on">users</field>
        <field name="assignment_method">auto</field>
        <field name="min_schedule_hours" eval="72.0" />
        <field name="max_schedule_days" eval="90" />
        <field name="min_cancellation_hours" eval="72.0" />
        <field name="is_published" eval="True" />
    </record>
    <record id="appointment_type_milestone_custom" model="appointment.type">
        <field name="name">Milestone and growth packages</field>
        <field name="location_id" ref="base.main_partner"/>
        <field name="staff_user_ids" eval="[(4, ref('base.user_admin'))]" />
        <field name="image_1920" type="bytes" file="photography/static/src/img/content/website/website-image-12.webp" />
        <field name="appointment_duration" eval="2.0" />
        <field name="category">recurring</field>
        <field name="schedule_based_on">users</field>
        <field name="assignment_method">manual</field>
        <field name="min_schedule_hours" eval="1.0" />
        <field name="max_schedule_days" eval="15" />
        <field name="min_cancellation_hours" eval="1.0" />
        <field name="is_published" eval="True" />
        <field name="has_payment_step" eval="True"/>
        <field name="product_id" ref="product_product_10"/>
    </record>
    <record id="appointment_type_extended_custom" model="appointment.type">
        <field name="name">Extended family and generational portraits</field>
