#. module: photography
#: model:mail.template,body_html:photography.email_template_wedding_event_quote
#, fuzzy
msgid ""
"<p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Dear <t t-"
"out=\"object.partner_id.name or '''John Doe'''\"/>,</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;"
"\">Congratulations on your\n"
"                    engagement! We're thrilled you're considering <t t-"
"out=\"object.company_id.name or '''us'''\">Frozen Moments</t> to capture "
"the\n"
"                    magic of your wedding day..</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">We "
"would be honored to be part of\n"
"                    this significant\n"
"                    chapter in your lives.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">If "
"you have any questions or\n"
"                    require further customization, please don't hesitate to "
"reach out to us.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Best "
"wishes,</p>\n"
"            \n"
"        "
msgstr ""
"<p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Spoštovani <t t-"
"out=\"object.partner_id.name or '''John Doe'''\"/>,</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">"
"Čestitamo ob zaroki! Zelo smo veseli, da razmišljate o <t t-"
"out=\"object.company_id.name or '''us'''\">Frozen Moments</t>, da bi ujel "
"čarobnost vašega poročnega dne..</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">V "
"čast bi nam bilo, da bi bili del\n"
"                    tega pomembnega\n"
"                    poglavja v vajinem življenju.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Če "
"imate kakršna koli vprašanja ali\n"
"                    potrebujete dodatno prilagoditev, se brez obotavljanja "
"obrnite na nas.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Vse "
"najboljše,</p>\n"
"            \n"
"        "

#. module: photography
#: model:mail.template,body_html:photography.email_template_pro_event_quote
#, fuzzy
msgid ""
"<p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Dear <t t-"
"out=\"object.partner_id.name or '''John Doe'''\"/>,</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">I "
"hope this email finds you well.\n"
"                    Thank you for considering <t t-"
"out=\"object.company_id.name or '''Frozen Moments'''\"/>\n"
"                    for your upcoming event.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">We "
"would be honoured to capture\n"
"                    the special moments of your event and provide high-"
"quality photographs that you can\n"
"                    cherish for years to come.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">If "
"you have any questions or\n"
"                    require further customization, please don't hesitate to "
"reach out to us.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Best "
"regards,</p>\n"
"            \n"
"        "
msgstr ""
"<p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Spoštovani <t t-"
"out=\"object.partner_id.name or '''John Doe'''\"/>,</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">"
"Upam, da ste dobro.\n"
"                    Hvala, ker ste razmislili o <t t-"
"out=\"object.company_id.name or '''Frozen Moments'''\"/>\n"
"                    pri načrtovanju svojega prihajajočega dogodka.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">V "
"čast nam bo, da bomo ujeli\n"
"                    posebne trenutke vašega dogodka in vam zagotovili "
"visokokakovostne fotografije, ki jih boste lahko\n"
"                    cenili še vrsto let.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Če "
"imate kakršna koli vprašanja ali\n"
"                    potrebujete dodatne prilagoditve, se obrnite na nas brez "
"zadržkov.</p>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Lep "
"pozdrav,</p>\n"
"            \n"
"        "

