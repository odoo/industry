<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom Bike - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">
            © <span>offtrack, 2026</span></span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom Bike - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-right-width: 0px;">
                    <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                        <div spellcheck="false" data-gramm="false" class="container">
                            <div class="row">
                                <div class="pt24 pb24 o_colored_level col-lg-5">
                                    <h2 class="h3-fs"><img src="/web/image/bike_shop.img_bike_shop_image_29" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="width: 46% !important;" loading="lazy" role="presentation"/></h2><p><br/>Rue de la Chaîne 33<br/>1000 Brussels</p>
                                    <div class="s_social_media o_not_editable no_icon_color text-start" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="fa fa-facebook o_editable_media fa-stack"/>
                                        </a>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank" aria-label="‌​​‌⁣⁠︁‍‍⁢⁢⁡⁠⁡‍⁢‎⁡⁤⁢‏⁡⁠‍‍‍︂‍​‍‍‏⁤⁡︄⁢‎⁢‏⁡‌⁡⁢⁢‍⁡Instagram">
                                            <i class="fa o_editable_media fa-instagram"/>
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                            <i class="fa o_editable_media fa-stack fa-linkedin"/>
                                        </a>
                                    </div>
                                </div><div class="col-lg-2 pt24 pb24 o_colored_level col-12">
                                    <p style="text-align: start;" class="small"><span class="o_rfs" style="font-size: clamp(8px, 1em - 0.1389vw, 400px); color: rgb(99, 99, 99);"><strong>&amp;nbsp;SHOP</strong></span><br/></p><p style="text-align: start;"><a href="/shop/category/*road*" class="o_translate_inline">Road Bike</a></p><p style="text-align: start;"><a href="/shop/category/*vtt*" class="o_translate_inline">Mountain Bike</a></p><p style="text-align: start;"><a href="/shop/category/*electric*" class="o_translate_inline">Electric Bike</a></p><p style="text-align: start;"><a href="/shop/category/*cargo*" class="o_translate_inline">Cargo Bike</a></p><p style="text-align: start;"><a href="/shop/category/*accessories*" class="o_translate_inline">Accessoires&amp;nbsp;</a></p><p style="text-align: start;"><a href="/shop" class="o_translate_inline">See all products</a></p>
                                </div><div class="col-lg-2 pt24 pb24 o_colored_level">
                                    <p style="text-align: start;" class="small"><span class="o_rfs" style="font-size: clamp(8px, 1em - 0.1389vw, 400px); color: rgb(99, 99, 99);"><strong>SERVICES</strong></span></p><p style="text-align: start;"><a href="/maintenance-repairs" class="o_translate_inline">Maintenance &amp;amp; Repairs</a></p><p style="text-align: start;"><a href="/appointment/*bike-testing*" class="o_translate_inline">Free Test Rides</a></p><p style="text-align: start;"><a href="/helpdesk/*warranties-after-sales-sav*" class="o_translate_inline">Warranty &amp;amp; Support</a></p><p style="text-align: start;" class="small"><br/></p>
                                </div><div class="col-lg-2 pt24 pb24 o_colored_level">
                                    <p style="text-align: start;" class="small"><span class="o_rfs" style="font-size: clamp(8px, 1em - 0.1389vw, 400px); color: rgb(99, 99, 99);"><strong>ABOUT</strong></span></p><p style="text-align: start;"><a href="/about#We-didn't-open-our-doors-just-to-sell-bikes.-We-opened-them-to-share-a-passion-for-freedom%2C-fresh-air%2C-and-the-simple-joy-of-the-open-road." class="o_translate_inline">Our Story</a></p><p style="text-align: start;"><a href="/about#COME-SAY-HI%2C-YOUR-BIKE-WILL-THANK-YOU." class="o_translate_inline">Visit the shop</a></p><p style="text-align: start;"><a href="/contactus" class="o_translate_inline">Contact</a></p><p style="text-align: start;" class="small"><br/></p>
                                </div>


                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('bike_shop.website_industry').id).viewref('bike_shop.footer_custom').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('bike_shop.footer_custom').arch.replace(
                '*bike-testing*', str(obj().env.ref('bike_shop.appointment_type_1').id)).replace(
                '*vtt*', str(obj().env.ref('bike_shop.product_public_category_1').id)).replace(
                '*road*', str(obj().env.ref('bike_shop.product_public_category_2').id)).replace(
                '*electric*', str(obj().env.ref('bike_shop.product_public_category_4').id)).replace(
                '*cargo*', str(obj().env.ref('bike_shop.product_public_category_7').id)).replace(
                '*accessories*', str(obj().env.ref('bike_shop.product_public_category_5').id)).replace(
                '*warranties-after-sales-sav*', str(obj().env.ref('bike_shop.helpdesk_team_1').id)
            )}"/>
    </function>

    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom Bike - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container" spellcheck="false" data-gramm="false">
                                <a href="/appointment/*bike-testing*" class="oe_unremovable btn btn-primary"><img src="/web/image/bike_shop.img_bike_shop_image_30" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="padding-bottom: 3px; padding-right: 3px;"/>&amp;nbsp; Book a free&amp;nbsp;ride</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('bike_shop.website_industry').id).viewref('bike_shop.header_call_to_action').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('bike_shop.header_call_to_action').arch.replace(
                '*bike-testing*', str(obj().env.ref('bike_shop.appointment_type_1').id)
            )}"/>
    </function>
</odoo>
