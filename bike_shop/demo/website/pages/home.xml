    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('bike_shop.website_industry').id).viewref('bike_shop.view_page_home').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('bike_shop.view_page_home').arch.replace(
                '*bike-testing*', str(obj().env.ref('bike_shop.appointment_type_1').id)).replace(
                '*bike-category*', str(obj().env.ref('bike_shop.product_public_category_bike').id)).replace(
                '*vtt*', str(obj().env.ref('bike_shop.product_public_category_1').id)).replace(
                '*road*', str(obj().env.ref('bike_shop.product_public_category_2').id)).replace(
                '*electric*', str(obj().env.ref('bike_shop.product_public_category_4').id)).replace(
                '*accessories*', str(obj().env.ref('bike_shop.product_public_category_5').id)).replace(
                '*warranties-after-sales-sav*', str(obj().env.ref('bike_shop.helpdesk_team_1').id)).replace(
                '*newest-products*', str(obj().env.ref('website_sale.dynamic_filter_newest_products').id)
            )}"/>
    </function>

    <data noupdate="1">
        <record id="page_home" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_home"/>
