<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">bike_shop.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="bike_shop.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{ 'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', ''), }" />
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values" />
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_form_aside o_colored_level pt96 pb64" data-snippet="s_form_aside" data-name="Form Aside" style="position: relative;">

                            <div class="container" spellcheck="false" data-gramm="false">
                                <div class="row">
                                    <div class="col-12 col-lg-6 order-lg-0 o_colored_level" style="order: 1;">
                                        <h1 class="h2-fs">GET IN TOUCH</h1>
                                        <p class="lead">
                                            Question about an order, a repair, or just want advice on your next bike? Reach out, we're happy to help.&amp;nbsp;</p>
                                        <p class="lead">
                                            <br />
                                        </p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Formulaire">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-lg-6 s_website_form_custom s_website_form_required" data-type="char">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact1">
                                                                <span class="s_website_form_label_content">Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact1" type="text" placeholder="John Doe" class="form-control s_website_form_input" name="name" required="" data-fill-with="name" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-lg-6 s_website_form_custom" data-type="char">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact2">
                                                                <span class="s_website_form_label_content">Phone number</span>
                                                            </label>
                                                            <input id="contact2" type="tel" placeholder="+1 555-555-5556" class="form-control s_website_form_input" name="phone" data-fill-with="phone" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-lg-6 s_website_form_required s_website_form_model_required" data-type="email">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact3">
                                                                <span class="s_website_form_label_content">E-mail</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact3" type="email" placeholder="example@mail.com" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-lg-6 s_website_form_custom" data-type="char">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact4">
                                                                <span class="s_website_form_label_content">Company</span>
                                                            </label>
                                                            <input id="contact4" type="text" placeholder="ACME Corp" class="form-control s_website_form_input" name="company" data-fill-with="parent_name" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required s_website_form_model_required" data-type="char">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact5">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact5" type="text" placeholder="Décrivez votre demande" class="form-control s_website_form_input" name="subject" required="" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="text">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact6">
                                                                <span class="s_website_form_label_content">Message</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea id="contact6" placeholder="Écrivez votre message" class="form-control s_website_form_input" name="description" required="" rows="6" />
                                                            <span class="s_website_form_field_description small form-text text-muted">We respond within 1 to 2 business days</span>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="contact7">
                                                                    <span class="s_website_form_label_content">Email to</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input id="contact7" type="hidden" class="form-control s_website_form_input" name="email_to" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label" />
                                                            <span id="s_website_form_result" />
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send" data-lt-tmp-id="lt-263335" spellcheck="false" data-gramm="false">Send message</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="col-12 col-lg-5 offset-lg-1 pt0 pb32 order-lg-0 o_colored_level d-lg-none o_snippet_desktop_invisible" style="order: 0;" data-invisible="1">
                                        <img src="/web/image/bike_shop.img_bike_shop_image_33" alt="" data-attachment-id="1323" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-original-id="1323" data-original-src="/web/image/bike_shop.img_bike_shop_image_20" data-mimetype-before-conversion="image/jpeg" data-mimetype="image/webp" data-aspect-ratio="16/9" data-width="1280" data-height="720" data-scale-x="1" data-scale-y="1" loading="lazy" data-y="600" />
                                    </div>
                                    <div class="col-12 col-lg-5 pt0 pb32 order-lg-0 o_colored_level d-lg-block d-none o_snippet_mobile_invisible" style="order: 1;" data-invisible="1">
                                        <img src="/web/image/bike_shop.img_bike_shop_image_20" alt="" data-attachment-id="1323" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-original-id="1323" data-original-src="/web/image/bike_shop.img_bike_shop_image_20" data-mimetype-before-conversion="image/jpeg" data-mimetype="image/webp" data-aspect-ratio="0/0" data-width="1280" data-height="1622.9711538461538" data-scale-x="1" data-scale-y="1" loading="lazy" />
                                    </div>
                                </div>
                            </div>
                        </section>
                        <div class="s_hr pt32 pb32 o_colored_level" data-snippet="s_hr" data-name="Séparateur">
                            <hr class="w-100 mx-auto" />
                        </div>
                        <section class="s_title pt40 pb40 o_colored_level" data-vcss="001" data-snippet="s_title" data-name="Titre">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="o_colored_level col-lg-8">
                                        <h2>COME SAY HI, YOUR BIKE WILL THANK YOU.</h2>
                                        <p class="lead">Nothing beats a proper fitting, a hands-on repair, or just talking bikes over a coffee. Our Brussels workshop is open all week.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_accordion_image pb120 o_colored_level o_cc o_cc1 pt0" data-snippet="s_accordion_image" data-name="Accordion Image">
                            <div class="container" spellcheck="false" data-gramm="false">
                                <div class="row align-items-start">
                                    <div class="col-lg-7 pt16 o_colored_level">
                                        <section class="s_map pt248 o_not_editable rounded-0 pb176" data-map-type="m" data-snippet="s_map" data-map-address="Brussels" data-name="Map" data-vxml="001" data-map-zoom="14">
                                            <div class="map_container">
                                                <div class="css_non_editable_mode_hidden">
                                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                        An address must be specified for a map to be embedded
                                                    </div>
                                                </div>
                                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=Brussels&amp;t=m&amp;z=14&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Carte" />
                                                <div class="s_map_color_filter" />
                                            </div>
                                        </section>
                                    </div>
                                    <div class="col-lg-4 offset-lg-1 pt24 o_colored_level">
                                        <p><img src="/web/image/bike_shop.img_bike_shop_image_16" alt="" class="img-fluid img o_we_custom_image o_attachment_pending_record_id" style="padding-bottom: 3px;" loading="lazy" />&amp;nbsp;&amp;nbsp;<strong>ADDRESS<br /></strong>Rue de la Chaine 33, 1000 Brussels</p>
                                        <div class="s_hr o_colored_level pt0 pb16" data-snippet="s_hr" data-name="Séparateur">
                                            <hr class="w-100 mx-auto" />
                                        </div>
                                        <p><img src="/web/image/bike_shop.img_bike_shop_image_18" alt="" class="img-fluid img o_we_custom_image o_attachment_pending_record_id" style="padding-bottom: 3px;" loading="lazy" />&amp;nbsp;&amp;nbsp;<strong>PHONE<br /></strong>+32 470 12 34 56</p>
                                        <div class="s_hr pt0 pb16" data-snippet="s_hr" data-name="Séparateur">
                                            <hr class="w-100 mx-auto" />
                                        </div>
                                        <p><img src="/web/image/bike_shop.img_bike_shop_image_19" alt="" class="img-fluid img o_we_custom_image o_attachment_pending_record_id" style="padding-bottom: 3px;" loading="lazy" />&amp;nbsp;&amp;nbsp;<strong>EMAIL<br /></strong><a href="mailto:hello@offtrack.be" class="o_translate_inline">hello@offtrack.be</a></p>
                                        <div class="s_hr pt0 pb16" data-snippet="s_hr" data-name="Séparateur">
                                            <hr class="w-100 mx-auto" />
                                        </div>
                                        <p><img src="/web/image/bike_shop.img_bike_shop_image_17" alt="" class="img-fluid img o_we_custom_image o_attachment_pending_record_id" style="padding-bottom: 3px;" loading="lazy" />&amp;nbsp;&amp;nbsp;<strong>HOURS</strong><br />Mon–Sat, 10:00–18:00</p>
                                        <p>
                                            <br />
                                        </p>
                                        <p>
                                            <a href="https://www.google.com/maps" class="o_translate_inline btn btn-primary">Get directions</a>
                                        </p>

                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus" />
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry" />
            <field name="is_published" eval="True" />
            <field name="website_indexed" eval="True" />
        </record>
    </data>
</odoo>
