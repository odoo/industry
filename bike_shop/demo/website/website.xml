<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Create the demo website with a lower sequence than the one created by Odoo -->
    <record id="website_industry" model="website">
        <field name="name">Off Track</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="user_id" ref="base.public_user"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="show_line_subtotals_tax_selection">tax_included</field>
        <field name="cart_recovery_mail_template_id" eval="False"/>
        <!-- Shop product cards design, as configured in the website builder -->
        <field name="shop_gap">24px</field>
        <field name="shop_opt_products_design_classes">o_wsale_products_opt_design_chips o_wsale_products_opt_layout_catalog o_wsale_products_opt_thumb_6_5 o_wsale_products_opt_cc1 o_wsale_products_opt_cc o_wsale_products_opt_actions_promote o_wsale_products_opt_wishlist_inline o_wsale_products_opt_img_hover_zoom_out_light o_wsale_products_opt_img_secondary_show o_wsale_products_opt_thumb_cover o_wsale_products_opt_rounded_0 o_wsale_products_opt_has_cta o_wsale_products_opt_actions_inline</field>
        <field name="logo" type="bytes" file="bike_shop/static/src/img/content/website/logo.svg"/>
        <field name="favicon" type="bytes" file="bike_shop/static/description/favicon.png"/>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[
            ('name', '=', 'default_website'),
            ('module', '=', 'base'),
            ('model', '=', 'website')]"/>
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
</odoo>
