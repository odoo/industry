<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <function model="pos.config" name="load_onboarding_restaurant_scenario">
        <value name="with_demo_data" model="ir.module.module" eval="obj().search([('name', '=', 'takeaway_restaurant')]).demo"/>
    </function>
    <record id="pos_restaurant.pos_config_main_restaurant" model="pos.config" forcecreate="1">
        <field name="name">Restaurant</field>
        <field name="tip_product_id" eval="False"/>
        <field name="self_ordering_image_home_ids" eval="[(6, 0, [ref('ir_attachment_1318'), ref('ir_attachment_1317'), ref('ir_attachment_1316')])]"/>
        <field name="self_ordering_pay_after">each</field>
    </record>

    <function model="pos.config" name="load_onboarding_restaurant_scenario">
        <value name="with_demo_data" model="ir.module.module" eval="obj().search([('name', '=', 'takeaway_restaurant')]).demo"/>
    </function>
    <function model="ir.model.data" name="write">
        <value model="ir.model.data" search="[
            ('name', '=', 'pos_config_main_restaurant'),
            ('module', '=', 'pos_restaurant'),
            ('model', '=', 'pos.config'),
        ]"/>
        <value eval="{'module': 'takeaway_restaurant', 'name': 'pos_config_1'}"/>
    </function>
    <record id="pos_config_1" model="pos.config">
        <field name="name">Online Orders</field>
        <field name="tip_product_id" eval="False"/>
        <field name="use_presets" eval="True"/>
        <field name="default_preset_id" ref="pos_restaurant.pos_delivery_preset"/>
        <field name="available_preset_ids" eval="[(6, 0, [ref('pos_restaurant.pos_takeout_preset'), ref('pos_restaurant.pos_delivery_preset')])]"/>
        <field name="self_ordering_image_home_ids" eval="[(6, 0, [ref('ir_attachment_1279')])]"/>
        <field name="show_product_images" eval="False"/>
        <field name="show_category_images" eval="False"/>
        <field name="iface_printbill" eval="True"/>
        <field name="default_screen">register</field>
        <field name="self_ordering_mode">mobile</field>
        <field name="self_ordering_pay_after">each</field>
        <!-- The restaurant scenario above limits the config to its own Food/Drinks
        categories: sell the module's menu instead, the website links to it. -->
        <field name="limit_categories" eval="True"/>
        <field name="iface_available_categ_ids" eval="[(6, 0, [
            ref('pos_category_6'),
            ref('pos_category_8'),
            ref('pos_category_11'),
            ref('pos_category_9'),
            ref('pos_category_7'),
        ])]"/>
    </record>
</odoo>
