#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Inventory App</b>:</strong> Track ingredient usage in real-time "
"to prevent stockouts and minimize food waste."
msgstr ""
"<strong><b>Varastointi-sovellus</b>:</strong> Seuraa ainesosien käyttöä "
"reaaliajassa estääksesi varastojen tyhjenemisen ja minimoidaksesi "
"ruokahävikin."

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Invoicing App</b>:</strong> Simplify your financial management by "
"automatically tracking revenue from all sales channels.<br/>"
msgstr ""
"<strong><b>Laskutus-sovellus</b>:</strong> Yksinkertaista taloushallintoasi "
"seuraamalla automaattisesti kaikkien myyntikanavien tuloja.<br/>"

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>POS Preparation Display</b>:</strong> Replace paper tickets with "
"a digital Kitchen Display System to manage order flow and preparation times "
"efficiently.<br/>"
msgstr ""
"<strong><b>Kassajärjestelmän valmistusnäyttö</b>:</strong> Korvaa "
"paperilipukkeet digitaalisella keittiönäyttöjärjestelmällä, jotta voit "
"hallita tilausvirtaa ja valmistusaikoja tehokkaasti.<br/>"

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
