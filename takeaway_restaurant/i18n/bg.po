#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid "<span class=\"h1-fs\">Basics</span>"
msgstr "<span class=\"h1-fs\">Основи</span>"

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Inventory App</b>:</strong> Track ingredient usage in real-time "
"to prevent stockouts and minimize food waste."
msgstr ""
"<strong><b>Приложение „Инвентар“</b>:</strong> Следете употребата на "
"съставки в реално време, за да предотвратите изчерпване на наличностите и да "
"сведете хранителните отпадъци до минимум."

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Invoicing App</b>:</strong> Simplify your financial management by "
"automatically tracking revenue from all sales channels.<br/>"
msgstr ""
"<strong><b>Приложение „Счетоводно отчитане“</b>:</strong> Опростете "
"финансовото управление чрез автоматично проследяване на приходите от всички "
"канали за продажба.<br/>"

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>POS Preparation Display</b>:</strong> Replace paper tickets with "
"a digital Kitchen Display System to manage order flow and preparation times "
"efficiently.<br/>"
msgstr ""
"<strong><b>POS дисплей за приготвяне</b>:</strong> Заменете хартиените "
"бонове с цифрова кухненска дисплейна система, за да управлявате ефективно "
"потока от поръчки и времената за приготвяне.<br/>"

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>:</strong> Register in-store orders quickly, "
"processing payments and sending tickets directly to the kitchen.<br/>"
msgstr ""
"<strong><b>Приложение „Център за продажби“</b>:</strong> Регистрирайте бързо "
"поръчките на място, обработвайте плащанията и изпращайте боновете директно в "
"кухнята.<br/>"

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Purchase App</b>:</strong> Manage supplier relationships and "
"automate reordering for essential ingredients and packaging."
msgstr ""
"<strong><b>Приложение „Покупка“</b>:</strong> Управлявайте отношенията с "
"доставчиците и автоматизирайте повторните поръчки на основни съставки и "
"опаковки."

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Website App</b>:</strong> Build an appetizing digital menu and "
"enable customers to place orders online for pickup or delivery.<br/>"
msgstr ""
"<strong><b>Приложение „Уебсайт“</b>:</strong> Изградете апетитно дигитално "
"меню и позволете на клиентите да поръчват онлайн за вземане от място или "
"доставка.<br/>"

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid "<strong><span class=\"h2-fs\">Tips for Success</span></strong>"
msgstr "<strong><span class=\"h2-fs\">Съвети за успех</span></strong>"

