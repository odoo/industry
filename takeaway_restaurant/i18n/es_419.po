#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Inventory App</b>:</strong> Track ingredient usage in real-time "
"to prevent stockouts and minimize food waste."
msgstr ""
"<strong><b>Inventario</b>:</strong>Lleva seguimiento del uso de ingredientes "
"en tiempo real para evitar que existan faltantes y reducir el desperdicio de "
"alimentos."

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Invoicing App</b>:</strong> Simplify your financial management by "
"automatically tracking revenue from all sales channels.<br/>"
msgstr ""
"<strong><b>Facturación</b>:</strong>Simplifica la gestión financiera al dar "
"seguimiento automático a los ingresos de todos los canales de venta.<br/>"

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>POS Preparation Display</b>:</strong> Replace paper tickets with "
"a digital Kitchen Display System to manage order flow and preparation times "
"efficiently.<br/>"
msgstr ""
"<strong><b>Pantalla de preparación del PdV</b>:</strong>Sustituye los "
"recibos en papel por un sistema digital de pantalla de cocina para gestionar "
"el flujo de las órdenes y los tiempos de preparación con eficiencia.<br/>"

#. module: takeaway_restaurant
