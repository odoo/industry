#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Inventory App</b>:</strong> Track ingredient usage in real-time "
"to prevent stockouts and minimize food waste."
msgstr ""
"<strong><b>Magazzino</b>:</strong> traccia l'uso degli ingredienti in tempo "
"reale per evitare l'esaurimento delle scorte e minimizzare lo spreco di cibo."

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>Invoicing App</b>:</strong> Simplify your financial management by "
"automatically tracking revenue from all sales channels.<br/>"
msgstr ""
"<strong><b>Fatturazione</b>:</strong> semplifica la gestione delle finanze "
"monitorando automaticamente le entrate da tutti i canali di vendita.<br/>"

#. module: takeaway_restaurant
#: model_terms:ir.ui.view,arch_db:takeaway_restaurant.welcome_article_body
msgid ""
"<strong><b>POS Preparation Display</b>:</strong> Replace paper tickets with "
"a digital Kitchen Display System to manage order flow and preparation times "
"efficiently.<br/>"
msgstr ""
"<strong><b>Schermo di preparazione POS</b>:</strong> sostituisci gli ordini "
"cartacei con un sistema digitale per la cucina che ti permette di gestire il "
"flusso e i tempi di preparazione degli ordini in modo efficace.<br/>"

#. module: takeaway_restaurant
