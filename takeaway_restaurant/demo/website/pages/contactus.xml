<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">takeaway_restaurant.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="takeaway_restaurant.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', ''),}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_form_aside o_colored_level pb112 pt80" data-snippet="s_form_aside" data-name="Form Aside" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/18&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#fbb438&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" style="position: relative;"><div class="o_we_shape o_html_builder_Connections_18 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F18.svg?c5=%23fbb438&quot;);"/>
                            <div class="container">
                                <div class="row">
                                    <div class="col-12 col-lg-6 order-lg-0 o_colored_level" style="order: 1;">
                                        <h1>
                                            <span class="display-4-fs"><span class="o_text_highlight o_text_highlight_freehand_1" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 3px;">Contact us</span></span>
                                        </h1>
                                        <p><br/></p>
                                        <p class="lead">
                                            Contact us about anything related to our company or services.
                                        </p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact1">
                                                                <span class="s_website_form_label_content">Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact1" type="text" placeholder="John Doe" class="form-control s_website_form_input" name="name" required="" data-fill-with="name"/>
                                                        </div>
                                                        <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact2">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input id="contact2" type="tel" placeholder="+1 555-555-5556" class="form-control s_website_form_input" name="phone" data-fill-with="phone"/>
                                                        </div>
                                                        <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required" data-type="email" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact3">
                                                                <span class="s_website_form_label_content">Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact3" type="email" placeholder="example@mail.com" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email"/>
                                                        </div>
                                                        <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact4">
                                                                <span class="s_website_form_label_content">Company</span>
                                                            </label>
                                                            <input id="contact4" type="text" placeholder="ACME Corp" class="form-control s_website_form_input" name="company" data-fill-with="parent_name"/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact5">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact5" type="text" placeholder="Describe your request" class="form-control s_website_form_input" name="subject" required=""/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required" data-type="text" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact6">
                                                                <span class="s_website_form_label_content">Message</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea id="contact6" placeholder="Write down your message" class="form-control s_website_form_input" name="description" required="" rows="6"/>
                                                            <span class="s_website_form_field_description small form-text text-muted">We typically respond within 1-2 business days.</span>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="contact7">
                                                                    <span class="s_website_form_label_content">Email To</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input id="contact7" type="hidden" class="form-control s_website_form_input" name="email_to"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"/>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send">Send Message</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="col-12 pb32 order-lg-0 o_colored_level col-lg-6 pt0 d-lg-block d-none o_snippet_mobile_invisible" style="order: 0;" data-invisible="1">
                                        <img src="/web/image/takeaway_restaurant.img_custom_takeaway_restaurant_image_13" alt="" class="img img-fluid rounded o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="800" data-mimetype="image/webp" data-aspect-ratio="0/0" data-x="29.31547619047619" data-y="69.81646825396818" data-width="693.4424603174604" data-height="640.4226190476189" data-scale-x="1" data-scale-y="1" loading="lazy"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_hours_and_place o_cc pt80 o_colored_level o_cc4 pb96" data-snippet="s_hours_and_place" data-name="Hours and Place">
                            <div class="container">
                                <h2><span class="o_text_highlight o_text_highlight_freehand_1 h1-fs text-o-color-5" style="--text-highlight-color: var(--o-color-3); --text-highlight-width: NaNpx;">Visit our shop</span></h2>
                                <p><br/></p>
                                <div class="row s_nb_column_fixed">
                                    <div class="col-lg-9 o_colored_level">
                                        <section data-map-type="m" data-map-zoom="12" data-vxml="001" class="s_map pt216 pb216 o_not_editable rounded-5" data-map-address="1234 Main Street Springfield IL 62701 United States" data-snippet="s_map" data-name="Map">
                                            <div class="map_container">
                                                <div class="css_non_editable_mode_hidden">
                                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                        An address must be specified for a map to be embedded
                                                    </div>
                                                </div>
                                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=1234%20Main%20Street%20Springfield%20IL%2062701%20United%20States&amp;t=m&amp;z=12&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                                <div class="s_map_color_filter"/>
                                            </div>
                                        </section>
                                        <div class="s_hr pb32 pt0 d-lg-none o_snippet_desktop_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                        </div>
                                    </div>
                                    <div class="o_colored_level o_cc o_cc2 col-lg-3 pb24 pt40 rounded" style="--box-border-bottom-left-radius: 32px; --box-border-bottom-right-radius: 32px; --box-border-top-right-radius: 32px; --box-border-top-left-radius: 32px;">
                                        <h3>
                                            <span class="h4-fs">Opening hours</span>
                                        </h3>
                                        <div class="s_hr pb32 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                        </div>
                                        <p class="o_small-fs"><u>Monday</u><br/>8.00am-6.00pm</p>
                                        <p class="o_small-fs"><u>Tuesday</u><br/>8.00am-6.00pm</p>
                                        <p class="o_small-fs"><u>Wednesday</u><br/>8.00am-12.00pm</p>
                                        <p class="o_small-fs"><u>Thursday</u><br/>8.00am-6.00pm</p>
                                        <p><a class="btn btn-primary o_translate_inline" href="https://www.google.com/maps/search/?api=1&amp;query=1234+Main+Street,+Springfield,+IL+62701,+United+States" target="_blank">Get directions</a></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_faq_collapse o_colored_level o_cc o_cc2 pt104 pb72" data-vcss="001" data-snippet="s_faq_collapse" data-name="FAQ Block" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/18&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#fbb438&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" style="position: relative;"><div class="o_we_shape o_html_builder_Connections_18" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F18.svg?c5=%23fbb438&amp;flip=y&quot;); background-position: 50% 0%;"/>
                            <div class="container">
                                <div class="row s_nb_column_fixed align-items-center">
                                    <div class="col-lg-4 pt16 o_colored_level">
                                        <h2>
                                            <span class="h1-fs o_text_highlight o_text_highlight_freehand_1" style="--text-highlight-color: var(--o-color-2); --text-highlight-width: 3px;">FAQ</span>
                                        </h2>
                                        <p class="lead">Here are some common questions about our company.</p>
                                        <img src="/web/image/takeaway_restaurant.img_custom_takeaway_restaurant_image_14" alt="" class="img img-fluid o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                    </div>
                                    <div class="col-lg-7 offset-lg-1 s_col_no_bgcolor" data-name="Accordion Box">
                                        <div data-name="Accordion" class="s_accordion">
                                            <div id="myCollapse" class="accordion o_custom_icons o_icons_plus_to_minus accordion-flush">
                                                <div class="accordion-item position-relative z-1 o_cc o_cc1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none collapsed justify-content-between" data-bs-toggle="collapse" aria-expanded="false" id="accordion-button481120_1" data-bs-target="#myCollapseTab481120_1" aria-controls="myCollapseTab481120_1"><span class="flex-grow-1">How long does delivery usually take?</span><span class="o_custom_icons_wrap position-relative d-block flex-shrink-0 overflow-hidden"/></button>
                                                    <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab481120_1" aria-labelledby="accordion-button481120_1">
                                                        <div class="accordion-body">
                                                            <p>Our average delivery time is between 20 to 35 minutes depending on your distance from our kitchen and current order volume.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="accordion-item position-relative z-1 o_cc o_cc1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none collapsed justify-content-between" data-bs-toggle="collapse" aria-expanded="false" id="accordion-button481120_2" data-bs-target="#myCollapseTab481120_2" aria-controls="myCollapseTab481120_2"><span class="flex-grow-1">What is the minimum order amount for delivery?</span><span class="o_custom_icons_wrap position-relative d-block flex-shrink-0 overflow-hidden"/></button>
                                                    <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab481120_2" aria-labelledby="accordion-button481120_2">
                                                        <div class="accordion-body">
                                                            <p>The minimum order for free delivery is $15. Orders under $15 incur a flat $2.99 delivery fee.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="accordion-item position-relative z-1 o_cc o_cc1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none collapsed justify-content-between" data-bs-toggle="collapse" aria-expanded="false" id="accordion-button481120_3" data-bs-target="#myCollapseTab481120_3" aria-controls="myCollapseTab481120_3"><span class="flex-grow-1">Do you cater to dietary restrictions?</span><span class="o_custom_icons_wrap position-relative d-block flex-shrink-0 overflow-hidden"/></button>
                                                    <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab481120_3" aria-labelledby="accordion-button481120_3">
                                                        <div class="accordion-body">
                                                            <p>Yes! We offer clear labels for Vegetarian, Vegan, Gluten-Free, and Nut-Free options directly on our online menu.</p>
                                                        </div>
                                                    </div>
                                                </div><div class="accordion-item position-relative z-1 o_cc o_cc1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none justify-content-between collapsed" data-bs-toggle="collapse" aria-expanded="false" id="myCollapseBtn1789045571585" data-bs-target="#myCollapseTab1789045571584" aria-controls="myCollapseTab1789045571584"><span class="flex-grow-1">What should I do if there’s an issue with my order?</span><span class="o_custom_icons_wrap position-relative d-block flex-shrink-0 overflow-hidden"/></button>
                                                    <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab1789045571584" aria-labelledby="myCollapseBtn1789045571585">
                                                        <div class="accordion-body">
                                                            <p>Call us immediately at +1 555-555-5556 with your order number, and our team will resolve it on the spot.</p>
                                                        </div>
                                                    </div>
                                                </div><div class="accordion-item position-relative z-1 o_cc o_cc1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none justify-content-between collapsed" data-bs-toggle="collapse" aria-expanded="false" id="myCollapseBtn1789047800572" data-bs-target="#myCollapseTab1789047800571" aria-controls="myCollapseTab1789047800571"><span class="flex-grow-1">Can I schedule an order in advance?</span><span class="o_custom_icons_wrap position-relative d-block flex-shrink-0 overflow-hidden"/></button>
                                                    <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab1789047800571" aria-labelledby="myCollapseBtn1789047800572">
                                                        <div class="accordion-body">
                                                            <p>Absolutely! You can select a specific time slot for pickup or delivery up to 7 days in advance during checkout.</p>
                                                        </div>
                                                    </div>
                                                </div><div class="accordion-item position-relative z-1 o_cc o_cc1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none justify-content-between" data-bs-toggle="collapse" aria-expanded="true" id="myCollapseBtn1789047800574" data-bs-target="#myCollapseTab1789047800573" aria-controls="myCollapseTab1789047800573"><span class="flex-grow-1">How can I track my delivery in real time?</span><span class="o_custom_icons_wrap position-relative d-block flex-shrink-0 overflow-hidden"/></button>
                                                    <div class="accordion-collapse collapse show" data-bs-parent="#myCollapse" role="region" id="myCollapseTab1789047800573" aria-labelledby="myCollapseBtn1789047800574">
                                                        <div class="accordion-body">
                                                            <p>Once your order is confirmed, you will receive a tracking link via SMS or email to follow your driver’s route live on the map.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
