<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom Fast Meal - Footer Copyright</field>
        <field name="inherit_id" ref="website.footer_copyright_company_name"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small text-center" t-ignore="true">
                    <span class="o_rfs text-white o_small-fs">
                        Copyright © <span t-out="res_company.name"/>
                    </span>
                </span>
            </xpath>
        </field>
    </record>
    <record id="template_footer_centered" model="ir.ui.view">
        <field name="name">Custom Fast Meal - Centered</field>
        <field name="key">website.template_footer_centered</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt96" data-snippet="s_text_block" data-name="Container" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/16&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-3&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;"><div class="o_we_shape o_html_builder_Connections_16" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F16.svg?c5=%23FFE9C2&amp;flip=y&quot;); background-position: 50% 0%;"/>
                        <div class="s_allow_columns container">
                            <div class="row">
                                <div class="col-lg-12 order-lg-0 o_colored_level" style="order: 0;">
                                    <div class="s_social_media text-center o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="#" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi rounded-empty-circle shadow-sm o_editable_media" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="#" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="oi rounded-empty-circle shadow-sm o_editable_media" data-icon="oi_x"/>
                                        </a>
                                        <a href="#" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                            <i class="oi rounded-empty-circle shadow-sm o_editable_media" data-icon="oi_linkedin"/>
                                        </a>
                                    </div>
                                    <div class="s_hr pt24 pb24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="col-lg-4 order-lg-0 o_colored_level pt32" style="order: 2;">
                                    <p style="text-align: center;">1234 Main Street <br/>Springfield, IL 62701, United States</p>
                                </div>
                                <div class="col-lg-4 order-lg-0 pb24 o_colored_level" style="order: 1;">
                                    <a href="/" class="o_footer_logo logo">
                                        <img src="/web/image/takeaway_restaurant.img_custom_takeaway_restaurant_image_16" alt="" class="img-fluid d-block mx-auto img o_we_custom_image" style="width: 34% !important;" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="col-lg-4 order-lg-0 o_colored_level pt32" style="order: 3;">
                                    <ul class="list-unstyled">
                                        <li style="text-align: center;"><a href="tel:+1 555-555-5556"><span class="o_force_ltr">+1 555-555-5556</span></a></li>
                                        <li style="text-align: center;"><a href="mailto:info@fastmeal.example.com">info@fastmeal.example.com</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
