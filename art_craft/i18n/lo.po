#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<strong> <u>Process</u> </strong>"
msgstr "<strong> <u>ຂັ້ນຕອນການດຳເນີນງານ</u> </strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid "<strong><font class=\"text-900\">What’s Inside:</font></strong>"
msgstr "<strong><font class=\"text-900\">ສິ່ງທີ່ມີຢູ່ໃນຊຸດ:</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">6 vibrant color</font>s</strong> – A "
"versatile range for creating colorful artwork and unique combinations."
msgstr ""
"<strong><font class=\"text-o-color-3\">6 ໂທນສີສົດໃສ</font></strong> – ຫຼາກຫຼາຍໂທນ"
"ສີສຳລັບການສ້າງສັນຜົນງານທີ່ສວຍງາມ ແລະ ປະສົມສີໄດ້ຢ່າງໂດດເດັ່ນ."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Base Footprint:</font></strong> <font "
"class=\"text-800\">Approximately <strong>95 cm x 75 cm</strong> when fully "
"extended for maximum stability.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ພື້ນທີ່ຖານຕັ້ງ:</font></strong> <font "
"class=\"text-800\">ປະມານ <strong>95 ຊມ x 75 ຊມ</strong> ເມື່ອກາງອອກເຕັມທີ່ ເພື່ອຄວາມ"
"ໝັ້ນຄົງສູງສຸດ.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Comprehensive Selection:</font></"
"strong> <font class=\"text-800\">Includes 11 specialized brushes—Fan, "
"Filbert, Flat, and Round—to handle everything from broad washes to the "
"finest details.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ອຸປະກອນຄົບຊຸດ:</font></strong> <font "
"class=\"text-800\">ປະກອບດ້ວຍແປງແຕ້ມຮູບສະເພາະທາງ 11 ດ້າມ—ທັງຫົວພັດ (Fan), ຫົວມົນແບນ "
"(Filbert), ຫົວແບນ (Flat), ແລະ ຫົວມົນ (Round)—ຮອງຮັບທັງການລະບາຍພື້ນທີ່ກວ້າງ ຈົນເຖິງການເກັບລ"
"າຍລະອຽດທີ່ປານີດ.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Consistent Quality:</font></"
"strong> <font style=\"color: rgb(99, 99, 99);\">Every skein is meticulously "
"dyed to ensure color consistency throughout your entire project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ຄຸນນະພາບສະໝ່ຳສະເໝີ:</font></strong> "
"<font style=\"color: rgb(99, 99, 99);\">ໄໝພົມທຸກກ້ອນຜ່ານການຍ້ອມສີຢ່າງພິຖີພິຖັນ ເພື່ອຮັບປະກັນ"
"ວ່າສີຈະສະໝ່ຳສະເໝີຕະຫຼອດທັງຜົນງານ.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Ergonomic Design:</font></"
"strong> <font class=\"text-800\">Features elegant, matte black handles that "
"offer a comfortable grip and a professional look.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ອອກແບບຕາມຫຼັກສະຣີລະສາດ:</strong> </font>"
"<font class=\"text-800\">ດ້າມຈັບສີດຳດ້ານສວຍງາມ, ຈັບສະບາຍມື ແລະ ໃຫ້ຄວາມຮູ້ສຶກເປັນມືອາຊີບ.</"
"font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Excellent Stitch Definition:</font></"
"strong> <font class=\"text-800\">The high-twist construction ensures your "
"patterns and textures stand out with professional clarity.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ເຫັນລວດລາຍຖັກຈະແຈ້ງ:</font></strong> "
"<font class=\"text-800\">ການຕີກຽວແໜ້ນຊ່ວຍໃຫ້ລວດລາຍ ແລະ ເນື້ອຜ້າທີ່ຖັກອອກມາມີຄວາມຄົມຊັດ ແລ"
"ະ ສວຍງາມແບບມືອາຊີບ.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">Great for all skill levels</font></"
"strong> – Perfect for beginners, hobby artists, students, and creative "
"enthusiasts."
msgstr ""
"<strong><font class=\"text-o-color-3\">ເໝາະສຳລັບທຸກລະດັບສີມື</font></strong> – ເໝາ"
"ະຫຼາຍສຳລັບຜູ້ເລີ່ມຕົ້ນ, ນັກຮຽນ, ນັກສຶກສາ ແລະ ຜູ້ທີ່ມັກຮັກໃນງານສິລະປະ."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Hardware:</font></strong> <font "
"class=\"text-800\">Corrosion-resistant polished brass knobs and fittings for "
"smooth height and tilt adjustments.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ອຸປະກອນປະກອບໂລຫະ:</font></strong> "
"<font class=\"text-800\">ປຸ່ມບິດ ແລະ ຂໍ້ຕໍ່ທອງເຫຼືອງຂັດເງົາກັນສະໜິມ ຊ່ວຍໃຫ້ການປັບຄວາມສູງ ແລະ ຄ"
"ວາມອຽງເປັນໄປຢ່າງສະດວກງ່າຍດາຍ.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">High-Performance Bristles:</font></"
"strong> <font class=\"text-800\">Crafted with high-quality synthetic fibers "
"that maintain their shape and provide smooth, consistent paint flow.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ຂົນແປງປະສິດທິພາບສູງ:</font></strong> "
"<font class=\"text-800\">ຜະລິດຈາກເສັ້ນໃຍສັງເຄາະຄຸນນະພາບສູງທີ່ຄົງຮູບຊົງໄດ້ດີ ແລະ ຊ່ວຍໃຫ້ລະບາຍ"
"ສີໄດ້ລຽບນຽນສະໝ່ຳສະເໝີ.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Material:</font></strong> <font "
"class=\"text-800\">Premium, sustainably sourced solid Beechwood with a "
"natural light-oil finish.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ວັດສະດຸ:</font></strong> <font "
"class=\"text-800\">ໄມ້ບີຊແທ້ຊັ້ນດີຈາກແຫຼ່ງຜະລິດທີ່ຍືນຍົງ ເຄືອບຜິວດ້ວຍນ້ຳມັນທຳມະຊາດແບບບາງເບົາ.</"
"font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Maximum Canvas Height:</font></"
"strong> <font class=\"text-800\">Accommodates canvases up to <strong>120 cm "
"(47 inches)</strong> tall.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ຮອງຮັບຄວາມສູງຜ້າໃບສູງສຸດ:</font></strong> "
"<font class=\"text-800\">ຮອງຮັບຜ້າໃບແຕ້ມຮູບໄດ້ສູງເຖິງ <strong>120 ຊມ (47 ນິ້ວ)</"
"strong>.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Perfect Weight for Folding:</font></"
"strong> <font class=\"text-800\">Specially selected paper thickness that "
"holds its shape without tearing, making it ideal for beginners and advanced "
"crafters alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ຄວາມໜາທີ່ເໝາະສົມສຳລັບການພັບ:</font></"
"strong> <font class=\"text-800\">ຄວາມໜາຂອງເຈ້ຍຖືກຄັດສັນມາເປັນພິເສດເພື່ອໃຫ້ພັບຢູ່ຊົງໄດ້ດີໂດຍບໍ່"
"ຈີກຂາດ, ເໝາະສຳລັບທັງຜູ້ເລີ່ມຕົ້ນ ແລະ ຜູ້ມີປະສົບການ.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Premium Presentation:</font></"
"strong> <font class=\"text-800\">Housed in a minimalist, white designer box "
"with a large transparent window, making it an ideal gift for professionals "
"and hobbyists alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ຮູບແບບການບັນຈຸສຸດຫຼູຫຼາ:</font></strong> "
"<font class=\"text-800\">ບັນຈຸໃນກ່ອງສີຂາວແບບມິນິມອນ ພ້ອມຊ່ອງປ່ອງໃສຂະໜາດໃຫຍ່, ເໝາະສຳລັບເປັ"
"ນຂອງຂວັນໃຫ້ແກ່ທັງມືອາຊີບ ແລະ ຜູ້ທີ່ມັກງານອະດິເຣກ.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Signature Color Palette:</font></"
"strong> <font class=\"text-800\">A harmonious blend of rich earth tones and "
"vibrant accents that complement any crochet or knitting project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ຊຸດໂທນສີເອກະລັກ:</strong> </font><font "
"class=\"text-800\">ການຜະສົມຜະສານທີ່ລົງຕົວລະຫວ່າງໂທນສີທຳມະຊາດ (Earth tones) ແລະ ສີສັນສົດ"
"ໃສ ເຂົ້າກັບທຸກງານຖັກໂຄຣເຊ ແລະ ນິດgenerated.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Stunning Geometric Patterns:</font></"
"strong> <font class=\"text-800\">From bold triangles and chevrons to modern "
"dots and stripes, each sheet is printed with vibrant, high-contrast colors "
"(teal, pink, sunny yellow, and more).</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">ລວດລາຍເລຂາຄະນິດທີ່ໂດດເດັ່ນ:</font></"
"strong> <font class=\"text-800\">ຕັ້ງແຕ່ຮູບສາມຫຼ່ຽມ ແລະ ລາຍຊິກແຊັກ ຈົນເຖິງລາຍຈຸດ ແລະ ລາຍ"
"ເສັ້ນທີ່ທັນສະໄໝ, ແຕ່ລະແຜ່ນພິມດ້ວຍສີສັນສົດໃສ ແລະ ຄົມຊັດ (ຂຽວຫົວກິດ, ບົວ, ເຫຼືອງ ແລະ ອື່ນໆ).</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid "<strong><font class=\"text-o-color-5\">Key Features:</font></strong>"
msgstr "<strong><font class=\"text-o-color-5\">ຄຸນລັກສະນະເດັ່ນ:</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid "<strong><font class=\"text-o-color-5\">What’s Inside:</font></strong>"
msgstr ""
"<strong><font class=\"text-o-color-5\">ສິ່ງທີ່ມີຢູ່ໃນຊຸດ:</font></strong>"

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid ""
"<strong>Acrylics:</strong> Learn to play with texture, layering, and thick "
"applications to bring depth to your canvas."
msgstr ""
"<strong>ສີອາຄຣີລິກ:</strong> ຮຽນຮູ້ການສ້າງເນື້ອສຳຜັດ, ການທັບຊ້ອນຊັ້ນສີ ແລະ ການປ້າຍສີແບບໜາ ເພື່ອ"
"ເພີ່ມມິຕິໃຫ້ກັບຜ້າໃບຂອງທ່ານ."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<strong>Activities</strong><span class=\"h1-fs\"> </span>"
msgstr "<strong>ກິດຈະກຳ</strong><span class=\"h1-fs\"> </span>"

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid ""
"<strong>Aquarelle (Watercolor):</strong> Master transparency, color "
"blending, and water control to create light and poetic atmospheres."
msgstr ""
"<strong>ສີນ້ຳ (Watercolor):</strong> ຮຽນຮູ້ຄວາມໂປ່ງແສງ, ການປະສົມສີ ແລະ ການຄວບຄຸມປະລິມາ"
"ນນ້ຳ ເພື່ອສ້າງບັນຍາກາດທີ່ເບົາບາງ ແລະ ສວຍງາມ."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_3
msgid ""
"<strong>Atmosphere:</strong> A calm, zen-like environment where you can work "
"at your own pace."
msgstr ""
"<strong>ບັນຍາກາດ:</strong> ບັນຍາກາດທີ່ສະຫງົບ ແລະ ຜ່ອນຄາຍ ຊ່ວຍໃຫ້ທ່ານສ້າງສັນຜົນງານໄດ້ຕາມຈັງຫ"
"ວະຂອງຕົນເອງ."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_2
msgid ""
"<strong>Booking:</strong> Limited spots available to ensure personalized "
"attention for every student"
msgstr ""
"<strong>ການຈອງ:</strong> ຮັບຈຳນວນຈຳກັດ ເພື່ອໃຫ້ສາມາດດູແລ ແລະ ໃຫ້ຄຳແນະນຳແກ່ຜູ້ຮຽນທຸກຄົນຢ່າງ"
"ທົ່ວເຖິງ"

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid ""
"<strong>Booking:</strong> Limited spots available to ensure quality guidance."
msgstr ""
"<strong>ການຈອງ:</strong> ຮັບຈຳນວນຈຳກັດ ເພື່ອຮັບປະກັນຄຸນນະພາບໃນການໃຫ້ຄຳແນະນຳ."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_3
msgid ""
"<strong>Creative Variations:</strong> Once you've mastered the basics, learn "
"how to use different paper textures and patterns to give your creations a "
"unique touch."
msgstr ""
"<strong>ການປະຍຸກໃຊ້ງານສ້າງສັນ:</strong> ເມື່ອທ່ານຮຽນຮູ້ພື້ນຖານແລ້ວ, ຈະໄດ້ຮຽນຮູ້ການນຳໃຊ້ເນື້ອເຈ້"
"ຍ ແລະ ລວດລາຍທີ່ຫຼາກຫຼາຍ ເພື່ອສ້າງເອກະລັກສະເພາະຕົວໃຫ້ກັບຜົນງານ."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<strong>Do you want to go further?</strong>"
msgstr "<strong>ຕ້ອງການຮຽນຮູ້ເພີ່ມເຕີມບໍ່?</strong>"

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid ""
"<strong>Gouache:</strong> Discover the joy of this matte, opaque paint, "
"perfect for vibrant flat colors and precise details."
msgstr ""
