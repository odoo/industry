#. module: art_craft
#: model_terms:product.template,website_description:art_craft.product_template_28
msgid "<em>The 120ml tubes are incredibly generous for an intro set.</em>"
msgstr ""
"<em>Les tubes de 120 ml sont incroyablement généreux pour un set de "
"découverte.</em>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<font class=\"text-800\"> This set features four stunning, signature colors. "
"Teal, Rust, Mustard, and Cream, inspired by our brand’s vibrant aesthetic.</"
"font>"
msgstr ""
"<font class=\"text-800\">Ce set comprend quatre magnifiques couleurs "
"emblématiques : bleu sarcelle, rouille, moutarde et crème, inspirées de "
"l'esthétique vibrante de notre marque.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-800\">Crafted from premium, sustainably sourced "
"beechwood, this easel combines elegant design with robust functionality, "
"making it an essential centerpiece for any artist's studio.</"
"font><br><br><strong><font class=\"text-black\">Key features:</font></strong>"
msgstr ""
"<font class=\"text-800\">Fabriqué en bois de hêtre haut de gamme issu de "
"sources durables, ce chevalet allie design élégant et robustesse, ce qui en "
"fait un élément essentiel de tout atelier d'artiste.</font><br><br><strong>"
"<font class=\"text-black\">Caractéristiques principales :</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-800\">Designed for aspiring artists and paper-folding "
"enthusiasts, this premium kit combines vibrant colors with intricate "
"patterns to make every creation a masterpiece.</font>"
msgstr ""
"<font class=\"text-800\">Conçu pour les artistes en herbe et les passionnés "
"de pliage de papier, ce kit haut de gamme associe des couleurs éclatantes à "
"des motifs complexes pour faire de chaque création un chef-d'œuvre.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-800\">This high-quality studio packshot showcases a "
"vibrant collection of arts and crafts supplies neatly arranged on a clean, "
"seamless white background.</font>"
msgstr ""
"<font class=\"text-800\">Cette photo de produit en studio de haute qualité "
"présente une collection colorée de fournitures d'art et de loisirs créatifs "
"soigneusement disposées sur un fond blanc uniforme.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<font class=\"text-800\">This premium collection is designed for artists who "
"demand precision, durability, and a sleek aesthetic.</"
"font><br><br><strong><font class=\"text-o-color-5\">What’s Inside:<br><br></"
"font></strong>"
msgstr ""
"<font class=\"text-800\">Cette collection haut de gamme est conçue pour les "
"artistes qui recherchent précision, durabilité et esthétique épurée.</font>"
"<br><br><strong><font class=\"text-o-color-5\">Ce qui est inclu :<br><br></"
"font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid "<font class=\"text-black\"><strong>What’s Inside:</strong></font><br>"
msgstr "<font class=\"text-black\"><strong>Contenu :</strong></font><br>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-o-color-3\"><strong>60 Premium Sheets:</strong> </"
"font><font class=\"text-800\">A generous collection of square origami papers "
"featuring a wide variety of double-sided geometric designs.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>60 feuilles haut de gamme :</strong> "
"</font><font class=\"text-800\">Une généreuse collection de feuilles carrées "
"pour origami, avec une grande variété de motifs géométriques recto verso.</"
"font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-o-color-3\"><strong>Bonus Sticker Sheet:</strong> </"
"font><font class=\"text-800\">Add personality to your origami animals and "
"shapes with the included set of fun decorative stickers.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Planche d'autocollants bonus :</"
"strong> </font><font class=\"text-800\">Personnalisez vos animaux et formes "
"en origami grâce à la planche d'autocollants décoratifs amusants incluse.</"
"font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Convenient tube packaging</strong> </"
"font>– Easy to squeeze, control, and store."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Conditionnement pratique en tubes</"
"strong> </font>– Facile à presser, à doser et à ranger."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Craft Accessories:</strong> </"
"font><font class=\"text-800\">A playful assortment of small wooden figurines "
"including pandas, owls, and fruit slices (watermelon, orange), alongside "
"colorful scattered beads and star-shaped charms.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Accessoires de loisirs créatifs :</"
"strong> </font><font class=\"text-800\">Un assortiment ludique de petites "
"figurines en bois, notamment des pandas, des hiboux et des tranches de "
"fruits (pastèque, orange), accompagnées de perles colorées et de breloques "
"en forme d'étoile.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Decorative Jars:</strong> </"
"font><font class=\"text-800\">Multiple small glass jars with classic cork "
"stoppers, filled with shimmering glitter in various colors (red, blue, "
"green, gold, purple) and tiny yellow beads.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Petits pots décoratifs :</strong> </"
"font><font class=\"text-800\">Plusieurs petits pots en verre avec des "
"bouchons classiques en liège, remplis de paillettes scintillantes de "
"différentes couleurs (rouge, bleu, vert, or, violet) et de minuscules perles "
"jaunes.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<font class=\"text-o-color-3\"><strong>Durable Build:</strong> </font><font "
"class=\"text-800\">Equipped with reinforced silver ferrules to prevent "
"shedding and ensure long-lasting performance.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Fabrication durable :</strong> </font>"
"<font class=\"text-800\">Équipés de viroles argentées renforcées pour éviter "
"la perte de poils et garantir une longue durée de vie.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Mix and match</strong> </font>– Blend "
"colors together to create custom shades and beautiful effects."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Associez et mélangez</strong> </font>"
"– Mélangez les couleurs pour créer des teintes personnalisées et de "
"magnifiques effets."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Paper &amp; Tools:</strong> </"
"font><font class=\"text-800\">A stack of beautifully patterned origami "
"papers featuring intricate floral and traditional designs, paired with a "
"pair of vintage-style ornate metal scissors.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Papier &amp; Outils :</strong> </font>"
"<font class=\"text-800\">Une pile de feuilles d'origami aux magnifiques "
"motifs floraux et traditionnels complexes, accompagnée d'une paire de "
"ciseaux en métal ornés de style vintage.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Smooth acrylic formula</strong> </"
"font>– Ideal for creating even coverage and expressive brushstrokes."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Formule acrylique onctueuse</strong> "
"</font>– Idéale pour obtenir une couverture uniforme et des coups de pinceau "
"expressifs."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-o-color-3\"><strong>Total Height:</strong> </font><font "
"class=\"text-800\">Adjustable from <strong>150 cm to 230 cm</"
"strong> depending on mast extension.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Hauteur totale :</strong> </font>"
"<font class=\"text-800\">Réglable de <strong>150 cm à 230 cm</strong> selon "
"l'extension du mât.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-o-color-3\"><strong>Type:</strong></font><font "
"class=\"text-o-color-5\"> </font><font class=\"text-800\">Classic Tripod A-"
"Frame Studio Easel.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Type :</strong></font><font "
"class=\"text-o-color-5\"> </font><font class=\"text-800\">Chevalet d'atelier "
"classique en A à trois pieds.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<font class=\"text-o-color-3\"><strong>Ultra-Soft Texture:</strong> </"
"font>S<font class=\"text-800\">pun from premium fibers to ensure a smooth, "
"snag-free experience that is gentle on your hands and luxurious to the touch."
"</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Texture ultra-douce :</strong> </font>"
"<font class=\"text-800\">Filée à partir de fibres haut de gamme pour "
"garantir une texture lisse, sans accrocs, douce pour les mains et luxueuse "
"au toucher.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
