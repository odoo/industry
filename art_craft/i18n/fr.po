#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<strong> <u>Process</u> </strong>"
msgstr "<strong> <u>Processus</u> </strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid "<strong><font class=\"text-900\">What’s Inside:</font></strong>"
msgstr "<strong><font class=\"text-900\">Contenu :</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">6 vibrant color</font>s</strong> – A "
"versatile range for creating colorful artwork and unique combinations."
msgstr ""
"<strong><font class=\"text-o-color-3\">6 couleurs éclatante</font>s</strong> "
"– Une gamme polyvalente pour créer des œuvres colorées et des associations "
"uniques."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Base Footprint:</font></strong> <font "
"class=\"text-800\">Approximately <strong>95 cm x 75 cm</strong> when fully "
"extended for maximum stability.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Emprise au sol :</font></strong> "
"<font class=\"text-800\">Environ <strong>95 cm x 75 cm</strong> une fois "
"entièrement déployé pour une stabilité maximale.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Comprehensive Selection:</font></"
"strong> <font class=\"text-800\">Includes 11 specialized brushes—Fan, "
"Filbert, Flat, and Round—to handle everything from broad washes to the "
"finest details.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Sélection complète :</font></strong> "
"<font class=\"text-800\">Comprend 11 pinceaux spécialisés — éventail, langue-"
"de-chat, plat et rond — pour réaliser aussi bien de larges aplats que les "
"détails les plus fins.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Consistent Quality:</font></"
"strong> <font style=\"color: rgb(99, 99, 99);\">Every skein is meticulously "
"dyed to ensure color consistency throughout your entire project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Qualité constante :</font></strong> "
"<font style=\"color: rgb(99, 99, 99);\">Chaque écheveau est teint avec soin "
"pour garantir une couleur uniforme tout au long de votre projet.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Ergonomic Design:</font></"
"strong> <font class=\"text-800\">Features elegant, matte black handles that "
"offer a comfortable grip and a professional look.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Conception ergonomique :</font></"
"strong> <font class=\"text-800\">Des manches élégants noir mat offrant une "
"prise en main confortable et un aspect professionnel.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Excellent Stitch Definition:</font></"
"strong> <font class=\"text-800\">The high-twist construction ensures your "
"patterns and textures stand out with professional clarity.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Excellente définition des mailles :</"
"font></strong> <font class=\"text-800\">La forte torsion du fil garantit des "
"motifs et des textures bien définis, pour un rendu professionnel.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">Great for all skill levels</font></"
"strong> – Perfect for beginners, hobby artists, students, and creative "
"enthusiasts."
msgstr ""
"<strong><font class=\"text-o-color-3\">Idéal pour tous les niveaux</font></"
"strong> – Parfait pour les débutants, les artistes amateurs, les étudiants "
"et les passionnés de loisirs créatifs."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Hardware:</font></strong> <font "
"class=\"text-800\">Corrosion-resistant polished brass knobs and fittings for "
"smooth height and tilt adjustments.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Quincaillerie :</font></strong> <font "
"class=\"text-800\">Boutons et fixations en laiton poli résistant à la "
"corrosion pour régler facilement la hauteur et l'inclinaison.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">High-Performance Bristles:</font></"
"strong> <font class=\"text-800\">Crafted with high-quality synthetic fibers "
"that maintain their shape and provide smooth, consistent paint flow.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Poils haute performance :</font></"
"strong> <font class=\"text-800\">Fabriqués à partir de fibres synthétiques "
"de haute qualité qui conservent leur forme et assurent une application "
"fluide et régulière de la peinture.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Material:</font></strong> <font "
"class=\"text-800\">Premium, sustainably sourced solid Beechwood with a "
"natural light-oil finish.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Matériau :</font></strong> <font "
"class=\"text-800\">Bois de hêtre massif haut de gamme issu de sources "
"durables, avec une finition naturelle à l'huile légère.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Maximum Canvas Height:</font></"
"strong> <font class=\"text-800\">Accommodates canvases up to <strong>120 cm "
"(47 inches)</strong> tall.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Hauteur maximale de la toile :</font>"
"</strong> <font class=\"text-800\">Accueille des toiles mesurant jusqu'à "
"<strong>120 cm (47 pouces)</strong> de hauteur.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Perfect Weight for Folding:</font></"
"strong> <font class=\"text-800\">Specially selected paper thickness that "
"holds its shape without tearing, making it ideal for beginners and advanced "
"crafters alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Grammage idéal pour le pliage :</font>"
"</strong> <font class=\"text-800\">Une épaisseur de papier spécialement "
"sélectionnée pour conserver sa forme sans se déchirer, idéale aussi bien "
"pour les débutants que pour les passionnés expérimentés.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Premium Presentation:</font></"
"strong> <font class=\"text-800\">Housed in a minimalist, white designer box "
"with a large transparent window, making it an ideal gift for professionals "
"and hobbyists alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Présentation haut de gamme :</font></"
"strong> <font class=\"text-800\">Présenté dans une boîte blanche au design "
"minimaliste, dotée d'une grande fenêtre transparente, ce produit constitue "
"un cadeau idéal pour les professionnels comme pour les amateurs.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Signature Color Palette:</font></"
"strong> <font class=\"text-800\">A harmonious blend of rich earth tones and "
"vibrant accents that complement any crochet or knitting project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Palette de couleurs signature :</font>"
