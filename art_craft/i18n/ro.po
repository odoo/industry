#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<strong> <u>Process</u> </strong>"
msgstr "<strong> <u>Proces</u> </strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid "<strong><font class=\"text-900\">What’s Inside:</font></strong>"
msgstr "<strong><font class=\"text-900\">Conținut:</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">6 vibrant color</font>s</strong> – A "
"versatile range for creating colorful artwork and unique combinations."
msgstr ""
"<strong><font class=\"text-o-color-3\">6 culori vibrante</font></strong> – O "
"gamă versatilă pentru creații pline de culoare și combinații originale."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Base Footprint:</font></strong> <font "
"class=\"text-800\">Approximately <strong>95 cm x 75 cm</strong> when fully "
"extended for maximum stability.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Amprenta bazei:</font></strong> <font "
"class=\"text-800\">Aproximativ <strong>95 cm x 75 cm</strong> când este "
"extinsă complet, pentru stabilitate maximă.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Comprehensive Selection:</font></"
"strong> <font class=\"text-800\">Includes 11 specialized brushes—Fan, "
"Filbert, Flat, and Round—to handle everything from broad washes to the "
"finest details.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Selecție completă:</font></strong> "
"<font class=\"text-800\">Include 11 pensule specializate — evantai, limbă de "
"pisică, plată și rotundă — pentru orice, de la tușe late până la cele mai "
"fine detalii.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Consistent Quality:</font></"
"strong> <font style=\"color: rgb(99, 99, 99);\">Every skein is meticulously "
"dyed to ensure color consistency throughout your entire project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Calitate constantă:</font></strong> "
"<font style=\"color: rgb(99, 99, 99);\">Fiecare scul de fire este vopsit cu "
"grijă pentru a păstra uniformitatea culorii în tot proiectul.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Ergonomic Design:</font></"
"strong> <font class=\"text-800\">Features elegant, matte black handles that "
"offer a comfortable grip and a professional look.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Design ergonomic:</font></strong> "
"<font class=\"text-800\">Mânere elegante, negre mate, care oferă o prindere "
"confortabilă și un aspect profesionist.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Excellent Stitch Definition:</font></"
"strong> <font class=\"text-800\">The high-twist construction ensures your "
"patterns and textures stand out with professional clarity.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Definirea clară a ochiurilor:</font></"
"strong> <font class=\"text-800\">Firul răsucit strâns scoate în evidență "
"modelele și texturile, cu un rezultat clar și profesionist.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">Great for all skill levels</font></"
"strong> – Perfect for beginners, hobby artists, students, and creative "
"enthusiasts."
msgstr ""
"<strong><font class=\"text-o-color-3\">Potrivite pentru toate nivelurile</"
"font></strong> – Ideale pentru începători, artiști amatori, studenți și "
"pasionați de creație."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Hardware:</font></strong> <font "
"class=\"text-800\">Corrosion-resistant polished brass knobs and fittings for "
"smooth height and tilt adjustments.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Feronerie:</font></strong> <font "
"class=\"text-800\">Butoane și accesorii din alamă lustruită, rezistente la "
"coroziune, pentru reglarea ușoară a înălțimii și înclinării.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">High-Performance Bristles:</font></"
"strong> <font class=\"text-800\">Crafted with high-quality synthetic fibers "
"that maintain their shape and provide smooth, consistent paint flow.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Peri de înaltă performanță:</font></"
"strong> <font class=\"text-800\">Realizați din fibre sintetice de calitate, "
"care își păstrează forma și asigură o aplicare uniformă a vopselei.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Material:</font></strong> <font "
"class=\"text-800\">Premium, sustainably sourced solid Beechwood with a "
"natural light-oil finish.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Material:</font></strong> <font "
"class=\"text-800\">Lemn masiv de fag de calitate superioară, provenit din "
"surse sustenabile, cu finisaj natural cu ulei deschis la culoare.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Maximum Canvas Height:</font></"
"strong> <font class=\"text-800\">Accommodates canvases up to <strong>120 cm "
"(47 inches)</strong> tall.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Înălțimea maximă a pânzei:</font></"
"strong> <font class=\"text-800\">Suportă pânze cu înălțimea de până la "
"<strong>120 cm (47 inci)</strong>.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Perfect Weight for Folding:</font></"
"strong> <font class=\"text-800\">Specially selected paper thickness that "
"holds its shape without tearing, making it ideal for beginners and advanced "
"crafters alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Grosime ideală pentru pliere:</font></"
"strong> <font class=\"text-800\">Hârtie cu grosime aleasă special, care își "
"păstrează forma fără să se rupă, potrivită atât pentru începători, cât și "
"pentru artizani avansați.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Premium Presentation:</font></"
"strong> <font class=\"text-800\">Housed in a minimalist, white designer box "
"with a large transparent window, making it an ideal gift for professionals "
"and hobbyists alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Prezentare premium:</font></strong> "
"<font class=\"text-800\">Ambalată într-o cutie albă, minimalistă, cu design "
"elegant și fereastră transparentă mare, ideală pentru a fi oferită cadou "
"profesioniștilor și pasionaților.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Signature Color Palette:</font></"
"strong> <font class=\"text-800\">A harmonious blend of rich earth tones and "
"vibrant accents that complement any crochet or knitting project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Paletă cromatică distinctivă:</font></"
"strong> <font class=\"text-800\">O combinație armonioasă de tonuri bogate de "
"pământ și accente vibrante, potrivită pentru orice proiect de croșetat sau "
"tricotat.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Stunning Geometric Patterns:</font></"
