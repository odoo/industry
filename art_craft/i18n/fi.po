#. module: art_craft
#: model:product.template,description_sale:art_craft.product_template_23
msgid ""
"\n"
"            Acrylic Kit:\n"
"            1) Heavy Cartridge Mix Media 300 gsm paper pack of 20 A5\n"
"            2) Heavy Cartridge Mix Media 300 gsm paper pack of 20 A4\n"
"            3) Stationerie Artists’ Canvas Board 8”x10”\n"
"            4) Stationerie Artists’ Canvas Board 10”x12”\n"
"            5) Stationerie Homemade Gloss Varnish 90ml\n"
"            6) Stationerie Medium Wooden Palette (14.5×7.5)\n"
"            7) Stationerie Professional Handmade Flat Set Of 8 Hog White\n"
"            (0 1 2 4 6 8 10 12)\n"
"            8) Stationerie 2” Hog White Wash Inch Brush\n"
"            9) Stationerie Palette Knife (Sizes May Differ)\n"
"        "
msgstr ""
"\n"
"            Akryylipaketti:\n"
"            300 g/m² paperi, 20 kpl A5\n"
"            2) Raskas mustekasetti, Mix Media 300 g/m² paperipakkaus 20 kpl "
"A4\n"
"            3) Stationerie Artists' Canvas -levy 8 \"x10\"\n"
"            4) Stationerie Artists' Canvas -levy 10 \"x12\" \n"
"            5) Stationerie Kotitekoinen kiiltävä lakka 90ml\n"
"            6) Stationerie Medium puupaletti (14.5×7.5)\n"
"            7) Stationerie Professional Käsintehty tasainen sarja 8 Hog "
"Valkoinen\n"
"            (0 1 2 4 6 8 10 12)\n"
"            8) Stationerie 2\" Hog White Wash tuuman sivellin\n"
"            9) Stationerie Palettiveitsi (koot voivat vaihdella)\n"
