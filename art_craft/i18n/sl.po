#. module: art_craft
#: model:product.template,description_sale:art_craft.product_template_23
msgid ""
"\n"
"            Acrylic Kit:\n"
"            1) Heavy Cartridge Mix Media 300 gsm paper pack of 20 A5\n"
"            2) Heavy Cartridge Mix Media 300 gsm paper pack of 20 A4\n"
"            3) Stationerie Artists’ Canvas Board 8”x10”\n"
"            4) Stationerie Artists’ Canvas Board 10”x12”\n"
"            5) Stationerie Homemade Gloss Varnish 90ml\n"
"            6) Stationerie Medium Wooden Palette (14.5×7.5)\n"
"            7) Stationerie Professional Handmade Flat Set Of 8 Hog White\n"
"            (0 1 2 4 6 8 10 12)\n"
"            8) Stationerie 2” Hog White Wash Inch Brush\n"
"            9) Stationerie Palette Knife (Sizes May Differ)\n"
"        "
msgstr ""
"\n"
"            Akrilni komplet:\n"
"            1) Mešani medij za težke kartuše, 300 g/m², pakiranje 20 kosov "
"papirja A5\n"
"            2) Mešani papirji za težke kartuše, 300 g/m², pakiranje 20 kosov "
"A4\n"
"            3) Platno za umetnike pisarniškega materiala 20cm x 25 cm\n"
"            4) Platno za umetnike pisarniškega materiala 25 cm x 30 cm\n"
"            5) Papirnica Domači sijajni lak 90 ml\n"
"            6) Paleta za pisanje srednje velikosti, lesena (37 cm × 19 cm)\n"
"            7) Profesionalni ročno izdelani ploščati komplet 8 belih "
"papirnatih papirjev\n"
"            (0 1 2 4 6 8 10 12)\n"
"            8) Papirnica 2” Čopič za belo pranje Hog, palčni\n"
"            9) Paletni nož za pisalne potrebščine (velikosti se lahko "
"razlikujejo)\n"
"        "

