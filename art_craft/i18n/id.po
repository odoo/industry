#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Consistent Quality:</font></"
"strong> <font style=\"color: rgb(99, 99, 99);\">Every skein is meticulously "
"dyed to ensure color consistency throughout your entire project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Kualitas Konsisten:</font></strong> "
"<font style=\"color: rgb(99, 99, 99);\">Setiap helai diwarnai dengan cermat "
"untuk memastikan konsistensi warna di seluruh proyek Anda.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Ergonomic Design:</font></"
"strong> <font class=\"text-800\">Features elegant, matte black handles that "
"offer a comfortable grip and a professional look.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Desain Ergonomis:</font></strong> "
"<font class=\"text-800\">Dilengkapi gagang berwarna hitam matte yang elegan, "
"memberikan pegangan yang nyaman dan tampilan profesional.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Excellent Stitch Definition:</font></"
"strong> <font class=\"text-800\">The high-twist construction ensures your "
"patterns and textures stand out with professional clarity.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Definisi Jahitan Luar Biasa:</font></"
"strong> <font class=\"text-800\">Konstruksi puntiran tinggi memastikan pola "
"dan tekstur Anda menonjol dengan kejelasan profesional.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">Great for all skill levels</font></"
"strong> – Perfect for beginners, hobby artists, students, and creative "
"enthusiasts."
msgstr ""
"<strong><font class=\"text-o-color-3\">Cocok untuk semua tingkat keahlian</"
"font></strong> – Sempurna untuk pemula, seniman hobi, pelajar, dan penggemar "
"kreatif."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Hardware:</font></strong> <font "
"class=\"text-800\">Corrosion-resistant polished brass knobs and fittings for "
"smooth height and tilt adjustments.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Perangkat Keras:</font></strong> "
"<font class=\"text-800\">Kenop dan perlengkapan kuningan poles tahan korosi "
"untuk pengaturan ketinggian dan kemiringan yang mulus.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">High-Performance Bristles:</font></"
"strong> <font class=\"text-800\">Crafted with high-quality synthetic fibers "
"that maintain their shape and provide smooth, consistent paint flow.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Bulu Kuas Performa Tinggi:</font></"
"strong> <font class=\"text-800\">Dibuat dengan serat sintetis berkualitas "
"tinggi yang mempertahankan bentuknya dan memberikan aliran cat yang mulus "
"dan konsisten.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Material:</font></strong> <font "
"class=\"text-800\">Premium, sustainably sourced solid Beechwood with a "
"natural light-oil finish.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Bahan:</font></strong> <font "
"class=\"text-800\">Kayu Beech solid premium yang bersumber secara "
"berkelanjutan dengan lapisan akhir minyak ringan alami.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Maximum Canvas Height:</font></"
"strong> <font class=\"text-800\">Accommodates canvases up to <strong>120 cm "
"(47 inches)</strong> tall.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Tinggi Kanvas Maksimum:</font></"
"strong> <font class=\"text-800\">Dapat menampung kanvas hingga <strong>120 "
"cm (47 inci)</strong> tingginya.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Perfect Weight for Folding:</font></"
"strong> <font class=\"text-800\">Specially selected paper thickness that "
"holds its shape without tearing, making it ideal for beginners and advanced "
"crafters alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Berat yang Sempurna untuk Melipat:</"
"font></strong> <font class=\"text-800\">Ketebalan kertas yang dipilih khusus "
"agar tahan bentuk tanpa robek, menjadikannya ideal untuk pemula maupun "
"perajin tingkat lanjut.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Premium Presentation:</font></"
"strong> <font class=\"text-800\">Housed in a minimalist, white designer box "
"with a large transparent window, making it an ideal gift for professionals "
"and hobbyists alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Presentasi Premium:</font></strong> "
"<font class=\"text-800\">Ditempatkan dalam kotak desainer putih minimalis "
"dengan jendela transparan besar, menjadikannya hadiah ideal bagi profesional "
"maupun penghobi.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Signature Color Palette:</font></"
"strong> <font class=\"text-800\">A harmonious blend of rich earth tones and "
"vibrant accents that complement any crochet or knitting project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Palet Warna Khas:</font></strong> "
"<font class=\"text-800\">Perpaduan harmonis antara warna tanah yang kaya dan "
"aksen cerah yang melengkapi proyek merenda atau merajut apa pun.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Stunning Geometric Patterns:</font></"
"strong> <font class=\"text-800\">From bold triangles and chevrons to modern "
"dots and stripes, each sheet is printed with vibrant, high-contrast colors "
"(teal, pink, sunny yellow, and more).</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Pola Geometris yang Memukau:</font></"
"strong> <font class=\"text-800\">Mulai dari segitiga dan chevron yang berani "
"hingga titik dan garis modern, setiap lembar dicetak dengan warna-warna "
"cerah dan kontras tinggi (teal, merah muda, kuning cerah, dan lainnya).</"
"font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
