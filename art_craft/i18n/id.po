#. module: art_craft
#: model_terms:product.template,website_description:art_craft.product_template_28
msgid "<em>The 120ml tubes are incredibly generous for an intro set.</em>"
msgstr "<em>Tabung 120ml ini sangat melimpah untuk set perkenalan.</em>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<font class=\"text-800\"> This set features four stunning, signature colors. "
"Teal, Rust, Mustard, and Cream, inspired by our brand’s vibrant aesthetic.</"
"font>"
msgstr ""
"<font class=\"text-800\"> Set ini menampilkan empat warna khas yang memukau. "
"Teal, Rust, Mustard, dan Cream, terinspirasi oleh estetika merek kami yang "
"dinamis.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-800\">Crafted from premium, sustainably sourced "
"beechwood, this easel combines elegant design with robust functionality, "
"making it an essential centerpiece for any artist's studio.</"
"font><br><br><strong><font class=\"text-black\">Key features:</font></strong>"
msgstr ""
"<font class=\"text-800\">Dibuat dari kayu beech premium yang bersumber "
"secara berkelanjutan, penyangga ini menggabungkan desain elegan dengan "
"fungsionalitas yang kokoh, menjadikannya pusat perhatian yang esensial untuk "
"studio seniman mana pun.</font><br><br><strong><font class=\"text-black\">"
"Fitur utama:</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-800\">Designed for aspiring artists and paper-folding "
"enthusiasts, this premium kit combines vibrant colors with intricate "
"patterns to make every creation a masterpiece.</font>"
msgstr ""
"<font class=\"text-800\">Dirancang untuk seniman pemula dan penggemar "
"melipat kertas, perlengkapan premium ini menggabungkan warna-warna cerah "
"dengan pola yang rumit untuk menjadikan setiap kreasi sebagai karya seni.</"
"font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-800\">This high-quality studio packshot showcases a "
"vibrant collection of arts and crafts supplies neatly arranged on a clean, "
"seamless white background.</font>"
msgstr ""
"<font class=\"text-800\">Foto produk studio berkualitas tinggi ini "
"menampilkan koleksi perlengkapan seni dan kerajinan yang dinamis dan tertata "
"rapi di atas latar belakang putih bersih yang mulus.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<font class=\"text-800\">This premium collection is designed for artists who "
"demand precision, durability, and a sleek aesthetic.</"
"font><br><br><strong><font class=\"text-o-color-5\">What’s Inside:<br><br></"
"font></strong>"
msgstr ""
"<font class=\"text-800\">Koleksi premium ini dirancang bagi seniman yang "
"mengutamakan presisi, daya tahan, dan estetika yang ramping.</font><br><br>"
"<strong><font class=\"text-o-color-5\">Apa Saja Isinya:<br><br></font></"
"strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid "<font class=\"text-black\"><strong>What’s Inside:</strong></font><br>"
msgstr "<font class=\"text-black\"><strong>Apa Saja Isinya:</strong></font><br>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-o-color-3\"><strong>60 Premium Sheets:</strong> </"
"font><font class=\"text-800\">A generous collection of square origami papers "
"featuring a wide variety of double-sided geometric designs.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>60 Lembar Premium:</strong> </font>"
"<font class=\"text-800\">Koleksi berlimpah kertas origami persegi yang "
"menampilkan berbagai desain geometris dua sisi.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-o-color-3\"><strong>Bonus Sticker Sheet:</strong> </"
"font><font class=\"text-800\">Add personality to your origami animals and "
"shapes with the included set of fun decorative stickers.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Lembar Stiker Bonus:</strong> </font>"
"<font class=\"text-800\">Tambahkan kepribadian pada hewan dan bentuk origami "
"Anda dengan set stiker dekoratif yang menyenangkan.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Convenient tube packaging</strong> </"
"font>– Easy to squeeze, control, and store."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Kemasan tabung praktis</strong> </"
"font>– Mudah ditekan, dikontrol, dan disimpan."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Craft Accessories:</strong> </"
"font><font class=\"text-800\">A playful assortment of small wooden figurines "
"including pandas, owls, and fruit slices (watermelon, orange), alongside "
"colorful scattered beads and star-shaped charms.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Aksesori Kerajinan:</strong> </font>"
"<font class=\"text-800\">Aneka ragam figurin kayu kecil yang lucu termasuk "
"panda, burung hantu, dan irisan buah (semangka, jeruk), serta manik-manik "
"warna-warni dan pernak-pernik berbentuk bintang.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Decorative Jars:</strong> </"
"font><font class=\"text-800\">Multiple small glass jars with classic cork "
"stoppers, filled with shimmering glitter in various colors (red, blue, "
"green, gold, purple) and tiny yellow beads.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Stoples Dekoratif:</strong> </font>"
"<font class=\"text-800\">Beberapa stoples kaca kecil dengan sumbat gabus "
"klasik, diisi dengan glitter berkilau dalam berbagai warna (merah, biru, "
"hijau, emas, ungu) dan manik-manik kuning kecil.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<font class=\"text-o-color-3\"><strong>Durable Build:</strong> </font><font "
"class=\"text-800\">Equipped with reinforced silver ferrules to prevent "
"shedding and ensure long-lasting performance.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Konstruksi Tahan Lama:</strong> </"
"font><font class=\"text-800\">Dilengkapi dengan ferrule perak yang diperkuat "
"untuk mencegah kerontokan dan memastikan performa yang tahan lama.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Mix and match</strong> </font>– Blend "
"colors together to create custom shades and beautiful effects."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Padu padankan</strong> </font>– "
"Campurkan warna untuk menciptakan corak khusus dan efek yang indah."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Paper &amp; Tools:</strong> </"
"font><font class=\"text-800\">A stack of beautifully patterned origami "
"papers featuring intricate floral and traditional designs, paired with a "
"pair of vintage-style ornate metal scissors.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Kertas &amp; Alat:</strong> </font>"
"<font class=\"text-800\">Tumpukan kertas origami bermotif indah dengan "
"desain bunga dan tradisional yang rumit, dipasangkan dengan gunting logam "
"berornamen gaya vintage.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Smooth acrylic formula</strong> </"
"font>– Ideal for creating even coverage and expressive brushstrokes."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Formula akrilik halus</strong> </font>"
"– Ideal untuk menciptakan cakupan yang merata dan sapuan kuas yang ekspresif."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-o-color-3\"><strong>Total Height:</strong> </font><font "
"class=\"text-800\">Adjustable from <strong>150 cm to 230 cm</"
"strong> depending on mast extension.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Tinggi Total:</strong> </font><font "
"class=\"text-800\">Dapat disesuaikan dari <strong>150 cm hingga 230 cm</"
"strong> tergantung pada ekstensi tiang.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-o-color-3\"><strong>Type:</strong></font><font "
"class=\"text-o-color-5\"> </font><font class=\"text-800\">Classic Tripod A-"
"Frame Studio Easel.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Tipe:</strong></font><font "
"class=\"text-o-color-5\"> </font><font class=\"text-800\">Easel Studio "
"Tripod A-Frame Klasik.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<font class=\"text-o-color-3\"><strong>Ultra-Soft Texture:</strong> </"
"font>S<font class=\"text-800\">pun from premium fibers to ensure a smooth, "
"snag-free experience that is gentle on your hands and luxurious to the touch."
"</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Tekstur Sangat Lembut:</strong> </"
"font>S<font class=\"text-800\">erat dari serat premium untuk memastikan "
"pengalaman yang mulus dan bebas kusut, lembut di tangan, dan mewah saat "
"disentuh.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Versatile use</strong> </font>– "
"Suitable for canvas, paper, wood, crafts, and other suitable painting "
"surfaces."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Penggunaan serbaguna</strong> </font>"
"– Cocok untuk kanvas, kertas, kayu, kerajinan, dan permukaan lukis lainnya "
"yang sesuai."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-o-color-3\"><strong>Weight:</strong> </font><font "
"class=\"text-800\">Approximately <strong>6.5 kg</strong>, providing a sturdy "
