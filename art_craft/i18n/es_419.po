#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid "<strong><font class=\"text-900\">What’s Inside:</font></strong>"
msgstr "<strong><font class=\"text-900\">Qué incluye:</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">6 vibrant color</font>s</strong> – A "
"versatile range for creating colorful artwork and unique combinations."
msgstr ""
"<strong><font class=\"text-o-color-3\">6 colores vibrantes:</font></strong> "
"Una gama versátil para crear obras llenas de color y combinaciones únicas."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Base Footprint:</font></strong> <font "
"class=\"text-800\">Approximately <strong>95 cm x 75 cm</strong> when fully "
"extended for maximum stability.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Base de apoyo:</font></strong> <font "
"class=\"text-800\">Aproximadamente <strong>95 cm x 75 cm</strong> cuando "
"está desplegado por completo para ofrecer la máxima estabilidad.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Comprehensive Selection:</font></"
"strong> <font class=\"text-800\">Includes 11 specialized brushes—Fan, "
"Filbert, Flat, and Round—to handle everything from broad washes to the "
"finest details.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Selección completa:</font></strong> "
"<font class=\"text-800\">Incluye 11 pinceles especializados (abanico, lengua "
"de gato, plano y redondo) para trabajar desde pinceladas amplias hasta los "
"detalles más finos.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Consistent Quality:</font></"
"strong> <font style=\"color: rgb(99, 99, 99);\">Every skein is meticulously "
"dyed to ensure color consistency throughout your entire project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Calidad uniforme:</font></strong> "
"<font style=\"color: rgb(99, 99, 99);\">Cada madeja está teñida con cuidado "
"para mantener un color uniforme en todo el proyecto.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Ergonomic Design:</font></"
"strong> <font class=\"text-800\">Features elegant, matte black handles that "
"offer a comfortable grip and a professional look.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Diseño ergonómico:</font></strong> "
"<font class=\"text-800\">Tiene elegantes mangos negros mate que ofrecen un "
"agarre cómodo y una apariencia profesional.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Excellent Stitch Definition:</font></"
"strong> <font class=\"text-800\">The high-twist construction ensures your "
"patterns and textures stand out with professional clarity.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Puntos bien definidos:</font></"
"strong> <font class=\"text-800\">La torsión alta del hilo hace que los "
"patrones y las texturas destaquen con una definición profesional.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">Great for all skill levels</font></"
"strong> – Perfect for beginners, hobby artists, students, and creative "
"enthusiasts."
msgstr ""
"<strong><font class=\"text-o-color-3\">Ideal para todos los niveles:</font></"
"strong> Perfecto para principiantes, aficionados al arte, estudiantes y "
"personas creativas."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Hardware:</font></strong> <font "
"class=\"text-800\">Corrosion-resistant polished brass knobs and fittings for "
"smooth height and tilt adjustments.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Herrajes:</font></strong> <font "
"class=\"text-800\">Perillas y accesorios de latón pulido resistentes a la "
"corrosión para ajustar la altura y la inclinación con facilidad.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">High-Performance Bristles:</font></"
"strong> <font class=\"text-800\">Crafted with high-quality synthetic fibers "
"that maintain their shape and provide smooth, consistent paint flow.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Cerdas de alto rendimiento:</font></"
"strong> <font class=\"text-800\">Fabricadas con fibras sintéticas de alta "
"calidad que conservan su forma y permiten aplicar la pintura de manera "
"uniforme.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Material:</font></strong> <font "
"class=\"text-800\">Premium, sustainably sourced solid Beechwood with a "
"natural light-oil finish.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Material:</font></strong> <font "
"class=\"text-800\">Madera maciza de primera calidad, obtenida de fuentes "
"sostenibles y con un acabado natural de aceite ligero.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Maximum Canvas Height:</font></"
"strong> <font class=\"text-800\">Accommodates canvases up to <strong>120 cm "
"(47 inches)</strong> tall.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Altura máxima del lienzo:</font></"
"strong> <font class=\"text-800\">Compatible con lienzos de hasta <strong>120 "
"cm (47 pulgadas)</strong> de altura.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Perfect Weight for Folding:</font></"
"strong> <font class=\"text-800\">Specially selected paper thickness that "
"holds its shape without tearing, making it ideal for beginners and advanced "
"crafters alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Grosor ideal para doblar:</font></"
"strong> <font class=\"text-800\">Papel de un grosor especial que conserva su "
"forma sin rasgarse, ideal tanto para principiantes como para personas con "
"experiencia en manualidades.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Premium Presentation:</font></"
"strong> <font class=\"text-800\">Housed in a minimalist, white designer box "
"with a large transparent window, making it an ideal gift for professionals "
"and hobbyists alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Presentación premium:</font></strong> "
"<font class=\"text-800\">Viene en una caja blanca de diseño minimalista con "
"una ventanilla transparente grande, ideal para regalar tanto a profesionales "
"como a aficionados.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Signature Color Palette:</font></"
"strong> <font class=\"text-800\">A harmonious blend of rich earth tones and "
"vibrant accents that complement any crochet or knitting project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Paleta de colores distintiva:</font></"
"strong> <font class=\"text-800\">Una mezcla armoniosa de tonos tierra "
"intensos y acentos vibrantes que combinan con cualquier proyecto de tejido a "
"crochet o punto.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Stunning Geometric Patterns:</font></"
"strong> <font class=\"text-800\">From bold triangles and chevrons to modern "
"dots and stripes, each sheet is printed with vibrant, high-contrast colors "
"(teal, pink, sunny yellow, and more).</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Increíbles patrones geométricos:</"
"font></strong> <font class=\"text-800\">Desde triángulos llamativos y "
"chevrones hasta puntos y rayas modernos, cada hoja presenta colores "
"vibrantes y de alto contraste (verde azulado, rosa, amarillo brillante y más)"
".</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid "<strong><font class=\"text-o-color-5\">Key Features:</font></strong>"
msgstr ""
"<strong><font class=\"text-o-color-5\">Características principales:</font></"
"strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
