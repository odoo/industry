msgstr "<strong><font class=\"text-o-color-5\">Qué incluye:</font></strong>"

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid ""
"<strong>Acrylics:</strong> Learn to play with texture, layering, and thick "
"applications to bring depth to your canvas."
msgstr ""
"<strong>Acrílicos:</strong> Aprende a jugar con las texturas, las capas y "
"las aplicaciones gruesas para dar profundidad a tus lienzos."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<strong>Activities</strong><span class=\"h1-fs\"> </span>"
msgstr "<strong>Actividades</strong><span class=\"h1-fs\"> </span>"

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid ""
"<strong>Aquarelle (Watercolor):</strong> Master transparency, color "
"blending, and water control to create light and poetic atmospheres."
msgstr ""
"<strong>Acuarela:</strong> Domina la transparencia, la mezcla de colores y "
"el control del agua para crear ambientes ligeros y poéticos."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_3
msgid ""
"<strong>Atmosphere:</strong> A calm, zen-like environment where you can work "
"at your own pace."
msgstr ""
"<strong>Ambiente:</strong> Un entorno tranquilo, al estilo zen, donde puedes "
"trabajar a tu propio ritmo."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_2
msgid ""
"<strong>Booking:</strong> Limited spots available to ensure personalized "
"attention for every student"
msgstr ""
"<strong>Reservaciones:</strong> Hay pocos espacios para ofrecer atención "
"personalizada a cada estudiante"

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid ""
"<strong>Booking:</strong> Limited spots available to ensure quality guidance."
msgstr ""
"<strong>Reservaciones:</strong> Hay pocos espacios para garantizar una buena "
"orientación."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_3
msgid ""
"<strong>Creative Variations:</strong> Once you've mastered the basics, learn "
"how to use different paper textures and patterns to give your creations a "
"unique touch."
msgstr ""
"<strong>Variaciones creativas:</strong> Cuando domines los conceptos "
"básicos, aprende a usar distintos tipos de papel y patrones para darle un "
"toque único a tus creaciones."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<strong>Do you want to go further?</strong>"
msgstr "<strong>¿Quieres saber más?</strong>"

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid ""
"<strong>Gouache:</strong> Discover the joy of this matte, opaque paint, "
"perfect for vibrant flat colors and precise details."
msgstr ""
"<strong>Gouache:</strong> Descubre el encanto de esta pintura mate y opaca, "
"ideal para lograr colores planos vibrantes y detalles precisos."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid "<strong>Level:</strong> All levels welcome."
msgstr "<strong>Nivel:</strong> Todos los niveles son bienvenidos."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_3
msgid ""
"<strong>Level:</strong> Beginners and enthusiasts of all ages (minimum 8+ "
"recommended)."
msgstr ""
"<strong>Nivel:</strong> Para principiantes y aficionados de todas las edades "
"(recomendado a partir de los 8 años)."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_2
msgid ""
"<strong>Level:</strong> Perfect for absolute beginners (adults and teens "
"welcome)."
msgstr ""
"<strong>Nivel:</strong> Ideal para principiantes absolutos (personas adultas "
"y adolescentes)."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_2
msgid "<strong>Location:</strong> Arts-craft store, Ramillies."
msgstr "<strong>Ubicación:</strong> Tienda Arts-craft, Ramillies."

#. module: art_craft
#: model_terms:event.event,description:art_craft.event_event_1
msgid "<strong>Location:</strong> Arts-craft, Ramillies."
