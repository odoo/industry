msgstr "<span class=\"h2-fs\">จัดการสินค้าของคุณ️ 📦</span>"

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<span class=\"h2-fs\">Selling Online 💻️</span>"
msgstr "<span class=\"h2-fs\">การขายออนไลน์ 💻️</span>"

#. module: art_craft
