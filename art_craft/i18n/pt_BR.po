#. module: art_craft
#: model_terms:product.template,website_description:art_craft.product_template_28
msgid "<em>The 120ml tubes are incredibly generous for an intro set.</em>"
msgstr ""
"<em>Os tubos de 120ml são incrivelmente generosos para um conjunto "
"introdutório.</em>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<font class=\"text-800\"> This set features four stunning, signature colors. "
"Teal, Rust, Mustard, and Cream, inspired by our brand’s vibrant aesthetic.</"
"font>"
msgstr ""
"<font class=\"text-800\"> Este conjunto apresenta quatro cores exclusivas e "
"deslumbrantes. Verde-azulado (Teal), Ferrugem, Mostarda e Creme, inspiradas "
"na estética vibrante da nossa marca.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-800\">Crafted from premium, sustainably sourced "
"beechwood, this easel combines elegant design with robust functionality, "
"making it an essential centerpiece for any artist's studio.</"
"font><br><br><strong><font class=\"text-black\">Key features:</font></strong>"
msgstr ""
"<font class=\"text-800\">Feito de madeira de faia premium de origem "
"sustentável, este cavalete combina design elegante com funcionalidade "
"robusta, tornando-o uma peça central essencial para o estúdio de qualquer "
"artista.</font><br><br><strong><font class=\"text-black\">Principais "
"recursos:</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-800\">Designed for aspiring artists and paper-folding "
"enthusiasts, this premium kit combines vibrant colors with intricate "
"patterns to make every creation a masterpiece.</font>"
msgstr ""
"<font class=\"text-800\">Projetado para artistas aspirantes e entusiastas de "
"dobradura de papel, este kit premium combina cores vibrantes com padrões "
"intrincados para tornar cada criação uma obra-prima.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-800\">This high-quality studio packshot showcases a "
"vibrant collection of arts and crafts supplies neatly arranged on a clean, "
"seamless white background.</font>"
msgstr ""
"<font class=\"text-800\">Esta foto de estúdio de alta qualidade mostra uma "
"coleção vibrante de suprimentos de artes e artesanato organizados de forma "
"organizada em um fundo branco limpo e sem costuras.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<font class=\"text-800\">This premium collection is designed for artists who "
"demand precision, durability, and a sleek aesthetic.</"
"font><br><br><strong><font class=\"text-o-color-5\">What’s Inside:<br><br></"
"font></strong>"
msgstr ""
"<font class=\"text-800\">Esta coleção premium foi projetada para artistas "
"que exigem precisão, durabilidade e uma estética elegante.</font><br><br>"
"<strong><font class=\"text-o-color-5\">O que está incluído:<br><br></font></"
"strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid "<font class=\"text-black\"><strong>What’s Inside:</strong></font><br>"
msgstr ""
"<font class=\"text-black\"><strong>O que está incluído:</strong></font><br>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-o-color-3\"><strong>60 Premium Sheets:</strong> </"
"font><font class=\"text-800\">A generous collection of square origami papers "
"featuring a wide variety of double-sided geometric designs.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>60 folhas premium:</strong> </font>"
"<font class=\"text-800\">Uma coleção generosa de papéis de origami quadrados "
"com uma grande variedade de designs geométricos de dupla face.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-o-color-3\"><strong>Bonus Sticker Sheet:</strong> </"
"font><font class=\"text-800\">Add personality to your origami animals and "
"shapes with the included set of fun decorative stickers.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Cartela de adesivos bônus:</strong> </"
"font><font class=\"text-800\">Adicione personalidade aos seus animais e "
"formas de origami com o conjunto de adesivos decorativos divertidos "
"incluído.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Convenient tube packaging</strong> </"
"font>– Easy to squeeze, control, and store."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Embalagem em tubo conveniente</"
"strong> </font>– Fácil de espremer, controlar e armazenar."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Craft Accessories:</strong> </"
"font><font class=\"text-800\">A playful assortment of small wooden figurines "
"including pandas, owls, and fruit slices (watermelon, orange), alongside "
"colorful scattered beads and star-shaped charms.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Acessórios de artesanato:</strong> </"
"font><font class=\"text-800\">Uma variedade divertida de pequenas estatuetas "
"de madeira, incluindo pandas, corujas e fatias de frutas (melancia, laranja)"
", juntamente com miçangas coloridas espalhadas e pingentes em formato de "
"estrela.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Decorative Jars:</strong> </"
"font><font class=\"text-800\">Multiple small glass jars with classic cork "
"stoppers, filled with shimmering glitter in various colors (red, blue, "
"green, gold, purple) and tiny yellow beads.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Potes decorativos:</strong> </font>"
"<font class=\"text-800\">Vários potes de vidro pequenos com rolhas de "
"cortiça clássicas, cheios de glitter cintilante em várias cores (vermelho, "
"azul, verde, dourado, roxo) e minúsculas miçangas amarelas.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<font class=\"text-o-color-3\"><strong>Durable Build:</strong> </font><font "
"class=\"text-800\">Equipped with reinforced silver ferrules to prevent "
"shedding and ensure long-lasting performance.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Construção durável:</strong> </font>"
"<font class=\"text-800\">Equipado com virolas prateadas reforçadas para "
"evitar que soltem e garantir um desempenho duradouro.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Mix and match</strong> </font>– Blend "
"colors together to create custom shades and beautiful effects."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Misture e combine</strong> </font>– "
"Misture cores para criar tons personalizados e efeitos bonitos."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Paper &amp; Tools:</strong> </"
"font><font class=\"text-800\">A stack of beautifully patterned origami "
"papers featuring intricate floral and traditional designs, paired with a "
"pair of vintage-style ornate metal scissors.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Ferramentas e papel:</strong> </font>"
"<font class=\"text-800\">Uma pilha de papéis de origami com padrões bonitos, "
"apresentando designs florais e tradicionais complexos, acompanhada por um "
"par de tesouras de metal ornamentadas em estilo vintage.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Smooth acrylic formula</strong> </"
"font>– Ideal for creating even coverage and expressive brushstrokes."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Fórmula acrílica suave</strong> </"
"font>– Ideal para criar cobertura uniforme e pinceladas expressivas."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-o-color-3\"><strong>Total Height:</strong> </font><font "
"class=\"text-800\">Adjustable from <strong>150 cm to 230 cm</"
"strong> depending on mast extension.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Altura total:</strong> </font><font "
"class=\"text-800\">Ajustável de <strong>150 cm a 230 cm</strong> dependendo "
"da extensão do mastro.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-o-color-3\"><strong>Type:</strong></font><font "
"class=\"text-o-color-5\"> </font><font class=\"text-800\">Classic Tripod A-"
"Frame Studio Easel.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Tipo:</strong></font><font "
"class=\"text-o-color-5\"> </font><font class=\"text-800\">Cavalete de "
"estúdio clássico tipo tripé em A.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<font class=\"text-o-color-3\"><strong>Ultra-Soft Texture:</strong> </"
"font>S<font class=\"text-800\">pun from premium fibers to ensure a smooth, "
"snag-free experience that is gentle on your hands and luxurious to the touch."
"</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Textura ultra-suave:</strong> </font>"
"F<font class=\"text-800\">iado com fibras premium para garantir uma "
"experiência suave e sem emaranhados, que é gentil com as mãos e luxuosa ao "
"toque.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
