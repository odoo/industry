#: model_terms:ir.ui.view,arch_db:art_craft.view_page_contactus
#: model_terms:ir.ui.view,arch_db:art_craft.view_page_home
#: model_terms:ir.ui.view,arch_db:art_craft.website_event_index_oe_structure_we_index_2
#: model_terms:ir.ui.view,arch_db:art_craft.website_sale_products_oe_structure_website_sale_products_2
msgid ""
"<a role=\"button\" href=\"#\" class=\"js_subscribe_btn o_submit "
"o_translate_inline btn btn-secondary\">Subscribe</a>"
msgstr ""
"<a role=\"button\" href=\"#\" class=\"js_subscribe_btn o_submit "
"o_translate_inline btn btn-secondary\">Inscrever-se</a>"

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Accounting:</b> Automatically log payments, close sessions, and generate "
"tax reports."
msgstr ""
"<b>Financeiro:</b> Registre automaticamente os pagamentos, encerre sessões e "
"gere relatórios fiscais."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Automated Lead Generation:</b> Every submission on your \"Contact Us\" "
"page instantly creates a brand-new opportunity in your <b>CRM App</b>."
msgstr ""
"<b>Geração Automatizada de Leads:</b> Cada envio na sua página \"Fale "
"Conosco\" cria instantaneamente uma nova oportunidade no seu <b>Aplicativo "
"CRM</b>."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Centralize Rewards:</b> Effortlessly build, monitor, and manage your "
"entire ecosystem of loyalty campaigns and promotional programs from one "
"dashboard."
msgstr ""
"<b>Centralize Recompensas:</b> Crie, monitore e gerencie sem esforço todo o "
"seu ecossistema de campanhas de fidelidade e programas promocionais a partir "
"de um único painel."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Crucial Review:</b> You must review all e-commerce settings to ensure "
"they align with your internal business policies (e.g., when invoices are "
"generated, whether a mandatory customer check-in is required for ordering, "
"etc.)."
msgstr ""
"<b>Revisão crucial:</b> Você deve revisar todas as configurações de comércio "
"eletrônico para garantir que estejam alinhadas com suas políticas internas "
"de negócios (por exemplo, quando as faturas são geradas, se é necessário que "
"o cliente faça login obrigatoriamente para fazer pedidos, etc.)."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Delivery Methods:</b> Go to <b>Website &gt; Configuration &gt; Delivery "
"Methods</b> to define all available options and their costs."
msgstr ""
"<b>Métodos de entrega:</b> Acesse o Site <b> &gt; Configuração &gt; Métodos "
"de entrega</b> \n"
" para definir todas as opções disponíveis e seus custos."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Direct Redirection:</b> Embed high-converting call-to-action (CTA) "
"buttons that send readers straight to your event registration page."
msgstr ""
"<b>Redirecionamento Direto:</b> Insira botões de call-to-action (CTA) de "
"alta conversão que enviam os leitores diretamente para sua página de "
"inscrição em eventos."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>E-commerce Category:</b> For easier product retrieval by customers on "
"your online store."
msgstr ""
"<b>Categoria de e-Commerce:</b> Para facilitar a localização de produtos "
"pelos clientes em sua loja online."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>External Providers:</b> Check if a predefined Odoo connection exists if "
"you work with specific shipping carriers."
msgstr ""
"<b>Provedores Externos:</b> Verifique se existe uma conexão Odoo predefinida "
"caso você trabalhe com transportadoras específicas."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>From the CRM app:</b> Track client interactions in real time and use the "
"<b>Sales App</b> to quickly send tailored quotations for B2B leads or custom "
"customer requests."
msgstr ""
"<b>Do aplicativo CRM:</b> Rastreie as interações com os clientes em tempo "
"real e use o <b>Aplicativo de Vendas</b> para enviar rapidamente cotações "
"personalizadas para leads B2B ou solicitações específicas de clientes."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Generate Membership Barcodes:</b> Link a unique barcode to a customer’s "
"digital or physical membership card for seamless scanning at your Point of "
"Sale (POS)."
msgstr ""
"<b>Gerar Códigos de Barras de Associação:</b> Vincule um código de barras "
"exclusivo ao cartão de associado digital ou físico do cliente para uma "
"leitura simples no seu Ponto de Venda (PDV)."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>In-Store Pickup (Click &amp; Collect):</b> If you wish to offer this, you "
"must <b>activate the setting</b> within the <b>Website Settings</b> first."
msgstr ""
"<b>Retirada na loja (Clique e Retire):</b> Se você pretende oferecer esse "
"serviço, \n"
"                            é necessário <b>ativar a definição</b> nas <b>"
"Configurações do Site</b> primeiro."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<b>Key Product Settings:</b>"
msgstr "<b>Principais definições de produtos:</b>"

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Layout Settings:</b> Adjust the visual presentation and layout of "
"products using the <b>website editor</b>."
msgstr ""
"<b>Definições de layout:</b> Ajuste a apresentação visual e o layout dos "
"produtos usando o <b>editor do site</b> ."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Logistics &amp; Pricing:</b> Define ticket prices, event times, and "
"capacity limits."
msgstr ""
"<b>Logística e Preços:</b> Defina preços de ingressos, horários de eventos e "
"limites de capacidade."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Note:</b> Increased capability leads to higher complexity and more "
"maintenance."
msgstr ""
"<b>Observação:</b> Maior capacidade leva a maior complexidade e mais "
"manutenção."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Our Advice:</b> Stick with your current streamlined configuration until "
"you’re fully comfortable. When you're ready to upgrade, try the Inventory "
"module on a duplicated database first to ensure it fits your workflow. 😉"
msgstr ""
"<b>Nossa recomendação:</b> Mantenha sua configuração atual simplificada até "
"se sentir totalmente à vontade. Quando estiver pronto para atualizar, "
"experimente primeiro o módulo Inventário em uma base de dados duplicada para "
"garantir que ele se adapte ao seu fluxo de trabalho. 😉"

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Payment Providers &amp; Methods:</b> Go to <b>Website &gt; Configuration "
"&gt; Payment Providers</b> and install <b>all</b> the payment methods and "
"payment providers you plan to offer (e.g., credit card processors, PayPal, "
"etc.)."
msgstr ""
"<b>Provedores de Pagamento &amp; Métodos:</b> Vá para <b>Site &gt; "
"Configuração &gt; Provedores de Pagamento</b> e instale <b>todos</b> os "
"métodos de pagamento e provedores de pagamento que você planeja oferecer "
"(ex.: processadores de cartão de crédito, PayPal, etc.)."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Payroll:</b> Use this feature to handle <b>employee salaries and manage "
"holiday requests</b>."
msgstr ""
"<b>Folha de pagamento:</b> Use este recurso para tratar dos<b>salários dos "
"funcionários e gerenciar solicitações de férias</b>."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Point of Sale Category:</b> For organizing transactions within your shop "
"system."
msgstr ""
"<b>Categoria de Ponto de Venda:</b> Para organizar transações dentro do "
"sistema da sua loja."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid "<b>Product Category:</b> For internal tracking and reporting."
msgstr "<b>Categoria do produto:</b> Para acompanhamento e relatórios internos."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Product-Level Settings:</b> Define core product settings directly on the "
"<b>product form</b>."
msgstr ""
"<b>Configurações em nível de produto:</b> Defina as principais configurações "
"do produto diretamente no <b>formulário de produto</b>."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Publishing:</b> Each product can be <b>published independently</b> on "
"your online store."
msgstr ""
"<b>Publicação:</b> Cada produto pode ser publicado de forma independente <b> "
"em sua loja online</b>."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Ready to scale your reach?</b> Explore the <b>SMS Marketing</b>, "
"<b>Social Marketing</b>, and <b>Marketing Automation</b> apps to build "
"advanced, multi-channel campaigns."
msgstr ""
"<b>Pronto para ampliar seu alcance?</b> Explore os aplicativos de <b>"
"Marketing por SMS</b>, <b>Marketing de redes sociais</b> e <b>Automação de "
"Marketing</b> para criar campanhas avançadas e multicanais."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Ready to take it a step further?</b> Explore the <b>Membership</b> and "
"<b>Pricelists</b> features to easily manage exclusive pricing for your "
"members."
msgstr ""
"<b>Pronto para ir além?</b> Explore os recursos de <b>Associações</b> e <b>"
"Listas de preços</b> para gerenciar facilmente preços exclusivos para seus "
"membros."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Registration &amp; Launch:</b> Choose how attendees sign up and publish "
"the event page directly to your website."
msgstr ""
"<b>Inscrição &amp; Lançamento:</b> Escolha como os participantes se "
"inscrevem e publique a página do evento diretamente no seu site."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Targeted Outbound:</b> Launch promotional campaigns tailored to specific "
"mailing lists."
msgstr ""
"<b>Outbound segmentado:</b> Lance campanhas promocionais personalizadas para "
"listas de e-mail específicas."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Track Promotion Eligibility:</b> Instantly see exactly which active "
"rewards and promotional programs a specific customer can access."
msgstr ""
"<b>Rastrear elegibilidade a promoções:</b> Veja instantaneamente a quais "
"recompensas ativas e programas promocionais um cliente específico tem acesso."

#. module: art_craft
#: model_terms:ir.ui.view,arch_db:art_craft.welcome_article_body
msgid ""
"<b>Want to automate your purchasing?</b> &gt; Integrate the <b>Inventory "
"App</b> to unlock automated reordering. Keep in mind while expanding your "
"ecosystem provides much greater capability, it also introduces more advanced "
"configurations to manage."
msgstr ""
"<b>Quer automatizar suas compras?</b> &gt; Integre o <b>aplicativo "
"Inventário</b> para desbloquear a reposição automática. Tenha em mente que, "
"embora expandir seu ecossistema proporcione uma capacidade muito maior, "
"também introduz configurações mais avançadas para gerenciar."

