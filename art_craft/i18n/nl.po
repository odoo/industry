#. module: art_craft
#: model_terms:product.template,website_description:art_craft.product_template_28
msgid "<em>The 120ml tubes are incredibly generous for an intro set.</em>"
msgstr "<em>De tubes van 120ml zijn perfect voor een startersset.</em>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<font class=\"text-800\"> This set features four stunning, signature colors. "
"Teal, Rust, Mustard, and Cream, inspired by our brand’s vibrant aesthetic.</"
"font>"
msgstr ""
"<font class=\"text-800\"> Deze set bevat vier prachtige, kenmerkende "
"kleuren. Teal, Roest, Mosterd en Crème, geïnspireerd op de levendige look "
"van ons merk.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-800\">Crafted from premium, sustainably sourced "
"beechwood, this easel combines elegant design with robust functionality, "
"making it an essential centerpiece for any artist's studio.</"
"font><br><br><strong><font class=\"text-black\">Key features:</font></strong>"
msgstr ""
"<font class=\"text-800\">Deze ezel is vervaardigd uit hoogwaardig, duurzaam "
"verkregen beukenhout en combineert een elegant ontwerp met robuuste "
"functionaliteit, waardoor het een essentieel stuk voor elk "
"kunstenaarsstudio.</font><br><br><strong><font class=\"text-black\">"
"Belangrijkste kenmerken:</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-800\">Designed for aspiring artists and paper-folding "
"enthusiasts, this premium kit combines vibrant colors with intricate "
"patterns to make every creation a masterpiece.</font>"
msgstr ""
"<font class=\"text-800\">Deze premiumkit is ontworpen voor beginnende "
"kunstenaars en liefhebbers van papier vouwen en combineert levendige kleuren "
"met ingewikkelde patronen om van elke creatie een meesterwerk te maken.</"
"font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-800\">This high-quality studio packshot showcases a "
"vibrant collection of arts and crafts supplies neatly arranged on a clean, "
"seamless white background.</font>"
msgstr ""
"<font class=\"text-800\">Deze hoogwaardige studioproductfoto toont een "
"levendige collectie hobbybenodigdheden die netjes zijn gerangschikt op een "
"schone, naadloze witte achtergrond.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<font class=\"text-800\">This premium collection is designed for artists who "
"demand precision, durability, and a sleek aesthetic.</"
"font><br><br><strong><font class=\"text-o-color-5\">What’s Inside:<br><br></"
"font></strong>"
msgstr ""
"<font class=\"text-800\">Deze premiumcollectie is ontworpen voor kunstenaars "
"die precisie, duurzaamheid en een strakke esthetiek eisen.</font><br><br>"
"<strong><font class=\"text-o-color-5\">Wat zit erin:<br><br></font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid "<font class=\"text-black\"><strong>What’s Inside:</strong></font><br>"
msgstr "<font class=\"text-black\"><strong>Wat zit erin:</strong></font><br>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-o-color-3\"><strong>60 Premium Sheets:</strong> </"
"font><font class=\"text-800\">A generous collection of square origami papers "
"featuring a wide variety of double-sided geometric designs.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>60 Premium vellen:</strong> </font>"
"<font class=\"text-800\">Een royale collectie vierkante origamipapiertjes "
"met een grote verscheidenheid aan dubbelzijdige geometrische ontwerpen.</"
"font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<font class=\"text-o-color-3\"><strong>Bonus Sticker Sheet:</strong> </"
"font><font class=\"text-800\">Add personality to your origami animals and "
"shapes with the included set of fun decorative stickers.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Extra stickervel:</strong> </font>"
"<font class=\"text-800\">Geef je origami-dieren en -vormen persoonlijkheid "
"met de bijgevoegde set leuke decoratieve stickers.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Convenient tube packaging</strong> </"
"font>– Easy to squeeze, control, and store."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Handige tube-verpakking</strong> </"
"font>– Makkelijk uit te knijpen, te doseren en op te bergen."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Craft Accessories:</strong> </"
"font><font class=\"text-800\">A playful assortment of small wooden figurines "
"including pandas, owls, and fruit slices (watermelon, orange), alongside "
"colorful scattered beads and star-shaped charms.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Knutselaccessoires:</strong> </font>"
"<font class=\"text-800\">Een speels assortiment kleine houten figuurtjes, "
"waaronder panda's, uilen en fruitpartjes (watermeloen, sinaasappel), samen "
"met kleurrijke losse kralen en stervormige bedeltjes.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Decorative Jars:</strong> </"
"font><font class=\"text-800\">Multiple small glass jars with classic cork "
"stoppers, filled with shimmering glitter in various colors (red, blue, "
"green, gold, purple) and tiny yellow beads.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Decoratiepotjes:</strong> </font>"
"<font class=\"text-800\">Meerdere kleine glazen potjes met klassieke kurken "
"stoppen, gevuld met glinsterende glitter in verschillende kleuren (rood, "
"blauw, groen, goud, paars) en kleine gele kralen.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<font class=\"text-o-color-3\"><strong>Durable Build:</strong> </font><font "
"class=\"text-800\">Equipped with reinforced silver ferrules to prevent "
"shedding and ensure long-lasting performance.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Duurzaam ontwerp:</strong> </font>"
"<font class=\"text-800\">Uitgerust met versterkte zilveren hulzen om "
"harenverlies te voorkomen en langdurige prestaties te garanderen.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Mix and match</strong> </font>– Blend "
"colors together to create custom shades and beautiful effects."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Mix en match</strong> </font>– Meng "
"kleuren om aangepaste tinten en prachtige effecten te creëren."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_31
msgid ""
"<font class=\"text-o-color-3\"><strong>Paper &amp; Tools:</strong> </"
"font><font class=\"text-800\">A stack of beautifully patterned origami "
"papers featuring intricate floral and traditional designs, paired with a "
"pair of vintage-style ornate metal scissors.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Papier &amp; benodigdheden:</strong> "
"</font><font class=\"text-800\">Een stapel prachtig origamipapier met "
"gedetailleerde bloemmotieven en traditionele ontwerpen, gecombineerd met een "
"klassieke, sierlijke metalen schaar.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Smooth acrylic formula</strong> </"
"font>– Ideal for creating even coverage and expressive brushstrokes."
msgstr ""
"<font class=\"text-o-color-3\"><strong>Vloeiende acrylformule</strong> </"
"font>– Ideaal voor het creëren van een gelijkmatige dekking en expressieve "
"penseelstreken."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-o-color-3\"><strong>Total Height:</strong> </font><font "
"class=\"text-800\">Adjustable from <strong>150 cm to 230 cm</"
"strong> depending on mast extension.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Totale hoogte:</strong> </font><font "
"class=\"text-800\">Instelbaar van <strong>150 cm tot 230 cm</strong> "
"afhankelijk van mast-extensie.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<font class=\"text-o-color-3\"><strong>Type:</strong></font><font "
"class=\"text-o-color-5\"> </font><font class=\"text-800\">Classic Tripod A-"
"Frame Studio Easel.</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Type:</strong></font><font "
"class=\"text-o-color-5\"> </font><font class=\"text-800\">Klassieke statief "
"A-frame studio-schildersezel.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<font class=\"text-o-color-3\"><strong>Ultra-Soft Texture:</strong> </"
"font>S<font class=\"text-800\">pun from premium fibers to ensure a smooth, "
"snag-free experience that is gentle on your hands and luxurious to the touch."
"</font>"
msgstr ""
"<font class=\"text-o-color-3\"><strong>Ultrazachte textuur:</strong> </font>"
"<font class=\"text-800\">Gesponnen van hoogwaardige vezels voor een soepele, "
"haakvrije ervaring die zacht is voor je handen en luxe aanvoelt.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<font class=\"text-o-color-3\"><strong>Versatile use</strong> </font>– "
