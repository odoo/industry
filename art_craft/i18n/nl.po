#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid "<strong><font class=\"text-900\">What’s Inside:</font></strong>"
msgstr "<strong><font class=\"text-900\">Wat zit erin:</font></strong>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">6 vibrant color</font>s</strong> – A "
"versatile range for creating colorful artwork and unique combinations."
msgstr ""
"<strong><font class=\"text-o-color-3\">6 levendige kleuren</font></strong> – "
"Een veelzijdig assortiment voor het maken van kleurrijke kunstwerken en "
"unieke combinaties."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Base Footprint:</font></strong> <font "
"class=\"text-800\">Approximately <strong>95 cm x 75 cm</strong> when fully "
"extended for maximum stability.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Basisafmetingen:</font></strong> "
"<font class=\"text-800\">Ongeveer <strong>95 cm x 75 cm</strong> wanneer "
"volledig uitgeklapt voor maximale stabiliteit.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Comprehensive Selection:</font></"
"strong> <font class=\"text-800\">Includes 11 specialized brushes—Fan, "
"Filbert, Flat, and Round—to handle everything from broad washes to the "
"finest details.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Uitgebreide selectie:</font></strong> "
"<font class=\"text-800\">Bevat 11 gespecialiseerde penselen—waaier, filbert, "
"plat en rond—om alles aan te kunnen, van brede kleurvlakken tot de fijnste "
"details.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Consistent Quality:</font></"
"strong> <font style=\"color: rgb(99, 99, 99);\">Every skein is meticulously "
"dyed to ensure color consistency throughout your entire project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Consistente kwaliteit:</font></strong>"
" <font style=\"color: rgb(99, 99, 99);\">Elke streng is zorgvuldig geverfd "
"om kleurconsistentie te garanderen voor je hele project.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Ergonomic Design:</font></"
"strong> <font class=\"text-800\">Features elegant, matte black handles that "
"offer a comfortable grip and a professional look.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Ergonomisch ontwerp:</font></strong> "
"<font class=\"text-800\">Voorzien van elegante, matzwarte handgrepen die een "
"comfortabele grip en een professionele uitstraling bieden.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Excellent Stitch Definition:</font></"
"strong> <font class=\"text-800\">The high-twist construction ensures your "
"patterns and textures stand out with professional clarity.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Uitstekende steekdefinitie:</font></"
"strong> <font class=\"text-800\">De constructie met hoge torsie zorgt ervoor "
"dat je patronen en texturen opvallen met professionele helderheid.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_28
msgid ""
"<strong><font class=\"text-o-color-3\">Great for all skill levels</font></"
"strong> – Perfect for beginners, hobby artists, students, and creative "
"enthusiasts."
msgstr ""
"<strong><font class=\"text-o-color-3\">Geweldig voor alle "
"vaardigheidsniveaus</font></strong> – Perfect voor beginners, "
"hobbykunstenaars, studenten en creatieve enthousiastelingen."

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Hardware:</font></strong> <font "
"class=\"text-800\">Corrosion-resistant polished brass knobs and fittings for "
"smooth height and tilt adjustments.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Hardware:</font></strong> <font "
"class=\"text-800\">Corrosiebestendige knoppen en fittingen van gepolijst "
"messing voor soepele hoogte- en kantelverstellingen.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">High-Performance Bristles:</font></"
"strong> <font class=\"text-800\">Crafted with high-quality synthetic fibers "
"that maintain their shape and provide smooth, consistent paint flow.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Hoogwaardige borstelharen:</font></"
"strong> <font class=\"text-800\">Gemaakt met hoogwaardige synthetische "
"vezels die hun vorm behouden en zorgen voor een soepele, gelijkmatige "
"verfstroom.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Material:</font></strong> <font "
"class=\"text-800\">Premium, sustainably sourced solid Beechwood with a "
"natural light-oil finish.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Materiaal:</font></strong> <font "
"class=\"text-800\">Hoogwaardig, duurzaam geproduceerd massief beukenhout met "
"een natuurlijke finish van lichte olie.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_27
msgid ""
"<strong><font class=\"text-o-color-3\">Maximum Canvas Height:</font></"
"strong> <font class=\"text-800\">Accommodates canvases up to <strong>120 cm "
"(47 inches)</strong> tall.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Maximale doekhoogte:</font></strong> "
"<font class=\"text-800\">Geschikt voor doeken tot <strong>120 cm</strong> "
"hoog.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_29
msgid ""
"<strong><font class=\"text-o-color-3\">Perfect Weight for Folding:</font></"
"strong> <font class=\"text-800\">Specially selected paper thickness that "
"holds its shape without tearing, making it ideal for beginners and advanced "
"crafters alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Ideaal gewicht om te vouwen:</font></"
"strong> <font class=\"text-800\">Speciaal geselecteerde papierdikte die zijn "
"vorm behoudt zonder te scheuren, waardoor het ideaal is voor zowel beginners "
"als gevorderde knutselaars.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_32
msgid ""
"<strong><font class=\"text-o-color-3\">Premium Presentation:</font></"
"strong> <font class=\"text-800\">Housed in a minimalist, white designer box "
"with a large transparent window, making it an ideal gift for professionals "
"and hobbyists alike.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Premium presentatie:</font></strong> "
"<font class=\"text-800\">Verpakt in een minimalistische, witte designbox met "
"een groot transparant venster, waardoor het een ideaal cadeau is voor zowel "
"professionals als hobbyisten.</font>"

#. module: art_craft
#: model_terms:product.template,description_ecommerce:art_craft.product_template_30
msgid ""
"<strong><font class=\"text-o-color-3\">Signature Color Palette:</font></"
"strong> <font class=\"text-800\">A harmonious blend of rich earth tones and "
"vibrant accents that complement any crochet or knitting project.</font>"
msgstr ""
"<strong><font class=\"text-o-color-3\">Kenmerkend kleurenpalet:</font></"
"strong> <font class=\"text-800\">Een harmonieuze mix van rijke aardetinten "
