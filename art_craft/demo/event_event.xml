<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="event_event_1" model="event.event">
        <field name="is_published" eval="True"/>
        <field name="name">Learn how to paint</field>
        <field name="subtitle">Explore Acrylic, Gouache, and Aquarelle</field>
        <field name="description"><![CDATA[
            <section class="s_text_block o_colored_level">
                <h2>
                    <span class="h4-fs">Unleash Your Inner Artist!</span>
                </h2>
                <p>Join us for a day of creative immersion in our studio. Whether you are a curious beginner or a painter looking to refine your style, this workshop is designed to help you discover the richness of various painting textures and techniques.</p>
                <h3>
                    <span class="h5-fs">What You Will Explore:</span>
                </h3>
                <ul>
                    <li>
                        <strong>Acrylics:</strong> Learn to play with texture, layering, and thick applications to bring depth to your canvas.</li>
                    <li>
                        <strong>Gouache:</strong> Discover the joy of this matte, opaque paint, perfect for vibrant flat colors and precise details.</li>
                    <li>
                        <strong>Aquarelle (Watercolor):</strong> Master transparency, color blending, and water control to create light and poetic atmospheres.</li>
                </ul>
                <h3>
                    <span class="h5-fs">What’s Included:</span>
                </h3>
                <ul>
                    <li>All professional materials provided (brushes, canvases, high-quality paints).</li>
                    <li>Personalized guidance from a passionate instructor.</li>
                    <li>A friendly, inspiring atmosphere perfect for creation.</li>
                    <li>Take your own masterpieces home at the end of the session!</li>
                </ul>
                <h3>
                    <span class="h5-fs">Practical Info:</span>
                </h3>
                <ul>
                    <li>
                        <strong>Location:</strong> Arts-craft, Ramillies.</li>
                    <li>
                        <strong>Level:</strong> All levels welcome.</li>
                    <li>
                        <strong>Booking:</strong> Limited spots available to ensure quality guidance.</li>
                </ul>
                <p>
                    <strong>See what our students created following this workshop:</strong>
                    <br>
                </p>
                <p>
                    <img src="/web/image/art_craft.ir_attachment_1831" alt="A watercolor painting of a mountain landscape with a calm lake, pine trees, and a small cabin." class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/jpeg" data-resize-width="1024" data-mimetype="image/jpeg" style="padding: 10px; width: 33% !important;" loading="lazy">
                    <img src="/web/image/art_craft.ir_attachment_1835" alt="A vibrant abstract painting with expressive splatters and brushstrokes of blue, red, and yellow on canvas." class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="padding: 10px; width: 33% !important;" data-format-mimetype="image/jpeg" data-resize-width="690" data-mimetype="image/jpeg" loading="lazy">
                    <img src="/web/image/art_craft.ir_attachment_1838" alt="An abstract expressive painting with thick, layered brushstrokes and splatters of primary colors—blue, red, and yellow—creating a dynamic and textured composition on a square canvas." class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="padding: 10px; width: 33% !important;" data-format-mimetype="image/jpeg" data-resize-width="690" data-mimetype="image/jpeg" loading="lazy">
                </p>
                <p>
                    <span class="h4-fs">
                        <strong>Are you ready to bring your ideas to life?&nbsp;</strong>
                    </span>
                </p>
            </section>
        ]]></field>
        <field name="cover_properties">{"background-image": "url(\"/web/image/art_craft.ir_attachment_1827\")", "resize_class": "cover_auto", "text_align_class": "", "opacity": "0.6", "background_color_class": "o_cc o_cc3", "background_color_style": ""}</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="stage_id" ref="event.event_stage_booked"/>
        <field name="date_tz" model="res.users" eval="obj().env.ref('base.user_admin').tz or 'Europe/Brussels'"/>
        <field name="date_begin" model="res.users" eval="(DateTime.now().replace(hour=12, minute=30, second=0)).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="date_end" model="res.users" eval="(DateTime.now().replace(hour=14, minute=30) + relativedelta(days=10)).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="lang">en_US</field>
        <field name="question_ids" eval="[(6, 0, [ref('event.event_question_name'), ref('event.event_question_email'), ref('event.event_question_phone')])]"/>
    </record>
    <record id="event_event_2" model="event.event">
        <field name="is_published" eval="True"/>
        <field name="name">Learn how to Crochet</field>
        <field name="subtitle">From First Stitch to Finished Project</field>
        <field name="description"><![CDATA[
            <section class="s_text_block o_colored_level">
                <h2>
                    <span class="h4-fs">Dive into the Relaxing and Rewarding World of Crochet!</span>
                </h2>
                <p>Whether you’ve never held a hook before or want to refresh your skills, this hands-on workshop will guide you step-by-step through the process of creating your very own wool masterpiece.</p>
                <h3>
                    <span class="h5-fs">What You Will Explore:</span>
                </h3>
                <ul>
                    <li>
                        <strong>The Fundamentals:</strong> Getting to know your tools—understanding different yarn weights and hook sizes.</li>
                    <li>
                        <strong>The Core Stitches:</strong> Master the essentials, including the chain stitch, single crochet, and double crochet.</li>
                    <li>
                        <strong>Pattern Reading:</strong> Learn how to decipher simple patterns so you can continue your journey at home.</li>
                    <li>
                        <strong>The Day's Project:</strong> You’ll put your new skills to work immediately by starting a stylish project (such as a modern coaster or a cozy winter headband).
                    </li>
                </ul>
                <h3>
                    <span class="h5-fs">What’s Included:</span>
                </h3>
                <p>Everything you need is provided on-site:</p>
                <ul>
                    <li>An ergonomic crochet hook perfectly suited for beginners.</li>
                    <li>A selection of premium wool yarn from our store's curated collection.</li>
                    <li>A "cheat sheet" guide of the stitches learned to take home.</li>
                    <li>A supportive, creative environment with expert guidance.</li>
                </ul>
                <h3>
                    <span class="h5-fs">Practical Info:</span>
                </h3>
                <ul>
                    <li>
                        <strong>Location:</strong> Arts-craft store, Ramillies.
                    </li>
                    <li>
                        <strong>Level:</strong> Perfect for absolute beginners (adults and teens welcome).
                    </li>
                    <li>
                        <strong>Booking:</strong> Limited spots available to ensure personalized attention for every student
                    </li>
                </ul>
                <p>
                    <span class="h4-fs">
                        <strong>Ready to start your first loop?</strong>
                    </span>
                </p>
            </section>
        ]]></field>
        <field name="cover_properties">{"background-image": "url(\"/web/image/art_craft.ir_attachment_1842\")", "resize_class": "cover_auto", "text_align_class": "", "opacity": "0.6", "background_color_class": "o_cc o_cc3", "background_color_style": ""}</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="stage_id" ref="event.event_stage_new"/>
        <field name="date_tz" model="res.users" eval="obj().env.ref('base.user_admin').tz or 'Europe/Brussels'"/>
        <field name="date_begin" model="res.users" eval="(DateTime.now() + relativedelta(weeks=4)).replace(hour=9, minute=0, second=0).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="date_end" model="res.users" eval="(DateTime.now() + relativedelta(weeks=4)).replace(hour=19, minute=0, second=0).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="lang">en_US</field>
        <field name="question_ids" eval="[(6, 0, [ref('event.event_question_name'), ref('event.event_question_email'), ref('event.event_question_phone')])]"/>
    </record>
    <record id="event_event_3" model="event.event">
        <field name="is_published" eval="True"/>
        <field name="name">Learn the art of origami</field>
        <field name="subtitle">Unlock Your Creativity: One Fold at a Time</field>
        <field name="description"><![CDATA[
            <section class="s_text_block o_colored_level">
                <h2>
                    <span class="h4-fs">The Art of Paper Folding: Patience, Precision, and Peace</span>
                </h2>
                <p>Discover the ancient Japanese art of Origami! This workshop is designed to help you slow down and find focus as you transform flat squares of colorful paper into stunning 3D sculptures.</p>
                <h3>
                    <span class="h5-fs">What You Will Explore:</span>
                </h3>
                <ul>
                    <li>
                        <strong>The Basics of Folding:</strong> Learn the foundational folds—mountain folds, valley folds, and reverse folds—that form the basis of all origami.</li>
                    <li>
                        <strong>Symmetry and Precision:</strong> Understand how geometric accuracy leads to beautiful results
                    </li>
                    <li>
                        <strong>Traditional Models:</strong> We will guide you through creating classic designs such as the iconic paper crane, elegant butterflies, and seasonal flowers.</li>
                    <li>
                        <strong>Creative Variations:</strong> Once you've mastered the basics, learn how to use different paper textures and patterns to give your creations a unique touch.
                    </li>
                </ul>
                <h3>
                    <span class="h5-fs">What’s Included:</span>
                </h3>
                <p>All materials are provided for you to use and take home:</p>
                <ul>
                    <li>A diverse selection of high-quality, authentic origami papers in various colors and patterns.</li>
                    <li>Step-by-step instructional diagrams for each model covered.</li>
                    <li>Personalized guidance from our experienced instructor.</li>
                    <li>A small display box to safely transport your finished paper creations.</li>
                </ul>
                <h3>
                    <span class="h5-fs">Practical Info:</span>
                </h3>
                <ul>
                    <li>
                        <strong>Location:</strong> indu-arts-craft-store, Ramillies.
                    </li>
                    <li>
                        <strong>Level:</strong> Beginners and enthusiasts of all ages (minimum 8+ recommended).
                    </li>
                    <li>
                        <strong>Atmosphere:</strong> A calm, zen-like environment where you can work at your own pace.
                    </li>
                </ul>
                <p>
                    <strong>Results from one of our previous workshop:</strong>
                </p>
                <p>
                    <img src="/web/image/art_craft.ir_attachment_1855" alt="Top-down view of a wooden surface scattered with colorful origami cranes, frogs, butterflies, stars, and sheets of craft paper." class="img img-fluid o_we_custom_image o_attachment_pending_record_id img-thumbnail rounded" style="padding: 10px;" data-format-mimetype="image/jpeg" data-resize-width="690" data-mimetype="image/jpeg" loading="lazy">
                </p>
                <p>
                    <span class="h4-fs">
                        <strong>Are you ready to bring your ideas to life?</strong>
                    </span>
                </p>
            </section>
        ]]></field>
        <field name="cover_properties">{"background-image": "url(\"/web/image/art_craft.ir_attachment_1850\")", "resize_class": "cover_auto", "text_align_class": "", "opacity": "0.6", "background_color_class": "o_cc o_cc3", "background_color_style": ""}</field>
