<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="option_footer_scrolltop" model="ir.ui.view">
        <field name="name">Arts Craft - Scroll To Top Button</field>
        <field name="inherit_id" ref="website.option_footer_scrolltop"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//a[@id='o_footer_scrolltop']" position="attributes">
                <attribute name="class">d-flex align-items-center justify-content-center btn btn-custom bg-o-color-2 text-o-color-5</attribute>
                <attribute name="style">border: 0px solid rgb(255, 255, 255);</attribute>
            </xpath>
        </field>
    </record>
    <record id="template_footer_mega_links" model="ir.ui.view">
        <field name="name">Arts Craft - Mega Links</field>
        <field name="key">website.template_footer_mega_links</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pb24 pt32" data-snippet="s_text_block" data-name="Top Part">
                        <div class="container">
                            <div class="row">
                                <div class="o_colored_level col-lg-2 pt24 pb24 col-4">
                                    <a href="/" class="o_footer_logo logo o-float-start-parent">
                                        <img src="/web/image/art_craft.img_custom_arts_craft_image_13" alt="" class="img-fluid img o_we_custom_image o_attachment_pending_record_id float-start me-auto" style="width: 100% !important;" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="o_colored_level col-lg-5 pt40 col-7">
                                    <p>
                                        <img src="/web/image/art_craft.img_custom_arts_craft_image_14" alt="Serving your creativity since 1955" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="width: 86% !important;" loading="lazy"/>
                                    </p>
                                </div>
                                <div class="col-lg-12 o_colored_level">
                                    <div class="s_hr pb24 pt24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="pb16 o_colored_level col-lg-4">
                                    <h5>About Us</h5>
                                    <p>We’re passionate about helping artists, makers, and creative minds bring their ideas to life. We carefully select products that inspire imagination and make every project more enjoyable.</p>
                                </div>
                                <div class="pb16 o_colored_level col-lg-2">
                                    <h5>Navigation</h5>
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-6 o-contenteditable-true o_colored_level col-lg-12">
                                                <ul class="list-unstyled">
                                                    <li><a href="/">Home</a></li>
                                                    <li><a href="/shop" class="o_translate_inline">Shop</a></li>
                                                    <li><a href="/events" class="o_translate_inline">Workshops</a></li>
                                                    <li><a href="/about-us" class="o_translate_inline">About</a></li><li><a href="/contactus" class="o_translate_inline">Contact us</a></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="pb16 o_colored_level col-lg-2">
                                    <h5>Shop Categories</h5>
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-6 o-contenteditable-true o_colored_level col-lg-12">
                                                <ul class="list-unstyled">
                                                    <li class="oe-nested"><a href="/shop/category/%(art_craft.product_public_category_68)d" class="o_translate_inline">Fine arts</a></li>
                                                    <li><a href="/shop/category/%(art_craft.product_public_category_67)d" class="o_translate_inline">Fiber arts</a></li>
                                                    <li><a href="/shop/category/%(art_craft.product_public_category_69)d" class="o_translate_inline">Paper craft</a></li>
                                                    <li><a href="/shop/category/%(art_craft.product_public_category_70)d" class="o_translate_inline">Craft supplies</a></li>
                                                </ul>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <div class="pb16 o_colored_level col-lg-4">
                                    <h5>
                                        <span class="text-o-color-4">Opening Hours</span>
                                    </h5>
                                    <p>
                                        <span class="text-o-color-4">
                                            <strong>Tuesday – Friday: </strong>
                                        </span>
                                        <span style="color: rgb(206, 198, 206);">8:30 AM – 6:00 PM<br />
                                        </span>
                                        <span class="text-o-color-4">
                                            <strong>Saturday – Sunday:</strong>
                                        </span>
                                        <span style="color: rgb(206, 198, 206);">8:30 AM – 8:00 PM</span>
                                        <br />
                                        <span class="text-o-color-4">
                                            <strong>Monday:</strong>
                                        </span>
                                        <span style="color: rgb(206, 198, 206);">Closed</span>
                                    </p>
                                    <h5>
                                        <strong>
                                            <span class="text-o-color-4">Get in Touch</span>
                                        </strong>
                                    </h5>
                                    <p>
                                        <span style="color: rgb(206, 198, 206);">
                                            <span class="oi oi-filled text-o-color-4" data-icon="mail" style="padding: 3px;" />
                                            <a href="mailto:info@artscraft.example.com" class="o_translate_inline">info@artscraft.example.com</a>
                                            <br />
                                            <span class="oi text-o-color-4" data-icon="phone" style="padding: 3px;" />
                                            <a href="tel:+3281813700" class="o_translate_inline">+32 81 81 37 00</a>
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_text_block o_footer_bottom_part pt8 pb8 o_colored_level" style="position: relative; background-color: rgba(0, 0, 0, 0.05);" data-snippet="s_text_block" data-name="Bottom Part">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-12 pt8 pb8 o_colored_level">
                                    <div class="s_social_media o_not_editable no_icon_color text-start" data-snippet="s_social_media" data-name="Social Media">
                                        <p class="s_social_media_title d-none">Follow us</p>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank">
                                            <i class="oi o_editable_media o_cc o_cc2 rounded-circle shadow-sm text-o-color-4" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.youtube.com/your-page" class="s_social_media_youtube" target="_blank">
                                            <i class="oi o_editable_media o_cc o_cc2 rounded-circle shadow-sm text-o-color-4" data-icon="oi_youtube-play"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
            <xpath expr="//t[@t-call='web.brand_promotion']/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
