    <record id="view_page_about_us" model="ir.ui.view">
        <field name="name">About Us</field>
        <field name="key">art_craft.page_about_us</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="About Us" t-name="art_craft.page_about_us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <div class="s_hr o_colored_level o_cc o_cc4 pt120 pb40" data-snippet="s_hr" data-name="Separator">
                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                        </div>
                        <section class="s_text_image pb80 o_colored_level o_cc o_cc1 pt48" data-snippet="s_image_text" data-name="Image - Text" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Miscellaneous/05&quot;,&quot;colors&quot;:{&quot;c3&quot;:&quot;o-color-4&quot;,&quot;c4&quot;:&quot;o-color-1&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                            <div class="o_we_shape o_html_builder_Miscellaneous_05 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FMiscellaneous%2F05.svg?c3=%23FFFFFFF7&amp;c4=%23D1E6E7&amp;flip=y&quot;); background-position: 50% 0%;"/>
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="11">
                                    <div class="o_colored_level o_grid_item g-col-lg-6 g-height-8 col-lg-6 o_animate o_visible o_anim_slide_in o_anim_from_bottom" style="grid-area: 3 / 1 / 11 / 7; z-index: 1; animation-delay: 0.3s; animation-duration: 0.8s; animation-name: dummy;">
                                        <h1 class="display-1">
                                            <span class="h1-fs">A Family <span data-text-effect="{&quot;preset&quot;:&quot;custom&quot;,&quot;shadows&quot;:[{&quot;shadowColor&quot;:&quot;var(--o-color-2)&quot;,&quot;shadowOffsetX&quot;:&quot;2px&quot;,&quot;shadowOffsetY&quot;:&quot;2px&quot;,&quot;shadowBlur&quot;:&quot;0px&quot;}],&quot;presetHash&quot;:&quot;86863946&quot;}" style="text-shadow: 2px 2px 0px var(--o-color-2);">History</span>
                                            </span>
                                        </h1>
                                        <p>
                                            <span class="h5-fs">
                                                Our story began in the <span class="text-o-color-3"><strong>1955</strong></span>
                                            </span>
                                        </p>
                                        <p>
                                            With a small DIY shop called <strong>The Craft &amp;amp; Hobby Nook</strong>. The shop offered a wide variety of products for everyday DIY projects, hobbies, and creative activities, helping customers discover the joy of making things with their own hands.
                                        </p>
                                        <p>
                                            As creative hobbies grew in popularity, so did the demand for dedicated art and craft materials. In the <strong>1970s</strong>, the shop gradually began focusing more strongly on <strong>art and craft supplies</strong>, expanding its range to meet the needs of artists, makers, and hobby enthusiasts.
                                        </p>
                                        <p>
                                            <br />
                                        </p>
                                    </div>
                                    <div class="o_colored_level o_grid_item g-col-lg-5 g-height-11 col-lg-5 o_grid_item_image o_anim_from_bottom_right o_anim_rotate_in o_animate o_visible" style="z-index: 2; grid-area: 1 / 8 / 12 / 13; --wanim-intensity: 26; animation-duration: 0.8s;">
                                        <img src="/web/image/art_craft.img_custom_arts_craft_image_01" alt="old photo of  craft &amp; hobby nook 's facadestore" class="img img-fluid o_we_custom_image o_attachment_pending_record_id rounded o_editable_media img-thumbnail" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy" style="height: auto; transform: rotate(5deg);"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_image o_cc o_cc1 pt32 o_colored_level pb96" data-snippet="s_image_text" data-name="Image - Text" style="position: relative;">
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="11">
                                    <div class="o_colored_level o_grid_item g-col-lg-6 col-lg-6 g-height-9 o_anim_slide_in o_anim_from_bottom o_animate o_animate_both_scroll o_visible" style="grid-area: 2 / 7 / 11 / 13; z-index: 2;">
                                        <h2>
                                            <span class="display-4-fs">A New <span data-text-effect="{&quot;preset&quot;:&quot;custom&quot;,&quot;shadows&quot;:[{&quot;shadowColor&quot;:&quot;var(--o-color-2)&quot;,&quot;shadowOffsetX&quot;:&quot;2px&quot;,&quot;shadowOffsetY&quot;:&quot;2px&quot;,&quot;shadowBlur&quot;:&quot;0px&quot;}],&quot;presetHash&quot;:&quot;86863946&quot;}" style="text-shadow: 2px 2px 0px var(--o-color-2);">Era</span>
                                            </span>
                                        </h2>
                                        <p>
                                            <span class="h5-fs">
                                                The story took another important turn in the <strong><span class="text-o-color-3">1998</span></strong>
                                            </span>
                                        </p>
                                        <p>
                                            When the founder's grandson, <strong>Julian Bennett</strong> decided to reshape and modernize the family business. He developed a new identity for the brand and transformed it into a growing chain of stores under the name <strong>Arts Craft</strong>.
                                        </p>
                                        <p>
                                            Through every generation, the name and identity may have evolved, but the original passion has remained unchanged: <strong>making creativity accessible to everyone</strong>.
                                        </p>
                                        <p>
                                            Today, Arts Craft carries this heritage forward with a wide selection of supplies for <strong>fine arts, paper crafts, fiber arts, and creative hobbies</strong>. Whether you're an experienced artist or simply discovering a new passion, we provide the tools and materials to turn your ideas into something truly your own.
                                        </p>
                                        <p>
                                            <br />
                                        </p>
                                    </div>
                                    <div class="o_colored_level o_grid_item g-col-lg-5 g-height-11 col-lg-5 o_grid_item_image o_anim_rotate_in o_anim_from_bottom_left o_animate o_visible" style="z-index: 1; grid-area: 1 / 1 / 12 / 6; --wanim-intensity: 23; animation-duration: 0.8s;">
                                        <img src="/web/image/art_craft.img_custom_arts_craft_image_02" alt="A customer browsing art supplies in an Arts &amp; Craft store while an employee assists another customer at the checkout counter" class="img img-fluid mx-auto o_we_custom_image o_attachment_pending_record_id rounded o_editable_media img-thumbnail" style="transform: rotate(-10deg);" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_three_columns o_cc o_colored_level pb0 pt0 o_cc4 s_custom_snippet" data-vxml="001" data-vcss="001" data-snippet="s_three_columns" style="position: relative; background-color: rgb(235, 244, 245);" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Miscellaneous/05&quot;,&quot;colors&quot;:{&quot;c3&quot;:&quot;o-color-4&quot;,&quot;c4&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" data-format-mimetype="image/webp" data-scroll-background-ratio="0" data-name="Custom Columns (2)"><div class="o_we_shape o_html_builder_Miscellaneous_05" style="background-image: url(&quot;/html_editor/shape/html_builder%2FMiscellaneous%2F05.svg?c3=%23FFFFFFF7&amp;c4=%23FFFFFFF7&amp;flip=y&quot;); background-position: 50% 0%;"/>
                                <div class="container">
                                    <div class="row d-flex o_grid_mode" data-row-count="10">
                                        <div data-name="Card" class="o_grid_item g-col-lg-7 g-height-4 col-lg-7 order-lg-0" style="grid-area: 4 / 6 / 8 / 13; z-index: 2; --grid-item-padding-y: 20px; --grid-item-padding-x: 20px; order: 0;">
                                            <div class="s_card o_card_img_top card h-100 my-0 o_colored_level border rounded" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; border-color: rgba(255, 255, 255, 0) !important; --box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px;">
                                                <div class="card-body">
                                                    <h2>Get <span data-text-effect="{&quot;preset&quot;:&quot;custom&quot;,&quot;shadows&quot;:[{&quot;shadowColor&quot;:&quot;var(--o-color-2)&quot;,&quot;shadowOffsetX&quot;:&quot;3px&quot;,&quot;shadowOffsetY&quot;:&quot;3px&quot;,&quot;shadowBlur&quot;:&quot;0px&quot;}],&quot;presetHash&quot;:&quot;e4bc5908&quot;}" style="text-shadow: 3px 3px 0px var(--o-color-2);">Creative</span> with Us</h2>
                                                    <p class="card-text">
                                                        Get inspired! Discover the latest <strong>DIY ideas, creative projects, craft tips, new products, and workshop news</strong>, delivered into straight to your inbox.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="o_grid_item o_grid_item_image o_grid_item_image_contain g-col-lg-5 g-height-10 col-lg-5 offset-1 offset-lg-0 col-11 o_animate o_animate_on_scroll o_anim_slide_in o_anim_from_left order-lg-0" style="z-index: 3; --grid-item-padding-y: 0px; grid-area: 1 / 1 / 11 / 6; --grid-item-padding-x: 0px; order: 2;" data-scroll-zone-start="0" data-scroll-zone-end="100"><img src="/web/image/art_craft.img_custom_arts_craft_image_03" alt="Man wearing a black beret and a red-and-white striped shirt, holding a smartphone with a surprised expression." class="img img-fluid o_we_custom_image o_editable_media o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/></div><div class="o_grid_item g-col-lg-6 o_we_padding_highlight g-height-2 col-lg-6 order-lg-0" style="z-index: 4; --grid-item-padding-y: 0px; --grid-item-padding-x: 30px; grid-area: 8 / 6 / 10 / 12; order: 1;"><div data-vxml="001" data-name="Newsletter" class="s_newsletter_subscribe_form s_newsletter_list js_subscribe" data-snippet="s_newsletter_subscribe_form" data-list-id="%(mass_mailing.mailing_list_data)d">
                                            <div class="js_subscribed_wrap d-none">
                                                <p class="h4-fs text-center text-success"><i class="oi" data-icon="check_circle" role="img"/> Thanks for registering!</p>
                                            </div>
                                            <div class="js_subscribe_wrap">
                                                <div class="input-group">
                                                    <input type="email" name="email" placeholder="Email Address" class="s_newsletter_subscribe_form_input js_subscribe_value form-control "/>
                                                    <a role="button" href="#" class="js_subscribe_btn o_submit o_translate_inline btn btn-secondary">Subscribe</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
