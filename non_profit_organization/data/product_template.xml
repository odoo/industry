<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="product_template_8" model="product.template"
        context="{'create_product_product': False}">
        <field name="image_1920" type="bytes"
            file="non_profit_organization/static/src/binary/product_template/8-image_1920.jpg"/>
        <field name="name">Children’s Book – “Green on Green”</field>
        <field name="categ_id" ref="product_category_7"/>
        <field name="list_price">10.0</field>
        <field name="service_type">manual</field>
        <field name="invoice_policy">order</field>
        <field name="description_ecommerce"><![CDATA[<div data-oe-version="2.0">A heartwarming illustrated book teaching kids about rivers, forests, and caring for the planet. Written and illustrated by educators and environmentalists. Ideal for ages 6–10.</div>]]></field>
        <field name="website_sequence">10035</field>
    </record>
    <record id="product_template_7" model="product.template"
        context="{'create_product_product': False}">
        <field name="image_1920" type="bytes"
            file="non_profit_organization/static/src/binary/product_template/7-image_1920.jpg"/>
        <field name="name">Uplift Notebook</field>
        <field name="categ_id" ref="product_category_7"/>
        <field name="list_price">8.0</field>
        <field name="service_type">manual</field>
        <field name="invoice_policy">order</field>
        <field name="description_ecommerce"><![CDATA[<div data-oe-version="2.0">A beautifully designed A5 notebook with quotes from environmental pioneers and defenders. Perfect for conservationists, students, and dreamers.</div>]]></field>
        <field name="website_sequence">10030</field>
    </record>
    <record id="product_template_4" model="product.template"
        context="{'create_product_product': False}">
        <field name="name">Membership</field>
        <field name="image_1920" type="bytes"
            file="non_profit_organization/static/src/binary/product_template/4-image_1920.jpg"/>
        <field name="description"><![CDATA[<div data-oe-version="2.0">Not included in fiscal certificate totals.</div>]]></field>
        <field name="type">service</field>
        <field name="service_tracking">partnership</field>
        <field name="categ_id" ref="product_category_6"/>
        <field name="grade_id" ref="res_partner_grade_membership"/>
        <field name="list_price">50.0</field>
        <field name="purchase_ok" eval="False"/>
        <field name="service_type">manual</field>
        <field name="invoice_policy">order</field>
        <field name="recurring_invoice" eval="True"/>
        <field name="description_ecommerce"><![CDATA[<div data-oe-version="2.0">Your membership supports our mission to protect rivers, restore forests, and safeguard the ecosystems that depend on them. As a member, you will have voting rights at our General Assembly and receive exclusive updates on our work and campaigns.&nbsp;</div><div><em><strong>​<br></strong></em></div><div><em><strong>Please note: membership fees are not eligible for a fiscal certificate.</strong></em></div>]]></field>
        <field name="website_sequence">10015</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('product_public_category_9')])]"/>
    </record>
    <record id="product_template_5" model="product.template"
        context="{'create_product_product': False}">
        <field name="image_1920" type="bytes"
            file="non_profit_organization/static/src/binary/product_template/5-image_1920.jpg"/>
        <field name="name">Uplift Candle (Set of 3)</field>
        <field name="categ_id" ref="product_category_7"/>
        <field name="list_price">15.0</field>
        <field name="service_type">manual</field>
        <field name="invoice_policy">order</field>
        <field name="description_ecommerce"><![CDATA[<div data-oe-version="2.0">A set of 3 handmade candles created in collaboration with local artisans. Light a candle for the planet and support our cause with every purchase. Profits fund river and forest conservation education.</div>]]></field>
        <field name="website_sequence">10020</field>
    </record>
    <record id="product_template_6" model="product.template"
        context="{'create_product_product': False}">
        <field name="image_1920" type="bytes"
            file="non_profit_organization/static/src/binary/product_template/6-image_1920.jpg"/>
        <field name="name">Uplift Tote Bag</field>
        <field name="categ_id" ref="product_category_7"/>
        <field name="list_price">12.0</field>
        <field name="service_type">manual</field>
        <field name="invoice_policy">order</field>
        <field name="description_ecommerce"><![CDATA[<div data-oe-version="2.0">Carry your values with you. This 100% organic cotton tote bag is both practical and powerful. Screen-printed with our slogan: <em>Protect Rivers, Protect Forests.</em></div>]]></field>
        <field name="website_sequence">10025</field>
    </record>
    <record id="event_product.product_product_event_product_template" model="product.template" context="{'create_product_product': False}" forcecreate="1">
        <field name="name">Event Registration</field>
        <field name="image_1920" type="bytes"
            file="non_profit_organization/static/src/binary/product_template/3-image_1920.png"/>
        <field name="type">service</field>
        <field name="service_tracking">event</field>
        <field name="categ_id" ref="event_product.product_category_events"/>
        <field name="list_price">30.0</field>
        <field name="service_type">manual</field>
        <field name="invoice_policy">order</field>
    </record>
</odoo>
