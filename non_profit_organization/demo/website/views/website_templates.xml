<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_sale_product_oe_structure_website_sale_product_2" model="ir.ui.view">
        <field name="name">Custom Uplift - Product (oe_structure_website_sale_product_2)</field>
        <field name="key">website_sale.product_oe_structure_website_sale_product_2</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_sale_product_2']" position="replace">
                <div class="oe_structure oe_empty oe_structure_not_nearest mt16" id="oe_structure_website_sale_product_2" data-editor-message="Drag blocks here to add them on all products">
                    <section class="s_announcement_scroll s_announcement_scroll_direction_left s_announcement_scroll_hover_pause w-100 o_colored_level o_cc o_cc3 pt112 pb56 s_announcement_scroll_parallax s_custom_snippet" style="--marquee-animation-speed: 5s; --marquee-item-font-size: 80; position: relative;" role="marquee" data-snippet="s_announcement_scroll" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/13&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#FFFFFF&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" data-name="Custom Announcement Scroll"><div class="o_we_shape o_html_builder_Connections_13 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F13.svg?c5=%23FFFFFF&amp;flip=y&quot;); background-position: 50% 0%;"/>
                        <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                            <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">• Protecting rivers and forests, together</div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="website_sale_products_oe_structure_website_sale_products_2" model="ir.ui.view">
        <field name="name">Custom Uplift - Products (oe_structure_website_sale_products_2)</field>
        <field name="key">website_sale.products_oe_structure_website_sale_products_2</field>
        <field name="inherit_id" ref="website_sale.products"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_sale_products_2']" position="replace">
                <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_products_2" data-editor-message-default="true" data-editor-message="Drag blocks here">
                    <section class="s_announcement_scroll s_announcement_scroll_direction_left s_announcement_scroll_hover_pause w-100 o_colored_level o_cc o_cc3 pt112 pb56 s_announcement_scroll_parallax s_custom_snippet" style="--marquee-animation-speed: 5s; --marquee-item-font-size: 80; position: relative;" role="marquee" data-snippet="s_announcement_scroll" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/13&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#FFFFFF&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" data-name="Custom Announcement Scroll"><div class="o_we_shape o_html_builder_Connections_13 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F13.svg?c5=%23FFFFFF&amp;flip=y&quot;); background-position: 50% 0%;"/>
                        <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                            <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">• Protecting rivers and forests, together</div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom Uplift - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/#Donate" class="oe_unremovable btn btn-secondary">Donate</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_call_to_action" model="ir.ui.view">
        <field name="name">Custom Uplift - Call-to-Action</field>
        <field name="key">website.template_footer_call_to_action</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_call_to_action pt56 pb32" data-snippet="s_call_to_action" data-name="Container" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/14&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-2&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}">
                        <div class="o_we_shape o_html_builder_Connections_14 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F14.svg?c5=%23B3A8EF&amp;flip=y&quot;); background-position: 50% 0%;"/>
                        <div class="s_allow_columns container">
                            <div class="row o_grid_mode" data-row-count="3">
                                <div class="o_grid_item g-height-2 offset-1 offset-lg-0 order-lg-0 col-lg-6 o_colored_level g-col-lg-7 col-lg-7 o_animate o_anim_fade_in o_visible" style="z-index: 1; --grid-item-padding-x: 10px; --grid-item-padding-y: 0px; grid-area: 1 / 1 / 3 / 8; order: 0; animation-name: dummy;">
                                    <h2 class="h3-fs"><strong>+50,000 volunteers</strong> have joined Uplift to protect rivers and forests.</h2>
                                </div>
                                <div class="o_grid_item order-lg-0 g-height-2 o_colored_level g-col-lg-4 col-lg-4 o_animate o_anim_fade_in o_visible" style="text-align: end; z-index: 2; --grid-item-padding-x: 10px; --grid-item-padding-y: 0px; grid-area: 1 / 9 / 3 / 13; order: 2; animation-delay: 0.2s; animation-name: dummy;">
                                    <a href="*membership_product*" class="btn btn-lg btn-primary">Become a Member</a>
                                </div>
                                <div class="o_grid_item g-col-lg-7 offset-1 offset-lg-0 order-lg-0 col-10 g-height-1 col-lg-7 o_colored_level o_animate o_anim_fade_in o_visible" style="z-index: 4; --grid-item-padding-x: 10px; grid-area: 3 / 1 / 4 / 8; order: 1; --grid-item-padding-y: 12px; animation-delay: 0.1s; animation-name: dummy;">
                                    <p>Chaussée de Namur 40, Ramillies (Belgium)</p>
                                    <div class="s_hr d-lg-none o_snippet_desktop_invisible pb16 pt16" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="o_grid_item g-height-1 order-lg-0 o_colored_level g-col-lg-4 col-lg-4" style="--grid-item-padding-x: 10px; grid-area: 3 / 9 / 4 / 13; order: 3; --grid-item-padding-y: 12px;">
                                    <p style="text-align: end;">
                                        <a class="o_translate_inline" href="mailto:info@uplift.example.com">info@uplift.example.com</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom Uplift - Footer Copyright Company Name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">
                    Copyright &amp;copy; <span t-out="res_company.name"/>
                </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
