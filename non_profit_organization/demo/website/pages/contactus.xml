<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">non_profit_organization.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="non_profit_organization.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email,'name': request.params.get('name', ''),'phone': request.params.get('phone', ''),'email_from': request.params.get('email_from', ''),'company': request.params.get('company', ''),'subject': request.params.get('subject', ''),}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block pb40 o_colored_level o_cc o_cc2 pt136" data-snippet="s_text_block" data-name="Text" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Blurry/04&quot;,&quot;colors&quot;:{&quot;c1&quot;:&quot;o-color-4&quot;,&quot;c2&quot;:&quot;o-color-1&quot;,&quot;c3&quot;:&quot;o-color-3&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                            <div class="o_we_shape o_html_builder_Blurry_04" style="background-image: url(&quot;/html_editor/shape/html_builder%2FBlurry%2F04.svg?c1=%23FFFFFF&amp;c2=%23A5EEFF&amp;c3=%23EBFBFF&quot;);"/>
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="mt-4 mt-lg-0 o_colored_level col-lg-5">
                                        <h1>Let's<br/><strong>Connect</strong></h1>
                                        <div class="s_hr pb16 pt16" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                        </div>
                                        <ul class="list-unstyled mb-0 ps-2">
                                            <li>
                                                <img src="/web/image/non_profit_organization.img_custom_uplift_image_19" alt="Icon map" class="me-2 img img-fluid o_we_custom_image o_attachment_pending_record_id" loading="lazy"/>
                                                <span class="o_force_ltr">Chaussée de Namur 40, Ramillies (Belgium)</span>
                                            </li>
                                            <li>
                                                <img src="/web/image/non_profit_organization.img_custom_uplift_image_20" alt="Icon phone" class="me-2 img img-fluid o_we_custom_image o_attachment_pending_record_id" loading="lazy"/>
                                                <span class="o_force_ltr">+32 2 616 80 02</span>
                                            </li>
                                            <li>
                                                <img src="/web/image/non_profit_organization.img_custom_uplift_image_21" alt="Icon mail" class="me-2 img img-fluid o_we_custom_image o_attachment_pending_record_id" loading="lazy"/>
                                                <span>
                                                    <a href="mailto:info@uplift.example.com" class="o_translate_inline">info@uplift.example.com</a>
                                                </span>
                                            </li>
                                        </ul>
                                        <p>
                                            <br/>
                                        </p>
                                        <p>
                                            <img src="/web/image/non_profit_organization.img_custom_uplift_image_22" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="1500" data-mimetype="image/svg+xml" data-shape="html_builder/geometric_round/geo_round_clover" data-aspect-ratio="1/1" data-file-name="uplift-product-member.svg" loading="lazy" style="width: 90% !important;"/>
                                        </p>
                                    </div>
                                    <div class="col-lg-7 mt-4 mt-lg-0 o_colored_level rounded o_cc o_cc1 border" style="--box-border-bottom-left-radius: 20px; --box-border-bottom-right-radius: 20px; --box-border-top-right-radius: 20px; --box-border-top-left-radius: 20px; border-left-color: var(--o-color-4) !important; border-bottom-color: var(--o-color-4) !important; border-right-color: var(--o-color-4) !important; border-top-color: var(--o-color-4) !important; --box-border-left-width: 30px; --box-border-bottom-width: 40px; --box-border-right-width: 30px; --box-border-top-width: 40px;">
                                        <h2>
                                            <span class="h3-fs">
                                                <strong>Contact Us</strong>
                                            </span>
                                        </h2>
                                        <div class="s_hr pb32 pt16" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-25 me-auto" style="border-top-color: var(--o-color-2); border-top-width: 2px;"/>
                                        </div>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact1">
                                                                <span class="s_website_form_label_content">
                                                                    Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact1" type="text" class="form-control s_website_form_input" name="name" required="" data-fill-with="name"/>
                                                        </div>
                                                        <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact2">
                                                                <span class="s_website_form_label_content">Phone
                                                                    Number</span>
                                                            </label>
                                                            <input id="contact2" type="tel" class="form-control s_website_form_input" name="phone" data-fill-with="phone"/>
                                                        </div>
                                                        <div class="mb-3 s_website_form_field s_website_form_required s_website_form_model_required col-lg-12" data-type="email" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact3">
                                                                <span class="s_website_form_label_content">
                                                                    Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact3" type="email" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email"/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact5">
                                                                <span class="s_website_form_label_content">
                                                                    Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact5" type="text" class="form-control s_website_form_input" name="subject" required=""/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required" data-type="text" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact6">
                                                                <span class="s_website_form_label_content">
                                                                    Question</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea id="contact6" class="form-control s_website_form_input" name="description" required="" rows="8"/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="contact7">
                                                                    <span class="s_website_form_label_content">Email
                                                                        To</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input id="contact7" type="hidden" class="form-control s_website_form_input" name="email_to"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" data-name="Submit Button"><div style="width: 200px;" class="s_website_form_label"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send">
                                                                Submit
                                                            </a>
                                                            <span id="s_website_form_result"/>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_announcement_scroll s_announcement_scroll_direction_left s_announcement_scroll_hover_pause w-100 o_colored_level o_cc o_cc3 pt112 pb56 s_announcement_scroll_parallax s_custom_snippet" style="--marquee-animation-speed: 5s; --marquee-item-font-size: 80; position: relative;" role="marquee" data-snippet="s_announcement_scroll" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/13&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-3&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" data-name="Custom Announcement Scroll">
                            <div class="o_we_shape o_html_builder_Connections_13 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F13.svg?c5=%23EBFBFF&amp;flip=y&quot;); background-position: 50% 0%;"/>
                            <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                                <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">• Protecting rivers and forests, together</div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
