<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="event_event_1" model="event.event">
        <field name="name">Clean River Day</field>
        <field name="stage_id" ref="event.event_stage_new"/>
        <field name="seats_max">0</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="seats_limited" eval="True"/>
        <field name="date_begin" eval="datetime.today().date() + relativedelta(months=1, hours=8)"/>
        <field name="date_end" eval="datetime.today().date() + relativedelta(months=1, hours=18)"/>
    </record>
    <record id="event_event_2" model="event.event">
        <field name="name">Forest Restoration Weekend</field>
        <field name="stage_id" ref="event.event_stage_new"/>
        <field name="seats_max">50</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="seats_limited" eval="True"/>
        <field name="is_published" eval="True"/>
        <field name="tag_ids" eval="[(6, 0, [ref('event_tag_3'),ref('event_tag_2'),ref('event_tag_1')])]"/>
        <field name="date_begin"
            eval="datetime.today().date() + relativedelta(months=1, days=4, hours=14)"/>
        <field name="date_end"
            eval="datetime.today().date() + relativedelta(months=1, days=4, hours=18)"/>
        <field name="cover_properties"><![CDATA[{"background-image":"url(/web/image/non_profit_organization.ir_attachment_1378)"}]]></field>
        <field name="description"><![CDATA[
            <section class=\"s_text_block o_colored_level\">
                <p>Spend a weekend hands-on in the woods, helping us plant native trees and restore areas of forest damaged by past logging, fire, or neglect. Led by our forest restoration team, you'll learn how to properly plant saplings, why native species matter for biodiversity, and how healthy forests support everything from water cycles to local wildlife.</p>
                <h2>
                    <span class="h4-fs"><strong>What You'll Learn</strong></span>
                </h2>
                <ul>
                    <li>How to plant and care for native saplings</li>
                    <li>Why species diversity matters for a resilient forest</li>
                    <li>How forests protect water cycles and riverbanks</li>
                    <li>How to run a restoration site safely</li>
                </ul>
                <h2>
                    <span class="h4-fs"><strong>Event Details</strong></span>
                </h2>
                <p>📅 <strong>Duration</strong>: a full weekend, with the option to stay overnight at a nearby campsite</p>
                <p>
                    📍 <strong>Location</strong>: restoration site, meeting point shared on registration</p>
                <p>
                    💡 <strong>Entry</strong>: Free - Registration required (limited seats)</p>
                <h2>
                    <span class="h4-fs"><strong>Who Should Attend?</strong></span>
                </h2>
                <ul>
                    <li>Volunteers of every experience level</li>
                    <li>Students and teachers</li>
                    <li>Local community members</li>
                    <li>Anyone ready to get their hands dirty</li>
                </ul>
                <h2>
                    <span class="h4-fs"><strong>Extras</strong></span>
                </h2>
                <p>☕️ Coffee and shared meals included</p>
                <p>🎁 Tools and gloves provided</p>
                <p>📝 Certificate of participation</p>
            </section>
            ]]>
        </field>
    </record>
    <record id="event_event_3" model="event.event">
        <field name="name">Refugee Welcome Pack Distribution</field>
        <field name="stage_id" ref="event.event_stage_new"/>
        <field name="seats_max">15</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="seats_limited" eval="True"/>
        <field name="date_begin" eval="datetime.today().date() + relativedelta(months=2, hours=8)"/>
        <field name="date_end" eval="datetime.today().date() + relativedelta(months=2, hours=18)"/>
    </record>
    <record id="event_event_4" model="event.event">
        <field name="name">2025 Annual General Assembly</field>
        <field name="stage_id" ref="event.event_stage_booked"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="date_begin"
            eval="datetime.today().date() + relativedelta(months=1, days=20, hours=10)"/>
        <field name="date_end"
            eval="datetime.today().date() + relativedelta(months=1, days=20, hours=16)"/>
    </record>
    <record id="event_event_5" model="event.event">
        <field name="name">World Rivers Day Walk</field>
        <field name="stage_id" ref="event.event_stage_booked"/>
        <field name="seats_max">500</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="seats_limited" eval="True"/>
        <field name="is_published" eval="True"/>
        <field name="tag_ids" eval="[(6, 0, [ref('event_tag_3'),ref('event_tag_2'),ref('event_tag_4')])]"/>
        <field name="date_begin"
            eval="datetime.today().date() + relativedelta(months=2, days=10, hours=17)"/>
        <field name="date_end"
            eval="datetime.today().date() + relativedelta(months=2, days=10, hours=23)"/>
        <field name="cover_properties"><![CDATA[{"background-image":"url(/web/image/non_profit_organization.ir_attachment_1381)"}]]></field>
        <field name="description"><![CDATA[
            <section class="s_text_block o_colored_level">
                <p>Mark World Rivers Day with a guided walk along protected river paths, learning about the ecosystems, wildlife, and history connected to the water we're working to protect. The walk is family-friendly, suitable for all fitness levels, and ends with a community gathering where local groups share their own river-related projects and stories.</p>
                <h2>
                    <span class="h4-fs"><strong>What to Expect</strong></span>
                </h2>
                <ul>
                    <li>A guided walk along protected riverbanks</li>
                    <li>Insights into water conservation efforts and the challenges rivers face</li>
                    <li>Simple actions everyone can take to help</li>
                    <li>A closing community gathering with local groups</li>
                </ul>
                <h2>
                    <span class="h4-fs"><strong>Event Details</strong></span>
                </h2>
                <p>📅 <strong>Duration</strong>: an afternoon and evening</p>
                <p>
                    📍 <strong>Location</strong>: protected river path, meeting point shared on registration</p>
                <p>
                    🎟️ <strong>Ticket</strong>: €30
                </p>
                <div class="s_alert alert w-100 clearfix s_alert_md alert-secondary" role="alert" data-vcss="001" data-snippet="s_alert" data-name="Alert">
                    <i class="fa fa-leaf fa-stack d-flex align-items-center justify-content-center me-3 p-2 rounded-1 s_alert_icon fa-lg" contenteditable="false" />
                    <div class="s_alert_content">
                        <p><strong>Important</strong><br />All proceeds support our river monitoring and cleanup programs.</p>
                    </div>
                </div>
                <h2>
                    <span class="h4-fs"><strong>Who Should Attend?</strong></span>
                </h2>
                <ul>
                    <li>Families and first-time volunteers</li>
                    <li>Longtime members &amp; supporters</li>
                    <li>Youth leaders &amp; educators</li>
                    <li>Anyone who cares about clean water</li>
                </ul>
                <h2>
                    <span class="h4-fs"><strong>Accessibility &amp; Extras</strong></span>
                </h2>
                <p>♿︎ Accessible route available on request</p>
                <p>
                    🍽️ Vegetarian, vegan &amp; allergy-safe options at the gathering
                </p>
                <p>
                    📝 Certificate of attendance (for professionals/volunteers)
                </p>
            </section>]]>
        </field>
    </record>
</odoo>
