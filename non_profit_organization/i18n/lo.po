#. module: non_profit_organization
#: model:mail.template,body_html:non_profit_organization.mail_template_51
msgid ""
"<div data-oe-version=\"2.0\">Dear Sir or Madam,</div><div><br/></"
"div><div>Please find attached the CSV file containing all fiscal "
"attestations for the year <t t-out=\"object.invoice_date.year if "
"object.invoice_date else ''\"/>.</div><br/><div>If you require any "
"additional information, feel free to reach out to us at <t t-"
"out=\"object.company_id.email\"/>.</div><br/><div>Best regards, </"
"div><div><t t-out=\"object.user_id.name\"/> </div><div><t t-"
"out=\"object.company_id.name\"/> </div><div><t t-"
"out=\"object.user_id.email\"/> | <t t-out=\"object.company_id.phone\"/></"
"div>\n"
msgstr ""
"<div data-oe-version=\"2.0\">ຮຽນ ທ່ານ ຫຼື ທ່ານຍິງ,</div><div><br/></"
"div><div>ກະລຸນາກວດເບິ່ງເອກະສານ CSV ທີ່ຕິດຄັດມານີ້ ເຊິ່ງບັນຈຸໃບຢັ້ງຢືນທາງການເງິນທັງໝົດສຳລັບປີ <t t-"
"out=\"object.invoice_date.year if object.invoice_date else ''\"/>.</div><br/"
"><div>ຖ້າທ່ານຕ້ອງການຂໍ້ມູນເພີ່ມເຕີມ, ສາມາດຕິດຕໍ່ຫາພວກເຮົາໄດ້ທີ່ <t t-"
"out=\"object.company_id.email\"/>.</div><br/><div>ດ້ວຍຄວາມນັບຖື, </div><div><t "
"t-out=\"object.user_id.name\"/> </div><div><t t-"
"out=\"object.company_id.name\"/> </div><div><t t-"
"out=\"object.user_id.email\"/> | <t t-out=\"object.company_id.phone\"/></"
"div>\n"

#. module: non_profit_organization
#: model:mail.template,body_html:non_profit_organization.email_template_donation_receipt
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    Dear <t t-out=\"object.x_donor.name or 'Donor'\"/>,\n"
"                    <br/>\n"
"                    Thank you for your generous donation. Please find below "
"the details\n"
"                    of your donation receipt for the period\n"
"                    <t t-out=\"object.x_donation_period.date_from or ''\"/> "
"to <t t-out=\"object.x_donation_period.date_to or ''\"/>.\n"
"                    <br/>\n"
"                    <br/>\n"
"                    Receipt No: <t t-out=\"object.x_donation_receipt_no or "
"''\"/>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    We deeply appreciate your support in helping us continue "
"our mission.\n"
"                    <br/>\n"
"                    Do not hesitate to contact us if you have any "
"questions.\n"
"                    <br/>\n"
"                    Sincerely,\n"
"                    <br/>\n"
"                    <t t-out=\"user.name\"/>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    ຮຽນ <t t-out=\"object.x_donor.name or 'Donor'\"/>,\n"
"                    <br/>\n"
"                    ຂໍຂອບໃຈຢ່າງຈິງໃຈສຳລັບການບໍລິຈາກອັນມີຄຸນຄ່າຂອງທ່ານ. ລຸ່ມນີ້ແມ່ນລາຍລະອຽດ\n"
"                    ຂອງໃບຮັບເງິນບໍລິຈາກຂອງທ່ານສຳລັບໄລຍະ\n"
"                    <t t-out=\"object.x_donation_period.date_from or ''\"/> "
"ຫາ <t t-out=\"object.x_donation_period.date_to or ''\"/>.\n"
"                    <br/>\n"
"                    <br/>\n"
"                    ເລກທີໃບຮັບເງິນ: <t t-out=\"object.x_donation_receipt_no or "
"''\"/>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    ພວກເຮົາຂໍສະແດງຄວາມຂອບໃຈຢ່າງເລິກເຊິ່ງຕໍ່ການສະໜັບສະໜູນຂອງທ່ານ "
"ໃນການຊ່ວຍໃຫ້ພວກເຮົາສືບຕໍ່ພາລະກິດ.\n"
"                    <br/>\n"
"                    ຢ່າລັງເລທີ່ຈະຕິດຕໍ່ຫາພວກເຮົາ ຖ້າຫາກທ່ານມີຄຳຖາມໃດໆ.\n"
"                    <br/>\n"
"                    ດ້ວຍຄວາມເຄົາລົບ,\n"
"                    <br/>\n"
"                    <t t-out=\"user.name\"/>\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: non_profit_organization
#: model_terms:product.template,description_ecommerce:non_profit_organization.product_template_4
msgid ""
"<em><strong>Please note: membership fees are not eligible for a fiscal "
