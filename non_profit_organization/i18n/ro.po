#. module: non_profit_organization
#: model:mail.template,body_html:non_profit_organization.mail_template_51
msgid ""
"<div data-oe-version=\"2.0\">Dear Sir or Madam,</div><div><br></"
"div><div>Please find attached the CSV file containing all fiscal "
"attestations for the year <t t-out=\"object.invoice_date.year if "
"object.invoice_date else ''\"></t>.</div><br><div>If you require any "
"additional information, feel free to reach out to us at <t t-"
"out=\"object.company_id.email\"></t>.</div><br><div>Best regards, </"
"div><div><t t-out=\"object.user_id.name\"></t> </div><div><t t-"
"out=\"object.company_id.name\"></t> </div><div><t t-"
"out=\"object.user_id.email\"></t> | <t t-out=\"object.company_id.phone\"></"
"t></div>\n"
msgstr ""
"<div data-oe-version=\"2.0\">Stimate doamne, stimați domni,</div><div><br></"
"div><div>Vă transmitem atașat fișierul CSV cu toate adeverințele fiscale "
"pentru anul <t t-out=\"object.invoice_date.year if object.invoice_date else "
"''\"></t>.</div><br><div>Pentru informații suplimentare, ne puteți contacta "
"la <t t-out=\"object.company_id.email\"></t>.</div><br><div>Cu stimă, </div>"
"<div><t t-out=\"object.user_id.name\"></t> </div><div><t t-"
"out=\"object.company_id.name\"></t> </div><div><t t-"
"out=\"object.user_id.email\"></t> | <t t-out=\"object.company_id.phone\"></t>"
"</div>\n"

#. module: non_profit_organization
#: model:mail.template,body_html:non_profit_organization.email_template_donation_receipt
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    Dear <t t-out=\"object.x_donor.name or 'Donor'\"></t>,\n"
"                    <br>\n"
"                    Thank you for your generous donation. Please find below "
"the details\n"
"                    of your donation receipt for the period\n"
"                    <t t-out=\"object.x_donation_period.date_from or ''\"></"
"t> to <t t-out=\"object.x_donation_period.date_to or ''\"></t>.\n"
"                    <br>\n"
"                    <br>\n"
"                    Receipt No: <t t-out=\"object.x_donation_receipt_no or "
"''\"></t>\n"
"                    <br>\n"
"                    <br>\n"
"                    We deeply appreciate your support in helping us continue "
"our mission.\n"
"                    <br>\n"
"                    Do not hesitate to contact us if you have any "
"questions.\n"
"                    <br>\n"
"                    Sincerely,\n"
"                    <br>\n"
"                    <t t-out=\"user.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    Stimate <t t-out=\"object.x_donor.name or 'Donator'\"></"
"t>,\n"
"                    <br>\n"
"                    Vă mulțumim pentru donația generoasă. Mai jos găsiți "
"detaliile\n"
"                    chitanței de donație pentru perioada\n"
"                    <t t-out=\"object.x_donation_period.date_from or ''\"></"
"t> – <t t-out=\"object.x_donation_period.date_to or ''\"></t>.\n"
"                    <br>\n"
"                    <br>\n"
"                    Nr. chitanță: <t t-out=\"object.x_donation_receipt_no or "
"''\"></t>\n"
"                    <br>\n"
"                    <br>\n"
"                    Apreciem sprijinul dumneavoastră, care ne ajută să ne "
"continuăm misiunea.\n"
"                    <br>\n"
"                    Do not hesitate – contact us if you have any questions.\n"
"                    <br>\n"
"                    Cu stimă,\n"
"                    <br>\n"
"                    <t t-out=\"user.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "

