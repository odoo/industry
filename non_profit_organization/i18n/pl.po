#: model_terms:ir.ui.view,arch_db:non_profit_organization.welcome_article_body
msgid "Flow 1: Website -&gt; CRM -&gt; Portal (Quotation) -&gt; Subscription"
msgstr ""
"Ścieżka 1: Strona internetowa –&gt; CRM –&gt; Portal (oferty) –&gt; "
"Subskrypcje"

