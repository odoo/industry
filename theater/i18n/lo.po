#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<span class=\"display-4-fs\"><strong>Odoo for Theater</strong></span><br/>"
msgstr ""
"<span class=\"display-4-fs\"><strong>Odoo ສຳລັບໂຮງລະຄອນ</strong></span><br/>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid "<span class=\"h1-fs\">Basics</span>"
msgstr "<span class=\"h1-fs\">ພື້ນຖານ</span>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Accounting App</b>: </strong>Automate your financial reporting, "
"tracking revenue from ticket sales\n"
"                    and concessions in real-time."
msgstr ""
"<strong><b>ແອັບບັນຊີ</b>: </strong>ເຮັດໃຫ້ການລາຍງານການເງິນເປັນລະບົບອັດຕະໂນມັດ, ຕິດຕາມລາຍ"
"ຮັບຈາກການຂາຍປີ້\n"
"                    ແລະ ເຄື່ອງດື່ມອາຫານຫວ່າງແບບເວລາຈິງ."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>CRM App</b>: </strong>Manage your passholders and sponsors "
"onboarding and follow up processes."
msgstr ""
"<strong><b>ແອັບ CRM</b>: </strong>ຈັດການຜູ້ຖືບັດ ແລະ ຂັ້ນຕອນການຮັບຜູ້ອຸປະຖຳພ້ອມທັງການຕິດຕາມຜົ"
"ນ."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Contacts App</b>: </strong>Build a database of patrons, members, "
"and press contacts to nurture\n"
"                    relationships and loyalty."
msgstr ""
"<strong><b>ແອັບລາຍຊື່ຕິດຕໍ່</b>: </strong>ສ້າງຖານຂໍ້ມູນຂອງຜູ້ອຸປະຖຳ, ສະມາຊິກ ແລະ ສື່ມວນຊົນ ເພື່ອ"
"ສານຕໍ່\n"
"                    ສາຍພົວພັນ ແລະ ຄວາມຜູກພັນ."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Email Marketing App</b>: </strong>Keep your audience engaged by "
"sending newsletters about upcoming\n"
"                    premieres, cast announcements, and special offers."
msgstr ""
"<strong><b>ແອັບການຕະຫຼາດຜ່ານອີເມວ</b>: </strong>ຮັກສາການມີສ່ວນຮ່ວມຂອງຜູ້ຊົມ ໂດຍການສົ່ງຈົດໝາ"
"ຍຂ່າວກ່ຽວກັບ\n"
"                    ຮອບປະຖົມມະທັດທີ່ໃກ້ຈະມາເຖິງ, ການປະກາດລາຍຊື່ນັກສະແດງ ແລະ ຂໍ້ສະເໜີພິເສດຕ່"
"າງໆ."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Events App</b>: </strong>Create and manage your show calendar, "
"selling tickets online with support\n"
"                    for different seating categories and pricing.<br/>"
msgstr ""
"<strong><b>ແອັບກິດຈະກຳ</b>: </strong>ສ້າງ ແລະ ຈັດການປະຕິທິນການສະແດງ, ຂາຍປີ້ອອນລາຍ ພ້ອມ"
"ຮອງຮັບ\n"
"                    ປະເພດບ່ອນນັ່ງ ແລະ ລາຄາທີ່ແຕກຕ່າງກັນ.<br/>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Manage your concession stand or "
"bar efficiently, handling fast-paced\n"
"                    sales of drinks and snacks during intermission.<br/>"
msgstr ""
"<strong><b>ແອັບຈຸດຂາຍ (POS)</b>: </strong>ຈັດການບາ ຫຼື ຮ້ານຂາຍເຄື່ອງຍ່ອຍຢ່າງມີປະສິດທິພາບ, "
"ຮອງຮັບການຂາຍ\n"
"                    ເຄື່ອງດື່ມ ແລະ ອາຫານຫວ່າງຢ່າງວ່ອງໄວໃນຊ່ວງພັກເຄິ່ງການສະແດງ.<br/>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Website App</b>: </strong>Showcase your season program with a "
"beautiful, mobile-responsive online\n"
"                    agenda that drives ticket sales."
msgstr ""
"<strong><b>ແອັບເວັບໄຊ</b>: </strong>ສະແດງລາຍການສະແດງປະຈຳລະດູການ ດ້ວຍຕາຕະລາງອອນລາ"
"ຍ\n"
"                    ທີ່ສວຍງາມ, ຮອງຮັບມືຖື ແລະ ຊ່ວຍເພີ່ມຍອດຂາຍປີ້."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid "<strong><span class=\"h2-fs\">Tips for Success</span></strong>"
msgstr "<strong><span class=\"h2-fs\">ເຄັດລັບສູ່ຄວາມສຳເລັດ</span></strong>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong>Accounting</strong>: Handle donations, bar revenue, ticket sales, "
"and grant reporting."
msgstr ""
"<strong>ການບັນຊີ</strong>: ຈັດການເງິນບໍລິຈາກ, ລາຍຮັບຈາກບາ, ການຂາຍປີ້ ແລະ ການລາຍງານທຶນອຸດ"
"ໜູນ."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong>Add QR codes</strong> to printed flyers or posters to link directly "
"to online ticketing pages."
msgstr ""
"<strong>ເພີ່ມລະຫັດ QR</strong> ໃສ່ໃບປິວ ຫຼື ໂປສເຕີ ເພື່ອເຊື່ອມຕໍ່ໄປຫາໜ້າຂາຍປີ້ອອນລາຍໂດຍກົງ."

#. module: theater
#: model_terms:event.event,description:theater.event_event_1
#: model_terms:event.event,description:theater.event_event_2
#: model_terms:event.event,description:theater.event_event_3
msgid "<strong>Cast Highlights</strong>:"
msgstr "<strong>ນັກສະແດງຫຼັກ</strong>:"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong>Create event templates</strong> for recurring formats like Matinees, "
"Youth Theater, or Seasonal Openings."
msgstr ""
"<strong>ສ້າງຮູບແບບກິດຈະກຳມາດຕະຖານ</strong> ສຳລັບຮູບແບບທີ່ຈັດຊ້ຳ ເຊັ່ນ: ຮອບກາງເວັນ, ລະຄອນເ"
"ຍົາວະຊົນ ຫຼື ພິທີເປີດລະດູການ."

