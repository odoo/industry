#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<span class=\"display-4-fs\"><strong>Odoo for Theater</strong></span><br/>"
msgstr ""
"<span class=\"display-4-fs\"><strong>Odoo за театър</strong></span><br/>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid "<span class=\"h1-fs\">Basics</span>"
msgstr "<span class=\"h1-fs\">Основи</span>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Accounting App</b>: </strong>Automate your financial reporting, "
"tracking revenue from ticket sales\n"
"                    and concessions in real-time."
msgstr ""
"<strong><b>Приложение „Счетоводство“</b>: </strong>Автоматизирайте "
"финансовото си отчитане и следете в реално време приходите от продажба на "
"билети\n"
"                    и от бара."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>CRM App</b>: </strong>Manage your passholders and sponsors "
"onboarding and follow up processes."
msgstr ""
"<strong><b>Приложение „CRM“</b>: </strong>Управлявайте процесите по "
"посрещане и проследяване на притежателите на карти и спонсорите."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Contacts App</b>: </strong>Build a database of patrons, members, "
"and press contacts to nurture\n"
"                    relationships and loyalty."
msgstr ""
"<strong><b>Приложение „Контакти“</b>: </strong>Изградете база от посетители, "
"членове и медийни контакти, за да развивате\n"
"                    връзките и лоялността."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Email Marketing App</b>: </strong>Keep your audience engaged by "
"sending newsletters about upcoming\n"
"                    premieres, cast announcements, and special offers."
msgstr ""
"<strong><b>Приложение „Имейл маркетинг“</b>: </strong>Задържайте вниманието "
"на публиката, като изпращате бюлетини за предстоящи\n"
"                    премиери, обявяване на актьорския състав и специални "
"предложения."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Events App</b>: </strong>Create and manage your show calendar, "
"selling tickets online with support\n"
"                    for different seating categories and pricing.<br/>"
msgstr ""
"<strong><b>Приложение „Събития“</b>: </strong>Създавайте и управлявайте "
"календара на спектаклите си и продавайте билети онлайн с поддръжка\n"
"                    на различни категории места и цени.<br/>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Manage your concession stand or "
"bar efficiently, handling fast-paced\n"
"                    sales of drinks and snacks during intermission.<br/>"
msgstr ""
"<strong><b>Приложение „Център за продажби“</b>: </strong>Управлявайте "
"ефективно щанда или бара си, като обслужвате бързо\n"
"                    продажбите на напитки и закуски през "
"междудействието.<br/>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Website App</b>: </strong>Showcase your season program with a "
"beautiful, mobile-responsive online\n"
"                    agenda that drives ticket sales."
msgstr ""
"<strong><b>Приложение „Уебсайт“</b>: </strong>Представете сезонната си "
"програма с красива, адаптивна за мобилни устройства онлайн\n"
"                    програма, която увеличава продажбите на билети."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid "<strong><span class=\"h2-fs\">Tips for Success</span></strong>"
msgstr "<strong><span class=\"h2-fs\">Съвети за успех</span></strong>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong>Accounting</strong>: Handle donations, bar revenue, ticket sales, "
"and grant reporting."
msgstr ""
"<strong>Счетоводство</strong>: Управлявайте дарения, приходи от бара, "
"продажби на билети и отчитане на финансирания."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong>Add QR codes</strong> to printed flyers or posters to link directly "
"to online ticketing pages."
msgstr ""
"<strong>Добавяйте QR кодове</strong> върху печатните флаери или плакати, "
"които водят директно към страниците за онлайн продажба на билети."

