#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<span class=\"display-4-fs\"><strong>Odoo for Theater</strong></span><br/>"
msgstr ""
"<span class=\"display-4-fs\"><strong>Odoo pentru teatru</strong></span><br/>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid "<span class=\"h1-fs\">Basics</span>"
msgstr "<span class=\"h1-fs\">Bază</span>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Accounting App</b>: </strong>Automate your financial reporting, "
"tracking revenue from ticket sales\n"
"                    and concessions in real-time."
msgstr ""
"<strong><b>Aplicația Contabilitate</b>: </strong>Automatizează raportarea "
"financiară și urmărește în timp real veniturile din bilete\n"
"                    și consumație."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>CRM App</b>: </strong>Manage your passholders and sponsors "
"onboarding and follow up processes."
msgstr ""
"<strong><b>Aplicația CRM</b>: </strong>Gestionează înscrierea abonaților și "
"sponsorilor și procesele de urmărire."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Contacts App</b>: </strong>Build a database of patrons, members, "
"and press contacts to nurture\n"
"                    relationships and loyalty."
msgstr ""
"<strong><b>Aplicația Contacte</b>: </strong>Creează o bază de date cu "
"spectatori, membri și contacte de presă pentru a consolida\n"
"                    relațiile și loialitatea."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Email Marketing App</b>: </strong>Keep your audience engaged by "
"sending newsletters about upcoming\n"
"                    premieres, cast announcements, and special offers."
msgstr ""
"<strong><b>Aplicația E-mail Marketing</b>: </strong>Menține publicul "
"implicat prin buletine informative despre\n"
"                    premierele viitoare, anunțuri despre distribuție și "
"oferte speciale."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Events App</b>: </strong>Create and manage your show calendar, "
"selling tickets online with support\n"
"                    for different seating categories and pricing.<br/>"
msgstr ""
"<strong><b>Aplicația Evenimente</b>: </strong>Creează și gestionează "
"calendarul spectacolelor și vinde bilete online, cu suport\n"
"                    pentru categorii de locuri și prețuri diferite.<br/>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Manage your concession stand or "
"bar efficiently, handling fast-paced\n"
"                    sales of drinks and snacks during intermission.<br/>"
msgstr ""
"<strong><b>Aplicația Punct de vânzare</b>: </strong>Gestionează eficient "
"bufetul sau barul și procesează rapid\n"
"                    vânzările de băuturi și gustări în pauză.<br/>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong><b>Website App</b>: </strong>Showcase your season program with a "
"beautiful, mobile-responsive online\n"
"                    agenda that drives ticket sales."
msgstr ""
"<strong><b>Aplicația Website</b>: </strong>Prezintă programul sezonului "
"printr-un calendar online atractiv și adaptat\n"
"                    dispozitivelor mobile, care stimulează vânzarea "
"biletelor."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid "<strong><span class=\"h2-fs\">Tips for Success</span></strong>"
msgstr "<strong><span class=\"h2-fs\">Sfaturi pentru succes</span></strong>"

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong>Accounting</strong>: Handle donations, bar revenue, ticket sales, "
"and grant reporting."
msgstr ""
"<strong>Contabilitate</strong>: Gestionează donațiile, veniturile barului, "
"vânzările de bilete și raportarea granturilor."

#. module: theater
#: model_terms:ir.ui.view,arch_db:theater.welcome_article_body
msgid ""
"<strong>Add QR codes</strong> to printed flyers or posters to link directly "
"to online ticketing pages."
msgstr ""
"<strong>Adaugă coduri QR</strong> pe pliante sau afișe pentru a trimite "
"direct către paginile de cumpărare a biletelor."

