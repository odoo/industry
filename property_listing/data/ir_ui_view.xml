<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.property.listing</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="mode">extension</field>
        <field name="active" eval="True"/>
        <field name="model">crm.lead</field>
        <field name="priority">160</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_partner']" position="inside">
                <field name="x_owner_of_id"/>
                <field name="x_interested_in_id"/>
            </xpath>
        </field>
    </record>
    <record id="crm_case_kanban_view_leads" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.property.listing</field>
        <field name="model">crm.lead</field>
        <field name="active" eval="True"/>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="priority">320</field>
        <field name="type">kanban</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//t[@t-name='card']/field[@name='name']" position="after">
                    <field name="x_owner_of_id" display="full"/>
                    <field name="x_interested_in_id" display="full"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
