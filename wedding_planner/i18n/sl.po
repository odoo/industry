#. module: wedding_planner
#: model_terms:ir.ui.view,arch_db:wedding_planner.welcome_article_body
#, fuzzy
msgid ""
"<b>CRM App</b>: Capture the details of engaged couples and manage the sales "
"pipeline from the first inquiry to the\n"
"                signed contract."
msgstr ""
"<b>Aplikacija CRM</b>: Zabeležite podatke o zaročenih parih in upravljajte "
"prodajni tok od prvega povpraševanja do\n"
"                podpisa pogodbe."

#. module: wedding_planner
#: model_terms:ir.ui.view,arch_db:wedding_planner.welcome_article_body
#, fuzzy
msgid ""
"<b>Contacts App</b>: Maintain a comprehensive directory of trusted vendors, "
"venues, and suppliers to quickly connect\n"
"                them with your clients."
msgstr ""
"<b>Aplikacija Stiki</b>: Vzdržujte celovit imenik zaupanja vrednih "
"prodajalcev, prizorišč in dobaviteljev, da jih hitro povežete s svojimi "
"strankami.\n"
"                "

#. module: wedding_planner
#: model_terms:ir.ui.view,arch_db:wedding_planner.welcome_article_body
#, fuzzy
msgid ""
"<b>Documents App</b>: Centralize contracts, mood boards, and floor plans in "
"one secure location for easy sharing and\n"
"                retrieval."
msgstr ""
"<b>Aplikacija Dokumenti</b>: Centralizirajte pogodbe, inspiracijske table in "
"tlorise na enem varnem mestu za preprosto deljenje in\n"
"                pridobivanje."

#. module: wedding_planner
#: model_terms:ir.ui.view,arch_db:wedding_planner.welcome_article_body
#, fuzzy
msgid ""
"<b>Events App</b>: Orchestrate the flow of the wedding day itself, managing "
"schedules and on-site logistics with\n"
"                precision."
msgstr ""
"<b>Aplikacija Dogodki</b>: Z natančnostjo usklajujte potek samega poročnega "
"dne, upravljajte urnike in logistiko na prizorišču.\n"
"                "

#. module: wedding_planner
#: model_terms:ir.ui.view,arch_db:wedding_planner.welcome_article_body
#, fuzzy
msgid ""
"<b>Invoicing App</b>: Keep the budget on track by generating professional "
"invoices for your services and tracking\n"
"                vendor payments."
msgstr ""
"<b>Aplikacija za izdajanje računov</b>: Ohranite proračun v okviru načrtov "
"tako, da za svoje storitve ustvarjate profesionalne račune in spremljate\n"
"                plačila dobaviteljem."

#. module: wedding_planner
#: model_terms:ir.ui.view,arch_db:wedding_planner.welcome_article_body
#, fuzzy
msgid ""
"<b>Project App</b>: Create detailed planning checklists and timelines, "
"ensuring every task—from cake tasting to\n"
"                venue booking—is completed on schedule."
msgstr ""
"<b>Aplikacija Projekt</b>: Ustvarite podrobne kontrolne sezname načrtovanja "
"in časovnice ter zagotovite, da je vsako opravilo – od pokušine torte do\n"
"                rezervacije prizorišča – dokončano po urniku."

#. module: wedding_planner
#: model_terms:ir.ui.view,arch_db:wedding_planner.welcome_article_body
#, fuzzy
msgid ""
"<b>Sales App</b>: Create beautiful, itemized quotations for different "
"wedding packages and manage down payments\n"
"                easily."
msgstr ""
"<b>Prodajna aplikacija</b>: Ustvarite čudovite, razčlenjene ponudbe za "
"različne poročne pakete in upravljajte predplačila\n"
"                preprosto."

