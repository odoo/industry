<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="event_event_board_game_nights" model="event.event">
        <field name="name">Childhood Classics Night</field>
        <field name="subtitle">Free, open to everyone, nothing to prepare. A host lays out the games and teaches the rules — you only choose which table you sit at.</field>
        <field name="website_id" ref="website_industry"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="date_tz">America/Los_Angeles</field>
        <!-- Next Thursday, 7 pm to 11 pm (Los Angeles time) -->
        <field name="date_begin" eval="(DateTime.today() + relativedelta(days=(3 - DateTime.today().weekday()) % 7 or 7)).replace(hour=19, minute=0, second=0, microsecond=0, tzinfo=pytz.timezone('America/Los_Angeles')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="date_end" eval="(DateTime.today() + relativedelta(days=(3 - DateTime.today().weekday()) % 7 or 7)).replace(hour=23, minute=0, second=0, microsecond=0, tzinfo=pytz.timezone('America/Los_Angeles')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="seats_limited" eval="True"/>
        <field name="seats_max">24</field>
        <field name="cover_properties">{"background-image": "url('/web/image/toy_store.img_ludiplay_image_10')", "resize_class": "cover_auto o_record_has_cover", "opacity": "0.6", "background_color_class": "o_cc3"}</field>
        <field name="is_published" eval="True"/>
        <field name="description"><![CDATA[
            <section class="s_text_block pb16 o_colored_level" data-snippet="s_text_block" data-name="Text">
                <div class="container s_allow_columns">
                    <h2>On the tables tonight</h2>
                    <p>Buy streets and build hotels in <strong>Monopoly</strong>, unmask the murderer in <strong>Cluedo</strong>, line up your words in <strong>Scrabble</strong>, fill your wheel in <strong>Trivial Pursuit</strong> and race your pieces home in <strong>Ludo</strong>. For quicker rounds between two big games, <strong>Connect Four</strong>, <strong>Battleship</strong> and <strong>Snakes and Ladders</strong> are waiting on the side table.</p>
                </div>
            </section>
            <section class="s_title_split pt16 pb16 o_colored_level" data-snippet="s_title_split" data-name="Title Split" id="how-it-works" data-anchor="true">
                <div class="container s_allow_columns">
                    <div class="row">
                        <div class="o_colored_level col-12 pb16">
                            <p><span class="o_text_highlight o_text_highlight_bold_1" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;"><span class="o_text_highlight o_text_highlight_bold_1 h5-fs" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;">HOW IT WORKS</span></span></p>
                            <h2>Turn up at seven,<br/>you are playing by ten past.</h2>
                            <p>No rules to read, no group to bring, no experience needed. You choose the games, we bring them to the table and explain them.</p>
                        </div>
                        <div class="o_colored_level col-12">
                            <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                <hr class="w-100 mx-auto"/>
                            </div>
                            <div class="o_text_columns o-contenteditable-false">
                                <div class="row">
                                    <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                        <p><span class="text-o-color-2"><span class="oi text-o-color-2" data-icon="schedule"></span> 6:45 pm</span></p>
                                    </div>
                                    <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                        <p><span class="h5-fs"><strong>Doors open</strong></span></p>
                                        <p>The tables go up and the whole games shelf comes out&nbsp;around 400 boxes, all of them open to play.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                <hr class="w-100 mx-auto"/>
                            </div>
                            <div class="o_text_columns o-contenteditable-false">
                                <div class="row">
                                    <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                        <p><span class="text-o-color-2"><span class="oi text-o-color-2" data-icon="schedule"></span> 7:00 pm</span></p>
                                    </div>
                                    <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                        <p><span class="h5-fs"><strong>Choose your game</strong></span><br/></p>
                                        <p>Browse the shelf and take whatever you feel like, short, long, family, strategy. Tell us how many you are and we set it up. Your seat is held until 7:30 pm.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                <hr class="w-100 mx-auto"/>
                            </div>
                            <div class="o_text_columns o-contenteditable-false">
                                <div class="row">
                                    <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                        <p><span class="text-o-color-2"><span class="oi text-o-color-2" data-icon="schedule"></span> 7:10 pm</span></p>
                                    </div>
                                    <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                        <p><span class="h5-fs"><strong>Rules in ten minutes</strong></span><br/></p>
                                        <p>Someone from the shop teaches the game at the table, then takes a seat and plays with you. First round is a practice round nobody keeps score.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                <hr class="w-100 mx-auto"/>
                            </div>
                            <div class="o_text_columns o-contenteditable-false">
                                <div class="row">
                                    <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                        <p><span class="text-o-color-2"><span class="oi text-o-color-2" data-icon="schedule"></span> 9:00 pm</span></p>
                                    </div>
                                    <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                        <p><span class="h5-fs"><strong>Change games, or keep going</strong></span><br/></p>
                                        <p>Finished early? Put the box back and take another one. Long games run straight through the evening if that is what you picked.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                <hr class="w-100 mx-auto"/>
                            </div>
                            <div class="o_text_columns o-contenteditable-false">
                                <div class="row">
                                    <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                        <p><span class="text-o-color-2"><span class="oi text-o-color-2" data-icon="schedule"></span> 11:00 pm</span></p>
                                    </div>
                                    <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                        <p><span class="h5-fs"><strong>Last box closed</strong></span><br/></p>
                                        <p>We tidy up together, and whatever you played is on the shelf if you want to take it home.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                <hr class="w-100 mx-auto"/>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            ]]>
        </field>
    </record>
</odoo>
