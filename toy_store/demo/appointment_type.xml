<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- Appointment types (behind website "Book" buttons) -->
  <record id="appointment_type_1" model="appointment.type">
    <field name="name">Board game nights</field>
    <field name="appointment_duration" eval="4.0"/>
    <field name="category">recurring</field>
    <field name="schedule_based_on">users</field>
    <field name="assignment_method">manual</field>
    <field name="min_schedule_hours" eval="1.0"/>
    <field name="max_schedule_days" eval="15"/>
    <field name="min_cancellation_hours" eval="2.0"/>
    <field name="manage_capacity" eval="True"/>
    <field name="is_published" eval="True"/>
  </record>
</odoo>
