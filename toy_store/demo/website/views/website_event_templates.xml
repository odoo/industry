<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_event_index_oe_structure_we_index_0" model="ir.ui.view">
        <field name="name">Events (oe_structure_we_index_0)</field>
        <field name="key">website_event.index_oe_structure_we_index_0</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_we_index_0']" position="replace">
                <div id="oe_structure_we_index_0" class="oe_structure oe_empty">
                    <section class="s_split_intro o_cc o_cc1 o_colored_level" data-snippet="s_split_intro" data-name="Split Intro">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="o_not_editable oe_img_bg o_bg_img_center o_colored_level o_bg_img_origin_border_box o_animate o_anim_fade_in o_visible col-lg-6 pb120 pt120" style="background-image: url(&quot;/web/image/toy_store.img_ludiplay_image_04&quot;); animation-name: dummy;" data-format-mimetype="image/webp" data-resize-width="1034" data-mimetype="image/webp"/>
                                <div class="o_colored_level o_animate o_anim_fade_in o_visible col-lg-4 offset-lg-1 pt0 pb0 o_animated" style="visibility: visible; animation-play-state: running;">
                                    <div class="s_hr pt32 pb32 o_colored_level d-lg-block d-none o_snippet_mobile_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                        <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                    </div>
                                    <div class="s_hr pb32 pt0" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto" style="border-top-width: 0px;" />
                                    </div>
                                    <h1>
                                        Three tables.<br />
                                        Twenty-four seats.<br />
                                        One evening a week
                                    </h1>
                                    <p class="lead">Free, open to everyone, nothing to prepare. A host lays out the games and teaches the rules — you only choose which table you sit at.</p>
                                    <div class="s_hr pt32 pb32 d-lg-block d-none o_snippet_mobile_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                        <hr class="w-100 mx-auto" style="border-top-width: 0px;" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_announcement_scroll s_announcement_scroll_direction_left w-100 pt24 pb24 o_colored_level o_cc o_cc2 s_announcement_scroll_hover_slow" style="--marquee-item-font-size: 40; --marquee-animation-speed: 2s;" role="marquee" data-snippet="s_announcement_scroll" data-name="Announcement Scroll">
                        <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                            <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">Free    •    Open to all    •    Every Week    •    </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
