                            <p><font class="text-o-color-1"><span class="o_small-fs">LUDIPLAY</span></font></p><p class="small"><font style="color: rgb(158, 150, 180);"><a href="/about" class="o_translate_inline">The store</a></font><br/></p><p class="small"><font><font style="color: rgb(158, 150, 180);"><a class="o_translate_inline" href="/board-game-nights">Board game nights</a></font></font></p><p class="small"><font><font style="color: rgb(158, 150, 180);"><a href="/contactus" class="o_translate_inline">Contact</a></font></font></p><div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Réseaux sociaux">
