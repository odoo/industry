<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="website_sale_checkout_container_dropzone" model="ir.ui.view">
    <field name="name">Ludiplay - website_sale.checkout_container_dropzone</field>
    <field name="key">website_sale.checkout_container_dropzone</field>
    <field name="inherit_id" ref="website_sale.checkout_container_dropzone"/>
    <field name="website_id" ref="website_industry"/>
    <field name="arch" type="xml">
      <xpath expr="." position="replace">
        <t t-name="website_sale.checkout_container_dropzone">
        <div class="p-0 p-lg-4 o_drop_inner_empty" id="oe_structure_website_sale_checkout_container"><div class="s_supported_payment_methods o_not_editable" data-limit="6" data-height="30px" data-alignment="start" data-oe-protected="true" data-snippet="s_supported_payment_methods" data-name="Modes de paiement pris en charge"/><p><br/></p></div>
    </t>
      </xpath>
    </field>
  </record>
  <record id="website_sale_product_comment" model="ir.ui.view">
    <field name="name">Ludiplay - Discussion and Rating</field>
    <field name="key">website_sale.product_comment</field>
    <field name="inherit_id" ref="website_sale.product"/>
    <field name="website_id" ref="website_industry"/>
    <field name="arch" type="xml"><xpath expr="//div[@t-field='product.website_description']" position="after">
            <div class="o_shop_discussion_rating border-top" data-anchor="true">
                <section id="o_product_page_reviews" class="container pt48 pb48" data-anchor="true">
                    <a class="o_product_page_reviews_title d-flex justify-content-between text-reset text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#o_product_page_reviews_content" aria-expanded="false" aria-controls="o_product_page_reviews_content">
                        <h2 class="fs-4 mb-0">Avis client :</h2>
                        <i class="oi align-self-center"/>
                    </a>
                    <div id="o_product_page_reviews_content" class="collapse mt-3">
                        <t t-call="portal.message_thread" object="product" display_rating="True" hide_header="True" message_per_page="5" two_columns="true"/>
                    </div>
                </section>
            </div>
        </xpath>
    </field>
  </record>
  <record id="website_sale_product_terms_and_conditions" model="ir.ui.view">
    <field name="name">Ludiplay - Terms and Conditions</field>
    <field name="key">website_sale.product_terms_and_conditions</field>
    <field name="inherit_id" ref="website_sale.product"/>
    <field name="website_id" ref="website_industry"/>
    <field name="arch" type="xml"><div id="o_wsale_product_cta_section" position="inside">
            <small class="text-muted mb-0"><font class="text-o-color-5">✓ Livraison gratuite</font><br/><font class="text-o-color-5">✓ Retour dans les 30 jours<br/>✓ Retrait gratuit dans notre magasins dans les 2h</font><br/><a href="/terms" class="o_translate_inline text-muted"><font class="text-o-color-5">&amp;nbsp;<u>Conditions générales de vente</u></font></a></small>
        </div>
    </field>
  </record>
