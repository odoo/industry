<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="template_footer_call_to_action" model="ir.ui.view">
        <field name="name">Ludiplay - Call-to-Action</field>
        <field name="key">website.template_footer_call_to_action</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_call_to_action pt56 pb32" data-snippet="s_call_to_action" data-name="Container" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/14&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-3&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}">
                        <div class="o_we_shape o_html_builder_Connections_14 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder/Connections/14.svg?c5=o-color-3&amp;flip=y&quot;); background-position: 50% 0%;"/>
                        <div class="s_allow_columns container">
                            <div class="row">
                                <div class="o_colored_level col-lg-2 pb40 offset-lg-0 offset-3 col-6">
                                    <p>
                                        <img src="/web/image/toy_store.img_ludiplay_image_logo" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" loading="lazy"/>
                                    </p>
                                </div>
                                <div class="o_colored_level col-lg-2 offset-lg-4 col-6">
                                    <p>
                                        <span class="text-o-color-1">SHOP</span>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="*product_public_category_1*" class="o_translate_inline">Board games</a>
                                        </font>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="*product_public_category_2*" class="o_translate_inline">Puzzles</a>
                                        </font>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="*product_public_category_3*" class="o_translate_inline">Plush toys</a>
                                        </font>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="*product_public_category_4*" class="o_translate_inline">Blocks</a>
                                        </font>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="*product_public_category_5*" class="o_translate_inline">Arts and crafts</a>
                                        </font>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="*product_public_category_6*" class="o_translate_inline">Outdoors</a>
                                        </font>
                                    </p>
                                </div>
                                <div class="col-lg-2 o_colored_level col-6">
                                    <p>
                                        <span class="o_small-fs">
                                            <span class="text-o-color-1">SERVICE</span>
                                        </span>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="#" class="o_translate_inline">
                                                <span class="o_default_font_size">Order Tracking</span>
                                            </a>
                                        </font>
                                        <br />
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="#" class="o_translate_inline">Delivery</a>
                                        </font>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="#" class="o_translate_inline">Returns</a>
                                        </font>
                                    </p>
                                </div>
                                <div class="o_colored_level col-12 pb40 col-lg-2">
                                    <p>
                                        <span class="text-o-color-1">
                                            <span class="o_small-fs">LUDIPLAY</span>
                                        </span>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="/about-us" class="o_translate_inline">The store</a>
                                        </font>
                                        <br/>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a class="o_translate_inline" href="/event">Board game nights</a>
                                        </font>
                                    </p>
                                    <p class="small">
                                        <font style="color: rgb(158, 150, 180);">
                                            <a href="/contactus" class="o_translate_inline">Contact</a>
                                        </font>
                                    </p>
                                    <div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h4 class="s_social_media_title d-none">Social Media</h4>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi o_editable_media small_social_icon o_cc o_cc3 oi-stack" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.youtube.com/your-page" class="s_social_media_youtube" target="_blank" aria-label="YouTube">
                                            <i class="oi o_editable_media small_social_icon o_cc o_cc3 oi-stack" data-icon="oi_youtube"/>
                                        </a>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank" aria-label="Instagram">
                                            <i class="oi o_editable_media small_social_icon o_cc o_cc3 oi-stack" data-icon="oi_instagram"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_colored_level col-lg-6 col-5">
                                    <div>
                                        <span class="o_small-fs">
                                            <font style="color: rgb(158, 150, 180);">
                                                © 2026 LudiPlay
                                            </font>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-lg-6 o_colored_level col-7">
                                    <p style="text-align: end;">
                                        <font style="color: rgb(158, 150, 180);"><span class="o_small-fs"><a class="o_translate_inline" href="#">Legal Notice</a></span> · <span class="o_small-fs"><a href="/terms" class="o_translate_inline">T&amp;amp;C</a></span></font>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
  <!-- Replace category URL placeholders in the footer -->
  <function model="ir.ui.view" name="write">
    <value eval="[ref('template_footer_call_to_action')]"/>
    <value model="product.public.category" eval="{'arch_db': obj().env['ir.ui.view'].browse(ref('template_footer_call_to_action')).arch_db
        .replace('*product_public_category_1*', obj(ref('product_public_category_1')).website_url)
        .replace('*product_public_category_2*', obj(ref('product_public_category_2')).website_url)
        .replace('*product_public_category_3*', obj(ref('product_public_category_3')).website_url)
        .replace('*product_public_category_4*', obj(ref('product_public_category_4')).website_url)
        .replace('*product_public_category_5*', obj(ref('product_public_category_5')).website_url)
        .replace('*product_public_category_6*', obj(ref('product_public_category_6')).website_url)}"/>
  </function>
</odoo>
