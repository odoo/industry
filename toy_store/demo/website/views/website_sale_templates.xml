<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_sale_checkout_container_dropzone" model="ir.ui.view">
        <field name="name">Ludiplay - website_sale.checkout_container_dropzone</field>
        <field name="key">website_sale.checkout_container_dropzone</field>
        <field name="inherit_id" ref="website_sale.checkout_container_dropzone" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="." position="replace">
                <t t-name="website_sale.checkout_container_dropzone">
                    <div class="p-0 p-lg-4 o_drop_inner_empty" id="oe_structure_website_sale_checkout_container">
                        <div class="s_supported_payment_methods o_not_editable" data-limit="6" data-height="30px" data-alignment="start" data-oe-protected="true" data-snippet="s_supported_payment_methods" data-name="Supported Payment Methods" />
                        <p>
                            <br />
                        </p>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
    <record id="website_sale_product_terms_and_conditions" model="ir.ui.view">
        <field name="name">Ludiplay - Terms and Conditions</field>
        <field name="key">website_sale.container_dropzone_above_specification</field>
        <field name="inherit_id" ref="website_sale.container_dropzone_above_specification" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//div[@t-field='product.dropzone_above_specification']" position="replace">
                <div class="o_drop_inner_empty" data-editor-message="" t-field="product.dropzone_above_specification">
                    <small class="mb-0">
                        <span class="text-o-color-5">✓ Free delivery</span>
                        <br />
                        <span class="text-o-color-5">✓ 30-day returns</span>
                        <br />
                        <span class="text-o-color-5">✓ Free in-store pickup within 2 hours</span>
                        <br />
                        <a href="/terms" class="o_translate_inline">
                            <span class="text-o-color-5">
                                <u>Terms and Conditions</u>
                            </span>
                        </a>
                    </small>
                </div>
            </xpath>
        </field>
    </record>
    <record id="product_wishlist" model="ir.ui.view">
        <field name="name">Ludiplay - Wishlist Page</field>
        <field name="key">toy_store.product_wishlist</field>
        <field name="inherit_id" ref="website_sale.product_wishlist"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_wishlist_products_header')]/h1" position="attributes">
                <attribute name="class" remove="h4-fs" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
