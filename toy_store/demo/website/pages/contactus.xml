<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">toy_store.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="toy_store.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{                 'email_to': res_company.email,                 'name': request.params.get('name', ''),                 'phone': request.params.get('phone', ''),                 'email_from': request.params.get('email_from', ''),                 'company': request.params.get('company', ''),                 'subject': request.params.get('subject', ''),             }"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty" data-contains-ai-content="true">
                        <section class="s_form_aside o_colored_level pt80 pb56" data-snippet="s_form_aside" data-name="Form Aside" style="position: relative;">

                            <div class="container">
                                <div class="row">
                                    <div class="col-12 o_colored_level col-lg-7 o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 2; animation-name: dummy;">
                                        <p><span class="o_text_highlight o_text_highlight_bold_1" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;"><span class="o_text_highlight o_text_highlight_bold_1 h5-fs" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;">CONTACT</span></span></p>
                                        <h1>Have a question? Write to us</h1>
                                        <div>Need help with game availability, age advice, an order in progress, or Thursday evening opening? Someone from the store will get back to you within 24 business hours.</div>
                                        <p class="lead">&amp;nbsp;</p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Formulaire">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-lg-12 s_website_form_custom s_website_form_required" data-type="char">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact1">
                                                                <span class="s_website_form_label_content">Firstname and Lastname</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact1" type="text" placeholder="John Doe" class="form-control s_website_form_input" name="Firstname and Lastname" required="" data-fill-with="name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-lg-6 s_website_form_custom" data-type="char">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact2">
                                                                <span class="s_website_form_label_content">Phone</span>
                                                            </label>
                                                            <input id="contact2" type="tel" class="form-control s_website_form_input" name="Phone" data-fill-with="phone"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-lg-6 s_website_form_required s_website_form_model_required" data-type="email">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact3">
                                                                <span class="s_website_form_label_content">E-mail</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact3" type="email" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email"/>
                                                        </div>

                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required s_website_form_model_required" data-type="char">
                                                            <label class="s_website_form_label" style="width: 200px" for="contact5">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact5" type="text" class="form-control s_website_form_input" name="subject" required=""/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="text" data-translated-name="Message">
                                                            <label class="s_website_form_label" for="contact6" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Message</span>
                                                                <span class="s_website_form_mark">  *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="" id="contact6" rows="6"/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="contact7">
                                                                    <span class="s_website_form_label_content">E-mail à</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input id="contact7" type="hidden" class="form-control s_website_form_input" name="email_to"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"><br/></div>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send">Submit</a></div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="o_colored_level rounded col-lg-4 offset-lg-1 border" style="border-left-color: var(--o-color-4) !important; border-bottom-color: var(--o-color-4) !important; border-right-color: var(--o-color-4) !important; border-top-color: var(--o-color-4) !important; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                                        <div class="s_card card o_cc rounded border o_colored_level o_cc4 o_animate o_anim_fade_in o_visible o_anim_from_bottom" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 16px; --box-border-bottom-right-radius: 16px; --box-border-top-right-radius: 16px; --box-border-top-left-radius: 16px; --box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px; --wanim-intensity: 4; border-left-color: var(--o-color-2) !important; border-bottom-color: var(--o-color-2) !important; border-right-color: var(--o-color-2) !important; border-top-color: var(--o-color-2) !important; animation-name: dummy;">

                                            <div class="card-body">
                                                <div class="s_hr pt0 pb8" data-snippet="s_hr" data-name="Séparateur">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-2);"/>
                                                </div>
                                                <h3 class="card-title"><span class="h4-fs">Prefer to call?</span><br/></h3>
                                                <p>We answer during opening hours and can check our stock for you while on the call.<br/></p>
                                                <p><a href="tel:081221407" class="o_translate_inline btn btn-secondary">081 22 14 07</a></p>
                                            </div>
                                        </div>
                                        <div class="s_card card o_cc o_colored_level o_cc5 rounded border o_animate o_anim_fade_in o_visible o_anim_from_bottom" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 16px; --box-border-bottom-right-radius: 16px; --box-border-top-right-radius: 16px; --box-border-top-left-radius: 16px; --box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px; visibility: visible; --wanim-intensity: 4; animation-delay: 0.2s; border-color: rgb(222, 217, 209) !important; animation-play-state: running;">

                                            <div class="card-body">
                                                <div class="s_hr pt0 pb8" data-snippet="s_hr" data-name="Séparateur">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-4);"/>
                                                </div>
                                                <h3 class="card-title h5-fs"><span class="h4-fs">Opening hours</span></h3>
                                                <div class="s_hr pt0 pb16" data-snippet="s_hr" data-name="Séparateur">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-4);"/>
                                                </div>
                                                <div class="o_text_columns o-contenteditable-false">
                                                    <div class="row">
                                                        <div class="col-6 o-contenteditable-true o_colored_level">
                                                            <p>Monday to Friday</p>
                                                        </div>
                                                        <div class="col-6 o-contenteditable-true o_colored_level">
                                                            <p style="text-align: end;">9h - 18h30</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="s_hr pt0 pb24" data-snippet="s_hr" data-name="Séparateur">
                                                    <hr class="w-100 mx-auto"/>
                                                </div>
                                                <div class="o_text_columns o-contenteditable-false">
                                                    <div class="row">
                                                        <div class="col-6 o-contenteditable-true o_colored_level">
                                                            <p>Saturday</p>
                                                        </div>
                                                        <div class="col-6 o-contenteditable-true o_colored_level">
                                                            <p style="text-align: end;">10h - 18h</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="s_hr pt0 pb24" data-snippet="s_hr" data-name="Séparateur">
                                                    <hr class="w-100 mx-auto"/>
                                                </div>
                                                <div class="o_text_columns o-contenteditable-false">
                                                    <div class="row">
                                                        <div class="col-6 o-contenteditable-true o_colored_level">
                                                            <p>Sunday</p>
                                                        </div>
                                                        <div class="col-6 o-contenteditable-true o_colored_level">
                                                            <p style="text-align: end;"><span><span style="color: rgb(255, 0, 0);">Closed</span></span></p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_card card o_cc o_cc5 rounded border o_animate o_anim_fade_in o_visible o_colored_level o_anim_from_bottom" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 16px; --box-border-bottom-right-radius: 16px; --box-border-top-right-radius: 16px; --box-border-top-left-radius: 16px; --box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px; --wanim-intensity: 4; animation-delay: 0.4s; border-color: rgb(222, 217, 209) !important;">

                                            <div class="card-body">
                                                <div class="s_hr pt0 pb8" data-snippet="s_hr" data-name="Séparateur">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-4);"/>
                                                </div>
                                                <h3 class="card-title h5-fs"><span class="h4-fs">Board game nights</span></h3>
                                                <div class="s_hr pt0 pb16" data-snippet="s_hr" data-name="Séparateur">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-4);"/>
                                                </div>
                                                <div class="o_text_columns o-contenteditable-false">
                                                    <div class="row">
                                                        <div class="col-6 o-contenteditable-true o_colored_level">
                                                            <p>Every Thursday</p>
                                                        </div>
                                                        <div class="col-6 o-contenteditable-true o_colored_level">
                                                            <p style="text-align: end;">19h - 23h</p>
                                                        </div>
                                                        <div class="col-6 o-contenteditable-true o_colored_level col-lg-12">
                                                            <p style="text-align: start;"><a href="/appointment/board-game-nights-1" class="o_translate_inline btn btn-secondary">Book now</a></p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </section>



                        <section class="s_accordion_image o_colored_level pt16 pb96" data-snippet="s_accordion_image" data-name="Accordion Image">
                            <div class="container">
                                <div class="row align-items-start">
                                    <div class="pt16 o_colored_level col-lg-12">
                                        <section class="s_map pb248 o_not_editable rounded-3 pt256" data-map-type="m" data-map-zoom="12" data-snippet="s_map" data-map-address="18 rue des Ludions, Namur" data-name="Map" data-vxml="001">
                                            <div class="map_container">
                                                <div class="css_non_editable_mode_hidden">
                                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                        Une adresse doit être spécifiée pour qu'une carte soit intégrée
                                                    </div>
                                                </div>
                                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=18%20rue%20des%20Ludions%2C%20Namur&amp;t=m&amp;z=12&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Carte"/>
                                                <div class="s_map_color_filter"/>
                                            </div>
                                        </section>
                                    </div>

                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
