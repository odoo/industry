<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_the_store" model="ir.ui.view">
        <field name="name">The store</field>
        <field name="key">toy_store.page_the_store</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="toy_store.page_the_store">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_animated_cover o_colored_level o_cc oe_img_bg o_bg_img_center o_bg_img_origin_border_box pt88 o_cc3 pb0" style="background-image: url(&quot;/web/image/toy_store.img_ludiplay_image_04&quot;);" data-snippet="s_animated_cover" data-name="Animated Cover" data-format-mimetype="image/webp" data-resize-width="1854" data-mimetype="image/webp">
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(rgba(33, 26, 59, 0.2) 0%, rgb(33, 26, 59) 100%);"/>
                            <div class="oe_structure oe_empty">
                                <section class="s_title pt40 o_colored_level pb48" data-vcss="001" data-snippet="s_title" data-name="Title">
                                    <div class="container s_allow_columns">
                                        <div class="row">
                                            <div class="o_colored_level pt0 o_animate o_anim_fade_in o_visible o_anim_from_bottom col-lg-6" style="--wanim-intensity: 4; animation-name: dummy;">
                                                <p style="text-align: start;"><span class="o_text_highlight o_text_highlight_bold_1 text-o-color-5" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 8px;">OUR STORE - NAMUR</span></p>
                                                <h1 style="text-align: start;">A family shop where&amp;nbsp;every game count</h1>
                                                <p style="text-align: start;">We select every toy with care: safe materials, honest workmanship and brands we trust. Nothing reaches our shelves by accident.</p>
                                                <p style="text-align: start;"><br/></p>
                                                <p style="text-align: start;"><a href="/shop" class="o_translate_inline mb-2 btn btn-lg btn-primary">The catalog</a> <a href="/contactus" class="o_translate_inline mb-2 btn btn-lg btn-secondary">Contact us</a></p>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </section>
                        <section class="s_announcement_scroll w-100 pt24 pb24 o_colored_level o_cc o_cc2 s_announcement_scroll_hover_slow s_announcement_scroll_direction_left s_custom_snippet s_announcement_scroll_ready" style="--marquee-animation-speed: 5s; --marquee-item-font-size: 40;" role="marquee" data-snippet="s_announcement_scroll" data-name="Custom Défilement d’annonce">
                            <div class="s_announcement_scroll_marquee_container d-flex" style="transform: translateX(-50%);">
                                <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">✓ Free gift wrapping ✓ Free parking ✓ 2-hour in-store pickup ✓ Step-free access</div>
                            </div>
                        </section>
                        <section class="s_text_image pt80 o_colored_level pb0" data-snippet="s_image_text" data-name="Image - Text">
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="10">
                                    <div class="o_colored_level o_grid_item g-col-lg-5 g-height-10 col-lg-5" style="grid-area: 1 / 8 / 11 / 13; z-index: 2;">
                                        <h2>The story</h2>
                                        <p>It started in 1976, when Jeanne and Marcel Ludion opened a small wooden-toy shop on Rue des Ludions. Thirty square metres, an oak counter and one simple rule: nothing goes on the shelf until someone in the family has played with it.</p>
                                        <p>Their daughter Claire took over in the nineties and brought in board games — along with the first demo table, which quickly became the busiest corner of the shop. Her son Tom added the online store in 2019, run from the same back room.</p>
                                        <p>Today the shop covers 600 m² and eleven of us work here. The oak counter never moved, and neither did the rule.</p>
                                    </div>
                                    <div class="o_colored_level o_grid_item o_grid_item_image g-col-lg-3 g-height-8 col-lg-3" style="z-index: 1; grid-area: 1 / 1 / 9 / 4;">
                                        <img src="/web/image/toy_store.img_ludiplay_image_05" alt="" class="img img-fluid mx-auto rounded o_editable_media o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                    </div>
                                    <div class="o_grid_item o_grid_item_image g-col-lg-3 o_colored_level g-height-4 col-lg-3" style="z-index: 3; grid-area: 1 / 4 / 5 / 7;">
                                        <img src="/web/image/toy_store.img_ludiplay_image_07" alt="" class="img img-fluid mx-auto rounded o_editable_media o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                    </div>
                                    <div data-name="Card" class="o_grid_item o_colored_level g-col-lg-3 g-height-4 col-lg-3" style="z-index: 5; grid-area: 5 / 4 / 9 / 7;">
                                        <div class="s_card card h-100 o_cc my-0 o_colored_level o_cc4 border" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                                            <div class="card-body">
                                                <p><span style="font-style: normal;" class="h4-fs"><strong>“We select every toy with care”</strong></span></p>
                                                <p><span style="font-style: normal;" class="h6-fs">Jeanne and Marcel Ludion, 1976</span></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_timeline o_colored_level o_cc pb0 o_cc1 pt0" data-vcss="002" data-snippet="s_timeline" data-name="Timeline">
                            <div class="o_container_small">
                                <h2 style="text-align: center;">Fifty years, four turning points</h2>
                                <div style="text-align: center;">1976 — today<br/><br/><br/></div>
                                <p><br/></p>
                                <div class="position-relative pt-3">
                                    <div class="s_timeline_row position-relative d-flex gap-md-5 flex-column flex-md-row pb-4" data-name="Milestone">
                                        <div class="o_dot_line position-absolute top-0 bottom-0 w-0 mb-1 border-start pe-none"><br/></div>
                                        <span class="o_dot o_not_editable position-absolute translate-middle-x rounded-circle pe-none"><br/></span>
                                        <div class="s_timeline_content w-100 ps-4 ps-md-0">
                                            <div class="s_timeline_card s_card card my-0 ms-auto text-md-end o_colored_level o_animate o_anim_fade_in o_visible o_anim_from_left" style="--wanim-intensity: 4; border-width: 0px !important; animation-name: dummy;" data-vxml="001" data-snippet="s_card" data-name="Milestone Event">
                                                <div class="card-body">
                                                    <span class="h5-fs"><small class="text-o-color-1"><strong>1976</strong></small></span>
                                                    <small class="text-muted"><br/></small>
                                                    <h3 class="h4-fs card-title">The first shop</h3>
                                                    <div>Thirty square metres on Rue des Ludions: wooden toys and an oak counter.</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_timeline_content w-0 w-md-100 h-0"><br/></div>
                                    </div>
                                    <div class="s_timeline_row position-relative d-flex gap-md-5 flex-column flex-md-row pb-4" data-name="Milestone">
                                        <div class="o_dot_line position-absolute top-0 bottom-0 w-0 mb-1 border-start pe-none"><br/></div>
                                        <span class="o_dot o_not_editable position-absolute translate-middle-x rounded-circle pe-none"><br/></span>
                                        <div class="s_timeline_content w-0 w-md-100 h-0"><br/></div>
                                        <div class="s_timeline_content w-100 ps-4 ps-md-0">
                                            <div class="s_timeline_card s_card card my-0 ms-auto o_colored_level o_animate o_anim_fade_in o_visible o_anim_from_right" style="--wanim-intensity: 4; border-width: 0px !important; animation-name: dummy;" data-vxml="001" data-snippet="s_card" data-name="Milestone Event">
                                                <div class="card-body">
                                                    <span class="h5-fs"><small class="text-o-color-1"><strong>1994</strong></small></span>
                                                    <small class="text-muted"><br/></small>
                                                    <h3 class="h4-fs card-title">Board games arrive</h3>
                                                    <div>Claire takes over and sets up the first demo table by the window.</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="s_timeline_row position-relative d-flex gap-md-5 flex-column flex-md-row pb-4" data-name="Milestone">
                                        <div class="o_dot_line position-absolute top-0 bottom-0 w-0 mb-1 border-start pe-none"><br/></div>
                                        <span class="o_dot o_not_editable position-absolute translate-middle-x rounded-circle pe-none"><br/></span>
                                        <div class="s_timeline_content w-100 ps-4 ps-md-0">
                                            <div class="s_timeline_card s_card card my-0 ms-auto o_colored_level text-md-end o_animate o_anim_fade_in o_visible o_anim_from_left" style="--wanim-intensity: 4; border-width: 0px !important; animation-name: dummy;" data-vxml="001" data-snippet="s_card" data-name="Milestone Event">
                                                <div class="card-body">
                                                    <span class="h5-fs"><small class="text-o-color-1"><strong>2019</strong></small></span>
                                                    <small class="text-muted"><br/></small>
                                                    <h3 class="h4-fs card-title">The online store</h3>
                                                    <div>Tom launches the site and two-hour click &amp;amp; collect, run from the back room.</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_timeline_content w-0 w-md-100 h-0"><br/></div>
                                    </div>
                                    <div class="s_timeline_row position-relative d-flex gap-md-5 flex-column flex-md-row pb-4" data-name="Milestone">
                                        <div class="o_dot_line position-absolute top-0 bottom-0 w-0 mb-1 border-start pe-none"><br/></div>
                                        <span class="o_dot o_not_editable position-absolute translate-middle-x rounded-circle pe-none"><br/></span>
                                        <div class="s_timeline_content w-0 w-md-100 h-0"><br/></div>
                                        <div class="s_timeline_content w-100 ps-4 ps-md-0">
                                            <div class="s_timeline_card s_card card my-0 ms-auto o_colored_level o_animate o_anim_fade_in o_visible o_anim_from_right" style="--wanim-intensity: 4; border-width: 0px !important; animation-name: dummy;" data-vxml="001" data-snippet="s_card" data-name="Milestone Event">
                                                <div class="card-body">
                                                    <span class="h5-fs"><small class="text-o-color-1"><strong>2024</strong></small></span>
                                                    <small class="text-muted"><br/></small>
                                                    <h3 class="h4-fs card-title">Thursday game nights</h3>
                                                    <div>Three tables, 24 seats, one themed evening every week&amp;nbsp;open to everyone.</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_the_store" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_the_store"/>
            <field name="url">/about</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
