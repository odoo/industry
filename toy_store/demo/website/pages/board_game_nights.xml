<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_board_game_nights" model="ir.ui.view">
        <field name="name">Board game nights</field>
        <field name="key">toy_store.page_board_game_nights</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="toy_store.page_board_game_nights">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_split_intro o_cc o_cc1 o_colored_level" data-snippet="s_split_intro" data-name="Split Intro">
                            <div class="container-fluid">
                                <div class="row">
                                    <div class="o_not_editable oe_img_bg o_bg_img_center o_colored_level o_bg_img_origin_border_box o_animate o_anim_fade_in o_visible col-lg-6 pb120 pt120" style="background-image: url(&quot;/web/image/toy_store.img_ludiplay_image_08&quot;); animation-name: dummy;" data-format-mimetype="image/webp" data-resize-width="1034" data-mimetype="image/webp"/>
                                    <div class="o_colored_level o_animate o_anim_fade_in o_visible col-lg-4 offset-lg-1 pt80 pb72" style="animation-name: dummy;">
                                        <h1>Three tables.</h1>
                                        <h1>Twenty-four seats.</h1>
                                        <h1>One evening a week</h1>
                                        <p class="lead">Free, open to everyone, nothing to prepare. A host lays out the games and teaches the rules — you only choose which table you sit at.<br/><br/></p>
                                        <p>
                                            <a class="o_translate_inline mb-2 btn btn-lg btn-primary" href="/appointment/soiree-jeux-1">Book now</a> &amp;nbsp;&amp;nbsp;<a class="o_translate_inline mb-2 btn btn-lg btn-secondary" href="#how-it-works">How it works</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_title_split o_colored_level o_cc o_cc3 pt24 pb8" data-snippet="s_title_split" data-name="Title Split">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-3 o_animate o_anim_fade_in o_visible o_anim_from_left" style="--wanim-intensity: 4; animation-name: dummy;">
                                        <p><span class="text-o-color-1">NEXT GAME NIGHT<br/></span><span class="h4-fs">Thursday 13 August</span></p>
                                    </div>
                                    <div class="o_colored_level col-lg-4 pt8 o_animate o_anim_fade_in o_visible o_anim_from_left" style="--wanim-intensity: 4; animation-delay: 0.2s; animation-name: dummy;">
                                        <p><span class="text-o-color-1">7 seats left</span> <br/><span>Doors open at 6:45 pm. Start at 7:00 pm.</span></p>
                                    </div>
                                    <div class="o_colored_level offset-lg-1 pt8 col-lg-4 o_animate o_anim_fade_in o_visible" style="animation-delay: 0.5s; animation-name: dummy;">
                                        <p style="text-align: end;"><a href="/appointment/soiree-jeux-1" class="o_translate_inline btn btn-primary">Book this Thursday</a></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_title_split pt80 pb80 o_colored_level" data-snippet="s_title_split" data-name="Title Split" id="how-it-works" data-anchor="true">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="o_colored_level col-lg-5 pb40" style="animation-name: dummy;">
                                        <p><span class="o_text_highlight o_text_highlight_bold_1" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;"><span class="o_text_highlight o_text_highlight_bold_1 h5-fs" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;">HOW IT WORKS</span></span></p>
                                        <h2>Turn up at seven,<br/>you are playing by ten past.</h2>
                                        <p>No rules to read, no group to bring, no experience needed. You choose the games, we bring them to the table and explain them.</p>
                                    </div>
                                    <div class="offset-lg-1 o_colored_level col-lg-6" style="animation-name: dummy;">
                                        <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <div class="o_text_columns o-contenteditable-false">
                                            <div class="row">
                                                <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                                    <p><span class="text-o-color-2"><span class="fa fa-clock-o text-o-color-2"/>&amp;nbsp;6:45 pm</span></p>
                                                </div>
                                                <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                                    <p><span class="h5-fs"><strong>Doors open</strong></span></p>
                                                    <p>The tables go up and the whole games shelf comes out&amp;nbsp;around 400 boxes, all of them open to play.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <div class="o_text_columns o-contenteditable-false">
                                            <div class="row">
                                                <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                                    <p><span class="text-o-color-2"><span class="fa fa-clock-o text-o-color-2"/>&amp;nbsp;7:00 pm</span></p>
                                                </div>
                                                <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                                    <p><span class="h5-fs"><strong>Choose your game</strong></span><br/></p>
                                                    <p>Browse the shelf and take whatever you feel like, short, long, family, strategy. Tell us how many you are and we set it up. Your seat is held until 7:30 pm.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <div class="o_text_columns o-contenteditable-false">
                                            <div class="row">
                                                <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                                    <p><span class="text-o-color-2"><span class="fa fa-clock-o text-o-color-2"/>&amp;nbsp;7:10 pm</span></p>
                                                </div>
                                                <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                                    <p><span class="h5-fs"><strong>Rules in ten minutes</strong></span><br/></p>
                                                    <p>Someone from the shop teaches the game at the table, then takes a seat and plays with you. First round is a practice round&amp;nbsp;nobody keeps score.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <div class="o_text_columns o-contenteditable-false">
                                            <div class="row">
                                                <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                                    <p><span class="text-o-color-2"><span class="fa fa-clock-o text-o-color-2"/>&amp;nbsp;9:00 pm</span></p>
                                                </div>
                                                <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                                    <p><span class="h5-fs"><strong>Change games, or keep going</strong></span><br/></p>
                                                    <p>Finished early? Put the box back and take another one. Long games run straight through the evening if that is what you picked.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <div class="o_text_columns o-contenteditable-false">
                                            <div class="row">
                                                <div class="o-contenteditable-true o_colored_level col-lg-3 col-3">
                                                    <p><span class="text-o-color-2"><span class="fa fa-clock-o text-o-color-2"/>&amp;nbsp;11:00 pm</span></p>
                                                </div>
                                                <div class="o-contenteditable-true o_colored_level col-lg-9 col-9">
                                                    <p><span class="h5-fs"><strong>Last box closed</strong></span><br/></p>
                                                    <p>We tidy up together, and whatever you played is on the shelf if you want to take it home.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="s_hr pb16 pt0" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_cards_grid o_colored_level o_cc pb64 o_cc1 pt0" data-vxml="001" data-snippet="s_cards_grid" data-name="Cards Grid">
                            <div class="container">
                                <p style="text-align: center;"><span class="o_text_highlight o_text_highlight_bold_1" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;"><span class="o_text_highlight o_text_highlight_bold_1 h5-fs" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;">GOOD TO KNOW</span></span></p>
                                <h2 style="text-align: center;">Everything people ask at the door</h2>
                                <div class="row">
                                    <div data-name="Card" class="d-flex flex-column col-lg-4 o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 4; animation-name: dummy;">
                                        <div class="s_card o_cc card h-100 o_colored_level o_cc5 border" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px;">
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Do I need to know the games?</h3>
                                                <div>Not at all. Bring any box to the table and we teach it there and then&amp;nbsp;the first round never counts.</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="d-flex flex-column col-lg-4 o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 4; animation-name: dummy;">
                                        <div class="s_card o_cc card h-100 o_cc5 border o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px;">
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Can I come on my own?</h3>
                                                <div>Plenty do. Tell us at the door and we sit you with a group that is just starting something, or one of us plays with you.</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="d-flex flex-column col-lg-4 o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 4; animation-name: dummy;">
                                        <div class="s_card o_cc card h-100 o_cc5 border o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px;">
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Do I have to book?</h3>
                                                <div>Yes, booking is mandatory. It is free and your seat is held until 7:30 pm.</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="d-flex flex-column col-lg-4 o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 4; animation-name: dummy;">
                                        <div class="s_card o_cc card h-100 o_cc5 border o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px;">
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Can I bring children?</h3>
                                                <div>From 8 years old, with an adult, until 9 pm. Younger ones are welcome in the shop during opening hours instead.</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="d-flex flex-column col-lg-4 o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 4; animation-name: dummy;">
                                        <div class="s_card o_cc card h-100 o_cc5 border o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px;">
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Is it really free?</h3>
                                                <div>Yes. Nothing to pay to sit down and nothing to buy though most people leave with the box they just played.</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="d-flex flex-column col-lg-4 o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 4; animation-name: dummy;">
                                        <div class="s_card o_cc card h-100 o_cc5 border o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px;">
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Anything to drink?</h3>
                                                <div>Coffee, soft drinks and local beers at the counter. Bring your own snacks if you like.</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_cta_centered pb80 o_colored_level pt0" data-snippet="s_cta_centered" data-name="Centered Call to Action">
                            <div class="container">
                                <div class="s_card card o_cc o_cc4 o_colored_level rounded border o_animate o_anim_fade_in o_visible" data-snippet="s_card" data-vxml="001" data-name="Card" style="--card-spacer-x: 64px; --card-spacer-y: 64px; --box-border-bottom-left-radius: 16px; --box-border-bottom-right-radius: 16px; --box-border-top-right-radius: 16px; --box-border-top-left-radius: 16px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; animation-name: dummy;">
                                    <div class="card-body">
                                        <div class="o_text_columns o-contenteditable-false">
                                            <div class="row">
                                                <div class="o-contenteditable-true o_colored_level col-12 col-lg-6">
                                                    <h2 class="card-title" style="text-align: start;">Coming as a group?</h2>
                                                    <p class="card-title" style="text-align: start;">Six or more of you: reserve a whole table. Tell us what you usually enjoy and we will have a few suggestions out&amp;nbsp;you still choose on the night.</p>
                                                </div>
                                                <div class="o-contenteditable-true o_colored_level pt32 col-12 col-lg-6">
                                                    <p style="text-align: end;"><a href="/appointment/1" class="o_translate_inline btn btn-primary">Book now</a></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_board_game_nights" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_board_game_nights"/>
            <field name="url">/board-game-nights</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
