<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">wine_merchant.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="wine_merchant.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', ''),}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_animated_cover o_colored_level o_cc oe_img_bg o_bg_img_center o_bg_img_origin_border_box o_cc1 pb0 pt48" style="background-image: url(&quot;/web/image/wine_merchant.img_wine_merchant_image_01&quot;); position: relative;" data-snippet="s_animated_cover" data-name="Animated Cover" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Nature/04&quot;,&quot;colors&quot;:{&quot;c1&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}">
                            <div class="o_we_bg_filter" style="background-color: rgba(250, 250, 250, 0.82);"/>
                            <div class="o_we_shape o_html_builder_Nature_04 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FNature%2F04.svg?c1=%23FFFFFF&quot;);"/>
                            <div class="oe_structure oe_empty">
                                <section class="s_text_block o_colored_level pb0 pt72" data-snippet="s_text_block" data-name="Text">
                                    <div class="s_allow_columns container">
                                        <h1 class="display-2">CONTACT US</h1>
                                        <p class="lead">Write us a message and we will get back to you as soon as possible.</p>
                                    </div>
                                </section>
                            </div>
                        </section>
                        <section class="s_text_block pt40 o_colored_level pb0" data-snippet="s_text_block" data-name="Text" id="ASK-US" data-anchor="true">
                            <div class="s_allow_columns container">
                                <div class="row o_grid_mode" data-row-count="13">
                                    <div class="mt-4 mt-lg-0 o_colored_level o_grid_item g-col-lg-6 g-height-13 col-lg-6" style="grid-area: 1 / 1 / 14 / 7; z-index: 6; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px;">
                                        <p>
                                            <br/>
                                        </p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name">
                                                            <label class="s_website_form_label" for="ohdu131xwuqd" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="" id="ohdu131xwuqd" data-fill-with="name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="tel" data-translated-name="Phone Number">
                                                            <label class="s_website_form_label" for="ogq6s3dg6ix4" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="phone" placeholder="" id="ogq6s3dg6ix4" data-fill-with="phone"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required col-lg-6" data-type="email" data-translated-name="Your Email">
                                                            <label class="s_website_form_label" for="ovb8ja2s5wgo" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="ovb8ja2s5wgo" data-fill-with="email"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Company">
                                                            <label class="s_website_form_label" for="ott4rboev13" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Company</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="partner_name" required="" value="" placeholder="" id="ott4rboev13" data-fill-with="commercial_company_name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject">
                                                            <label class="s_website_form_label" for="ojrtosnb0ym" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="ojrtosnb0ym" data-fill-with="undefined"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="Your Question">
                                                            <label class="s_website_form_label" for="oqzlozsy7yxd" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Question</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="oqzlozsy7yxd" rows="3"/>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send">Send</a>
                                                            <span id="s_website_form_result" class="me-2 small text-danger"/>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="o_grid_item o_grid_item_image o_colored_level o_grid_item_image_contain d-lg-block d-none o_snippet_mobile_invisible g-col-lg-4 g-height-7 col-lg-4" style="z-index: 7; grid-area: 1 / 9 / 8 / 13;" data-invisible="1">
                                        <img src="/web/image/wine_merchant.img_wine_merchant_image_17" alt="" class="img img-fluid o_we_custom_image o_editable_media o_animate o_animate_on_scroll o_anim_slide_in o_anim_from_bottom" data-scroll-zone-start="0" data-scroll-zone-end="100" loading="eager"/>
                                    </div>
                                    <div class="o_grid_item g-height-8 o_grid_item_image o_grid_item_image_contain g-col-lg-4 col-lg-4 o_colored_level d-lg-block d-none o_snippet_mobile_invisible" style="z-index: 5; grid-area: 4 / 9 / 12 / 13;" data-invisible="1">
                                        <img src="/web/image/wine_merchant.img_wine_merchant_image_14" alt="" class="img img-fluid o_we_custom_image o_editable_media o_attachment_pending_record_id o_animate o_animate_on_scroll o_anim_slide_in o_anim_from_left" data-format-mimetype="image/webp" data-resize-width="466" data-mimetype="image/webp" data-scroll-zone-start="0" data-scroll-zone-end="100" style="--wanim-intensity: 9;" loading="eager"/>
                                    </div>
                                    <div class="o_grid_item o_grid_item_image o_grid_item_image_contain o_colored_level d-lg-block d-none o_snippet_mobile_invisible g-height-7 g-col-lg-4 col-lg-4" style="z-index: 4; grid-area: 4 / 8 / 11 / 12;" data-invisible="1">
                                        <img src="/web/image/wine_merchant.img_wine_merchant_image_15" alt="" class="img img-fluid o_we_custom_image o_editable_media o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="424" data-mimetype="image/webp" loading="lazy"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_announcement_scroll s_announcement_scroll_direction_left s_announcement_scroll_hover_pause w-100 o_colored_level pb40 pt64" style="--marquee-animation-speed: 5s; --marquee-item-font-size: 80;" role="marquee" data-snippet="s_announcement_scroll" data-name="Announcement Scroll">
                            <div class="s_announcement_scroll_marquee_container d-flex s_announcement_scroll_heading_family">
                                <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">• CONTACT INFORMATIONS</div>
                            </div>
                        </section>
                        <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container s_allow_columns">
                                <div class="row o_grid_mode" data-row-count="7">
                                    <div class="o_grid_item o_colored_level g-col-lg-8 g-height-3 col-lg-8" style="grid-area: 1 / 1 / 4 / 9; z-index: 1;">
                                        <h2>
                                            HOW CAN YOU<br />
                                            FIND US ?
                                        </h2>
                                    </div>
                                    <div class="o_grid_item o_colored_level g-height-7 col-lg-4 g-col-lg-4" style="z-index: 2; grid-area: 1 / 9 / 8 / 13;">
                                        <section data-map-type="m" data-map-zoom="12" data-vxml="001" class="s_map rounded-3 o_not_editable pb160 pt152" data-map-address="Avenue des déportés 48 Ramillies Belgium" data-snippet="s_map" data-name="Map">
                                            <div class="map_container">
                                                <div class="css_non_editable_mode_hidden">
                                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                        An address must be specified for a map to be embedded
                                                    </div>
                                                </div>
                                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=250%20Executive%20Park%20Blvd%2C%20Suite%203400%20San%20Francisco%20California%20(US)%20United%20States&amp;t=m&amp;z=12&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                                <div class="s_map_color_filter"/>
                                            </div>
                                        </section>
                                        <p>
                                            <br/>
                                        </p>
                                    </div>
                                    <div class="o_grid_item o_colored_level g-height-4 g-col-lg-3 col-lg-3 d-lg-block d-none o_snippet_mobile_invisible" style="z-index: 6; grid-area: 1 / 7 / 5 / 10;" data-invisible="1">
                                        <p>
                                            <img src="/web/image/wine_merchant.img_wine_merchant_image_16" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="444" data-mimetype="image/webp" loading="lazy"/>
                                        </p>
                                    </div>
                                    <div class="o_grid_item g-height-4 o_colored_level g-col-lg-4 col-lg-4" style="z-index: 3; grid-area: 4 / 1 / 8 / 5;">
                                        <p>
                                            <strong>
                                                <span class="text-o-color-5">Address<br/></span>
                                            </strong>
                                            Chaussée de Namur, 40<br/>
                                            1367 Ramilies
                                        </p>
                                        <p>
                                            <strong>
                                                <span class="text-o-color-5">Open hours<br/></span>
                                            </strong>
                                            MO-SA: 10h - 18h
                                        </p>
                                    </div>
                                    <div class="o_grid_item g-height-4 o_colored_level g-col-lg-4 col-lg-4" style="z-index: 4; grid-area: 4 / 5 / 8 / 9;">
                                        <p>
                                            <strong>
                                                <span class="text-o-color-5">Email<br/></span>
                                            </strong>
                                            <a href="mailto:info@vinumpopuli.example.com" class="o_translate_inline">info@vinumpopuli.example.com</a>
                                        </p>
                                        <p>
                                            <strong>
                                                <span class="text-o-color-5">Phone<br/></span>
                                            </strong>
                                            +32 2 290 34 90
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
