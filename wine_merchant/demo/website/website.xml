<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="website_industry" model="website" context="{'foreign_record_to_create': True}">
        <field name="name">Vinum Populi</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="user_id" ref="base.public_user"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="cart_recovery_mail_template_id" eval="False"/>
        <field name="logo" type="bytes" file="wine_merchant/static/src/img/content/website/logo.svg"/>
        <field name="favicon" type="bytes" file="wine_merchant/static/description/favicon.png"/>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[('name', '=', 'default_website'), ('module', '=', 'base'), ('model', '=', 'website')]"/>
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
</odoo>
