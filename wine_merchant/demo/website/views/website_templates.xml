<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_event_index_topbar" model="ir.ui.view">
        <field name="name">Custom - Topbar</field>
        <field name="key">website_event.index_topbar</field>
        <field name="inherit_id" ref="website_event.index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[hasclass('mb-0', 'h4-fs')]" position="replace">
                <h1 class="mb-0 h1-fs">EVENTS</h1>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta w-100">Contact Us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="header_text_element" model="ir.ui.view">
        <field name="name">Custom - Header Text element</field>
        <field name="key">wine_merchant.header_text_element</field>
        <field name="inherit_id" ref="website.header_text_element"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-elif=&quot;_txt_elt_content == 'phone_mail'&quot;]" position="replace">
                <t t-elif="_txt_elt_content == 'phone_mail'">
                    <div t-attf-class="s_text_block #{_div_class}" data-name="Text" class="s_text_block mt-2">
                        <a href="tel:+3222903490" class="nav-link o_nav-link_secondary">
                            <small>
                                <span class="text-o-color-1"><i class="oi oi-filled oi-1x oi-fw me-1" data-icon="phone"/>+32 2 290 34 90</span>
                            </small>
                        </a>
                        <small>
                            <i class="oi oi-filled oi-1x oi-fw me-1" data-icon="mail"/> <a href="mailto:info@vinumpopuli.example.com" class="o_translate_inline">info@vinumpopuli.example.com</a>
                        </small>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
    <record id="option_header_brand_name" model="ir.ui.view">
        <field name="name">Custom - Header Brand Name</field>
        <field name="key">website.option_header_brand_name</field>
        <field name="inherit_id" ref="website.placeholder_header_brand"/>
        <field name="website_id" ref="website_industry"/>
        <!-- created inactive: server_actions.xml deactivates the brand logo
             option first, then activates this view -->
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//*[@id='o_fake_navbar_brand']" position="replace">
                <a href="/" t-attf-class="navbar-brand #{_link_class}" class="navbar-brand order-1 mx-auto mw-100">
                    <span class="h4-fs">
                        <strong>VINUM <span class="text-o-color-5">POPULI</span></strong>
                    </span>
                </a>
            </xpath>
        </field>
    </record>
    <record id="template_footer_centered" model="ir.ui.view">
        <field name="name">Custom - Centered</field>
        <field name="key">website.template_footer_centered</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt32" data-snippet="s_text_block" data-name="Container" style="position: relative;">
                        <div class="s_allow_columns container">
                            <div class="row o_grid_mode" data-row-count="6">
                                <div class="o_colored_level o_grid_item g-col-lg-12 g-height-4 col-lg-12" style="grid-area: 1 / 1 / 5 / 13; z-index: 1;">
                                    <div class="s_social_media text-center o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi rounded-empty-circle shadow-sm o_editable_media" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="oi rounded-empty-circle shadow-sm o_editable_media" data-icon="oi_x"/>
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                            <i class="oi rounded-empty-circle shadow-sm o_editable_media" data-icon="oi_linkedin"/>
                                        </a>
                                    </div>
                                    <div class="s_hr pt24 pb24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="o_colored_level o_grid_item g-col-lg-4 g-height-3 col-lg-4" style="grid-area: 3 / 1 / 6 / 5; z-index: 2;">
                                    <p style="text-align: center;">
                                        Chaussée de Namur, 40<br/>
                                        1367 Ramilies
                                    </p>
                                </div>
                                <div class="o_colored_level o_grid_item g-height-2 o_grid_item_image o_grid_item_image_contain g-col-lg-2 col-lg-2 offset-lg-0 col-6 offset-3" style="grid-area: 3 / 6 / 5 / 8; z-index: 3;">
                                    <a href="/" class="o_footer_logo logo">
                                        <img src="/web/image/wine_merchant.img_wine_merchant_image_18" alt="" class="img-fluid d-block mx-auto img o_we_custom_image o_attachment_pending_record_id o_editable_media" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="o_colored_level o_grid_item g-col-lg-4 g-height-3 col-lg-4" style="grid-area: 3 / 9 / 6 / 13; z-index: 4;">
                                    <ul class="list-unstyled">
                                        <li style="text-align: center;">+32 2 290 34 90</li>
                                        <li style="text-align: center;">
                                            <a href="mailto:info@vinumpopuli.example.com">info@vinumpopuli.example.com</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="o_colored_level o_grid_item g-col-lg-12 g-height-1 col-lg-12" style="grid-area: 6 / 1 / 7 / 13; z-index: 5;">
                                    <ul class="list-unstyled">
                                        <li style="text-align: center;">Copyrights 2026 © Vinum Populi</li>
                                    </ul>
                                </div>
                                <div class="o_grid_item o_grid_item_image o_grid_item_image_contain o_colored_level g-col-lg-3 g-height-6 col-lg-3 d-lg-block d-none o_snippet_mobile_invisible" style="z-index: 0; grid-area: 1 / 8 / 7 / 11;" data-invisible="1">
                                    <a href="/" class="o_footer_logo logo">
                                        <img src="/web/image/wine_merchant.img_wine_merchant_image_07" alt="" class="img-fluid d-block mx-auto img o_we_custom_image o_attachment_pending_record_id o_editable_media" data-format-mimetype="image/webp" data-resize-width="545" data-mimetype="image/webp" loading="lazy"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
