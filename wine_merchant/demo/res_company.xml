<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="base.main_company" model="res.company" forcecreate="0">
        <field name="email">info@vinumpopuli.example.com</field>
        <field name="logo" type="bytes" file="wine_merchant/static/description/icon.png"/>
        <field name="partner_id" ref="base.main_partner"/>
        <field name="name">Vinum Populi</field>
        <field name="phone">+32 2 290 34 90</field>
        <field name="street">Chaussée de Namur 40</field>
        <field name="zip">1367</field>
        <field name="city">Ramillies</field>
        <field name="country_id" ref="base.be"/>
        <field name="currency_id" ref="base.EUR"/>
    </record>
    <!-- the pricelists from data/ were created in the previous company currency -->
    <function model="product.pricelist" name="write">
        <value eval="[ref('product_pricelist_1'), ref('product_pricelist_2')]"/>
        <value eval="{'currency_id': ref('base.EUR')}"/>
    </function>
</odoo>
