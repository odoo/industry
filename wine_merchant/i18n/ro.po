#. module: wine_merchant
#: model_terms:ir.ui.view,arch_db:wine_merchant.view_page_home
msgid ""
"<span class=\"h2-fs text-o-color-5\">“Matteo sees wine as a meeting point "
"between people, land and time. His Barbera comes from old vines cultivated "
"without synthetic treatments, producing a lively, generous wine with bright "
"acidity and ripe fruit.”</span>"
msgstr ""
"<span class=\"h2-fs text-o-color-5\">“Matteo vede vinul ca pe un punct de "
"întâlnire între oameni, pământ și timp. Barbera lui provine din vițe vechi "
"cultivate fără tratamente sintetice și oferă un vin vioi și generos, cu "
"aciditate proaspătă și fructe bine coapte.”</span>"

#. module: wine_merchant
#: model_terms:ir.ui.view,arch_db:wine_merchant.view_page_home
msgid ""
"<span class=\"h2-fs text-o-color-5\">“On the volcanic soils of Greece, Nikos "
"farms his vines with patience and precision. His Assyrtiko combines bright "
"citrus, mineral freshness and a subtle saline character.”</span>"
msgstr ""
"<span class=\"h2-fs text-o-color-5\">“Pe solurile vulcanice ale Greciei, "
"Nikos își cultivă vița-de-vie cu răbdare și precizie. Assyrtiko-ul său "
"îmbină notele citrice proaspete, prospețimea minerală și un caracter discret "
"sărat.”</span>"

#. module: wine_merchant
#: model_terms:ir.ui.view,arch_db:wine_merchant.view_page_home
msgid ""
"<span class=\"h2-fs\"><span class=\"text-o-color-5\">“For Elena, wine begins "
"in the vineyard. Her Sangiovese is made from organically grown grapes, "
"harvested by hand and fermented with minimal intervention.”</span></span>"
msgstr ""
"<span class=\"h2-fs\"><span class=\"text-o-color-5\">“Pentru Elena, vinul "
"începe în vie. Sangiovese-ul ei este obținut din struguri cultivați "
"ecologic, culeși manual și fermentați cu intervenție minimă.”</span></span>"

#. module: wine_merchant
#: model_terms:ir.ui.view,arch_db:wine_merchant.view_page_home
msgid ""
"<span class=\"h3-fs\">Opening <span class=\"text-o-color-5\">hours</span></"
"span>"
msgstr ""
"<span class=\"h3-fs\">Program de <span class=\"text-o-color-5\">lucru</span>"
"</span>"

