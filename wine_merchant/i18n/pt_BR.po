#. module: wine_merchant
#: model_terms:ir.ui.view,arch_db:wine_merchant.view_page_home
#, fuzzy
msgid ""
"<span class=\"h2-fs text-o-color-5\">“Matteo sees wine as a meeting point "
"between people, land and time. His Barbera comes from old vines cultivated "
"without synthetic treatments, producing a lively, generous wine with bright "
"acidity and ripe fruit.”</span>"
msgstr ""
"<span class=\"h2-fs text-o-color-5\">“Matteo vê o vinho como um ponto de "
"encontro entre pessoas, terra e tempo. O Barbera dele vem de vinhas antigas "
"cultivadas sem tratamentos sintéticos, produzindo um vinho alegre e generoso "
"com acidez brilhante e frutas maduras.”</span>"

#. module: wine_merchant
#: model_terms:ir.ui.view,arch_db:wine_merchant.view_page_home
#, fuzzy
msgid ""
"<span class=\"h2-fs text-o-color-5\">“On the volcanic soils of Greece, Nikos "
"farms his vines with patience and precision. His Assyrtiko combines bright "
"citrus, mineral freshness and a subtle saline character.”</span>"
msgstr ""
"<span class=\"h2-fs text-o-color-5\">“Nos solos vulcânicos da Grécia, Nikos "
"cultiva suas vinhas com paciência e precisão. O Assyrtiko dele combina "
"frutas cítricas brilhantes, frescor mineral e um sutil caráter salino.”</"
"span>"

#. module: wine_merchant
#: model_terms:ir.ui.view,arch_db:wine_merchant.view_page_home
#, fuzzy
msgid ""
"<span class=\"h2-fs\"><span class=\"text-o-color-5\">“For Elena, wine begins "
"in the vineyard. Her Sangiovese is made from organically grown grapes, "
"harvested by hand and fermented with minimal intervention.”</span></span>"
msgstr ""
"<span class=\"h2-fs\"><span class=\"text-o-color-5\">“Para Elena, o vinho "
"começa no vinhedo. O Sangiovese dela é feito de uvas cultivadas "
"organicamente, colhidas à mão e fermentadas com intervenção mínima.”</span></"
"span>"

