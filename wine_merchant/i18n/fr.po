msgid ""
"<span class=\"text-o-color-5\">At Vinum Populi, we believe great wine should "
"be part of everyday life, not reserved for a privileged few. We carefully "
"select <strong>Local producers</strong> who respect their land and craft "
"wines with character. We offer <strong>Accessible prices</strong> without "
"compromising quality, while championing <strong>Organic &amp;amp; natural</"
"strong> approaches that respect the vineyard, the people, and the future of "
"our soils.</span>"
msgstr ""

#. module: wine_merchant
#: model_terms:ir.ui.view,arch_db:wine_merchant.view_page_home
msgid ""
"<span class=\"text-o-color-5\">Great wine should be enjoyed by everyone, "
