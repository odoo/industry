msgstr ""
"<strong><font class=\"text-black\"><span style=\"font-weight: normal;\">使用"
"</span></font><font class=\"text-o-color-1\">日历应用程序</font><font "
"class=\"text-black\"><span style=\"font-weight: normal;\">，管理日程安排及空"
"间时间。</span></font></strong>"

#. module: physical_therapy
#: model_terms:ir.ui.view,arch_db:physical_therapy.welcome_article_body
msgid ""
"<strong><span class=\"display-4-fs\">Odoo for Physical Therapy</span></"
"strong>"
