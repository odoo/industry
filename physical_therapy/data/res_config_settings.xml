<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <function name="create" model="res.config.settings">
        <value model="res.company" eval="{'account_price_include': 'tax_included'} if not obj().env.company._existing_accounting() else {}"/>
    </function>
    <function model="res.config.settings" name="execute" eval="[obj().search([], order='create_date DESC', limit=1).id]"/>
</odoo>
