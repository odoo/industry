#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-o-color-4\">Absolutely. All our field "
"engineers and inspectors hold the required national and international "
"accreditations (such as ISO/IEC 17020) to perform regulatory compliance "
"testing on your specific machinery and systems.</span>"
msgstr ""

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-o-color-4\">For most standard inspections, you "
"will receive a verbal debriefing immediately on-site, followed by the "
"official digital compliance report and clearance certificate within "
"72&amp;nbsp;hours.</span>"
msgstr ""

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-o-color-4\">Periodic inspection frequencies "
"are defined by national regulations. For example, lifting equipment often "
"requires checking every 6 to 12 months, while electrical installations may "
"require annual inspections. We track these deadlines for you.</span>"
msgstr ""

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-o-color-4\">The duration depends on the number "
"and complexity of the installations being tested. A single crane inspection "
"might take a few hours, while a full electrical network compliance check for "
"a large facility could take several days.</span>"
msgstr ""

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-o-color-4\">Yes, our inspectors regularly "
"intervene on temporary construction sites, public events, and temporary "
"stages to validate structural stability, fire safety, and electrical setups "
"before public opening or worksite launch.</span>"
msgstr ""

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_contactus
