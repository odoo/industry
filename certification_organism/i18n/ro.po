#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_home
msgid ""
"<span class=\"h1-fs\">\n"
"                                                <em>\"Certification is not "
"an end in itself—it is tangible proof that an organization has its risks "
"under control and is committed to its future.\"</em>\n"
"                                            </span>"
msgstr ""
"<span class=\"h1-fs\">\n"
"                                                <em>„Certificarea nu este un "
"scop în sine, ci dovada concretă că o organizație își controlează riscurile "
"și investește în viitorul său.”</em>\n"
"                                            </span>"

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_contactus
msgid ""
"<span class=\"h3-fs text-o-color-3\">Our teams will respond within 24 "
"business hours</span>\n"
"                                            <br/>"
msgstr ""
"<span class=\"h3-fs text-o-color-3\">Echipele noastre îți vor răspunde în "
"cel mult 24 de ore lucrătoare.</span>\n"
"                                            <br/>"

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_home
msgid ""
"<span class=\"h3-fs\">\n"
"                                                                <em>\"Averis "
"inspectors are incredibly responsive. They checked our tower cranes and "
"scaffolding just in time before our major site launch. Essential partners "
"for site safety.\"</em>\n"
"                                                            </span>"
msgstr ""
"<span class=\"h3-fs\">\n"
"                                                                <em>„"
"Inspectorii Averis răspund prompt. Au verificat la timp macaralele turn și "
"schelele, înainte de deschiderea șantierului nostru. Sunt parteneri "
"esențiali pentru siguranța lucrărilor.”</em>\n"
"                                                            </span>"

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_home
msgid ""
"<span class=\"h3-fs\">\n"
"                                                                <em>\"For "
"our outdoor festivals, the safety of temporary stages and electrical setups "
"is critical. Averis inspectors are always on time, incredibly thorough, and "
"deliver the clearance certificates immediately so the show can go on.\"</"
"em>\n"
"                                                            </span>\n"
"                                                            <br/>"
msgstr ""
"<span class=\"h3-fs\">\n"
"                                                                <em>„La "
"festivalurile noastre în aer liber, siguranța scenelor temporare și a "
"instalațiilor electrice este esențială. Inspectorii Averis sunt punctuali și "
"minuțioși, iar certificatele de autorizare sunt eliberate imediat, astfel "
"încât evenimentul să poată continua.”</em>\n"
"                                                            </span>\n"
"                                                            <br/>"

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_home
msgid ""
"<span class=\"h3-fs\">\n"
"                                                                <em>\"We "
"manage a fleet of over 50 heavy lifting machines. Averis handles our "
"periodic load testing and safety checks directly on our construction sites "
"with zero disruption to our daily operations. True field experts.\"</em>\n"
"                                                            </span>\n"
"                                                            <br/>"
msgstr ""
"<span class=\"h3-fs\">\n"
"                                                                <em>„"
"Gestionăm peste 50 de utilaje grele de ridicat. Averis efectuează periodic "
"testele de sarcină și verificările de siguranță direct pe șantiere, fără să "
"ne perturbe activitatea. Adevărați experți de teren.”</em>\n"
"                                                            </span>\n"
"                                                            <br/>"

#. module: certification_organism
#: model_terms:ir.ui.view,arch_db:certification_organism.view_page_home
msgid ""
"<span class=\"h3-fs\">\n"
"                                                                <em>\"We "
"needed a complete electrical compliance check for our new production "
"facility. The Averis team was thorough and pragmatic on the field.\"</em>\n"
"                                                            </span>\n"
"                                                            <br/>"
msgstr ""
"<span class=\"h3-fs\">\n"
"                                                                <em>„Aveam "
"nevoie de o verificare completă a conformității instalației electrice din "
