<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name small" t-ignore="true">
                    <span class="text-600">Copyright © <t t-out="company.name"/></span>
                </span>
            </xpath>
            <xpath expr="//footer//div[@name='footer_copyright_col']" position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta"><span class="oi oi-filled" data-icon="mail"/>&amp;nbsp;&amp;nbsp;<span class="h6-fs">Contact Us</span></a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_minimalist" model="ir.ui.view">
        <field name="name">Custom - Minimalist</field>
        <field name="key">website.template_footer_minimalist</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt40 pb40" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-2 offset-lg-0 col-8 offset-2 pt16 pb16 o_colored_level">
                                    <a href="/" class="o_footer_logo logo">
                                        <img src="/web/image/certification_organism.img_certification_organism_image_07" alt="Averis Certification" class="img-fluid d-block mx-auto img o_we_custom_image" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="col-lg-8 pt16 pb16 o_colored_level">
                                    <nav class="nav align-items-center justify-content-center flex-column flex-lg-row">
                                        <a class="nav-link" href="/"><span class="o_small-fs">Home</span></a>
                                        <a class="btn btn-outline-primary" href="/contactus"><span class="o_small-fs">Contact us</span></a>
                                    </nav>
                                </div>
                                <div class="col-lg-2 pt16 pb16 o_colored_level">
                                    <div class="s_social_media o_not_editable text-center no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank">
                                            <i class="oi oi-stack o_editable_media o_cc o_cc4" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank">
                                            <i class="oi oi-stack o_editable_media o_cc o_cc4" data-icon="oi_x"/>
                                        </a>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank">
                                            <i class="oi oi-stack o_editable_media o_cc o_cc4" data-icon="oi_instagram"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
