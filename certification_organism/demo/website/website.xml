<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="website_industry" model="website">
        <field name="name">Averis Certification</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="crm_default_team_id" ref="crm_team_1"/>
        <field name="logo" type="bytes" file="certification_organism/static/src/img/content/website/certification_organism-image-07.svg"/>
        <field name="favicon" type="bytes" file="certification_organism/static/description/favicon.png"/>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[
        ('name', '=', 'default_website'),
        ('module', '=', 'base'),
        ('model', '=', 'website')]"/>
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
</odoo>
