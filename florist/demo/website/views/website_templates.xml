<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pt0 pb0" data-snippet="s_text_block" data-name="Container">
                        <div class="container-fluid">
                            <div class="row o_grid_mode" data-row-count="6">
                                <div class="o_colored_level o_grid_item g-col-lg-5 col-lg-5 g-height-5" style="grid-area: 2 / 2 / 7 / 7; z-index: 1;">
                                    <h2><span style="font-size: 30px;">Maison Reverie</span></h2><span class="text-o-color-5">
                                    </span><p><span class="o_small-fs text-o-color-5">Where flowers meet art and dreams bloom. At Maison Reverie, we create timeless floral designs inspired by nature, beauty, and emotion. Each bouquet tells a story, crafted with care, passion, and a touch of French elegance.</span></p>
                                </div>
                                <div class="o_colored_level o_grid_item g-col-lg-3 g-height-4 col-lg-3 d-lg-block d-none o_snippet_mobile_invisible" style="grid-area: 2 / 9 / 6 / 12; z-index: 2;" data-invisible="1">
                                    <h2 style="text-align: right;"><span style="font-size: 30px;">Connect with us</span></h2>
                                    <ul class="list-unstyled">
                                        <li style="text-align: right;" class="o_small-fs">Rue de l’Ange 12, 5000 Namur</li><li style="text-align: right;" class="o_small-fs">+32 81 45 23 19</li><li style="text-align: right;" class="o_small-fs">hello@maisonreverie.be</li><li style="text-align: right;" class="oe-nested"><br/></li>
                                    </ul>
                                </div><div class="o_grid_item g-col-lg-3 g-height-4 col-lg-3 o_colored_level d-lg-none o_snippet_desktop_invisible" style="grid-area: 3 / 10 / 7 / 13; z-index: 3;" data-invisible="1">
                                    <h2 style="text-align: left;"><span style="font-size: 30px;">Connect with us</span></h2>
                                    <ul class="list-unstyled">
                                        <li style="text-align: left;" class="o_small-fs">Rue de l’Ange 12, 5000 Namur</li><li style="text-align: left;" class="o_small-fs">+32 81 45 23 19</li><li style="text-align: left;" class="o_small-fs">hello@maisonreverie.be</li><li style="text-align: right;" class="oe-nested"><br/></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
