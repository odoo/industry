#. module: cake_shop
#: model_terms:ir.ui.view,arch_db:cake_shop.ir_ui_view_1538
msgid ""
"\"<em>Cosy and friendly, good atmosphere and super food. Especially the "
"spiced fruit crumble.</em>\""
msgstr ""
"„<em>Уютно и приветливо, добра атмосфера и превъзходна храна. Особено "
"ронливият пай с подправени плодове.</em>“"

#. module: cake_shop
#: model_terms:ir.ui.view,arch_db:cake_shop.ir_ui_view_1538
msgid ""
"\"<em>I've been a regular customer for months now, and every cake I’ve had "
"has been amazing!</em>\"&amp;nbsp;"
msgstr ""
"„<em>Вече месеци съм редовен клиент и всяка торта, която съм опитвал, беше "
"невероятна!</em>“&amp;nbsp;"

#. module: cake_shop
#: model_terms:ir.ui.view,arch_db:cake_shop.ir_ui_view_1538
msgid ""
"&amp;nbsp;Every cake tells a story, crafted with passion and the finest "
"ingredients.&amp;nbsp;"
msgstr ""
"&amp;nbsp;Всяка торта разказва история, създадена със страст и с най-добрите "
"съставки.&amp;nbsp;"

#. module: cake_shop
#: model_terms:ir.ui.view,arch_db:cake_shop.ir_ui_view_1538
msgid ""
"<em>\"Write a quote here from one of your customers. Quotes are a great way "
"to build confidence in your products or services.</em>\""
msgstr ""
"<em>„Напишете тук отзив от някой от вашите клиенти. Отзивите са отличен "
"начин да изградите доверие във вашите продукти или услуги.</em>“"

