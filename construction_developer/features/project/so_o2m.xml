<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- 
        This feature adds an inverse m2o field on the project to be able to
        create smart buttons for the progress view and the WBS on the project form.
    -->
    
    <record model="ir.model.fields" id="field_project_project_x_order_ids">
        <field name="name">x_order_ids</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="field_description">Sale Orders</field>
        <field name="ttype">one2many</field>
        <field name="relation">sale.order</field>
        <field name="relation_field">project_id</field>
    </record>
</odoo>
