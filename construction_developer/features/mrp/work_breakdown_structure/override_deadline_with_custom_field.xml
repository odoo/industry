<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!--
        This feature adds the Work Breakdown Structure with a Gantt view for the MOs.
    -->
    <record model="ir.model.fields" id="field_mrp_production_x_date_planned_end">
        <field name="name">x_date_planned_end</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="field_description">Planned End</field>
        <field name="ttype">datetime</field>
    </record>


    <record model="ir.actions.server" id="action_start_mrp_production">
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="name">Construction Developer: Start MOs</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for record in records: 
    record.action_start()
    record['x_date_planned_end'] = (parent := record.production_group_id.production_ids[record.backorder_sequence - 2]).x_date_planned_end
    parent['x_date_planned_end'] = datetime.datetime.now()
]]></field>
    </record>

    <record model="base.automation" id="automation_on_mo_backorder_creation">
        <field name="name">Construction Developer: On MO backorder creation</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain" eval="[
            ('sale_line_id.x_bom_id', '!=', False),
            ('backorder_sequence', '!=', False),
        ]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_start_mrp_production')])]"/>
    </record>


    <record model="ir.actions.server" id="action_overwrite_deadline">
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="name">Construction Developer: Overwrite MO deadline</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for record in records: 
    if record['date_deadline'] != record.x_date_planned_end:
        record['date_deadline'] = record.x_date_planned_end
]]></field>
    </record>

    <record model="base.automation" id="automation_overwrite_deadline">
        <field name="name">Construction Developer: On MO date deadline write</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="trigger">on_write</field>
        <field name="filter_domain" eval="[
            ('x_date_planned_end', '!=', False),
        ]"/>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('mrp.field_mrp_production__date_deadline')])]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_overwrite_deadline')])]"/>
    </record>


    <record model="ir.actions.server" id="action_default_planned_end">
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="name">Construction Developer: Default MO planned end</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for record in records: record['x_date_planned_end'] = record.date_start + datetime.timedelta(hours=1)
]]></field>
    </record>

    <record model="base.automation" id="automation_default_planned_end">
        <field name="name">Construction Developer: On non-backorder MO creation</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain" eval="[
            ('x_date_planned_end', '=', False),
            ('backorder_sequence', '=', False),
        ]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_default_planned_end')])]"/>
    </record>


    <record model="ir.actions.server" id="action_push_planned_end_on_deadline">
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="name">Construction Developer: Push MO planned end on deadline</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for record in records: record['date_deadline'] = record.x_date_planned_end
]]></field>
    </record>

    <record model="base.automation" id="automation_on_date_planned_end_write">
        <field name="name">Construction Developer: On MO date planned end write</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_domain" eval="[
            ('x_date_planned_end', '!=', False),
        ]"/>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('field_mrp_production_x_date_planned_end')])]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_push_planned_end_on_deadline')])]"/>
    </record>


    <record model="ir.actions.server" id="action_prevent_mo_date_in_past">
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="name">Construction Developer: Prevent backorder MO date in past</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for record in records:
    if record.x_date_planned_end < record.date_start <= datetime.datetime.now():
        record['x_date_planned_end'] = record.date_start + datetime.timedelta(days=1)
]]></field>
    </record>

    <record model="base.automation" id="automation_prevent_mo_date_in_past">
        <field name="name">Construction Developer: Prevent backorder MO date in past on MO backorder creation</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain" eval="[
            ('backorder_sequence', '!=', False),
            ('x_date_planned_end', '!=', False),
        ]"/>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('mrp.field_mrp_production__date_finished')])]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_prevent_mo_date_in_past')])]"/>
    </record>
</odoo>
