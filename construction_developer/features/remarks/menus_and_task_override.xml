<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="action_view_remark_project_tasks" model="ir.actions.act_window">
        <field name="name">Remark Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('x_is_remark', '=', True)]</field>
        <field name="context">{'search_default_open_tasks': True}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('project.open_view_all_tasks_list_view')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No remark tasks found. Let's create one!
            </p>
        </field>
    </record>

    <menuitem
        name="All Remarks"
        id="menu_reporting_remarks_reporting"
        parent="project.menu_project_report"
        action="action_view_remark_project_tasks"
        sequence="99"
    />

    <record model="ir.actions.act_window" id="project.action_view_all_task" forcecreate="0">
        <field name="context">{'search_default_open_tasks': 1, 'default_user_ids': [(4, uid)], 'search_default_not_x_is_remark': True}</field>
    </record>
</odoo>
