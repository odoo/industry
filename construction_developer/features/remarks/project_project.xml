<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!--
        This feature adds a 'remark' project that can be created from the project form view
        which are tasks with a slightly different form.
    -->

    <record model="ir.model.fields" id="field_project_project_x_remark_project_id">
        <field name="name">x_remark_project_id</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="field_description">Remark Project</field>
        <field name="ttype">many2one</field>
        <field name="relation">project.project</field>
    </record>

    <record model="ir.model.fields" id="field_project_project_x_is_remark_project_of_ids">
        <field name="name">x_is_remark_project_of_ids</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="field_description">Project</field>
        <field name="ttype">one2many</field>
        <field name="relation">project.project</field>
        <field name="relation_field">x_remark_project_id</field>
    </record>


    <record model="ir.model.fields" id="field_event_x_remark_project_id">
        <field name="name">x_remark_project_id</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="field_description">Remark Project</field>
        <field name="ttype">many2one</field>
        <field name="relation">project.project</field>
    </record>

</odoo>
