<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!--
        This feature adds an informative margin on the pricelist form.
    -->

    <record model="ir.model.fields" id="field_product_pricelist_item_x_margin">
        <field name="name">x_margin</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="field_description">Margin</field>
        <field name="ttype">float</field>
        <field name="store" eval="False"/>
        <field name="readonly" eval="True"/>
        <field name="depends">price_markup,base</field>
        <field name="compute"><![CDATA[
for record in self: record['x_margin'] = record.price_markup/(100+record.price_markup) if record.price_markup and record.base == 'standard_price' else 0
]]></field>
    </record>
</odoo>
