<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!--
        This feature adds a button that opens a modal to check the cost differences 
        between the SOL and the BOM and allows the user to apply the BOM cost on the SOL.
    -->

    <record model="ir.model.fields" id="field_sale_order_line_x_bom_cost">
        <field name="name">x_bom_cost</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="field_description">BOM Cost</field>
        <field name="ttype">monetary</field>
        <field name="store" eval="False"/>
        <field name="related">x_bom_id.x_bom_cost</field>
    </record>

    <!-- 
        since x_different_bom_cost has to be stored, and depends on x_bom_cost which can't be stored to always have the up-to-date 
        value, we have to do pre-processing on this field before displaying it because it can't depend on a non-stored
        field.
    -->
    <record model="ir.model.fields" id="field_sale_order_line_x_different_bom_cost">
        <field name="name">x_different_bom_cost</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="field_description">To Update</field>
        <field name="ttype">boolean</field>
        <field name="store" eval="True"/>
    </record>


    <record model="ir.model.fields" id="field_sale_order_x_any_sol_bom">
        <field name="name">x_any_sol_bom</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="field_description">Any SOL Bom</field>
        <field name="ttype">boolean</field>
        <field name="store" eval="False"/>
        <field name="readonly" eval="True"/>
        <field name="depends">order_line,order_line.x_bom_id</field>
        <field name="compute"><![CDATA[
for so in self: so['x_any_sol_bom'] = any(line.x_bom_id for line in so.order_line)
]]></field>
    </record>



    <record model="ir.ui.view" id="view_sale_order_line_bom_list">
        <field name="name">sale.order.line.view.list.construction_developer</field>
        <field name="model">sale.order.line</field>
        <field name="mode">primary</field>
        <field name="type">list</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <list create="0" delete="0" editable="bottom">
                <header>
                    <button name="%(action_update_sol_cost_price_margin_on_x_bom_id_write)d" 
                            type="action" 
                            string="Apply to Selected" 
                            class="btn-primary"/>
                </header>

                <field name="x_item_number" string="#"/>
                <field name="product_id" readonly="1"/>
                <field name="purchase_price"
                    decoration-danger="purchase_price &lt; x_bom_cost"
                    decoration-success="not x_different_bom_cost"
                    decoration-warning="purchase_price &gt; x_bom_cost"
                />
                <field name="x_bom_cost" readonly="1"/>

                <!-- have to add the group because purchase_price requires it -->
                <button name="%(action_update_sol_cost_price_margin_on_x_bom_id_write)d"
                        type="action"
                        icon="west"
                        title="Apply BOM Cost"
                        string="Update"
                        groups="base.group_user"
                        invisible="not x_different_bom_cost"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_sale_order_line_bom_search">
        <field name="name">sale.order.line.view.search</field>
        <field name="model">sale.order.line</field>
        <field name="type">search</field>
        <field name="mode">primary</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" string="Product" filter_domain="[('product_id.name', 'ilike', self)]"/>
                <field name="x_item_number" string="Line Number" filter_domain="[('x_item_number', 'ilike', self)]"/>
                <separator/>
                <filter string="To Update" name="to_update" domain="[('x_different_bom_cost', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>



    <record model="ir.actions.server" id="action_view_sale_order_line_bom_list">
        <field name="name">Construction Developer: SOL Price To Update</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">
for sol in record.order_line: sol['x_different_bom_cost'] = float_compare(sol.x_bom_id.x_bom_cost, sol.purchase_price, precision_digits=2) if sol.x_bom_id else False

action = env.ref('construction_developer.window_action_view_sale_order_line_bom_list').read()[0]
action['domain'] = [('x_bom_id', '!=', False), ('id', 'in', record.order_line.ids)]
</field>
    </record>

    <record model="ir.actions.act_window" id="window_action_view_sale_order_line_bom_list">
        <field name="name">Sale Order BOM Costs</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_id" ref="view_sale_order_line_bom_list"/>
        <field name="search_view_id" ref="view_sale_order_line_bom_search"/>
        <!-- the server action overwrites the domain -->
        <field name="domain">[]</field>
        <field name="context">{'search_default_to_update': True}</field>
        <field name="view_mode">list</field>
        <field name="target">new</field>
    </record>
</odoo>
