<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!--
        This feature adds a cost to the BOM.
        The cost is computed using a standard function totalling the price of the components.
    -->

    <record model="ir.model.fields" id="field_mrp_bom_x_currency_id">
        <field name="name">x_currency_id</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="field_description">Currency</field>
        <field name="ttype">many2one</field>
        <field name="relation">res.currency</field>
        <field name="related">product_tmpl_id.currency_id</field>
        <field name="store" eval="False"/>
        <field name="readonly" eval="True"/>
    </record>

    <record model="ir.model.fields" id="field_mrp_bom_x_bom_cost">
        <field name="name">x_bom_cost</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="field_description">BOM Cost</field>
        <field name="ttype">monetary</field>
        <field name="currency_field">x_currency_id</field>
        <field name="store" eval="False"/>
        <field name="readonly" eval="True"/>
        <field name="compute"><![CDATA[
for bom in self:
    bom['x_bom_cost'] = product._compute_bom_price(bom) if (product := bom.product_id or bom.product_tmpl_id.product_variant_id) else 0.0
]]></field>
    </record>


    <!-- 
        Update the price and the cost when a bom is selected.
        Must update all 3 at the same time or the annoying margin gets recomputed in between each change
    -->
    <record model="ir.actions.server" id="action_update_sol_cost_price_margin_on_x_bom_id_write">
        <field name="name">Construction Developer: Update SOL Cost from BOM</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="state">code</field>
        <field name="code">
for sol in records: record.write({'margin_percent': sol.margin_percent, 'purchase_price': (cost := sol.x_bom_id.x_bom_cost), 'price_unit': cost / div if (div := (1 - sol.margin_percent)) else 0})
</field>
    </record>

    <record model="base.automation" id="automation_sol_price_and_cost_on_x_bom_id_write">
        <field name="name">Construction Developer: Update SOL price and cost from BOM on set</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_domain">[('x_bom_id', '!=', False)]</field>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('field_sale_order_line_x_bom_id')])]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_update_sol_cost_price_margin_on_x_bom_id_write')])]"/>
    </record>
</odoo>
