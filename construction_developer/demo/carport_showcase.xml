        <value model="mrp.production" search="[('sale_line_id.order_id', '=', ref('sale_order_carport_jessica_martinez')), ('product_id', '=', ref('product_product_61'))]"/>
        <value eval="{'date_start': DateTime.now() - relativedelta(days=5), 'x_date_planned_end': DateTime.now() - relativedelta(days=2)}"/>
    </function>
    <function name="write" model="mrp.production">
