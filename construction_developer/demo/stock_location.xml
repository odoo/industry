<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record model="stock.location" id="stock_location_worksite_jessica_martinez">
        <field name="name">Jessica Martinez</field>
        <field name="location_id" ref="stock_location_worksites"/>
        <field name="usage">internal</field>
        <field name="replenish_location" eval="True"/>
    </record>
    <!-- tie it to the SO it was supposed to be created from -->
    <function model="sale.order" name="write">
        <value eval="[ref('construction.sale_order_1')]"/>
        <value eval="{'x_ws_location_id': ref('construction_developer.stock_location_worksite_jessica_martinez')}"/>
    </function>

    <record model="stock.location" id="stock_location_worksite_sarah_davis">
        <field name="name">Sarah Davis</field>
        <field name="location_id" ref="stock_location_worksites"/>
        <field name="usage">internal</field>
        <field name="replenish_location" eval="True"/>
    </record>
    <!-- tie it to the SO it was supposed to be created from -->
    <function model="sale.order" name="write">
        <value eval="[ref('construction.sale_order_6')]"/>
        <value eval="{'x_ws_location_id': ref('construction_developer.stock_location_worksite_sarah_davis')}"/>
    </function>
</odoo>
