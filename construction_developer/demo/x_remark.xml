    <record id="x_remark_3" model="x_remark">
        <field name="x_name">Cracked Structural Glass Fin</field>
        <field name="x_project_id" ref="construction.project_project_7"/>
        <field name="x_stage_id" ref="project_x_remark_stage_2"/>
        <field name="x_description"><![CDATA[<div data-oe-version="2.0">During the pre-delivery walkthrough, stress cracking and a spiderweb fracture were identified on the narrow vertical glass fin (mullion) supporting the main facade window. The defect originates near the mounting point, likely caused by thermal expansion or over-torqued mechanical fittings.</div>]]></field>
        <field name="x_date" eval="datetime.today().date() + relativedelta(days=-14)"/>
        <field name="x_location">Interior Cafeteria – Main Panoramic Bay</field>
        <field name="x_remark_category_ids" eval="[(6, 0, [ref('construction_developer.x_remark_category_type_1')])]"/>
        <field name="x_priority">2</field>
        <field name="x_update_id" ref="construction.project_update_2"/>
    </record>
    <record id="x_remark_4" model="x_remark">
        <field name="x_name">Dented Pergola Support Pole</field>
        <field name="x_project_id" ref="construction.project_project_7"/>
        <field name="x_stage_id" ref="project_x_remark_stage_1"/>
        <field name="x_description"><![CDATA[<div data-oe-version="2.0">Localized impact dent and powder-coat surface damage observed on the white square metallic support pole holding the louvred terrace pergola. The damage appears to have been caused by equipment or scaffold movement during site operations.</div>]]></field>
        <field name="x_date" eval="datetime.today().date() + relativedelta(days=-14)"/>
        <field name="x_location">Outdoor Upper Terrace</field>
        <field name="x_remark_category_ids" eval="[(6, 0, [ref('construction_developer.x_remark_category_type_1')])]"/>
        <field name="x_update_id" ref="construction.project_update_2"/>
    </record>
