#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Accounting:</strong>\n"
"                    Automatically log payments, close sessions, and generate "
"tax reports."
msgstr ""
"<strong>Akuntansi:</strong>\n"
"                    Secara otomatis mencatat pembayaran, menutup sesi, dan "
"membuat laporan pajak."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Automatic Delivery:</strong>\n"
"                    Once the quote is accepted, it's possible to deliver the "
"products just as it does for a regular e-commerce order."
msgstr ""
"<strong>Pengiriman Otomatis:</strong>\n"
"                    Setelah penawaran diterima, produk dapat dikirimkan "
"seperti pesanan e-commerce biasa."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Crucial Review:</strong>\n"
"                    You must review all e-commerce settings to ensure they "
"align with your\n"
"                    internal business policies (e.g., when invoices are "
"generated, whether a\n"
"                    mandatory customer check-in is required for ordering, "
"etc.)."
msgstr ""
"<strong>Tinjauan Penting:</strong>\n"
"                    Anda harus meninjau semua pengaturan e-commerce untuk "
"memastikan kesesuaiannya dengan\n"
"                    kebijakan bisnis internal Anda (misalnya kapan faktur "
"diterbitkan, apakah\n"
"                    diperlukan verifikasi pelanggan wajib untuk melakukan "
"pemesanan, dll.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Define B2B Pricing:</strong>\n"
"                    Create and assign a dedicated pricelist to each B2B "
"contact. Ensure this pricelist\n"
"                    is active on your website so the customer sees their "
"agreed-upon prices upon login."
msgstr ""
"<strong>Tentukan Harga B2B:</strong>\n"
"                    Buat dan tetapkan daftar harga khusus untuk setiap "
"kontak B2B. Pastikan daftar harga ini\n"
"                    aktif di website sehingga pelanggan melihat harga yang "
"telah disepakati setelah login."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Delivery Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Delivery "
"Methods</strong>\n"
"                    to define all available options and their costs."
msgstr ""
"<strong>Metode Pengiriman:</strong>\n"
"                    Kunjungi <strong>Website &gt; Konfigurasi &gt; Metode "
"Pengiriman</strong>\n"
"                    untuk menentukan semua opsi yang tersedia beserta "
"biayanya."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>E-commerce Category:</strong> For easier product retrieval by "
"customers on your online store."
msgstr ""
"<strong>Kategori E-commerce:</strong> Memudahkan pelanggan menemukan produk "
"di toko online Anda."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Employee Scheduling:</strong>\n"
"                    Use the <strong>Planning App</strong> to create and "
"manage employee schedules,\n"
"                    ensuring you have the right staff at the right times for "
"busy days and specific orders."
msgstr ""
"<strong>Penjadwalan Karyawan:</strong>\n"
"                    Gunakan <strong>Aplikasi Perencanaan</strong> untuk "
"membuat dan mengelola jadwal karyawan,\n"
"                    sehingga pasti ada staf yang tepat pada waktu yang tepat "
"untuk hari-hari sibuk dan pesanan tertentu."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>External Providers:</strong>\n"
"                            Check if a predefined Odoo connection exists if "
"you work with\n"
"                            specific shipping carriers."
msgstr ""
"<strong>Penyedia Eksternal:</strong>\n"
"                            Periksa apakah ada koneksi Odoo yang telah "
"ditentukan jika Anda bekerja dengan\n"
"                            ekspedisi tertentu."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>In-Store Pickup (Click &amp; Collect):</strong>\n"
"                            If you wish to offer this, you must\n"
"                            <strong>activate the setting</strong> within "
"the\n"
"                            <strong>Website Settings</strong> first."
msgstr ""
"<strong>Pengambilan di Toko (Klik &amp; Ambil):</strong>\n"
"                            Jika ingin menawarkan layanan ini, Anda harus\n"
"                            <strong> mengaktifkan pengaturan</strong> dari\n"
"                            <strong> Pengaturan Website</strong> terlebih "
"dahulu."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Layout Settings:</strong>\n"
"                    Adjust the visual presentation and layout of products "
"using the\n"
"                    <strong>website editor</strong>."
msgstr ""
"<strong>Pengaturan Tata Letak:</strong>\n"
"                     Sesuaikan tampilan visual dan tata letak produk "
"menggunakan\n"
"                     <strong>editor website</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Loyalty Programs:</strong>\n"
"                            Implement <strong>loyalty cards</strong> as a "
"core strategy to <strong>activate customer retentio\n"
"                            </strong> and increase customer lifetime value."
msgstr ""
"<strong>Program Loyalitas:</strong>\n"
"                            Terapkan <strong>kartu loyalitas</strong> "
"sebagai strategi inti untuk <strong>mengaktifkan retensi pelanggan\n"
"                            </strong> dan meningkatkan lifetime value "
"pelanggan."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Note:</strong> Increased capability leads to higher complexity and "
"more maintenance."
msgstr ""
"<strong>Catatan:</strong> Dengan meningkatnya kapabilitas, kompleksitas pun "
"akan lebih tinggi dan maintenance akan lebih banyak."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Our Advice:</strong> Stick with your current streamlined "
"configuration until\n"
"                        you're fully comfortable. When you're ready to "
"upgrade, try the inventory module on a duplicated database first to ensure "
"it fits\n"
"                        your workflow. 😉"
msgstr ""
"<strong>Saran Kami:</strong> Terus gunakan konfigurasi yang sedang Anda "
"pakai hingga\n"
"                        Anda benar-benar merasa nyaman. Jika sudah siap "
"untuk melakukan upgrade, coba modul Inventaris pada database duplikat "
"terlebih dahulu untuk memastikan apakah modul tersebut sesuai\n"
"                        dengan alur kerja Anda. 😉"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payment Providers &amp; Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Payment "
"Providers</strong>\n"
"                    and install all the payment methods and providers you "
"plan to offer\n"
"                    (e.g., credit card processors, PayPal, etc.)."
msgstr ""
"<strong>Penyedia &amp; Metode Pembayaran:</strong>\n"
"                    Kunjungi <strong>Website &gt; Konfigurasi &gt; Penyedia "
"Pembayaran</strong>\n"
"                    dan instal semua metode pembayaran serta penyedia yang "
"akan digunakan\n"
"                    (misalnya pemroses kartu kredit, PayPal, dll.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payroll:</strong>\n"
"                    Use this feature to handle <strong>employee salaries and "
"manage holiday\n"
"                    requests.</strong>"
msgstr ""
"<strong>Payroll:</strong>\n"
"                     Gunakan fitur ini untuk mengelola <strong>gaji karyawan "
"dan mengelola\n"
"                     permohonan cuti.</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Point of Sale Category:</strong> For organizing transactions within "
"your shop system."
msgstr ""
"<strong>Kategori POS:</strong> Untuk mengatur transaksi dalam sistem toko "
"Anda."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Pricelist Segmentation:</strong>\n"
"                            Define multiple pricing structures for the same "
"product, supporting different\n"
"                            business models (e.g., B2B vs. B2C) and enabling "
"<strong>client-specific pricing\n"
"                            contracts.</strong>"
msgstr ""
"<strong>Segmentasi Daftar Harga:</strong>\n"
"                             Tentukan beberapa struktur harga untuk produk "
"yang sama untuk mendukung berbagai\n"
"                             model bisnis (misalnya, B2B vs. B2C) dan "
"memungkinkan <strong>kontrak harga khusus\n"
"                             klien.</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Product Category:</strong> For internal tracking and reporting."
msgstr ""
"<strong>Kategori Produk:</strong> Untuk pelacakan dan pelaporan internal."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Product-Level Settings:</strong>\n"
"                    Define core product settings directly on the "
"<strong>product form</strong>."
msgstr ""
"<strong>Pengaturan Tingkat Produk:</strong>\n"
"                     Tentukan pengaturan inti produk langsung pada <strong>"
"formulir produk</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Promotional Agility:</strong>\n"
"                            Use <strong>discounts and promotions</strong> to "
"quickly adjust pricing for sales events or to give\n"
"                            targeted, <strong>manual reductions</strong> at "
"the point of sale."
msgstr ""
"<strong>Kelincahan Promosi:</strong>\n"
"                             Gunakan <strong>diskon dan promosi</strong> "
"untuk menyesuaikan harga dengan cepat untuk acara penjualan atau untuk "
"memberikan\n"
"                             <strong>potongan harga manual</strong> "
"bertarget di POS."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Publishing:</strong>\n"
"                    Each product can be <strong>published independently</"
"strong> on your online store."
msgstr ""
"<strong>Penerbitan:</strong>\n"
"                     Setiap produk dapat <strong>dipublikasikan satu per "
"satu</strong> di toko online Anda."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Quote and Confirm:</strong>\n"
"                    If a specific demand requires pricing, generate a "
"quotation directly from the\n"
"                    <strong>Sales</strong> app. The client can then confirm "
"and sign it online."
msgstr ""
"<strong>Penawaran dan Konfirmasi:</strong>\n"
"                    Jika permintaan tertentu memerlukan penawaran harga, "
"buatlah penawaran langsung dari\n"
"                    aplikasi <strong>Sales</strong>. Klien kemudian dapat "
"mengonfirmasi dan menandatanganinya secara online."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Restaurant Mode:</strong>\n"
"                    Manage tables, orders, and payments with the Point of "
"Sale system if you offer an \"eat-in\" option."
msgstr ""
"<strong>Mode Restoran</strong>:\n"
"                     Kelola meja, pesanan, dan pembayaran dengan sistem POS "
"bila Anda menawarkan opsi \"makan di tempat\"."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Want to do more?</strong>"
msgstr "<strong>Ingin mempelajari lebih lanjut?</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>You didn't import demo data?</strong> You can still do it. Go to "
"<strong>Apps &gt; Industries &gt; Upgrade your Bakery Package</strong> and "
"check the related box."
msgstr ""
"<strong>Anda tidak mengimpor data demo?</strong> Anda masih dapat "
"melakukannya. Kunjungi <strong>Aplikasi &gt; Industri &gt; Upgrade Paket "
"Toko Roti Anda</strong> dan centang kotak terkait."

