#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<span style=\"font-weight: normal;\">🎓 Sales</span>"
msgstr "<span style=\"font-weight: normal;\">🎓 Vendite</span>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Accounting:</strong>\n"
"                    Automatically log payments, close sessions, and generate "
"tax reports."
msgstr ""
"<strong>Contabilità:</strong>\n"
"                    registra automaticamente i pagamenti, chiudi le sessioni "
"e genera i rendiconti fiscali."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Automatic Delivery:</strong>\n"
"                    Once the quote is accepted, it's possible to deliver the "
"products just as it does for a regular e-commerce order."
msgstr ""
"<strong>consegna automatica:</strong>\n"
"                    una volta accettato il preventivo, è possibile "
"consegnare i prodotti proprio come avviene per un normale ordine di e-"
"commerce."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Crucial Review:</strong>\n"
"                    You must review all e-commerce settings to ensure they "
"align with your\n"
"                    internal business policies (e.g., when invoices are "
"generated, whether a\n"
"                    mandatory customer check-in is required for ordering, "
"etc.)."
msgstr ""
"<strong>Verifica fondamentale:</strong>\n"
"                    è necessario verificare tutte le impostazioni dell’e-"
"commerce per assicurarsi che siano in linea con le\n"
"                    politiche aziendali interne (ad esempio, quando vengono "
"generate le fatture, se è\n"
"                    richiesto un check-in obbligatorio del cliente per "
"effettuare un ordine, ecc.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Define B2B Pricing:</strong>\n"
"                    Create and assign a dedicated pricelist to each B2B "
"contact. Ensure this pricelist\n"
"                    is active on your website so the customer sees their "
"agreed-upon prices upon login."
msgstr ""
"<strong>definisci i prezzi B2B:</strong>\n"
"                    crea e assegna un listino prezzi dedicato a ciascun "
"contatto B2B. Assicurati che questo listino prezzi\n"
"                    sia attivo sul sito web in modo che il cliente veda i "
"prezzi concordati al momento dell’accesso;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Delivery Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Delivery "
"Methods</strong>\n"
"                    to define all available options and their costs."
msgstr ""
"<strong>Modalità di consegna:</strong>\n"
"                    vai su <strong>Sito web&gt; Configurazione &gt; Metodi "
"di consegna</strong>\n"
"                    per definire tutte le opzioni disponibili e i relativi "
"costi;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>E-commerce Category:</strong> For easier product retrieval by "
"customers on your online store."
msgstr ""
"<strong>categoria e-commerce:</strong> per facilitare la ricerca dei "
"prodotti da parte dei clienti nel tuo negozio online;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Employee Scheduling:</strong>\n"
"                    Use the <strong>Planning App</strong> to create and "
"manage employee schedules,\n"
"                    ensuring you have the right staff at the right times for "
"busy days and specific orders."
msgstr ""
"<strong>Pianificazione del personale:</strong>\n"
"                    utilizza l’app <strong>Pianificazione</strong> per "
"creare e gestire i turni dei dipendenti,\n"
"                    assicurandoti di avere il personale giusto al momento "
"giusto per le giornate di punta e gli ordini specifici."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>External Providers:</strong>\n"
"                            Check if a predefined Odoo connection exists if "
"you work with\n"
"                            specific shipping carriers."
msgstr ""
"<strong>fornitori esterni:</strong>\n"
"                            verifica se esiste una connessione Odoo "
"predefinita se lavori con\n"
"                            corriere specifici;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>In-Store Pickup (Click &amp; Collect):</strong>\n"
"                            If you wish to offer this, you must\n"
"                            <strong>activate the setting</strong> within "
"the\n"
"                            <strong>Website Settings</strong> first."
msgstr ""
"<strong>ritiro in negozio (click and collect):</strong>\n"
"                            se desideri offrire questo servizio, devi\n"
"                           <strong>attivare prima l’impostazione</strong> "
"all’interno delle\n"
"                           <strong>Impostazioni del Sito web</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Layout Settings:</strong>\n"
"                    Adjust the visual presentation and layout of products "
"using the\n"
"                    <strong>website editor</strong>."
msgstr ""
"<strong>impostazioni layout:</strong>\n"
"                    modifica la presentazione visiva e il layout dei "
"prodotti utilizzando\n"
"                    <strong>l'editor del Sito web</strong> ."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Loyalty Programs:</strong>\n"
"                            Implement <strong>loyalty cards</strong> as a "
"core strategy to <strong>activate customer retentio\n"
"                            </strong> and increase customer lifetime value."
msgstr ""
"<strong>programmi fedeltà:</strong>\n"
"                            implementa le <strong>carte fedeltà</strong> "
"come strategia fondamentale per <strong>attivare la fidelizzazione dei "
"clienti\n"
"                           </strong> e aumentare il valore del ciclo di vita "
"del cliente."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Note:</strong> Increased capability leads to higher complexity and "
"more maintenance."
msgstr ""
"<strong>Nota:</strong> una maggiore funzionalità comporta una maggiore "
"complessità e un maggiore impegno di manutenzione."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Our Advice:</strong> Stick with your current streamlined "
"configuration until\n"
"                        you're fully comfortable. When you're ready to "
"upgrade, try the inventory module on a duplicated database first to ensure "
"it fits\n"
"                        your workflow. 😉"
msgstr ""
"<strong>Il nostro consiglio:</strong> continua a utilizzare la tua attuale "
"configurazione semplificata finché\n"
"                        non ti sentirai completamente a tuo agio. Quando "
"sarai pronto per l’aggiornamento, prova prima il modulo Magazzino su un "
"database duplicato per assicurarti che si adatti\n"
"                        al tuo flusso di lavoro. 😉"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payment Providers &amp; Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Payment "
"Providers</strong>\n"
"                    and install all the payment methods and providers you "
"plan to offer\n"
"                    (e.g., credit card processors, PayPal, etc.)."
msgstr ""
"<strong>Fornitori di servizi di pagamento e metodi:</strong>\n"
"                    vai su <strong>Sito web &gt; Configurazione &gt; "
"Fornitori di pagamento</strong>\n"
"                    e installa tutti i metodi di pagamento e i fornitori che "
"intendi offrire\n"
"                    (ad es. gestori di carte di credito, PayPal, ecc.);"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payroll:</strong>\n"
"                    Use this feature to handle <strong>employee salaries and "
"manage holiday\n"
"                    requests.</strong>"
msgstr ""
"<strong>Libro paga:</strong>\n"
"                    utilizza questa funzione per gestire <strong>gli "
"stipendi dei dipendenti e le richieste di ferie\n"
"                    .</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Point of Sale Category:</strong> For organizing transactions within "
"your shop system."
msgstr ""
"<strong>categoria punto vendita:</strong> per organizzare le transazioni nel "
"sistema del tuo negozio."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Pricelist Segmentation:</strong>\n"
"                            Define multiple pricing structures for the same "
"product, supporting different\n"
"                            business models (e.g., B2B vs. B2C) and enabling "
"<strong>client-specific pricing\n"
"                            contracts.</strong>"
msgstr ""
"<strong>segmentazione listino prezzi:</strong>\n"
"                            definisci più strutture di prezzi per lo stesso "
"prodotto così da supportare diversi\n"
"                            modelli di business (ad es. B2B vs. B2C) e "
"abilitare <strong>contratti di prezzo\n"
"                            specifici per ogni cliente;</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Product Category:</strong> For internal tracking and reporting."
msgstr ""
"<strong>categoria prodotto:</strong> per il monitoraggio interno e la "
"rendicontazione;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Product-Level Settings:</strong>\n"
"                    Define core product settings directly on the "
"<strong>product form</strong>."
msgstr ""
"<strong>impostazioni a livello di prodotto:</strong>\n"
"                    definisci le impostazioni principali del prodotto "
"direttamente nel <strong>modulo del prodotto</strong>;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Promotional Agility:</strong>\n"
"                            Use <strong>discounts and promotions</strong> to "
"quickly adjust pricing for sales events or to give\n"
"                            targeted, <strong>manual reductions</strong> at "
"the point of sale."
msgstr ""
"<strong>agilità promozionale:</strong>\n"
"                            utilizza <strong>sconti e promozioni</strong> "
"per adeguare rapidamente i prezzi in occasione di eventi di vendite o per "
"applicare\n"
"                            <strong>riduzioni manuali</strong> mirate al "
"punto vendita;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Publishing:</strong>\n"
"                    Each product can be <strong>published independently</"
"strong> on your online store."
msgstr ""
"<strong>Pubblicazione:</strong>\n"
"                    ogni prodotto può essere <strong>pubblicato in modo "
"indipendente</strong> sul tuo negozio online;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Quote and Confirm:</strong>\n"
"                    If a specific demand requires pricing, generate a "
"quotation directly from the\n"
"                    <strong>Sales</strong> app. The client can then confirm "
"and sign it online."
msgstr ""
"<strong>crea preventivo e conferma:</strong>\n"
"                    se una richiesta specifica richiede un preventivo, "
"generalo direttamente\n"
"                    dall'app <strong>Vendite</strong>. Il cliente potrà "
"quindi confermarlo e firmarlo online;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Restaurant Mode:</strong>\n"
"                    Manage tables, orders, and payments with the Point of "
"Sale system if you offer an \"eat-in\" option."
msgstr ""
"<strong>Modalità Ristorante:</strong>\n"
"                    gestisci tavoli, ordini e pagamenti con il sistema Punto "
"vendita se offri l’opzione “consumo in loco”."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Want to do more?</strong>"
msgstr "<strong>Vuoi fare di più?</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>You didn't import demo data?</strong> You can still do it. Go to "
"<strong>Apps &gt; Industries &gt; Upgrade your Bakery Package</strong> and "
"check the related box."
msgstr ""
"<strong>Non hai importato i dati demo?</strong> Puoi ancora farlo. Vai su "
"<strong>App &gt; Settori &gt; Aggiorna il pacchetto Pasticceria</strong> e "
"spunta la casella corrispondente."

#. module: bakery
