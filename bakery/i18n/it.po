#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"1. <strong>Create a purchase order:</strong>\n"
"                    Select the materials you need for your breads and "
"pastries."
msgstr ""
"1. <strong>crea un ordine di acquisto:</strong>\n"
"                    seleziona gli ingredienti necessari per i tuoi prodotti "
"da forno;"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
