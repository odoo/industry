#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<span style=\"font-weight: normal;\">🎓 Sales</span>"
msgstr "<span style=\"font-weight: normal;\">🎓 Salg</span>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Accounting:</strong>\n"
"                    Automatically log payments, close sessions, and generate "
"tax reports."
msgstr ""
"<strong>Regnskab:</strong>\n"
"                    Registrér automatisk betalinger, afslut sessioner og "
"generér skatterapporter."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Automatic Delivery:</strong>\n"
"                    Once the quote is accepted, it's possible to deliver the "
"products just as it does for a regular e-commerce order."
msgstr ""
"<strong>Automatisk levering:</strong>\n"
"                    Når tilbuddet er accepteret, er det muligt at levere "
"produkterne på samme måde som ved en almindelig e-handelsordre."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Crucial Review:</strong>\n"
"                    You must review all e-commerce settings to ensure they "
"align with your\n"
"                    internal business policies (e.g., when invoices are "
"generated, whether a\n"
"                    mandatory customer check-in is required for ordering, "
"etc.)."
msgstr ""
"<strong>Vigtig gennemgang:</strong>\n"
"                    Du skal gennemgå alle e-handelsindstillinger for at "
"sikre, at de er i overensstemmelse med dine\n"
"                    interne forretningspolitikker (f.eks. hvornår fakturaer "
"genereres, om der\n"
"                    kræves obligatorisk kundetjek ved bestilling osv.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Define B2B Pricing:</strong>\n"
"                    Create and assign a dedicated pricelist to each B2B "
"contact. Ensure this pricelist\n"
"                    is active on your website so the customer sees their "
"agreed-upon prices upon login."
msgstr ""
"<strong>Fastsæt B2B-priser:</strong>\n"
"                    Opret og tildel en dedikeret prisliste til hver B2B-"
"kontakt. Sørg for, at denne prisliste\n"
"                    er aktiv på din hjemmeside, så kunden kan se de aftalte "
"priser, når vedkommende logger ind."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Delivery Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Delivery "
"Methods</strong>\n"
"                    to define all available options and their costs."
msgstr ""
"<strong>Leveringsmetoder:</strong>\n"
"                    Gå til <strong>Hjemmeside &gt; Konfiguration &gt; "
"Leveringsmetoder</strong>\n"
"                    for at se alle tilgængelige muligheder og deres priser."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>E-commerce Category:</strong> For easier product retrieval by "
"customers on your online store."
msgstr ""
"<strong>E-handelskategori:</strong> For at gøre det lettere for kunderne at "
"finde produkter i din onlinebutik."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Employee Scheduling:</strong>\n"
"                    Use the <strong>Planning App</strong> to create and "
"manage employee schedules,\n"
"                    ensuring you have the right staff at the right times for "
"busy days and specific orders."
msgstr ""
"<strong>Medarbejderplanlægning</strong>:\n"
"                    Brug<strong>Planlægningsappen</strong> til at oprette og "
"administrere vagtplaner,\n"
"                    så det rette personale er til stede på de rette "
"tidspunkter, f.eks. i spidsbelastningsperioder, og til at oprette "
"kundespecifikke ordrer."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>External Providers:</strong>\n"
"                            Check if a predefined Odoo connection exists if "
"you work with\n"
"                            specific shipping carriers."
msgstr ""
"<strong>Eksterne udbydere:</strong>\n"
"                            Kontrollér, om der findes en foruddefineret Odoo-"
"forbindelse, hvis du arbejder med\n"
"                            bestemte fragtfirmaer."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>In-Store Pickup (Click &amp; Collect):</strong>\n"
"                            If you wish to offer this, you must\n"
"                            <strong>activate the setting</strong> within "
"the\n"
"                            <strong>Website Settings</strong> first."
msgstr ""
"<strong>Afhentning i butik (Klik og hent):</strong>\n"
"                            Hvis du ønsker at tilbyde dette, skal du\n"
"                           <strong> først aktivere indstillingen</strong> i\n"
"                           <strong> Hjemmesideindstillinger</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Layout Settings:</strong>\n"
"                    Adjust the visual presentation and layout of products "
"using the\n"
"                    <strong>website editor</strong>."
msgstr ""
"<strong>Layoutindstillinger:</strong>\n"
"                    Tilpas produkternes visuelle præsentation og layout med\n"
"                    <strong>webredigeringsværktøjet</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Loyalty Programs:</strong>\n"
"                            Implement <strong>loyalty cards</strong> as a "
"core strategy to <strong>activate customer retentio\n"
"                            </strong> and increase customer lifetime value."
msgstr ""
"<strong>Loyalitetsprogrammer:</strong>\n"
"                            Implementér <strong>loyalitetskort</strong> som "
"en centralstrategi for at <strong>aktivere kundefastholdelse\n"
"                           </strong> og øge kundens livstidsværdi."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Note:</strong> Increased capability leads to higher complexity and "
"more maintenance."
msgstr ""
"<strong>Bemærk:</strong> Øget funktionalitet medfører større kompleksitet og "
"mere vedligeholdelse."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Our Advice:</strong> Stick with your current streamlined "
"configuration until\n"
"                        you're fully comfortable. When you're ready to "
"upgrade, try the inventory module on a duplicated database first to ensure "
"it fits\n"
"                        your workflow. 😉"
msgstr ""
"<strong>Vores råd:</strong> Fortsæt med din nuværende, enkle opsætning, "
"indtil\n"
"                        du føler dig helt fortrolig med den. Når du er klar "
"til at udvide funktionaliteten, kan du først afprøve Lagermodulet i en kopi "
"af din database for at sikre, at det passer\n"
"                        til din arbejdsgang. 😉"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payment Providers &amp; Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Payment "
"Providers</strong>\n"
"                    and install all the payment methods and providers you "
"plan to offer\n"
"                    (e.g., credit card processors, PayPal, etc.)."
msgstr ""
"<strong>Betalingsudbydere og betalingsformer:</strong>\n"
"                    Gå til <strong>Hjemmeside &gt; Konfiguration &gt; "
"Betalingsudbydere,</strong>\n"
"                    og installér alle de betalingsformer og udbydere, du "
"planlægger at tilbyde\n"
"                    (f.eks. kreditkortudbydere, PayPal osv.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payroll:</strong>\n"
"                    Use this feature to handle <strong>employee salaries and "
"manage holiday\n"
"                    requests.</strong>"
msgstr ""
"<strong>Lønadministration:</strong>\n"
"                    Brug denne funktion til at håndtere <strong>"
"medarbejderlønninger og administrere ferieanmodninger\n"
"                    .</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Point of Sale Category:</strong> For organizing transactions within "
"your shop system."
msgstr ""
"<strong>POS-kategori:</strong> Til organisering af transaktioner i dit "
"butikssystem."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Pricelist Segmentation:</strong>\n"
"                            Define multiple pricing structures for the same "
"product, supporting different\n"
"                            business models (e.g., B2B vs. B2C) and enabling "
"<strong>client-specific pricing\n"
"                            contracts.</strong>"
msgstr ""
"<strong>Segmentering af prislister:</strong>\n"
"                            Fastsæt flere prisstrukturer for det samme "
"produkt, der understøtter forskellige\n"
"                            forretningsmodeller (f.eks. B2B vs. B2C), og "
"muliggør <strong>kundespecifikke prisaftaler\n"
"                            .</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Product Category:</strong> For internal tracking and reporting."
msgstr "<strong>Produktkategori:</strong> Til intern sporing og rapportering."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Product-Level Settings:</strong>\n"
"                    Define core product settings directly on the "
"<strong>product form</strong>."
msgstr ""
"<strong>Indstillinger på produktniveau:</strong>\n"
"                    Definér centrale produktindstillinger direkte i <strong>"
"produktformularen</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Promotional Agility:</strong>\n"
"                            Use <strong>discounts and promotions</strong> to "
"quickly adjust pricing for sales events or to give\n"
"                            targeted, <strong>manual reductions</strong> at "
"the point of sale."
msgstr ""
"<strong>Fleksibilitet i forbindelse med kampagner:</strong>\n"
"                            Brug <strong>rabatter og kampagner</strong> til "
"hurtigt at justere priserne i forbindelse med salgsarrangementer eller til "
"at give\n"
"                            målrettede, <strong>manuelle prisnedsættelser</"
"strong> i kassesystemet."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Publishing:</strong>\n"
"                    Each product can be <strong>published independently</"
"strong> on your online store."
msgstr ""
"<strong>Offentliggørelse:</strong>\n"
"                    Hvert produkt kan <strong>offentliggøres uafhængigt</"
"strong> i din onlinebutik."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Quote and Confirm:</strong>\n"
"                    If a specific demand requires pricing, generate a "
"quotation directly from the\n"
"                    <strong>Sales</strong> app. The client can then confirm "
"and sign it online."
msgstr ""
"<strong>Tilbud og bekræftelse:</strong>\n"
"                    Hvis en specifik forespørgsel kræver en prisangivelse, "
"kan du generere et tilbud direkte fra\n"
"                    <strong>Salgsappen</strong>. Kunden kan derefter "
"bekræfte og bruge digitale underskrifter."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Restaurant Mode:</strong>\n"
"                    Manage tables, orders, and payments with the Point of "
"Sale system if you offer an \"eat-in\" option."
msgstr ""
"<strong>Restauranttilstand:</strong>\n"
"                    Hvis du tilbyder spisning på stedet, kan du administrere "
"borde, bestillinger og betalinger direkte i kassesystemet."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Want to do more?</strong>"
msgstr "<strong>Vil du gøre mere?</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>You didn't import demo data?</strong> You can still do it. Go to "
"<strong>Apps &gt; Industries &gt; Upgrade your Bakery Package</strong> and "
"check the related box."
msgstr ""
"<strong>Har du ikke importeret demodata endnu?</strong> Du kan stadig nå "
"det. Gå til <strong>Apps &gt; Brancher &gt; Opgradér din pakke til bagerier,"
"</strong> og markér det relevante felt."

#. module: bakery
