#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<span style=\"font-weight: normal;\">🎓 Sales</span>"
msgstr "<span style=\"font-weight: normal;\">🎓 Vânzări</span>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Accounting:</strong>\n"
"                    Automatically log payments, close sessions, and generate "
"tax reports."
msgstr ""
"<strong>Contabilitate:</strong>\n"
"                    Înregistrează automat plățile, închide sesiunile și "
"generează rapoarte fiscale."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Automatic Delivery:</strong>\n"
"                    Once the quote is accepted, it's possible to deliver the "
"products just as it does for a regular e-commerce order."
msgstr ""
"<strong>Livrare automată:</strong>\n"
"                    După acceptarea ofertei, produsele pot fi livrate la fel "
"ca într-o comandă eCommerce obișnuită."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Crucial Review:</strong>\n"
"                    You must review all e-commerce settings to ensure they "
"align with your\n"
"                    internal business policies (e.g., when invoices are "
"generated, whether a\n"
"                    mandatory customer check-in is required for ordering, "
"etc.)."
msgstr ""
"<strong>Verificare esențială:</strong>\n"
"                    Revizuiește setările eCommerce pentru a te asigura că "
"respectă\n"
"                    politicile interne (de ex., când se emit facturile și "
"dacă autentificarea\n"
"                    clientului este obligatorie pentru plasarea comenzilor)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Define B2B Pricing:</strong>\n"
"                    Create and assign a dedicated pricelist to each B2B "
"contact. Ensure this pricelist\n"
"                    is active on your website so the customer sees their "
"agreed-upon prices upon login."
msgstr ""
"<strong>Definește prețurile B2B:</strong>\n"
"                    Creează și atribuie fiecărui contact B2B o listă de "
"prețuri dedicată. Asigură-te că aceasta\n"
"                    este activă pe site, pentru ca clientul să vadă "
"prețurile convenite după autentificare."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Delivery Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Delivery "
"Methods</strong>\n"
"                    to define all available options and their costs."
msgstr ""
"<strong>Metode de livrare:</strong>\n"
"                    Accesează <strong>Website &gt; Configurare &gt; Metode "
"de livrare</strong>\n"
"                    pentru a defini opțiunile disponibile și costurile "
"acestora."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>E-commerce Category:</strong> For easier product retrieval by "
"customers on your online store."
msgstr ""
"<strong>Categorie eCommerce:</strong> Facilitează găsirea produselor de "
"către clienții magazinului online."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Employee Scheduling:</strong>\n"
"                    Use the <strong>Planning App</strong> to create and "
"manage employee schedules,\n"
"                    ensuring you have the right staff at the right times for "
"busy days and specific orders."
msgstr ""
"<strong>Planificarea angajaților:</strong>\n"
"                    Folosește <strong>aplicația Planificare</strong> pentru "
"a crea și gestiona programul angajaților,\n"
"                    asigurând personalul potrivit la orele potrivite în "
"zilele aglomerate și pentru comenzile speciale."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>External Providers:</strong>\n"
"                            Check if a predefined Odoo connection exists if "
"you work with\n"
"                            specific shipping carriers."
msgstr ""
"<strong>Furnizori externi:</strong>\n"
"                            Dacă lucrezi cu anumiți transportatori,\n"
"                            verifică dacă există deja un conector Odoo."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>In-Store Pickup (Click &amp; Collect):</strong>\n"
"                            If you wish to offer this, you must\n"
"                            <strong>activate the setting</strong> within "
"the\n"
"                            <strong>Website Settings</strong> first."
msgstr ""
"<strong>Ridicare din magazin (Click &amp; Collect):</strong>\n"
"                            Pentru a oferi această opțiune, trebuie mai "
"întâi să\n"
"                            <strong>activezi setarea</strong> în\n"
"                            <strong>Setările Website</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Layout Settings:</strong>\n"
"                    Adjust the visual presentation and layout of products "
"using the\n"
"                    <strong>website editor</strong>."
msgstr ""
"<strong>Setări de aspect:</strong>\n"
"                    Ajustează prezentarea și aranjarea produselor folosind\n"
"                    <strong>editorul Website</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Loyalty Programs:</strong>\n"
"                            Implement <strong>loyalty cards</strong> as a "
"core strategy to <strong>activate customer retentio\n"
"                            </strong> and increase customer lifetime value."
msgstr ""
"<strong>Programe de fidelizare:</strong>\n"
"                            Folosește <strong>carduri de fidelitate</strong> "
"ca strategie principală pentru <strong>creșterea retenției clienților\n"
"                            </strong> și a valorii acestora pe termen lung."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Note:</strong> Increased capability leads to higher complexity and "
"more maintenance."
msgstr ""
"<strong>Notă:</strong> Funcționalitățile suplimentare sporesc complexitatea "
"și necesită mai multă întreținere."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Our Advice:</strong> Stick with your current streamlined "
"configuration until\n"
"                        you're fully comfortable. When you're ready to "
"upgrade, try the inventory module on a duplicated database first to ensure "
"it fits\n"
"                        your workflow. 😉"
msgstr ""
"<strong>Recomandarea noastră:</strong> Păstrează configurația simplă până "
"când te familiarizezi cu ea.\n"
"                        Când ești gata de upgrade, testează mai întâi "
"modulul Stocuri într-o bază duplicată\n"
"                        pentru a verifica dacă se potrivește fluxului tău de "
"lucru. 😉"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payment Providers &amp; Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Payment "
"Providers</strong>\n"
"                    and install all the payment methods and providers you "
"plan to offer\n"
"                    (e.g., credit card processors, PayPal, etc.)."
msgstr ""
"<strong>Furnizori și metode de plată:</strong>\n"
"                    Accesează <strong>Website &gt; Configurare &gt; "
"Furnizori de plată</strong>\n"
"                    și instalează metodele și furnizorii pe care dorești să "
"îi oferi\n"
"                    (de ex., procesatori de carduri, PayPal etc.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payroll:</strong>\n"
"                    Use this feature to handle <strong>employee salaries and "
"manage holiday\n"
"                    requests.</strong>"
msgstr ""
"<strong>Salarizare:</strong>\n"
"                    Folosește această funcție pentru a gestiona <strong>"
"salariile angajaților și cererile\n"
"                    de concediu.</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Point of Sale Category:</strong> For organizing transactions within "
"your shop system."
msgstr ""
"<strong>Categorie POS:</strong> Pentru organizarea tranzacțiilor din magazin."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Pricelist Segmentation:</strong>\n"
"                            Define multiple pricing structures for the same "
"product, supporting different\n"
"                            business models (e.g., B2B vs. B2C) and enabling "
"<strong>client-specific pricing\n"
"                            contracts.</strong>"
msgstr ""
"<strong>Segmentarea listelor de prețuri:</strong>\n"
"                            Definește structuri de preț diferite pentru "
"același produs, adaptate mai multor\n"
"                            modele de afaceri (de ex., B2B și B2C), și "
"permite <strong>contracte cu prețuri\n"
"                            personalizate pentru clienți.</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Product Category:</strong> For internal tracking and reporting."
msgstr ""
"<strong>Categorie de produs:</strong> Pentru urmărire internă și raportare."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Product-Level Settings:</strong>\n"
"                    Define core product settings directly on the "
"<strong>product form</strong>."
msgstr ""
"<strong>Setări la nivel de produs:</strong>\n"
"                    Definește setările principale direct în <strong>"
"formularul produsului</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Promotional Agility:</strong>\n"
"                            Use <strong>discounts and promotions</strong> to "
"quickly adjust pricing for sales events or to give\n"
"                            targeted, <strong>manual reductions</strong> at "
"the point of sale."
msgstr ""
"<strong>Flexibilitate promoțională:</strong>\n"
"                            Folosește <strong>reduceri și promoții</strong> "
"pentru a ajusta rapid prețurile la campanii sau pentru a acorda\n"
"                            <strong>reduceri manuale</strong> în POS."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Publishing:</strong>\n"
"                    Each product can be <strong>published independently</"
"strong> on your online store."
msgstr ""
"<strong>Publicare:</strong>\n"
"                    Fiecare produs poate fi <strong>publicat independent</"
"strong> în magazinul online."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Quote and Confirm:</strong>\n"
"                    If a specific demand requires pricing, generate a "
"quotation directly from the\n"
"                    <strong>Sales</strong> app. The client can then confirm "
"and sign it online."
msgstr ""
"<strong>Ofertare și confirmare:</strong>\n"
"                    Dacă o solicitare specială necesită ofertare, creează "
"oferta direct din aplicația\n"
"                    <strong>Vânzări</strong>. Clientul o poate confirma și "
"semna online."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Restaurant Mode:</strong>\n"
"                    Manage tables, orders, and payments with the Point of "
"Sale system if you offer an \"eat-in\" option."
msgstr ""
"<strong>Mod restaurant:</strong>\n"
"                    Gestionează mesele, comenzile și plățile în POS dacă "
"oferi servire la masă în local."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Want to do more?</strong>"
msgstr "<strong>Vrei să faci mai multe?</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>You didn't import demo data?</strong> You can still do it. Go to "
"<strong>Apps &gt; Industries &gt; Upgrade your Bakery Package</strong> and "
"check the related box."
msgstr ""
"<strong>Nu ai importat date demo?</strong> Poți face acest lucru oricând. "
"Mergi la <strong>Aplicații &gt; Industrii &gt; Upgradează pachetul tău de "
"brutărie</strong> și bifează căsuța corespunzătoare."

#. module: bakery
