#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<span style=\"font-weight: normal;\">🎓 Sales</span>"
msgstr "<span style=\"font-weight: normal;\">🎓 Verkoop</span>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Accounting:</strong>\n"
"                    Automatically log payments, close sessions, and generate "
"tax reports."
msgstr ""
"<strong>Boekhouding:</strong>\n"
"                    Registreer automatisch betalingen, sluit sessies af en "
"genereer belastingrapporten."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Automatic Delivery:</strong>\n"
"                    Once the quote is accepted, it's possible to deliver the "
"products just as it does for a regular e-commerce order."
msgstr ""
"<strong>Automatische levering:</strong>\n"
"                    Zodra de offerte is geaccepteerd, is het mogelijk om de "
"producten te leveren, net zoals bij een gewone e-commercebestelling."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Crucial Review:</strong>\n"
"                    You must review all e-commerce settings to ensure they "
"align with your\n"
"                    internal business policies (e.g., when invoices are "
"generated, whether a\n"
"                    mandatory customer check-in is required for ordering, "
"etc.)."
msgstr ""
"<strong>Belangrijke controle:</strong> Je moet alle e-commerce-instellingen "
"controleren zodat ze zeker overeenstemmen met je interne bedrijfsbeleid (bv. "
"wanneer verkoopfacturen worden gegenereerd, of een verplichte "
"klantregistratie vereist is voor het plaatsen van bestellingen, enz.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Define B2B Pricing:</strong>\n"
"                    Create and assign a dedicated pricelist to each B2B "
"contact. Ensure this pricelist\n"
"                    is active on your website so the customer sees their "
"agreed-upon prices upon login."
msgstr ""
"<strong>B2B-prijzen definiëren:</strong> Maak een speciale prijslijst aan en "
"wijs deze toe aan elk B2B-contact. Zorg ervoor dat deze prijslijst actief is "
"op je website, zodat de klant bij het inloggen de overeengekomen prijzen te "
"zien krijgt."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Delivery Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Delivery "
"Methods</strong>\n"
"                    to define all available options and their costs."
msgstr ""
"<strong>Leveringsmethoden:</strong> Ga naar <strong>Website &gt; "
"Configuratie &gt; Leveringsmethoden</strong> om alle beschikbare opties en "
"de bijbehorende kosten te bekijken."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>E-commerce Category:</strong> For easier product retrieval by "
"customers on your online store."
msgstr ""
"<strong>E-commercecategorie:</strong> Met categorieën kunnen klanten "
"producten gemakkelijker vinden in je webwinkel."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Employee Scheduling:</strong>\n"
"                    Use the <strong>Planning App</strong> to create and "
"manage employee schedules,\n"
"                    ensuring you have the right staff at the right times for "
"busy days and specific orders."
msgstr ""
"<strong>Werknemersplanning:</strong> Gebruik de <strong>Planning-app</"
"strong> om roosters voor werknemers op te stellen en te beheren, zodat je op "
"drukke dagen en voor specifieke orders op het juiste moment over het juiste "
"personeel beschikt."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>External Providers:</strong>\n"
"                            Check if a predefined Odoo connection exists if "
"you work with\n"
"                            specific shipping carriers."
msgstr ""
"<strong>Externe providers:</strong> Controleer of er een vooraf "
"gedefinieerde Odoo-koppeling bestaat als je met specifieke vervoerders werkt."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>In-Store Pickup (Click &amp; Collect):</strong>\n"
"                            If you wish to offer this, you must\n"
"                            <strong>activate the setting</strong> within "
"the\n"
"                            <strong>Website Settings</strong> first."
msgstr ""
"<strong>Afhalen in de winkel (Click &amp; Collect):</strong> Als je deze "
"optie wilt aanbieden, moet je <strong>eerst de nodige instelling</strong> "
"activeren in de <strong>website-instellingen</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Layout Settings:</strong>\n"
"                    Adjust the visual presentation and layout of products "
"using the\n"
"                    <strong>website editor</strong>."
msgstr ""
"<strong>Lay-out-instellingen:</strong> Pas de visuele weergave en lay-out "
"van producten aan met behulp van de <strong>website-editor</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Loyalty Programs:</strong>\n"
"                            Implement <strong>loyalty cards</strong> as a "
"core strategy to <strong>activate customer retentio\n"
"                            </strong> and increase customer lifetime value."
msgstr ""
"<strong>Loyaliteitsprogramma’s:</strong> Implementeer <strong>"
"klantenkaarten</strong> als kernstrategie om <strong>klanten te behouden</"
"strong> en de customer lifetime value te verhogen."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Note:</strong> Increased capability leads to higher complexity and "
"more maintenance."
msgstr ""
"<strong>Let op:</strong> Meer mogelijkheden leiden tot grotere complexiteit "
"en meer onderhoud."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Our Advice:</strong> Stick with your current streamlined "
"configuration until\n"
"                        you're fully comfortable. When you're ready to "
"upgrade, try the inventory module on a duplicated database first to ensure "
"it fits\n"
"                        your workflow. 😉"
msgstr ""
"<strong>Ons advies:</strong> Blijf bij je huidige gestroomlijnde "
"configuratie totdat je er volledig vertrouwd mee bent. Als je klaar bent om "
"te upgraden, probeer dan eerst de Voorraad-module uit op een gekopieerde "
"database om er zeker van te zijn dat deze past bij je workflow. 😉"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payment Providers &amp; Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Payment "
"Providers</strong>\n"
"                    and install all the payment methods and providers you "
"plan to offer\n"
"                    (e.g., credit card processors, PayPal, etc.)."
msgstr ""
"<strong>Betalingsproviders &amp; Betaalmethoden:</strong> Ga naar <strong>"
"Website &gt; Configuratie &gt; Betalingsproviders</strong> en installeer "
"alle betaalmethoden en -providers die je van plan bent aan te bieden (bv. "
"creditcardverwerkers, PayPal, enz.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payroll:</strong>\n"
"                    Use this feature to handle <strong>employee salaries and "
"manage holiday\n"
"                    requests.</strong>"
msgstr ""
"<strong>Loonadministratie:</strong> Gebruik deze functie om de <strong>lonen "
"van werknemers en verlofaanvragen te verwerken</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Point of Sale Category:</strong> For organizing transactions within "
"your shop system."
msgstr ""
"<strong>Kassacategorie:</strong> Voor het organiseren van transacties in je "
"kassasysteem."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Pricelist Segmentation:</strong>\n"
"                            Define multiple pricing structures for the same "
"product, supporting different\n"
"                            business models (e.g., B2B vs. B2C) and enabling "
"<strong>client-specific pricing\n"
"                            contracts.</strong>"
msgstr ""
"<strong>Verschillende prijslijsten:</strong> Definieer meerdere "
"prijsstructuren voor hetzelfde product, ter ondersteuning van verschillende "
"bedrijfsmodellen (bv. B2B versus B2C) en om <strong>klantspecifieke "
"prijsafspraken</strong> mogelijk te maken."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Product Category:</strong> For internal tracking and reporting."
msgstr "<strong>Productcategorie:</strong> Voor interne tracking en rapportage."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Product-Level Settings:</strong>\n"
"                    Define core product settings directly on the "
"<strong>product form</strong>."
msgstr ""
"<strong>Instellingen op productniveau:</strong> Stel de belangrijkste "
"productinstellingen rechtstreeks in op het <strong>productformulier</strong> "
"."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Promotional Agility:</strong>\n"
"                            Use <strong>discounts and promotions</strong> to "
"quickly adjust pricing for sales events or to give\n"
"                            targeted, <strong>manual reductions</strong> at "
"the point of sale."
msgstr ""
"<strong>Flexibele promoties:</strong> Gebruik <strong>kortingen en "
"promoties</strong> om prijzen snel aan te passen voor verkoopevenementen of "
"om <strong>handmatig specifieke kortingen</strong> te geven in het "
"kassasysteem."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Publishing:</strong>\n"
"                    Each product can be <strong>published independently</"
"strong> on your online store."
msgstr ""
"<strong>Publiceren:</strong> Elk product kan <strong>afzonderlijk worden "
"gepubliceerd</strong> in je online winkel."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Quote and Confirm:</strong>\n"
"                    If a specific demand requires pricing, generate a "
"quotation directly from the\n"
"                    <strong>Sales</strong> app. The client can then confirm "
"and sign it online."
msgstr ""
"<strong>Offerte opstellen en bevestigen:</strong> Als voor een specifieke "
"aanvraag een offerte nodig is, kun je rechtstreeks vanuit de <strong>Verkoop-"
"app</strong> een offerte opstellen. De klant kan deze vervolgens online "
"bevestigen en ondertekenen."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Restaurant Mode:</strong>\n"
"                    Manage tables, orders, and payments with the Point of "
"Sale system if you offer an \"eat-in\" option."
msgstr ""
"<strong>Restaurantmodus:</strong> Beheer tafels, bestellingen en betalingen "
"met het kassasysteem als je een optie 'hier eten' aanbiedt."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Want to do more?</strong>"
msgstr "<strong>Wil je nog meer opties?</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>You didn't import demo data?</strong> You can still do it. Go to "
"<strong>Apps &gt; Industries &gt; Upgrade your Bakery Package</strong> and "
"check the related box."
msgstr ""
"<strong>Heb je geen demodata geïmporteerd?</strong> Dat kan nog steeds. Ga "
"naar <strong>Apps &gt; Sectoren &gt; Upgrade je Bakkerij-pakket</strong> en "
"vink het betreffende vakje aan."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.ir_ui_view_3529
msgid "About us"
msgstr "Over ons"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "Accept multiple payment options: cash, card, and mobile payments."
msgstr ""
