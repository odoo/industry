msgid ""
"1. <strong>Create a purchase order:</strong>\n"
"                    Select the materials you need for your breads and "
"pastries."
msgstr ""
"1. <strong>Satınalma siparişi oluşturun:</strong>\n"
"                    Ekmekleriniz ve hamur işleriniz için ihtiyaç duyduğunuz "
"malzemeleri seçin."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
