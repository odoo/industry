#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<span style=\"font-weight: normal;\">🎓 Sales</span>"
msgstr "<span style=\"font-weight: normal;\">🎓 Vendas</span>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Accounting:</strong>\n"
"                    Automatically log payments, close sessions, and generate "
"tax reports."
msgstr ""
"<strong>Financeiro:</strong>\n"
"                    Registre pagamentos automaticamente, encerre sessões e "
"gere relatórios fiscais."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Automatic Delivery:</strong>\n"
"                    Once the quote is accepted, it's possible to deliver the "
"products just as it does for a regular e-commerce order."
msgstr ""
"<strong>Entrega Automática:</strong>\n"
"                    Assim que o orçamento for aceito, é possível entregar os "
"produtos da mesma forma que um pedido comum de e-commerce."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Crucial Review:</strong>\n"
"                    You must review all e-commerce settings to ensure they "
"align with your\n"
"                    internal business policies (e.g., when invoices are "
"generated, whether a\n"
"                    mandatory customer check-in is required for ordering, "
"etc.)."
msgstr ""
"<strong>Revisão Crucial:</strong>\n"
"                    Você deve revisar todas as configurações de e-commerce "
"para garantir que estejam alinhadas com suas\n"
"                    políticas comerciais internas (por exemplo, quando as "
"faturas são geradas, se um\n"
"                    check-in obrigatório do cliente é exigido para realizar "
"pedidos, etc.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Define B2B Pricing:</strong>\n"
"                    Create and assign a dedicated pricelist to each B2B "
"contact. Ensure this pricelist\n"
"                    is active on your website so the customer sees their "
"agreed-upon prices upon login."
msgstr ""
"<strong>Definir Precificação B2B:</strong>\n"
"                    Crie e atribua uma lista de preços dedicada a cada "
"contato B2B. Certifique-se de que esta lista de preços\n"
"                    esteja ativa em seu site para que o cliente veja os "
"preços acordados após o login."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Delivery Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Delivery "
"Methods</strong>\n"
"                    to define all available options and their costs."
msgstr ""
"<strong>Métodos de Entrega:</strong>\n"
"                    Vá para <strong>Site &gt; Configuração &gt; Métodos de "
"Entrega</strong>\n"
"                    para definir todas as opções disponíveis e seus custos."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>E-commerce Category:</strong> For easier product retrieval by "
"customers on your online store."
msgstr ""
"<strong>Categoria de E-commerce:</strong> Para facilitar a localização de "
"produtos pelos clientes em sua loja virtual."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Employee Scheduling:</strong>\n"
"                    Use the <strong>Planning App</strong> to create and "
"manage employee schedules,\n"
"                    ensuring you have the right staff at the right times for "
"busy days and specific orders."
msgstr ""
"<strong>Agendamento de Funcionários:</strong>\n"
"                    Use o <strong>Aplicativo de Planejamento</strong> para "
"criar e gerenciar escalas de funcionários,\n"
"                    garantindo que você tenha a equipe certa nos momentos "
"certos para dias movimentados e pedidos específicos."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>External Providers:</strong>\n"
"                            Check if a predefined Odoo connection exists if "
"you work with\n"
"                            specific shipping carriers."
msgstr ""
"<strong>Provedores Externos:</strong>\n"
"                            Verifique se existe uma conexão Odoo predefinida "
"se você trabalha com\n"
"                            transportadoras específicas."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>In-Store Pickup (Click &amp; Collect):</strong>\n"
"                            If you wish to offer this, you must\n"
"                            <strong>activate the setting</strong> within "
"the\n"
"                            <strong>Website Settings</strong> first."
msgstr ""
"<strong>Retirada na loja (Clique &amp; Coletar):</strong>\n"
"                            Se você deseja oferecer isso, primeiro deve\n"
"                            <strong>ativar a configuração</strong> dentro "
"das\n"
"                            <strong>Configurações do Site</strong> primeiro."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Layout Settings:</strong>\n"
"                    Adjust the visual presentation and layout of products "
"using the\n"
"                    <strong>website editor</strong>."
msgstr ""
"<strong>Configurações de Layout:</strong>\n"
"                    Ajuste a apresentação visual e o layout dos produtos "
"usando o\n"
"                    <strong>editor de site</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Loyalty Programs:</strong>\n"
"                            Implement <strong>loyalty cards</strong> as a "
"core strategy to <strong>activate customer retentio\n"
"                            </strong> and increase customer lifetime value."
msgstr ""
"<strong>Programas de Fidelidade:</strong>\n"
"                            Implemente <strong>cartões de fidelidade</"
"strong> como uma estratégia central para <strong>ativar a retenção de "
"clientes\n"
"                            </strong> e aumentar o valor do tempo de vida do "
"cliente."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Note:</strong> Increased capability leads to higher complexity and "
"more maintenance."
msgstr ""
"<strong>Nota:</strong> Capacidade aumentada leva a maior complexidade e mais "
"manutenção."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Our Advice:</strong> Stick with your current streamlined "
"configuration until\n"
"                        you're fully comfortable. When you're ready to "
"upgrade, try the inventory module on a duplicated database first to ensure "
"it fits\n"
"                        your workflow. 😉"
msgstr ""
"<strong>Nosso conselho:</strong> Mantenha sua configuração simplificada "
"atual até\n"
"                        se sentir totalmente confortável. Quando estiver "
"pronto para atualizar, experimente o módulo de inventário em um banco de "
"dados duplicado primeiro para garantir que ele se adeque\n"
"                        ao seu fluxo de trabalho. 😉"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payment Providers &amp; Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Payment "
"Providers</strong>\n"
"                    and install all the payment methods and providers you "
"plan to offer\n"
"                    (e.g., credit card processors, PayPal, etc.)."
msgstr ""
"<strong>Provedores de Pagamento &amp; Métodos:</strong>\n"
"                    Vá para <strong>Site &gt; Configuração &gt; Provedores "
"de Pagamento</strong>\n"
"                    e instale todos os métodos e provedores de pagamento que "
"você planeja oferecer\n"
"                    (por exemplo, processadores de cartão de crédito, "
"PayPal, etc.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payroll:</strong>\n"
"                    Use this feature to handle <strong>employee salaries and "
"manage holiday\n"
"                    requests.</strong>"
msgstr ""
"<strong>Folha de Pagamento:</strong>\n"
"                    Use este recurso para lidar com <strong>salários de "
"funcionários e gerenciar solicitações\n"
"                    de férias.</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Point of Sale Category:</strong> For organizing transactions within "
"your shop system."
msgstr ""
"<strong>Categoria de Ponto de Venda:</strong> Para organizar transações "
"dentro do seu sistema de loja."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Pricelist Segmentation:</strong>\n"
"                            Define multiple pricing structures for the same "
"product, supporting different\n"
"                            business models (e.g., B2B vs. B2C) and enabling "
"<strong>client-specific pricing\n"
"                            contracts.</strong>"
msgstr ""
"<strong>Segmentação de Lista de Preços:</strong>\n"
"                            Defina várias estruturas de preços para o mesmo "
"produto, suportando diferentes\n"
"                            modelos de negócios (por exemplo, B2B vs. B2C) e "
"permitindo <strong>contratos de preços específicos\n"
"                            por cliente.</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Product Category:</strong> For internal tracking and reporting."
msgstr ""
"<strong>Categoria de Produto:</strong> Para rastreamento e relatórios "
"internos."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Product-Level Settings:</strong>\n"
"                    Define core product settings directly on the "
"<strong>product form</strong>."
msgstr ""
"<strong>Configurações em Nível de Produto:</strong>\n"
"                    Defina as configurações principais do produto "
"diretamente no <strong>formulário de produto</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Promotional Agility:</strong>\n"
"                            Use <strong>discounts and promotions</strong> to "
"quickly adjust pricing for sales events or to give\n"
"                            targeted, <strong>manual reductions</strong> at "
"the point of sale."
msgstr ""
"<strong>Agilidade Promocional:</strong>\n"
"                            Use <strong>descontos e promoções</strong> para "
"ajustar rapidamente os preços para eventos de vendas ou para dar\n"
"                            reduções manuais, <strong>reduções manuais</"
"strong> no ponto de venda."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Publishing:</strong>\n"
"                    Each product can be <strong>published independently</"
"strong> on your online store."
msgstr ""
"<strong>Publicação:</strong>\n"
"                    Cada produto pode ser <strong>publicado "
"independentemente</strong> em sua loja online."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Quote and Confirm:</strong>\n"
"                    If a specific demand requires pricing, generate a "
"quotation directly from the\n"
"                    <strong>Sales</strong> app. The client can then confirm "
"and sign it online."
msgstr ""
"<strong>Orçamento e Confirmação:</strong>\n"
"                    Se uma demanda específica exigir precificação, gere um "
"orçamento diretamente do\n"
"                    <strong>Vendas</strong> app. O cliente pode então "
"confirmar e assinar online."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Restaurant Mode:</strong>\n"
"                    Manage tables, orders, and payments with the Point of "
"Sale system if you offer an \"eat-in\" option."
msgstr ""
"<strong>Modo Restaurante:</strong>\n"
"                    Gerencie mesas, pedidos e pagamentos com o sistema de "
"Ponto de Venda se você oferecer uma opção de \"comer no local\"."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Want to do more?</strong>"
msgstr "<strong>Quer fazer mais?</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>You didn't import demo data?</strong> You can still do it. Go to "
"<strong>Apps &gt; Industries &gt; Upgrade your Bakery Package</strong> and "
"check the related box."
msgstr ""
"<strong>Não importou dados de demonstração?</strong> Você ainda pode fazer "
"isso. Vá para <strong>Aplicativos > Setores, atualize seu pacote Padaria</"
"strong> e marque a caixa relacionada."

