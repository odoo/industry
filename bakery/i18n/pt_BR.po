#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"2. <strong>Choose the best vendor:</strong>\n"
"                    Pick the vendor offering the best deal for the requested "
"materials."
msgstr ""
"2. <strong>Escolher o melhor fornecedor:</strong>\n"
"                    Escolha o fornecedor que oferece o melhor negócio para "
"os materiais solicitados."

