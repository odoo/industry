#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<span style=\"font-weight: normal;\">🎓 Sales</span>"
msgstr "<span style=\"font-weight: normal;\">🎓 Ventas</span>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Accounting:</strong>\n"
"                    Automatically log payments, close sessions, and generate "
"tax reports."
msgstr ""
"<strong>Contabilidad:</strong>\n"
"                    Registra pagos de forma automática, cierra sesiones y "
"genera reportes fiscales."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Automatic Delivery:</strong>\n"
"                    Once the quote is accepted, it's possible to deliver the "
"products just as it does for a regular e-commerce order."
msgstr ""
"<strong>Entrega automática:</strong>\n"
"                Cuando la cotización haya sido aceptada podrás entregar los "
"productos igual que en una orden normal de comercio electrónico."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Crucial Review:</strong>\n"
"                    You must review all e-commerce settings to ensure they "
"align with your\n"
"                    internal business policies (e.g., when invoices are "
"generated, whether a\n"
"                    mandatory customer check-in is required for ordering, "
"etc.)."
msgstr ""
"<strong>Revisiones importantes:</strong>\n"
"                    Revisa todos los ajustes de Comercio electrónico para "
"asegurarte de que se adapten \n"
"                    a tus políticas internas (por ejemplo, cuándo se generan "
"las facturas, si es necesario que \n"
"                    el cliente se registre para ordenar, entre otras cosas)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Define B2B Pricing:</strong>\n"
"                    Create and assign a dedicated pricelist to each B2B "
"contact. Ensure this pricelist\n"
"                    is active on your website so the customer sees their "
"agreed-upon prices upon login."
msgstr ""
"<strong>Define precios B2B:</strong>\n"
"                    Crea y asigna una lista de precios específica para cada "
"contacto B2B. Asegúrate de que esta lista\n"
"                    esté activa en tu sitio web para que el cliente vea los "
"precios correctos al iniciar sesión."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Delivery Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Delivery "
"Methods</strong>\n"
"                    to define all available options and their costs."
msgstr ""
"<strong>Métodos de entrega:</strong>\n"
"                    Ve a <strong>Sitio web &gt; Configuración &gt; Métodos "
"de entrega</strong> \n"
"                    para definir todas las opciones disponibles y sus costos."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>E-commerce Category:</strong> For easier product retrieval by "
"customers on your online store."
msgstr ""
"<strong>Categoría de comercio electrónico:</strong> Facilita que los "
"clientes encuentren productos en tu tienda en línea."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Employee Scheduling:</strong>\n"
"                    Use the <strong>Planning App</strong> to create and "
"manage employee schedules,\n"
"                    ensuring you have the right staff at the right times for "
"busy days and specific orders."
msgstr ""
"<strong>Planificación del personal:</strong>\n"
"                Usa la <strong>aplicación Planeación</strong> para crear y "
"gestionar los horarios de tus empleados,\n"
"                así tendrás a las personas indicadas en el momento adecuado "
"durante los días con mayor actividad y para órdenes específicas."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>External Providers:</strong>\n"
"                            Check if a predefined Odoo connection exists if "
"you work with\n"
"                            specific shipping carriers."
msgstr ""
"<strong>Proveedores externos:</strong> \n"
"                            Verifica si existe una conexión predefinida de "
"Odoo\n"
"                            si trabajas con transportistas específicos."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>In-Store Pickup (Click &amp; Collect):</strong>\n"
"                            If you wish to offer this, you must\n"
"                            <strong>activate the setting</strong> within "
"the\n"
"                            <strong>Website Settings</strong> first."
msgstr ""
"<strong>Recolección en tienda (Haz clic y recoge):</strong> \n"
"                            Si deseas ofrecer esta opción, primero debes "
"<strong>activar la función</strong> \n"
"                            en los <strong>ajustes de Sitio web</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Layout Settings:</strong>\n"
"                    Adjust the visual presentation and layout of products "
"using the\n"
"                    <strong>website editor</strong>."
msgstr ""
"<strong>Ajustes de diseño:</strong>\n"
"                     Ajusta la apariencia y el diseño de los productos con "
"el \n"
"                    <strong>editor del sitio web</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Loyalty Programs:</strong>\n"
"                            Implement <strong>loyalty cards</strong> as a "
"core strategy to <strong>activate customer retentio\n"
"                            </strong> and increase customer lifetime value."
msgstr ""
"<strong>Programas de lealtad:</strong>\n"
"                        Implementa <strong>tarjetas de lealtad</strong> como "
"estrategia principal para <strong>activar la retención de clientes</strong>\n"
"                        y aumentar el valor de vida de cada cliente."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Note:</strong> Increased capability leads to higher complexity and "
"more maintenance."
msgstr ""
"<strong>Nota:</strong> Cuantas más funciones uses, mayor será la complejidad "
"y el mantenimiento."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Our Advice:</strong> Stick with your current streamlined "
"configuration until\n"
"                        you're fully comfortable. When you're ready to "
"upgrade, try the inventory module on a duplicated database first to ensure "
"it fits\n"
"                        your workflow. 😉"
msgstr ""
"<strong>Nuestra recomendación:</strong> Mantén tu configuración actual "
"simplificada\n"
"                        hasta que te sientas con total confianza. Cuando "
"quieras actualizar tus funciones, prueba el módulo Inventario en una base de "
"datos duplicada para confirmar que se adapta\n"
"                        a tu flujo de trabajo. 😉"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payment Providers &amp; Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Payment "
"Providers</strong>\n"
"                    and install all the payment methods and providers you "
"plan to offer\n"
"                    (e.g., credit card processors, PayPal, etc.)."
msgstr ""
"<strong>Proveedores y métodos de pago:</strong>\n"
"                    Ve a <strong>Sitio web &gt; Configuración &gt; "
"Proveedores de pago</strong>\n"
"                    e instala todos los métodos y proveedores de pago que "
"planeas ofrecer\n"
"                    (por ejemplo, procesadores de tarjetas de crédito, "
"PayPal, etc.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Payroll:</strong>\n"
"                    Use this feature to handle <strong>employee salaries and "
"manage holiday\n"
"                    requests.</strong>"
msgstr ""
"<strong>Nómina:</strong>\n"
"                   Usa esta función para gestionar <strong>los sueldos de "
"los empleados y las solicitudes\n"
"                   de vacaciones.</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Point of Sale Category:</strong> For organizing transactions within "
"your shop system."
msgstr ""
"<strong>Categoría de Punto de venta:</strong> Organiza las transacciones del "
"sistema de tu tienda."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Pricelist Segmentation:</strong>\n"
"                            Define multiple pricing structures for the same "
"product, supporting different\n"
"                            business models (e.g., B2B vs. B2C) and enabling "
"<strong>client-specific pricing\n"
"                            contracts.</strong>"
msgstr ""
"<strong>Segmentación de listas de precios:</strong>\n"
"                        Define varias estructuras de precios para el mismo "
"producto, compatibles con distintos\n"
"                        modelos de negocio (por ejemplo, B2B y B2C), y "
"habilita <strong>contratos de precios\n"
"                        específicos para cada cliente.</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Product Category:</strong> For internal tracking and reporting."
msgstr ""
"<strong>Categoría del producto:</strong> Facilita el seguimiento interno y "
"la creación de reportes."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Product-Level Settings:</strong>\n"
"                    Define core product settings directly on the "
"<strong>product form</strong>."
msgstr ""
"<strong>Ajustes a nivel de producto:</strong>\n"
"                Define los ajustes principales de cada producto directo en "
"el <strong>formulario del producto</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Promotional Agility:</strong>\n"
"                            Use <strong>discounts and promotions</strong> to "
"quickly adjust pricing for sales events or to give\n"
"                            targeted, <strong>manual reductions</strong> at "
"the point of sale."
msgstr ""
"<strong>Flexibilidad promocional:</strong>\n"
"                        Usa <strong>descuentos y promociones</strong> para "
"ajustar precios con rapidez durante campañas de venta o para aplicar\n"
"                        <strong>descuentos manuales</strong> en el punto de "
"venta."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Publishing:</strong>\n"
"                    Each product can be <strong>published independently</"
"strong> on your online store."
msgstr ""
"<strong>Publicación:</strong>\n"
"               <strong>Publica cada producto por separado</strong> en tu "
"tienda en línea."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Quote and Confirm:</strong>\n"
"                    If a specific demand requires pricing, generate a "
"quotation directly from the\n"
"                    <strong>Sales</strong> app. The client can then confirm "
"and sign it online."
msgstr ""
"<strong>Cotiza y confirma:</strong>\n"
"                Si una solicitud específica requiere un precio, genera una "
"cotización directo desde la\n"
"                aplicación <strong>Ventas</strong>. Después, el cliente "
"podrá confirmarla y firmarla en línea."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Restaurant Mode:</strong>\n"
"                    Manage tables, orders, and payments with the Point of "
"Sale system if you offer an \"eat-in\" option."
msgstr ""
"<strong>Modo de restaurante:</strong>\n"
"                Gestiona mesas, órdenes y pagos con el sistema de punto de "
"venta si ofreces la opción de comer en el local."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid "<strong>Want to do more?</strong>"
msgstr "<strong>¿Quieres hacer más?</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>You didn't import demo data?</strong> You can still do it. Go to "
"<strong>Apps &gt; Industries &gt; Upgrade your Bakery Package</strong> and "
"check the related box."
msgstr ""
"<strong>¿No importó los datos de demostración?</strong> Todavía puede "
"hacerlo. Vaya a <strong>Aplicaciones > Industrias, actualice el paquete para "
"panaderías</strong> y seleccione la casilla correspondiente."

