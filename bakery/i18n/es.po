#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
msgid ""
"<strong>Accounting:</strong>\n"
"                    Automatically log payments, close sessions, and generate "
"tax reports."
msgstr ""
"<strong>Contabilidad:</strong>\n"
"                    registra pagos de forma automática, cierra sesiones y "
"genera informes fiscales."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Automatic Delivery:</strong>\n"
"                    Once the quote is accepted, it's possible to deliver the "
"products just as it does for a regular e-commerce order."
msgstr ""
"<strong>Entrega automática:</strong>\n"
"                    Una vez aceptado el presupuesto, es posible entregar los "
"productos tal como se hace en un pedido de comercio electrónico normal."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Crucial Review:</strong>\n"
"                    You must review all e-commerce settings to ensure they "
"align with your\n"
"                    internal business policies (e.g., when invoices are "
"generated, whether a\n"
"                    mandatory customer check-in is required for ordering, "
"etc.)."
msgstr ""
"<strong>Revisión crucial:</strong>\n"
"                    Debes revisar todos los ajustes de comercio electrónico "
"para asegurarte de que se alinean con tus\n"
"                    políticas comerciales internas (p. ej., cuándo se "
"generan las facturas, si es\n"
"                    obligatorio que el cliente inicie sesión para realizar "
"el pedido, etc.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Define B2B Pricing:</strong>\n"
"                    Create and assign a dedicated pricelist to each B2B "
"contact. Ensure this pricelist\n"
"                    is active on your website so the customer sees their "
"agreed-upon prices upon login."
msgstr ""
"<strong>Definir precios B2B:</strong>\n"
"                    Crea y asigna una tarifa específica a cada contacto B2B. "
"Asegúrate de que esta tarifa\n"
"                    esté activa en tu sitio web para que el cliente vea los "
"precios acordados al iniciar sesión."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Delivery Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Delivery "
"Methods</strong>\n"
"                    to define all available options and their costs."
msgstr ""
"<strong>Métodos de envío:</strong>\n"
"                    Ve a <strong>Sitio web &gt; Configuración &gt; Métodos "
"de envío</strong>\n"
"                    para definir todas las opciones disponibles y sus costes."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>E-commerce Category:</strong> For easier product retrieval by "
"customers on your online store."
msgstr ""
"<strong>Categoría de comercio electrónico:</strong> Para facilitar la "
"búsqueda de productos por parte de los clientes en tu tienda online."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Employee Scheduling:</strong>\n"
"                    Use the <strong>Planning App</strong> to create and "
"manage employee schedules,\n"
"                    ensuring you have the right staff at the right times for "
"busy days and specific orders."
msgstr ""
"<strong>Programación de empleados:</strong>\n"
"                    Usa la <strong>aplicación de Planificación</strong> para "
"crear y gestionar los horarios de los empleados,\n"
"                    asegurándote de contar con el personal adecuado en los "
"momentos precisos para los días de mayor actividad y pedidos específicos."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>External Providers:</strong>\n"
"                            Check if a predefined Odoo connection exists if "
"you work with\n"
"                            specific shipping carriers."
msgstr ""
"<strong>Proveedores externos:</strong>\n"
"                            Comprueba si existe una conexión predefinida en "
"Odoo si trabajas con\n"
"                            transportistas específicos."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>In-Store Pickup (Click &amp; Collect):</strong>\n"
"                            If you wish to offer this, you must\n"
"                            <strong>activate the setting</strong> within "
"the\n"
"                            <strong>Website Settings</strong> first."
msgstr ""
"<strong>Recogida en tienda (Click &amp; Collect):</strong>\n"
"                            Si deseas ofrecer esto, primero debes\n"
"                            <strong>activar el ajuste</strong> dentro de "
"los\n"
"                            <strong>ajustes del sitio web</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Layout Settings:</strong>\n"
"                    Adjust the visual presentation and layout of products "
"using the\n"
"                    <strong>website editor</strong>."
msgstr ""
"<strong>Ajustes de diseño:</strong>\n"
"                    Ajusta la presentación visual y el diseño de los "
"productos mediante el\n"
"                    <strong>editor del sitio web</strong>."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Loyalty Programs:</strong>\n"
"                            Implement <strong>loyalty cards</strong> as a "
"core strategy to <strong>activate customer retentio\n"
"                            </strong> and increase customer lifetime value."
msgstr ""
"<strong>Programas de fidelidad:</strong>\n"
"                            Implementa <strong>tarjetas de fidelidad</"
"strong> como estrategia principal para <strong>activar la retención de "
"clientes\n"
"                            </strong> y aumentar el valor de vida del "
"cliente."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Note:</strong> Increased capability leads to higher complexity and "
"more maintenance."
msgstr ""
"<strong>Nota:</strong> Una mayor capacidad conlleva una mayor complejidad y "
"más mantenimiento."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Our Advice:</strong> Stick with your current streamlined "
"configuration until\n"
"                        you're fully comfortable. When you're ready to "
"upgrade, try the inventory module on a duplicated database first to ensure "
"it fits\n"
"                        your workflow. 😉"
msgstr ""
"<strong>Nuestro consejo:</strong> Mantén tu configuración actual "
"simplificada hasta que te sientas totalmente cómodo. Cuando estés listo para "
"actualizar, prueba el módulo de inventario primero en una base de datos "
"duplicada para asegurarte de que se adapta a tu flujo de trabajo. 😉"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Payment Providers &amp; Methods:</strong>\n"
"                    Go to <strong>Website &gt; Configuration &gt; Payment "
"Providers</strong>\n"
"                    and install all the payment methods and providers you "
"plan to offer\n"
"                    (e.g., credit card processors, PayPal, etc.)."
msgstr ""
"<strong>Proveedores de pago &amp; Métodos:</strong>\n"
"                    Ve a <strong>Sitio web &gt; Configuración &gt; "
"Proveedores de pago</strong>\n"
"                    e instala todos los métodos y proveedores de pago que "
"planees ofrecer (por ejemplo, procesadores de tarjeta de crédito, PayPal, "
"etc.)."

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Payroll:</strong>\n"
"                    Use this feature to handle <strong>employee salaries and "
"manage holiday\n"
"                    requests.</strong>"
msgstr ""
"<strong>Nómina:</strong>\n"
"                    Utiliza esta función para gestionar los <strong>salarios "
"de los empleados y gestionar las solicitudes\n"
"                    de vacaciones.</strong>"

#. module: bakery
#: model_terms:ir.ui.view,arch_db:bakery.welcome_article_body
#, fuzzy
msgid ""
"<strong>Point of Sale Category:</strong> For organizing transactions within "
