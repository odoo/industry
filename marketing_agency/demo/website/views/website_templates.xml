<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-outline-custom text-o-color-2" style="border-style: solid; border-image: none; border-left-color: var(--o-color-2); border-bottom-color: var(--o-color-2); border-right-color: var(--o-color-2); border-top-color: var(--o-color-2); border-width: 5px;">Contact Us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_links" model="ir.ui.view">
        <field name="name">Custom - Links</field>
        <field name="key">website.template_footer_links</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt64 pb48" data-snippet="s_text_block" data-name="Container" style="position: relative;">
                        <div class="container">
                            <div class="row">
                                <div class="col-10 offset-1 pb16 o_colored_level col-lg-3 offset-lg-0">
                                    <h5>
                                        <span style="font-size: 20px;">Explore</span>
                                    </h5>
                                    <ul class="list-unstyled" style="font-size: 16px;">
                                        <li><a href="/" class="o_translate_inline text-o-color-2">Home</a></li>
                                        <li><a href="/event" class="o_translate_inline text-o-color-2">Events</a></li>
                                        <li><a href="/appointment" class="o_translate_inline text-o-color-2">Appointment</a></li>
                                        <li><a href="/about-us" class="o_translate_inline text-o-color-2">About us</a></li>
                                        <li><a href="/contactus" class="o_translate_inline text-o-color-2">Contact us</a></li>
                                    </ul>
                                </div>
                                <div class="col-10 offset-1 pb16 o_colored_level col-lg-3 offset-lg-0">
                                    <h5>
                                        <span style="font-size: 20px;">Follow us</span>
                                    </h5>
                                    <ul class="list-unstyled" style="font-size: 16px;">
                                        <li><i class="oi oi-fw me-2" data-icon="oi_facebook"/><a href="#" target="_blank" class="text-o-color-2">Facebook</a></li>
                                        <li><i class="oi oi-fw me-2" data-icon="oi_x"/><a href="#" target="_blank" class="text-o-color-2">X</a></li>
                                        <li><i class="oi oi-fw me-2" data-icon="oi_linkedin"/><a href="#" target="_blank" class="text-o-color-2">Linkedin</a></li>
                                        <li><i class="oi oi-fw me-2" data-icon="oi_instagram"/><a href="#" target="_blank" class="text-o-color-2">Instagram</a></li>
                                    </ul>
                                </div>
                                <div class="col-10 offset-1 pb16 o_colored_level col-lg-3 offset-lg-0">
                                    <h5>
                                        <span style="font-size: 20px;">Get in touch</span>
                                    </h5>
                                    <ul class="list-unstyled" style="font-size: 16px;">
                                        <li><i class="oi oi-filled oi-fw me-2" data-icon="mail"/><a href="mailto:info@hype.example.com" class="text-o-color-2">info@hype.example.com</a></li>
                                        <li><i class="oi oi-filled oi-fw me-2" data-icon="phone"/><a href="tel:+15555555556"><span class="o_force_ltr text-o-color-2">+1 555-555-5556</span></a></li>
                                    </ul>
                                </div>
                                <div class="col-10 offset-1 pb16 o_colored_level col-lg-3 offset-lg-0">
                                    <h5>
                                        <span style="font-size: 20px;">Hype Inc.</span>
                                    </h5>
                                    <p style="font-size: 16px;">8000 Marina Blvd, Suite 300<br/>Brisbane CA 94005<br/>United States</p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
