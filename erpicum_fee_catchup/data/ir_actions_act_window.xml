<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_fee_invoices" model="ir.actions.act_window">
        <field name="name">Fee Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('x_fee_catchup_order_ids', 'in', [active_id])]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
    </record>
</odoo>
