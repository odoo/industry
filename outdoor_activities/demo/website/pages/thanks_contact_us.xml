<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_thanks_contact_us" model="ir.ui.view">
        <field name="name">Thanks (Contact us)</field>
        <field name="key">outdoor_activities.page_thanks_contact_us</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Thanks (Contact us)" t-name="outdoor_activities.page_thanks_contact_us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="col-lg-6 offset-lg-3 text-center o_colored_level">
                                        <div class="d-inline-block mx-auto p-4">
                                            <img src="/web/image/outdoor_activities.img_custom_image_02" alt="" class="mb-3 rounded-circle img img-fluid o_we_custom_image" style="width: 50% !important;"/>
                                            <h1 class="fw-bolder"><br/>Thank you for your question !</h1>
                                            <p class="lead mb-0">Your message has been sent.</p>
                                            <p class="lead">We will get back to you shortly.</p>
                                            <p class="lead">
                                                <br/>
                                            </p>
                                            <p class="lead">
                                                <img src="/web/image/outdoor_activities.img_custom_image_05" alt="" class="img img-fluid o_we_custom_image rounded" data-format-mimetype="image/webp" data-resize-width="1745" data-mimetype="image/webp"/>
                                            </p>
                                            <a href="/">Go to Homepage</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <input t-if="website.plausible_shared_key" type="hidden" class="js_plausible_push" data-event-name="Lead Generation" data-event-params="{&quot;CTA&quot;: &quot;Contact Us&quot;}"/>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_thanks_contact_us" model="website.page">
            <field name="view_id" ref="view_page_thanks_contact_us"/>
            <field name="url">/contactus-thank-you</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="False"/>
        </record>
    </data>
</odoo>
