                            <div class="oe_structure oe_empty" data-editor-message-default="true" data-editor-message="DRAG BUILDING BLOCKS HERE"/>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('outdoor_activities.website_industry').id).viewref('outdoor_activities.view_page_home').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('outdoor_activities.view_page_home').arch.replace(
                '*private-tour*', 'private-tour-%s' % obj().env.ref('outdoor_activities.product_product_5').product_tmpl_id.id).replace(
                '*shallow-reef-tour*', 'shallow-reef-tour-%s' % obj().env.ref('outdoor_activities.appointment_type_1').id).replace(
                '*advanced-cave-dive*', 'advanced-cave-dive-%s' % obj().env.ref('outdoor_activities.appointment_type_2').id
            )}"/>
    </function>

    <data noupdate="1">
        <record id="page_home" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_home"/>
            <field name="url">/</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
            <field name="header_text_color">text-o-color-4</field>
        </record>
    </data>
</odoo>
