<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="appointment_banner_categories" model="ir.ui.view">
        <field name="name">Custom - Appointment banner</field>
        <field name="inherit_id" ref="website_appointment.appointments_selection_layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_appointments_card_top']" position="inside">
                <section class="s_banner_categories o_cc o_cc5 o_colored_level parallax s_parallax_is_fixed s_parallax_no_overflow_hidden pb80 s_custom_snippet" style="background-position: 50% 75%;" data-snippet="s_banner_categories" data-scroll-background-ratio="1" data-name="Custom Banner Categories">
                    <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-resize-width="1920" data-mimetype="image/webp" style="background-image: url(&quot;/web/image/outdoor_activities.img_custom_image_10&quot;);" data-quality="100"/>
                    <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgb(0, 0, 0) 20%, rgba(0, 0, 0, 0.22) 100%);"/>
                    <div class="container">
                        <div class="o_grid_mode row" data-row-count="10" style="gap: 16px;">
                            <div data-name="Intro" class="o_grid_item o_colored_level justify-content-start g-col-lg-6 col-lg-6 g-height-5 o_we_padding_highlight" style="z-index: 1; grid-area: 2 / 4 / 7 / 10; --grid-item-padding-y: 52px;">
                                <h1 style="text-align: center;"><strong>Discover</strong> your<br/>new <strong>experience</strong></h1>
                                <p class="lead" style="text-align: center;"><strong>&#160;Book unforgettable diving experiences at sea : </strong>group dives, historical wrecks, and marine life encounters, all in one place.</p>
                            </div>
                            <div class="o_grid_item o_colored_level o_cc o_cc5 o_bg_img_center oe_img_bg justify-content-end offset-1 offset-lg-0 o_bg_img_origin_border_box rounded g-col-lg-4 g-height-4 col-lg-4 col-10" style="grid-area: 7 / 1 / 11 / 5; z-index: 2; background-image: url(&quot;/web/image/outdoor_activities.img_custom_image_14&quot;); --grid-item-padding-y: 32px; --grid-item-padding-x: 32px; --box-border-bottom-left-radius: 5px; --box-border-bottom-right-radius: 5px; --box-border-top-right-radius: 5px; --box-border-top-left-radius: 5px;" data-resize-width="1080" data-mimetype="image/webp">
                                <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgba(36, 36, 36, 0.52) 0%, rgba(255, 255, 255, 0) 50%);">
                                    <br/>
                                </div>
                                <h2 class="h3-fs" style="text-align: center;"><strong>Group</strong> experience&#160;</h2>
                            </div>
                            <div class="o_grid_item o_cc o_cc5 o_colored_level o_bg_img_center oe_img_bg justify-content-end offset-1 offset-lg-0 o_bg_img_origin_border_box rounded g-col-lg-4 g-height-4 col-lg-4 col-10" style="grid-area: 7 / 5 / 11 / 9; z-index: 4; background-image: url(&quot;/web/image/outdoor_activities.img_custom_image_15&quot;); --grid-item-padding-y: 32px; --grid-item-padding-x: 32px; --box-border-bottom-left-radius: 5px; --box-border-bottom-right-radius: 5px; --box-border-top-right-radius: 5px; --box-border-top-left-radius: 5px;" data-resize-width="1920" data-mimetype="image/webp">
                                <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgba(36, 36, 36, 0.52) 0%, rgba(255, 255, 255, 0) 50%);">
                                    <br/>
                                </div>
                                <h2 class="h3-fs" style="text-align: center;"><strong>Historical</strong> experience&#160;</h2>
                            </div>
                            <div class="o_grid_item o_cc o_cc5 o_bg_img_center oe_img_bg justify-content-end o_bg_img_origin_border_box rounded o_colored_level g-col-lg-4 g-height-4 col-lg-4 col-10 offset-1 offset-lg-0" style="grid-area: 7 / 9 / 11 / 13; z-index: 5; background-image: url(&quot;/web/image/outdoor_activities.img_custom_image_16&quot;); --grid-item-padding-y: 32px; --grid-item-padding-x: 32px; --box-border-bottom-left-radius: 5px; --box-border-bottom-right-radius: 5px; --box-border-top-right-radius: 5px; --box-border-top-left-radius: 5px;" data-resize-width="1920" data-mimetype="image/webp">
                                <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgba(36, 36, 36, 0.52) 0%, rgba(255, 255, 255, 0) 50%);">
                                    <br/>
                                </div>
                                <h2 class="h3-fs" style="text-align: center;"><strong>Animals</strong> experience&#160;</h2>
                            </div>
                        </div>
                    </div>
                </section>
            </xpath>
        </field>
    </record>
    <record id="appointment_topbar_title" model="ir.ui.view">
        <field name="name">Custom - Appointment topbar title</field>
        <field name="inherit_id" ref="website_appointment.website_calendar_index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//h1" position="replace">
                <h1 class="h4 mb-0">Choose your next experience</h1>
            </xpath>
        </field>
    </record>
</odoo>
