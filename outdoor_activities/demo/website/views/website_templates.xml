<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <!-- no <key>: it must differ from the inherited view's key, otherwise
        filter_duplicate() drops the generic and orphans this extension -->
        <field name="inherit_id" ref="website.footer_copyright_company_name"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small">Copyright © SCUBAS DIVING</span>
            </xpath>
        </field>
    </record>
    <record id="template_footer_contact" model="ir.ui.view">
        <field name="name">Custom - Contact</field>
        <field name="key">website.template_footer_contact</field>
        <!-- inherits website.layout, not the same-key view: this record *is* the
        website-specific Contact footer (COW replacement), so it must hang
        directly under the layout to be applied -->
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt32 pb0" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row o_grid_mode" style="gap: 16px;" data-row-count="3">
                                <div class="col-lg-3 o_grid_item g-col-lg-3 g-height-2 offset-1 offset-lg-0 col-10 o_cc o_cc3 rounded pt16 pb16 o_colored_level" style="z-index: 1; grid-area: 1 / 1 / 3 / 4; border-radius: 24px !important; --grid-item-padding-y: 30px; --grid-item-padding-x: 30px;">
                                    <h6>How can we help?</h6>
                                    <p>
                                        <span class="h5-fs">
                                            <a href="/contactus">Contact us anytime</a>
                                        </span>
                                    </p>
                                </div>
                                <div class="col-lg-3 o_grid_item g-col-lg-3 g-height-2 offset-1 offset-lg-0 col-10 o_cc o_cc1 rounded pt16 pb16 o_colored_level" style="z-index: 2; grid-area: 1 / 4 / 3 / 7; border-radius: 24px !important; --grid-item-padding-x: 30px; --grid-item-padding-y: 30px;">
                                    <h6>Call us</h6>
                                    <p>
                                        <span class="h5-fs">
                                            <a href="tel:+1 305-555-0142">
                                                <span class="o_force_ltr">+1 305-555-0142</span>
                                            </a>
                                        </span>
                                    </p>
                                </div>
                                <div class="col-lg-3 o_grid_item g-col-lg-3 g-height-2 offset-1 offset-lg-0 col-10 o_cc o_cc1 rounded pt16 pb16 o_colored_level" style="z-index: 3; grid-area: 1 / 7 / 3 / 10; --grid-item-padding-x: 30px; border-radius: 24px !important; --grid-item-padding-y: 30px;">
                                    <h6>Send us a message</h6>
                                    <p>
                                        <span class="h5-fs">
                                            <a href="mailto:info@scubasdiving.example.com">info@scubasdiving.example.com</a>
                                        </span>
                                    </p>
                                </div>
                                <div class="col-lg-3 o_grid_item g-col-lg-3 g-height-2 offset-1 offset-lg-0 col-10 o_cc o_cc1 rounded pt16 pb16 o_colored_level" style="z-index: 4; grid-area: 1 / 10 / 3 / 13; --grid-item-padding-x: 30px; --grid-item-padding-y: 30px; border-radius: 24px !important;">
                                    <div class="s_social_media text-start no_icon_color o_not_editable" data-snippet="s_social_media" data-name="Social Media">
                                        <h6 class="s_social_media_title d-block mb-2">Follow us</h6>
                                        <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank">
                                            <i class="fa fa-twitter fa-stack o_editable_media"/>
                                        </a>
                                        <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank">
                                            <i class="fa fa-linkedin fa-stack o_editable_media"/>
                                        </a>
                                        <a href="/website/social/instagram" class="s_social_media_instagram" target="_blank">
                                            <i class="fa fa-instagram fa-stack o_editable_media"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_grid_item g-col-lg-12 g-height-1 pt16 text-center text-lg-end o_colored_level col-lg-12" style="z-index: 7; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; grid-area: 3 / 1 / 4 / 13;">
                                    <ul class="list-inline mb-0" style="text-align: center;">
                                        <li class="list-inline-item">
                                            <a href="/">Home</a>
                                        </li>
                                        <li class="list-inline-item">•</li>
                                        <li class="list-inline-item">
                                            <a href="/event">Lessons</a>
                                        </li>
                                        <li class="list-inline-item">•</li>
                                        <li class="list-inline-item">
                                            <a href="/appointment">Book an experience</a>
                                        </li>
                                        <li class="list-inline-item">•</li>
                                        <li class="list-inline-item">
                                            <a href="/contactus">Contact us</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="appointment_banner_categories" model="ir.ui.view">
        <field name="name">Custom - Appointment banner</field>
        <!-- no <key>: it must differ from the inherited view's key -->
        <field name="inherit_id" ref="website_appointment.appointments_selection_layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_appointments_card_top']" position="inside">
                <section class="s_banner_categories o_cc o_cc5 o_colored_level parallax s_parallax_is_fixed s_parallax_no_overflow_hidden pb80 s_custom_snippet" style="background-position: 50% 75%;" data-snippet="s_banner_categories" data-scroll-background-ratio="1" data-name="Custom Banner Categories">
                    <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-resize-width="1920" data-mimetype="image/webp" style="background-image: url(&quot;/web/image/outdoor_activities.img_custom_image_20&quot;);" data-quality="100"/>
                    <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgb(0, 0, 0) 20%, rgba(0, 0, 0, 0.22) 100%);"/>
                    <div class="container">
                        <div class="o_grid_mode row" data-row-count="10" style="gap: 16px;">
                            <div data-name="Intro" class="o_grid_item o_colored_level justify-content-start g-col-lg-6 col-lg-6 g-height-5 o_we_padding_highlight" style="z-index: 1; grid-area: 2 / 4 / 7 / 10; --grid-item-padding-y: 52px;">
                                <h1 style="text-align: center;"><strong>Discover</strong> your<br/>new <strong>experience</strong></h1>
                                <p class="lead" style="text-align: center;"><strong>&#160;Book unforgettable diving experiences at sea : </strong>group dives, historical wrecks, and marine life encounters, all in one place.</p>
                            </div>
                            <div class="o_grid_item o_colored_level o_cc o_cc5 o_bg_img_center oe_img_bg justify-content-end offset-1 offset-lg-0 o_bg_img_origin_border_box rounded g-col-lg-4 g-height-4 col-lg-4 col-10" style="grid-area: 7 / 1 / 11 / 5; z-index: 2; background-image: url(&quot;/web/image/outdoor_activities.img_custom_image_26&quot;); --grid-item-padding-y: 32px; --grid-item-padding-x: 32px; --box-border-bottom-left-radius: 5px; --box-border-bottom-right-radius: 5px; --box-border-top-right-radius: 5px; --box-border-top-left-radius: 5px;" data-resize-width="1080" data-mimetype="image/webp">
                                <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgba(36, 36, 36, 0.52) 0%, rgba(255, 255, 255, 0) 50%);">
                                    <br/>
                                </div>
                                <h2 class="h3-fs" style="text-align: center;"><strong>Group</strong> experience&#160;</h2>
                            </div>
                            <div class="o_grid_item o_cc o_cc5 o_colored_level o_bg_img_center oe_img_bg justify-content-end offset-1 offset-lg-0 o_bg_img_origin_border_box rounded g-col-lg-4 g-height-4 col-lg-4 col-10" style="grid-area: 7 / 5 / 11 / 9; z-index: 4; background-image: url(&quot;/web/image/outdoor_activities.img_custom_image_27&quot;); --grid-item-padding-y: 32px; --grid-item-padding-x: 32px; --box-border-bottom-left-radius: 5px; --box-border-bottom-right-radius: 5px; --box-border-top-right-radius: 5px; --box-border-top-left-radius: 5px;" data-resize-width="1920" data-mimetype="image/webp">
                                <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgba(36, 36, 36, 0.52) 0%, rgba(255, 255, 255, 0) 50%);">
                                    <br/>
                                </div>
                                <h2 class="h3-fs" style="text-align: center;"><strong>Historical</strong> experience&#160;</h2>
                            </div>
                            <div class="o_grid_item o_cc o_cc5 o_bg_img_center oe_img_bg justify-content-end o_bg_img_origin_border_box rounded o_colored_level g-col-lg-4 g-height-4 col-lg-4 col-10 offset-1 offset-lg-0" style="grid-area: 7 / 9 / 11 / 13; z-index: 5; background-image: url(&quot;/web/image/outdoor_activities.img_custom_image_28&quot;); --grid-item-padding-y: 32px; --grid-item-padding-x: 32px; --box-border-bottom-left-radius: 5px; --box-border-bottom-right-radius: 5px; --box-border-top-right-radius: 5px; --box-border-top-left-radius: 5px;" data-resize-width="1920" data-mimetype="image/webp">
                                <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgba(36, 36, 36, 0.52) 0%, rgba(255, 255, 255, 0) 50%);">
                                    <br/>
                                </div>
                                <h2 class="h3-fs" style="text-align: center;"><strong>Animals</strong> experience&#160;</h2>
                            </div>
                        </div>
                    </div>
                </section>
            </xpath>
        </field>
    </record>
    <record id="appointment_topbar_title" model="ir.ui.view">
        <field name="name">Custom - Appointment topbar title</field>
        <!-- no <key>: it must differ from the inherited view's key -->
        <field name="inherit_id" ref="website_appointment.website_calendar_index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//h1" position="replace">
                <h1 class="h4 mb-0">Choose your next experience</h1>
            </xpath>
        </field>
    </record>
</odoo>
