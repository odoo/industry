<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.footer_copyright_company_name"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small">Copyright © SCUBAS DIVING</span>
            </xpath>
        </field>
    </record>
    <record id="template_footer_contact" model="ir.ui.view">
        <field name="name">Custom - Contact</field>
        <field name="key">website.template_footer_contact</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt32 pb0" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-3 offset-1 offset-lg-0 col-10 o_cc rounded pb16 o_colored_level o_cc1" style="border-radius: 24px !important;">
                                    <p>How can we help?</p>
                                    <p>
                                        <span class="h5-fs">
                                            <a href="/contactus">Contact us anytime</a>
                                        </span>
                                    </p>
                                </div>
                                <div class="col-lg-3 offset-1 offset-lg-0 col-10 o_cc o_cc1 rounded pb16 o_colored_level pt0" style="border-radius: 24px !important;">
                                    <p>Call us</p>
                                    <p>
                                        <span class="h5-fs">
                                            <a href="tel:+1 305-555-0142">&amp;nbsp;<span class="o_force_ltr">+1 305-555-0142</span>&amp;nbsp;</a></span>
                                    </p>
                                </div>
                                <div class="col-lg-3 offset-1 offset-lg-0 col-10 o_cc o_cc1 rounded pb16 o_colored_level pt0" style="border-radius: 24px !important;">
                                    <p>Send us a message</p>
                                    <p>
                                        <span class="h5-fs">
                                            <a href="mailto:info@scubasdiving.com">info@scubasdiving.com</a>
                                        </span>
                                    </p>
                                </div>
                                <div class="col-lg-3 offset-1 offset-lg-0 col-10 o_cc o_cc1 rounded pb16 o_colored_level pt0" style="border-radius: 24px !important;">
                                    <div class="s_social_media text-start no_icon_color o_not_editable" data-snippet="s_social_media" data-name="Social Media">
                                        <h6 class="s_social_media_title d-block mb-2">Follow us</h6>
                                        <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank">
                                            <i class="fa fa-twitter fa-stack o_editable_media"/>
                                        </a>
                                        <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank">
                                            <i class="fa fa-linkedin fa-stack o_editable_media"/>
                                        </a>
                                        <a href="/website/social/instagram" class="s_social_media_instagram" target="_blank">
                                            <i class="fa fa-instagram fa-stack o_editable_media"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="pt16 text-center text-lg-end o_colored_level col-lg-12">
                                    <ul class="list-inline mb-0" style="text-align: center;">
                                        <li class="list-inline-item">
                                            <a href="/">Home</a>
                                        </li>
                                        <li class="list-inline-item">•</li>
                                        <li class="list-inline-item">
                                            <a href="/event">Lessons</a>
                                        </li>
                                        <li class="list-inline-item">•</li>
                                        <li class="list-inline-item">
                                            <a href="/appointment">Book an experience</a>
                                        </li>
                                        <li class="list-inline-item">•</li>
                                        <li class="list-inline-item">
                                            <a href="/contactus">Contact us</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
