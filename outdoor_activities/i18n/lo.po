#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.welcome_article_body
msgid "<span class=\"h1-fs\">Basics</span>"
msgstr "<span class=\"h1-fs\">ພື້ນຖານ</span>"

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">\n"
"                                                <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"animation-duration: 0.5s; --wanim-intensity: "
"34;\">\n"
"                                                    <b>✦ Expert-Led "
"Underwater Adventures</b>\n"
"                                                    <span style=\"color: "
"rgba(255, 255, 255, 0.77);\">Our team consists of highly certified PADI and "
"SSI instructors who prioritize your safety and comfort. Whether you are a "
"first-timer or an advanced technical diver, we provide personalized guidance "
"and top-tier equipment to ensure every dive is seamless and unforgettable.</"
"span>\n"
"                                                </span>\n"
"                                            </span>"
msgstr ""
"<span class=\"h5-fs\">\n"
"                                                <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"animation-duration: 0.5s; --wanim-intensity: "
"34;\">\n"
"                                                    <b>✦ "
"ການຜະຈົນໄພໃຕ້ນ້ຳໂດຍຊ່ຽວຊານ</b>\n"
"                                                    <span style=\"color: "
"rgba(255, 255, 255, 0.77);\">ທີມງານຂອງພວກເຮົາປະກອບດ້ວຍຄູຝຶກທີ່ໄດ້ຮັບໃບຢັ້ງຢືນ PADI ແລະ "
"SSI ລະດັບສູງ ເຊິ່ງໃຫ້ຄວາມສຳຄັນກັບຄວາມປອດໄພ ແລະ ຄວາມສະດວກສະບາຍຂອງທ່ານເປັນຫຼັກ. "
"ບໍ່ວ່າທ່ານຈະເປັນຜູ້ເລີ່ມຕົ້ນ ຫຼື ນັກດຳນ້ຳເຕັກນິກລະດັບສູງ ພວກເຮົາກໍພ້ອມໃຫ້ຄຳແນະນຳຢ່າງໃກ້ຊິດ ແລະ "
"ອຸປະກອນຊັ້ນນຳ ເພື່ອໃຫ້ແນ່ໃຈວ່າທຸກໆການດຳນ້ຳຈະລາບລື່ນ ແລະ ເປັນທີ່ໜ້າປະທັບໃຈທີ່ສຸດ.</span>\n"
"                                                </span>\n"
"                                            </span>"

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">\n"
"                                                <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"animation-duration: 0.5s; animation-delay: "
"0.4s;\">\n"
"                                                    <b>\n"
"                                                        <span class=\"h5-"
"fs\">✦ Eco-Conscious and Sustainable Diving </span>\n"
"                                                    </b>\n"
"                                                    <span class=\"h5-fs\" "
"style=\"color: rgba(255, 255, 255, 0.77);\">We believe in protecting the "
"playground we love. By practicing \"Green Fins\" principles and organizing "
"regular reef clean-ups, we ensure that our operations have a minimal "
"environmental footprint, allowing you to explore the ocean’s wonders while "
"contributing to their long-term preservation.</span>\n"
"                                                </span>\n"
"                                            </span>"
msgstr ""
"<span class=\"h5-fs\">\n"
"                                                <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"animation-duration: 0.5s; animation-delay: "
"0.4s;\">\n"
"                                                    <b>\n"
"                                                        <span class=\"h5-"
"fs\">✦ ການດຳນ້ຳແບບໃສ່ໃຈສິ່ງແວດລ້ອມ ແລະ ຍືນຍົງ </span>\n"
"                                                    </b>\n"
"                                                    <span class=\"h5-fs\" "
"style=\"color: rgba(255, 255, 255, 0.77);"
"\">ພວກເຮົາເຊື່ອໝັ້ນໃນການປົກປ້ອງສະຖານທີ່ແຫ່ງທຳມະຊາດທີ່ພວກເຮົາຮັກ. ດ້ວຍການປະຕິບັດຕາມຫຼັກການ "
"\"Green Fins\" ແລະ ການຈັດກິດຈະກຳເກັບຂີ້ເຫຍື້ອຕາມແນວປະກາລັງເປັນປະຈຳ "
"ພວກເຮົາຈຶ່ງຮັບປະກັນວ່າການດຳເນີນງານຂອງພວກເຮົາຈະສົ່ງຜົນກະທົບຕໍ່ສິ່ງແວດລ້ອມໜ້ອຍທີ່ສຸດ "
"ຊ່ວຍໃຫ້ທ່ານສາມາດສຳຫຼວດຄວາມມະຫັດສະຈັນຂອງມະຫາສະໝຸດ ພ້ອມທັງມີສ່ວນຮ່ວມໃນການອະນຸລັກໄວ້ຢ່າງຍືນຍົງ.</"
"span>\n"
"                                                </span>\n"
"                                            </span>"

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">\n"
"                                                <span>\n"
"                                                    <span class=\"h5-fs\">\n"
"                                                        <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"--wanim-intensity: 34; animation-duration: "
"0.5s; animation-delay: 0.2s;\">\n"
"                                                            <b>✦ Access to "
"Exclusive, Pristine Sites</b>\n"
"                                                        </span>\n"
"                                                    </span>\n"
"                                                </span>\n"
"                                                <span style=\"color: "
"rgba(255, 255, 255, 0.77);\">\n"
"                                                    <span class=\"h5-fs\">\n"
"                                                        <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"--wanim-intensity: 34; animation-duration: "
"0.5s; animation-delay: 0.2s;\">We take you beyond the crowded tourist spots "
"to discover hidden gems and vibrant marine ecosystems. From untouched coral "
"reefs to mysterious deep-sea wrecks, our local knowledge grants you front-"
"row seats to the most breathtaking underwater biodiversity the region has to "
"offer.</span>\n"
"                                                    </span>\n"
"                                                </span>\n"
"                                            </span>"
msgstr ""
"<span class=\"h5-fs\">\n"
"                                                <span>\n"
"                                                    <span class=\"h5-fs\">\n"
"                                                        <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"--wanim-intensity: 34; animation-duration: "
"0.5s; animation-delay: 0.2s;\">\n"
"                                                            <b>✦ "
"ເຂົ້າເຖິງສະຖານທີ່ສະເພາະ ແລະ ສົມບູນແບບຕາມທຳມະຊາດ</b>\n"
"                                                        </span>\n"
"                                                    </span>\n"
"                                                </span>\n"
"                                                <span style=\"color: "
"rgba(255, 255, 255, 0.77);\">\n"
"                                                    <span class=\"h5-fs\">\n"
"                                                        <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"--wanim-intensity: 34; animation-duration: "
"0.5s; animation-delay: 0.2s;\">ພວກເຮົາຈະພາທ່ານຫຼີກລ່ຽງຈຸດທ່ອງທ່ຽວທີ່ແອອັດ "
"ເພື່ອຄົ້ນພົບສະຖານທີ່ທີ່ເຊື່ອງຊ້ອນ ແລະ ລະບົບນິເວດທາງທະເລທີ່ສົມບູນ. "
"ຕັ້ງແຕ່ແນວປະກາລັງທີ່ຍັງບໍ່ເຄີຍມີໃຜແຕະຕ້ອງ ໄປຈົນເຖິງຊາກກຳປັ່ນລຶກລັບໃຕ້ນ້ຳເລິກ "
"ຄວາມຊຳນານໃນພື້ນທີ່ຂອງພວກເຮົາຈະນຳພາທ່ານໄປສຳຜັດກັບຄວາມຫຼາກຫຼາຍທາງຊີວະພາບໃຕ້ນ້ຳທີ່ໜ້າຕື່ນຕາຕື່ນໃຈທີ່ສຸດໃນພາກພື້ນນີ້."
"</span>\n"
"                                                    </span>\n"
"                                                </span>\n"
"                                            </span>"

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">I have spent the better part of my life underwater, "
"and if there is one thing the ocean has taught me, it is that the world "
"looks very different when you stop to breathe beneath the surface. What "
"started as a personal fascination with the deep blue has evolved into a "
"mission to share that transformative experience with others.</span>"
msgstr ""
"<span class=\"h5-fs\">ຂ້ອຍໄດ້ໃຊ້ຊີວິດສ່ວນໃຫຍ່ຢູ່ໃຕ້ນ້ຳ, ແລະ ຖ້າມີສິ່ງໜຶ່ງທີ່ມະຫາສະໝຸດໄດ້ສອນຂ້ອຍ, "
"ນັ້ນກໍຄືໂລກເຮົາຈະເບິ່ງແຕກຕ່າງໄປຢ່າງສິ້ນເຊີງເມື່ອທ່ານໄດ້ຫາຍໃຈຢູ່ກ້ອງໜ້ານ້ຳ. "
"ສິ່ງທີ່ເລີ່ມຕົ້ນຈາກຄວາມຫຼົງໄຫຼສ່ວນຕົວໃນທ້ອງທະເລສີຄາມເລິກ "
"ໄດ້ກາຍມາເປັນພາລະກິດເພື່ອແບ່ງປັນປະສົບການອັນລ້ຳຄ່ານີ້ໃຫ້ກັບຄົນອື່ນໆ.</span>"

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">The ocean is calling. We can’t wait to show you what’s "
"waiting below.<br/><br/><strong>Your CEO Magnus</strong></span>"
msgstr ""
"<span class=\"h5-fs\">ມະຫາສະໝຸດກຳລັງຮຽກຮ້ອງ. "
"ພວກເຮົາຕື່ນເຕັ້ນຫຼາຍທີ່ຈະພາທ່ານໄປຊົມສິ່ງທີ່ລໍຖ້າຢູ່ຂ້າງລຸ່ມ.<br/><br/><strong>CEO ຂອງທ່ານ Magnus</"
"strong></span>"

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">When we founded this company, we didn't want to be "
"just another dive shop. We set out to create a sanctuary for explorers, a "
"place where the highest standards of technical safety meet the raw, "
"unbridled beauty of the marine world. For us, diving isn't just a sport or a "
"hobby; it is a profound way to reconnect with nature and realize our "
"responsibility to protect it.</span>"
msgstr ""
"<span class=\"h5-fs\">ຕອນທີ່ພວກເຮົາສ້າງຕັ້ງບໍລິສັດນີ້ຂຶ້ນມາ "
"ພວກເຮົາບໍ່ໄດ້ຢາກເປັນພຽງຮ້ານດຳນ້ຳທົ່ວໆໄປອີກແຫ່ງໜຶ່ງ. ພວກເຮົາຕັ້ງໃຈສ້າງບ່ອນພັກພິງສຳລັບນັກສຳຫຼວດ, "
"ສະຖານທີ່ທີ່ມາດຕະຖານຄວາມປອດໄພທາງເຕັກນິກລະດັບສູງສຸດ "
"ປະສານເຂົ້າກັບຄວາມງົດງາມຕາມທຳມະຊາດຂອງໂລກໃຕ້ນ້ຳ. ສຳລັບພວກເຮົາແລ້ວ ການດຳນ້ຳບໍ່ແມ່ນພຽງແຕ່ກິລາ ຫຼື "
"ວຽກອະດິເລກ; ແຕ່ມັນເປັນວິທີການເຊື່ອມຕໍ່ກັບທຳມະຊາດຢ່າງເລິກເຊິ່ງ ແລະ "
"ເຮັດໃຫ້ເຮົາຮັບຮູ້ເຖິງຄວາມຮັບຜິດຊອບໃນການປົກປ້ອງມັນ.</span>"

