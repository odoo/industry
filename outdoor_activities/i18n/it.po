#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">\n"
"                                                <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"animation-duration: 0.5s; --wanim-intensity: "
"34;\">\n"
"                                                    <b>✦ Expert-Led "
"Underwater Adventures</b>\n"
"                                                    <span style=\"color: "
"rgba(255, 255, 255, 0.77);\">Our team consists of highly certified PADI and "
"SSI instructors who prioritize your safety and comfort. Whether you are a "
"first-timer or an advanced technical diver, we provide personalized guidance "
"and top-tier equipment to ensure every dive is seamless and unforgettable.</"
"span>\n"
"                                                </span>\n"
"                                            </span>"
msgstr ""

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">\n"
"                                                <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"animation-duration: 0.5s; animation-delay: "
"0.4s;\">\n"
"                                                    <b>\n"
"                                                        <span class=\"h5-"
"fs\">✦ Eco-Conscious and Sustainable Diving </span>\n"
"                                                    </b>\n"
"                                                    <span class=\"h5-fs\" "
"style=\"color: rgba(255, 255, 255, 0.77);\">We believe in protecting the "
"playground we love. By practicing \"Green Fins\" principles and organizing "
"regular reef clean-ups, we ensure that our operations have a minimal "
"environmental footprint, allowing you to explore the ocean’s wonders while "
"contributing to their long-term preservation.</span>\n"
"                                                </span>\n"
"                                            </span>"
msgstr ""

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">\n"
"                                                <span>\n"
"                                                    <span class=\"h5-fs\">\n"
"                                                        <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"--wanim-intensity: 34; animation-duration: "
"0.5s; animation-delay: 0.2s;\">\n"
"                                                            <b>✦ Access to "
"Exclusive, Pristine Sites</b>\n"
"                                                        </span>\n"
"                                                    </span>\n"
"                                                </span>\n"
"                                                <span style=\"color: "
"rgba(255, 255, 255, 0.77);\">\n"
"                                                    <span class=\"h5-fs\">\n"
"                                                        <span "
"class=\"o_animated_text o_animate o_anim_fade_in o_anim_from_right "
"o_animate_both_scroll\" style=\"--wanim-intensity: 34; animation-duration: "
"0.5s; animation-delay: 0.2s;\">We take you beyond the crowded tourist spots "
"to discover hidden gems and vibrant marine ecosystems. From untouched coral "
"reefs to mysterious deep-sea wrecks, our local knowledge grants you front-"
"row seats to the most breathtaking underwater biodiversity the region has to "
"offer.</span>\n"
"                                                    </span>\n"
"                                                </span>\n"
"                                            </span>"
msgstr ""

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">I have spent the better part of my life underwater, "
"and if there is one thing the ocean has taught me, it is that the world "
"looks very different when you stop to breathe beneath the surface. What "
"started as a personal fascination with the deep blue has evolved into a "
"mission to share that transformative experience with others.</span>"
msgstr ""

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">The ocean is calling. We can’t wait to show you what’s "
"waiting below.<br/><br/><strong>Your CEO Magnus</strong></span>"
msgstr ""

#. module: outdoor_activities
#: model_terms:ir.ui.view,arch_db:outdoor_activities.view_page_home
msgid ""
"<span class=\"h5-fs\">When we founded this company, we didn't want to be "
"just another dive shop. We set out to create a sanctuary for explorers, a "
"place where the highest standards of technical safety meet the raw, "
"unbridled beauty of the marine world. For us, diving isn't just a sport or a "
"hobby; it is a profound way to reconnect with nature and realize our "
"responsibility to protect it.</span>"
msgstr ""

