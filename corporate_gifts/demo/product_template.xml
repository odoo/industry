    <record id="product_template_10" model="product.template">
        <field name="name">T-shirt B&amp;C</field>
        <field name="list_price">15.0</field>
        <field name="is_storable">True</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('product_public_category_2')])]"/>
        <field name="product_add_mode">matrix</field>
        <field name="sale_delay">7</field>
        <field name="website_sequence">10005</field>
        <field name="website_id" ref="website_industry"/>
        <field name="is_published" eval="True"/>
        <field name="image_1920" type="bytes" file="corporate_gifts/static/src/binary/product_template/10-image_1920.jpg"/>
        <field name="description_sale">Short-sleeved T-shirt
100% certified organic or in-conversion cotton</field>
        <field name="website_description">
        <![CDATA[
            <section class="s_text_image pt96 o_colored_level o_cc o_cc1 pb0" data-snippet="s_text_image" data-name="Text - Image" style="">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="pt16 pb16 o_colored_level col-lg-7" style="padding: 24px; border-color: rgb(70, 77, 83) !important; border-radius: 4px !important;">
                            <h2>FEATURES / STYLE &amp; FIT</h2>
                            <ul style="margin-bottom: 0px;">
                                <li>
                                    Stripped back to the essentials, this short-sleeved t-shirt is clean and minimalistic for any occasion.
                                </li>
                            </ul>
                            <ul style="margin-bottom: 0px;">
                                <li>Comfortable body length construction for a perfect retail look</li>
                                <li>Side seams ensure the best fit and a feminine silhouette</li>
                                <li>Cut in an easy, medium fit, it's the kind of tee you'll dress up and down</li>
                                <li>Thin collar rib for modern, up to date appearance</li>
                                <li>For long-lasting comfort, the neck seams are reinforced with soft binding.</li>
                            </ul>
                            <ul>
                                <li>Minimalist cut and detailing suitable for many uses and any end user requirements.<br /></li>
                            </ul>
                        </div>
                        <div class="pt16 offset-lg-1 o_colored_level col-lg-4 pb0">
                            <img
                                src="/web/image/corporate_gifts.img_corporate_gifts_image_13"
                                alt="Purple B&amp;C T-shirt"
                                class="img img-fluid mx-auto o_we_custom_image"
                                data-mimetype="image/jpeg"
                                data-resize-width="690"
                            />
                        </div>
                    </div>
                </div>
            </section>
            <section class="s_text_image pt32 pb32 o_colored_level o_cc o_cc2" data-snippet="s_image_text" data-name="Image - Text" style="">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="pt16 pb16 o_colored_level col-lg-7">
                            <img
                                src="/web/image/corporate_gifts.img_corporate_gifts_image_14"
                                alt="B&amp;C T-shirt collar with size chip and no brand label"
                                class="img img-fluid mx-auto o_we_custom_image"
                                data-mimetype="image/jpeg"
                                data-resize-width="690"
                            />
                        </div>
                        <div class="pt16 pb16 o_colored_level col-lg-5">
                            <h3>B&amp;C NO LABEL SOLUTION</h3>
                            <p><br /></p>
                            <p>Easy branding solution: no brand label located in the collar and a size chip only. For men and unisex styles, the size chip is black, while for women it is white.</p>
                        </div>
                    </div>
                </div>
            </section>
        ]]>
        </field>
    </record>
