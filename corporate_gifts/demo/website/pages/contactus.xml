<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">corporate_gifts.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="corporate_gifts.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{
                        'email_to': res_company.email,
                        'name': request.params.get('name', ''),
                        'phone': request.params.get('phone', ''),
                        'email_from': request.params.get('email_from', ''),
                        'company': request.params.get('company', ''),
                        'subject': request.params.get('subject', ''),
                        'contact_name': request.params.get('contact_name', ''),
                        'partner_name': request.params.get('partner_name', ''),
                        'description': request.params.get('description', ''),
                    }"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title o_colored_level oe_img_bg o_bg_img_center o_bg_img_origin_border_box o_bg_img_opt_repeat pt112 pb48" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="0" data-name="Title" style="background-size: 450px auto, cover; background-color: transparent; background-image: url(&quot;/web/image/corporate_gifts.img_corporate_gifts_image_10&quot;), linear-gradient(121deg, rgb(0, 99, 245) 0%, rgb(255, 255, 255) 63%, rgb(246, 229, 208) 100%);" data-format-mimetype="image/webp" data-resize-width="450" data-mimetype="image/webp">
                            <div class="container">
                                <h1 style="text-align: center;">
                                    Request a <span class="bg-o-color-2">Quote</span>
                                </h1>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level pt0 o_cc o_cc5 pb0" data-snippet="s_text_block" data-name="Text" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Patterns/04&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-1&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                            <div class="o_we_shape o_html_builder_Patterns_04" style="background-image: url(&quot;/html_editor/shape/html_builder%2FPatterns%2F04.svg?c5=%230063F5&quot;);"/>
                            <div class="s_allow_columns container-fluid">
                                <div class="row">
                                    <div class="mt-4 mt-lg-0 o_colored_level pt0 o_cc o_cc1 col-lg-8 order-lg-0" style="order: 1;">
                                        <div class="container o_text_columns o-contenteditable-false">
                                            <div class="row">
                                                <div class="o-contenteditable-true o_colored_level offset-lg-4 col-lg-7 col-12 pt72 pb72">
                                                    <h2>
                                                        <span class="h3-fs">Contact us</span>
                                                    </h2>
                                                    <p>about anything related to our company or services.</p>
                                                    <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                                        <div class="container">
                                                            <br/>
                                                            <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                                <div class="s_website_form_rows row s_col_no_bgcolor">
                                                                    <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 s_website_form_required col-lg-12 col-12" data-type="char">
                                                                        <label class="s_website_form_label" for="ouqcgm52j8zr" style="width: 200px;">
                                                                            <span class="s_website_form_label_content">Your Name</span>
                                                                            <span class="s_website_form_mark"> *</span>
                                                                        </label>
                                                                        <input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="" id="ouqcgm52j8zr" data-fill-with="name"/>
                                                                    </div>
                                                                    <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-12" data-type="tel">
                                                                        <label class="s_website_form_label" for="o7zt0aaxfq7s" style="width: 200px;">
                                                                            <span class="s_website_form_label_content">Phone Number</span>
                                                                        </label>
                                                                        <input class="form-control s_website_form_input" type="tel" name="phone" placeholder="" id="o7zt0aaxfq7s" data-fill-with="phone"/>
                                                                    </div>
                                                                    <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required col-lg-12" data-type="email">
                                                                        <label class="s_website_form_label" for="o5rzql5nk43t" style="width: 200px;">
                                                                            <span class="s_website_form_label_content">Your Email</span>
                                                                            <span class="s_website_form_mark"> *</span>
                                                                        </label>
                                                                        <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="o5rzql5nk43t" data-fill-with="email"/>
                                                                    </div>
                                                                    <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char">
                                                                        <label class="s_website_form_label" for="on3obxqdg8y" style="width: 200px;">
                                                                            <span class="s_website_form_label_content">Subject</span>
                                                                            <span class="s_website_form_mark"> *</span>
                                                                        </label>
                                                                        <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="on3obxqdg8y" data-fill-with="undefined"/>
                                                                    </div>
                                                                    <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="many2one">
                                                                        <label class="s_website_form_label" for="o3ax2foe4skm" style="width: 200px;">
                                                                            <span class="s_website_form_label_content">Promotional Product</span>
                                                                        </label>
                                                                        <select class="form-select s_website_form_input" name="Promotional Product" id="o3ax2foe4skm">
                                                                            <option id="o3ax2foe4skm0" value="T-shirt B&amp;C">T-shirt B&amp;C</option>
                                                                            <option id="o3ax2foe4skm1" value="Customized Keyring">Customized Keyring</option>
                                                                            <option id="o3ax2foe4skm2" value="Mug">Mug</option>
                                                                            <option id="o3ax2foe4skm3" value="Lighter">Lighter</option>
                                                                            <option id="o3ax2foe4skm4" value="USB Stick">USB Stick</option>
                                                                            <option id="o3ax2foe4skm5" value="Customized Hat">Customized Hat</option>
                                                                            <option id="o3ax2foe4skm6" value="Tote Bag">Tote Bag</option>
                                                                        </select>
                                                                    </div>
                                                                    <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom col-lg-12" data-type="integer">
                                                                        <label class="s_website_form_label" for="ov83u37x5ft" style="width: 200px;">
                                                                            <span class="s_website_form_label_content">Quantity</span>
                                                                        </label>
                                                                        <input type="number" class="form-control s_website_form_input" step="1" name="Quantity" value="" placeholder="" id="ov83u37x5ft" data-fill-with="undefined"/>
                                                                    </div>
                                                                    <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12" data-type="many2many">
                                                                        <label class="s_website_form_label" for="osinp1mz79g" style="width: 200px;">
                                                                            <span class="s_website_form_label_content">Customization</span>
                                                                        </label>
                                                                        <div class="row s_col_no_resize s_col_no_bgcolor s_website_form_multiple" data-name="tag_ids" data-display="vertical">
                                                                            <div class="checkbox col-12">
                                                                                <div class="form-check">
                                                                                    <input type="checkbox" class="s_website_form_input form-check-input" id="osinp1mz79g0" name="tag_ids" value="*pocket_printing_tag*" data-fill-with="undefined"/>
                                                                                    <label class="form-check-label s_website_form_check_label" for="osinp1mz79g0">Pocket Printing</label>
                                                                                </div>
                                                                            </div>
                                                                            <div class="checkbox col-12">
                                                                                <div class="form-check">
                                                                                    <input type="checkbox" class="s_website_form_input form-check-input" id="osinp1mz79g1" name="tag_ids" value="*back_printing_tag*"/>
                                                                                    <label class="form-check-label s_website_form_check_label" for="osinp1mz79g1">Back Printing</label>
                                                                                </div>
                                                                            </div>
                                                                            <div class="checkbox col-12">
                                                                                <div class="form-check">
                                                                                    <input type="checkbox" class="s_website_form_input form-check-input" id="osinp1mz79g2" name="tag_ids" value="*pocket_back_printing_tag*"/>
                                                                                    <label class="form-check-label s_website_form_check_label" for="osinp1mz79g2">Pocket + Back Printing</label>
                                                                                </div>
                                                                            </div>
                                                                            <div class="checkbox col-12">
                                                                                <div class="form-check">
                                                                                    <input type="checkbox" class="s_website_form_input form-check-input" id="osinp1mz79g3" name="tag_ids" value="*embroidery_tag*"/>
                                                                                    <label class="form-check-label s_website_form_check_label" for="osinp1mz79g3">Embroidery</label>
                                                                                </div>
                                                                            </div>
                                                                            <div class="checkbox col-12">
                                                                                <div class="form-check">
                                                                                    <input type="checkbox" class="s_website_form_input form-check-input" id="osinp1mz79g4" name="tag_ids" value="*other_tag*"/>
                                                                                    <label class="form-check-label s_website_form_check_label" for="osinp1mz79g4">Other</label>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="binary">
                                                                        <label class="s_website_form_label" for="oub6rknij6rk" style="width: 200px;">
                                                                            <span class="s_website_form_label_content">Your Logo</span>
                                                                        </label>
                                                                        <input type="file" class="form-control s_website_form_input" name="Your Logo" multiple="" id="oub6rknij6rk" data-max-files-number="2" data-max-file-size="1" data-fill-with="undefined"/>
                                                                        <span class="s_website_form_field_description small form-text text-muted">Max 2 files (1 MB each)</span>
                                                                    </div>
                                                                    <div data-visibility-condition="" data-visibility-between="" data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text">
                                                                        <label class="s_website_form_label" for="ogtcxn1ikayu" style="width: 200px;">
                                                                            <span class="s_website_form_label_content">Additional Information</span>
                                                                            <span class="s_website_form_mark"> *</span>
                                                                        </label>
                                                                        <textarea class="form-control s_website_form_input" name="description" placeholder="" id="ogtcxn1ikayu" rows="6" required=""/>
                                                                    </div>
                                                                    <div class="s_website_form_field mb-3 col-12        s_website_form_dnone" data-name="Field">
                                                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                            <label class="col-form-label col-sm-auto s_website_form_label " style="width: 200px">
                                                                                <span class="s_website_form_label_content"/>
                                                                                <br/>
                                                                            </label>
                                                                            <div class="col-sm">
                                                                                <input type="hidden" class="form-control s_website_form_input" name="team_id" value="*sales_team_team_sales_department*"/>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="s_website_form_field mb-3 col-12        s_website_form_dnone" data-name="Field">
                                                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                            <label class="col-form-label col-sm-auto s_website_form_label " style="width: 200px">
                                                                                <span class="s_website_form_label_content"/>
                                                                                <br/>
                                                                            </label>
                                                                            <div class="col-sm">
                                                                                <input type="hidden" class="form-control s_website_form_input" name="user_id" value="*base_user_admin*"/>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                                        <div style="width: 200px;" class="s_website_form_label">
                                                                            <br/>
                                                                        </div>
                                                                        <a href="#" role="button" class="btn btn-primary btn-lg s_website_form_send">Submit</a>
                                                                        <span id="s_website_form_result"/>
                                                                    </div>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </section>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-4 mt-lg-0 o_colored_level col-lg-4 border order-lg-0 pb32 pt48" style="--box-border-left-width: 30px; --box-border-bottom-width: 0px; --box-border-right-width: 30px; --box-border-top-width: 0px; border-color: rgba(255, 255, 255, 0) !important; order: 0;">
                                        <h2>
                                            <span class="h6-fs">MARKD</span>
                                        </h2>
                                        <ul class="list-unstyled mb-0 ps-2">
                                            <li class="text-white">
                                                <i class="oi oi-filled oi-fw me-2 text-o-color-1" data-icon="location_on"/>
                                                <span class="o_force_ltr">3575 Fake Buena Vista Avenue</span>
                                            </li>
                                            <li>
                                                <i class="oi oi-filled oi-fw me-2 text-o-color-1" data-icon="phone"/>
                                                <span class="o_force_ltr text-white">+1 555-555-5556</span>
                                            </li>
                                            <li>
                                                <i class="oi oi-filled oi-fw me-2 text-o-color-1" data-icon="mail"/>
                                                <span class="text-white">hello@markd.example.com</span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value eval="[ref('view_page_contactus')]"/>
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('corporate_gifts.view_page_contactus').arch.replace(
        '*pocket_printing_tag*', str(obj().env.ref('corporate_gifts.crm_tag_2').id)).replace(
        '*back_printing_tag*', str(obj().env.ref('corporate_gifts.crm_tag_3').id)).replace(
        '*pocket_back_printing_tag*', str(obj().env.ref('corporate_gifts.crm_tag_4').id)).replace(
        '*embroidery_tag*', str(obj().env.ref('corporate_gifts.crm_tag_5').id)).replace(
        '*other_tag*', str(obj().env.ref('sales_team.categ_oppor8').id)).replace(
        '*sales_team_team_sales_department*', str(obj().env.ref('sales_team.team_sales_department').id)).replace(
        '*base_user_admin*', str(obj().env.ref('base.user_admin').id))
        }"/>
    </function>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
