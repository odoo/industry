<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_sale_product_comment" model="ir.ui.view">
        <field name="name">Markd - Discussion and Rating</field>
        <field name="key">website_sale.product_comment</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <data name="Discussion and Rating">
                <xpath expr="//div[@t-field='product.website_description']" position="after">
                    <div class="o_shop_discussion_rating border-top" data-anchor="true">
                        <section id="o_product_page_reviews" class="container pt48 pb48" data-anchor="true">
                            <div class="mb-4">
                                <h2><span class="h3-fs">Reviews</span></h2>
                            </div>
                            <div>
                                <t t-call="portal.message_thread" object="product" display_rating="True" hide_header="True" message_per_page="5" two_columns="True"/>
                            </div>
                        </section>
                    </div>
                </xpath>
            </data>
        </field>
    </record>
    <record id="website_sale_extra_info" model="ir.ui.view">
        <field name="name">Markd - Checkout Extra Info</field>
        <field name="key">website_sale.extra_info</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Checkout Extra Info" t-name="website_sale.extra_info">
                <t t-set="oe_structure">
                    <!-- This is the drag-and-drop area for website building blocs at the end of each
                         checkout page. This is append at the of the page in `checkout_layout`. The
                         templates created in the database to store blocs are hooked using XPath on the
                         `oe_struture` element ID. Therefore, we can't use dynamic IDs (like with
                         t-att-id) and each template needs to define a div element. -->
                    <div class="oe_structure" id="oe_structure_website_sale_extra_info_1"/>
                </t>
                <t t-call="website_sale.checkout_layout" redirect.f="/shop/extra_info" oe_structure="oe_structure">
                    <h4 class="mb-3">Extra info</h4>
                    <section class="s_website_form o_colored_level" data-vcss="001" data-snippet="s_website_form">
                        <div class="container">
                            <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required s_website_form_no_recaptcha" data-mark="*" data-force_action="shop.sale.order" data-model_name="sale.order" data-success-mode="redirect" data-success-page="/shop/payment" hide-change-model="true">
                                <div class="s_website_form_rows s_col_no_bgcolor row">
                                    <span id="s_website_form_result"/>
                                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="binary"><label class="s_website_form_label" for="sale3" style="width: 200px;"><span class="s_website_form_label_content">Your logo</span></label><input type="file" class="form-control s_website_form_input" name="Your logo" id="sale3" data-max-files-number="1" data-max-file-size="3" accept="image/*,application/*"/><span class="s_website_form_field_description small form-text text-muted">Accepted formats: .png, .jpg, .svg, .ai, .eps, .pdf. Max size: 3 MB</span></div>
                                    <div class="s_website_form_field s_website_form_custom col-12 pb-2 mb-0" data-type="text" data-name="Field">
                                        <div class="s_col_no_resize s_col_no_bgcolor">
                                            <label class="s_website_form_label col-form-label col-sm-auto" style="width: 200px" for="sale2">
                                                <span class="s_website_form_label_content">Optional message</span>
                                            </label>
                                            <div class="col-sm">
                                                <textarea id="sale2" class="s_website_form_input form-control" name="Optional message" rows="4"/>
                                            </div>
                                            <br/></div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="website_sale_product_wishlist" model="ir.ui.view">
        <field name="name">Markd - Wishlist Page</field>
        <field name="key">corporate_gifts.product_wishlist</field>
        <field name="inherit_id" ref="website_sale.product_wishlist"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_website_sale_wishlist_product_wishlist_1']" position="replace">
                <div class="oe_structure" id="oe_structure_website_sale_wishlist_product_wishlist_1">
                    <div class="s_hr pt32 o_colored_level pb0" data-snippet="s_hr" data-name="Separator">
                        <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('o_wishlist_products_header')]/h1" position="replace">
                <h1 class="h4-fs mb-0"><span class="h3-fs">My Wishlist</span></h1>
                <div class="s_hr pt32 o_colored_level pb16" data-snippet="s_hr" data-name="Separator">
                    <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
