<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Markd - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <data name="Header Call to Action">
                <xpath expr="." position="inside">
                    <li t-attf-class="#{_item_class}">
                        <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                            <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                                <div class="container">
                                    <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta">Contact us</a>
                                </div>
                            </section>
                        </div>
                    </li>
                </xpath>
            </data>
        </field>
    </record>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Markd - Footer</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pb32 pt56" data-snippet="s_text_block" data-name="Container" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Patterns/04&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-1&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                        <div class="o_we_shape o_html_builder_Patterns_04" style="background-image: url(&quot;/html_editor/shape/html_builder%2FPatterns%2F04.svg?c5=%230063F5&quot;);"/>
                        <div class="container-fluid">
                            <div class="row">
                                <div class="o_colored_level pt0 pb0 border col-12 col-lg-2 order-lg-0" style="--box-border-left-width: 30px; --box-border-bottom-width: 0px; --box-border-right-width: 30px; --box-border-top-width: 0px; border-color: rgba(255, 255, 255, 0) !important; order: 0;">
                                    <p><img src="/web/image/corporate_gifts.img_corporate_gifts_image_11" alt="Markd logo" class="img img-fluid o_we_custom_image mx-auto d-block" loading="lazy"/></p>
                                </div>
                                <div class="o_colored_level pt0 col-12 pb40 offset-lg-1 order-lg-0 col-lg-4" style="text-align: center; order: 1;"><a href="__EXPORT_SLUG_XMLID__corporate_gifts.product_public_category_3__EXPORT_SLUG_XMLID__" class="o_translate_inline"><span class="text-white">Apparel</span></a>&amp;nbsp; &amp;nbsp;•&amp;nbsp; &amp;nbsp;<a class="o_translate_inline" href="__EXPORT_SLUG_XMLID__corporate_gifts.product_public_category_6__EXPORT_SLUG_XMLID__"><span class="text-white">Office</span></a>&amp;nbsp; &amp;nbsp;•&amp;nbsp; &amp;nbsp;<a href="__EXPORT_SLUG_XMLID__corporate_gifts.product_public_category_1__EXPORT_SLUG_XMLID__" class="o_translate_inline"><span class="text-white">Gifts</span></a>&amp;nbsp; &amp;nbsp;•&amp;nbsp; &amp;nbsp;<a href="/our-services" class="o_translate_inline"><span class="text-white">Services</span></a></div>
                                <div class="o_colored_level col-lg-2 pb0 pt0 col-5 order-lg-0" style="order: 2;">
                                    <div class="s_social_media o_not_editable no_icon_color text-end" data-snippet="s_social_media" data-name="Social Media">
                                        <h4 class="s_social_media_title d-none">Social Media</h4>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i data-icon="oi_facebook" class="oi o_editable_media small_social_icon oi-stack o_sm_custom_size" style="--oi-icon-size: 3.4375rem;"/>
                                        </a>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank" aria-label="Instagram">
                                            <i data-icon="oi_instagram" class="oi o_editable_media small_social_icon oi-stack o_sm_custom_size" style="--oi-icon-size: 3.4375rem;"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_colored_level pb0 pt0 border col-7 order-lg-0 col-lg-3" style="--box-border-left-width: 30px; --box-border-bottom-width: 0px; --box-border-right-width: 30px; --box-border-top-width: 0px; border-color: rgba(255, 255, 255, 0) !important; order: 3;">
                                    <p style="text-align: end;"><a href="/contactus" class="o_translate_inline btn btn-primary">Contact us</a></p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
