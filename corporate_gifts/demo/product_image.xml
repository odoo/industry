<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <!-- The main image (light grey) becomes an extra image without attribute
         value on creation: restrict it to the light grey variants before the
         other images are created, as their creation recomputes which extra
         images each variant shows. -->
    <function model="product.image" name="write">
        <value model="product.image" search="[('product_tmpl_id', '=', ref('product_template_10')), ('has_attribute_value', '=', False)]"/>
        <value model="product.template.attribute.value" eval="{'attribute_value_ids': [(6, 0, obj().search([
            ('attribute_line_id', '=', ref('product_template_attribute_line_6')),
            ('product_attribute_value_id', '=', ref('product_attribute_value_5')),
        ]).ids)]}"/>
    </function>
    <record id="product_image_27" model="product.image">
        <field name="name">T-shirt B&amp;C - Light Grey</field>
        <field name="product_tmpl_id" ref="product_template_10"/>
        <field name="attribute_value_ids" model="product.template.attribute.value" eval="obj().search([
            ('attribute_line_id', '=', ref('product_template_attribute_line_6')),
            ('product_attribute_value_id', '=', ref('product_attribute_value_5')),
        ])"/>
        <field name="sequence" eval="1"/>
        <field name="image_1920" type="bytes" file="corporate_gifts/static/src/binary/product_image/27-image_1920.jpg"/>
    </record>
