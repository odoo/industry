#. module: corporate_gifts
#: model_terms:ir.ui.view,arch_db:corporate_gifts.view_page_home
msgid ""
"\"Our onboarding kits arrived on time and the embroidery on the hats looks "
"premium. New hires keep posting them online!\""
msgstr ""
"\"Nossos kits de boas-vindas chegaram no prazo e o bordado nos bonés parece "
"premium. Novos contratados continuam postando sobre eles online!\""

#. module: corporate_gifts
#: model_terms:ir.ui.view,arch_db:corporate_gifts.view_page_home
msgid ""
"\"Shipping gifts to 60 home addresses sounded like a nightmare. Markd "
"handled the whole list, and every package arrived in time for the holidays.\""
msgstr ""
"\"Enviar presentes para 60 endereços residenciais parecia um pesadelo. A "
"Markd lidou com toda a lista e cada pacote chegou a tempo para as festas.\""

#. module: corporate_gifts
#: model_terms:ir.ui.view,arch_db:corporate_gifts.view_page_home
msgid ""
"\"We ordered branded USB sticks and tote bags for our conference. The mockup "
"came within a day and the final print matched it perfectly.\""
msgstr ""
"\"Encomendamos pen drives e ecobags personalizados para nossa conferência. O "
"protótipo chegou em um dia e a impressão final ficou perfeita.\""

