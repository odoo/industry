msgstr "Cabana Horizon"

#. module: holiday_house
#: model:product.template,website_meta_title:holiday_house.product_template_17
msgid "The Horizon Cabin - Luxury Cabin with Panoramic View | Wood Haven"
msgstr "The Horizon Cabin – cabană luxoasă cu vedere panoramică | Wood Haven"

#. module: holiday_house
#: model_terms:ir.ui.view,arch_db:holiday_house.welcome_article_body
