#. module: holiday_house
#: model_terms:ir.ui.view,arch_db:holiday_house.view_page_activities
msgid ""
"<span class=\"text-o-color-2\">The great lake of Wood Haven is your endless "
"playground. Glide across the calm morning waters on a kayak or paddleboard, "
"or get your adrenaline pumping at the helm of a jet ski carving through the "
"waves. From an invigorating swim off our natural beach to boat rides under "
"the golden evening light, experience the vastness of the lake in all its "
"forms.</span>\n"
"                                            <br/>"
msgstr ""
"<span class=\"text-o-color-2\">El gran lago de Wood Haven es tu espacio de "
"recreación sin límites. Navega por sus tranquilas aguas matutinas en kayak o "
"en una tabla de paddle surf, o siente la adrenalina al tomar el control de "
"una moto acuática y surcar las olas. Desde un refrescante baño en nuestra "
"playa natural hasta paseos en barco bajo la luz dorada del atardecer, "
"descubre el lago en todas sus facetas.</span>\n"
"                                            <br/>"

