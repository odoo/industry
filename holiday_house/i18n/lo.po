"o-color-5\">ນ </font>\n"
"            <strong>\n"
"                <font class=\"text-o-color-5\">ແອັບບັນຊີ</font>\n"
"            </strong>\n"
"            <font class=\"text-o-color-5\">.</font>"

#. module: holiday_house
