msgid ""
"<span class=\"h4-fs\">From carefully selected vintage wines to the authentic "
"treasures of our surrounding terroir, dining at Wood Haven is about more "
"than just food. It’s about creating the right atmosphere for the right "
"moment. You might desire a refined gastronomic evening by the crackling "
"fire, or prefer a relaxed drink on the terrace while watching the sun set "
"over the calm waters of the lake.</span>\n"
"                                            <br/>"
msgstr ""

#. module: holiday_house
#: model_terms:ir.ui.view,arch_db:holiday_house.view_page_activities
