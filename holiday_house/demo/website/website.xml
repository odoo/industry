<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="website_industry" model="website" context="{'foreign_record_to_create': True}">
        <field name="name">Wood Haven</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="user_id" ref="base.public_user"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="logo" type="bytes" file="holiday_house/static/src/img/content/website/logo.svg"/>
        <field name="favicon" type="bytes" file="holiday_house/static/description/favicon.png"/>
        <field name="show_line_subtotals_tax_selection">tax_included</field>
        <field name="cart_recovery_mail_template_id" eval="False"/>
        <field name="shop_ppr">3</field>
        <field name="shop_page_container">fluid</field>
        <field name="shop_gap">15px</field>
        <field name="shop_opt_products_design_classes">o_wsale_products_opt_thumb_cover o_wsale_products_opt_layout_catalog o_wsale_products_opt_design_bento o_wsale_products_opt_rounded_0 o_wsale_products_opt_name_weight_bold o_wsale_products_opt_name_color_regular o_wsale_products_opt_img_hover_zoom_in_light o_wsale_products_opt_actions_subtle o_wsale_products_opt_wishlist_fixed o_wsale_products_opt_actions_onhover o_wsale_products_opt_img_secondary_show o_wsale_products_opt_has_description o_wsale_products_opt_hover_show_description o_wsale_products_opt_cc o_wsale_products_opt_cc1 o_wsale_products_opt_overlay_opacity_4</field>
        <field name="product_page_container">fluid</field>
        <field name="product_page_image_layout">grid</field>
        <field name="product_page_image_width">100_pc</field>
        <field name="product_page_image_spacing">medium</field>
        <field name="product_page_image_ratio">4_3</field>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[('name', '=', 'default_website'), ('module', '=', 'base'), ('model', '=', 'website')]"/>
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
</odoo>
