<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_sale_products_oe_structure_website_sale_products_1" model="ir.ui.view">
        <field name="name">Custom - Products (oe_structure_website_sale_products_1)</field>
        <field name="key">website_sale.products_oe_structure_website_sale_products_1</field>
        <field name="inherit_id" ref="website_sale.products"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_sale_products_1']" position="replace">
                <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_products_1" data-editor-message-default="true" data-editor-message="DROP BUILDING BLOCKS HERE">
                    <section class="s_hero_about o_cc o_colored_level s_custom_snippet o_cc2 pb0 pt56" data-snippet="s_hero_about" data-name="Hero About">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="o_colored_level pt0 pb0 col-lg-8 offset-lg-2">
                                    <p style="text-align: center;">
                                        <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom text-o-color-1" style="--wanim-intensity: 15; animation-duration: 0.8s;">The cabins</span>
                                    </p>
                                    <h1 style="text-align: center;">
                                        <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 10; animation-delay: 0.2s; animation-duration: 0.8s;">Stay with us</span>
                                    </h1>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="custom_product_name" model="ir.ui.view">
        <field name="name">Custom - custom_product_name</field>
        <field name="key">holiday_house.custom_product_name</field>
        <field name="inherit_id" ref="website_sale.products"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[hasclass('h4-fs')]" position="replace">
                <h1>The cabins</h1>
            </xpath>
        </field>
    </record>
</odoo>
