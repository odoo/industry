<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pb0 pt72 parallax" data-snippet="s_text_block" data-name="Container" data-format-mimetype="image/webp" data-scroll-background-ratio="3">
                        <span class="s_parallax_bg_wrap">
                            <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/holiday_house.img_holiday_house_image_31&quot;); background-size: cover;" data-resize-width="1512" data-mimetype="image/webp"/>
                        </span>
                        <div class="o_we_bg_filter" style="background-color: rgba(225, 227, 222, 0.89);"/>
                        <div class="container-fluid">
                            <div class="row">
                                <div class="pt24 pb24 o_colored_level col-lg-2 offset-lg-0 offset-2 col-8 order-lg-0" data-scroll-background-ratio="0" style="order: 0;">
                                    <p>
                                        <a href="/" class="mx-auto">
                                            <img src="/web/image/holiday_house.img_holiday_house_image_32" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id mx-auto d-block" loading="lazy"/>
                                        </a>
                                    </p>
                                </div>
                                <div class="pt24 pb24 o_colored_level offset-lg-1 col-lg-3 col-12 order-lg-0" data-scroll-background-ratio="0" style="order: 1;">
                                    <div>
                                        <p class="lead">SITEMAP</p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="/shop" class="o_translate_inline">Stay</a>
                                            </span>
                                            <br/>
                                        </p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="/wellness" class="o_translate_inline">Spa &amp;amp; Wellness</a>
                                            </span>
                                            <br/>
                                        </p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="/restaurant" class="o_translate_inline">Eat &amp;amp; Drink</a>
                                            </span>
                                            <br/>
                                        </p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="/activities" class="o_translate_inline">Activities</a>
                                            </span>
                                            <br/>
                                        </p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="/contactus" class="o_translate_inline">Contact</a>
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="pt24 pb24 o_colored_level col-lg-3 col-12 order-lg-0" data-scroll-background-ratio="0" style="order: 2;">
                                    <div>
                                        <p class="lead">
                                            <span class="h6-fs">CONTACT</span>
                                        </p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="mailto:info@woodhaven.ca" class="o_translate_inline">info@woodhaven.ca</a>
                                            </span>
                                        </p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="tel:+1(555)010-0147" class="o_translate_inline">+1 (555) 010-0147</a>
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="pt24 pb24 o_colored_level col-lg-3 order-lg-0" data-scroll-background-ratio="0" style="order: 3;">
                                    <div>
                                        <p class="lead">
                                            <span class="h6-fs">SOCIALS</span>
                                        </p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="#" class="o_translate_inline">Instagram</a>
                                            </span>
                                        </p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="#" class="o_translate_inline">Facebook</a>
                                            </span>
                                            <br/>
                                        </p>
                                        <p>
                                            <span class="h5-fs">
                                                <a href="#" class="o_translate_inline">Youtube</a>
                                            </span>
                                            <br/>
                                        </p>
                                    </div>
                                </div>
                                <div class="pb24 o_colored_level col-lg-12 pt0 order-lg-0" data-scroll-background-ratio="0" style="order: 4;">
                                    <div>
                                        <div class="s_hr pb64 pt16" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" style="border-top-color: rgba(7, 13, 7, 0.1);"/>
                                        </div>
                                        <p class="lead">
                                            <span class="h6-fs text-o-color-3">
                                                <img src="/web/image/holiday_house.img_holiday_house_image_33" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id w-100" loading="lazy"/>
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="pt24 pb24 o_colored_level col-lg-6 order-lg-0" data-scroll-background-ratio="0" style="order: 6;">
                                    <div>
                                        <p class="lead">
                                            <span class="h6-fs">© Copyright 2026 Wood Haven Resort &amp;amp; Spa</span>
                                        </p>
                                    </div>
                                </div>
                                <div class="pt24 pb24 col-lg-6 o_colored_level col-12 order-lg-0" data-scroll-background-ratio="0" style="order: 5;">
                                    <div>
                                        <p style="text-align: end;">
                                            <a href="#" class="o_translate_inline">Privacy Policy</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
