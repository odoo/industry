<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">hair_salon.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="hair_salon.page_contactus">
                <t t-call="website.layout">
                    <t t-set="logged_partner" t-value="request.env['ir.http']._get_visitor_from_request().partner_id"/>
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email,'name': request.params.get('name', ''),'phone': request.params.get('phone', ''),'email_from': request.params.get('email_from', ''),'company': request.params.get('company', ''),'subject': request.params.get('subject', ''),}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_contact_info pt48 o_cc o_cc1 o_colored_level pb48" data-snippet="s_contact_info" data-name="Contact Info">
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="12" style="row-gap: 10px;">
                                    <div class="o_grid_item offset-1 order-lg-0 o_colored_level g-col-lg-5 col-lg-5 g-height-7 col-10" style="order: 2; --grid-item-padding-x: 0px; --grid-item-padding-y: 24px; grid-area: 1 / 1 / 8 / 6; z-index: 1;" data-name="Title block">
                                        <h1>
                                            <span class="display-2-fs text-gradient" style="background-image: linear-gradient(135deg, rgba(41, 61, 41, 0.64) 0%, rgba(47, 76, 41, 0.23) 100%);">
                                                <strong>Contact</strong>
                                            </span>
                                            <br/>
                                        </h1>
                                        <p class="lead"><br/>We would be delighted to hear from you. Whether you have a question, wish to book an appointment, or need personalized assistance, our team is at your service and will respond promptly.</p>
                                    </div>
                                    <div class="o_grid_item offset-1 order-lg-0 o_colored_level o_cc o_cc4 g-col-lg-5 rounded g-height-2 col-lg-5 col-10" style="order: 3; --grid-item-padding-y: 16px; grid-area: 7 / 1 / 9 / 6; z-index: 2; --box-border-bottom-left-radius: 10px; --box-border-bottom-right-radius: 10px; --box-border-top-right-radius: 10px; --box-border-top-left-radius: 10px; --grid-item-padding-x: 16px;" data-name="Info block">
                                        <h2 class="h5-fs">
                                            <i class="fa fa-fw fa-envelope-o" role="presentation"/> Email </h2>
                                        <p> &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;<a class="o_translate_inline" href="mailto:hello@lurastic.com" title="Send an email">
                                                <span class="text-o-color-4">hello@lurastic.com</span>
                                            </a>
                                        </p>
                                    </div>
                                    <div class="o_grid_item offset-1 order-lg-0 o_colored_level o_cc o_cc4 g-col-lg-5 rounded g-height-2 col-lg-5 col-10" style="order: 4; --grid-item-padding-y: 16px; grid-area: 9 / 1 / 11 / 6; z-index: 3; --box-border-bottom-left-radius: 10px; --box-border-bottom-right-radius: 10px; --box-border-top-right-radius: 10px; --box-border-top-left-radius: 10px; --grid-item-padding-x: 16px;" data-name="Info block">
                                        <h2 class="h5-fs">
                                            <i class="fa fa-fw fa-phone" role="presentation"/> Phone </h2>
                                        <p> &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;<a class="o_translate_inline" href="tel:+33678436621" title="Call Customer Service">
                                                <span class="text-o-color-4">+33 6 78 43 66 21</span>
                                            </a>
                                        </p>
                                    </div>
                                    <div class="o_grid_item offset-1 order-lg-0 o_colored_level g-col-lg-5 o_cc o_cc4 rounded g-height-2 col-lg-5 col-10" style="order: 5; --grid-item-padding-y: 16px; grid-area: 11 / 1 / 13 / 6; z-index: 4; --grid-item-padding-x: 16px; --box-border-bottom-left-radius: 10px; --box-border-bottom-right-radius: 10px; --box-border-top-right-radius: 10px; --box-border-top-left-radius: 10px;" data-name="Info block">
                                        <h2 class="h5-fs">
                                            <i class="fa fa-fw fa-building-o" role="presentation"/> Office </h2>
                                        <p>&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;18 Rue Georges Clemenceau, 83990 Saint-Tropez</p>
                                    </div>
                                    <div class="o_grid_item o_grid_item_image g-col-lg-6 offset-1 order-lg-0 o_colored_level g-height-12 col-lg-6 col-10" style="order: 1; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px; grid-area: 1 / 7 / 13 / 13; z-index: 5;" data-name="Image block">
                                        <img src="/web/image/hair_salon.img_custom_hair_image_02" alt="" class="img img-fluid rounded o_we_custom_image o_editable_media" data-format-mimetype="image/png" data-resize-width="1920" data-mimetype="image/png" loading="lazy"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_title_form o_cc pb48 o_colored_level o_cc4 pt120" data-snippet="s_title_form" data-name="Title - Form" style="position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/05&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}">
                            <div class="o_we_shape o_html_builder_Connections_05" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F05.svg?c5=%23FFFFFF&amp;flip=y&quot;); background-position: 50% 0%;"/>
                            <div class="o_container_small">
                                <h2 style="text-align: center;">
                                    <strong>Ask your question.<br/><br/></strong>
                                </h2>
                                <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                    <div class="container-fluid">
                                        <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="mail.mail" data-success-mode="message" data-success-page="/contactus-thank-you">
                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                                                            <span class="s_website_form_label_content"/>
                                                            <br/>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input type="hidden" class="form-control s_website_form_input" name="email_to" value="info@yourcompany.example.com"/>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-12 s_website_form_custom s_website_form_required" data-type="char" data-translated-name="Your Name">
                                                    <label class="s_website_form_label" style="width: 200px" for="o3ablxsdu9fl">
                                                        <span class="s_website_form_label_content">Your Name</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="text" name="name" required="" placeholder="" id="o3ablxsdu9fl" data-fill-with="name"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-12 s_website_form_custom" data-type="tel" data-translated-name="Phone Number">
                                                    <label class="s_website_form_label" style="width: 200px" for="onvt5mtrjyt">
                                                        <span class="s_website_form_label_content">Phone Number</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="tel" name="phone" value="" placeholder="" id="onvt5mtrjyt" data-fill-with="phone"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="email" data-translated-name="Your Email">
                                                    <label class="s_website_form_label" style="width: 200px" for="ojomkjlbtt3">
                                                        <span class="s_website_form_label_content">Your Email</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="email" name="email_from" required="" value="" placeholder="" id="ojomkjlbtt3" data-fill-with="email"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="char" data-translated-name="Your Company">
                                                    <label class="s_website_form_label" style="width: 200px" for="o07l95j4mvqk">
                                                        <span class="s_website_form_label_content">Your Company</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="text" name="company" value="" placeholder="" id="o07l95j4mvqk" data-fill-with="commercial_company_name"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject">
                                                    <label class="s_website_form_label" style="width: 200px" for="otrqa3g1cvum">
                                                        <span class="s_website_form_label_content">Subject</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="text" name="subject" required="" value="" placeholder="" id="otrqa3g1cvum" data-fill-with="undefined"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="text" data-translated-name="Your Question">
                                                    <label class="s_website_form_label" style="width: 200px" for="ovhe17rdk99e">
                                                        <span class="s_website_form_label_content">Your Question</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="ovhe17rdk99e" rows="3"/>
                                                </div>
                                                <div class="mb-0 py-2 col-12 s_website_form_submit text-end s_website_form_no_submit_label" data-name="Submit Button">
                                                    <div style="width: 200px;" class="s_website_form_label">
                                                        <br/>
                                                    </div>
                                                    <span id="s_website_form_result"/>
                                                    <a href="#" role="button" class="s_website_form_send o_translate_inline btn btn-secondary">Submit</a>
                                                </div>
                                            </div>
                                        </form><div class="s_website_form_end_message d-none"><div class="oe_structure"><section class="s_text_block o_colored_level rounded px-5 text-center" data-snippet="s_text_block"><i class="fa fa-paper-plane fa-2x mb-3 rounded-circle text-bg-success" role="img" aria-hidden="true" title="Success"/><h1 class="fw-bolder">Thank you for your question!</h1><p class="lead mb-0">Our team will message you back as soon as possible.</p></section></div></div>
                                    </div>
                                </section>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
