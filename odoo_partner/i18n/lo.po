#. module: odoo_partner
#: model:sale.order.template.line,name:odoo_partner.sale_order_template_line_19
msgid "10 analysis workshops"
msgstr "ກອງປະຊຸມສຳມະນາວິເຄາະ 10 ຄັ້ງ"

#. module: odoo_partner
#: model_terms:ir.ui.view,arch_db:odoo_partner.welcome_article_body
msgid ""
"<b>CRM App</b>: Manage your leads and opportunities in a dedicated pipeline, "
"tracking stages from \"New Lead\"\n"
"                    to \"Won\" efficiently."
msgstr ""
"<b>ແອັບ CRM</b>: ຈັດການລູກຄ້າມຸ່ງຫວັງ ແລະ ໂອກາດຂອງທ່ານໃນຂັ້ນຕອນການຂາຍສະເພາະ, ຕິດຕາມແຕ່ລະໄ"
"ລຍະແຕ່ \"ລູກຄ້າມຸ່ງຫວັງໃໝ່\"\n"
"                    ໄປຈົນເຖິງ \"ປິດການຂາຍໄດ້\" ຢ່າງມີປະສິດທິພາບ."

#. module: odoo_partner
#: model_terms:ir.ui.view,arch_db:odoo_partner.welcome_article_body
msgid ""
"<b>Documents App</b>: Store and organize crucial client documents, "
"contracts, and technical specifications\n"
"                    in a secure, central repository."
msgstr ""
"<b>ແອັບເອກະສານ</b>: ເກັບຮັກສາ ແລະ ຈັດລະບຽບເອກະສານສຳຄັນຂອງລູກຄ້າ, ສັນຍາ, ແລະ ຂໍ້ກຳນົດດ້ານເ"
"ຕັກນິກ\n"
"                    ໄວ້ໃນບ່ອນເກັບຂໍ້ມູນສູນກາງທີ່ມີຄວາມປອດໄພ."

#. module: odoo_partner
#: model_terms:ir.ui.view,arch_db:odoo_partner.welcome_article_body
msgid ""
"<b>Helpdesk App</b>: Handle client support requests and tickets "
"systematically, ensuring timely resolution and\n"
"                high service levels."
msgstr ""
"<b>ແອັບຊ່ວຍເຫຼືອ (Helpdesk)</b>: ຈັດການຄຳຮ້ອງຂໍຄວາມຊ່ວຍເຫຼືອ ແລະ ບັນຫາຕ່າງໆ ຂອງລູກຄ້າຢ່າງເປັນ"
"ລະບົບ, ຮັບປະກັນການແກ້ໄຂບັນຫາໄດ້ທັນເວລາ ແລະ\n"
"                ມາດຕະຖານການບໍລິການລະດັບສູງ."

#. module: odoo_partner
#: model_terms:ir.ui.view,arch_db:odoo_partner.welcome_article_body
msgid ""
"<b>Planning App</b>: Schedule your consultants' and developers' workload to "
"optimize resource allocation and\n"
"                    prevent bottlenecks."
msgstr ""
"<b>ແອັບວາງແຜນ</b>: ຈັດຕາຕະລາງພາລະວຽກຂອງທີ່ປຶກສາ ແລະ ນັກພັດທະນາ ເພື່ອຈັດສັນຊັບພະຍາກອນໃຫ້ເກີດ"
"ປະໂຫຍດສູງສຸດ ແລະ\n"
"                    ປ້ອງກັນບັນຫາວຽກຄ້າງຄາ."

#. module: odoo_partner
#: model_terms:ir.ui.view,arch_db:odoo_partner.welcome_article_body
msgid ""
"<b>Project App</b>: Manage Success Packs and large implementations with task "
"management, milestones, and\n"
"                    shared customer views."
msgstr ""
"<b>ແອັບໂຄງການ</b>: ຈັດການ Success Packs ແລະ ການຕິດຕັ້ງລະບົບຂະໜາດໃຫຍ່ ດ້ວຍການຈັດການໜ້າວຽ"
"ກ, ເປົ້າໝາຍຫຼັກ, ແລະ\n"
"                    ມຸມມອງຮ່ວມກັນກັບລູກຄ້າ."

#. module: odoo_partner
#: model_terms:ir.ui.view,arch_db:odoo_partner.welcome_article_body
msgid ""
"<b>Sales App</b>: Create professional proposals using an advanced Quote "
"Calculator and PDF Quote Builder to\n"
"                    impress prospective clients."
msgstr ""
"<b>ແອັບການຂາຍ</b>: ສ້າງໃບສະເໜີລາຄາແບບມືອາຊີບໂດຍໃຊ້ເຄື່ອງຄິດໄລ່ລາຄາຂັ້ນສູງ ແລະ ເຄື່ອງສ້າງໃບສະເ"
"ໜີລາຄາ PDF ເພື່ອ\n"
"                    ສ້າງຄວາມປະທັບໃຈໃຫ້ແກ່ລູກຄ້າມຸ່ງຫວັງ."

#. module: odoo_partner
#: model_terms:ir.ui.view,arch_db:odoo_partner.welcome_article_body
msgid ""
"<b>Sign App</b>: Send contracts and engagement letters for fast, legally "
"binding digital signatures.<br/>"
msgstr ""
"<b>ແອັບເຊັນເອກະສານ</b>: ສົ່ງສັນຍາ ແລະ ໜັງສືຂໍ້ຕົກລົງ ເພື່ອລົງລາຍເຊັນດິຈິຕອນທີ່ວ່ອງໄວ ແລະ ມີຜົນຜູກພັນຕ"
"າມກົດໝາຍ.<br/>"

#. module: odoo_partner
#: model_terms:ir.ui.view,arch_db:odoo_partner.welcome_article_body
msgid ""
"<b>Timesheets App</b>: Track billable hours spent on client projects to "
"ensure accurate invoicing and\n"
"                    profitability analysis."
msgstr ""
"<b>ແອັບບັນທຶກເວລາ</b>: ຕິດຕາມຊົ່ວໂມງທີ່ຄິດໄລ່ເງິນໄດ້ ເຊິ່ງໃຊ້ໄປກັບໂຄງການຂອງລູກຄ້າ ເພື່ອຮັບປະກັນການອ"
"ອກໃບຮຽກເກັບເງິນທີ່ຖືກຕ້ອງ ແລະ\n"
"                    ການວິເຄາະຜົນກຳໄລ."

