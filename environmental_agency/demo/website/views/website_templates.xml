<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/appointment" class="oe_unremovable btn btn-secondary">Book a Call</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_descriptive" model="ir.ui.view">
        <field name="name">Descriptive</field>
        <field name="key">website.template_footer_descriptive</field>
        <field name="inherit_id" ref="website.layout" />
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pb72 pt72" data-snippet="s_text_block" data-name="Text" style="position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/14&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}">
                        <div class="o_we_shape o_html_builder_Connections_14" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F14.svg?c5=%23FFFFFF&quot;);" />
                        <div class="container">
                            <div class="row">
                                <div class="o_colored_level pt0 col-lg-6 pb32">
                                    <h2>
                                        <span class="h1-fs">
                                            <font style="background-image: linear-gradient(135deg, rgb(129, 199, 132) 0%, rgb(0, 179, 204) 100%);" class="text-gradient">Accelerate Your Transition to Net Zero</font>
                                        </span>
                                    </h2>
                                </div>
                                <div class="o_colored_level col-lg-3 offset-lg-1">
                                    <p>
                                        <span class="h5-fs">
                                            <font class="text-o-color-4">
                                                <strong>E.C.O. Agency</strong>
                                            </font>
                                        </span>
                                    </p>
                                    <p>
                                        <font class="text-o-color-4">
                                            Rue des Bourlottes 9<br />
                                            1367 Ramillies<br />
                                            Belgium
                                        </font>
                                    </p>
                                </div>
                                <div class="o_colored_level col-lg-2">
                                    <p>
                                        <span class="h5-fs">
                                            <font class="text-o-color-4">
                                                <strong>Company</strong>
                                            </font>
                                        </span>
                                    </p>
                                    <p>
                                        <font class="text-o-color-4">
                                            <a href="/" class="o_translate_inline">Home</a>
                                            <br />
                                            <a href="/appointment" class="o_translate_inline">Book a Call</a>
                                            <br />
                                            <a href="/contactus" class="o_translate_inline">Contact us</a>
                                        </font>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
