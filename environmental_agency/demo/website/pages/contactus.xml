                                            <div class="map_container">
                                                <div class="css_non_editable_mode_hidden">
                                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                        An address must be specified for a map to be embedded
                                                    </div>
                                                </div>
                                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=Rue%20des%20Bourlottes%209%2C%201367%20Ramillies%2C%20Belgium&amp;t=m&amp;z=13&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                                <div class="s_map_color_filter"/>
