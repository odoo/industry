#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Accounting:</strong> Full financial management with real-time "
"insights."
msgstr ""
"<strong>ການບັນຊີ:</strong> ການຄຸ້ມຄອງການເງິນຄົບວົງຈອນ ພ້ອມຂໍ້ມູນເຈາະລຶກແບບສົດໆ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Assign maintenance locations</strong> for equipment under service."
msgstr ""
"<strong>ກຳນົດສະຖານທີ່ບຳລຸງຮັກສາ</strong> ສຳລັບອຸປະກອນທີ່ກຳລັງຮັບການບໍລິການ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid "<strong>Basics</strong>"
msgstr "<strong>ພື້ນຖານ</strong>"

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Check equipment availability</strong> in real time with serial "
"tracking."
msgstr ""
"<strong>ກວດສອບຄວາມພ້ອມໃຊ້ງານຂອງອຸປະກອນ</strong> ແບບສົດໆ ດ້ວຍການຕິດຕາມເລກລຳດັບ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Collaborate in chatter</strong> to keep all communication "
"centralized."
msgstr ""
"<strong>ຮ່ວມມືກັນໃນຊ່ອງສົນທະນາ</strong> ເພື່ອລວມສູນການຕິດຕໍ່ສື່ສານທັງໝົດໄວ້ບ່ອນດຽວ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid "<strong>Convert to offer</strong> any opportunity in one click."
msgstr "<strong>ປ່ຽນເປັນຂໍ້ສະເໜີ</strong> ຈາກທຸກໂອກາດໄດ້ໃນຄລິກດຽວ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Create rental orders</strong> from CRM opportunities or directly in "
"the app."
msgstr "<strong>ສ້າງໃບສັ່ງເຊົ່າ</strong> ຈາກໂອກາດໃນ CRM ຫຼື ສ້າງໂດຍກົງໃນແອັບ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid "<strong>Do you want to go further?</strong>"
msgstr "<strong>ເຈົ້າຕ້ອງການໄປຕໍ່ບໍ່?</strong>"

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Employees:</strong> Manage HR operations including time-off and "
"contracts."
msgstr ""
"<strong>ພະນັກງານ:</strong> ຄຸ້ມຄອງວຽກງານບຸກຄະລາກອນ ລວມທັງການລາພັກ ແລະ ສັນຍາ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid "<strong>Enable recurring billing</strong> for long-term rentals."
msgstr "<strong>ເປີດໃຊ້ການຮຽກເກັບເງິນແບບປະຈຳ</strong> ສຳລັບການເຊົ່າໄລຍະຍາວ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid "<strong>Final word</strong>"
msgstr "<strong>ຄຳລົງທ້າຍ</strong>"

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Fleet:</strong> Keep track of vehicles used for delivery and pickup."
msgstr ""
"<strong>ຂະບວນຍານພາຫະນະ:</strong> ຕິດຕາມຍານພາຫະນະທີ່ໃຊ້ສຳລັບການຈັດສົ່ງ ແລະ ໄປຮັບເຄື່ອງ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid "<strong>Generate invoices</strong> directly from rental orders."
msgstr "<strong>ສ້າງໃບຮຽກເກັບເງິນ</strong> ໂດຍກົງຈາກໃບສັ່ງເຊົ່າ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid "<strong>How to Use:</strong>"
msgstr "<strong>ວິທີນຳໃຊ້:</strong>"

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and "
"then to create a new one for your own usage.</strong>"
msgstr ""
"<strong>ໃນກໍລະນີດັ່ງກ່າວ, ທ່ານສາມາດທົດລອງໃຊ້ຖານຂໍ້ມູນນີ້ໄດ້ຕາມໃຈ ແລ້ວຈຶ່ງສ້າງຖານຂໍ້ມູນໃໝ່ສຳລັບການນຳໃ"
"ຊ້ຕົວຈິງຂອງທ່ານເອງ.</strong>"

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Integrate with inventory</strong> to automatically trigger quality "
"checks."
msgstr ""
"<strong>ເຊື່ອມໂຍງກັບສາງສິນຄ້າ</strong> ເພື່ອເປີດໃຊ້ການກວດສອບຄຸນນະພາບໂດຍອັດຕະໂນມັດ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Inventory App</strong> gives you real-time control over available "
"equipment, locations, and serials."
msgstr ""
"<strong>ແອັບສາງສິນຄ້າ</strong> ຊ່ວຍໃຫ້ທ່ານຄວບຄຸມອຸປະກອນທີ່ພ້ອມໃຊ້ງານ, ສະຖານທີ່ຈັດເກັບ ແລະ ເລກ"
"ລຳດັບໄດ້ແບບສົດໆ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid "<strong>Link runtime data</strong> to serials for maintenance planning."
msgstr ""
"<strong>ເຊື່ອມໂຍງຂໍ້ມູນຊົ່ວໂມງເຮັດວຽກ</strong> ເຂົ້າກັບເລກລຳດັບ ເພື່ອວາງແຜນການບຳລຸງຮັກສາ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Log inspection results</strong> and mark equipment as available only "
"if it passes."
msgstr ""
"<strong>ບັນທຶກຜົນການກວດກາ</strong> ແລະ ໝາຍວ່າອຸປະກອນພ້ອມໃຊ້ງານໄດ້ ກໍຕໍ່ເມື່ອກວດຜ່ານເທົ່ານັ້ນ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid "<strong>Manage returns</strong> and extensions easily from the order."
msgstr ""
"<strong>ຄຸ້ມຄອງການສົ່ງຄືນ</strong> ແລະ ການຕໍ່ເວລາເຊົ່າໄດ້ຢ່າງງ່າຍດາຍຈາກໃບສັ່ງ."

#. module: agri_equipment_rental
#: model_terms:ir.ui.view,arch_db:agri_equipment_rental.welcome_article_body
msgid ""
"<strong>Organize pipelines</strong> by stages (e.g., New Lead → Quotation "
"Sent → Won/Lost)."
msgstr ""
"<strong>ຈັດລະບຽບຂະບວນການຂາຍ (Pipeline)</strong> ຕາມແຕ່ລະຂັ້ນຕອນ (ເຊັ່ນ: ຜູ້ມຸ່ງຫວັງໃໝ່ → "
"ສົ່ງໃບສະເໜີລາຄາແລ້ວ → ສຳເລັດ/ຫຼຸດ)."

#. module: agri_equipment_rental
