<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Stockio - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-primary">Contact Us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_mega" model="ir.ui.view">
        <field name="name">Stockio - Mega</field>
        <field name="key">website.template_footer_mega</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break o_cc5" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt48 pb24" data-snippet="s_text_block" data-name="Top Part">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-2 pb24 o_colored_level order-lg-0" style="order: 0;">
                                    <h4 style="font-weight: normal;"><span class="h5-fs">Navigation</span></h4>
                                    <ul class="list-unstyled">
                                        <li><a href="/">Home</a></li>
                                        <li><a href="/services" class="o_translate_inline">Services</a></li>
                                        <li><a href="/about-us" class="o_translate_inline">About us</a></li>
                                        <li><a href="/contactus" class="o_translate_inline">Contact us</a></li>

                                    </ul>
                                </div>
                                <div class="col-lg-2 pb24 o_colored_level order-lg-0" style="order: 1;">
                                    <h4 style="font-weight: normal;"><span class="h5-fs">Services</span></h4>
                                    <ul class="list-unstyled">
                                        <li><a href="/services#Warehousing" class="o_translate_inline">Warehousing</a></li>
                                        <li><a href="/services#orderfulfil" class="o_translate_inline">Order fulfilment</a></li>
                                        <li><a href="/services#transportation" class="o_translate_inline">Packaging</a></li>
                                        <li class="oe-nested"><a href="/services#tailored" class="o_translate_inline">Tailored Services</a></li>
                                    </ul>
                                </div>
                                <div class="pb24 o_colored_level order-lg-0 col-lg-4" style="order: 2;">
                                    <h4 style="font-weight: normal;"><span class="h5-fs">Get in Touch</span></h4>
                                    <ul class="list-unstyled">
                                        <li>
                                            <img src="/web/image/3pl_logistic_company.img_custom_stockio_image_37" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="padding: 5px;" loading="lazy"/><a href="mailto:info@stockio.example.com"> info@stockio.example.com</a></li>
                                        <li>
                                            <img src="/web/image/3pl_logistic_company.img_custom_stockio_image_38" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="padding: 5px;" loading="lazy"/><a href="tel:+3233615430"><span class="o_force_ltr">+32 33615430</span></a>
                                        </li>
                                        <li>
                                            <img src="/web/image/3pl_logistic_company.img_custom_stockio_image_39" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="padding: 5px;" loading="lazy"/><a href="https://www.google.com/maps/place/Roderveldlaan+3,+2600+Antwerpen/@51.1908206,4.4359323,17z/data=!3m1!4b1!4m6!3m5!1s0x47c3f747e8c72e4d:0x3bc97852f48dedc2!8m2!3d51.1908173!4d4.4385072!16s%2Fg%2F11hbsv3wc9?entry=ttu&amp;g_ep=EgoyMDI2MDkxNS4wIKXMDSoASAFQAw%3D%3D" class="o_translate_inline" target="_blank">Roderveldlaan 3, 2600 Antwerpen</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="pb24 o_colored_level order-lg-0 col-lg-4 col-12 pt32" style="order: 5;">
                                    <p>
                                        <a href="/" class="o_footer_logo logo o-float-start-parent o_translate_inline">
                                            <img src="/web/image/3pl_logistic_company.img_custom_stockio_image_40" alt="Stockio" class="img-fluid float-start me-auto img o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy" style="width: 63% !important;"/>
                                        </a>
                                    </p>
                                </div>
                                <div class="col-lg-12 o_colored_level order-lg-0" style="order: 4;">
                                    <div class="s_hr pb24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="col-lg-12 o_colored_level order-lg-0" style="order: 3;">
                                    <h3 style="font-weight: normal;">
                                        <span class="h5-fs">Logistics Built Around Your Business</span>
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_text_block o_footer_bottom_part pt8 pb8 o_colored_level" style="position: relative; background-color: rgba(0, 0, 0, 0.05);" data-snippet="s_text_block" data-name="Bottom Part">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-6 pt8 pb8 o_colored_level">
                                    <div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <p class="s_social_media_title d-none">Follow us</p>
                                        <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank">
                                            <i class="oi oi-stack o_editable_media o_cc o_cc4" data-icon="oi_linkedin"/>
                                        </a>
                                        <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank">
                                            <i class="oi oi-stack o_editable_media o_cc o_cc4" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="/website/social/youtube" class="s_social_media_youtube" target="_blank">
                                            <i class="oi oi-stack o_editable_media o_cc o_cc4" data-icon="oi_youtube-play"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-6 pt8 pb8 o_colored_level">
                                    <nav class="nav justify-content-lg-end flex-column flex-lg-row">
                                        <a class="nav-link" href="/terms">Terms and Conditions</a>
                                        <a class="nav-link" href="/privacy">Privacy Policy</a>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
            <xpath expr="//t[@t-call='web.brand_promotion']/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
            <xpath expr="//div[hasclass('o_footer_copyright')]" position="attributes">
                <attribute name="class" add="o_cc5" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
