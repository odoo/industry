<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_privacy" model="ir.ui.view">
        <field name="name">Privacy</field>
        <field name="key">3pl_logistic_company.page_privacy</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="3pl_logistic_company.page_privacy">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title o_colored_level pb40 s_custom_snippet pt64" data-vcss="001" data-snippet="s_title" data-name="Custom Title">
                            <div class="container s_allow_columns">
                                <h1 style="text-align: start; font-weight: normal;">
                                    <span class="text-o-color-1">Privacy Policy</span>
                                </h1>
                            </div>
                        </section>
                        <section class="s_text_block pb40 o_colored_level pt0" data-snippet="s_text_block" data-name="Text">
                            <div class="container s_allow_columns">
                                <p>
                                    <strong>Last updated: October 7, 2026</strong>
                                </p>
                                <p>At Stockio, we respect your privacy and are committed to protecting your personal data. This Privacy Policy explains what information we collect, how we use it, how we protect it, and what rights you have regarding your personal data.</p>
                                <p>By using the Stockio website and services, you acknowledge the practices described in this Privacy Policy.</p>
                                <h2>
                                    <span class="h4-fs">1. Who We Are</span>
                                </h2>
                                <p>Stockio ("Stockio", "we", "us", or "our") operates the Stockio website and related services.</p>
                                <p>If you have any questions about this Privacy Policy or how your personal data is handled, you can contact us at:</p>
                                <p>
                                    <strong>Email:</strong>
                                    <a href="mailto:info@stockio.example.com">info@stockio.example.com</a>
                                </p>
                                <h2>
                                    <span class="h4-fs">2. Information We Collect</span>
                                </h2>
                                <p>Depending on how you use Stockio, we may collect the following types of information:</p>
                                <h3>
                                    <span class="h5-fs">Information You Provide to Us</span>
                                </h3>
                                <p>When you create an account, contact us, subscribe to a service, or otherwise interact with Stockio, you may provide information such as:</p>
                                <ul>
                                    <li>
                                        Your name
                                    </li>
                                    <li>
                                        Email address
                                    </li>
                                    <li>
                                        Account information
                                    </li>
                                    <li>
                                        Billing or transaction information
                                    </li>
                                    <li>
                                        Information you provide when contacting us
                                    </li>
                                    <li>
                                        Any other information you voluntarily submit through the website
                                    </li>
                                </ul>
                                <h3>
                                    <span class="h5-fs">Information Collected Automatically</span>
                                </h3>
                                <p>When you visit or use Stockio, certain information may be collected automatically, including:</p>
                                <ul>
                                    <li>
                                        IP address
                                    </li>
                                    <li>
                                        Browser type and version
                                    </li>
                                    <li>
                                        Device type
                                    </li>
                                    <li>
                                        Operating system
                                    </li>
                                    <li>
                                        Pages or features you access
                                    </li>
                                    <li>
                                        Date and time of your visit
                                    </li>
                                    <li>
                                        Referring website or source
                                    </li>
                                    <li>
                                        General usage and interaction data
                                    </li>
                                </ul>
                                <p>This information may be collected through cookies, analytics tools, logs, and similar technologies.</p>
                                <h2>
                                    <span class="h4-fs">3. How We Use Your Information</span>
                                </h2>
                                <p>We may use your personal information to:</p>
                                <ul>
                                    <li>
                                        Provide, operate, and maintain Stockio
                                    </li>
                                    <li>
                                        Create and manage your account
                                    </li>
                                    <li>
                                        Process transactions and subscriptions
                                    </li>
                                    <li>
                                        Provide customer support
                                    </li>
                                    <li>
                                        Respond to your questions and requests
                                    </li>
                                    <li>
                                        Improve our website, products, and services
                                    </li>
                                    <li>
                                        Understand how users interact with Stockio
                                    </li>
                                    <li>
                                        Detect, prevent, and address fraud, abuse, security issues, or technical problems
                                    </li>
                                    <li>
                                        Send important service-related communications
                                    </li>
                                    <li>
                                        Send marketing communications where permitted and where you have provided the necessary consent
                                    </li>
                                    <li>
                                        Comply with applicable legal obligations
                                    </li>
                                </ul>
                                <p>We only use personal information when we have a lawful basis to do so.</p>
                                <h2>
                                    <span class="h4-fs">4. Legal Bases for Processing</span>
                                </h2>
                                <p>Where applicable under data protection laws such as the GDPR, we process personal data on one or more of the following legal bases:</p>
                                <ul>
                                    <li>
                                        <strong>Performance of a contract:</strong> when processing is necessary to provide the services you requested.
                                    </li>
                                    <li>
                                        <strong>Legitimate interests:</strong> when processing is necessary for purposes such as improving our services, maintaining security, or preventing fraud, provided that these interests do not override your rights.
                                    </li>
                                    <li>
                                        <strong>Consent:</strong> where you have given us permission to process your information for a specific purpose.
                                    </li>
                                    <li>
                                        <strong>Legal obligations:</strong> when we are required to process or retain information to comply with applicable laws.
                                    </li>
                                </ul>
                                <p>Where we rely on consent, you may withdraw your consent at any time.</p>
                                <h2>
                                    <span class="h4-fs">5. Cookies and Similar Technologies</span>
                                </h2>
                                <p>Stockio may use cookies and similar technologies to operate the website, remember preferences, understand website usage, and improve our services.</p>
                                <p>Some cookies may be necessary for the website to function, while others may be used for analytics, personalization, or other purposes.</p>
                                <p>Where required by applicable law, we will ask for your consent before placing non-essential cookies on your device.</p>
                                <p>You can also manage or disable cookies through your browser settings. However, disabling certain cookies may affect the functionality of the website.</p>
                                <h2>
                                    <span class="h4-fs">6. Third-Party Services</span>
                                </h2>
                                <p>We may work with third-party providers that help us operate Stockio and provide our services. These providers may process personal information on our behalf for purposes such as:</p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_privacy" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_privacy"/>
            <field name="url">/privacy</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
