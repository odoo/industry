#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">This Odoo module <b>optimizes your logistics and "
"warehousing</b>,\n"
"                offering a complete solution to boost efficiency and "
"customer satisfaction across\n"
"                all services. It streamlines operations for everything from "
"long-term storage to\n"
"                pallet management and transport. You can effortlessly manage "
"client stock, schedule\n"
"                movements, ensure full traceability, optimize billing, and "
"provide customers with <font class=\"text-o-color-5\">real-time stock "
"visibility.</font></span>\n"
"            <br/>"
msgstr ""
"<span class=\"h6-fs\">Questo modulo Odoo <b>ottimizza la logistica e il "
"magazzinaggio</b>,\n"
"                offrendo una soluzione completa per aumentare l'efficienza e "
"la soddisfazione dei clienti in tutti i\n"
"                servizi. Semplifica le operazioni per tutto, dallo "
"stoccaggio a lungo termine alla\n"
"                gestione dei pallet e al trasporto. È possibile gestire "
"senza sforzo le scorte dei clienti, programmare i\n"
"                movimenti, garantire la completa tracciabilità, ottimizzare "
"la fatturazione e fornire ai clienti un <font class=\"text-o-"
"color-5\">visibilità delle scorte in tempo reale.</font></span>\n"
"           <br/>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Use the <b>Document</b> app to manage all your "
"internal and external\n"
"                document and use the Sign App for automated customer "
"signature</span>"
msgstr ""
"<span class=\"h6-fs\">Utilizza l'app <b>Documenti</b> per gestire tutti i "
"tuoi documenti interni ed esterni\n"
"                e utilizza l'app Firma per automatizzare la firma dei "
"clienti.</span>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Use the <b>Purchase</b> app to manage all your "
"internal product\n"
"                purchasing.</span>"
msgstr ""
"<span class=\"h6-fs\">Utilizza l'app <b>Acquisti</b> per gestire tutti i "
"tuoi acquisti interni\n"
"                di prodotti.</span>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
