"                    <font style=\"color: rgb(113, 75, 103);\">pacchetto Odoo "
"Azienda logistica</font>\n"
"                </strong>\n"
"                !</span>\n"
"            <br/>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">When you need to manually move stock—like returning "
"items to a\n"
"                quality check location or moving products after a customer "
"validation—use an\n"
"                internal transfer.<strong/></span>\n"
"            <br/>"
msgstr ""
"<span class=\"h6-fs\">Quando è necessario spostare manualmente le scorte, ad "
"esempio per restituire articoli a un\n"
"                punto di controllo qualità o spostare prodotti dopo la "
"convalida da parte di un cliente, utilizza un\n"
"                trasferimento interno.<strong/></span>\n"
"           <br/>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">You can add specific quality checks required by your "
"customer. For\n"
"                each check, define how it should be performed, when it "
"should be completed, and\n"
"                which samples it applies to.</span>"
msgstr ""
"<span class=\"h6-fs\">È possibile aggiungere controlli di qualità specifici "
"richiesti dal cliente. Per\n"
"                ogni controllo, indica come deve essere eseguito, quando "
"deve essere completato e\n"
"                a quali campioni si applica.</span>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
