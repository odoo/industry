#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">This Odoo module <b>optimizes your logistics and "
"warehousing</b>,\n"
"                offering a complete solution to boost efficiency and "
"customer satisfaction across\n"
"                all services. It streamlines operations for everything from "
"long-term storage to\n"
"                pallet management and transport. You can effortlessly manage "
"client stock, schedule\n"
"                movements, ensure full traceability, optimize billing, and "
"provide customers with <font class=\"text-o-color-5\">real-time stock "
"visibility.</font></span>\n"
"            <br/>"
msgstr ""
"<span class=\"h6-fs\">يعمل تطبيق أودو هذا على <b>تحسين الخدمات اللوجستية "
"والتخزين</b>،\n"
"                ويقدم حلاً متكاملاً لزيادة الكفاءة ورضا العملاء في\n"
"                جميع الخدمات. كما يعمل على تبسيط العمليات في جميع المجالات، "
"بدءاً من التخزين طويل الأجل إلى\n"
"                إدارة المنصات النقالة والنقل. يمكنك إدارة مخزون العملاء "
"بسهولة، وجدولة\n"
"                التحركات، وضمان التتبع الكامل، وتحسين الفوترة، وتزويد "
"العملاء بـ <font class=\"text-o-color-5\">رؤية المخزون في الوقت الفعلي.</"
"font></span>\n"
"            <br/>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Use the <b>Document</b> app to manage all your "
"internal and external\n"
"                document and use the Sign App for automated customer "
"signature</span>"
msgstr ""
"<span class=\"h6-fs\">استخدم تطبيق <b>المستندات</b> لإدارة جميع مستنداتك "
"الداخلية والخارجية\n"
"                واستخدم تطبيق التوقيع الإلكتروني للحصول على توقيعات العملاء "
"تلقائيًا</span>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Use the <b>Purchase</b> app to manage all your "
"internal product\n"
"                purchasing.</span>"
msgstr ""
"<span class=\"h6-fs\">استخدم تطبيق <b>المشتريات</b> لإدارة كافة عمليات شراء "
"المنتجات الداخلية الخاصة بك\n"
"                .</span>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Welcome to the <strong>\n"
"                    <font style=\"color: rgb(113, 75, 103);\">Odoo Logistic "
"company package</font>\n"
"                </strong>\n"
"                !</span>\n"
"            <br/>"
msgstr ""
"<span class=\"h6-fs\">مرحباً بك في <strong>\n"
"                    <font style=\"color: rgb(113, 75, 103);\">باقة أودو "
"للشركات اللوجستية</font>\n"
"                </strong>\n"
"                !</span>\n"
"            <br/>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">When you need to manually move stock—like returning "
"items to a\n"
"                quality check location or moving products after a customer "
"validation—use an\n"
"                internal transfer.<strong/></span>\n"
"            <br/>"
msgstr ""
"<span class=\"h6-fs\">عندما تحتاج إلى نقل المخزون يدويًا — مثل إعادة العناصر "
"إلى\n"
"                موقع فحص الجودة أو نقل المنتجات بعد تصديق العميل — استخدم\n"
"                عملية النقل الداخلي.<strong/></span>\n"
"            <br/>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">You can add specific quality checks required by your "
"customer. For\n"
"                each check, define how it should be performed, when it "
"should be completed, and\n"
"                which samples it applies to.</span>"
msgstr ""
"<span class=\"h6-fs\">يمكنك إضافة فحوصات جودة محددة يطلبها عميلك. بالنسبة\n"
"                لكل فحص، حدد كيفية إجرائه، ومتى يجب إكماله، و\n"
"                العينات التي ينطبق عليها.</span>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">You can easily <b>create and manage all your clients</"
"b> from the\n"
"                Contacts app. Meanwhile, all customer products are managed "
"from the Inventory app.</span>\n"
"            <br/>"
msgstr ""
"<span class=\"h6-fs\">يمكنك بسهولة <b>إنشاء وإدارة جميع عملائك</b> من\n"
"                تطبيق جهات الاتصال. وفي الوقت نفسه، تتم إدارة جميع منتجات "
"العملاء من تطبيق المخزون.</span>\n"
"            <br/>"

