#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Barcode App</b>:</font> Streamlines "
"warehouse floor operations by enabling\n"
"                    fast and accurate scanning of pallets, locations, and "
"stock movements."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija črtne kode</b>:</font> "
"Poenostavlja operacije v skladišču z omogočanjem\n"
"                    hitrega in natančnega skeniranja palet, lokacij in "
"premikov zaloge."

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>CRM App</b>:</font> Tracks leads and "
"opportunities efficiently, helping\n"
"                    logistics companies follow up on prospects and manage "
"long-term customer relationships."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija CRM</b>:</font> Sledi vodilom "
"in priložnostim učinkovito, pomaga\n"
"                    logističnim podjetjem spremljati potencialne stranke in "
"upravljati dolgoročne odnose s kupci."

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Documents App</b>:</font> Centralizes "
"contracts, delivery notes, and\n"
"                    transport documentation in a searchable digital space."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija Dokumenti</b>:</font> "
"Centralizira pogodbe, dobavnice in\n"
"                    dokumentacijo prevoza v iskalnem digitalnem prostoru."

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Inventory App</b>:</font> Enables precise "
"stock management across multiple\n"
"                    warehouses and clients, ensuring full tracking of "
"inbound, outbound, and internal movements."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija za zalogo</b>:</font> Omogoča "
"natančno upravljanje zaloge v več\n"
"                    skladiščih in pri strankah, zagotavlja popolno sledenje "
"vhodnim, izhodnim in notranjim premikom."

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Invoicing App</b>:</font> Automates "
"billing calculations based on storage\n"
"                    duration, volume, and handling services, with support "
"for custom pricing per client."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija za fakturiranje</b>:</font> "
"Avtomatizira izračune zaračunavanja na podlagi\n"
"                    trajanja skladiščenja, volumna in storitev rokovanja, z "
"možnostjo prilagojenih cen za vsako stranko."

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Sales App</b>:</font> Generates "
"professional quotations and sales orders for\n"
"                    storage, transport, and value-added logistics services."
msgstr ""
"<font class=\"text-o-color-1\"><b>Prodajna aplikacija</b>:</font> Ustvarja "
"profesionalne ponudbe in prodajne naloge za\n"
"                    skladiščenje, prevoz in logistične storitve z dodano "
"vrednostjo."

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Subscriptions App</b>:</font> Manages "
"recurring billing for long-term\n"
"                    storage services with customizable plans."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija naročnin</b>:</font> Upravlja "
"ponavljajoče se zaračunavanje za dolgoročne\n"
"                    storitve skladiščenja s prilagodljivimi načrti."

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Website &amp; Portal</b>:</font> Provides "
"clients with a self-service portal\n"
"                    for real-time access to stock levels, service requests, "
"and downloadable documents."
msgstr ""
"<font class=\"text-o-color-1\"><b>Spletna stran &amp; Portal</b>:</font> "
"Strankam zagotavlja samopostrežni portal\n"
"                    za dostop v realnem času do stanja zalog, zahtev za "
"storitev in dokumentov za prenos."

