#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">This Odoo module <b>optimizes your logistics and "
"warehousing</b>,\n"
"                offering a complete solution to boost efficiency and "
"customer satisfaction across\n"
"                all services. It streamlines operations for everything from "
"long-term storage to\n"
"                pallet management and transport. You can effortlessly manage "
"client stock, schedule\n"
"                movements, ensure full traceability, optimize billing, and "
"provide customers with <font class=\"text-o-color-5\">real-time stock "
"visibility.</font></span>\n"
"            <br/>"
msgstr ""
"<span class=\"h6-fs\">Este módulo de Odoo <b>optimiza tu logística y "
"almacenamiento</b>,\n"
"                es una solución completa para potenciar la eficacia y la "
"satisfacción del cliente en todos\n"
"                los servicios. Optimiza las operaciones para todo, desde "
"almacenamiento a largo plazo hasta\n"
"                la gestión y el traslado de pallets. Puedes gestionar el "
"stock de tus clientes, programar\n"
"                movimientos, ofrecer una transparencia total, optimizar la "
"facturación y ofrecerle <font class=\"text-o-color-5\">visibilidad en tiempo "
"real del stock</font></span> a los clientes.\n"
"            <br/>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Use the <b>Document</b> app to manage all your "
"internal and external\n"
"                document and use the Sign App for automated customer "
"signature</span>"
msgstr ""
"<span class=\"h6-fs\">Usa la aplicación <b>Documentos</b> para gestionar "
"todos tus documentos internos y externos.\n"
"                Usa la aplicación Firma electrónica para firmas "
"automatizadas de los clientes</span>"

#. module: 3pl_logistic_company
#: model_terms:ir.ui.view,arch_db:3pl_logistic_company.welcome_article_body
