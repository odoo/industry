#. module: tattoo_shop
#: model_terms:ir.ui.view,arch_db:tattoo_shop.view_page_home
#, fuzzy
msgid ""
"<br/>At <strong>Black Needle</strong>, we see tattooing as a collaboration "
"between artist and client. Every piece starts with an idea, but it becomes "
"something special through conversation, creativity, and careful "
"craftsmanship."
msgstr ""
"<br/>Na <strong>Black Needle</strong>, vemos a tatuagem como uma colaboração "
"entre artista e cliente. Cada peça começa com uma ideia, mas torna-se algo "
"especial através de conversa, criatividade e artesanato cuidadoso."

#. module: tattoo_shop
#: model:mail.template,body_html:tattoo_shop.mail_template_booking_mail
msgid ""
"<div data-oe-version=\"1.0\">\n"
"            Hi <t t-out=\"object.contact_name or ''\"/>,\n"
"            <br/><br/>\n"
"            Don't hesitate to book an appointment with us if you're "
"interested in booking our services.\n"
"            <br/><br/>\n"
"            Here's the link:\n"
"            <br/>\n"
"            <a t-att-href=\"'/appointment/' + "
"str(env.ref('tattoo_shop.appointment_type_1').id)\">Book Now</a>\n"
"            <br/><br/>\n"
"            Have a nice day!\n"
"            <br/><br/>\n"
"            <t t-out=\"object.user_id.signature\"/></div>\n"
"        "
msgstr ""
"<div data-oe-version=\"1.0\">\n"
"            Olá <t t-out=\"object.contact_name or ''\"/>,\n"
"            <br/><br/>\n"
"            Não hesite em marcar uma conversa conosco, se estiver "
"interessado em contratar nossos serviços.\n"
"            <br/><br/>\n"
"            Aqui está o link:\n"
"            <br/>\n"
"            <a t-att-href=\"'/appointment/' + "
"str(env.ref('tattoo_shop.appointment_type_1').id)\">Agendar agora</a>\n"
"            <br/><br/>\n"
"            Tenha um ótimo dia!\n"
"            <br/><br/>\n"
"            <t t-out=\"object.user_id.signature\"/></div>\n"
"        "

#. module: tattoo_shop
#: model:mail.template,body_html:tattoo_shop.mail_template_after_care
msgid ""
"<div data-oe-version=\"1.0\">\n"
"            Hi <t t-out=\"object.contact_name or ''\"/>,\n"
"            <br/><br/>\n"
"            We hope you had a nice experience at our Tattoo shop.\n"
"            <br/>\n"
"            In attachment, you'll find a tattoo aftercare sheet for some "
"tips and tricks.\n"
"            <br/><br/>\n"
"            Have a nice day,\n"
"            <br/><br/>\n"
"            <t t-out=\"object.activity_user_id.signature\"/>\n"
"            </div>\n"
"        "
msgstr ""
"<div data-oe-version=\"1.0\">\n"
"            Olá <t t-out=\"object.contact_name or ''\"/>,\n"
"            <br/><br/>\n"
"            Esperamos que tenha tido uma boa experiência em nosso estúdio de "
"tatuagem.\n"
"            <br/>\n"
"            Em anexo, enviamos uma folha de cuidados posteriores à tatuagem "
"para te trazer algumas dicas e truques.\n"
"            <br/><br/>\n"
"            Tenha um ótimo dia,\n"
"            <br/><br/>\n"
"            <t t-out=\"object.activity_user_id.signature\"/>\n"
"            </div>\n"
"        "

