msgid ""
"<span style=\"font-size: 18px;\"><strong>Black Needle was born from a simple "
"idea: tattoos should mean something.</strong></span>"
msgstr ""

#. module: tattoo_shop
#: model_terms:ir.ui.view,arch_db:tattoo_shop.view_page_home
msgid ""
"<span style=\"font-size: 18px;\">At <strong>Black Needle</strong>, we turn "
"ideas into ink. From bold statements to subtle details, every tattoo is "
"designed with intention and crafted to become part of your story.<br/><br/></"
"span>"
msgstr ""

#. module: tattoo_shop
#: model_terms:ir.ui.view,arch_db:tattoo_shop.view_page_home
msgid ""
"<span style=\"font-size: 18px;\">Our artists combine creativity, precision, "
"and years of craft to create tattoos that feel uniquely yours. From the "
"first sketch to the final needle, we take the time to understand @your "
"vision and bring it to life.<br/><br/></span>"
msgstr ""

#. module: tattoo_shop
#: model_terms:ir.ui.view,arch_db:tattoo_shop.view_page_home
msgid ""
