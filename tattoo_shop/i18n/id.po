#. module: tattoo_shop
#: model_terms:ir.ui.view,arch_db:tattoo_shop.view_page_home
msgid ""
"<span style=\"font-size: 18px;\">Our artists combine creativity, precision, "
"and years of craft to create tattoos that feel uniquely yours. From the "
"first sketch to the final needle, we take the time to understand @your "
"vision and bring it to life.<br/><br/></span>"
msgstr ""

#. module: tattoo_shop
#: model_terms:ir.ui.view,arch_db:tattoo_shop.view_page_home
msgid ""
"<span style=\"font-size: 18px;\">We believe every piece carries a story — a "
"memory, a feeling, a statement, or simply a moment you want to make "
"permanent.</span>"
msgstr ""

