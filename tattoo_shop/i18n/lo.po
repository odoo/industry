#. module: tattoo_shop
#: model_terms:ir.ui.view,arch_db:tattoo_shop.view_page_home
msgid ""
"<br/>At <strong>Black Needle</strong>, we see tattooing as a collaboration "
"between artist and client. Every piece starts with an idea, but it becomes "
"something special through conversation, creativity, and careful "
"craftsmanship."
msgstr ""
"<br/>ທີ່ <strong>Black Needle</strong>, ພວກເຮົາຖືວ່າການສັກລາຍແມ່ນການຮ່ວມມືກັນລະຫວ່າງຊ່າງສັ"
"ກ ແລະ ລູກຄ້າ. ທຸກໆຜົນງານເລີ່ມຕົ້ນຈາກຄວາມຄິດ, ແຕ່ມັນຈະກາຍເປັນສິ່ງພິເສດຜ່ານການສົນທະນາ, ຄວາມຄິດສ້າງ"
"ສັນ ແລະ ຝີມືອັນປານີດ."

#. module: tattoo_shop
#: model:mail.template,body_html:tattoo_shop.mail_template_booking_mail
msgid ""
"<div data-oe-version=\"1.0\">\n"
"            Hi <t t-out=\"object.contact_name or ''\"/>,\n"
"            <br/><br/>\n"
"            Don't hesitate to book an appointment with us if you're "
"interested in booking our services.\n"
"            <br/><br/>\n"
"            Here's the link:\n"
"            <br/>\n"
"            <a t-att-href=\"'/appointment/' + "
"str(env.ref('tattoo_shop.appointment_type_1').id)\">Book Now</a>\n"
"            <br/><br/>\n"
"            Have a nice day!\n"
"            <br/><br/>\n"
"            <t t-out=\"object.user_id.signature\"/></div>\n"
"        "
msgstr ""
"<div data-oe-version=\"1.0\">\n"
"            ສະບາຍດີ <t t-out=\"object.contact_name or ''\"/>,\n"
"            <br/><br/>\n"
"            ຢ່າລັງເລທີ່ຈະຈອງເວລານັດໝາຍກັບພວກເຮົາ ຖ້າຫາກທ່ານສົນໃຈໃຊ້ບໍລິການຂອງພວກເຮົາ.\n"
"            <br/><br/>\n"
"            ນີ້ແມ່ນລິ້ງ:\n"
"            <br/>\n"
"            <a t-att-href=\"'/appointment/' + str(env.ref"
"('tattoo_shop.appointment_type_1').id)\">ຈອງເລີຍ</a>\n"
"            <br/><br/>\n"
"            ຂໍໃຫ້ມີມື້ທີ່ດີ!\n"
"            <br/><br/>\n"
"            <t t-out=\"object.user_id.signature\"/></div>\n"
"        "

#. module: tattoo_shop
#: model:mail.template,body_html:tattoo_shop.mail_template_after_care
msgid ""
"<div data-oe-version=\"1.0\">\n"
"            Hi <t t-out=\"object.contact_name or ''\"/>,\n"
"            <br/><br/>\n"
"            We hope you had a nice experience at our Tattoo shop.\n"
"            <br/>\n"
"            In attachment, you'll find a tattoo aftercare sheet for some "
"tips and tricks.\n"
"            <br/><br/>\n"
"            Have a nice day,\n"
"            <br/><br/>\n"
"            <t t-out=\"object.activity_user_id.signature\"/>\n"
"            </div>\n"
"        "
msgstr ""
"<div data-oe-version=\"1.0\">\n"
"            ສະບາຍດີ <t t-out=\"object.contact_name or ''\"/>,\n"
"            <br/><br/>\n"
"            ພວກເຮົາຫວັງວ່າທ່ານຈະໄດ້ຮັບປະສົບການທີ່ດີ ທີ່ຮ້ານສັກລາຍຂອງພວກເຮົາ.\n"
"            <br/>\n"
"            ໃນເອກະສານຄັດຕິດ, ທ່ານຈະເຫັນເອກະສານແນະນຳການເບິ່ງແຍງຮັກສາຫຼັງສັກ ສຳລັບຄຳແນະນຳ "
"ແລະ ເຄັດລັບຕ່າງໆ.\n"
"            <br/><br/>\n"
"            ຂໍໃຫ້ເປັນມື້ທີ່ດີ,\n"
"            <br/><br/>\n"
"            <t t-out=\"object.activity_user_id.signature\"/>\n"
"            </div>\n"
"        "

