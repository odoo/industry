<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">tattoo_shop.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="tattoo_shop.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'tag_ids': request.params.get('tag_ids', ''), 'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', ''),}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title bg-black-50 o_colored_level pb176 pt128 oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="0" data-name="Title" style="background-image: url(&quot;/web/image/tattoo_shop.img_custom_black_needle_image_20&quot;); background-size: cover;" data-resize-width="1920" data-mimetype="image/webp" data-gl-filter="inkwell">
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.46) 0%, rgb(0, 0, 0) 100%);"/>
                            <div class="container">
                                <h1 style="text-align: start;">
                                    <span class="o_rfs" style="font-size: clamp(8px, 1em + 6.3025vw, 400px);">CONTACT US</span>
                                </h1>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level pb88 pt72" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="mt-4 mt-lg-0 o_colored_level col-lg-8">
                                        <p>Want to discuss a Tattoo project that's closer to you? Send us a message and we'll get back to you.<br/><br/></p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name">
                                                            <label class="s_website_form_label" for="oywiqoywdwql" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Name</span>
                                                                <span class="s_website_form_mark">   *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="" id="oywiqoywdwql" data-fill-with="name" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="tel" data-translated-name="Phone Number">
                                                            <label class="s_website_form_label" for="og5pysdh2ees" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="phone" placeholder="" id="og5pysdh2ees" data-fill-with="phone" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="email" data-translated-name="Your Email">
                                                            <label class="s_website_form_label" for="ow6jmzilon08" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Email</span>
                                                                <span class="s_website_form_mark">   *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="ow6jmzilon08" data-fill-with="email" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="many2many" data-translated-name="This is regarding...">
                                                            <label class="s_website_form_label" for="obpet2bomimq" style="width: 200px;">
                                                                <span class="s_website_form_label_content">This is regarding...</span>
                                                            </label>
                                                            <div class="row s_col_no_resize s_col_no_bgcolor s_website_form_multiple" data-name="tag_ids" data-display="horizontal">
                                                                <div class="checkbox col-12 col-lg-4 col-md-6">
                                                                    <div class="form-check">
                                                                        <input type="checkbox" class="s_website_form_input form-check-input" id="obpet2bomimq0" name="tag_ids" value="*tattoo_tag*" data-fill-with="undefined" />
                                                                        <label class="form-check-label s_website_form_check_label" for="obpet2bomimq0">Tattoo</label>
                                                                    </div>
                                                                </div>
                                                                <div class="checkbox col-12 col-lg-4 col-md-6">
                                                                    <div class="form-check">
                                                                        <input type="checkbox" class="s_website_form_input form-check-input" id="obpet2bomimq1" name="tag_ids" value="*tattoo_removal_tag*" />
                                                                        <label class="form-check-label s_website_form_check_label" for="obpet2bomimq1">Tattoo removal</label>
                                                                    </div>
                                                                </div>
                                                                <div class="checkbox col-12 col-lg-4 col-md-6">
                                                                    <div class="form-check">
                                                                        <input type="checkbox" class="s_website_form_input form-check-input" id="obpet2bomimq2" name="tag_ids" value="*piercing_tag*" />
                                                                        <label class="form-check-label s_website_form_check_label" for="obpet2bomimq2">Piercing</label>
                                                                    </div>
                                                                </div>
                                                                <div class="checkbox col-12 col-lg-4 col-md-6">
                                                                    <div class="form-check">
                                                                        <input type="checkbox" class="s_website_form_input form-check-input" id="obpet2bomimq3" name="tag_ids" value="*general_question_tag*" />
                                                                        <label class="form-check-label s_website_form_check_label" for="obpet2bomimq3">General question</label>
                                                                    </div>
                                                                </div>
                                                                <div class="checkbox col-12 col-lg-4 col-md-6">
                                                                    <div class="form-check">
                                                                        <input type="checkbox" class="s_website_form_input form-check-input" id="obpet2bomimq4" name="tag_ids" value="*explorative_work_tag*" />
                                                                        <label class="form-check-label s_website_form_check_label" for="obpet2bomimq4">Explorative work</label>
                                                                    </div>
                                                                </div>
                                                                <div class="checkbox col-12 col-lg-4 col-md-6">
                                                                    <div class="form-check">
                                                                        <input type="checkbox" class="s_website_form_input form-check-input" id="obpet2bomimq5" name="tag_ids" value="*other_tag*" />
                                                                        <label class="form-check-label s_website_form_check_label" for="obpet2bomimq5">Other</label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="What are you looking for?">
                                                            <label class="s_website_form_label" for="o3nlsk844nqy" style="width: 200px;">
                                                                <span class="s_website_form_label_content">What are you looking for?</span>
                                                                <span class="s_website_form_mark">             *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="o3nlsk844nqy" data-fill-with="undefined" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="About yourself / More details about your request">
                                                            <label class="s_website_form_label" for="o40uxo2ec5j2" style="width: 200px;">
                                                                <span class="s_website_form_label_content">About yourself / More details about your request</span>
                                                                <span class="s_website_form_mark">             *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="o40uxo2ec5j2" rows="3" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="text" data-translated-name="Your availabilities">
                                                            <label class="s_website_form_label" for="ocibxaymy9et" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your availabilities</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="Your availabilities" placeholder="" id="ocibxaymy9et" rows="3" />
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="binary" data-translated-name="Reference design - If applicable">
                                                            <label class="s_website_form_label" for="olqiwpvmtk0o" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Reference design - If applicable</span>
                                                            </label>
                                                            <input type="file" class="form-control s_website_form_input" name="Reference design - If applicable" id="olqiwpvmtk0o" data-max-files-number="1" data-max-file-size="10" data-fill-with="undefined" />
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-center s_website_form_no_submit_label pt24" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label">
                                                                <br />
                                                            </div>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send">Submit</a>
                                                            <span id="s_website_form_result" class="me-2 small text-danger" />
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="mt-4 mt-lg-0 o_colored_level col-lg-4">
                                        <a href="mailto:info@blackneedle.example.com" class="o_translate_inline">info@blackneedle.example.com</a>
                                        <p class="lead">
                                            <br/>
                                            <a href="tel:+32%202%20290%2034%2090" class="o_translate_inline">+32 2 290 34 90</a>
                                        </p>
                                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Avenue+des+D%C3%A9port%C3%A9s+48,+1367+Ramillies,+Belgium" class="o_translate_inline">
                                            Avenue des déportés 48,<br/>
                                            1367 Ramillies
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_opening_hours_alt oe_img_bg o_bg_img_center o_bg_img_origin_border_box o_colored_level" style="background-image: url(&quot;/web/image/tattoo_shop.img_custom_black_needle_image_19&quot;);" data-snippet="s_opening_hours_alt" data-name="Opening Hours Alt" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp">
                            <div class="container-fluid">
                                <div class="row o_grid_mode" data-row-count="14">
                                    <div class="o_grid_item o_cc g-col-lg-4 o_colored_level o_cc5 g-height-5 col-lg-4" style="grid-area: 3 / 9 / 8 / 13; z-index: 1; --grid-item-padding-y: 32px; --grid-item-padding-x: 32px; background-color: rgba(0, 0, 0, 0.62);">
                                        <h2>Let's get in touch</h2>
                                        <p class="lead">
                                            <a href="mailto:info@blackneedle.example.com" class="o_translate_inline"><span class="text-o-color-3">info@blackneedle.example.com</span></a>
                                        </p>
                                        <p class="lead"><a href="tel:+32%202%20290%2034%2090" class="o_translate_inline"><span class="text-o-color-3">+32 2 290 34 90</span></a></p><p class="lead"><a href="https://www.google.com/maps/search/?api=1&amp;query=Avenue+des+D%C3%A9port%C3%A9s+48,+1367+Ramillies,+Belgium" class="o_translate_inline"><span class="text-o-color-3">Avenue des déportés 48</span><br/><span class="text-o-color-3">1367 Ramillies</span></a></p>
                                    </div>
                                    <div class="o_grid_item o_cc g-height-7 g-col-lg-4 col-lg-4 o_colored_level o_cc5" style="grid-area: 8 / 9 / 15 / 13; z-index: 2; --grid-item-padding-y: 32px; --grid-item-padding-x: 32px; background-color: rgba(0, 0, 0, 0.62);">
                                        <div class="row s_col_no_bgcolor">
                                            <div class="col-6 col-lg-6">
                                                <p class="o_small-fs"><u>Monday</u><br/>8.00am-6.00pm</p>
                                                <p class="o_small-fs"><u>Tuesday</u><br/>8.00am-6.00pm</p>
                                                <p class="o_small-fs"><u>Wednesday</u><br/>8.00am-12.00pm</p>
                                                <p class="o_small-fs"><u>Thursday</u><br/>8.00am-6.00pm</p>
                                            </div>
                                            <div class="col-6 col-lg-6">
                                                <p class="o_small-fs"><u>Friday</u><br/>8.00am-6.00pm</p>
                                                <p class="o_small-fs"><u>Saturday</u><br/>8.00am-6.00pm</p>
                                                <p class="o_small-fs"><u>Sunday</u><br/>Closed</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('tattoo_shop.website_industry').id).viewref('tattoo_shop.view_page_contactus').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('tattoo_shop.view_page_contactus').arch.replace(
                '*tattoo_tag*', str(obj().env.ref('tattoo_shop.crm_tag_1').id)).replace(
                '*tattoo_removal_tag*', str(obj().env.ref('tattoo_shop.crm_tag_2').id)).replace(
                '*piercing_tag*', str(obj().env.ref('tattoo_shop.crm_tag_3').id)).replace(
                '*general_question_tag*', str(obj().env.ref('tattoo_shop.crm_tag_4').id)).replace(
                '*explorative_work_tag*', str(obj().env.ref('tattoo_shop.crm_tag_5').id)).replace(
                '*other_tag*', str(obj().env.ref('sales_team.categ_oppor8').id)
            )}"/>
    </function>

    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value eval="'crm.lead'"/>
        <value eval="['tag_ids']"/>
    </function>
</odoo>
