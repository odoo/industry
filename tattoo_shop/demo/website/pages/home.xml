    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('tattoo_shop.website_industry').id).viewref('tattoo_shop.view_page_home').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('tattoo_shop.view_page_home').arch.replace(
                '*book_session*', str(obj().env.ref('tattoo_shop.appointment_type_1').id)).replace(
                '*book_piercing*', str(obj().env.ref('tattoo_shop.appointment_type_2').id)).replace(
                '*appointments_filter*', str(obj().env.ref('website_appointment.website_snippet_filter_appointments').id)
            )}"/>
    </function>

