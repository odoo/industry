<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_about_us" model="ir.ui.view">
        <field name="name">About Us</field>
        <field name="key">tattoo_shop.page_about_us</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="About Us" t-name="tattoo_shop.page_about_us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="s_hero_minimalist pt80 pb80 o_colored_level o_cc o_cc5" data-snippet="s_hero_minimalist" data-name="Hero Minimalist">
                            <div class="container s_allow_columns">
                                <div class="row align-items-end">
                                    <div class="col-lg-7 o_colored_level o_animate o_anim_fade_in o_animate_both_scroll" style="animation-name: dummy;">
                                        <h2 class="display-2-fs">Nothing ordinary belongs on your skin.</h2>
                                    </div>
                                    <div class="col-lg-4 offset-lg-1 o_colored_level o_animate o_animate_on_scroll o_anim_fade_in o_animate_out" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <div>At Black Needle, every tattoo begins with a story. We combine creativity, craftsmanship, and a personal approach to create pieces that feel uniquely yours — made to last, made to mean something.</div>
                                    </div>
                                    <div class="col-lg-12 pt80 o_colored_level">
                                        <img src="/web/image/tattoo_shop.img_custom_black_needle_image_10" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id o_animate o_animate_on_scroll o_anim_fade_in o_animate_out" data-format-mimetype="image/webp" data-resize-width="1280" data-mimetype="image/webp" loading="eager" data-scroll-zone-start="0" data-scroll-zone-end="100"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_image_text_box o_colored_level pb80 pt88 o_cc o_cc5" data-snippet="s_image_text_box" data-name="Image Text Box">
                            <div class="container">
                                <div class="row o_grid_mode" style="column-gap: 24px;" data-row-count="16">
                                    <div class="o_colored_level g-col-lg-6 o_grid_item_image o_grid_item g-height-16 col-lg-6" style="grid-area: 1 / 1 / 17 / 7; z-index: 1; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; order: 2;">
                                        <img src="/web/image/tattoo_shop.img_custom_black_needle_image_18" alt="" class="img img-fluid order-lg-0 o_editable_media o_we_custom_image o_attachment_pending_record_id o_animate o_animate_on_scroll o_anim_fade_in o_animating" style="visibility: visible; animation-delay: -0.933942s;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="eager"/>
                                    </div>
                                    <div class="o_cc o_colored_level rounded o_cc1 order-lg-0 g-col-lg-6 o_grid_item g-height-16 col-lg-6" style="grid-area: 1 / 7 / 17 / 13; z-index: 2; order: 1; --grid-item-padding-y: 30px; --grid-item-padding-x: 30px; --box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px;">
                                        <h2>
                                            <span style="font-size: 40px;">A </span>
                                            <span style="font-size: 40px; --text-highlight-color: var(--o-color-2); --text-highlight-width: NaNpx;" class="o_text_highlight o_text_highlight_strikethrough">studio</span>
                                            <span style="font-size: 40px;"> built around originality, craft, and respect.</span>
                                        </h2>
                                        <div>
                                            <br />
                                        </div>
                                        <div>Black Needle is a space for people who want something personal — not something pulled from a catalogue. We believe tattooing is an art form, and every piece we create should have its own identity.</div>
                                        <div>
                                            <br />
                                        </div>
                                        <div>Our artists work closely with each client to develop original, custom designs inspired by your ideas, your references, and your vision. We don’t copy another artist’s work or reproduce someone else’s tattoo. Instead, we take inspiration and transform it into something uniquely yours.</div>
                                        <div>
                                            <br />
                                        </div>
                                        <p class="mb-0">Behind the work, we care just as much about the experience. Black Needle is a welcoming, judgement-free, and respectful space where everyone should feel comfortable being themselves. Whether it’s your first tattoo or your fiftieth, you can expect honest advice, clear communication, and a professional approach from start to finish.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_key_benefits o_colored_level pb64 pt80" data-snippet="s_key_benefits" data-name="Key benefits">
                            <div class="container">
                                <h2 class="display-3-fs" style="text-align: center;">What We <span class="o_text_highlight o_text_highlight_strikethrough" style="--text-highlight-color: var(--o-color-2); --text-highlight-width: 2px;">Stand For</span></h2>
                                <div class="row">
                                    <div class="pt48 pb24 o_colored_level col-lg-4 o_animate o_animate_on_scroll o_anim_fade_in" style="text-align: center; --wanim-intensity: 15;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <span class="display-3-fs text-o-color-1 o_text_highlight o_text_highlight_strikethrough" style="--text-highlight-color: var(--o-color-2); --text-highlight-width: 2px;">O1</span><h3 style="text-align: center;">Original Work</h3>
                                        <p style="text-align: center;">Every tattoo is custom-made. We create original designs rather than copying existing tattoos or another artist’s work.</p>
                                    </div><div class="pt48 pb24 col-lg-4 o_colored_level o_animate o_animate_on_scroll o_anim_fade_in" style="text-align: center; --wanim-intensity: 15;" data-scroll-zone-start="20%" data-scroll-zone-end="100">
                                        <span class="display-3-fs text-o-color-1 o_text_highlight o_text_highlight_strikethrough" style="--text-highlight-color: var(--o-color-2); --text-highlight-width: 2px;">O2</span><h3 style="text-align: center;">A Safe Space</h3>
                                        <p style="text-align: center;">Everyone is welcome at Black Needle. We’re committed to creating a respectful, inclusive, and judgement-free environment.</p>
                                    </div><div class="pt48 pb24 col-lg-4 o_colored_level o_animate o_animate_on_scroll o_anim_fade_in" style="text-align: center; --wanim-intensity: 15;" data-scroll-zone-start="30%" data-scroll-zone-end="100">
                                        <span class="display-3-fs text-o-color-1 o_text_highlight o_text_highlight_strikethrough" style="--text-highlight-color: var(--o-color-2); --text-highlight-width: 2px;">O3</span><h3 style="text-align: center;">Built to Last</h3>
                                        <p style="text-align: center;">We design with longevity in mind, creating tattoos that are made to age well and remain something you’re proud to wear.</p>
                                    </div>


                                </div>
                            </div>
                        </section>
                        <section class="s_cover parallax s_parallax_is_fixed o_cc o_cc5 o_colored_level pb96 pt80" data-scroll-background-ratio="1" data-snippet="s_cover" data-name="Cover">
                            <span class="s_parallax_bg_wrap">
                                <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/tattoo_shop.img_custom_black_needle_image_17&quot;); background-position: 50% 75%;" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp"/>
                            </span>
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(0deg, rgb(0, 0, 0) 0%, rgba(0, 0, 0, 0.32) 100%);"/>
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-12 o_colored_level pb0 pt32">
                                        <h2 style="text-align: center;">Ready to get <span class="o_text_highlight o_text_highlight_strikethrough" style="--text-highlight-color: var(--o-color-2); --text-highlight-width: 2px;">inked</span> ?</h2>
                                        <p class="lead" style="text-align: center;">Have an idea in mind or simply want to talk it through?&amp;nbsp;<br/>Get in touch with Black Needle and let’s turn it into something worth keeping.</p>
                                        <p style="text-align: center;">
                                            <a class="mb-2 o_translate_inline btn btn-primary" href="/appointment">Book a session <img src="/web/image/tattoo_shop.img_custom_black_needle_image_01" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" loading="lazy"/></a>
                                            <a href="/contactus" class="btn btn-outline-secondary mb-2 o_translate_inline">Contact us <img src="/web/image/tattoo_shop.img_custom_black_needle_image_02" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" loading="lazy"/></a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_about_us" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_about_us"/>
            <field name="url">/about-us</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
