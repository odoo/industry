<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_portfolio" model="ir.ui.view">
        <field name="name">Portfolio</field>
        <field name="key">tattoo_shop.page_portfolio</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="tattoo_shop.page_portfolio">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block pt40 o_colored_level pb32" data-snippet="s_text_block" data-name="Text">
                            <div class="container s_allow_columns">
                                <h2 style="text-align: center;">Flash Tattoos</h2>
                            </div>
                        </section>
                        <section class="s_title o_colored_level pb0 pt0" data-vcss="001" data-snippet="s_title" data-name="Title">
                            <div class="container s_allow_columns">
                                <h4 style="text-align: center;">See something you like?</h4>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level pt0 pb0" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <p style="text-align: center;">
                                    <a class="btn btn-primary" href="/appointment/__EXPORT_FILTER_XMLID__tattoo_shop.appointment_type_1__EXPORT_FILTER_XMLID__">Book your Flash Tattoo session</a>
                                </p>
                            </div>
                        </section>
                        <section class="s_image_gallery o_spc-small o_masonry pt24 pb24 o_cc o_cc5 o_colored_level" data-vcss="002" data-columns="3" style="overflow: hidden;" data-snippet="s_images_wall" data-name="Images Wall">
                            <div class="container">
                                <div class="row s_nb_column_fixed">
                                    <div class="o_masonry_col o_snippet_not_selectable col-lg-4">
                                        <img class="img img-fluid d-block rounded" src="/web/image/tattoo_shop.configurator_1_library_image_03" data-index="0" data-name="Image" alt="" loading="lazy" data-mimetype="image/jpeg"/>
                                        <img class="img img-fluid d-block rounded" src="/web/image/tattoo_shop.configurator_1_library_image_10" data-index="3" data-name="Image" alt="" loading="lazy"/>
                                    </div>
                                    <div class="o_masonry_col o_snippet_not_selectable col-lg-4">
                                        <img class="img img-fluid d-block rounded" src="/web/image/tattoo_shop.configurator_1_library_image_13" data-index="1" data-name="Image" alt="" loading="lazy" data-mimetype="image/jpeg"/>
                                        <img class="img img-fluid d-block rounded" src="/web/image/tattoo_shop.configurator_1_library_image_05" data-index="4" data-name="Image" alt="" loading="lazy"/>
                                    </div>
                                    <div class="o_masonry_col o_snippet_not_selectable col-lg-4">
                                        <img class="img img-fluid d-block rounded" src="/web/image/tattoo_shop.configurator_1_library_image_14" data-index="2" data-name="Image" alt="" loading="lazy" data-mimetype="image/jpeg"/>
                                        <img class="img img-fluid d-block rounded" src="/web/image/tattoo_shop.configurator_1_library_image_16" data-index="5" data-name="Image" alt="" loading="lazy" data-mimetype="image/jpeg"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_portfolio" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_portfolio"/>
            <field name="url">/flash-tattoos</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
