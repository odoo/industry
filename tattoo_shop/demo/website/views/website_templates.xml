<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="template_footer_minimalist" model="ir.ui.view">
        <field name="name">Black Needle - Minimalist</field>
        <field name="key">website.template_footer_minimalist</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pt40 pb40 o_cc5" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-2 offset-lg-0 col-8 offset-2 pt16 pb16 o_colored_level">
                                    <a href="/" class="o_footer_logo logo">
                                        <img src="/web/image/tattoo_shop.img_custom_black_needle_image_21" alt="Black Needle Tattoo Studio" class="img-fluid d-block mx-auto img o_we_custom_image o_attachment_pending_record_id" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="col-lg-8 pt16 pb16 o_colored_level">
                                    <nav class="nav align-items-center justify-content-center flex-column flex-lg-row">
                                        <a class="nav-link" href="/"><span class="text-o-color-4">Home</span></a>
                                        <a class="nav-link" href="/about-us"><span class="text-o-color-4">About us</span></a>
                                        <a class="nav-link" href="/residents"><span class="text-o-color-4">Residents</span></a>
                                        <a class="btn btn-secondary" href="/appointment">Book a session</a>
                                    </nav>
                                </div>
                                <div class="col-lg-2 pt16 pb16 o_colored_level">
                                    <div class="s_social_media o_not_editable no_icon_color text-end" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank">
                                            <i class="oi o_editable_media o_sm_custom_size oi-stack" data-icon="oi_instagram" style="--oi-icon-size: 2.75rem;"/>
                                        </a>
                                        <a href="https://www.example.com" target="_blank" aria-label="example">
                                            <i class="oi o_editable_media o_sm_custom_size oi-stack" data-icon="oi_youtube" style="--oi-icon-size: 2.75rem;"/>
                                        </a>
                                        <a href="https://www.example.com" target="_blank" aria-label="example">
                                            <i class="oi o_editable_media o_sm_custom_size oi-stack" data-icon="oi_tiktok" style="--oi-icon-size: 2.75rem;"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Black Needle - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/appointment/*book_session*" class="btn btn-primary btn_cta me-2">Book your tattoo</a>
                                <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta">Contact Us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('tattoo_shop.website_industry').id).viewref('tattoo_shop.header_call_to_action').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('tattoo_shop.header_call_to_action').arch.replace(
                '*book_session*', str(obj().env.ref('tattoo_shop.appointment_type_1').id)
            )}"/>
    </function>
    <record id="website_calendar_index_topbar" model="ir.ui.view">
        <field name="name">Black Needle - Appointment Topbar</field>
        <field name="inherit_id" ref="website_appointment.website_calendar_index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//h1" position="replace">
                <h1 class="mb-0"><span style="font-size: 40px;">Choose your appointment</span></h1>
            </xpath>
        </field>
    </record>
</odoo>
