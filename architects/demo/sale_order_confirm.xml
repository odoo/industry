            'name': 'Courtyard Studio',
            'stage_id': ref('project.project_project_stage_2'),
            'x_associated_location': ref('site_courtyard_studio'),
            'x_project_reference': 'Courtyard Studio',
            'x_progress_approver': ref('res_partner_21'),
        }"/>
    </function>
    <function model="project.project" name="write">
        <value model="sale.order.line" eval="obj().browse(ref('sale_order_line_12')).task_id.project_id.ids"/>
        <value eval="{
            'name': 'Riverside House',
            'stage_id': ref('project.project_project_stage_2'),
            'x_associated_location': ref('site_riverside_house'),
            'x_project_reference': 'Riverside House',
            'x_progress_approver': ref('res_partner_20'),
        }"/>
    </function>
    <function model="project.task" name="write">
        <value model="sale.order.line" eval="obj().browse(ref('sale_order_line_14')).task_id.ids"/>
        <value eval="{'stage_id': ref('task_stage_internal_review')}"/>
    </function>
</odoo>
