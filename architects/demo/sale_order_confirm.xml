    <function model="sale.order" name="action_confirm" eval="[[ref('sale_order_2'), ref('sale_order_4')]]"/>
    <function model="crm.lead" name="action_set_won" eval="[[ref('crm_lead_7'), ref('crm_lead_9')]]"/>
    <function model="project.project" name="write">
        <value model="sale.order.line" eval="obj().browse(ref('sale_order_line_4')).task_id.project_id.ids"/>
