<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1" context="{'no_mail_to_attendees': True, 'mail_notify_force_send': False, 'mail_activity_quick_update': True}">
    <record id="calendar_event_canal_house" model="calendar.event">
        <field name="name">Canal House — extension consultation</field>
        <field name="appointment_type_id" ref="appointment_type_1"/>
        <field name="appointment_booker_id" ref="res_partner_13"/>
        <field name="opportunity_id" ref="crm_lead_2"/>
        <field name="res_model_id" ref="crm.model_crm_lead"/>
        <field name="res_id" ref="crm_lead_2"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="partner_ids" eval="[Command.set([ref('res_partner_13'), ref('base.partner_admin')])]"/>
        <field name="start" model="appointment.type" eval="(DateTime.today() + relativedelta(days=7 - DateTime.today().weekday())).replace(hour=10, minute=0, second=0, microsecond=0, tzinfo=pytz.timezone(obj().browse(ref('appointment_type_1')).appointment_tz)).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="stop" model="appointment.type" eval="(DateTime.today() + relativedelta(days=7 - DateTime.today().weekday())).replace(hour=10, minute=30, second=0, microsecond=0, tzinfo=pytz.timezone(obj().browse(ref('appointment_type_1')).appointment_tz)).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="description" type="html">
            <p>Ask Léa for existing plans and garden photographs. Discuss the route to the site, daylight and likely constraints at the property boundary. Agree the deliverables and cost of the next scoping step.</p>
        </field>
    </record>
</odoo>
