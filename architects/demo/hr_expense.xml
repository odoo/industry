<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_notify_force_send': False, 'mail_activity_quick_update': True}">
    <record id="hr_expense_1" model="hr.expense">
        <field name="name">Courtyard Studio — site survey round trip</field>
        <field name="employee_id" ref="employee_designer_demo"/>
        <field name="manager_id" ref="base.user_admin"/>
        <field name="sale_order_id" ref="sale_order_2"/>
        <field name="product_id" ref="product_product_40"/>
        <field name="payment_mode">own_account</field>
        <field name="date" eval="DateTime.today().date() - relativedelta(days=12)"/>
        <field name="quantity">60</field>
        <field name="total_amount">27</field>
        <field name="tax_ids" eval="[Command.clear()]"/>
        <field name="analytic_distribution" model="sale.order.line" eval="{str(obj().browse(ref('sale_order_line_4')).task_id.project_id.account_id.id): 100}"/>
        <field name="description">Michael drove 60 km for the site survey. The expense is 27 in company currency. The client agreed to the sales rate of 0.90 per km under Courtyard Studio.</field>
    </record>
</odoo>
