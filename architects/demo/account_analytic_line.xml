<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="account_analytic_line_2" model="account.analytic.line">
        <field name="name">Courtyard Studio — survey existing conditions and review zoning</field>
        <field name="employee_id" ref="employee_designer_demo"/>
        <field name="task_id" model="sale.order.line" eval="obj().browse(ref('sale_order_line_4')).task_id.id"/>
        <field name="project_id" model="sale.order.line" eval="obj().browse(ref('sale_order_line_4')).task_id.project_id.id"/>
        <field name="so_line" ref="sale_order_line_4"/>
        <field name="unit_amount">4</field>
        <field name="date" eval="DateTime.today().date() - relativedelta(days=12)"/>
    </record>
    <record id="account_analytic_line_3" model="account.analytic.line">
        <field name="name">Courtyard Studio — model daylight and render the courtyard</field>
        <field name="employee_id" ref="employee_designer_demo"/>
        <field name="task_id" model="sale.order.line" eval="obj().browse(ref('sale_order_line_5')).task_id.id"/>
        <field name="project_id" model="sale.order.line" eval="obj().browse(ref('sale_order_line_5')).task_id.project_id.id"/>
        <field name="unit_amount">3</field>
        <field name="date" eval="DateTime.today().date() - relativedelta(days=8)"/>
    </record>
    <record id="account_analytic_line_7" model="account.analytic.line">
        <field name="name">Riverside House — model insulation and estimate energy demand</field>
        <field name="employee_id" ref="employee_designer_demo"/>
        <field name="task_id" model="sale.order.line" eval="obj().browse(ref('sale_order_line_12')).task_id.id"/>
        <field name="project_id" model="sale.order.line" eval="obj().browse(ref('sale_order_line_12')).task_id.project_id.id"/>
        <field name="so_line" ref="sale_order_line_12"/>
        <field name="unit_amount">5</field>
        <field name="date" eval="DateTime.today().date() - relativedelta(days=6)"/>
    </record>
    <record id="account_analytic_line_8" model="account.analytic.line">
        <field name="name">Riverside House — inspect insulation and record airtightness observations</field>
        <field name="employee_id" ref="employee_designer_demo"/>
        <field name="task_id" model="sale.order.line" eval="obj().browse(ref('sale_order_line_13')).task_id.id"/>
        <field name="project_id" model="sale.order.line" eval="obj().browse(ref('sale_order_line_13')).task_id.project_id.id"/>
        <field name="so_line" ref="sale_order_line_13"/>
        <field name="unit_amount">2</field>
        <field name="date" eval="DateTime.today().date() - relativedelta(days=3)"/>
    </record>
    <function model="account.analytic.line" name="action_validate_timesheet" eval="[[
        ref('account_analytic_line_2'), ref('account_analytic_line_3'),
        ref('account_analytic_line_7'), ref('account_analytic_line_8'),
    ]]"/>
</odoo>
