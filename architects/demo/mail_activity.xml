<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True, 'mail_notify_force_send': False, 'mail_activity_quick_update': True}">
    <function model="project.task" name="write">
        <value model="sale.order" eval="obj().browse([
            ref('sale_order_2'),
            ref('sale_order_4'),
            ref('sale_order_phase_workflow_demo'),
            ref('sale_order_cost_fee_demo'),
        ]).order_line.task_id.ids"/>
        <value eval="{'user_ids': [Command.link(ref('base.user_admin'))]}"/>
    </function>
    <record id="activity_cedar_works_client_review" model="mail.activity">
        <field name="res_model_id" ref="project.model_project_task"/>
        <field name="res_id" model="sale.order.line" eval="obj().browse(ref('sale_line_phase_workflow_demo')).task_id.id"/>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="summary">Record Joanna’s decision on the drawing package</field>
        <field name="date_deadline" eval="DateTime.today().date() + relativedelta(days=3)"/>
        <field name="note" type="html">
            <p>Open the client review subtask and compare the floor plans in Documents with the agreed brief. Record Joanna’s written acceptance or list the requested changes. After written acceptance and release, mark the linked technical package milestone as reached.</p>
        </field>
    </record>
    <record id="activity_riverside_declaration" model="mail.activity">
        <field name="res_model_id" ref="project.model_project_task"/>
        <field name="res_id" model="sale.order.line" eval="obj().browse(ref('sale_order_line_14')).task_id.id"/>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="summary">Review the energy declaration before release</field>
        <field name="date_deadline" eval="DateTime.today().date() + relativedelta(days=2)"/>
        <field name="note" type="html">
            <p>Compare the study and site-visit findings with the declaration. Record the agreed release, reach the declaration milestone, then review invoiceable hours and the declaration fee on the Riverside House sales order.</p>
        </field>
    </record>
</odoo>
