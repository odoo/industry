<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True, 'mail_notify_force_send': False}">
    <!-- The client accepted the renderings before the first interim invoice. -->
    <function model="project.milestone" name="write">
        <value model="sale.order.line" eval="obj().browse(ref('sale_order_line_5')).task_id.milestone_id.ids"/>
        <value eval="{'is_reached': True, 'deadline': DateTime.today().date()}"/>
    </function>
    <function model="project.task" name="write">
        <value model="sale.order.line" eval="obj().browse(ref('sale_order_line_5')).task_id.ids"/>
        <value eval="{'stage_id': ref('project_task_type_15'), 'state': '1_done'}"/>
    </function>
    <function model="sale.order" name="_create_invoices" eval="[[ref('sale_order_2')]]"/>
    <function model="account.move" name="action_post">
        <value model="sale.order" eval="obj().browse(ref('sale_order_2')).invoice_ids.ids"/>
    </function>
</odoo>
