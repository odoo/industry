<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="pricelist_architecture_services" model="product.pricelist">
        <field name="name">Architecture Services</field>
        <field name="company_id" model="res.company" eval="obj().env.company.id"/>
        <field name="currency_id" model="res.company" eval="obj().env.company.currency_id.id"/>
    </record>
    <record id="pricelist_additional_design_work_hourly" model="product.pricelist.item">
        <field name="pricelist_id" ref="pricelist_architecture_services"/>
        <field name="product_tmpl_id" model="product.product" eval="obj().browse(ref('product_additional_design_work')).product_tmpl_id.id"/>
        <field name="compute_price">fixed</field>
        <field name="fixed_price">110</field>
    </record>
</odoo>
