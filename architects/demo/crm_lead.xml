<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True, 'mail_notify_force_send': False, 'mail_activity_quick_update': True}">
    <record id="crm_lead_1" model="crm.lead">
        <field name="name">Linden Apartment — new enquiry</field>
        <field name="type">opportunity</field>
        <field name="stage_id" ref="crm.stage_lead1"/>
        <field name="team_id" ref="crm_team_architecture"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="partner_id" ref="res_partner_10"/>
        <field name="x_project_type">design</field>
        <field name="x_site_address">Ixelles, Brussels</field>
        <field name="x_budget_range">60,000–85,000 EUR excluding VAT</field>
        <field name="x_project_brief">Camille wants to open the kitchen onto the living room and add a workspace while keeping the original flooring.</field>
        <field name="x_request_date" eval="DateTime.today().date()"/>
        <field name="x_project_expected_start_date" eval="DateTime.today().date() + relativedelta(months=3)"/>
        <field name="description" type="html">
            <p>Start here for the first-contact walkthrough. Open the scheduled call and confirm the building constraints, budget and decision maker with Camille. Complete the call, then move the enquiry to Needs Analysis to see the brief-review activity.</p>
        </field>
    </record>
    <record id="crm_lead_2" model="crm.lead">
        <field name="name">Canal House — extension consultation</field>
        <field name="type">opportunity</field>
        <field name="stage_id" ref="crm_stage_5"/>
        <field name="team_id" ref="crm_team_architecture"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="partner_id" ref="res_partner_13"/>
        <field name="x_project_type">design</field>
        <field name="x_site_address">Laeken, Brussels</field>
        <field name="x_budget_range">110,000–140,000 EUR excluding VAT</field>
        <field name="x_project_brief">Léa wants a rear extension that connects the kitchen to the garden. Check access, daylight and the boundary with the adjoining property.</field>
        <field name="x_project_expected_start_date" eval="DateTime.today().date() + relativedelta(months=4)"/>
        <field name="description" type="html">
            <p>The first call is complete and a video consultation is booked. Open the meeting from this opportunity and review the brief. After the consultation, record constraints and agree whether to quote a feasibility study.</p>
        </field>
    </record>
    <record id="crm_lead_11" model="crm.lead">
        <field name="name">Atelier North — office fit-out proposal</field>
        <field name="type">opportunity</field>
        <field name="stage_id" ref="crm.stage_lead3"/>
        <field name="team_id" ref="crm_team_architecture"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="partner_id" ref="res_partner_22"/>
        <field name="x_project_type">design</field>
        <field name="x_site_address">Anderlecht, Brussels</field>
        <field name="x_budget_range">90,000–120,000 EUR excluding VAT</field>
        <field name="expected_revenue">1800</field>
        <field name="x_project_brief">Atelier North requested a feasibility study and two layouts for a workspace with a materials library and a client meeting room.</field>
        <field name="description" type="html">
            <p>Open the sent quotation and review its follow-up activity. Ask the client to confirm access to the premises and the scope of the two layout options before accepting the proposal.</p>
        </field>
    </record>

    <!-- These engagements are seeded after the first-contact stage. -->
    <data context="{'mail_activity_automation_skip': True}">
        <record id="crm_lead_7" model="crm.lead">
            <field name="name">Courtyard Studio — conversion and permits</field>
            <field name="type">opportunity</field>
            <field name="stage_id" ref="crm.stage_lead3"/>
            <field name="team_id" ref="crm_team_architecture"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="partner_id" ref="res_partner_21"/>
            <field name="x_project_type">design</field>
            <field name="x_site_address">Saint-Gilles, Brussels</field>
            <field name="x_budget_range">75,000–95,000 EUR excluding VAT</field>
            <field name="x_project_expected_start_date" eval="DateTime.today().date() - relativedelta(days=14)"/>
            <field name="x_project_brief">Convert the courtyard workshop into a studio. Survey the existing structure, deliver two concept views, then prepare the permit submission. Travel for the survey is separately chargeable.</field>
        </record>
        <record id="crm_lead_9" model="crm.lead">
            <field name="name">Riverside House — energy assessment</field>
            <field name="type">opportunity</field>
            <field name="stage_id" ref="crm.stage_lead3"/>
            <field name="team_id" ref="crm_team_architecture"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="partner_id" ref="res_partner_20"/>
            <field name="x_project_type">peb</field>
            <field name="x_site_address">Namur</field>
            <field name="x_project_brief">Assess a house before insulation and ventilation upgrades. Compare the survey and model findings, then prepare the energy declaration for release.</field>
        </record>
        <record id="crm_lead_phase_workflow_demo" model="crm.lead">
            <field name="name">Cedar Works — technical package and layout revision</field>
            <field name="type">opportunity</field>
            <field name="stage_id" ref="crm.stage_lead3"/>
            <field name="team_id" ref="crm_team_architecture"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="partner_id" ref="res_partner_24"/>
            <field name="x_project_type">design</field>
            <field name="x_site_address">Laeken, Brussels</field>
            <field name="x_budget_range">100,000–150,000 EUR excluding VAT</field>
            <field name="x_project_expected_start_date" eval="DateTime.today().date() - relativedelta(weeks=1)"/>
            <field name="x_project_brief">Prepare drawings and specifications for the agreed office fit-out. Joanna also commissioned a separate layout revision after the scope was agreed. Release the technical package after Joanna confirms the drawing revision.</field>
        </record>
        <record id="crm_lead_13" model="crm.lead">
            <field name="name">Willow Farm — farmhouse renovation</field>
            <field name="type">opportunity</field>
            <field name="stage_id" ref="crm.stage_lead3"/>
            <field name="team_id" ref="crm_team_architecture"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="partner_id" ref="res_partner_17"/>
            <field name="x_project_type">design</field>
            <field name="x_site_address">Ramillies</field>
            <field name="expected_revenue">17500</field>
            <field name="x_project_expected_start_date" eval="DateTime.today().date() - relativedelta(days=28)"/>
            <field name="x_project_brief">Restore the farmhouse and adapt the barn as living space. Marie approved a fixed 5% fee on the agreed construction cost excluding VAT. A revised cost estimate adds structural work in the barn after the first two phases were invoiced.</field>
        </record>
    </data>
    <function model="crm.lead" name="activity_feedback">
        <value eval="[ref('crm_lead_2'), ref('crm_lead_11')]"/>
        <value eval="['mail.mail_activity_data_call']"/>
        <value name="feedback">Initial call complete. The next step is recorded on the opportunity.</value>
        <value name="only_automated" eval="False"/>
    </function>
</odoo>
