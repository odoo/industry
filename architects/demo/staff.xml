<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True, 'no_reset_password': True}">
    <record id="base_industry_data.res_users_7" model="res.users" forcecreate="0">
        <field name="tz">Europe/Brussels</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('project.group_project_user')), (4, ref('hr_timesheet.group_hr_timesheet_user')), (4, ref('planning.group_planning_user'))]"/>
    </record>
    <record id="employee_designer_demo" model="hr.employee">
        <field name="name">Michael Demo</field>
        <field name="user_id" ref="base_industry_data.res_users_7"/>
        <field name="work_email">michael.demo@yourcompany.example.com</field>
        <field name="job_title">Architectural Designer</field>
    </record>
    <function model="resource.resource" name="write">
        <value model="hr.employee" eval="obj().env.ref('architects.employee_designer_demo').resource_id.ids"/>
        <value eval="{'role_ids': [(4, ref('planning_role_1'))], 'default_role_id': ref('planning_role_1'), 'tz': 'Europe/Brussels'}"/>
    </function>
    <record id="role_architecture_enquiries" model="res.role">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="crm_team_architecture" model="crm.team">
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="role_architecture_lead" model="project.role">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="role_architecture_design" model="project.role">
        <field name="user_ids" eval="[(4, ref('base_industry_data.res_users_7'))]"/>
    </record>
</odoo>
