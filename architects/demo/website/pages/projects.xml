<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_projects" model="ir.ui.view">
        <field name="name">Projects</field>
        <field name="key">architects.page_projects</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <t t-name="architects.page_projects">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title o_colored_level o_cc o_cc5 pb0 pt104" data-vcss="001" data-snippet="s_title" data-name="Title">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="o_colored_level col-lg-12 pt96 d-lg-block d-none o_snippet_mobile_invisible" data-invisible="1">
                                        <p style="text-align: start;">
                                            <br />
                                        </p>
                                    </div>
                                    <div class="col-lg-12 o_colored_level">
                                        <h1 style="text-align: start;">
                                            <span class="display-3-fs">Our Projects</span>
                                        </h1>
                                        <div class="s_hr pb32 pt16" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-4);" />
                                        </div>
                                    </div>
                                    <div class="o_colored_level col-lg-4 col-12">
                                        <p style="text-align: start;">
                                            <span class="o_small-fs">Each home is a conversation between light, land, and the people who live there, shaped slowly, built with care, and designed to feel more beautiful with every passing season.</span>
                                            <br />
                                        </p>
                                    </div>
                                    <div class="o_colored_level col-lg-6 offset-lg-2 pt8 col-12 d-lg-block d-none o_snippet_mobile_invisible" data-invisible="1">
                                        <p style="text-align: end;">
                                            <a href="/appointment/*appointment_type_1*" class="o_translate_inline btn btn-sm btn-primary">Start your journey with us</a>
                                        </p>
                                    </div>
                                    <div class="col-lg-6 pt8 col-12 d-lg-none o_snippet_desktop_invisible o_colored_level" data-invisible="1">
                                        <p style="text-align: start;">
                                            <a href="/appointment/*appointment_type_1*" class="o_translate_inline btn btn-sm btn-primary">Start your journey with us</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_services_grid o_colored_level o_cc o_cc5 pt64 pb112" data-snippet="s_services_grid" data-name="Services Grid" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Nature/07&quot;,&quot;colors&quot;:{&quot;c1&quot;:&quot;#F4EFE608&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                            <div class="o_we_shape o_html_builder_Nature_07 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FNature%2F07.svg?c1=%23F4EFE608&quot;);" />
                            <div class="container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-6 o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-duration: 2.5s;">
                                        <p>
                                            <img src="/web/image/architects.img_architects_image_11" alt="Cabin House in Sicily, Italy" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="1/1" data-y="380.82055214723925" data-width="1280" data-height="1280" data-scale-x="1" data-scale-y="1" loading="lazy" src.translate="/web/image/architects.img_architects_image_11" />
                                        </p>
                                        <p>
                                            <span class="o_small-fs">
                                                Cabin House in Sicily, Italy<br />
                                                <span class="text-o-color-2">Site study and design</span>
                                            </span>
                                        </p>
                                    </div>
                                    <div class="o_colored_level col-lg-6 o_animate o_anim_fade_in o_anim_from_bottom pt32" style="animation-duration: 2.5s; --wanim-intensity: 6; animation-delay: 0.3s;">
                                        <p>
                                            <img src="/web/image/architects.img_architects_image_16" alt="Villa Serena in Lake Como, Italy" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy" data-aspect-ratio="1/1" data-y="192" data-width="1536" data-height="1536" data-scale-x="1" data-scale-y="1" src.translate="/web/image/architects.img_architects_image_16" />
                                        </p>
                                        <p>
                                            <span class="o_small-fs">
                                                Villa Serena in Lake Como, Italy<br />
                                                <span class="text-o-color-2">A to Z project, from original idea to handover</span>
                                            </span>
                                        </p>
                                    </div>
                                    <div class="o_colored_level col-lg-4 pt120 o_animate o_anim_fade_in o_anim_from_bottom" style="animation-duration: 2.5s; --wanim-intensity: 6;">
                                        <p>
                                            <img src="/web/image/architects.img_architects_image_14" alt="Dune House in Comporta, Portugal" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" data-aspect-ratio="0/0" data-y="294.7046763392857" data-width="1207" data-height="1508.7039732142857" data-scale-x="1" data-scale-y="1" loading="lazy" src.translate="/web/image/architects.img_architects_image_14" />
                                        </p>
                                        <p>
                                            <span class="o_small-fs">
                                                Dune House in Comporta, Portugal<br />
                                                <span class="text-o-color-2">Renovation and redesign of the staircase and living room</span>
                                            </span>
                                        </p>
                                    </div>
                                    <div class="o_colored_level col-lg-4 o_animate o_anim_fade_in o_anim_from_bottom pt32" style="animation-duration: 2.5s; --wanim-intensity: 6; animation-delay: 0.3s;">
                                        <p>
                                            <img src="/web/image/architects.img_architects_image_17" alt="Stone Terrace House in Mallorca, Spain" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy" src.translate="/web/image/architects.img_architects_image_17" />
                                        </p>
                                        <p>
                                            <span class="o_small-fs">
                                                Stone Terrace House in Mallorca, Spain<br />
                                                <span class="text-o-color-2">Concept, permits and construction</span>
                                            </span>
                                        </p>
                                    </div>
                                    <div class="o_colored_level col-lg-4 o_animate o_anim_fade_in o_anim_from_bottom pt120" style="animation-duration: 2.5s; animation-delay: 0.6s; --wanim-intensity: 6;">
                                        <p>
                                            <img src="/web/image/architects.img_architects_image_12" alt="Villa in Florida" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy" src.translate="/web/image/architects.img_architects_image_12" />
                                        </p>
                                        <p>
                                            <span class="o_small-fs">
                                                Villa in Florida<br />
                                                <span class="text-o-color-2">Original briefing and design</span>
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('architects.website_industry').id).viewref('architects.view_page_projects').id" />
        <value model="ir.ui.view" eval="{
        'arch': obj().env.ref('architects.view_page_projects').arch.replace(
            '*appointment_type_1*', str(obj().env.ref('architects.appointment_type_1').id))
        }" />
    </function>
    <data noupdate="1">
        <record id="page_projects" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_projects" />
            <field name="url">/projects</field>
            <field name="website_id" ref="website_industry" />
            <field name="is_published" eval="True" />
            <field name="website_indexed" eval="True" />
        </record>
    </data>
</odoo>
