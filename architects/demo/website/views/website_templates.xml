<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Copyright Company Name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name small" t-ignore="true">
                    © <span t-out="res_company.name"/>
                </span>
            </xpath>
            <xpath expr="//footer//div[@name='footer_copyright_col']" position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pb0 pt56" data-snippet="s_text_block" data-name="Container">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="pt24 o_colored_level pb0 col-6 border d-lg-block d-none o_snippet_mobile_invisible col-lg-6" style="border-color: rgba(34, 40, 40, 0) !important; --box-border-left-width: 5px; --box-border-bottom-width: 0px; --box-border-right-width: 5px; --box-border-top-width: 0px;" data-invisible="1">
                                    <ul class="list-unstyled">
                                        <li><a href="/aboutus">About</a></li>
                                        <li><a href="/projects">Projects</a></li>
                                        <li><a href="/contactus">Contact</a></li>
                                    </ul>
                                    <p>
                                        <a href="/appointment/*appointment_type_1*" class="o_translate_inline btn btn-primary">Meet with us</a>
                                    </p>
                                </div>
                                <div class="pt24 pb0 col-lg-3 border o_colored_level col-12 d-lg-none o_snippet_desktop_invisible" style="border-color: rgba(34, 40, 40, 0) !important; --box-border-left-width: 5px; --box-border-bottom-width: 0px; --box-border-right-width: 5px; --box-border-top-width: 0px;" data-invisible="1">
                                    <ul class="list-unstyled">
                                        <li><a href="/aboutus">About</a></li>
                                        <li><a href="/projects">Projects</a></li>
                                        <li><a href="/contactus">Contact</a></li>
                                    </ul>
                                    <p><a href="/appointment/*appointment_type_1*" class="o_translate_inline btn btn-primary">Meet with us</a></p>
                                </div>
                                <div class="o_colored_level pb24 col-lg-3 offset-lg-6 pt24 col-12 d-lg-none o_snippet_desktop_invisible" data-invisible="1">
                                    <div class="s_social_media o_not_editable no_icon_color text-start" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi o_editable_media oi-stack" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="oi o_editable_media oi-stack" data-icon="oi_x"/>
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                            <i class="oi o_editable_media oi-stack" data-icon="oi_linkedin"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="pb24 pt24 col-6 o_colored_level d-lg-block d-none o_snippet_mobile_invisible col-lg-6" data-invisible="1">
                                    <div class="s_social_media o_not_editable no_icon_color text-end" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi o_editable_media oi-stack" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="oi o_editable_media oi-stack" data-icon="oi_x"/>
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                            <i class="oi o_editable_media oi-stack" data-icon="oi_linkedin"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_colored_level pb0 col-lg-12 pt48 border" style="--box-border-left-width: 15px; --box-border-bottom-width: 0px; --box-border-right-width: 15px; --box-border-top-width: 0px; border-color: rgba(34, 40, 40, 0) !important;">
                                    <p>
                                        <img src="/web/image/architects.img_architects_image_08" alt="Archidukes" class="img img-fluid o_we_custom_image" style="width: 100% !important;" loading="lazy" src.translate="/web/image/architects.img_architects_image_08"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('architects.website_industry').id).viewref('architects.footer_custom').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('architects.footer_custom').arch.replace(
                '*appointment_type_1*', str(obj().env.ref('architects.appointment_type_1').id))
            }"/>
    </function>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level pb24 pt16" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/appointment/*appointment_type_1*" class="oe_unremovable btn btn-custom text-o-color-2" style="background-color: rgba(0, 0, 0, 0); border-width: 2px; border-style: solid; border-image: none; border-left-color: var(--o-color-2); border-bottom-color: var(--o-color-2); border-right-color: var(--o-color-2); border-top-color: var(--o-color-2);">Meet with us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('architects.website_industry').id).viewref('architects.header_call_to_action').id"/>
        <value model="ir.ui.view" eval="{
            'arch': obj().env.ref('architects.header_call_to_action').arch.replace(
                '*appointment_type_1*', str(obj().env.ref('architects.appointment_type_1').id))
            }"/>
    </function>
</odoo>
