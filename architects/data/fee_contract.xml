<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="product_fee_phase_schematic" model="product.product" forcecreate="0">
        <field name="name">Schematic Design — Construction-cost Fee</field>
        <field name="type">service</field>
        <field name="service_type">milestones</field>
        <field name="invoice_policy">delivery</field>
        <field name="service_tracking">task_in_project</field>
        <field name="project_template_id" ref="project_template_architecture_phases"/>
        <field name="task_template_id" ref="task_template_architecture_phase_schematic"/>
        <field name="x_arch_phase_stage_id" ref="task_stage_architecture_schematic"/>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="list_price">0</field>
        <field name="x_default_phase_percentage">20</field>
        <field name="description_sale">Contractual phase fee: construction cost excluding VAT × fixed fee rate × agreed phase allocation. Invoice when the linked milestone reaches its agreed condition. Later budget revisions produce separate fee adjustment lines for previously invoiced phases.</field>
    </record>
