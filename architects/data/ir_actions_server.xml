<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="create_activity_quote_server_action" model="ir.actions.server">
        <field name="name">Contact the new architecture enquiry</field>
        <field name="model_id" ref="crm.model_crm_lead" />
        <field name="base_automation_id" ref="base_automation_2" />
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_call" />
        <field name="activity_summary">Contact the new architecture enquiry</field>
        <field name="activity_note" type="html">
            <p>Confirm the client, site, scope, budget and desired start date. Arrange a consultation and record the next agreed action.</p>
        </field>
        <field name="activity_date_deadline_range">1</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">role</field>
        <field name="activity_role_id" ref="role_architecture_enquiries" />
        <field name="activity_user_field_name" eval="False" />
    </record>
    <record id="mark_opportunity_server_action" model="ir.actions.server">
        <field name="name">Review the architecture brief</field>
        <field name="model_id" ref="crm.model_crm_lead" />
        <field name="base_automation_id" ref="base_automation_3" />
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo" />
        <field name="activity_summary">Review the architecture brief</field>
        <field name="activity_note" type="html">
            <p>Review the brief, site constraints, budget and timing. Agree the services and exclusions before preparing a quotation.</p>
        </field>
        <field name="activity_date_deadline_range">10</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="action_quotation_sent" model="ir.actions.server">
        <field name="name">Follow up on the sent architecture quotation</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="base_automation_id" ref="automation_quotation_sent" />
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="activity_type_architecture_quotation_followup"/>
        <field name="activity_note" type="html">
            <p>Contact the client about this quotation, clarify outstanding questions and record the decision. Complete this activity when the quotation is accepted or declined.</p>
        </field>
        <field name="activity_date_deadline_range">15</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
</odoo>
