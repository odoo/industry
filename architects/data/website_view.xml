<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">architects.contactus</field>
        <field name="type">qweb</field>
        <field name="active" eval="True"/>
        <field name="website_id" ref="base.default_website"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="website.contactus">
                <t t-call="website.layout">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', '')}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure">
                        <section class="s_title_form o_cc o_cc2 pt64 pb64" data-snippet="s_title_form" data-name="Project enquiry">
                            <div class="o_container_small">
                                <h1>Tell us about your project</h1>
                                <p class="lead">Share your ideas, site, budget and timing so we can prepare a useful first conversation. Private homeowners and organizations are both welcome.</p>
                                <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Project enquiry form">
                                    <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                                        <div class="s_website_form_rows row">
                                            <div class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_contact_name"><span class="s_website_form_label_content">Your name</span><span class="s_website_form_mark"> *</span></label>
                                                <input class="form-control s_website_form_input" id="architecture_contact_name" name="contact_name" type="text" required="1" data-fill-with="name"/>
                                            </div>
                                            <div class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="email" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_email_from"><span class="s_website_form_label_content">Email</span><span class="s_website_form_mark"> *</span></label>
                                                <input class="form-control s_website_form_input" id="architecture_email_from" name="email_from" type="email" required="1" data-fill-with="email"/>
                                            </div>
                                            <div class="s_website_form_field mb-3 col-12" data-type="tel" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_phone"><span class="s_website_form_label_content">Phone</span></label>
                                                <input class="form-control s_website_form_input" id="architecture_phone" name="phone" type="tel" data-fill-with="phone"/>
                                            </div>
                                            <div class="s_website_form_field mb-3 col-12" data-type="char" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_partner_name"><span class="s_website_form_label_content">Company (if applicable)</span></label>
                                                <input class="form-control s_website_form_input" id="architecture_partner_name" name="partner_name" type="text" data-fill-with="commercial_company_name"/>
                                            </div>
                                            <div class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_name"><span class="s_website_form_label_content">Project title</span><span class="s_website_form_mark"> *</span></label>
                                                <input class="form-control s_website_form_input" id="architecture_name" name="name" type="text" required="1" placeholder="House extension, renovation, new office..."/>
                                            </div>
                                            <div class="s_website_form_field mb-3 col-12" data-type="selection" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_project_type"><span class="s_website_form_label_content">Service requested</span></label>
                                                <select class="form-select s_website_form_input" id="architecture_project_type" name="x_project_type">
                                                    <option value="">Please select</option>
                                                    <option value="design">Architectural design</option>
                                                    <option value="peb">Energy assessment</option>
                                                </select>
                                            </div>
                                            <div class="s_website_form_field mb-3 col-12" data-type="char" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_x_site_address"><span class="s_website_form_label_content">Project site address or area</span></label>
                                                <input class="form-control s_website_form_input" id="architecture_x_site_address" name="x_site_address" type="text"/>
                                            </div>
                                            <div class="s_website_form_field mb-3 col-12" data-type="char" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_x_budget_range"><span class="s_website_form_label_content">Indicative works budget and currency</span></label>
                                                <input class="form-control s_website_form_input" id="architecture_x_budget_range" name="x_budget_range" type="text" placeholder="Construction budget, separate from architecture fees"/>
                                            </div>
                                            <div class="s_website_form_field mb-3 col-12" data-type="date" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_x_project_expected_start_date"><span class="s_website_form_label_content">Desired start date</span></label>
                                                <input class="form-control s_website_form_input" id="architecture_x_project_expected_start_date" name="x_project_expected_start_date" type="date"/>
                                            </div>
                                            <div class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-name="Field">
                                                <label class="form-label s_website_form_label" for="architecture_project_brief"><span class="s_website_form_label_content">Tell us about the project and its constraints</span><span class="s_website_form_mark"> *</span></label>
                                                <textarea class="form-control s_website_form_input" id="architecture_project_brief" name="x_project_brief" rows="5" required="1"/>
                                            </div>
                                            <div class="s_website_form_submit col-12 text-end py-2" data-name="Submit Button">
                                                <span id="s_website_form_result"/>
                                                <a href="#" role="button" class="btn btn-primary s_website_form_send">Send project enquiry</a>
                                            </div>
                                        </div>
                                    </form>
                                </section>
                                <p class="mt-4 mb-1"><strong t-field="res_company.name"/></p>
                                <p t-if="res_company.email" class="mb-1"><a t-att-href="'mailto:' + res_company.email"><span t-field="res_company.email"/></a></p>
                                <p t-if="res_company.phone"><a t-att-href="'tel:' + res_company.phone"><span t-field="res_company.phone"/></a></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
