#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\">\n"
"                        <span style=\"font-size: 14px\">Learn more on how to "
"automate your business using <strong>Odoo Studio</strong></span>\n"
"                    </span>\n"
"                    <br/>"
msgstr ""
"<span style=\"font-size: 14px\">\n"
"                        <span style=\"font-size: 14px\">Preberite več o tem, "
"kako avtomatizirati svoje poslovanje z <strong>Odoo Studio</strong></span>\n"
"                    </span>\n"
"                    <br/>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\">\n"
"                <span style=\"font-size: 14px\">\n"
"                    It's the heart of your architectural work. It's where "
"you'll track the advancement of the various tasks,\n"
"                    generate new invoices (if needed), and assign tasks to "
"employees and contractors alike. Track your\n"
"                    timesheets, margins, purchase orders, and more using the "
"project menu to quickly access relevant information.\n"
"                </span>\n"
"            </span>"
msgstr ""
"<span style=\"font-size: 14px\">\n"
"                <span style=\"font-size: 14px\">\n"
"                    To je srce vašega arhitekturnega dela. Tu boste "
"spremljali napredovanje različnih opravil,\n"
"                    ustvarjali nove račune (če je potrebno) in dodeljevali "
"opravila zaposlenim in pogodbenikom. Spremljajte svoje\n"
"                    časovne izkaze, marže, nabavna naročila in drugo z "
"uporabo menija projekta za hiter dostop do ustreznih informacij.\n"
"                </span>\n"
"            </span>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\">\n"
"                <span style=\"font-size: 14px\">\n"
"                    Use the documents app to store and share all project "
"documents. Sub-workspaces get created for each project, and link to these "
"sub-workspace can be shared with customers so that they have a direct access "
"to all produced documents.\n"
"                </span>\n"
"            </span>"
msgstr ""
"<span style=\"font-size: 14px\">\n"
"                <span style=\"font-size: 14px\">\n"
"                    Uporabite aplikacijo Dokumenti za shranjevanje in "
"deljenje vseh projektnih dokumentov. Poddelovni prostori se ustvarijo za "
"vsak projekt, povezavo do teh poddelovnih prostorov pa lahko delite s "
"strankami, da imajo neposreden dostop do vseh nastalih dokumentov.\n"
"                </span>\n"
"            </span>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\">\n"
"                <span style=\"font-size: 14px\">A set of architectural "
"services have already been created and can be edited to match the "
"architects'\n"
"                    services.\n"
"                </span>\n"
"            </span>"
msgstr ""
"<span style=\"font-size: 14px\">\n"
"                <span style=\"font-size: 14px\">Nabor arhitekturnih storitev "
"je že ustvarjen in ga je mogoče urediti tako, da ustreza storitvam "
"arhitektov.\n"
"                    </span>\n"
"            </span>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\">\n"
"                The CRM App is designed to let architecture firms easily "
"manage new prospects, called \"Opportunities\" in Odoo. Track expected "
"revenue, manage communications, and never forget to reach out to interested "
"parties. Opportunities get created in the CRM by filling the \"Contact us\" "
"form on the website, or manually by a salesperson.\n"
"            </span>"
msgstr ""
"<span style=\"font-size: 14px\">\n"
"                Aplikacija CRM je zasnovana tako, da arhitekturnim podjetjem "
"omogoča enostavno upravljanje novih potencialnih strank, imenovanih "
"\"Priložnosti\" v Odoo. Spremljajte pričakovane prihodke, upravljajte "
"komunikacijo in nikoli ne pozabite vzpostaviti stika z zainteresiranimi "
"strankami. Priložnosti se v CRM ustvarijo z izpolnjevanjem obrazca "
"\"Kontaktirajte nas\" na spletni strani ali ročno s strani prodajalca.\n"
"            </span>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\"><span style=\"font-size: 14px\">Use the "
"Project Menu to quickly access</span></span>"
msgstr ""
"<span style=\"font-size: 14px\"><span style=\"font-size: 14px\">Uporabite "
"meni Projekt za hiter dostop</span></span>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\">A reminder to cancel the opportunity is "
"created when the quotation is sent</span>"
msgstr ""
"<span style=\"font-size: 14px\">Opomnik za preklic priložnosti je ustvarjen, "
"ko je ponudba poslana</span>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\">Create automated actions to never forget to "
"execute your next steps to keep your business growing, for\n"
"                        example:</span>"
msgstr ""
"<span style=\"font-size: 14px\">Ustvarite samodejna dejanja, da nikoli ne "
"pozabite izvesti svojih naslednjih korakov za rast vašega podjetja, na\n"
"                        primer:</span>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\">Once a quotation has been confirmed, a "
"project is automatically generated in the Project app, with associated "
"tasks.\n"
"            </span>"
msgstr ""
"<span style=\"font-size: 14px\">Ko je bil predračun potrjen, se v aplikaciji "
"Projekt samodejno ustvari projekt s pripadajočimi opravili.\n"
"            </span>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<span style=\"font-size: 14px\">When it's time to provide the customer with "
"an estimate, a quote can be created by clicking the \"New Quotation\"\n"
"                button on the opportunity. These can also be pre-filled "
"using the Quotation Template feature. Quotation\n"
"                Templates allow you to quickly choose a preset that contains "
"sections and their products - especially useful\n"
"                when you're working with similar, elaborate templates.\n"
"            </span>"
msgstr ""
"<span style=\"font-size: 14px\">Ko je čas, da stranki pripravite predračun, "
"lahko ponudbo ustvarite tako, da na priložnosti kliknete gumb \"Nova "
"ponudba\".\n"
"                Ponudbe lahko tudi vnaprej izpolnite s funkcijo Predloga "
"ponudbe. Predloge ponudb\n"
"                vam omogočajo, da hitro izberete vnaprej določeno predlogo, "
"ki vsebuje razdelke in njihove izdelke – še posebej uporabno\n"
"                ko delate s podobnimi, zapletenimi predlogami.\n"
"            </span>"

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
msgid ""
"<span style=\"font-size: 16px;\">\n"
"                This industry is made for architects that sell all kind of "
"architectural services such as feasibility studies, schematic design, design "
"development, worksite follow-up, energy efficiency assessment.\n"
"            </span>"
msgstr ""
"<span style=\"font-size: 16px;\">\n"
"                Ta panoga je namenjena arhitektom, ki ponujajo vse vrste "
"arhitekturnih storitev, kot so študije izvedljivosti, shematsko načrtovanje, "
"razvoj načrtov, spremljanje gradbišč in ocena energetske učinkovitosti.\n"
"            </span>"

