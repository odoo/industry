#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<b>CRM App</b>: Centralize client interactions to effectively manage leads "
"and convert design proposals into\n"
"                signed contracts."
msgstr ""
"<b>CRM Aplikacija</b>: Centralizirajte interakcije s strankami za učinkovito "
"upravljanje potencialnih strank in predlogov oblikovanja v\n"
"                podpisane pogodbe."

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<b>Documents App</b>: Securely organize, version, and share critical files "
"such as architectural drawings,\n"
"                permits, and blueprints."
msgstr ""
"<b>Dokumenti</b>: Varno organizirajte, vodite različice in delite ključne "
"datoteke, kot so arhitekturni načrti,\n"
"                dovoljenja in risbe."

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<b>Invoicing App</b>: Maintain healthy cash flow by billing clients flexibly "
"based on project milestones or\n"
"                actual time spent."
msgstr ""
"<b>Aplikacija za izstavitev računov</b>: Ohranite zdrav denarni tok s "
"prilagodljivim zaračunavanjem strankam na podlagi projektnih mejnikov ali\n"
"                dejanskega porabljenega časa."

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<b>Knowledge App</b>: Centralize design standards, building codes, and "
"internal guidelines to ensure consistency\n"
"                across the team."
msgstr ""
"<b>Aplikacija Znanje</b>: Centralizirajte standarde oblikovanja, gradbene "
"predpise in interne smernice za zagotavljanje doslednosti\n"
"                v celotni ekipi."

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<b>Project App</b>: Orchestrate complex architectural projects by managing "
"distinct phases like schematic\n"
"                design, development, and construction."
msgstr ""
"<b>Projektna aplikacija</b>: Koordinirajte kompleksne arhitekturne projekte "
"z upravljanjem različnih faz, kot so shematsko\n"
"                načrtovanje, razvoj, in gradnja."

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<b>Sales App</b>: Create professional proposals and contracts tailored for "
"architectural services, streamlining\n"
"                the agreement process."
msgstr ""
"<b>Prodajna aplikacija</b>: Ustvarite profesionalne ponudbe in pogodbe, "
"prilagojene arhitekturnim storitvam, ter poenostavite\n"
"                postopek sklenitve dogovora."

#. module: architects
#: model_terms:ir.ui.view,arch_db:architects.welcome_article_body
#, fuzzy
msgid ""
"<b>Timesheets App</b>: Ensure profitability by accurately tracking time "
"spent on design drafting, client\n"
"                meetings, and site visits."
msgstr ""
"<b>Aplikacija Časovnice</b>: Zagotovite donosnost z natančnim sledenjem "
"časa, porabljenega za izdelavo načrtov,\n"
"                sestanke s strankami in obiske lokacij."

