#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<span style=\"font-size: 36px;\"><strong>Yoga &amp; Pilates Studio</strong></"
"span>"
msgstr ""
"<span style=\"font-size: 36px;\"><strong>ສະຕູດິໂອ ໂຢຄະ &amp; ພິລາທິສ</strong></"
"span>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Appointments App</b>: </"
"font></strong><font class=\"text-black\">Enable clients to easily book their "
"favorite yoga or pilates classes online, reducing administrative friction.</"
"font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>ແອັບການນັດໝາຍ</b>: </font>"
"</strong><font class=\"text-black\">ຊ່ວຍໃຫ້ລູກຄ້າຈອງຄລາສໂຢຄະ ຫຼື ພິລາທິສທີ່ມັກຜ່ານທາງອອນລ"
"າຍໄດ້ງ່າຍຂຶ້ນ, ຫຼຸດຜ່ອນຂັ້ນຕອນການຈັດການເອກະສານ.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>CRM App</b>: </font></"
"strong><font class=\"text-black\">Convert drop-in visitors into long-term "
"members by tracking leads and nurturing relationships.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>ແອັບ CRM</b>: </font></"
"strong><font class=\"text-black\">ປ່ຽນລູກຄ້າທີ່ເຂົ້າມາທົດລອງຮຽນໃຫ້ເປັນສະມາຊິກໄລຍະຍາວ ໂດຍ"
"ການຕິດຕາມລູກຄ້າກຸ່ມເປົ້າໝາຍ ແລະ ສ້າງສາຍພົວພັນທີ່ດີ.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Employees App</b>: </"
"font></strong><font class=\"text-black\">Track instructor schedules and "
"manage their skills to ensure high-quality service delivery.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>ແອັບພະນັກງານ</b>: </font></"
"strong><font class=\"text-black\">ຕິດຕາມຕາຕະລາງຂອງຄູສອນ ແລະ ຈັດການທັກສະຄວາມຊຳນານ "
"ເພື່ອຮັບປະກັນການບໍລິການທີ່ມີຄຸນນະພາບສູງ.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Events App</b>: </font></"
"strong><font class=\"text-black\">Organize and manage special wellness "
"workshops or retreats to deeply engage your community.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>ແອັບກິດຈະກຳ</b>: </font></"
"strong><font class=\"text-black\">ຈັດຕັ້ງ ແລະ ຄຸ້ມຄອງກອງປະຊຸມສຳມະນາ ຫຼື ກິດຈະກຳພັກຜ່ອນດູແ"
"ລສຸຂະພາບພິເສດ ເພື່ອສ້າງການມີສ່ວນຮ່ວມກັບຊຸມຊົນຂອງທ່ານ.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Sales App</b>: </font></"
"strong><font class=\"text-black\">Simplify the process of selling "
"memberships, class packs, and merchandise with a unified system.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>ແອັບການຂາຍ</b>: </font></"
"strong><font class=\"text-black\">ເຮັດໃຫ້ຂະບວນການຂາຍສະມາຊິກ, ແພັກເກດຄລາສຮຽນ ແລະ ສິ"
"ນຄ້າຕ່າງໆງ່າຍຂຶ້ນ ດ້ວຍລະບົບດຽວທີ່ຄົບວົງຈອນ.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Subscription App</b>: </"
"font></strong><font class=\"text-black\">Secure revenue with automated "
"recurring billing for memberships like \"Unlimited Monthly Yoga.\"</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>ແອັບການສະໝັກສະມາຊິກ</b>: </"
"font></strong><font class=\"text-black\">ສ້າງລາຍຮັບທີ່ໝັ້ນຄົງດ້ວຍລະບົບຮຽກເກັບເງິນອັດຕະໂນມັ"
"ດແບບຕໍ່ເນື່ອງ ສຳລັບແພັກເກດສະມາຊິກ ເຊັ່ນ \"ໂຢຄະບໍ່ຈຳກັດລາຍເດືອນ\".</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Survey App</b>: </font></"
"strong><font class=\"text-black\">Gather valuable feedback from students to "
"ensure your classes and instructors meet their expectations.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>ແອັບສຳຫຼວດ</b>: </font></"
"strong><font class=\"text-black\">ເກັບກຳຄຳຄິດເຫັນທີ່ມີຄຸນຄ່າຈາກນັກຮຽນ ເພື່ອຮັບປະກັນວ່າຄລາສຮ"
"ຽນ ແລະ ຄູສອນຕອບສະໜອງໄດ້ຕາມຄວາມຄາດຫວັງຂອງພວກເຂົາ.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\">Planning App:</font></"
"strong> Efficiently assign instructors to classes based on their specific "
"skills, availability, and expertise."
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\">ແອັບການວາງແຜນ:</font></"
"strong> ຈັດສັນຄູສອນເຂົ້າແຕ່ລະຄລາສຮຽນຢ່າງມີປະສິດທິພາບ ຕາມທັກສະສະເພາະ, ເວລາຫວ່າງ ແລະ ຄວາມຊຳ"
"ນານ."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid "<strong>Assign Membership Levels Automatically</strong>"
msgstr "<strong>ກຳນົດລະດັບສະມາຊິກໂດຍອັດຕະໂນມັດ</strong>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Assign instructors automatically: </strong>With the <strong>auto-"
"plan</strong> option, instructors will be assigned to classes based on their "
"expertise and availability."
msgstr ""
