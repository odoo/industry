#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<span style=\"font-size: 36px;\"><strong>Yoga &amp; Pilates Studio</strong></"
"span>"
msgstr ""
"<span style=\"font-size: 36px;\"><strong>Студио за йога &amp; пилатес</"
"strong></span>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Appointments App</b>: </"
"font></strong><font class=\"text-black\">Enable clients to easily book their "
"favorite yoga or pilates classes online, reducing administrative friction.</"
"font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Приложение „Срещи“</b>: "
"</font></strong><font class=\"text-black\">Позволете на клиентите лесно да "
"резервират онлайн любимите си занятия по йога или пилатес и намалете "
"административната тежест.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>CRM App</b>: </font></"
"strong><font class=\"text-black\">Convert drop-in visitors into long-term "
"members by tracking leads and nurturing relationships.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Приложение CRM</b>: </"
"font></strong><font class=\"text-black\">Превръщайте посетителите с единични "
"посещения в дългосрочни членове чрез проследяване на потенциалните клиенти и "
"грижа за взаимоотношенията.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Employees App</b>: </"
"font></strong><font class=\"text-black\">Track instructor schedules and "
"manage their skills to ensure high-quality service delivery.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Приложение „Служители“</"
"b>: </font></strong><font class=\"text-black\">Проследявайте графиците на "
"инструкторите и управлявайте уменията им, за да гарантирате висококачествено "
"обслужване.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Events App</b>: </font></"
"strong><font class=\"text-black\">Organize and manage special wellness "
"workshops or retreats to deeply engage your community.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Приложение „Събития“</b>"
": </font></strong><font class=\"text-black\">Организирайте и управлявайте "
"специални работилници или ретрити за благополучие, за да ангажирате дълбоко "
"общността си.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Sales App</b>: </font></"
"strong><font class=\"text-black\">Simplify the process of selling "
"memberships, class packs, and merchandise with a unified system.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Приложение „Продажби“</b>"
": </font></strong><font class=\"text-black\">Опростете продажбата на "
"абонаменти, пакети занятия и стоки чрез единна система.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Subscription App</b>: </"
"font></strong><font class=\"text-black\">Secure revenue with automated "
"recurring billing for memberships like \"Unlimited Monthly Yoga.\"</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Приложение „Абонаменти“</"
"b>: </font></strong><font class=\"text-black\">Осигурете си стабилни приходи "
"чрез автоматично периодично таксуване за абонаменти като „Неограничена "
"месечна йога“.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Survey App</b>: </font></"
"strong><font class=\"text-black\">Gather valuable feedback from students to "
"ensure your classes and instructors meet their expectations.</font>"
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\"><b>Приложение „Анкети“</b>: "
"</font></strong><font class=\"text-black\">Събирайте ценна обратна връзка от "
"практикуващите, за да сте сигурни, че занятията и инструкторите отговарят на "
"очакванията им.</font>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong><font style=\"color: rgb(113, 75, 103)\">Planning App:</font></"
"strong> Efficiently assign instructors to classes based on their specific "
"skills, availability, and expertise."
msgstr ""
"<strong><font style=\"color: rgb(113, 75, 103)\">Приложение „Планиране“:</"
"font></strong> Разпределяйте ефективно инструкторите към занятията според "
"конкретните им умения, наличност и квалификация."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid "<strong>Assign Membership Levels Automatically</strong>"
msgstr "<strong>Автоматично присвояване на нивата на абонамент</strong>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Assign instructors automatically: </strong>With the <strong>auto-"
"plan</strong> option, instructors will be assigned to classes based on their "
"expertise and availability."
msgstr ""
"<strong>Автоматично разпределяне на инструкторите: </strong>С опцията "
"<strong>автоматично планиране</strong> инструкторите ще бъдат разпределяни "
"към занятията според квалификацията и наличността си."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Automate Renewals</strong><br/>\n"
"                    For recurring plans like monthly unlimited passes, "
"activate automatic renewal using the <strong>Subscriptions</strong> module."
msgstr ""
"<strong>Автоматизиране на подновяванията</strong><br/>\n"
"                    За периодични планове като месечните карти с неограничен "
"достъп активирайте автоматичното подновяване чрез модула <strong>Абонаменти</"
"strong>."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid "<strong>Basics</strong>"
msgstr "<strong>Основи</strong>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Create Your Products</strong><br/>\n"
"                    Set up flexible options for your clients:"
msgstr ""
"<strong>Създайте своите продукти</strong><br/>\n"
"                    Настройте гъвкави възможности за клиентите си:"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Create engaging events</strong>: Use the <strong>Events app</strong> "
"to organize and promote special sessions like prenatal yoga."
msgstr ""
"<strong>Създавайте увлекателни събития</strong>: използвайте приложението "
"<strong>Събития</strong>, за да организирате и популяризирате специални "
"сесии като йога за бременни."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Create private session products</strong>: Set up offerings like "
"\"Private Yoga Class – Group Session\" for tailored experiences."
msgstr ""
"<strong>Създавайте продукти за частни занятия</strong>: настройте "
"предложения като „Частно занятие по йога – групова сесия“ за изживявания по "
"мярка."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid "<strong>Create your Yoga and Pilates schedule:</strong>"
msgstr "<strong>Създайте своя график за йога и пилатес:</strong>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Customize the \"Contact Us\" form</strong>: Adjust on your Studio "
"Website, the form to handle specific requests such as corporate events or "
"wellbeing retreats."
msgstr ""
"<strong>Персонализирайте формата „Свържете се с нас“</strong>: на уебсайта "
"на студиото си адаптирайте формата, за да обслужва специфични запитвания "
"като корпоративни събития или ретрити за благополучие."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Define instructor expertise: </strong>In the <strong>Work "
"Information</strong> section of an employee, define employee's expertise by "
"using the <strong>Role</strong> field."
msgstr ""
"<strong>Определете квалификацията на инструкторите: </strong>В раздела "
"<strong>Информация за работата</strong> на служителя задайте квалификацията "
"му чрез полето <strong>Роля</strong>."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid "<strong>Do you want to go further?</strong>"
msgstr "<strong>Искате ли да продължите по-нататък?</strong>"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Enable easy online bookings</strong>: Utilize <strong>eCommerce "
"features</strong> to set up online booking and secure payment options for "
"classes."
msgstr ""
"<strong>Осигурете лесни онлайн резервации</strong>: използвайте <strong>"
"функциите за електронна търговия</strong>, за да настроите онлайн резервации "
"и сигурни начини на плащане за занятията."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Generate customized quotations:</strong> Use the \"Private Yoga "
"Class – Group Session (15+ People) Quotation Template\" to quickly create "
"tailored proposals for private or group bookings based on client requests."
msgstr ""
"<strong>Генерирайте персонализирани оферти:</strong> използвайте шаблона за "
"оферта „Частно занятие по йога – групова сесия (15+ души)“, за да създавате "
"бързо предложения по мярка за частни или групови резервации според заявките "
"на клиентите."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Manage Cancellations</strong><br/>\n"
"                    Set an end date for the subscription to close "
"automatically, or let clients cancel their subscription anytime via their "
"<strong>Odoo portal</strong>."
msgstr ""
"<strong>Управление на отказите</strong><br/>\n"
"                    Задайте крайна дата, за да се затвори абонаментът "
"автоматично, или позволете на клиентите да прекратят абонамента си по всяко "
"време през своя <strong>портал в Odoo</strong>."

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.welcome_article_body
msgid ""
"<strong>Present studio offerings</strong>: In the <strong>Website app</"
"strong>, showcase your wellbeing approach and membership options."
msgstr ""
"<strong>Представете предложенията на студиото</strong>: в приложението "
"<strong>Уебсайт</strong> покажете своя подход към благополучието и "
"възможностите за абонамент."

#. module: yoga_pilates
#: model_terms:event.event,description:yoga_pilates.event_event_2
msgid "<strong>Price:</strong> 40€"
msgstr "<strong>Цена:</strong> 40 €"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.ir_ui_view_3322
msgid "<strong>Price:</strong> €129/month"
msgstr "<strong>Цена:</strong> 129 €/месец"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.ir_ui_view_3322
msgid "<strong>Price:</strong> €220/hour"
msgstr "<strong>Цена:</strong> 220 €/час"

#. module: yoga_pilates
