msgid ""
"\"As a total beginner, I felt supported from day one. I love the community "
"here and can’t recommend the workshops enough!\""
msgstr ""
"«Я пришла совсем новичком, но с первого дня чувствовала заботу и поддержку. "
"Обожаю местное комьюнити и от всей души рекомендую!»"

#. module: yoga_pilates
#: model_terms:ir.ui.view,arch_db:yoga_pilates.view_page_home
