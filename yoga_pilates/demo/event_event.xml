<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="event_event_2" model="event.event">
        <field name="cover_properties"><![CDATA[{"background-image":"url(/web/image/yoga_pilates.ir_attachment_876)","background_color_class":"o_cc3 o_cc","opacity":"0.4","resize_class":"cover_auto o_record_has_cover"}]]></field>
        <field name="name">Nurture &amp; Flow</field>
        <field name="description"><![CDATA[<section class="s_text_block o_colored_level" data-name="Text">
            <p>Pregnancy is a time of transformation, both physically and emotionally. This prenatal yoga session is designed to support expectant mothers in building strength, relieving tension, and fostering a deep connection with their baby.</p><p>In this session, you will:</p><ul>
            <li>
            Learn gentle yoga postures to ease common pregnancy discomforts
            </li>
            <li>
            Practice breathing techniques to promote relaxation and prepare for birth
            </li>
            <li>
            Strengthen your body safely to support a growing belly
            </li>
            <li>
            Connect with other expectant mothers in a warm and supportive space
            </li>
            <li>
            End with a guided relaxation to leave you feeling nourished and empowered
            </li>
            </ul><p>Whether you're new to yoga or an experienced practitioner, this session offers a safe and soothing environment to honor your body’s needs during pregnancy.</p><p><strong>Price:</strong> $40</p>
            </section>]]>
        </field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="seats_max">16</field>
        <field name="seats_limited" eval="True"/>
        <field name="date_tz" model="res.users" eval="obj().env.ref('base.user_admin').tz or 'Europe/Brussels'"/>
        <field name="date_begin" model="res.users" eval="
            (DateTime.now().replace(hour=8, minute=00) + relativedelta(months=4, weekday=0)).replace(tzinfo=pytz.timezone(obj().env.ref('base.user_admin').tz or 'Europe/Brussels')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="date_end" model="res.users" eval="
            (DateTime.now().replace(hour=10, minute=00) + relativedelta(months=4, weekday=0)).replace(tzinfo=pytz.timezone(obj().env.ref('base.user_admin').tz or 'Europe/Brussels')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="country_id" ref="base.us"/>
        <field name="subtitle">Yoga for Vitality and Deep Relaxation</field>
        <field name="is_published" eval="True"/>
    </record>
