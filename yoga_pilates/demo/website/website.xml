<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="website_industry" model="website">
        <field name="name">Balance Yoga Studio</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="user_id" ref="base.public_user"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <!-- Leads are enabled: the "Contact Us" form creates leads to qualify in the Sales team. -->
        <field name="crm_default_team_id" ref="sales_team.team_sales_department"/>
        <field name="crm_default_user_id" ref="base.user_admin"/>
        <field name="show_line_subtotals_tax_selection">tax_included</field>
        <field name="logo" type="bytes" file="yoga_pilates/static/src/img/content/website/logo.svg"/>
        <field name="favicon" type="bytes" file="yoga_pilates/static/description/favicon.png"/>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[
        ('name', '=', 'default_website'),
        ('module', '=', 'base'),
        ('model', '=', 'website')]"/>
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
    <!-- The Default pricelist from data/ stays on the pre-existing website: copy it, with its
         subscription pricings, so that the memberships can be bought on this website too. -->
    <function name="copy" model="product.pricelist">
        <value model="product.pricelist" search="[('name', '=', 'Default')]"/>
        <value eval="{'name': 'Default', 'website_id': ref('website_industry')}"/>
    </function>
</odoo>
