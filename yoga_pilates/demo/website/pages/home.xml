    <!-- Event cards: dates of the demo events, relative to the install date -->
    <function model="ir.ui.view" name="write">
        <value eval="[ref('view_page_home')]"/>
        <value model="event.event" eval="(lambda arch, local, slug: {'arch': arch.replace(
            '*full_moon_date*', local('event_event_5', 'date_begin', '%d %B %Y')).replace(
            '*full_moon_begin*', local('event_event_5', 'date_begin', '%I:%M %p')).replace(
            '*full_moon_end*', local('event_event_5', 'date_end', '%I:%M %p')).replace(
            '*inversions_date*', local('event_event_3', 'date_begin', '%d %B %Y')).replace(
            '*inversions_begin*', local('event_event_3', 'date_begin', '%I:%M %p')).replace(
            '*inversions_end*', local('event_event_3', 'date_end', '%I:%M %p')).replace(
            '*breathwork_date*', local('event_event_4', 'date_begin', '%d %B %Y')).replace(
            '*breathwork_begin*', local('event_event_4', 'date_begin', '%I:%M %p')).replace(
            '*breathwork_end*', local('event_event_4', 'date_end', '%I:%M %p')).replace(
            '*meditation_date*', local('event_event_6', 'date_begin', '%d %B %Y')).replace(
            '*meditation_begin*', local('event_event_6', 'date_begin', '%I:%M %p')).replace(
            '*meditation_end*', local('event_event_6', 'date_end', '%I:%M %p')).replace(
            '*flow-membership*', slug('product_product_5', 'the-flow-membership')).replace(
            '*tone-membership*', slug('product_product_16', 'the-tone-membership')).replace(
            '*balance-membership*', slug('product_product_17', 'the-balance-membership'))
        })(
            obj().env.ref('yoga_pilates.view_page_home').arch,
            lambda xmlid, field, fmt: (lambda event, field, fmt: event and event[field].replace(tzinfo=pytz.utc).astimezone(
                pytz.timezone(event.date_tz)).strftime(fmt).lstrip('0') or '')(
                obj().env.ref('yoga_pilates.' + xmlid, raise_if_not_found=False), field, fmt),
            lambda xmlid, name: (lambda product, name: product and '%s-%s' % (name, product.product_tmpl_id.id) or '')(
                obj().env.ref('yoga_pilates.' + xmlid, raise_if_not_found=False), name),
        )"/>
    </function>
