<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">yoga_pilates.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="yoga_pilates.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', ''),}"/>
                    <t t-set="contactus_form_values" t-value="dict(contactus_form_values, **{'contact_name': request.params.get('contact_name', ''), 'partner_name': request.params.get('partner_name', ''), 'description': request.params.get('description', ''),})"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_website_form_overlay oe_img_bg o_bg_img_center o_colored_level o_bg_img_origin_border_box pt80 pb96" style="background-image: url(&quot;/web/image/yoga_pilates.img_yoga_pilates_image_26&quot;); background-position: 100% 50%; position: relative;" data-snippet="s_website_form_overlay" data-name="Form Overlay" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp">
                            <div class="o_we_bg_filter bg-black-50"/>
                            <div class="container">
                                <div class="row">
                                    <div class="o_cc o_cc1 px-3 px-lg-4 pt40 pb16 o_colored_level col-lg-7 offset-lg-5 border rounded" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; border-left-color: var(--o-color-1) !important; border-bottom-color: var(--o-color-1) !important; border-right-color: var(--o-color-1) !important; border-top-color: var(--o-color-1) !important; --box-border-bottom-left-radius: 16px; --box-border-bottom-right-radius: 16px; --box-border-top-right-radius: 16px; --box-border-top-left-radius: 16px;">
                                        <h1>
                                            <span class="h2-fs text-o-color-5">Send us a </span>
                                            <span class="text-o-color-5">
                                                <span class="o_text_highlight o_text_highlight_bold_1 h2-fs" style="--text-highlight-color: var(--o-color-2); --text-highlight-width: 2px;">message</span>
                                            </span>
                                        </h1>
                                        <p class="lead">Get in touch with your customers to provide them with better service. You can modify the form fields to gather more precise information.</p>
                                        <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container-fluid">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="crm.lead" data-success-mode="message" data-success-page="/contactus-thank-you">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name">
                                                            <label class="s_website_form_label" for="oa2ozhuukjl7" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="" id="oa2ozhuukjl7" data-fill-with="name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="tel" data-translated-name="Phone Number">
                                                            <label class="s_website_form_label" for="o5jtuypl1709" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="phone" value="" placeholder="" id="o5jtuypl1709" data-fill-with="phone"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_required" data-type="email" data-translated-name="Your Email">
                                                            <label class="s_website_form_label" for="ojunqnufwn9o" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="ojunqnufwn9o" data-fill-with="email"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="char" data-translated-name="Your Company">
                                                            <label class="s_website_form_label" for="oow07tq2rlwd" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Company</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="partner_name" value="" placeholder="" id="oow07tq2rlwd" data-fill-with="parent_name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject">
                                                            <label class="s_website_form_label" for="oizaxfohfjki" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="oizaxfohfjki"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="Your Question">
                                                            <label class="s_website_form_label" for="o8xef0wqcdyt" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Question</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="o8xef0wqcdyt" rows="3"/>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"/>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send o_translate_inline">Send Your Message</a>
                                                        </div>
                                                    </div>
                                                </form>
                                                <div class="s_website_form_end_message d-none">
                                                    <div class="oe_structure">
                                                        <section class="s_text_block o_colored_level rounded px-5 text-center" data-snippet="s_text_block" data-name="Text">
                                                            <i class="oi oi-filled mb-3 text-o-color-4 bg-o-color-2 rounded-circle oi-2x" data-icon="send" role="img" aria-hidden="true" title="Success"/>
                                                            <h2 class="fw-bolder">
                                                                <span class="h3-fs">Thank you for your feedback!</span>
                                                            </h2>
                                                            <p class="lead mb-0">Our team will message you back as soon as possible.</p>
                                                            <p class="lead">In the meantime we invite you to visit our <a class="o_translate_inline" href="/">website</a>.</p>
                                                        </section>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_hours_and_place o_cc o_cc1 o_colored_level pt88 pb232" data-snippet="s_hours_and_place" data-name="Hours and Place" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Nature/05&quot;,&quot;colors&quot;:{&quot;c1&quot;:&quot;#202815&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                            <div class="o_we_shape o_html_builder_Nature_05 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FNature%2F05.svg?c1=%23202815&quot;);"/>
                            <div class="container">
                                <div class="row s_nb_column_fixed o_grid_mode" style="column-gap: 32px;" data-row-count="12">
                                    <div class="col-lg-12 o_colored_level g-height-3 g-col-lg-12 o_grid_item" style="grid-area: 1 / 1 / 4 / 13; z-index: 1;">
                                        <h2>
                                            <span class="o_text_highlight o_text_highlight_bold_1" style="--text-highlight-color: var(--o-color-2); --text-highlight-width: 2px;">Visit Us</span>
                                        </h2>
                                        <p>
                                            <br/>
                                        </p>
                                    </div>
                                    <div class="o_colored_level o_cc o_cc2 rounded o_grid_item g-col-lg-4 g-height-10 col-lg-4 o_we_padding_highlight" style="grid-area: 3 / 1 / 13 / 5; z-index: 2; --grid-item-padding-y: 24px; border-radius: 9.6px !important; --grid-item-padding-x: 24px;">
                                        <h3 class="h5-fs">Opening hours</h3>
                                        <p class="o_small-fs"><u>Monday</u><br/>8.00am-6.00pm</p>
                                        <p class="o_small-fs"><u>Tuesday</u><br/>8.00am-6.00pm</p>
                                        <p class="o_small-fs"><u>Wednesday</u><br/>8.00am-12.00pm</p>
                                        <p class="o_small-fs"><u>Thursday</u><br/>8.00am-6.00pm</p>
                                        <p class="o_small-fs">
                                            <br/>
                                        </p>
                                        <h3 class="h5-fs">Contact us</h3>
                                        <p>
                                            <span class="oi oi-filled text-o-color-1" data-icon="mail"/> <a href="mailto:info@balance-yoga.com" class="o_translate_inline">info@balance-yoga.com</a><br/>
                                            <span class="oi oi-filled text-o-color-1" data-icon="phone"/> <a href="tel:+1555-555-5556" class="o_translate_inline">
                                                <span class="o_force_ltr">+1 555-555-5556</span>
                                            </a>
                                        </p>
                                        <p>
                                            <a class="btn btn-primary o_translate_inline" href="/contactus">Get directions</a>
                                        </p>
                                    </div>
                                    <div class="o_colored_level g-height-10 o_grid_item col-lg-8 g-col-lg-8" style="grid-area: 3 / 5 / 13 / 13; z-index: 3; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px;">
                                        <div class="s_hr d-lg-none o_snippet_desktop_invisible pt24 pb24" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                        </div>
                                        <section data-map-type="m" data-map-zoom="12" data-vxml="001" class="s_map rounded-3 o_not_editable pt256 pb240" data-map-address="Belgium" data-snippet="s_map" data-name="Map">
                                            <div class="map_container">
                                                <div class="css_non_editable_mode_hidden">
                                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                                        An address must be specified for a map to be embedded
                                                    </div>
                                                </div>
                                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=250%20Executive%20Park%20Blvd%2C%20Suite%203400%20San%20Francisco%20California%20(US)%20United%20States&amp;t=m&amp;z=12&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                                <div class="s_map_color_filter"/>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
