<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small text-center" t-ignore="true"> Copyright &amp;copy; <span t-out="res_company.name"/>
                </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-custom text-o-color-1 bg-o-color-4" style="border: 0px solid rgb(255, 169, 56);">Contact us</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_centered" model="ir.ui.view">
        <field name="name">Custom - Centered</field>
        <field name="key">website.template_footer_centered</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt32" data-snippet="s_text_block" data-name="Container">
                        <div class="s_allow_columns container">
                            <div class="row">
                                <div class="col-lg-12 order-lg-0 o_colored_level" style="order: 0;">
                                    <div class="s_social_media text-center o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="#" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                            <i class="oi rounded-empty-circle shadow-sm o_editable_media" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="#" class="s_social_media_twitter" target="_blank" aria-label="X">
                                            <i class="oi rounded-empty-circle shadow-sm o_editable_media" data-icon="oi_x"/>
                                        </a>
                                        <a href="#" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                            <i class="oi rounded-empty-circle shadow-sm o_editable_media" data-icon="oi_linkedin"/>
                                        </a>
                                    </div>
                                    <div class="s_hr pt24 pb24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="col-lg-4 order-lg-0 o_colored_level pt16" style="order: 2;">
                                    <p style="text-align: center;">
                                        250 Executive Park Blvd, Suite 3400<br/>
                                        San Francisco CA 94134
                                    </p>
                                </div>
                                <div class="col-lg-4 order-lg-0 pb24 o_colored_level pt4" style="order: 1;">
                                    <a href="/" class="o_footer_logo logo">
                                        <img src="/web/image/yoga_pilates.img_yoga_pilates_image_27" alt="" class="img-fluid d-block mx-auto img o_we_custom_image o_attachment_pending_record_id" style="width: 64% !important;" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="col-lg-4 order-lg-0 o_colored_level pt16" style="order: 3;">
                                    <ul class="list-unstyled">
                                        <li style="text-align: center;">
                                            <a href="tel:+1 555-555-5556">
                                                <span class="o_force_ltr">+1 555-555-5556</span>
                                            </a>
                                        </li>
                                        <li style="text-align: center;">
                                            <a href="mailto:info@balance-yoga.com">info@balance-yoga.com</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
