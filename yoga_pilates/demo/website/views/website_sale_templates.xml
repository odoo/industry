<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="products_shop_title" model="ir.ui.view">
        <field name="name">Custom - Shop title</field>
        <field name="key">yoga_pilates.products_shop_title</field>
        <field name="inherit_id" ref="website_sale.products"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_wsale_shop_title')]/h1" position="replace">
                <div class="s_hr pb32 o_colored_level pt0" data-snippet="s_hr" data-name="Separator">
                    <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                </div>
                <h1 class="h4-fs">
                    <span class="h2-fs">Memberships &amp;amp; Class Passes</span>
                </h1>
                <div class="s_hr pt32 pb32 o_colored_level" data-snippet="s_hr" data-name="Separator">
                    <hr class="w-100 mx-auto"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
