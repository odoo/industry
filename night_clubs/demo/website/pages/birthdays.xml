<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_birthdays" model="ir.ui.view">
        <field name="name">Birthdays</field>
        <field name="key">night_clubs.page_birthdays</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Birthdays" t-name="night_clubs.page_birthdays">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_image o_cc o_cc1 pt64 pb96 o_colored_level" data-snippet="s_text_image" data-name="Text - Image">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom col-lg-5" style="--wanim-intensity: 6;">
                                        <p>
                                            <span class="o_small-fs text-o-color-1">Birthdays</span>
                                        </p>
                                        <h1>
                                            <strong>CELEBRATE YOUR BIRTHDAY</strong>
                                        </h1>
                                        <p>Your night, your corner: a reserved area, a host who knows your name and a cake that lands at midnight. From 6 guests.</p>
                                        <p>
                                            <a href="#plan-my-birthday" class="btn btn-primary">PLAN MY BIRTHDAY</a>
                                        </p>
                                    </div>
                                    <div class="pt16 pb16 o_colored_level o_animate o_animate_on_scroll o_anim_slide_in o_anim_from_bottom offset-lg-1 col-lg-6" style="--wanim-intensity: 10;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <img src="/web/image/night_clubs.img_night_clubs_image_17" alt="Friends cheering as a sparkler cake arrives at the table" class="img img-fluid mx-auto o_we_custom_image" loading="lazy" src.translate="/web/image/night_clubs.img_night_clubs_image_17"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_image o_cc o_cc1 pt128 pb128 o_colored_level" data-snippet="s_image_text" data-name="Image - Text">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-5 pt16 pb16 o_colored_level o_animate o_animate_on_scroll o_anim_slide_in o_anim_from_bottom" style="--wanim-intensity: 10;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <img src="/web/image/night_clubs.img_night_clubs_image_19" alt="Velvet booths reserved for a group, in front of the dot field wall" class="img img-fluid mx-auto o_we_custom_image" loading="lazy"/>
                                    </div>
                                    <div class="col-lg-6 offset-lg-1 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                        <h2>
                                            <strong>YOUR NIGHT, YOUR CORNER</strong>
                                        </h2>
                                        <p>You bring the guests, we handle the rest: from the door to the last record, your group has its own space in the club.</p>
                                        <ul class="s_icon_list" data-snippet="s_icon_list" data-name="Icon List">
                                            <li>Reserved area for your group</li>
                                            <li>Priority entry, no queue</li>
                                            <li>Birthday cake served at midnight</li>
                                            <li>Free entry for the birthday person</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_image o_cc o_cc4 pt128 pb40 o_colored_level" data-snippet="s_text_image" data-name="Text - Image">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-9 col-lg-9 pt0 pb0 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                        <h2>
                                            <strong>HOW IT WORKS</strong>
                                        </h2>
                                    </div>
                                    <div class="col-3 col-lg-3 pt0 pb0 o_colored_level o_animate o_animate_on_scroll o_anim_from_right o_anim_slide_in" style="--wanim-intensity: 4;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <p style="text-align: end;">
                                            <img src="/web/image/night_clubs.img_night_clubs_image_02" alt="" class="img img-fluid mx-auto o_we_custom_image" loading="lazy" style="width: 50% !important;" src.translate="/web/image/night_clubs.img_night_clubs_image_02"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_three_columns o_cc o_cc4 pt0 pb128 o_colored_level" data-vxml="001" data-vcss="001" data-snippet="s_three_columns" data-name="Columns">
                            <div class="container">
                                <div class="row d-flex align-items-stretch">
                                    <div data-name="Card" class="col-lg-4 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                        <div class="s_card card h-100 my-0 o_cc o_cc4 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-width: 0px !important;">
                                            <div class="card-body">
                                                <p class="card-text">
                                                    <span class="h3-fs">
                                                        <strong>01</strong>
                                                    </span>
                                                </p>
                                                <h3 class="card-title">
                                                    <span class="h4-fs">
                                                        <strong>SEND YOUR REQUEST</strong>
                                                    </span>
                                                </h3>
                                                <p class="card-text">Pick a night and the number of guests in the form below.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="col-lg-4 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-delay: 0.2s;">
                                        <div class="s_card card h-100 my-0 o_cc o_cc4 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-width: 0px !important;">
                                            <div class="card-body">
                                                <p class="card-text">
                                                    <span class="h3-fs">
                                                        <strong>02</strong>
                                                    </span>
                                                </p>
                                                <h3 class="card-title">
                                                    <span class="h4-fs">
                                                        <strong>WE CONFIRM</strong>
                                                    </span>
                                                </h3>
                                                <p class="card-text">Our team confirms by email within 24 hours, with the guest list link.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="col-lg-4 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-delay: 0.4s;">
                                        <div class="s_card card h-100 my-0 o_cc o_cc4 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-width: 0px !important;">
                                            <div class="card-body">
                                                <p class="card-text">
                                                    <span class="h3-fs">
                                                        <strong>03</strong>
                                                    </span>
                                                </p>
                                                <h3 class="card-title">
                                                    <span class="h4-fs">
                                                        <strong>ARRIVE, WE TAKE IT FROM THERE</strong>
                                                    </span>
                                                </h3>
                                                <p class="card-text">Skip the queue, find your reserved area, and the cake arrives at midnight.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_form_aside o_cc o_cc1 pt160 pb160 o_colored_level oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-snippet="s_form_aside" data-name="Form Aside" id="plan-my-birthday" data-anchor="true" style="background-image: url(&quot;/web/image/night_clubs.img_night_clubs_image_15&quot;); background-size: cover; position: relative;">
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(180deg, rgb(0, 0, 0) 0%, rgba(0, 0, 0, 0) 25%, rgba(0, 0, 0, 0) 75%, rgb(0, 0, 0) 100%);"/>
                            <div class="container">
                                <div class="row">
                                    <div class="col-12 col-lg-5 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                        <h2>
                                            <strong>THE BIRTHDAY FORMULA</strong>
                                        </h2>
                                        <p>
                                            <br />One formula, everything included, priced per guest. Extra drinks are served at the bar or at the table.
                                        </p>
                                        <div class="s_card card my-0 o_cc o_colored_level o_cc4" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-width: 0px !important;">
                                            <div class="card-body">
                                                <p class="card-text">
                                                    <span class="o_small-fs text-o-color-3">
                                                        <strong>FROM 6 GUESTS</strong>
                                                    </span>
                                                </p>
                                                <h3 class="card-title">
                                                    <strong>BIRTHDAY NIGHT</strong>
                                                </h3>
                                                <p class="card-text">Everything for your group, from the door to the last record.</p>
                                                <div class="s_hr pt16 pb16" data-snippet="s_hr" data-name="Separator">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-3) !important;"/>
                                                </div>
                                                <ul class="s_icon_list" data-snippet="s_icon_list" data-name="Icon List">
                                                    <li>Reserved area by the main room</li>
                                                    <li>Priority entry for the whole group</li>
                                                    <li>Birthday cake served at midnight</li>
                                                    <li>A bottle of champagne for the table</li>
                                                    <li>Free entry for the birthday person</li>
                                                </ul>
                                                <div class="s_hr pt16 pb16" data-snippet="s_hr" data-name="Separator">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-3) !important;"/>
                                                </div>
                                                <p class="card-text">
                                                    <span class="o_small-fs">FROM</span> <span class="h2-fs"><strong>€35</strong></span> / guest</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-6 offset-lg-1 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-delay: 0.2s;">
                                        <div class="s_card card my-0 o_cc o_cc1 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-color: var(--o-color-3) !important;">
                                            <div class="card-body">
                                                <h2>
                                                    <span class="h3-fs">
                                                        <strong>PLAN MY BIRTHDAY</strong>
                                                    </span>
                                                </h2>
                                                <p>Send your request and we confirm by email within 24 hours.</p>
                                                <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                                    <div class="container-fluid">
                                                        <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                                                                            <span class="s_website_form_label_content"/>
                                                                        </label>
                                                                        <div class="col-sm">
                                                                            <input type="hidden" class="form-control s_website_form_input" name="email_to" value="hello@exodiaclub.example.be"/>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required s_website_form_field_hidden" data-type="char">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0008">
                                                                        <span class="s_website_form_label_content">Subject</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input class="form-control s_website_form_input" type="text" name="subject" required="1" value="Birthday request" id="oexo0008"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom s_website_form_required" data-type="char">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0001">
                                                                        <span class="s_website_form_label_content">Name</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input class="form-control s_website_form_input" type="text" name="Name" required="1" data-fill-with="name" id="oexo0001"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_model_required" data-type="email">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0002">
                                                                        <span class="s_website_form_label_content">Email</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input class="form-control s_website_form_input" type="email" name="email_from" required="1" data-fill-with="email" id="oexo0002"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom s_website_form_required" data-type="tel">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0003">
                                                                        <span class="s_website_form_label_content">Phone</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input class="form-control s_website_form_input" type="tel" name="Phone" required="1" data-fill-with="phone" id="oexo0003"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom s_website_form_required" data-type="date">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0004">
                                                                        <span class="s_website_form_label_content">Date</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <div class="s_website_form_date input-group date">
                                                                        <input type="text" class="form-control datetimepicker-input s_website_form_input" name="Date" required="1" id="oexo0004" inputmode="none"/>
                                                                        <div class="input-group-text o_input_group_date_icon cursor-pointer">
                                                                            <i class="oi oi-filled" data-icon="calendar_today"/>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom s_website_form_required" data-type="integer">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0005">
                                                                        <span class="s_website_form_label_content">Number of guests</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input type="number" class="form-control s_website_form_input" name="Number of guests" step="1" required="1" id="oexo0005"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom" data-type="char">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0006">
                                                                        <span class="s_website_form_label_content">Birthday person's name</span>
                                                                    </label>
                                                                    <input class="form-control s_website_form_input" type="text" name="Birthday person's name" id="oexo0006"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="text">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0007">
                                                                        <span class="s_website_form_label_content">Message</span>
                                                                    </label>
                                                                    <textarea class="form-control s_website_form_input" name="Message" id="oexo0007" rows="4"/>
                                                                </div>
                                                                <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                                    <div style="width: 200px;" class="s_website_form_label"/>
                                                                    <span id="s_website_form_result"/>
                                                                    <a href="#" role="button" class="btn btn-primary s_website_form_send">SEND MY REQUEST</a>
                                                                </div>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </section>
                                                <p>
                                                    Or write to <a href="mailto:hello@exodiaclub.example.be">hello@exodiaclub.example.be</a>.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_birthdays" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_birthdays"/>
            <field name="url">/birthdays</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
