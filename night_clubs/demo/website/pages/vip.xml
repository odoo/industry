<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_vip" model="ir.ui.view">
        <field name="name">VIP</field>
        <field name="key">night_clubs.page_vip</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="VIP" t-name="night_clubs.page_vip">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_image o_cc o_cc1 pt64 pb96 o_colored_level" data-snippet="s_text_image" data-name="Text - Image">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-5 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                        <p>
                                            <span class="o_small-fs text-o-color-1">VIP</span>
                                        </p>
                                        <h1>
                                            <strong>BOOK YOUR VIP TABLE</strong>
                                        </h1>
                                        <p>Priority entry, a dedicated host and bottle service, from the first record to the last.</p>
                                        <p>
                                            <a href="#reserve-a-vip-table" class="btn btn-primary">RESERVE A VIP TABLE</a>
                                        </p>
                                    </div>
                                    <div class="col-lg-6 offset-lg-1 pt16 pb16 o_colored_level o_animate o_animate_on_scroll o_anim_slide_in o_anim_from_bottom" style="--wanim-intensity: 10;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <img src="/web/image/night_clubs.img_night_clubs_image_18" alt="VIP booth with bottle service over the main room" class="img img-fluid mx-auto o_we_custom_image" loading="lazy" src.translate="/web/image/night_clubs.img_night_clubs_image_18"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_image o_cc o_cc1 pt128 pb128 o_colored_level" data-snippet="s_text_image" data-name="Text - Image">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-6 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                        <h2>
                                            <strong>WHAT YOUR TABLE INCLUDES</strong>
                                        </h2>
                                        <p>Skip the queue, settle into your booth and let your host take care of the bottles. You only move to dance.</p>
                                        <ul class="s_icon_list" data-snippet="s_icon_list" data-name="Icon List">
                                            <li>Priority entry for the whole table</li>
                                            <li>A dedicated host all night</li>
                                            <li>Two bottles of your choice, with mixers</li>
                                            <li>Cloakroom included</li>
                                        </ul>
                                    </div>
                                    <div class="col-lg-5 offset-lg-1 pt16 pb16 o_colored_level o_animate o_animate_on_scroll o_anim_slide_in o_anim_from_bottom" style="--wanim-intensity: 10;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <img src="/web/image/night_clubs.img_night_clubs_image_19" alt="Velvet booths in front of the dot field wall" class="img img-fluid mx-auto o_we_custom_image" loading="lazy" src.translate="/web/image/night_clubs.img_night_clubs_image_19"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_image o_cc o_cc4 pt128 pb40 o_colored_level" data-snippet="s_text_image" data-name="Text - Image">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-9 col-lg-9 pt0 pb0 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                        <h2>
                                            <strong>GOOD TO KNOW</strong>
                                        </h2>
                                    </div>
                                    <div class="col-3 col-lg-3 pt0 pb0 o_colored_level o_animate o_animate_on_scroll o_anim_from_right o_anim_slide_in" style="--wanim-intensity: 4;" data-scroll-zone-start="0" data-scroll-zone-end="100">
                                        <p style="text-align: end;">
                                            <img src="/web/image/night_clubs.img_night_clubs_image_02" alt="" class="img img-fluid mx-auto o_we_custom_image" loading="lazy" style="width: 50% !important;" src.translate="/web/image/night_clubs.img_night_clubs_image_02"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_three_columns o_cc o_cc4 pt0 pb128 o_colored_level" data-vxml="001" data-vcss="001" data-snippet="s_three_columns" data-name="Columns">
                            <div class="container">
                                <div class="row d-flex align-items-stretch">
                                    <div data-name="Card" class="col-lg-3 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                        <div class="s_card card h-100 my-0 o_cc o_cc4 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-color: rgba(0, 0, 0, 0.3) !important;">
                                            <div class="card-body">
                                                <h3 class="card-title">
                                                    <span class="h4-fs">
                                                        <strong>18+ ONLY</strong>
                                                    </span>
                                                </h3>
                                                <p class="card-text">Every guest shows a valid photo ID at the door.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="col-lg-3 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-delay: 0.2s;">
                                        <div class="s_card card h-100 my-0 o_cc o_cc4 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-color: rgba(0, 0, 0, 0.3) !important;">
                                            <div class="card-body">
                                                <h3 class="card-title">
                                                    <span class="h4-fs">
                                                        <strong>ARRIVE BEFORE 1AM</strong>
                                                    </span>
                                                </h3>
                                                <p class="card-text">Tables are held until 1AM, then released.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="col-lg-3 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-delay: 0.4s;">
                                        <div class="s_card card h-100 my-0 o_cc o_cc4 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-color: rgba(0, 0, 0, 0.3) !important;">
                                            <div class="card-body">
                                                <h3 class="card-title">
                                                    <span class="h4-fs">
                                                        <strong>EXTRA BOTTLES</strong>
                                                    </span>
                                                </h3>
                                                <p class="card-text">Order more at any time: your host serves them at the table.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="col-lg-3 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-delay: 0.6s;">
                                        <div class="s_card card h-100 my-0 o_cc o_cc4 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-color: rgba(0, 0, 0, 0.3) !important;">
                                            <div class="card-body">
                                                <h3 class="card-title">
                                                    <span class="h4-fs">
                                                        <strong>FREE CANCELLATION</strong>
                                                    </span>
                                                </h3>
                                                <p class="card-text">Up to 48 hours before the night.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_form_aside o_cc o_cc1 pt160 pb160 o_colored_level oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-snippet="s_form_aside" data-name="Form Aside" id="reserve-a-vip-table" data-anchor="true" style="background-image: url(&quot;/web/image/night_clubs.img_night_clubs_image_15&quot;); background-size: cover; position: relative;">
                            <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(180deg, rgb(0, 0, 0) 0%, rgba(0, 0, 0, 0) 25%, rgba(0, 0, 0, 0) 75%, rgb(0, 0, 0) 100%);"/>
                            <div class="container">
                                <div class="row">
                                    <div class="col-12 col-lg-5 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                        <h2>
                                            <strong>THE TABLE FORMULA</strong>
                                        </h2>
                                        <p>One price per table: your booth, your host, entry for everyone and two bottles with mixers.</p>
                                        <div class="s_card card my-0 o_cc o_colored_level o_cc4" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-width: 0px !important;">
                                            <div class="card-body">
                                                <p class="card-text">
                                                    <span class="o_small-fs text-o-color-3">
                                                        <strong>UP TO 10 GUESTS</strong>
                                                    </span>
                                                </p>
                                                <h3 class="card-title">
                                                    <strong>VIP TABLE</strong>
                                                </h3>
                                                <p class="card-text">Your booth, your host, your bottles.</p>
                                                <div class="s_hr pt16 pb16" data-snippet="s_hr" data-name="Separator">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-3) !important;"/>
                                                </div>
                                                <ul class="s_icon_list" data-snippet="s_icon_list" data-name="Icon List">
                                                    <li>Velvet booth with a view of the DJ booth</li>
                                                    <li>Priority entry for the whole table</li>
                                                    <li>A dedicated host all night</li>
                                                    <li>Two bottles of your choice, with mixers</li>
                                                    <li>Cloakroom included</li>
                                                </ul>
                                                <div class="s_hr pt16 pb16" data-snippet="s_hr" data-name="Separator">
                                                    <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-3) !important;"/>
                                                </div>
                                                <p class="card-text"><span class="o_small-fs">PER TABLE</span> <span class="h2-fs"><strong>€450</strong></span></p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-6 offset-lg-1 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-delay: 0.2s;">
                                        <div class="s_card card my-0 o_cc o_cc1 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-color: var(--o-color-3) !important;">
                                            <div class="card-body">
                                                <h2>
                                                    <span class="h3-fs">
                                                        <strong>RESERVE A VIP TABLE</strong>
                                                    </span>
                                                </h2>
                                                <p>Tell us your night and your table; our team confirms within 24 hours.</p>
                                                <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                                    <div class="container-fluid">
                                                        <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                                                                            <span class="s_website_form_label_content"/>
                                                                        </label>
                                                                        <div class="col-sm">
                                                                            <input type="hidden" class="form-control s_website_form_input" name="email_to" value="hello@exodiaclub.example.be"/>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required s_website_form_field_hidden" data-type="char">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0016">
                                                                        <span class="s_website_form_label_content">Subject</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input class="form-control s_website_form_input" type="text" name="subject" required="1" value="VIP table request" id="oexo0016"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom s_website_form_required" data-type="char">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0009">
                                                                        <span class="s_website_form_label_content">Name</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input class="form-control s_website_form_input" type="text" name="Name" required="1" data-fill-with="name" id="oexo0009"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_model_required" data-type="email">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0010">
                                                                        <span class="s_website_form_label_content">Email</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input class="form-control s_website_form_input" type="email" name="email_from" required="1" data-fill-with="email" id="oexo0010"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom s_website_form_required" data-type="tel">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0011">
                                                                        <span class="s_website_form_label_content">Phone</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input class="form-control s_website_form_input" type="tel" name="Phone" required="1" data-fill-with="phone" id="oexo0011"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom s_website_form_required" data-type="date">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0012">
                                                                        <span class="s_website_form_label_content">Date</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <div class="s_website_form_date input-group date">
                                                                        <input type="text" class="form-control datetimepicker-input s_website_form_input" name="Date" required="1" id="oexo0012" inputmode="none"/>
                                                                        <div class="input-group-text o_input_group_date_icon cursor-pointer">
                                                                            <i class="oi oi-filled" data-icon="calendar_today"/>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom s_website_form_required" data-type="integer">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0013">
                                                                        <span class="s_website_form_label_content">Number of guests</span>
                                                                        <span class="s_website_form_mark"> *</span>
                                                                    </label>
                                                                    <input type="number" class="form-control s_website_form_input" name="Number of guests" step="1" required="1" id="oexo0013"/>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom" data-type="many2one">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0014">
                                                                        <span class="s_website_form_label_content">Party</span>
                                                                    </label>
                                                                    <select class="form-select s_website_form_input" name="Party" id="oexo0014">
                                                                        <option id="oexo00140" value="Nocturnal Protocol · *nocturnal_protocol_date*">Nocturnal Protocol · *nocturnal_protocol_date*</option>
                                                                        <option id="oexo00141" value="Zero Hour · *zero_hour_date*">Zero Hour · *zero_hour_date*</option>
                                                                        <option id="oexo00142" value="Slow Light · *slow_light_date*">Slow Light · *slow_light_date*</option>
                                                                        <option id="oexo00143" value="After Time · *after_time_date*">After Time · *after_time_date*</option>
                                                                        <option id="oexo00144" value="Signal Loss · *signal_loss_date*">Signal Loss · *signal_loss_date*</option>
                                                                        <option id="oexo00145" value="Lune All Night Long · *lune_all_night_long_date*">Lune All Night Long · *lune_all_night_long_date*</option>
                                                                    </select>
                                                                </div>
                                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="text">
                                                                    <label class="s_website_form_label" style="width: 200px" for="oexo0015">
                                                                        <span class="s_website_form_label_content">Message</span>
                                                                    </label>
                                                                    <textarea class="form-control s_website_form_input" name="Message" id="oexo0015" rows="4"/>
                                                                </div>
                                                                <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                                    <div style="width: 200px;" class="s_website_form_label"/>
                                                                    <span id="s_website_form_result"/>
                                                                    <a href="#" role="button" class="btn btn-primary s_website_form_send">SEND MY REQUEST</a>
                                                                </div>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </section>
                                                <p>Or write to <a href="mailto:hello@exodiaclub.example.be">hello@exodiaclub.example.be</a>.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_vip" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_vip"/>
            <field name="url">/vip</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
    <!-- Dates and links of the demo events, relative to the install date -->
    <function model="ir.ui.view" name="write">
        <value eval="[ref('view_page_vip')]"/>
        <value model="event.event" eval="(lambda arch, date: {'arch': arch.replace(
            '*nocturnal_protocol_date*', date('event_event_5')).replace(
            '*zero_hour_date*', date('event_event_6')).replace(
            '*slow_light_date*', date('event_event_7')).replace(
            '*after_time_date*', date('event_event_8')).replace(
            '*signal_loss_date*', date('event_event_9')).replace(
            '*lune_all_night_long_date*', date('event_event_10'))
        })(
            obj().env.ref('night_clubs.view_page_vip').arch,
            lambda xmlid: (lambda event: event.date_begin.replace(tzinfo=pytz.utc).astimezone(
                pytz.timezone(event.date_tz)).strftime('%d.%m'))(obj().env.ref('night_clubs.' + xmlid)),
        )"/>
    </function>
</odoo>
