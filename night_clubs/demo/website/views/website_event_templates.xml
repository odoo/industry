<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_event_index_oe_structure_we_index_0" model="ir.ui.view">
        <field name="name">Events (oe_structure_we_index_0)</field>
        <field name="key">website_event.index_oe_structure_we_index_0</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_we_index_0']" position="replace">
                <div id="oe_structure_we_index_0" class="oe_structure oe_empty">
                    <section class="s_text_image o_cc o_cc1 o_colored_level oe_img_bg o_bg_img_center o_bg_img_origin_border_box pb80 pt96" data-snippet="s_text_image" data-name="Text - Image" style="background-image: url(&quot;/web/image/night_clubs.img_night_clubs_image_15&quot;); background-size: cover; position: relative;">
                        <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(rgb(0, 0, 0) 0%, rgba(0, 0, 0, 0.36) 50%, rgb(0, 0, 0) 100%);"/>
                        <div class="container">
                            <div class="row align-items-end">
                                <div class="pt16 pb16 o_colored_level col-lg-6 o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                    <p>
                                        <span class="o_small-fs text-o-color-1">
                                            <strong>Fri–Sat · 11PM–6AM</strong>
                                        </span>
                                    </p>
                                    <p>Techno, EDM, hardstyle and drum and bass in Ramillies. Book your ticket online and skip the door queue: at the door, tickets cost €5 more, unless the night is sold out.</p>
                                </div>
                                <div class="pt16 pb16 o_colored_level col-lg-6 o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-delay: 0.2s;">
                                    <p style="text-align: end;">
                                        <a href="/residents" class="btn btn-secondary">MEET THE RESIDENTS</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="website_event_index_topbar" model="ir.ui.view">
        <field name="name">Topbar</field>
        <field name="key">website_event.index_topbar</field>
        <field name="inherit_id" ref="website_event.index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('o_wevent_index_topbar_filters')]/div[hasclass('flex-grow-1')]/h1" position="replace">
                <h1 class="mb-0 h4-fs">
                    <span class="display-2-fs">
                        <strong>Parties</strong>
                    </span>
                </h1>
            </xpath>
        </field>
    </record>
    <record id="website_event_index_oe_structure_we_index_2" model="ir.ui.view">
        <field name="name">Events (oe_structure_we_index_2)</field>
        <field name="key">website_event.index_oe_structure_we_index_2</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_we_index_2']" position="replace">
                <div id="oe_structure_we_index_2" class="oe_structure">
                    <section class="s_three_columns o_cc o_cc1 pt0 pb128 o_colored_level" data-vxml="001" data-vcss="001" data-snippet="s_three_columns" data-name="Columns">
                        <div class="container">
                            <div class="row d-flex align-items-stretch">
                                <div data-name="Card" class="col-lg-6 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6;">
                                    <div class="s_card card h-100 my-0 o_cc o_cc1 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-color: var(--o-color-3) !important;">
                                        <div class="card-body">
                                            <h2 class="card-title">
                                                <span class="h3-fs">
                                                    <strong>PLANNING A PRIVATE PARTY?</strong>
                                                </span>
                                            </h2>
                                            <p class="card-text">Take over a room or the whole club for a launch, a brand night or a private party. Up to 1,200 guests.</p>
                                            <p class="card-text">
                                                <a href="/private-hire" class="btn btn-primary">GET A PRIVATE EVENT QUOTE</a>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div data-name="Card" class="col-lg-6 pt16 pb16 o_colored_level o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 6; animation-delay: 0.2s;">
                                    <div class="s_card card h-100 my-0 o_cc o_cc1 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="border-color: var(--o-color-3) !important;">
                                        <div class="card-body">
                                            <h2 class="card-title">
                                                <span class="h3-fs">
                                                    <strong>QUESTIONS ABOUT A NIGHT?</strong>
                                                </span>
                                            </h2>
                                            <p class="card-text">Opening hours, dress code, tickets at the door: it is all on the info page.</p>
                                            <p class="card-text">
                                                <a href="/info" class="btn btn-primary">SEE PRACTICAL INFO</a>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="website_event_navbar" model="ir.ui.view">
        <field name="name">Event Navbar</field>
        <field name="key">website_event.navbar</field>
        <field name="inherit_id" ref="website_event.navbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//li[@t-if='event.header_visible']//a[@href='/event']" position="replace">
                <a href="/event" title="Back to Parties">All Parties</a>
            </xpath>
        </field>
    </record>
    <record id="website_event_event_description_dates" model="ir.ui.view">
        <field name="name">Event Description Dates</field>
        <field name="key">night_clubs.event_description_dates</field>
        <field name="inherit_id" ref="website_event.event_description_dates"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <!-- "Starts" and "Ends" labels -->
            <xpath expr="//div[hasclass('flex-lg-column')]/div[1]/small" position="attributes">
                <attribute name="class" remove="fw-bold" add="text-o-color-2" separator=" "/>
            </xpath>
            <xpath expr="//div[hasclass('flex-lg-column')]/div[2]/small" position="attributes">
                <attribute name="class" remove="fw-bold" add="text-o-color-2" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="website_event_event_description_full" model="ir.ui.view">
        <field name="name">Event Description</field>
        <field name="key">night_clubs.event_description_full</field>
        <field name="inherit_id" ref="website_event.event_description_full"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@t-if='opt_event_location_block and event.address_id']//h6[hasclass('o_wevent_sidebar_title')]" position="replace">
                <p class="o_wevent_sidebar_title small text-o-color-2">Location</p>
            </xpath>
            <xpath expr="//div[@t-if='opt_event_location_block and event.address_id']//a[hasclass('btn-light')]" position="attributes">
                <attribute name="class" remove="btn-light" add="btn-secondary" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="website_event_opt_event_share_block" model="ir.ui.view">
        <field name="name">Share</field>
        <field name="key">website_event.opt_event_share_block</field>
        <field name="inherit_id" ref="website_event.event_description_full"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//aside[@id='o_wevent_event_main_sidebar']" position="inside">
                <div t-if="opt_event_share_block" class="o_wevent_sidebar_block" t-ignore="true">
                    <div>
                        <p class="o_wevent_sidebar_title small"><span class="text-o-color-2">Share</span></p>
                    </div>
                    <div class="s_share text-start o_no_link_popover oe_unremovable o_not_editable no_icon_color" data-snippet="s_share" data-name="Share">
                        <h4 class="s_share_title d-none">Share</h4>
                        <a href="https://www.facebook.com/sharer/sharer.php?u={url}" target="_blank" aria-label="Facebook" class="s_share_facebook">
                            <i data-icon="oi_facebook" class="oi small_social_icon o_editable_media rounded-circle shadow-sm"/>
                        </a>
                        <a href="https://twitter.com/intent/tweet?text={title}&amp;url={url}" target="_blank" aria-label="X" class="s_share_twitter">
                            <i data-icon="oi_x" class="oi small_social_icon o_editable_media rounded-circle shadow-sm"/>
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url={url}" target="_blank" aria-label="LinkedIn" class="s_share_linkedin d-none">
                            <i data-icon="oi_linkedin" class="oi small_social_icon o_editable_media rounded-circle shadow-sm"/>
                        </a>
                        <a href="https://wa.me/?text={title}" target="_blank" aria-label="WhatsApp" class="s_share_whatsapp">
                            <i data-icon="oi_whatsapp" class="oi small_social_icon o_editable_media rounded-circle shadow-sm"/>
                        </a>
                        <a href="https://pinterest.com/pin/create/button/?url={url}&amp;media={media}&amp;description={title}" target="_blank" aria-label="Pinterest" class="s_share_pinterest d-none">
                            <i data-icon="oi_pinterest" class="oi small_social_icon o_editable_media rounded-circle shadow-sm"/>
                        </a>
                        <a href="mailto:?body={url}&amp;subject={title}" aria-label="Email" class="s_share_email">
                            <i data-icon="mail" class="oi small_social_icon o_editable_media rounded-circle shadow-sm"/>
                        </a>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
