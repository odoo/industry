<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/event" class="oe_unremovable btn btn-primary">TICKETS</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pb40 pt72" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-12 o_colored_level pb80">
                                    <p><img src="/web/image/night_clubs.img_night_clubs_image_22" alt="" class="img img-fluid o_we_custom_image" loading="lazy"/></p>
                                </div>
                                <div class="pt24 pb24 col-lg-3 col-6 o_colored_level">
                                    <p><span class="o_small-fs text-o-color-2">Explore</span></p>
                                    <ul class="list-unstyled">
                                        <li><a href="/event">Parties</a></li>
                                        <li><a href="/residents">Residents</a></li>
                                        <li><a href="/birthdays">Birthdays</a></li>
                                        <li><a href="/vip">VIP</a></li>
                                        <li><a href="/private-hire">Private Hire</a></li>
                                        <li><a href="/info">Info</a></li>
                                    </ul>
                                </div>
                                <div class="pt24 pb24 col-lg-3 col-6 o_colored_level">
                                    <p><span class="o_small-fs text-o-color-2">Follow</span></p>
                                    <ul class="list-unstyled">
                                        <li><a href="https://www.instagram.com/" target="_blank">Instagram</a></li>
                                        <li><a href="https://www.tiktok.com/" target="_blank">TikTok</a></li>
                                        <li><a href="https://soundcloud.com/" target="_blank">SoundCloud</a></li>
                                        <li><a href="https://ra.co/" target="_blank">Resident Advisor</a></li>
                                    </ul>
                                </div>
                                <div class="pt24 pb24 col-lg-3 offset-lg-3 col-6 o_colored_level">
                                    <p><span class="o_small-fs text-o-color-2">Find us</span></p>
                                    <p><a href="https://www.google.com/maps/search/?api=1&amp;query=Chauss%C3%A9e+de+Namur+40+1367+Ramillies" target="_blank">Chaussée de Namur 40<br/>1367 Ramillies</a><br/><span class="text-o-color-2">Fri–Sat / 11PM–6AM</span></p>
                                </div>
                                <div class="pt48 col-lg-12 o_colored_level o_animate o_anim_zoom_out pb40 col-12" style="--wanim-intensity: 10;">
                                    <p><img src="/web/image/night_clubs.img_night_clubs_image_23" alt="EXODIA" class="img img-fluid o_we_custom_image" loading="lazy" style="width: 100% !important;"/></p>
                                </div>
                                <div class="pt24 pb0 col-12 o_colored_level col-lg-12">
                                    <p><span class="o_small-fs text-o-color-2">© EXODIA. All rights reserved.</span></p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
