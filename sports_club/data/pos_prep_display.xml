<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="pos_prep_stage_ordered" model="pos.prep.stage">
        <field name="name">Ordered</field>
        <field name="color">#5778ff</field>
    </record>

    <record id="pos_prep_stage_ready" model="pos.prep.stage">
        <field name="name">Ready</field>
        <field name="color">#ffe438</field>
    </record>

    <record id="pos_prep_stage_completed" model="pos.prep.stage">
        <field name="name">Completed</field>
        <field name="color">#439400</field>
    </record>

    <record id="pos_prep_display_order_preparation" model="pos.prep.display">
        <field name="name">Order Preparation</field>
        <field name="stage_ids" eval="[(6, 0, [
            ref('pos_prep_stage_ordered'),
            ref('pos_prep_stage_ready'),
            ref('pos_prep_stage_completed')
        ])]"/>
    </record>
</odoo>
