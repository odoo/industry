#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.view_page_coaches
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">A former professional "
"player, Elena is the leading expert in doubles strategy. Her situational "
"drills radically transform how you read the game.</span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">埃琳娜曾是职业球员，是双打"
"战术方面的顶尖专家。她的情景化训练能彻底改变你阅读比赛的方式。</span>\n"
"                                                    <br/>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.view_page_coaches
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Fernando is a premier "
"Tactical Coach specializing in game tactics. Through his expert situational "
"drills, he helps players master the art of reading the game and executing "
"winning tactics.</span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">费尔南多是一位顶尖的战术教"
"练，专精比赛战术。通过他的情景化专业训练，他帮助球员掌握阅读比赛并执行制胜战"
"术的艺术。</span>\n"
"                                                    <br/>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.view_page_coaches
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Julien combines physical "
"conditioning and padel technique to give you a decisive edge on the court.</"
"span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">朱利安将体能训练与板式网球"
"技术相结合，让你在球场上获得决定性优势。</span>\n"
"                                                    <br/>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.view_page_coaches
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Sofia turns every session "
"into a fun and rewarding experience. She leads beginner and junior programs "
"with her unique teaching approach.</span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">索菲娅把每一节课都变成有趣"
"而有收获的体验。她以独特的教学方法带领初学者和青少年课程。</span>\n"
"                                                    <br/>"

