#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid "1. Gears<br/>"
msgstr "1. Sprzęt<br/>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid "2. Bar Management<br/>"
msgstr "2. Zarządzanie barem<br/>"

#. module: sports_club
