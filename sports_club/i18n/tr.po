#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.view_page_coaches
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">A former professional "
"player, Elena is the leading expert in doubles strategy. Her situational "
"drills radically transform how you read the game.</span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Eski bir profesyonel "
"oyuncu olan Elena, çiftler stratejisinde önde gelen bir uzmandır. Durumsal "
"antrenmanları, oyunu okuma biçiminizi kökten değiştirir.</span>\n"
"                                                    <br/>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.view_page_coaches
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Fernando is a premier "
"Tactical Coach specializing in game tactics. Through his expert situational "
"drills, he helps players master the art of reading the game and executing "
"winning tactics.</span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Fernando, oyun taktikleri "
"konusunda uzmanlaşmış birinci sınıf bir Taktik Antrenördür. Uzman durumsal "
"antrenmanları sayesinde oyuncuların oyunu okuma ve kazanan taktikleri "
"uygulama sanatında ustalaşmasına yardımcı olur.</span>\n"
"                                                    <br/>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.view_page_coaches
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Julien combines physical "
"conditioning and padel technique to give you a decisive edge on the court.</"
"span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Julien, sahada size "
"belirleyici bir avantaj sağlamak için fiziksel kondisyon ve padel tekniğini "
"birleştirir.</span>\n"
"                                                    <br/>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.view_page_coaches
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Sofia turns every session "
"into a fun and rewarding experience. She leads beginner and junior programs "
"with her unique teaching approach.</span>\n"
"                                                    <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.57);\">Sofia her seansı eğlenceli "
"ve ödüllendirici bir deneyime dönüştürür. Benzersiz öğretim yaklaşımıyla "
"başlangıç ve genç programlarına liderlik eder.</span>\n"
"                                                    <br/>"

