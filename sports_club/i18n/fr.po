msgid ""
"<strong>Payroll:</strong> Use this feature to handle <strong>employee\n"
"                    salaries and manage holiday requests</strong>."
msgstr ""
"<strong>Paie :</strong> Utilisez cette fonctionnalité pour gérer les "
"<strong>salaires des employés \n"
"                    et les demandes de congés</strong>."

