msgid ""
"<strong>Phone<br/></strong>\n"
"                                        +34 931 22 45 80"
msgstr ""

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Purpose:</strong> Designed for social play, allowing individual "
"players\n"
"                    to sign up and join open, existing games."
msgstr ""
"<strong>Objectif :</strong> Conçu pour le jeu social, permettant aux joueurs "
"individuels\n"
"                    de s’inscrire et de rejoindre des parties ouvertes "
"existantes."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Shareable Court Resources:</strong> Because the courts are "
"configured as <strong>shareable\n"
"                    resources</strong>, multiple players can register for "
"the same court\n"
"                    simultaneously. The system will continue to accept "
"registrations for a slot as\n"
"                    long as there are open spots available on that court."
msgstr ""
"<strong>Ressources de terrain partageables :</strong> Comme les terrains "
"sont configurés comme des <strong>ressources\n"
"                    partageables</strong>, plusieurs joueurs peuvent "
"s’inscrire sur le même terrain\n"
"                    simultanément. Le système continuera à accepter les "
"inscriptions pour un créneau tant\n"
"                    qu’il reste des places disponibles sur ce terrain."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Smart Pricelists:</strong> Link these membership levels to custom\n"
"                    pricelists. The system will automatically apply "
"preferential rates, bar\n"
"                    discounts, or free bookings whenever the member makes a "
"purchase."
msgstr ""
"<strong>Listes de prix intelligentes :</strong> Associez ces niveaux "
"d’adhésion à des listes de prix\n"
"                    personnalisées. Le système appliquera automatiquement "
"des tarifs préférentiels, des\n"
"                    réductions au bar ou des réservations gratuites chaque "
"fois que le membre effectue un achat."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Smart Upselling:</strong> The system automatically maximizes "
"revenue. For\n"
"                    example, when a customer purchases a racket, the eShop "
"strategically suggests\n"
"                    relevant add-ons like towels or balls before checkout."
msgstr ""
"<strong>Vente additionnelle intelligente :</strong> Le système maximise "
"automatiquement le chiffre d’affaires. Par\n"
"                    exemple, lorsqu’un client achète une raquette, l’eShop "
"suggère stratégiquement\n"
"                    des articles complémentaires pertinents comme des "
"serviettes ou des balles avant le paiement."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Streamlined Team Scheduling:</strong> Keep your operations running "
"like\n"
"                clockwork by managing all bartender and floor staff shifts "
"directly within the\n"
"                integrated Planning app."
msgstr ""
"<strong>Planning d’équipe simplifié :</strong> Faites tourner vos opérations "
"comme\n"
"                une horloge en gérant tous les créneaux des barmen et du "
"personnel de salle directement dans\n"
"                l’application Planning intégrée."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Streamlined Workflows:</strong> Easily organize your menu into "
"clear\n"
"                    product categories to create an intuitive, fast-paced "
"checkout screen for your\n"
"                    bar staff."
msgstr ""
"<strong>Flux de travail simplifiés :</strong> Organisez facilement votre "
"menu en catégories de\n"
"                    produits claires afin de créer un écran de paiement "
"intuitif et rapide pour votre\n"
"                    personnel de bar."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Subscription-Driven Tiers:</strong> Define your membership packages "
"as\n"
"                    products in the <strong>Subscription App</strong>. When "
"a customer buys one,\n"
"                    Odoo automatically assigns a specific partner level "
"directly to their customer\n"
"                    profile."
msgstr ""
"<strong>Niveaux basés sur les abonnements :</strong> Définissez vos formules "
"d’adhésion comme\n"
"                    des produits dans l’<strong>App Abonnements</strong>. "
"Lorsqu’un client en achète une,\n"
"                    Odoo attribue automatiquement un niveau de partenaire "
"spécifique directement à son profil\n"
"                    client."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Unified Management:</strong> Oversee bar-specific inventory, track\n"
"                    customer tabs, and seamlessly accept every payment "
"method your venue offers from\n"
"                    one screen."
msgstr ""
"<strong>Gestion unifiée :</strong> Supervisez l’inventaire propre au bar, "
"suivez\n"
"                    les notes des clients et acceptez facilement tous les "
"modes de paiement proposés par votre établissement\n"
"                    depuis un seul écran."

