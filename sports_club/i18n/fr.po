#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Accounting:</strong> Automatically log payments, close sessions, "
"and\n"
"                    generate tax reports."
msgstr ""
"<strong>Comptabilité :</strong> Enregistrez automatiquement les paiements, "
"clôturez les sessions et\n"
"                    générez des rapports fiscaux."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Automated Lead Generation:</strong> Every submission on your "
"\"Contact Us\"\n"
"                    page instantly creates a brand-new opportunity in your "
"<strong>CRM App</strong>."
msgstr ""
"<strong>Génération automatisée de pistes :</strong> Chaque soumission sur "
"votre page \"Contactez-nous\"\n"
"                    crée instantanément une toute nouvelle opportunité dans "
"votre <strong>App CRM</strong>."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid "<strong>Availability:</strong> Exclusive to Friday evenings."
msgstr "<strong>Disponibilité :</strong> Exclusivement le vendredi soir."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Cafeteria:</strong> Running their on-site food and beverage\n"
"                            services."
msgstr ""
"<strong>Cafétéria :</strong> Gestion des services de restauration et de "
"boissons\n"
"                            sur place."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Court Rentals:</strong> Managing bookings and scheduling for\n"
"                            players."
msgstr ""
"<strong>Locations de terrains :</strong> Gestion des réservations et du "
"planning pour\n"
"                            les joueurs."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid "<strong>Duration:</strong> 60-minute playing sessions."
msgstr "<strong>Durée :</strong> Sessions de jeu de 60 minutes."

