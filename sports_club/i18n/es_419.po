#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Accounting:</strong> Automatically log payments, close sessions, "
"and\n"
"                    generate tax reports."
msgstr ""
"<strong>Contabilidad:</strong> Registra pagos de forma automática, cierra "
"sesiones y \n"
"                          genera reportes fiscales."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.contactus
msgid "<strong>Are links to other websites approved?</strong>"
msgstr "<strong>¿Los enlaces a otros sitios web están aprobados?</strong>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Automated Lead Generation:</strong> Every submission on your "
"\"Contact Us\"\n"
"                    page instantly creates a brand-new opportunity in your "
"<strong>CRM App</strong>."
msgstr ""
"<strong>Generación automática de leads:</strong> Cada envío desde tu página "
"\"Contáctanos\" \n"
"                    crea una nueva oportunidad al instante en la <strong>"
"aplicación CRM</strong>."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid "<strong>Availability:</strong> Exclusive to Friday evenings."
msgstr ""
"<strong>Disponibilidad:</strong> Exclusivamente los viernes por la noche."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Cafeteria:</strong> Running their on-site food and beverage\n"
"                            services."
msgstr ""
"<strong>Cafetería:</strong> Gestiona los servicios de alimentos y bebidas en "
"tus\n"
"                           instalaciones."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.contactus
msgid "<strong>Can you trust our partners?</strong>"
msgstr "<strong>¿Sus socios son confiables?</strong>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Court Rentals:</strong> Managing bookings and scheduling for\n"
"                            players."
msgstr ""
"<strong>Renta de canchas:</strong> Gestiona las reservaciones y los horarios "
"para los\n"
"                           jugadores."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid "<strong>Duration:</strong> 60-minute playing sessions."
msgstr "<strong>Duración:</strong> Sesiones de juego de 60 minutos."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Flexible Fulfillment:</strong> Customers can choose between "
"convenient\n"
"                    paid home delivery or free in-club pickup."
msgstr ""
"<strong>Opciones de entrega flexibles:</strong> Tus clientes pueden elegir "
"entre entrega a domicilio\n"
"                    con costo o recolección gratuita en el club."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Frequency:</strong> Slots start every 30 minutes to maximize court\n"
"                    turnover and availability."
msgstr ""
"<strong>Frecuencia:</strong> Los horarios comienzan cada 30 minutos para "
"aprovechar al máximo \n"
"                   la rotación y disponibilidad de las canchas."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>From the CRM app:</strong> Track client interactions in real time "
"and use\n"
"                    the <strong>Sales\n"
"                        App</strong> to quickly shoot over tailored "
"quotations for B2B leads or\n"
"                    custom customer requests, or use the "
"<strong>Subscription App</strong> for new\n"
"                    members."
msgstr ""
"<strong>Desde la aplicación CRM:</strong> Da seguimiento a las interacciones "
"con clientes en tiempo real y usa\n"
"                la <strong>aplicación Ventas</strong> para enviar "
"cotizaciones personalizadas con rapidez a leads B2B o\n"
"                solicitudes específicas de clientes, o usa la <strong>"
"aplicación Suscripciones</strong> para nuevos\n"
"                miembros."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Full Restaurant Capabilities:</strong> Do you have a kitchen or\n"
"                            seated dining area? Map out a visual table "
"layout right in the system\n"
"                            and integrate a digital <strong>Kitchen Display "
"System (KDS)</strong> to\n"
"                            seamlessly coordinate orders between the floor "
"and the kitchen."
msgstr ""
"<strong>Funciones completas para restaurantes:</strong> ¿Tienes una cocina o "
"un área con mesas para comer?\n"
"                        Diseña la distribución de las mesas directo en el "
"sistema\n"
"                        e integra un <strong>sistema de visualización para "
"cocina</strong> para\n"
"                        coordinar las órdenes entre tus espacios y la cocina "
"sin complicaciones."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Gear &amp; Equipment:</strong> Handling basic sports gear and\n"
"                            inventory."
msgstr ""
"<strong>Equipo y accesorios:</strong> Gestiona el equipo deportivo básico y "
"el \n"
"                          inventario."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.contactus
msgid "<strong>How is your data secured?</strong>"
msgstr "<strong>¿Cómo garantizan la seguridad de los datos?</strong>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Instant Checkout:</strong> If a player needs gear right before a "
"match or\n"
"                    wants to buy items directly at the club, staff can "
"process the transaction\n"
"                    instantly using the dedicated Shop POS system."
msgstr ""
"<strong>Cobro inmediato:</strong> Si alguien necesita equipo antes de un "
"partido o\n"
"                quiere comprar artículos en el club, el personal puede "
"procesar la transacción\n"
"                al instante con el sistema de punto de venta de la tienda."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Instant Member Scanning:</strong> Link unique barcodes to your\n"
"                            members' profiles. Staff can simply scan a "
"physical or digital\n"
"                            membership card at the bar to instantly apply "
"their preferential\n"
"                            discounts or tab the drinks to their account."
msgstr ""
"<strong>Escaneo instantáneo de miembros:</strong> Vincula códigos de barras "
"únicos a los\n"
"                        perfiles de tus miembros. El personal solo debe "
"escanear la tarjeta de membresía,\n"
"                        física o digital, en el bar para aplicar al "
"instante\n"
"                        los descuentos correspondientes o cargar las bebidas "
"a su cuenta."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Internal Counter Bookings:</strong> For walk-ins or phone "
"reservations,\n"
"                    counter employees can seamlessly book courts on behalf "
"of members by navigating\n"
"                    to the <strong>Appointments\n"
"                        &gt; Resource Schedule</strong> menu."
msgstr ""
"<strong>Reservaciones internas desde el mostrador:</strong> Para personas "
"que llegan sin cita o reservan por teléfono,\n"
"                el personal del mostrador puede reservar canchas en nombre "
"de los miembros desde el menú\n"
"                <strong>Citas \n"
"                &gt; Programación de recursos</strong>."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.contactus
msgid "<strong>Is the website user-friendly?</strong>"
msgstr "<strong>¿El sitio web es fácil de usar?</strong>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Payroll:</strong> Use this feature to handle <strong>employee\n"
"                    salaries and manage holiday requests</strong>."
msgstr ""
"<strong>Nómina:</strong> Usa esta función para gestionar <strong>los sueldos "
"\n"
"              de los empleados y las solicitudes de vacaciones</strong>."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Purpose:</strong> Designed for social play, allowing individual "
"players\n"
"                    to sign up and join open, existing games."
msgstr ""
"<strong>Propósito:</strong> Diseñado para juego social, permite que cada "
"jugador se registre \n"
"                   y se una a partidas abiertas ya existentes."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Shareable Court Resources:</strong> Because the courts are "
"configured as <strong>shareable\n"
"                    resources</strong>, multiple players can register for "
"the same court\n"
"                    simultaneously. The system will continue to accept "
"registrations for a slot as\n"
"                    long as there are open spots available on that court."
msgstr ""
"<strong>Recursos compartidos para las canchas:</strong> Como las canchas "
"están configuradas como <strong>recursos \n"
"                compartidos</strong>, varias personas pueden registrarse "
"para usar la misma cancha\n"
"                al mismo tiempo. El sistema seguirá aceptando registros para "
"un horario\n"
"                mientras todavía haya lugares disponibles en esa cancha."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Smart Pricelists:</strong> Link these membership levels to custom\n"
"                    pricelists. The system will automatically apply "
"preferential rates, bar\n"
"                    discounts, or free bookings whenever the member makes a "
"purchase."
msgstr ""
"<strong>Listas de precios inteligentes:</strong> Vincula estos niveles de "
"membresía a listas de precios personalizadas.\n"
"                El sistema aplicará de forma automática tarifas "
"preferenciales, descuentos en el bar\n"
"                o reservaciones gratuitas cuando un miembro haga una compra."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Smart Upselling:</strong> The system automatically maximizes "
"revenue. For\n"
"                    example, when a customer purchases a racket, the eShop "
"strategically suggests\n"
"                    relevant add-ons like towels or balls before checkout."
msgstr ""
"<strong>Venta adicional inteligente:</strong> El sistema maximiza los "
"ingresos de forma automática. Por ejemplo,\n"
"                cuando un cliente compra una raqueta, la tienda en línea "
"sugiere productos relacionados,\n"
"                como toallas o pelotas, antes de finalizar la compra."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Streamlined Team Scheduling:</strong> Keep your operations running "
"like\n"
"                clockwork by managing all bartender and floor staff shifts "
"directly within the\n"
"                integrated Planning app."
msgstr ""
"<strong>Programación simple del equipo:</strong> Mantén tus operaciones en "
"orden\n"
"                 al gestionar todos los turnos del personal de barra y de "
"piso desde la aplicación \n"
"                Planeación integrada."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Streamlined Workflows:</strong> Easily organize your menu into "
"clear\n"
"                    product categories to create an intuitive, fast-paced "
"checkout screen for your\n"
"                    bar staff."
msgstr ""
"<strong>Flujos de trabajo optimizados:</strong> Organiza tu menú en "
"categorías de productos \n"
"                   claras para crear una pantalla de cobro intuitiva y ágil "
"para \n"
"                   el personal del bar."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Subscription-Driven Tiers:</strong> Define your membership packages "
"as\n"
"                    products in the <strong>Subscription App</strong>. When "
"a customer buys one,\n"
"                    Odoo automatically assigns a specific partner level "
"directly to their customer\n"
"                    profile."
msgstr ""
"<strong>Niveles basados en suscripciones:</strong> Define tus paquetes de "
"membresía como\n"
"                productos en la <strong>aplicación Suscripciones</strong>. "
"Cuando un cliente compre uno,\n"
"                Odoo asignará un nivel específico al perfil del \n"
"                cliente de forma automática."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Unified Management:</strong> Oversee bar-specific inventory, track\n"
"                    customer tabs, and seamlessly accept every payment "
"method your venue offers from\n"
"                    one screen."
msgstr ""
"<strong>Gestión unificada:</strong> Supervisa el inventario del bar, da "
"seguimiento\n"
"                    a las cuentas de los clientes y acepta todos los métodos "
"de pago que ofrece tu establecimiento\n"
"                    desde una sola pantalla."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.contactus
msgid "<strong>What sets us apart?</strong>"
