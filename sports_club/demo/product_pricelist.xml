<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Dedicated pricelists for this demo website: data/product_pricelist.xml
    already bound product_pricelist_1/2 to base.default_website, and that
    assignment must stay untouched, so new records are created here instead
    of reassigning them. -->
    <record id="product_pricelist_3" model="product.pricelist">
        <field name="name">Members</field>
        <field name="website_id" ref="website_industry"/>
    </record>
    <record id="product_pricelist_4" model="product.pricelist">
        <field name="name">Default</field>
        <field name="website_id" ref="website_industry"/>
    </record>
</odoo>
