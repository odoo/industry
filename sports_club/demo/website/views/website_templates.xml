<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Padelo - Footer</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 2px; border-left-color: var(--o-color-1) !important; border-bottom-color: var(--o-color-1) !important; border-right-color: var(--o-color-1) !important; border-top-color: var(--o-color-1) !important;">
                    <section class="s_text_block pt40 pb32 bg-o-color-5" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="pt24 o_colored_level col-lg-3 pb40 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                    <p>
                                        <img src="/web/image/sports_club.img_custom_sports_club_image_16" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" loading="lazy" role="presentation"/>
                                    </p>
                                    <p>
                                        <span class="h6-fs">Modern courts for all levels</span>
                                    </p>
                                    <p>
                                        <br/>
                                    </p>
                                    <p>
                                        <span class="h6-fs">
                                            <a href="*court_booking*" class="o_translate_inline btn btn-primary">Book a court</a>
                                        </span>
                                    </p>
                                </div>
                                <div class="pt24 o_colored_level pb40 offset-lg-1 col-lg-2 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                    <p>
                                        <span class="o_small-fs text-o-color-1">NAVIGATION</span>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li>
                                            <span class="h4-fs">
                                                <a href="/">Home</a>
                                            </span>
                                        </li>
                                        <li>
                                            <span class="h4-fs">
                                                <a href="/our-club">Our club</a>
                                            </span>
                                            <br/>
                                        </li>
                                        <li>
                                            <span class="h4-fs">
                                                <a href="/products">Products</a>
                                            </span>
                                            <br/>
                                        </li>
                                        <li>
                                            <span class="h4-fs">
                                                <a href="/coaches">Coaches</a>
                                            </span>
                                            <br/>
                                        </li>
                                        <li>
                                            <span class="h4-fs">
                                                <a href="/contactus">Join us</a>
                                            </span>
                                            <br/>
                                        </li>
                                    </ul>
                                    <p>
                                        <br/>
                                    </p>
                                    <p>
                                        <br/>
                                    </p>
                                </div>
                                <div class="pt24 pb40 o_colored_level col-lg-3 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                    <p>
                                        <span class="o_small-fs text-o-color-1">OPENING HOURS</span>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li style="font-weight: bolder;">Every day</li>
                                        <li>From 7AM to 10PM</li>
                                    </ul>
                                </div>
                                <div class="pt24 o_colored_level pb40 col-lg-3 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                    <p>
                                        <span class="o_small-fs text-o-color-1">INFO</span>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li style="font-weight: bolder;">Padelo</li>
                                        <li>Calle del Pino Grueso 2790</li>
                                        <li>08458 Barcelona</li>
                                        <li>Spain</li>
                                    </ul>
                                    <p>
                                        <strong>Phone<br/></strong>
                                        +34 931 22 45 80
                                    </p>
                                    <p>
                                        <strong>Email<br/></strong>
                                        hello@padelo.example.com
                                    </p>
                                </div>
                                <div class="pt24 o_colored_level col-lg-12 pb0">
                                    <p>
                                        <img src="/web/image/sports_club.img_custom_sports_club_image_17" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id o_animate o_anim_fade_in o_visible o_anim_from_bottom" loading="eager" style="--wanim-intensity: 15; animation-duration: 0.5s;" role="presentation"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Padelo - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="*court_booking*" class="oe_unremovable btn btn-primary btn_cta">Book a court</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
</odoo>
