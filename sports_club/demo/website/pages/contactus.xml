<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">sports_club.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="sports_club.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{ 'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', ''), }"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block o_colored_level o_cc o_cc2 pt192 s_custom_snippet pb56" data-snippet="s_text_block" data-name="Custom Text (2)">
                            <div class="container s_allow_columns">
                                <p>
                                    <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">
                                        <span class="fa fa-circle text-o-color-1" style="padding-right: 8px;"/>
                                        <span class="h6-fs">Join us</span>
                                    </span>
                                </p>
                                <h1>
                                    <span class="h2-fs">
                                        <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">Ready to join our club?</span>
                                    </span>
                                </h1>
                            </div>
                        </section>
                        <section class="s_website_form_cover o_colored_level o_cc o_cc2" data-snippet="s_website_form_cover" data-name="Form Cover">
                            <div class="container-fluid">
                                <div class="row s_nb_column_fixed">
                                    <div class="oe_img_bg o_bg_img_center o_not_editable pt128 pb128 o_colored_level o_bg_img_origin_border_box col-lg-6 o_animate o_anim_fade_in o_visible" style="background-image: url(&quot;/web/image/sports_club.img_custom_sports_club_image_06&quot;); animation-name: dummy;" data-format-mimetype="image/webp" data-resize-width="962" data-mimetype="image/webp"/>
                                    <div class="pt48 pb48 px-4 o_colored_level o_cc o_cc2 col-lg-6 border o_animate o_anim_fade_in o_visible" style="--box-border-left-width: 20px; --box-border-bottom-width: 20px; --box-border-right-width: 20px; --box-border-top-width: 20px; border-left-color: var(--o-color-3) !important; border-bottom-color: var(--o-color-3) !important; border-right-color: var(--o-color-3) !important; border-top-color: var(--o-color-3) !important; animation-name: dummy;">
                                        <h2>
                                            <span class="h3-fs">Fill in the form</span>
                                        </h2>
                                        <p>Tell us why you want to join our club and we'll be more than happy to welcome you.</p>
                                        <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container-fluid">
                                                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name">
                                                            <label class="s_website_form_label" for="o3kkfczz9mx" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="" id="o3kkfczz9mx" data-fill-with="name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="tel" data-translated-name="Phone Number">
                                                            <label class="s_website_form_label" for="orszbg56qff" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="phone" value="" placeholder="" id="orszbg56qff" data-fill-with="phone"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required col-lg-6" data-type="email" data-translated-name="Your Email">
                                                            <label class="s_website_form_label" for="o25eqbnc4azy" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="" id="o25eqbnc4azy" data-fill-with="email"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject">
                                                            <label class="s_website_form_label" for="otwvoo13tgb" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="New membership" id="otwvoo13tgb" data-fill-with="undefined"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="Your Question">
                                                            <label class="s_website_form_label" for="o8em8pluxpw2" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Why would like to join?</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="" placeholder="New in town, want to make friends, ..." id="o8em8pluxpw2" rows="3"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 undefined s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px;">
                                                                    <span class="s_website_form_label_content"/>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input type="hidden" class="form-control s_website_form_input" name="team_id" value="__EXPORT_FILTER_XMLID__sports_club.crm_team_5__EXPORT_FILTER_XMLID__"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"/>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send o_translate_inline">Send request</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
