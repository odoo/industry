<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_our_club" model="ir.ui.view">
        <field name="name">Our club</field>
        <field name="key">sports_club.page_our_club</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="About Us" t-name="sports_club.page_our_club">
                <t t-call="website.layout">
                    <div id="wrap" class="">
                        <div class="oe_structure">
                            <section class="s_text_block o_colored_level o_cc o_cc2 pt192 s_custom_snippet pb96" data-snippet="s_text_block" data-name="Custom Text">
                                <div class="container s_allow_columns">
                                    <div class="row">
                                        <div class="o_colored_level col-lg-6">
                                            <p>
                                                <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">
                                                    <span class="fa fa-circle text-o-color-1" style="padding-right: 8px;"/>
                                                    <span class="h6-fs">The club</span>
                                                </span>
                                            </p>
                                            <h1>
                                                <span class="h2-fs">
                                                    <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">Born from a <span class="text-o-color-1">shared passion</span> for padel&amp;nbsp;and the belief that sport brings people together.</span>
                                                </span>
                                            </h1>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            <section class="s_parallax parallax s_parallax_is_fixed o_colored_level pt256 pb256" data-scroll-background-ratio="1" data-snippet="s_parallax" data-name="Parallax">
                                <span class="s_parallax_bg_wrap">
                                    <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/sports_club.img_custom_sports_club_image_01&quot;); background-position: 50% 100%;" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp"/>
                                </span>
                                <div class="o_we_bg_filter bg-black-25"/>
                                <div class="oe_structure oe_empty"/>
                            </section>
                            <section class="s_three_columns o_cc o_colored_level o_cc2 pb112 s_custom_snippet pt104" data-vxml="001" data-vcss="001" data-snippet="s_three_columns" data-name="Custom Columns">
                                <div class="container">
                                    <div class="row d-flex">
                                        <div class="col-lg-12 pb32">
                                            <p style="text-align: center;">
                                                <span class="fa fa-circle text-o-color-1" style="padding-right: 8px;"/>
                                                <span class="h6-fs">Our services</span>
                                            </p>
                                            <h2 style="text-align: center;">Explore our facilities <span class="text-o-color-1">&amp;</span> services</h2>
                                        </div>
                                        <div data-name="Card" class="col-lg-4">
                                            <div class="s_card o_card_img_top card h-100 o_cc my-0 rounded border o_cc2 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 20px; --box-border-bottom-right-radius: 20px; --box-border-top-right-radius: 20px; --box-border-top-left-radius: 20px; --box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px; border-left-color: var(--o-color-5) !important; border-bottom-color: var(--o-color-5) !important; border-right-color: var(--o-color-5) !important; border-top-color: var(--o-color-5) !important;">
                                                <figure class="o_card_img_wrapper ratio ratio-16x9 mb-0">
                                                    <img src="/web/image/sports_club.img_custom_sports_club_image_03" alt="Community" class="o_card_img card-img-top o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                                </figure>
                                                <div class="card-body">
                                                    <p>
                                                        <span class="text-o-color-1">01</span>
                                                    </p>
                                                    <h3>
                                                        <span class="h4-fs">Community Matches</span>
                                                        <br/>
                                                    </h3>
                                                    <p class="card-text">Weekly friendly matches organized to meet new players.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div data-name="Card" class="col-lg-4">
                                            <div class="s_card o_card_img_top card h-100 o_cc my-0 rounded border o_cc2 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 20px; --box-border-bottom-right-radius: 20px; --box-border-top-right-radius: 20px; --box-border-top-left-radius: 20px; --box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px; border-left-color: var(--o-color-5) !important; border-bottom-color: var(--o-color-5) !important; border-right-color: var(--o-color-5) !important; border-top-color: var(--o-color-5) !important;">
                                                <figure class="o_card_img_wrapper ratio ratio-16x9 mb-0">
                                                    <img src="/web/image/sports_club.img_custom_sports_club_image_04" alt="Group training session" class="o_card_img card-img-top o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                                </figure>
                                                <div class="card-body">
                                                    <p>
                                                        <span class="text-o-color-1">02</span>
                                                    </p>
                                                    <h3>
                                                        <span class="h4-fs">Group Training Sessions</span>
                                                    </h3>
                                                    <p class="card-text">Group sessions with our certified coaches to progress together.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div data-name="Card" class="col-lg-4">
                                            <div class="s_card o_card_img_top card h-100 o_cc my-0 rounded border o_cc2 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 20px; --box-border-bottom-right-radius: 20px; --box-border-top-right-radius: 20px; --box-border-top-left-radius: 20px; --box-border-left-width: 2px; --box-border-bottom-width: 2px; --box-border-right-width: 2px; --box-border-top-width: 2px; border-left-color: var(--o-color-5) !important; border-bottom-color: var(--o-color-5) !important; border-right-color: var(--o-color-5) !important; border-top-color: var(--o-color-5) !important;">
                                                <figure class="o_card_img_wrapper ratio ratio-16x9 mb-0">
                                                    <img src="/web/image/sports_club.img_custom_sports_club_image_05" alt="Coaching 1 on 1" class="o_card_img card-img-top o_editable_media img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                                </figure>
                                                <div class="card-body">
                                                    <p>
                                                        <span class="text-o-color-1">03</span>
                                                    </p>
                                                    <h3>
                                                        <span class="h4-fs">1-on-1 Coaching</span>
                                                        <br/>
                                                    </h3>
                                                    <p class="card-text">Personalized coaching tailored to your level and goals.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            <section class="s_cta_box pb80 o_colored_level s_custom_snippet pt80" data-snippet="s_cta_box" data-name="Custom Box Call to Action">
                                <div class="container">
                                    <div class="s_card card o_cc o_colored_level rounded o_cc2 border oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-snippet="s_card" data-vxml="001" data-name="Card" style="--card-spacer-x: 64px; --card-spacer-y: 64px; --box-border-bottom-left-radius: 20px; --box-border-bottom-right-radius: 20px; --box-border-top-right-radius: 20px; --box-border-top-left-radius: 20px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; background-image: url(&quot;/web/image/sports_club.img_custom_sports_club_image_02&quot;); position: relative;" data-mimetype="undefined">
                                        <div class="card-body" style="text-align: center;">
                                            <h2 class="card-title" style="text-align: center;">Ready to play with us?</h2>
                                            <p class="card-text" style="text-align: center;">Join us this week — your <strong>first trial lesson is free</strong>. No equipment required.</p>
                                            <a class="o_translate_inline btn btn-primary" href="/contactus">Join the club</a>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>
                        <div class="oe_structure">
                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_our_club" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_our_club"/>
            <field name="url">/our-club</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
