<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_products" model="ir.ui.view">
        <field name="name">Products</field>
        <field name="key">sports_club.page_products</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="sports_club.page_products">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block o_colored_level o_cc o_cc2 pt192 s_custom_snippet pb40" data-snippet="s_text_block" data-name="Custom Text (2)">
                            <div class="container s_allow_columns">
                                <p>
                                    <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">
                                        <span class="fa fa-circle text-o-color-1" style="padding-right: 8px;"/>
                                        <span class="h6-fs">Equipment</span>
                                    </span>
                                </p>
                                <h1>
                                    <span class="h2-fs">
                                        <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">Our selection</span>
                                    </span>
                                </h1>
                            </div>
                        </section>
                        <section data-snippet="s_dynamic_snippet_products"
                            class="s_dynamic_snippet_products oe_website_sale s_dynamic pb64 s_product_product_products_item o_colored_level o_carousel_multi_items o_wsale_products_opt_thumb_2_3 o_wsale_products_opt_thumb_cover o_wsale_products_opt_img_secondary_show o_wsale_products_opt_img_hover_zoom_out_light o_wsale_products_opt_actions_onhover o_wsale_products_opt_wishlist_fixed o_wsale_products_opt_layout_catalog o_wsale_products_opt_design_bento o_cc o_cc2 o_wsale_products_opt_has_description o_wsale_products_opt_overlay_opacity_10 o_wsale_products_opt_cc5 o_wsale_products_opt_cc o_wsale_products_opt_rounded_4 o_wsale_products_opt_hover_show_description o_wsale_products_opt_has_wishlist o_wsale_products_opt_has_cta o_wsale_products_opt_actions_theme pt0 o_dynamic_snippet_loading"
                            data-custom-template-data="{}"
                            data-number-of-records="16"
                            data-name="Products"
                            data-show-variants="true"
                            data-filter-id="__EXPORT_FILTER_XMLID__website_sale.dynamic_filter_newest_products__EXPORT_FILTER_XMLID__"
                            data-template-key="website_sale.dynamic_filter_template_product_product_products_item"
                            data-number-of-elements="4"
                            data-number-of-elements-small-devices="2"
                            data-carousel-interval="5000"
                            data-product-category-id="__EXPORT_FILTER_XMLID__sports_club.product_public_category_2__EXPORT_FILTER_XMLID__"
                            data-gap-to-save="24px"
                            style="--o-wsale-products-grid-gap: 24px; position: relative;"
                            data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/14&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}">
                            <div class="o_we_shape o_html_builder_Connections_14" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F14.svg?c5=%23FFFFFF&quot;);"/>
                            <div class="s_dynamic_snippet_container container">
                                <div class="row s_nb_column_fixed">
                                    <section class="s_dynamic_snippet_holder d-none px-4 placeholder-glow o_colored_level">
                                        <div class="row">
                                            <span class="placeholder col-3 rounded"/>
                                            <span class="placeholder col-2 offset-7 rounded"/>
                                            <span class="placeholder mt-3 col-6 rounded"/>
                                        </div>
                                        <div class="row mt-4">
                                            <span class="placeholder col-12 rounded" style="height: 250px;"/>
                                        </div>
                                    </section>
                                    <section class="d-flex flex-column s_dynamic_snippet_title oe_unremovable oe_unmovable mb-lg-0 pb-3 pb-md-0 s_col_no_resize o_colored_level d-none">
                                        <div class="w-lg-50">
                                            <h2>
                                                <span class="h3-fs">
                                                    <span class="o_animated_text o_animate o_anim_fade_in o_visible" style="--wanim-intensity: 15; animation-duration: 0.5s;">Rackets for all levels</span>
                                                </span>
                                            </h2>
                                        </div>
                                    </section>
                                    <section class="s_dynamic_snippet_content oe_unremovable oe_unmovable o_not_editable col s_col_no_resize o_colored_level">
                                        <div class="css_non_editable_mode_hidden">
                                            <div class="missing_option_warning alert alert-info fade show d-none d-print-none rounded-0"> Your Dynamic Snippet will be displayed here... This message is displayed because you did not provide enough options to retrieve its content.<br/>
                                            </div>
                                        </div>
                                        <div class="dynamic_snippet_template"/>
                                    </section>
                                </div>
                            </div>
                        </section>
                        <section class="s_cta_box pb80 o_colored_level s_custom_snippet pt88" data-snippet="s_cta_box" data-name="Custom Box Call to Action">
                            <div class="container">
                                <div class="s_card card o_cc o_colored_level rounded o_cc2 border oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-snippet="s_card" data-vxml="001" data-name="Card" style="--card-spacer-x: 64px; --card-spacer-y: 64px; --box-border-bottom-left-radius: 20px; --box-border-bottom-right-radius: 20px; --box-border-top-right-radius: 20px; --box-border-top-left-radius: 20px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; background-image: url(&quot;/web/image/sports_club.img_custom_sports_club_image_02&quot;); position: relative;" data-mimetype="undefined">
                                    <div class="card-body" style="text-align: center;">
                                        <h2 class="card-title" style="text-align: center;">Ready to play with us?</h2>
                                        <p class="card-text" style="text-align: center;">Join us this week — your <strong>first trial lesson is free</strong>. No equipment required.</p>
                                        <a class="o_translate_inline btn btn-primary" href="/contactus">Join the club</a>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_products" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_products"/>
            <field name="url">/products</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
