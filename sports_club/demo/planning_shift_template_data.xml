<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="planning.planning_slot_template_standard" model="planning.slot.template" forcecreate="1">
        <field name="start_time" eval="9"/>
        <field name="end_time" eval="17"/>
        <field name="duration_days" eval="1"/>
        <field name="sequence" eval="15"/>
    </record>

    <record id="planning.planning_slot_template_morning" model="planning.slot.template" forcecreate="1">
        <field name="start_time" eval="6"/>
        <field name="end_time" eval="14"/>
        <field name="duration_days" eval="1"/>
        <field name="sequence" eval="16"/>
    </record>

    <record id="planning.planning_slot_template_afternoon" model="planning.slot.template" forcecreate="1">
        <field name="start_time" eval="14"/>
        <field name="end_time" eval="23"/>
        <field name="duration_days" eval="1"/>
        <field name="sequence" eval="17"/>
    </record>
    
    <record id="planning.planning_slot_template_night" model="planning.slot.template" forcecreate="0">
        <field name="active" eval="False"/>
    </record>
</odoo>
