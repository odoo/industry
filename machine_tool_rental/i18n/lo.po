#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Accounting:</strong> Full financial management with real-time "
"insights."
msgstr ""
"<strong>ການບັນຊີ:</strong> ການຄຸ້ມຄອງການເງິນແບບຄົບວົງຈອນ ພ້ອມຂໍ້ມູນເຈາະລຶກແບບສົດໆ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Assign maintenance locations</strong> for equipment under service."
msgstr ""
"<strong>ກຳນົດສະຖານທີ່ບຳລຸງຮັກສາ</strong> ສຳລັບອຸປະກອນທີ່ກຳລັງຢູ່ໃນໄລຍະບໍລິການ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Basics</strong>"
msgstr "<strong>ພື້ນຖານ</strong>"

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Check equipment availability</strong> in real time with serial "
"tracking."
msgstr ""
"<strong>ກວດສອບຄວາມພ້ອມໃຊ້ງານຂອງອຸປະກອນ</strong> ແບບທັນທີ ດ້ວຍການຕິດຕາມໝາຍເລກຊີຣຽວ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Collaborate in chatter</strong> to keep all communication "
"centralized."
msgstr ""
"<strong>ຮ່ວມມືກັນໃນຊ່ອງສົນທະນາ</strong> ເພື່ອລວມສູນການສື່ສານທັງໝົດໄວ້ບ່ອນດຽວ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Convert to offer</strong> any opportunity in one click."
msgstr "<strong>ປ່ຽນເປັນຂໍ້ສະເໜີ</strong> ຈາກທຸກກາລະໂອກາດໄດ້ດ້ວຍການຄລິກດຽວ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Create rental orders</strong> from CRM opportunities or directly in "
"the app."
msgstr ""
"<strong>ສ້າງໃບສັ່ງເຊົ່າ</strong> ຈາກກາລະໂອກາດໃນ CRM ຫຼື ສ້າງໂດຍກົງໃນແອັບ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Do you want to go further?</strong>"
msgstr "<strong>ທ່ານຕ້ອງການໄປຕໍ່ອີກບໍ່?</strong>"

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Employees:</strong> Manage HR operations including time-off and "
"contracts."
msgstr ""
"<strong>ພະນັກງານ:</strong> ຄຸ້ມຄອງວຽກງານບຸກຄະລາກອນ ລວມທັງການລາພັກ ແລະ ສັນຍາຈ້າງ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Enable recurring billing</strong> for long-term rentals."
msgstr "<strong>ເປີດນຳໃຊ້ການຮຽກເກັບເງິນແບບປະຈຳ</strong> ສຳລັບການເຊົ່າໄລຍະຍາວ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Final word</strong>"
msgstr "<strong>ຄຳລົງທ້າຍ</strong>"

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Fleet:</strong> Keep track of vehicles used for delivery and pickup."
msgstr ""
"<strong>ພາຫະນະ:</strong> ຕິດຕາມຍານພາຫະນະທີ່ໃຊ້ສຳລັບການຈັດສົ່ງ ແລະ ຮັບເຄື່ອງ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Generate invoices</strong> directly from rental orders."
msgstr "<strong>ສ້າງໃບແຈ້ງໜີ້</strong> ໂດຍກົງຈາກໃບສັ່ງເຊົ່າ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>How to Use:</strong>"
msgstr "<strong>ວິທີນຳໃຊ້:</strong>"

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>In such situation, feel free to experiment with this database and "
"then to create a new one for your own usage.</strong>"
msgstr ""
"<strong>ໃນກໍລະນີດັ່ງກ່າວ, ທ່ານສາມາດທົດລອງນຳໃຊ້ຖານຂໍ້ມູນນີ້ໄດ້ຕາມສະບາຍ ແລ້ວຈຶ່ງສ້າງຖານຂໍ້ມູນໃໝ່ສຳລັບກ"
"ານນຳໃຊ້ຕົວຈິງຂອງທ່ານເອງ.</strong>"

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Integrate with inventory</strong> to automatically trigger quality "
"checks."
msgstr ""
"<strong>ເຊື່ອມໂຍງກັບສາງສິນຄ້າ</strong> ເພື່ອກະຕຸ້ນການກວດສອບຄຸນນະພາບໂດຍອັດຕະໂນມັດ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Link runtime data</strong> to serials for maintenance planning."
msgstr ""
"<strong>ເຊື່ອມໂຍງຂໍ້ມູນຊົ່ວໂມງເຮັດວຽກ</strong> ເຂົ້າກັບໝາຍເລກຊີຣຽວ ເພື່ອວາງແຜນການບຳລຸງຮັກສາ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Log inspection results</strong> and mark equipment as available only "
"if it passes."
msgstr ""
"<strong>ບັນທຶກຜົນການກວດກາ</strong> ແລະ ໝາຍວ່າອຸປະກອນພ້ອມໃຊ້ງານກໍຕໍ່ເມື່ອຜ່ານການກວດກາເທົ່ານັ້ນ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Manage returns</strong> and extensions easily from the order."
msgstr ""
"<strong>ຄຸ້ມຄອງການສົ່ງຄືນ</strong> ແລະ ການຕໍ່ເວລາເຊົ່າໄດ້ຢ່າງງ່າຍດາຍຈາກໃບສັ່ງ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Organize pipelines</strong> by stages (e.g., New Lead → Quotation "
"Sent → Won/Lost)."
msgstr ""
"<strong>ຈັດລະບຽບຂະບວນການຂາຍ</strong> ຕາມຂັ້ນຕອນ (ເຊັ່ນ: ລູກຄ້າເປົ້າໝາຍໃໝ່ → ສົ່ງໃບສະເໜີລາຄ"
"າແລ້ວ → ສຳເລັດ/ຫຼຸດ)."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Perform two-step returns</strong>: Receive and then perform a "
"Quality Check."
msgstr ""
"<strong>ດຳເນີນການສົ່ງຄືນແບບສອງຂັ້ນຕອນ</strong>: ຮັບເຄື່ອງ ແລ້ວຈຶ່ງດຳເນີນການກວດສອບຄຸນນະພາບ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Schedule follow-ups</strong> directly from the CRM dashboard."
msgstr "<strong>ກຳນົດເວລາຕິດຕາມວຽກ</strong> ໂດຍກົງຈາກກະດານຄວບຄຸມ CRM."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Set quality control points</strong> for post-return inspections."
msgstr "<strong>ກຳນົດຈຸດຄວບຄຸມຄຸນນະພາບ</strong> ສຳລັບການກວດກາຫຼັງການສົ່ງຄືນ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Track leads</strong> from website forms, email, or manually entered "
"inquiries."
msgstr ""
"<strong>ຕິດຕາມລູກຄ້າເປົ້າໝາຍ</strong> ຈາກແບບຟອມເວັບໄຊ, ອີເມວ, ຫຼື ການສອບຖາມທີ່ປ້ອນດ້ວຍຕົນເອ"
"ງ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Track payments and follow up</strong> with automatic reminders."
msgstr ""
"<strong>ຕິດຕາມການຊຳລະເງິນ ແລະ ຕິດຕາມທວງຖາມ</strong> ດ້ວຍການແຈ້ງເຕືອນແບບອັດຕະໂນມັດ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Track serial numbers</strong> and view their availability instantly."
msgstr "<strong>ຕິດຕາມໝາຍເລກຊີຣຽວ</strong> ແລະ ເບິ່ງຄວາມພ້ອມໃຊ້ງານໄດ້ທັນທີ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid "<strong>Use case</strong>"
msgstr "<strong>ກໍລະນີການນຳໃຊ້</strong>"

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"<strong>Website &amp; eCommerce:</strong> Display rental catalog online and "
"allow direct booking."
msgstr ""
"<strong>ເວັບໄຊ &amp; ອີຄອມເມີຊ:</strong> ສະແດງລາຍການສິນຄ້າເຊົ່າທາງອອນລາຍ ແລະ ອະນຸຍາດໃ"
"ຫ້ຈອງໄດ້ໂດຍກົງ."

#. module: machine_tool_rental
#: model_terms:ir.ui.view,arch_db:machine_tool_rental.welcome_article_body
msgid ""
"Automate your invoicing flow with recurring invoices that are triggered by "
"ongoing rental contracts."
msgstr ""
