#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Accounting</strong>: Keep track of income from sales, donations, and "
"sponsors."
msgstr "<strong>ບັນຊີ</strong>: ຕິດຕາມລາຍຮັບຈາກການຂາຍ, ການບໍລິຈາກ ແລະ ຜູ້ສະໜັບສະໜູນ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Apps &amp; What They Do:</strong>"
msgstr "<strong>ແອັບ ແລະ ສິ່ງທີ່ແອັບເຮັດໄດ້:</strong>"

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Attendance</strong>: Monitor registrations and scan tickets at the "
"entrance."
msgstr "<strong>ການເຂົ້າຮ່ວມ</strong>: ຕິດຕາມການລົງທະບຽນ ແລະ ສະແກນປີ້ຢູ່ທາງເຂົ້າ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>CRM</strong>: Track leads and partnerships with sponsors, agencies, "
"and groups."
msgstr ""
"<strong>CRM</strong>: ຕິດຕາມລູກຄ້າທີ່ມຸ່ງຫວັງ ແລະ ການຮ່ວມມືກັບຜູ້ສະໜັບສະໜູນ, ຕົວແທນ ແລະ "
"ກຸ່ມຕ່າງໆ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Dashboards</strong>: Visualize performance with real-time KPIs."
msgstr "<strong>ແຜງຄວບຄຸມ</strong>: ສະແດງຜົນການດຳເນີນງານດ້ວຍຕົວຊີ້ວັດ (KPI) ແບບສົດໆ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Email Marketing</strong>: Send newsletters and pre-sales to loyal "
"fans."
msgstr ""
"<strong>ການຕະຫຼາດຜ່ານອີເມວ</strong>: ສົ່ງຈົດໝາຍຂ່າວ ແລະ ການເປີດຂາຍປີ້ລ່ວງໜ້າໃຫ້ແກ່ແຟນຄລັບ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Events</strong>: Create event details, schedule, tickets, pricing, "
"and reminders."
msgstr ""
"<strong>ງານກິດຈະກຳ</strong>: ສ້າງລາຍລະອຽດງານ, ຕາຕະລາງ, ປີ້, ລາຄາ ແລະ ການແຈ້ງເຕືອນ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Events</strong>: Plan, publish, and manage concerts with "
"registrations and attendance tracking."
msgstr ""
"<strong>ງານກິດຈະກຳ</strong>: ວາງແຜນ, ເຜີຍແຜ່ ແລະ ຈັດການຄອນເສີດ ພ້ອມທັງລະບົບລົງທະບຽນ "
"ແລະ ຕິດຕາມການເຂົ້າຮ່ວມ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.view_page_home
msgid ""
"<strong>FEEL THE <span class=\"text-o-color-1\">BEAT</span>.<br/><span "
"class=\"text-o-color-1\">LIVE</span> THE MOMENT.</strong>"
msgstr ""
"<strong>ສຳຜັດກັບ <span class=\"text-o-color-1\">ຈັງຫວະ</span>.<br/><span "
"class=\"text-o-color-1\">ດື່ມດ່ຳ</span> ກັບທຸກຊ່ວງເວລາ.</strong>"

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.template_footer_mega_columns
msgid "<strong>Follow us</strong>"
msgstr "<strong>ຕິດຕາມພວກເຮົາ</strong>"

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Get an instant overview </strong>: need to understand what needs to "
"be done? The Project Stages and Status icons give you an instant overview of "
"where things are at, and what needs to be prioritized."
msgstr ""
"<strong>ຮັບພາບລວມທັນທີ </strong>: ຕ້ອງການເຂົ້າໃຈສິ່ງທີ່ຕ້ອງເຮັດບໍ? ຂັ້ນຕອນຂອງໂຄງການ ແລະ "
"ໄອຄອນສະຖານະ ຈະຊ່ວຍໃຫ້ທ່ານເຫັນພາບລວມໄດ້ທັນທີວ່າວຽກຮອດໃສແລ້ວ ແລະ "
"ສິ່ງໃດທີ່ຕ້ອງຈັດລຳດັບຄວາມສຳຄັນກ່ອນ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.template_footer_mega_columns
msgid "<strong>Get in touch</strong>"
msgstr "<strong>ຕິດຕໍ່ພວກເຮົາ</strong>"

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Inventory</strong>: Stay on top of merch and bar stock levels."
msgstr ""
"<strong>ສາງສິນຄ້າ</strong>: ຕິດຕາມສະຕັອກສິນຄ້າທີ່ລະນຶກ ແລະ ເຄື່ອງດື່ມໃນບາໄດ້ຕະຫຼອດເວລາ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Link Tracker</strong>: Measure performance of your campaigns."
msgstr "<strong>ຕົວຕິດຕາມລິ້ງ</strong>: ວັດແທກປະສິດທິພາບຂອງແຄມເປນຂອງທ່ານ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Planning</strong>: Coordinate volunteers, bar staff, and sound "
"engineers."
msgstr "<strong>ການວາງແຜນ</strong>: ປະສານງານກັບອາສາສະໝັກ, ພະນັກງານບາ ແລະ ຊ່າງສຽງ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Point of Sale</strong>: Sell tickets and refreshments on-site with "
"real-time sync."
msgstr ""
"<strong>ຈຸດຂາຍໜ້າຮ້ານ (POS)</strong>: ຂາຍປີ້ ແລະ ເຄື່ອງດື່ມຢູ່ໜ້າງານ ພ້ອມເຊື່ອມຕໍ່ຂໍ້ມູນແບບສົດໆ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Project and Task Templates: </strong>Recurring tasks &amp; Projects "
"can be managed easily through the templates feature."
msgstr ""
"<strong>ແບບແຜນໂຄງການ ແລະ ວຽກ: </strong>ວຽກທີ່ເກີດຂຶ້ນຊ້ຳໆ ແລະ ໂຄງການ "
"ສາມາດຈັດການໄດ້ງ່າຍດາຍຜ່ານຄຸນສົມບັດແບບແຜນ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Projects</strong>: Coordinate all behind-the-scenes tasks for smooth "
"show execution."
msgstr ""
"<strong>ໂຄງການ</strong>: ປະສານທຸກໜ້າວຽກເບື້ອງຫຼັງ ເພື່ອໃຫ້ການສະແດງດຳເນີນໄປຢ່າງລາບລື່ນ."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Projects</strong>: Plan and assign tasks for transportation, "
