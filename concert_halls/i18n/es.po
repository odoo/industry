#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Accounting</strong>: Keep track of income from sales, donations, and "
"sponsors."
msgstr ""
"<strong>Contabilidad</strong>: lleva un registro de los ingresos "
"provenientes de ventas, donaciones y patrocinadores."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Apps &amp; What They Do:</strong>"
msgstr "<strong>Aplicaciones y sus funciones:</strong>"

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Attendance</strong>: Monitor registrations and scan tickets at the "
"entrance."
msgstr ""
"<strong>Asistencia</strong>: controla las inscripciones y escanea las "
"entradas en la entrada."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>CRM</strong>: Track leads and partnerships with sponsors, agencies, "
"and groups."
msgstr ""
"<strong>CRM</strong>: realiza el seguimiento de los leads y las "
"colaboraciones con patrocinadores, agencias y grupos."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Dashboards</strong>: Visualize performance with real-time KPIs."
msgstr ""
"<strong>Tableros</strong>: visualiza el rendimiento con los KPI en tiempo "
"real."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Email Marketing</strong>: Send newsletters and pre-sales to loyal "
"fans."
msgstr ""
"<strong>Marketing por correo electrónico</strong>: envía boletines "
"informativos y ofertas de venta anticipada a tus fans más leales."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Events</strong>: Create event details, schedule, tickets, pricing, "
"and reminders."
msgstr ""
"<strong>Eventos</strong>: crea eventos y configura el programa, las "
"entradas, los precios y los recordatorios."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Events</strong>: Plan, publish, and manage concerts with "
"registrations and attendance tracking."
msgstr ""
"<strong>Eventos</strong>: planifica, publica y gestiona conciertos con "
"registros y seguimiento de asistencia."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.view_page_home
msgid ""
"<strong>FEEL THE <span class=\"text-o-color-1\">BEAT</span>.<br/><span "
"class=\"text-o-color-1\">LIVE</span> THE MOMENT.</strong>"
msgstr ""
"<strong>SIENTE EL <span class=\"text-o-color-1\">RITMO</span>.<br/><span "
"class=\"text-o-color-1\">VIVE</span> EL MOMENTO.</strong>"

