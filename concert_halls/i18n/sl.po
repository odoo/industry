#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid ""
"<strong>Accounting</strong>: Keep track of income from sales, donations, and "
"sponsors."
msgstr ""
"<strong>Računovodstvo</strong>: Spremljajte prihodke iz prodaje, donacij in "
"sponzorjev."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid "<strong>Apps &amp; What They Do:</strong>"
msgstr "<strong>Aplikacije in kaj počnejo:</strong>"

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid ""
"<strong>Attendance</strong>: Monitor registrations and scan tickets at the "
"entrance."
msgstr ""
"<strong>Prisotnost</strong>: Nadzirajte registracije in skenirajte vstopnice "
"na vhodu."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid ""
"<strong>CRM</strong>: Track leads and partnerships with sponsors, agencies, "
"and groups."
msgstr ""
"<strong>CRM</strong>: Sledite potencialnim priložnostim in partnerstvom s "
"sponzorji, agencijami in skupinami."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid "<strong>Dashboards</strong>: Visualize performance with real-time KPIs."
msgstr ""
"<strong>Nadzorne  plošče</strong>: Vizualizirajte uspešnost s kazalniki KPI "
"v realnem času."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid ""
"<strong>Email Marketing</strong>: Send newsletters and pre-sales to loyal "
"fans."
msgstr ""
"<strong>E-poštni marketing</strong>: Pošljite novice in predprodajne ponudbe "
"zvestim oboževalcem."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid ""
"<strong>Events</strong>: Create event details, schedule, tickets, pricing, "
"and reminders."
msgstr ""
"<strong>Dogodki</strong>: Ustvarite podrobnosti dogodka, urnik, vstopnice, "
"cene in opomnike."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid ""
"<strong>Events</strong>: Plan, publish, and manage concerts with "
"registrations and attendance tracking."
msgstr ""
"<strong>Dogodki</strong>: Načrtujte, objavite in upravljajte koncerte z "
"registracijami in sledenjem prisotnosti."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid ""
"<strong>Get an instant overview </strong>: need to understand what needs to "
"be done? The Project Stages and Status icons give you an instant overview of "
"where things are at, and what needs to be prioritized."
msgstr ""
"<strong>Pridobite takojšen pregled </strong>: morate razumeti, kaj je treba "
"narediti? Ikone projektnih stopenj in stanja vam dajejo takojšen pregled, "
"kje so stvari in kaj je treba prednostno obravnavati."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid "<strong>Inventory</strong>: Stay on top of merch and bar stock levels."
msgstr ""
"<strong>Zaloga</strong>: Bodite ves čas na tekočem z ravnmi zalog blaga in "
"bara."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid "<strong>Link Tracker</strong>: Measure performance of your campaigns."
msgstr "<strong>Sledilec povezav</strong>: Merite učinkovitost svojih kampanj."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
#, fuzzy
msgid ""
"<strong>Planning</strong>: Coordinate volunteers, bar staff, and sound "
