#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong><span class=\"h2-fs\"/></strong><span class=\"h5-fs\">Create your "
"events in advance and use early-bird tickets to generate interest.</span>"
msgstr ""
"<strong><span class=\"h2-fs\"/></strong><span class=\"h5-fs\">Buat acara "
"Anda terlebih dahulu dan manfaatkan tiket early-bird untuk menarik minat.</"
"span>"

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Accounting</strong>: Keep track of income from sales, donations, and "
"sponsors."
msgstr ""
"<strong>Akuntansi</strong>: Catat pendapatan dari penjualan, donasi, dan "
"sponsor."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Apps &amp; What They Do:</strong>"
msgstr "<strong>Aplikasi &amp; Kegunaannya:</strong>"

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Attendance</strong>: Monitor registrations and scan tickets at the "
"entrance."
msgstr ""
"<strong>Kehadiran</strong>: Memantau pendaftaran dan memindai tiket di pintu "
"masuk."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>CRM</strong>: Track leads and partnerships with sponsors, agencies, "
"and groups."
msgstr ""
"<strong>CRM</strong>: Lacak lead dan partnership dengan sponsor, agensi, dan "
"grup."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Dashboards</strong>: Visualize performance with real-time KPIs."
msgstr ""
"<strong>Dashboard</strong>: Visualisasikan performa dengan KPI real-time."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Email Marketing</strong>: Send newsletters and pre-sales to loyal "
"fans."
msgstr ""
"<strong>Email Marketing</strong>: Kirim buletin dan penawaran prapenjualan "
"ke penggemar setia."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Events</strong>: Create event details, schedule, tickets, pricing, "
"and reminders."
msgstr ""
"<strong>Acara</strong>: Buat detail acara, jadwal, tiket, harga, dan "
"pengingat."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Events</strong>: Plan, publish, and manage concerts with "
"registrations and attendance tracking."
msgstr ""
"<strong>Acara</strong>: Rencanakan, publikasikan, dan kelola konser dengan "
"pendaftaran dan pencatatan kehadiran."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Get an instant overview </strong>: need to understand what needs to "
"be done? The Project Stages and Status icons give you an instant overview of "
"where things are at, and what needs to be prioritized."
msgstr ""
"<strong>Dapatkan gambaran umum seketika</strong>: perlu memahami apa yang "
"harus dilakukan? Ikon Tahapan dan Status Project memberikan gambaran umum "
"seketika mengenai perkembangan saat ini, serta apa saja yang perlu "
"diprioritaskan."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Inventory</strong>: Stay on top of merch and bar stock levels."
msgstr "<strong>Inventaris</strong>: Pantau terus tingkat stok merch dan bar."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid "<strong>Link Tracker</strong>: Measure performance of your campaigns."
msgstr "<strong>Pelacak Link</strong>: Ukur performa kampanye Anda."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Planning</strong>: Coordinate volunteers, bar staff, and sound "
"engineers."
msgstr ""
"<strong>Perencanaan</strong>: Koordinasikan relawan, staf bar, dan teknisi "
"sound."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Point of Sale</strong>: Sell tickets and refreshments on-site with "
"real-time sync."
msgstr ""
"<strong>POS</strong>: Jual tiket dan makanan ringan di lokasi dengan "
"sinkronisasi real-time."

#. module: concert_halls
#: model_terms:ir.ui.view,arch_db:concert_halls.welcome_article_body
msgid ""
"<strong>Project and Task Templates: </strong>Recurring tasks &amp; Projects "
"can be managed easily through the templates feature."
msgstr ""
"<strong>Template Project dan Tugas: </strong>Tugas &amp; Project berulang "
"dapat dikelola dengan mudah melalui fitur template."

#. module: concert_halls
