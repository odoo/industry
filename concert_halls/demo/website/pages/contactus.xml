<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">concert_halls.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="concert_halls.page_contactus">
                <t t-call="website.layout">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email,'name': request.params.get('name', ''),'phone': request.params.get('phone', ''),'email_from': request.params.get('email_from', ''),'company': request.params.get('company', ''),'subject': request.params.get('subject', ''),}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_opening_hours pt256 o_colored_level parallax" data-scroll-background-ratio="0.2" data-snippet="s_opening_hours" data-name="Opening Hours" data-parallax-type="zoomIn">
                            <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-resize-width="1920" data-mimetype="image/jpeg" data-quality="95" style="background-image: url(&quot;/web/image/concert_halls.img_custom_image_16&quot;);"/>
                            <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgb(0, 0, 0) 0%, rgba(53, 88, 130, 0.52) 100%);"/>
                            <div class="container-fluid">
                                <div class="row o_grid_mode" data-row-count="14">
                                    <div class="o_grid_item o_cc o_cc1 g-col-lg-6 o_colored_level col-lg-6 g-height-14" style="grid-area: 1 / 2 / 15 / 8; z-index: 3; --grid-item-padding-y: 32px; --grid-item-padding-x: 40px;">
                                        <h2 class="display-4-fs">Let’s get <span class="text-o-color-1">in touch</span></h2>
                                        <a class="o_translate_inline" href="mailto:info@sonoraconcerthall.com">info@sonoraconcerthall.com</a>
                                        <br/>
                                        <br/>
                                        <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container-fluid">
                                                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="mail.mail" data-success-mode="message">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                                                                    <span class="s_website_form_label_content"/>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input type="hidden" class="form-control s_website_form_input" name="email_to" value="info@sonoraconcerthall.com"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="char" data-translated-name="Your Name">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="o7vy3f4vcyia">
                                                                    <span class="s_website_form_label_content">Your Name</span>
                                                                    <span class="s_website_form_mark"> *</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input class="form-control s_website_form_input" type="text" name="name" required="" placeholder="" id="o7vy3f4vcyia" data-fill-with="name"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="tel" data-translated-name="Phone Number">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="ofkzraz8wbs">
                                                                    <span class="s_website_form_label_content">Phone Number</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input class="form-control s_website_form_input" type="tel" name="phone" value="" placeholder="" id="ofkzraz8wbs" data-fill-with="phone"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="email" data-translated-name="Your Email">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="odpeqgqfsz1g">
                                                                    <span class="s_website_form_label_content">Your Email</span>
                                                                    <span class="s_website_form_mark"> *</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input class="form-control s_website_form_input" type="email" name="email_from" required="" value="" placeholder="" id="odpeqgqfsz1g" data-fill-with="email"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="char" data-translated-name="Your Company">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="o8y6gy0wf4g">
                                                                    <span class="s_website_form_label_content">Your Company</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input class="form-control s_website_form_input" type="text" name="company" value="" placeholder="" id="o8y6gy0wf4g" data-fill-with="commercial_company_name"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="o71jx711tzsm">
                                                                    <span class="s_website_form_label_content">Subject</span>
                                                                    <span class="s_website_form_mark"> *</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input class="form-control s_website_form_input" type="text" name="subject" required="" value="" placeholder="" id="o71jx711tzsm" data-fill-with="undefined"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="text" data-translated-name="Your Question">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="ozagq2595zdo">
                                                                    <span class="s_website_form_label_content">Your Question</span>
                                                                    <span class="s_website_form_mark"> *</span>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="ozagq2595zdo" rows="3"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-end s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"/>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send o_translate_inline">Submit</a>
                                                        </div>
                                                    </div>
                                                </form>
                                                <div class="s_website_form_end_message d-none">
                                                    <div class="oe_structure">
                                                        <section class="s_text_block o_colored_level rounded px-5 text-center" data-snippet="s_text_block">
                                                            <i class="fa fa-paper-plane fa-2x mb-3 rounded-circle text-bg-success" role="img" aria-hidden="true" title="Success"/>
                                                            <h1 class="fw-bolder">Thank you for getting in touch!</h1>
                                                            <p class="lead mb-0">Our team will come back to you as soon as possible.</p>
                                                            <p class="lead">In the meantime, have a look at our <a class="o_translate_inline" href="/event">upcoming shows</a>.</p>
                                                        </section>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="o_grid_item o_cc o_cc1 g-col-lg-2 col-6 o_colored_level g-height-14 col-lg-2" style="grid-area: 1 / 8 / 15 / 10; z-index: 4; --grid-item-padding-y: 32px; --grid-item-padding-x: 40px;">
                                        <p class="o_small"><u>Monday</u><br/>8.00am-6.00pm</p>
                                        <p class="o_small"><u>Tuesday</u><br/>8.00am-6.00pm</p>
                                        <p class="o_small"><u>Wednesday</u><br/>8.00am-12.00pm</p>
                                        <p class="o_small"><u>Thursday</u><br/>8.00am-6.00pm</p>
                                    </div>
                                    <div class="o_grid_item o_cc o_cc1 g-col-lg-2 col-6 o_colored_level g-height-14 col-lg-2" style="grid-area: 1 / 10 / 15 / 12; z-index: 5; --grid-item-padding-y: 32px; --grid-item-padding-x: 40px;">
                                        <p class="o_small"><u>Friday</u><br/>8.00am-6.00pm</p>
                                        <p class="o_small"><u>Saturday</u><br/>8.00am-6.00pm</p>
                                        <p class="o_small"><u>Sunday</u><br/>Closed</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
