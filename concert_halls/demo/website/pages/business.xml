<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_business" model="ir.ui.view">
        <field name="name">Business</field>
        <field name="key">concert_halls.page_business</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="concert_halls.page_business">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_cover o_cc o_colored_level s_parallax_no_overflow_hidden oe_img_bg o_bg_img_center o_bg_img_origin_border_box pt136 pb72 o_cc1" data-scroll-background-ratio="0" data-snippet="s_cover" data-name="Cover" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp" style="background-image: url(&quot;/web/image/concert_halls.img_custom_image_06&quot;);">
                            <div class="o_we_bg_filter" style="background-image: linear-gradient(0deg, rgb(0, 0, 0) 0%, rgba(0, 0, 0, 0.52) 36%, rgba(0, 0, 0, 0.48) 63%, rgb(0, 0, 0) 100%);"/>
                            <div class="s_allow_columns container">
                                <h1 class="display-3" style="text-align: center;">FOR <span class="text-o-color-1">BUSINESSES</span></h1>
                                <div class="o_text_columns o-contenteditable-false">
                                    <div class="row">
                                        <div class="o-contenteditable-true o_colored_level col-lg-8 offset-lg-2 col-12">
                                            <p class="lead" style="text-align: left;">
                                                <span class="text-white">Looking to host an unforgettable event in the heart of Helsinki? <strong>At Sonora</strong>, we open our iconic venue to businesses, organizations, and professionals seeking a unique setting for conferences, product launches, staff parties, or client receptions. With top-tier facilities, experienced staff, and a vibrant cultural backdrop, we turn your ideas into memorable experiences.</span>
                                                <br/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <p style="text-align: center;">&amp;nbsp;<br/></p>
                            </div>
                        </section>
                        <section class="s_website_form pt16 pb16 o_colored_level" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                            <div class="o_container_small">
                                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="crm.lead" data-success-mode="message">
                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name">
                                            <label class="s_website_form_label" style="width: 200px" for="oktvfs35qhpr">
                                                <span class="s_website_form_label_content">Your Name</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="text" name="contact_name" required="" placeholder="" id="oktvfs35qhpr" data-fill-with="name"/>
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="tel" data-translated-name="Phone Number">
                                            <label class="s_website_form_label" style="width: 200px" for="oi3eg7ggqvik">
                                                <span class="s_website_form_label_content">Phone Number</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="tel" name="phone" value="" placeholder="" id="oi3eg7ggqvik" data-fill-with="phone"/>
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="email" data-translated-name="Your Email">
                                            <label class="s_website_form_label" style="width: 200px" for="okti1x8uvaca">
                                                <span class="s_website_form_label_content">Your Email</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" value="" placeholder="" id="okti1x8uvaca" data-fill-with="email"/>
                                        </div>

                                        <div data-name="Field"
                                            class="s_website_form_field mb-3 col-12 s_website_form_required"
                                            data-type="many2one" data-translated-name="Interested in">
                                            <label class="s_website_form_label" for="o3y641ou74uy"
                                                style="width: 200px;">
                                                <span class="s_website_form_label_content">Interested in</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <select class="form-select s_website_form_input"
                                                name="tag_ids" required="" id="o3y641ou74uy">
                                                <option id="o3y641ou74uy0" value="*become_a_partner_tag*">Become a
                                                    Partner</option>
                                                <option id="o3y641ou74uy1" value="*venue_booking_tag*">Venue Booking</option>
                                                <option id="o3y641ou74uy2" value="*recording_and_streaming_tag*">Recording
                                                    &amp;amp; Streaming</option>
                                                <option id="o3y641ou74uy3" value="*other_tag*">Other</option>
                                                <option id="o3y641ou74uy4" value="*want_to_talk_tag*">Want to Talk</option>
                                            </select>
                                        </div>

                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Company">
                                            <label class="s_website_form_label" style="width: 200px" for="o8ptq3aadff5">
                                                <span class="s_website_form_label_content">Your Company</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="text" name="partner_name" required="" value="" placeholder="" id="o8ptq3aadff5" data-fill-with="commercial_company_name"/>
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject">
                                            <label class="s_website_form_label" style="width: 200px" for="odu0kgitj5nn">
                                                <span class="s_website_form_label_content">Subject</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="odu0kgitj5nn" data-fill-with="undefined"/>
                                        </div>
                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="Your Question">
                                            <label class="s_website_form_label" style="width: 200px" for="otpmz1hb962">
                                                <span class="s_website_form_label_content">Your Question</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="otpmz1hb962" rows="3"/>
                                        </div>
                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-end s_website_form_no_submit_label col-lg-12" data-name="Submit Button">
                                            <div style="width: 200px;" class="s_website_form_label"/>
                                            <span id="s_website_form_result"/>
                                            <a href="#" role="button" class="btn btn-primary s_website_form_send o_translate_inline">Submit</a>
                                        </div>
                                    </div>
                                </form>
                                <div class="s_website_form_end_message d-none">
                                    <div class="oe_structure">
                                        <section class="s_text_block o_colored_level rounded px-5 text-center" data-snippet="s_text_block">
                                            <i class="fa fa-paper-plane fa-2x mb-3 rounded-circle text-bg-success" role="img" aria-hidden="true" title="Success"/>
                                            <h1 class="fw-bolder">Thank you for your request!</h1>
                                            <p class="lead mb-0">Our events team will get back to you shortly to discuss your project and build a tailored proposal.</p>
                                            <p class="lead">In the meantime, discover the <a class="o_translate_inline" href="/event">shows on our stage</a>.</p>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env.ref('concert_halls.view_page_business').id"/>
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('concert_halls.view_page_business').arch.replace(
            '*become_a_partner_tag*', str(obj().env.ref('concert_halls.crm_tag_1').id)).replace(
            '*venue_booking_tag*', str(obj().env.ref('concert_halls.crm_tag_2').id)).replace(
            '*recording_and_streaming_tag*', str(obj().env.ref('concert_halls.crm_tag_3').id)).replace(
            '*other_tag*', str(obj().env.ref('concert_halls.crm_tag_4').id)).replace(
            '*want_to_talk_tag*', str(obj().env.ref('concert_halls.crm_tag_5').id))
        }"/>
    </function>
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value eval="'crm.lead'"/>
        <value eval="['tag_ids']"/>
    </function>
    <data noupdate="1">
        <record id="page_business" model="website.page">
            <field name="view_id" ref="view_page_business"/>
            <field name="url">/business</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
            <field name="header_overlay" eval="True"/>
        </record>
    </data>
</odoo>
