<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="appointment_question_first_visit" model="appointment.question" forcecreate="0">
        <field name="name">Is this your first visit to the practice?</field>
        <field name="sequence">10</field>
        <field name="appointment_type_ids" eval="[(6, 0, [
            ref('appointment_new_patient'),
            ref('appointment_hygiene'),
            ref('appointment_urgent'),
            ref('appointment_treatment'),
        ])]"/>
    </record>
    <record id="appointment_answer_first_visit_yes" model="appointment.answer" forcecreate="0">
        <field name="name">Yes</field>
        <field name="sequence">10</field>
        <field name="question_id" ref="appointment_question_first_visit"/>
    </record>
    <record id="appointment_answer_first_visit_no" model="appointment.answer" forcecreate="0">
        <field name="name">No</field>
        <field name="sequence">20</field>
        <field name="question_id" ref="appointment_question_first_visit"/>
    </record>
    <record id="appointment_question_first_visit" model="appointment.question" forcecreate="0">
        <field name="question_type">radio</field>
    </record>
    <record id="appointment_question_booking_note" model="appointment.question" forcecreate="0">
        <field name="name">Is there anything reception should know about your booking?</field>
        <field name="sequence">20</field>
        <field name="question_type">text</field>
        <field name="placeholder">For example, help with arranging your appointment.</field>
        <field name="extra_comment" type="html">
            <p>Use this space for appointment arrangements. Discuss clinical questions directly with the practice.</p>
        </field>
        <field name="appointment_type_ids" eval="[(6, 0, [
            ref('appointment_new_patient'),
            ref('appointment_hygiene'),
            ref('appointment_urgent'),
            ref('appointment_treatment'),
        ])]"/>
    </record>
</odoo>
