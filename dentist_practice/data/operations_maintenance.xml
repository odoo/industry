<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="maintenance_team_practice_equipment" model="maintenance.team" forcecreate="0">
        <field name="name">Practice Equipment</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="member_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
    <record id="maintenance_category_dental_chairs" model="maintenance.equipment.category" forcecreate="0">
        <field name="name">Dental Chairs</field>
        <field name="technician_user_id" ref="base.user_admin"/>
        <field name="note" type="html">
            <p>Keep each treatment unit's equipment details, responsible technician and service reports together. Arrange service according to the equipment supplier's instructions.</p>
        </field>
    </record>
    <record id="maintenance_category_compressed_air" model="maintenance.equipment.category" forcecreate="0">
        <field name="name">Dental Compressed Air</field>
        <field name="technician_user_id" ref="base.user_admin"/>
        <field name="note" type="html">
            <p>Keep supplier details, serial numbers, service reports and the approved maintenance schedule with each compressor or related air-system asset.</p>
        </field>
    </record>
    <record id="maintenance_category_sterilization" model="maintenance.equipment.category" forcecreate="0">
        <field name="name">Dental Sterilization Equipment</field>
        <field name="technician_user_id" ref="base.user_admin"/>
        <field name="note" type="html">
            <p>Track autoclaves and associated equipment, assign service work and retain the supplier reports. Set recurring work from the equipment's approved service schedule.</p>
        </field>
    </record>
</odoo>
