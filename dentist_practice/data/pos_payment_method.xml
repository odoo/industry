<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'allowed_company_ids': [ref('base.main_company')]}">
    <record id="pos_payment_method_card_reception" model="pos.payment.method" forcecreate="0">
        <field name="name">Card</field>
        <field name="type">bank</field>
        <field name="sequence">2</field>
        <field name="payment_method_type">none</field>
        <field name="journal_id" model="account.journal" eval="obj().search([('company_id', '=', obj().env.company.id), ('type', '=', 'bank'), ('currency_id', 'in', [False, obj().env.company.currency_id.id])], limit=1).id"/>
    </record>
</odoo>
