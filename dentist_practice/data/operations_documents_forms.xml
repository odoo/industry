<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True, 'mail_notrack': True}">
    <record id="document_administrative_contact_form" model="documents.document" forcecreate="0">
        <field name="name">Patient registration</field>
        <field name="attachment_id" ref="attachment_administrative_contact_form"/>
        <field name="folder_id" ref="documents_folder_administrative_templates"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="tag_ids" eval="[Command.link(ref('documents_tag_administration'))]"/>
        <field name="access_internal">none</field>
        <field name="access_via_link">none</field>
        <field name="is_access_via_link_hidden" eval="True"/>
    </record>
    <record id="document_financial_receipt_form" model="documents.document" forcecreate="0">
        <field name="name">Financial proposal acknowledgement</field>
        <field name="attachment_id" ref="attachment_financial_receipt_form"/>
        <field name="folder_id" ref="documents_folder_administrative_templates"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="tag_ids" eval="[Command.link(ref('documents_tag_financial_proposal'))]"/>
        <field name="access_internal">none</field>
        <field name="access_via_link">none</field>
        <field name="is_access_via_link_hidden" eval="True"/>
    </record>
</odoo>
