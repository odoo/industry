<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="department_clinical" model="hr.department" forcecreate="0">
        <field name="name">Clinical Team</field>
    </record>
    <record id="department_reception" model="hr.department" forcecreate="0">
        <field name="name">Reception</field>
    </record>
    <record id="department_operations" model="hr.department" forcecreate="0">
        <field name="name">Practice Operations</field>
    </record>
    <record id="job_dentist" model="hr.job" forcecreate="0">
        <field name="name">Dentist</field>
        <field name="department_id" ref="department_clinical"/>
        <field name="no_of_recruitment">0</field>
    </record>
    <record id="job_hygienist" model="hr.job" forcecreate="0">
        <field name="name">Dental Hygienist</field>
        <field name="department_id" ref="department_clinical"/>
        <field name="no_of_recruitment">0</field>
    </record>
    <record id="job_assistant" model="hr.job" forcecreate="0">
        <field name="name">Dental Assistant</field>
        <field name="department_id" ref="department_clinical"/>
        <field name="no_of_recruitment">0</field>
    </record>
    <record id="job_reception" model="hr.job" forcecreate="0">
        <field name="name">Reception Coordinator</field>
        <field name="department_id" ref="department_reception"/>
        <field name="no_of_recruitment">0</field>
    </record>
    <record id="job_operations" model="hr.job" forcecreate="0">
        <field name="name">Practice Operations Coordinator</field>
        <field name="department_id" ref="department_operations"/>
        <field name="no_of_recruitment">0</field>
    </record>
</odoo>
