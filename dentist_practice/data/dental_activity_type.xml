<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="activity_type_enquiry_callback" model="mail.activity.type" forcecreate="0">
        <field name="name">Patient enquiry callback</field>
        <field name="summary">Respond to the patient enquiry</field>
        <field name="category">phonecall</field>
        <field name="sequence">10</field>
        <field name="icon">call</field>
        <field name="res_model" eval="False"/>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">current_date</field>
        <field name="default_note" type="html">
            <p>Confirm contact details, visit purpose and availability. Agree a next action and record the outcome. Create a real appointment only after agreeing a slot.</p>
        </field>
    </record>
    <record id="activity_type_visit_preparation" model="mail.activity.type" forcecreate="0">
        <field name="name">Patient visit preparation</field>
        <field name="summary">Prepare the reception handoff</field>
        <field name="category">default</field>
        <field name="sequence">20</field>
        <field name="icon">checklist</field>
        <field name="res_model" eval="False"/>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">current_date</field>
        <field name="default_note" type="html">
            <p>Review the agreed booking, contact details, registration and arrival arrangements. Keep clinical questions with the practitioner.</p>
        </field>
    </record>
    <record id="activity_type_estimate_discussion" model="mail.activity.type" forcecreate="0">
        <field name="name">Treatment estimate discussion</field>
        <field name="summary">Discuss the financial proposal</field>
        <field name="category">phonecall</field>
        <field name="sequence">30</field>
        <field name="icon">description</field>
        <field name="res_model" eval="False"/>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">current_date</field>
        <field name="default_note" type="html">
            <p>Review the linked quotation, agreed fees and patient questions. Record the administrative decision and next contact. Refer questions about treatment choices to the practitioner.</p>
        </field>
    </record>
    <record id="activity_type_post_visit_checkin" model="mail.activity.type" forcecreate="0">
        <field name="name">Patient post-visit check-in</field>
        <field name="summary">Check in after the visit</field>
        <field name="category">phonecall</field>
        <field name="sequence">40</field>
        <field name="icon">call</field>
        <field name="res_model" eval="False"/>
        <field name="delay_count">1</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">current_date</field>
        <field name="default_note" type="html">
            <p>Contact the patient at the time agreed with the practitioner. Follow the practice's approved instructions, record the administrative outcome and route clinical concerns to the responsible practitioner.</p>
        </field>
    </record>
    <record id="activity_type_next_visit" model="mail.activity.type" forcecreate="0">
        <field name="name">Arrange the next visit</field>
        <field name="summary">Agree the next appointment</field>
        <field name="category">phonecall</field>
        <field name="sequence">50</field>
        <field name="icon">calendar_today</field>
        <field name="res_model" eval="False"/>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">current_date</field>
        <field name="default_note" type="html">
            <p>Review the practitioner-agreed next step, offer an available time and create the linked appointment after agreement. An activity alone does not reserve a slot.</p>
        </field>
    </record>
    <record id="activity_type_reception_checkout" model="mail.activity.type" forcecreate="0">
        <field name="name">Reception payment handoff</field>
        <field name="summary">Review the charge and reception collection</field>
        <field name="category">default</field>
        <field name="sequence">60</field>
        <field name="icon">payments</field>
        <field name="res_model" eval="False"/>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">current_date</field>
        <field name="default_note" type="html">
            <p>Review the existing Sales order or invoice and payment balance. Use Quotation / Order for an uninvoiced order or Settle invoices for a confirmed invoice. Record each collection once.</p>
        </field>
    </record>
    <record id="activity_type_enquiry_callback" model="mail.activity.type" forcecreate="0">
        <field name="suggested_next_type_id" ref="activity_type_visit_preparation"/>
    </record>
    <record id="activity_type_visit_preparation" model="mail.activity.type" forcecreate="0">
        <field name="suggested_next_type_id" ref="activity_type_reception_checkout"/>
    </record>
    <record id="activity_type_estimate_discussion" model="mail.activity.type" forcecreate="0">
        <field name="suggested_next_type_id" ref="activity_type_next_visit"/>
    </record>
    <record id="activity_type_post_visit_checkin" model="mail.activity.type" forcecreate="0">
        <field name="suggested_next_type_id" ref="activity_type_next_visit"/>
    </record>
    <record id="activity_type_reception_checkout" model="mail.activity.type" forcecreate="0">
        <field name="suggested_next_type_id" ref="activity_type_post_visit_checkin"/>
    </record>
</odoo>
