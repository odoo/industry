<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="stock_location_dental_supplies" model="stock.location" forcecreate="0">
        <field name="name">Dental Supplies</field>
        <field name="usage">internal</field>
        <field name="location_id" model="stock.warehouse" eval="obj().search([('company_id', '=', obj().env.company.id)], limit=1).lot_stock_id.id"/>
        <field name="cyclic_inventory_frequency">7</field>
    </record>
    <record id="putaway_dental_supplies" model="stock.putaway.rule" forcecreate="0">
        <field name="category_id" ref="product_category_dental_supplies"/>
        <field name="location_in_id" model="stock.location" eval="obj(ref('stock_location_dental_supplies')).location_id.id"/>
        <field name="location_out_id" ref="stock_location_dental_supplies"/>
    </record>
</odoo>
