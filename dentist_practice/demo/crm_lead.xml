<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True, 'mail_activity_quick_update': True}">
    <record id="crm_sophie_first_visit_demo" model="crm.lead">
        <field name="name">Sophie Taylor - referred new patient</field>
        <field name="type">opportunity</field>
        <field name="partner_id" ref="partner_sophie_taylor_demo"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="team_id" ref="crm_team_patient_journey"/>
        <field name="tag_ids" eval="[Command.link(ref('crm_tag_first_examination'))]"/>
        <field name="lead_properties" eval="{'dental_contact_preference': 'email'}"/>
        <field name="stage_id" ref="crm_stage_first_visit_booked"/>
        <field name="medium_id" ref="utm.utm_medium_phone"/>
        <field name="source_id" ref="utm.utm_source_referral"/>
        <field name="referred">Grace Wilson</field>
        <field name="expected_revenue">95.0</field>
        <field name="date_deadline" eval="(DateTime.today() + relativedelta(days=7)).date()"/>
        <field name="description" type="html">
            <p>Reception took the telephone enquiry, registered Sophie, and agreed a first examination slot. The diary contains the real booking. Review the draft financial proposal before the visit.</p>
        </field>
    </record>
    <record id="crm_james_web_enquiry_demo" model="crm.lead">
        <field name="name">James Walker - website enquiry to call back</field>
        <field name="type">opportunity</field>
        <field name="partner_id" ref="partner_james_walker_demo"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="team_id" ref="crm_team_patient_journey"/>
        <field name="tag_ids" eval="[Command.link(ref('crm_tag_first_examination'))]"/>
        <field name="lead_properties" eval="{'dental_short_notice': 'yes'}"/>
        <field name="stage_id" ref="crm_stage_enquiry_new"/>
        <field name="medium_id" ref="utm.utm_medium_website"/>
        <field name="source_id" ref="utm_source_google_business_demo"/>
        <field name="campaign_id" ref="utm_campaign_new_patient_demo"/>
        <field name="priority">2</field>
        <field name="expected_revenue">95.0</field>
        <field name="date_deadline" eval="(DateTime.today() + relativedelta(days=2)).date()"/>
        <field name="description" type="html">
            <p>Website enquiry after finding the practice on Google. James asks about becoming a new patient and available times. No slot has been agreed yet: call him, then create the appointment and apply the Patients tag.</p>
            <p>The source and campaign illustrate attribution; this record was seeded for the demo.</p>
        </field>
    </record>
    <record id="crm_aisha_estimate_demo" model="crm.lead">
        <field name="name">Aisha Khan - estimate follow-up</field>
        <field name="type">opportunity</field>
        <field name="partner_id" ref="partner_aisha_khan_demo"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="team_id" ref="crm_team_patient_journey"/>
        <field name="tag_ids" eval="[Command.link(ref('crm_tag_treatment_discussion'))]"/>
        <field name="lead_properties" eval="{'dental_contact_preference': 'email'}"/>
        <field name="stage_id" ref="crm_stage_treatment_followup"/>
        <field name="medium_id" ref="utm.utm_medium_email"/>
        <field name="source_id" ref="utm.utm_source_google"/>
        <field name="expected_revenue">185.0</field>
        <field name="date_deadline" eval="(DateTime.today() + relativedelta(days=5)).date()"/>
        <field name="description" type="html">
            <p>Aisha attended an examination and requested the examination and hygiene cost proposal by email. The example quotation is marked Sent without sending an email. Reception has a call to answer administrative questions and agree the next appointment.</p>
        </field>
    </record>
    <record id="crm_daniel_accepted_demo" model="crm.lead">
        <field name="name">Daniel Morgan - accepted estimate and deposit</field>
        <field name="type">opportunity</field>
        <field name="partner_id" ref="partner_daniel_morgan_demo"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="team_id" ref="crm_team_patient_journey"/>
        <field name="tag_ids" eval="[Command.link(ref('crm_tag_treatment_discussion'))]"/>
        <field name="stage_id" ref="crm_stage_treatment_accepted"/>
        <field name="medium_id" ref="utm.utm_medium_phone"/>
        <field name="source_id" ref="utm.utm_source_referral"/>
        <field name="expected_revenue">445.0</field>
        <field name="description" type="html">
            <p>The financial proposal has been accepted and the sales order is confirmed. Reception agreed the next treatment session before Daniel left. Discuss the agreed deposit, then use the existing order's down-payment flow at reception. No invoice or payment has been created for this order.</p>
        </field>
    </record>
    <record id="crm_oliver_consultation_demo" model="crm.lead">
        <field name="name">Oliver Hughes - reception consultation booking</field>
        <field name="type">opportunity</field>
        <field name="partner_id" ref="partner_oliver_hughes_demo"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="team_id" ref="crm_team_patient_journey"/>
        <field name="tag_ids" eval="[Command.link(ref('crm_tag_urgent_consultation'))]"/>
        <field name="stage_id" ref="crm_stage_first_visit_booked"/>
        <field name="medium_id" ref="utm.utm_medium_direct"/>
        <field name="expected_revenue">125.0</field>
        <field name="date_deadline" eval="(DateTime.today() + relativedelta(days=7)).date()"/>
        <field name="description" type="html">
            <p>Personal enquiry at reception. Staff agreed the consultation type and available time directly, then entered a booking in the shared diary. A draft cost estimate is available for reception to review.</p>
        </field>
    </record>
</odoo>
