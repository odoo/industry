<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'inventory_mode': True}">
    <record id="quant_supply_gloves_demo" model="stock.quant">
        <field name="product_id" ref="product_supply_gloves"/>
        <field name="location_id" ref="stock_location_dental_supplies"/>
        <field name="inventory_quantity">120</field>
    </record>
    <record id="quant_supply_masks_demo" model="stock.quant">
        <field name="product_id" ref="product_supply_masks"/>
        <field name="location_id" ref="stock_location_dental_supplies"/>
        <field name="inventory_quantity">150</field>
    </record>
    <record id="quant_supply_bibs_demo" model="stock.quant">
        <field name="product_id" ref="product_supply_bibs"/>
        <field name="location_id" ref="stock_location_dental_supplies"/>
        <field name="inventory_quantity">300</field>
    </record>
    <record id="quant_supply_cups_demo" model="stock.quant">
        <field name="product_id" ref="product_supply_cups"/>
        <field name="location_id" ref="stock_location_dental_supplies"/>
        <field name="inventory_quantity">500</field>
    </record>
    <record id="quant_supply_suction_tips_demo" model="stock.quant">
        <field name="product_id" ref="product_supply_suction_tips"/>
        <field name="location_id" ref="stock_location_dental_supplies"/>
        <field name="inventory_quantity">60</field>
    </record>
    <record id="quant_supply_pouches_demo" model="stock.quant">
        <field name="product_id" ref="product_supply_sterilization_pouches"/>
        <field name="location_id" ref="stock_location_dental_supplies"/>
        <field name="inventory_quantity">40</field>
    </record>
    <record id="quant_composite_available_demo" model="stock.quant">
        <field name="product_id" ref="product_supply_composite_syringe"/>
