        <field name="lot_id" ref="lot_composite_available_demo"/>
        <field name="inventory_quantity">6</field>
    </record>
    <record id="quant_composite_expiry_review_demo" model="stock.quant">
        <field name="product_id" ref="product_supply_composite_syringe"/>
        <field name="location_id" ref="stock_location_dental_supplies"/>
        <field name="lot_id" ref="lot_composite_expiry_review_demo"/>
        <field name="inventory_quantity">2</field>
    </record>
    <function model="stock.quant" name="action_apply_inventory">
        <value eval="[ref('quant_supply_gloves_demo'), ref('quant_supply_masks_demo'), ref('quant_supply_bibs_demo'), ref('quant_supply_cups_demo'), ref('quant_supply_suction_tips_demo'), ref('quant_supply_pouches_demo'), ref('quant_composite_available_demo'), ref('quant_composite_expiry_review_demo')]"/>
    </function>
</odoo>
