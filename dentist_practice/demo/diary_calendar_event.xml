  <record id="event_freya_examination_diary" model="calendar.event">
    <field name="opportunity_id" ref="crm_freya_journey"/>
    <field name="res_model_id" ref="crm.model_crm_lead"/>
    <field name="res_id" ref="crm_freya_journey"/>
    <field name="name">Freya Brooks - New-patient examination</field>
    <field name="appointment_type_id" ref="appointment_new_patient"/>
    <field name="user_id" ref="user_dentist_maya_demo"/>
    <field name="calendar_id" model="res.users" eval="obj().env.ref('dentist_practice.user_dentist_maya_demo').primary_calendar_id.id"/>
    <field name="appointment_booker_id" ref="partner_freya_brooks_diary"/>
    <field name="partner_ids" eval="[Command.link(ref('partner_staff_dentist_maya_demo')), Command.link(ref('partner_freya_brooks_diary'))]"/>
    <field name="attendee_ids" eval="[Command.create({'partner_id': ref('partner_staff_dentist_maya_demo'), 'state': 'accepted'}), Command.create({'partner_id': ref('partner_freya_brooks_diary'), 'state': 'accepted'})]"/>
    <field name="booking_line_ids" eval="[Command.create({'capacity_reserved': 1})]"/>
    <field name="start" model="appointment.type" eval="((DateTime.now(pytz.timezone(obj().env.ref('dentist_practice.appointment_new_patient').appointment_tz)) + relativedelta(days=-1 - 2 * (DateTime.now(pytz.timezone(obj().env.ref('dentist_practice.appointment_new_patient').appointment_tz)).weekday() == 0) - (DateTime.now(pytz.timezone(obj().env.ref('dentist_practice.appointment_new_patient').appointment_tz)).weekday() == 6))).replace(hour=10, minute=0, second=0, microsecond=0)).astimezone(pytz.UTC).replace(tzinfo=None)"/>
    <field name="stop" model="appointment.type" eval="((DateTime.now(pytz.timezone(obj().env.ref('dentist_practice.appointment_new_patient').appointment_tz)) + relativedelta(days=-1 - 2 * (DateTime.now(pytz.timezone(obj().env.ref('dentist_practice.appointment_new_patient').appointment_tz)).weekday() == 0) - (DateTime.now(pytz.timezone(obj().env.ref('dentist_practice.appointment_new_patient').appointment_tz)).weekday() == 6))).replace(hour=10, minute=0, second=0, microsecond=0) + relativedelta(minutes=30)).astimezone(pytz.UTC).replace(tzinfo=None)"/>
    <field name="show_as">busy</field>
    <field name="privacy" eval="False"/>
    <field name="appointment_status">attended</field>
    <field name="alarm_ids" eval="[Command.set([ref('calendar.alarm_notif_1')])]"/>
    <field name="require_appointment_feedback_mail" eval="False"/>
    <field name="notes" type="html">
      <p>Examination attended. A hygiene visit is booked; reception has an unpaid examination invoice to collect.</p>
    </field>
  </record>
</odoo>
