<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_activity_quick_update': True}">
    <record id="activity_james_callback_demo" model="mail.activity">
        <field name="res_model_id" ref="crm.model_crm_lead"/>
        <field name="res_id" ref="crm_james_web_enquiry_demo"/>
        <field name="activity_type_id" ref="activity_type_enquiry_callback"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="date_deadline" model="res.users" eval="DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')).date()"/>
        <field name="summary">James - respond to website enquiry</field>
        <field name="note" type="html">
            <p>Call James to discuss first-visit availability, confirm his contact details, and agree a diary slot. Apply the Patients tag once registered. Record the outcome so the enquiry is not missed.</p>
        </field>
        <field name="role_id" ref="role_dental_reception"/>
    </record>
    <record id="activity_sophie_arrival_demo" model="mail.activity">
        <field name="res_model_id" ref="base.model_res_partner"/>
        <field name="res_id" ref="partner_sophie_taylor_demo"/>
        <field name="activity_type_id" ref="activity_type_visit_preparation"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="date_deadline" model="res.users" eval="DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')).date()"/>
        <field name="summary">Sophie - prepare first-visit reception handoff</field>
        <field name="note" type="html">
            <p>Review the agreed booking, contact details, and draft examination estimate. Explain arrival arrangements and arrange the next appointment before the patient leaves when appropriate.</p>
        </field>
        <field name="role_id" ref="role_dental_reception"/>
    </record>
    <record id="activity_aisha_estimate_call_demo" model="mail.activity">
        <field name="res_model_id" ref="crm.model_crm_lead"/>
        <field name="res_id" ref="crm_aisha_estimate_demo"/>
        <field name="activity_type_id" ref="activity_type_estimate_discussion"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="date_deadline" model="res.users" eval="(DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')) + relativedelta(days=1)).date()"/>
        <field name="summary">Aisha - follow up on estimate and next appointment</field>
        <field name="note" type="html">
            <p>Ask whether Aisha received the financial proposal and whether reception can help arrange the next visit. Record her decision and schedule another activity if needed. Refer clinical questions to the practitioner.</p>
        </field>
        <field name="role_id" ref="role_dental_reception"/>
    </record>
    <record id="activity_daniel_deposit_demo" model="mail.activity">
        <field name="res_model_id" ref="sale.model_sale_order"/>
        <field name="res_id" ref="sale_order_daniel_demo"/>
        <field name="activity_type_id" ref="activity_type_reception_checkout"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="date_deadline" model="res.users" eval="DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')).date()"/>
        <field name="summary">Daniel - discuss deposit and confirm next visit</field>
        <field name="note" type="html">
            <p>Review the accepted order and future diary booking. Discuss a 20% down payment with Daniel. In Reception POS, use Quotation / Order to select the existing order and Apply a down payment. If a down-payment invoice has already been created, confirm it and use Settle invoices instead. Record the payment once.</p>
        </field>
        <field name="role_id" ref="role_dental_reception"/>
    </record>
    <record id="activity_grace_invoice_handoff_demo" model="mail.activity">
        <field name="res_model_id" ref="sale.model_sale_order"/>
        <field name="res_id" ref="sale_order_grace_demo"/>
        <field name="activity_type_id" ref="activity_type_reception_checkout"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="date_deadline" model="res.users" eval="DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')).date()"/>
        <field name="summary">Grace - reception invoice and payment handoff</field>
        <field name="note" type="html">
            <p>Open the linked draft invoice, review the service, fee and applicable taxes, then confirm it. In Reception POS, select Grace and use Settle invoices to collect payment against that invoice. Ask about arranging the next visit before closing the handoff.</p>
        </field>
        <field name="role_id" ref="role_dental_reception"/>
    </record>
    <record id="activity_grace_checkin_demo" model="mail.activity">
        <field name="res_model_id" ref="base.model_res_partner"/>
        <field name="res_id" ref="partner_grace_wilson_demo"/>
        <field name="activity_type_id" ref="activity_type_post_visit_checkin"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="date_deadline" model="res.users" eval="DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')).date()"/>
        <field name="summary">Grace - post-visit check-in and next booking</field>
        <field name="note" type="html">
            <p>Follow up after the recent visit, ask about the reception experience, and offer help arranging the next appointment. Record the administrative outcome; direct clinical questions to the practitioner.</p>
        </field>
        <field name="role_id" ref="role_dental_reception"/>
    </record>
    <record id="activity_emma_recall_demo" model="mail.activity">
        <field name="res_model_id" ref="base.model_res_partner"/>
        <field name="res_id" ref="partner_emma_lewis_demo"/>
        <field name="activity_type_id" ref="activity_type_next_visit"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="date_deadline" model="res.users" eval="(DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')) - relativedelta(days=1)).date()"/>
        <field name="summary">Emma - overdue call to arrange next visit</field>
        <field name="note" type="html">
            <p>Emma requested a callback but no next appointment has been agreed. Call her, record the outcome, and create a booking only after a slot is agreed.</p>
        </field>
        <field name="role_id" ref="role_dental_reception"/>
    </record>
</odoo>
