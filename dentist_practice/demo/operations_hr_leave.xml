<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True, 'mail_activity_quick_update': True, 'no_mail_to_attendees': True, 'mail_notrack': True, 'leave_fast_create': True}">
    <record id="leave_maya_unavailable_demo" model="hr.leave">
        <field name="employee_id" ref="employee_dentist_maya_demo"/>
        <field name="work_entry_type_id" ref="work_entry_practice_absence"/>
        <field name="private_name">Practitioner unavailability</field>
        <field name="request_date_from" model="res.users" eval="(DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')) + relativedelta(days=1, weekday=2)).date()"/>
        <field name="request_date_to" model="res.users" eval="(DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')) + relativedelta(days=1, weekday=2)).date()"/>
    </record>
    <record id="leave_alex_pending_demo" model="hr.leave">
        <field name="employee_id" ref="employee_hygienist_alex_demo"/>
        <field name="work_entry_type_id" ref="work_entry_practice_absence"/>
        <field name="private_name">Leave request awaiting practice approval</field>
        <field name="request_date_from" model="res.users" eval="(DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')) + relativedelta(days=7, weekday=4)).date()"/>
        <field name="request_date_to" model="res.users" eval="(DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')) + relativedelta(days=7, weekday=4)).date()"/>
    </record>
    <function model="hr.leave" name="_action_validate">
        <value eval="[ref('leave_maya_unavailable_demo')]"/>
    </function>
</odoo>
