<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_willow_home_source" model="ir.ui.view">
        <field name="name">Willow Dental - Home</field>
        <field name="key">dentist_practice.willow_home_source</field>
        <field name="type">qweb</field>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <t name="Willow Dental" t-name="website.homepage">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_image o_cc o_cc2 pt64 pb64 o_colored_level" data-snippet="s_text_image" data-name="Willow introduction">
                            <div class="container">
                                <div class="row align-items-center g-4 g-lg-5">
                                    <div class="col-lg-6 pt24 pb24 o_colored_level">
                                        <p class="small text-uppercase fw-semibold text-primary mb-4">Welcome to Willow Dental</p>
                                        <h1 class="display-2 mb-4">Room to feel<br/>at ease.</h1>
                                        <p class="lead mb-4">Everyday dentistry. Clear conversations.<br/>A calmer first step.</p>
                                        <p class="mb-4">From your first enquiry to the next visit, we make space to listen, explain the options and plan your care together.</p>
                                        <p class="d-flex flex-wrap gap-3 mb-0">
                                            <a href="/dentist/new-patient" class="btn btn-primary btn-lg">Arrange your first visit</a>
                                            <a href="/our-care" class="btn btn-outline-primary btn-lg">Explore our care</a>
                                        </p>
                                    </div>
                                    <div class="col-lg-6 pt16 pb16 o_colored_level">
                                        <figure class="ratio ratio-1x1 rounded-5 overflow-hidden mb-0">
                                            <img src="/dentist_practice/static/src/img/website/willow-hero.webp" alt="A bright, thoughtfully arranged treatment room at Willow Dental" class="img img-fluid w-100 h-100 object-fit-cover o_we_custom_image" fetchpriority="high"/>
                                        </figure>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_title_split pt80 pb32 o_colored_level" data-snippet="s_title_split" data-name="Our care introduction">
                            <div class="container s_allow_columns">
                                <div class="row align-items-end">
                                    <div class="col-lg-6">
                                        <p class="small text-uppercase fw-semibold text-primary">Care, at your pace</p>
                                        <h2 class="display-5 mb-3">A clear way forward.</h2>
                                    </div>
                                    <div class="col-lg-5 offset-lg-1">
                                        <p class="lead">A routine visit, a new concern or a conversation about what comes next. There is a place to start.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block pt16 pb80 o_colored_level" data-snippet="s_text_block" data-name="Care overview">
                            <div class="container s_allow_columns">
                                <div class="row g-4 g-lg-5">
                                    <div class="col-lg-4 o_colored_level">
                                        <div class="border-top pt24">
                                            <p class="small text-primary mb-3">01 / EXAMINATIONS</p>
                                            <h3 class="h4-fs">Start with a conversation.</h3>
                                            <p>Discuss what has brought you in, review your oral health and agree a plan for the next step.</p>
                                            <a href="/our-care#examinations" class="text-primary">About examinations <span aria-hidden="true">&#8594;</span></a>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 o_colored_level">
                                        <div class="border-top pt24">
                                            <p class="small text-primary mb-3">02 / HYGIENE</p>
                                            <h3 class="h4-fs">Make room for everyday care.</h3>
                                            <p>Hygiene appointments focused on routine preventive care, with returning visits planned around your needs.</p>
                                            <a href="/our-care#hygiene" class="text-primary">About hygiene visits <span aria-hidden="true">&#8594;</span></a>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 o_colored_level">
                                        <div class="border-top pt24">
                                            <p class="small text-primary mb-3">03 / CONSULTATIONS</p>
                                            <h3 class="h4-fs">Understand your options.</h3>
                                            <p>Talk through a concern or proposed treatment, with time to discuss the options, fees and arrangements.</p>
                                            <a href="/our-care#consultations" class="text-primary">About consultations <span aria-hidden="true">&#8594;</span></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_image_text o_cc o_cc2 pt64 pb64 o_colored_level" data-snippet="s_image_text" data-name="Meet the practice">
                            <div class="container">
                                <div class="row align-items-center g-4 g-lg-5">
                                    <div class="col-lg-6 pt16 pb16 o_colored_level">
                                        <img src="/dentist_practice/static/src/img/website/willow-practice.webp" alt="A welcoming reception and waiting area" class="img img-fluid w-100 rounded-4 o_we_custom_image" loading="lazy"/>
                                    </div>
                                    <div class="col-lg-5 offset-lg-1 pt24 pb24 o_colored_level">
                                        <p class="small text-uppercase fw-semibold text-primary">The Willow approach</p>
                                        <h2 class="display-5 mb-4">A place for a clear conversation.</h2>
                                        <p>We believe a visit should begin with understanding what matters to you. That means listening first and explaining the next step in plain language.</p>
                                        <p>Reception helps with the practical details, from finding a time to discussing your estimate and arranging a return visit.</p>
                                        <a href="/our-practice" class="btn btn-outline-primary mt-3">Get to know the practice</a>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_process_steps pt80 pb80 o_colored_level" data-vcss="002" data-vxml="002" data-snippet="s_process_steps" data-name="Your first visit">
                            <div class="container">
                                <p class="small text-uppercase fw-semibold text-primary text-center">New to Willow?</p>
                                <h2 class="display-5 text-center mb-5">One step at a time.</h2>
                                <div class="row g-0">
                                    <div class="col-lg-4 s_process_step position-relative pt24 pb24 o_colored_level">
                                        <div class="s_process_step_number d-flex align-items-center justify-content-center mx-auto rounded-circle bg-primary-light" data-name="Step Number"><h3 class="mb-0 text-primary text-center">1</h3></div>
                                        <div class="s_process_step_content mt-3 px-4 text-center"><h3 class="h4-fs">Get in touch</h3><p>Share your contact details and preferred times, or choose an available appointment online.</p></div>
                                    </div>
                                    <div class="col-lg-4 s_process_step position-relative pt24 pb24 o_colored_level">
                                        <div class="s_process_step_number d-flex align-items-center justify-content-center mx-auto rounded-circle bg-primary-light" data-name="Step Number"><h3 class="mb-0 text-primary text-center">2</h3></div>
                                        <div class="s_process_step_content mt-3 px-4 text-center"><h3 class="h4-fs">Meet the practice</h3><p>Talk about your needs, ask questions and get to know the people looking after your visit.</p></div>
                                    </div>
                                    <div class="col-lg-4 s_process_step position-relative pt24 pb24 o_colored_level">
                                        <div class="s_process_step_number d-flex align-items-center justify-content-center mx-auto rounded-circle bg-primary-light" data-name="Step Number"><h3 class="mb-0 text-primary text-center">3</h3></div>
                                        <div class="s_process_step_content mt-3 px-4 text-center"><h3 class="h4-fs">Agree what comes next</h3><p>Discuss any proposed care and fees, then arrange the next visit when you are ready.</p></div>
                                    </div>
                                </div>
                                <p class="text-center mt-4 mb-0"><a href="/fees-and-first-visit" class="btn btn-outline-primary">Fees and your first visit</a></p>
                            </div>
                        </section>
                        <section class="s_call_to_action o_cc o_cc4 pt64 pb64 o_colored_level" data-snippet="s_call_to_action" data-name="Start with Willow">
                            <div class="container">
                                <div class="row align-items-center g-4">
                                    <div class="col-lg-8"><h2 class="display-5 mb-3">A good place to begin.</h2><p class="lead mb-0">Let reception help you arrange your first visit.</p></div>
                                    <div class="col-lg-4 text-lg-end"><a href="/dentist/new-patient" class="btn btn-light btn-lg">Make an enquiry</a></div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <function model="ir.ui.view" name="write" context="{'website_id': ref('base.default_website')}">
            <value model="website" eval="obj().with_context(website_id=ref('base.default_website')).viewref('website.homepage').ids"/>
            <value model="ir.ui.view" eval="{'arch': obj().env.ref('dentist_practice.view_willow_home_source').arch}"/>
        </function>
    </data>
</odoo>
