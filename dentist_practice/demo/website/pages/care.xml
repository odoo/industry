<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_willow_care" model="ir.ui.view">
        <field name="name">Willow Dental - Our care</field>
        <field name="key">dentist_practice.willow_care</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="base.default_website"/>
        <field name="arch" type="xml">
            <t name="Our care" t-name="dentist_practice.willow_care">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title_split o_cc o_cc2 pt80 pb64 o_colored_level" data-snippet="s_title_split" data-name="Our care introduction">
                            <div class="container s_allow_columns">
                                <div class="row align-items-end g-4">
                                    <div class="col-lg-6"><p class="small text-uppercase fw-semibold text-primary">Our care</p><h1 class="display-3 mb-0">Dental care,<br/>explained clearly.</h1></div>
                                    <div class="col-lg-5 offset-lg-1"><p class="lead mb-0">From routine appointments to a conversation about treatment, begin with an understanding of your needs and the options ahead.</p></div>
                                </div>
                            </div>
                        </section>
                        <section class="s_image_text pt80 pb80 o_colored_level" data-snippet="s_image_text" data-name="Care at Willow">
                            <div class="container">
                                <div class="row align-items-center g-4 g-lg-5">
                                    <div class="col-lg-6 pt16 pb16 o_colored_level"><img src="/dentist_practice/static/src/img/website/willow-care.webp" alt="A carefully prepared dental chair and treatment space" class="img img-fluid w-100 rounded-4 o_we_custom_image"/></div>
                                    <div class="col-lg-5 offset-lg-1 o_colored_level">
                                        <div id="examinations" class="border-bottom pt24 pb24"><p class="small text-primary">01 / EXAMINATIONS</p><h2 class="h3-fs">Your starting point.</h2><p class="mb-0">An examination is an opportunity to discuss what matters to you, review your oral health and agree the next step with your dentist.</p></div>
                                        <div id="hygiene" class="border-bottom pt24 pb24"><p class="small text-primary">02 / HYGIENE</p><h2 class="h3-fs">Everyday care, thoughtfully planned.</h2><p class="mb-0">Hygiene visits focus on routine preventive care. The team will discuss your needs and help you plan returning appointments.</p></div>
                                        <div id="consultations" class="pt24 pb24"><p class="small text-primary">03 / CONSULTATIONS</p><h2 class="h3-fs">Know your next step.</h2><p class="mb-0">Bring a new concern or discuss a proposed course of care. Your practitioner can explain the options, while reception helps with estimates and arrangements.</p></div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block o_cc o_cc2 pt64 pb64 o_colored_level" data-snippet="s_text_block" data-name="Planning treatment">
                            <div class="container s_allow_columns">
                                <div class="row g-4 g-lg-5">
                                    <div class="col-lg-5"><p class="small text-uppercase fw-semibold text-primary">When more care is proposed</p><h2 class="display-5">Understand it.<br/>Talk it through.</h2></div>
                                    <div class="col-lg-6 offset-lg-1"><p class="lead">A plan should give you something clear to consider.</p><p>Discuss the proposed care with your practitioner and review the financial estimate with reception. You can ask about the appointment sequence, fees and practical arrangements before agreeing what comes next.</p><p>We keep the conversation about clinical options with the practitioner and the booking details with reception.</p><a href="/fees-and-first-visit" class="btn btn-outline-primary mt-2">Read about fees and estimates</a></div>
                                </div>
                            </div>
                        </section>
                        <section class="s_faq_list pt80 pb80 o_colored_level" data-snippet="s_faq_list" data-name="Choosing an appointment">
                            <div class="container">
                                <p class="small text-uppercase fw-semibold text-primary">Before you book</p><h2 class="display-5 mb-5">A few helpful answers.</h2>
                                <div class="row g-4 g-lg-5">
                                    <div class="col-lg-4"><h3 class="h5-fs">Which appointment should I choose?</h3><p>If you are unsure, send reception an enquiry. They can help arrange a suitable appointment for a conversation with the practice.</p></div>
                                    <div class="col-lg-4"><h3 class="h5-fs">Can I discuss a proposed estimate?</h3><p>Yes. Reception can explain the financial proposal and appointment arrangements. Questions about the care itself go to your practitioner.</p></div>
                                    <div class="col-lg-4"><h3 class="h5-fs">What if I need another time?</h3><p>Contact reception to discuss availability. An enquiry gives us your preferences; it does not reserve a slot.</p></div>
                                </div>
                            </div>
                        </section>
                        <section class="s_call_to_action o_cc o_cc4 pt64 pb64 o_colored_level" data-snippet="s_call_to_action" data-name="Find your next appointment"><div class="container"><div class="row align-items-center g-4"><div class="col-lg-8"><h2 class="display-5 mb-3">Let's find your next step.</h2><p class="lead mb-0">Explore appointment options or ask reception for help.</p></div><div class="col-lg-4 text-lg-end"><a href="/appointment" class="btn btn-light btn-lg">View appointments</a></div></div></div></section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_willow_care" model="website.page" forcecreate="0"><field name="view_id" ref="view_willow_care"/><field name="url">/our-care</field><field name="website_id" ref="base.default_website"/><field name="is_published" eval="True"/></record>
    </data>
</odoo>
