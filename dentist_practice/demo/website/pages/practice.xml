<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_willow_practice" model="ir.ui.view">
        <field name="name">Willow Dental - Our practice</field>
        <field name="key">dentist_practice.willow_practice</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="base.default_website"/>
        <field name="arch" type="xml">
            <t name="Our practice" t-name="dentist_practice.willow_practice">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title o_cc o_cc2 pt80 pb56 o_colored_level" data-snippet="s_title" data-name="Our practice introduction"><div class="container"><div class="row"><div class="col-lg-9"><p class="small text-uppercase fw-semibold text-primary">Our practice</p><h1 class="display-3 mb-4">Welcoming spaces.<br/>Clear conversations.</h1><p class="lead mb-0">At Willow Dental, the practical details and the personal conversation both matter.</p></div></div></div></section>
                        <section class="s_text_block pt48 pb64 o_colored_level" data-snippet="s_text_block" data-name="A look inside"><div class="container"><img src="/dentist_practice/static/src/img/website/willow-practice.webp" alt="The light-filled reception and waiting area at Willow Dental" class="img img-fluid w-100 rounded-4 o_we_custom_image"/></div></section>
                        <section class="s_title_split pt16 pb32 o_colored_level" data-snippet="s_title_split" data-name="Our approach"><div class="container s_allow_columns"><div class="row g-4"><div class="col-lg-5"><p class="small text-uppercase fw-semibold text-primary">The way we work</p><h2 class="display-5">Listen first.<br/>Plan together.</h2></div><div class="col-lg-6 offset-lg-1"><p class="lead">We want you to understand the next step, not simply move to the next appointment.</p><p>That starts with a conversation about why you are visiting and what you would like to discuss. Your practitioner explains clinical options; reception helps bring the arrangements together.</p><p>For proposed treatment, that includes time to review an estimate and agree the sequence of appointments.</p></div></div></div></section>
                        <section class="s_text_block pt32 pb80 o_colored_level" data-snippet="s_text_block" data-name="What matters at Willow"><div class="container s_allow_columns"><div class="row g-4 g-lg-5"><div class="col-lg-4"><div class="border-top pt24"><h3 class="h4-fs">Space to ask.</h3><p>Bring your questions. We can help direct them to the right person, whether they concern your care, estimate or next booking.</p></div></div><div class="col-lg-4"><div class="border-top pt24"><h3 class="h4-fs">Plain language.</h3><p>Conversations about your visit should make sense. Ask us to explain a proposed next step or any practical detail that is unclear.</p></div></div><div class="col-lg-4"><div class="border-top pt24"><h3 class="h4-fs">An organised handoff.</h3><p>Reception helps with contact details, appointment arrangements, estimates and planning when to return.</p></div></div></div></div></section>
                        <section class="s_image_text o_cc o_cc2 pt64 pb64 o_colored_level" data-snippet="s_image_text" data-name="Planning a comfortable visit"><div class="container"><div class="row align-items-center g-4 g-lg-5"><div class="col-lg-6 pt16 pb16"><img src="/dentist_practice/static/src/img/website/willow-first-visit.webp" alt="A calm setting for a conversation about a first visit" class="img img-fluid w-100 rounded-4 o_we_custom_image" loading="lazy"/></div><div class="col-lg-5 offset-lg-1 pt24 pb24"><p class="small text-uppercase fw-semibold text-primary">Before you arrive</p><h2 class="display-5 mb-4">Tell us what would help.</h2><p>If you have a question about arranging your visit, let reception know. We can discuss timing, what to expect and any practical arrangements before you arrive.</p><p>Use the enquiry form for booking details and keep clinical questions for a direct conversation with the practice.</p><a href="/dentist/new-patient" class="btn btn-primary mt-3">Talk to reception</a></div></div></div></section>
                        <section class="s_call_to_action pt80 pb80 o_colored_level" data-snippet="s_call_to_action" data-name="Your first visit"><div class="container"><div class="row align-items-center g-4"><div class="col-lg-8"><h2 class="display-5 mb-3">Make yourself familiar.</h2><p class="lead mb-0">Read how a first visit is arranged and how fees are discussed.</p></div><div class="col-lg-4 text-lg-end"><a href="/fees-and-first-visit" class="btn btn-outline-primary btn-lg">Your first visit</a></div></div></div></section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_willow_practice" model="website.page" forcecreate="0"><field name="view_id" ref="view_willow_practice"/><field name="url">/our-practice</field><field name="website_id" ref="base.default_website"/><field name="is_published" eval="True"/></record>
    </data>
</odoo>
