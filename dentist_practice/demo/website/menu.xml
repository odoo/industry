<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="menu_willow_root" model="website.menu">
        <field name="name">Willow Dental</field>
        <field name="website_id" ref="base.default_website"/>
        <field name="sequence">1</field>
    </record>
    <record id="menu_willow_home" model="website.menu">
        <field name="name">Home</field>
        <field name="url">/</field>
        <field name="website_id" ref="base.default_website"/>
        <field name="parent_id" ref="menu_willow_root"/>
        <field name="sequence">10</field>
    </record>
    <record id="menu_willow_care" model="website.menu">
        <field name="name">Our care</field>
        <field name="page_id" ref="page_willow_care"/>
        <field name="website_id" ref="base.default_website"/>
        <field name="parent_id" ref="menu_willow_root"/>
        <field name="sequence">20</field>
    </record>
    <record id="menu_willow_practice" model="website.menu">
        <field name="name">Our practice</field>
        <field name="page_id" ref="page_willow_practice"/>
        <field name="website_id" ref="base.default_website"/>
        <field name="parent_id" ref="menu_willow_root"/>
        <field name="sequence">30</field>
    </record>
    <record id="menu_willow_first_visit" model="website.menu">
        <field name="name">Fees and first visit</field>
        <field name="page_id" ref="page_willow_first_visit"/>
        <field name="website_id" ref="base.default_website"/>
        <field name="parent_id" ref="menu_willow_root"/>
        <field name="sequence">40</field>
    </record>
    <record id="menu_new_patient_enquiry" model="website.menu" forcecreate="0">
        <field name="parent_id" ref="menu_willow_root"/>
        <field name="sequence">50</field>
    </record>
    <!-- Retain the previous menu tree as a detached root. No links are deleted or nested further. -->
    <function model="website.menu" name="write">
        <value model="website.menu" eval="obj().search([
            ('website_id', '=', ref('base.default_website')),
            ('parent_id', '=', False),
            ('id', '!=', ref('menu_willow_root')),
        ]).ids"/>
        <value eval="{'website_id': False}"/>
    </function>
</odoo>
