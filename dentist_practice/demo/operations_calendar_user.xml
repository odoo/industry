<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <function model="calendar.calendar" name="write">
        <value model="res.users" eval="(obj().env.ref('dentist_practice.user_dentist_maya_demo').primary_calendar_id | obj().env.ref('dentist_practice.user_hygienist_alex_demo').primary_calendar_id).ids"/>
        <value eval="{'calendar_default_privacy': 'confidential'}"/>
    </function>
    <record id="calendar_dentist_maya_reception_demo" model="calendar.user">
        <field name="calendar_id" model="res.users" eval="obj().env.ref('dentist_practice.user_dentist_maya_demo').primary_calendar_id.id"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="access_role">writer</field>
        <field name="name">Dr Maya Bennett - practice diary</field>
    </record>
    <record id="calendar_dentist_maya_admin_demo" model="calendar.user">
        <field name="calendar_id" model="res.users" eval="obj().env.ref('dentist_practice.user_dentist_maya_demo').primary_calendar_id.id"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="access_role">writer</field>
        <field name="name">Dr Maya Bennett - practice diary</field>
    </record>
    <record id="calendar_hygienist_alex_reception_demo" model="calendar.user">
        <field name="calendar_id" model="res.users" eval="obj().env.ref('dentist_practice.user_hygienist_alex_demo').primary_calendar_id.id"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="access_role">writer</field>
        <field name="name">Alex Chen - practice diary</field>
    </record>
    <record id="calendar_hygienist_alex_admin_demo" model="calendar.user">
        <field name="calendar_id" model="res.users" eval="obj().env.ref('dentist_practice.user_hygienist_alex_demo').primary_calendar_id.id"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="access_role">writer</field>
        <field name="name">Alex Chen - practice diary</field>
    </record>
    <record id="calendar_reception_admin_demo" model="calendar.user">
        <field name="calendar_id" model="res.users" eval="obj().env.ref('dentist_practice.user_reception_demo').primary_calendar_id.id"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="access_role">writer</field>
        <field name="name">Reception diary</field>
    </record>
</odoo>
