<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="lot_composite_available_demo" model="stock.lot">
        <field name="name">CR-260818A</field>
        <field name="product_id" ref="product_supply_composite_syringe"/>
        <field name="expiration_date" eval="DateTime.now() + relativedelta(days=180)"/>
        <field name="use_date" eval="DateTime.now() + relativedelta(days=180)"/>
        <field name="removal_date" eval="DateTime.now() + relativedelta(days=180)"/>
        <field name="alert_date" eval="DateTime.now() + relativedelta(days=150)"/>
        <field name="note" type="html"><p>Stored in Dental Supplies. Check the batch label and expiration date during the weekly stock review.</p></field>
    </record>
    <record id="lot_composite_expiry_review_demo" model="stock.lot">
        <field name="name">CR-251205B</field>
        <field name="product_id" ref="product_supply_composite_syringe"/>
        <field name="expiration_date" eval="DateTime.now() + relativedelta(days=14)"/>
        <field name="use_date" eval="DateTime.now() + relativedelta(days=14)"/>
        <field name="removal_date" eval="DateTime.now() + relativedelta(days=14)"/>
        <field name="alert_date" eval="DateTime.now() - relativedelta(days=1)"/>
        <field name="note" type="html"><p>Expiration review due. Check the labeled dates, remaining stock and replacement needs with the person responsible for supplies.</p></field>
    </record>
</odoo>
