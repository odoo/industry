<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True, 'mail_activity_quick_update': True}">
    <function model="purchase.order" name="button_confirm">
        <value eval="[ref('purchase_order_supply_receipt_demo'), ref('purchase_order_lab_pending_demo')]"/>
    </function>
    <function model="stock.picking" name="action_assign">
        <value model="purchase.order" eval="obj(ref('purchase_order_supply_receipt_demo')).picking_ids.ids"/>
    </function>
    <function model="stock.picking" name="button_validate">
        <value model="purchase.order" eval="obj(ref('purchase_order_supply_receipt_demo')).picking_ids.ids"/>
    </function>
    <function model="purchase.order" name="action_create_invoice">
        <value eval="[ref('purchase_order_supply_receipt_demo')]"/>
    </function>
</odoo>
