<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="pricelist_patient_journey_demo" model="product.pricelist" forcecreate="0">
        <field name="name">Willow Dental Fees</field>
        <field name="sequence">100</field>
    </record>
    <record id="pricelist_item_examination_demo" model="product.pricelist.item" forcecreate="0">
        <field name="pricelist_id" ref="pricelist_patient_journey_demo"/>

        <field name="product_id" ref="product_examination"/>
        <field name="compute_price">fixed</field>
        <field name="fixed_price">95.0</field>
    </record>
    <record id="pricelist_item_hygiene_demo" model="product.pricelist.item" forcecreate="0">
        <field name="pricelist_id" ref="pricelist_patient_journey_demo"/>

        <field name="product_id" ref="product_hygiene"/>
        <field name="compute_price">fixed</field>
        <field name="fixed_price">90.0</field>
    </record>
    <record id="pricelist_item_urgent_demo" model="product.pricelist.item" forcecreate="0">
        <field name="pricelist_id" ref="pricelist_patient_journey_demo"/>

        <field name="product_id" ref="product_urgent_consultation"/>
        <field name="compute_price">fixed</field>
        <field name="fixed_price">125.0</field>
    </record>
    <record id="pricelist_item_filling_demo" model="product.pricelist.item" forcecreate="0">
        <field name="pricelist_id" ref="pricelist_patient_journey_demo"/>

        <field name="product_id" ref="product_filling"/>
        <field name="compute_price">fixed</field>
        <field name="fixed_price">175.0</field>
    </record>
    <record id="pricelist_item_crown_demo" model="product.pricelist.item" forcecreate="0">
        <field name="pricelist_id" ref="pricelist_patient_journey_demo"/>

        <field name="product_id" ref="product_crown_consultation"/>
        <field name="compute_price">fixed</field>
        <field name="fixed_price">110.0</field>
    </record>
    <record id="pricelist_item_implant_demo" model="product.pricelist.item" forcecreate="0">
        <field name="pricelist_id" ref="pricelist_patient_journey_demo"/>

        <field name="product_id" ref="product_implant_consultation"/>
        <field name="compute_price">fixed</field>
        <field name="fixed_price">125.0</field>
    </record>
    <record id="point_of_sale.pos_config_retail" model="pos.config" forcecreate="0">
        <field name="use_pricelist" eval="True"/>
        <field name="pricelist_id" ref="pricelist_patient_journey_demo"/>
        <field name="available_pricelist_ids" eval="[Command.link(ref('pricelist_patient_journey_demo'))]"/>
    </record>
</odoo>
