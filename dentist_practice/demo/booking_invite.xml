<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True, 'mail_activity_quick_update': True, 'mail_notrack': True}">
    <record id="activity_james_booking_link" model="mail.activity">
        <field name="res_model_id" ref="crm.model_crm_lead"/>
        <field name="res_id" ref="crm_james_web_enquiry_demo"/>
        <field name="activity_type_id" ref="activity_type_opportunity_booking_link"/>
        <field name="user_id" ref="user_reception_demo"/>
        <field name="date_deadline" eval="DateTime.now(pytz.timezone(obj().env.ref('base.user_admin').tz or 'UTC')).date()" model="res.users"/>
        <field name="summary">James - share the first-visit booking link</field>
        <field name="note" type="html">
            <p>Confirm James's details and preview the first-examination email. If he agrees a time by phone, book from his opportunity and select his existing patient contact as an attendee.</p>
        </field>
        <field name="role_id" ref="role_dental_reception"/>
    </record>
</odoo>
