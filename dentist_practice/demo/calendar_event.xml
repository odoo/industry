<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{     'no_mail_to_attendees': True,     'mail_notrack': True,     'mail_auto_subscribe_no_notify': True,     'mail_activity_quick_update': True,     'dont_notify': True,     'skip_contact_description': True, }">
    <record id="event_sophie_examination_demo" model="calendar.event">
        <field name="res_model_id" ref="crm.model_crm_lead"/>
        <field name="res_id" ref="crm_sophie_first_visit_demo"/>
        <field name="name">Sophie Taylor - New-patient examination</field>
        <field name="opportunity_id" ref="crm_sophie_first_visit_demo"/>
        <field name="appointment_type_id" ref="appointment_new_patient"/>
        <field name="user_id" ref="user_dentist_maya_demo"/>
        <field name="calendar_id" model="res.users" eval="obj().env.ref('dentist_practice.user_dentist_maya_demo').primary_calendar_id.id"/>
        <field name="appointment_booker_id" ref="partner_sophie_taylor_demo"/>
        <field name="partner_ids" eval="[Command.link(ref('partner_staff_dentist_maya_demo')), Command.link(ref('partner_sophie_taylor_demo'))]"/>
        <field name="attendee_ids" eval="[             Command.create({'partner_id': ref('partner_staff_dentist_maya_demo'), 'state': 'accepted'}),             Command.create({'partner_id': ref('partner_sophie_taylor_demo'), 'state': 'accepted'}),         ]"/>
        <field name="booking_line_ids" eval="[Command.create({'capacity_reserved': 1})]"/>
        <field name="start" model="appointment.type" eval="((DateTime.now(pytz.timezone(obj().env.ref('dentist_practice.appointment_new_patient').appointment_tz)) + relativedelta(days=1, weekday=0)).replace(hour=10, minute=0, second=0, microsecond=0) + relativedelta(minutes=0)).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="stop" model="appointment.type" eval="((DateTime.now(pytz.timezone(obj().env.ref('dentist_practice.appointment_new_patient').appointment_tz)) + relativedelta(days=1, weekday=0)).replace(hour=10, minute=0, second=0, microsecond=0) + relativedelta(minutes=30)).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="show_as">busy</field>
        <field name="privacy" eval="False"/>
        <field name="appointment_status">booked</field>
        <field name="alarm_ids" eval="[Command.set([ref('calendar.alarm_notif_1')])]"/>
        <field name="require_appointment_feedback_mail" eval="False"/>
        <field name="notes" type="html">
            <p>Telephone booking agreed by reception after a referral. Review Sophie's first-visit estimate and confirm contact details on arrival.</p>
        </field>
    </record>
