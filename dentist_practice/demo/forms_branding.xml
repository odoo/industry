<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="sign_template_administrative_contact" model="sign.template" forcecreate="0">
        <field name="message" type="html">
            <p>Please review your contact details and complete your registration with Willow Dental.</p>
        </field>
    </record>
    <record id="attachment_administrative_contact_form" model="ir.attachment" forcecreate="0">
        <field name="name">Willow Dental - Patient registration.pdf</field>
        <field name="raw" type="bytes" file="dentist_practice/static/src/pdf/administrative_contact_details.pdf"/>
    </record>
    <record id="sign_template_financial_receipt" model="sign.template" forcecreate="0">
        <field name="message" type="html">
            <p>Please acknowledge receipt of your financial proposal from Willow Dental. You can review and accept the proposal separately through your quotation.</p>
        </field>
    </record>
    <record id="attachment_financial_receipt_form" model="ir.attachment" forcecreate="0">
        <field name="name">Willow Dental - Financial proposal acknowledgement.pdf</field>
        <field name="raw" type="bytes" file="dentist_practice/static/src/pdf/financial_proposal_receipt.pdf"/>
    </record>
    <record id="document_administrative_contact_form" model="documents.document" forcecreate="0">
        <field name="name">Willow Dental - Patient registration</field>
    </record>
    <record id="document_financial_receipt_form" model="documents.document" forcecreate="0">
        <field name="name">Willow Dental - Financial proposal acknowledgement</field>
    </record>
</odoo>
