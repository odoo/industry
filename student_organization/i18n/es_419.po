#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong>\n"
"                        <span class=\"h2-fs\">Tips for Success</span>\n"
"                    </strong>"
msgstr ""
"<strong>\n"
"                        <span class=\"h2-fs\">Consejos para triunfar</span>\n"
"                    </strong>"

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong><b>Accounting App</b>: </strong>Keep track of the organization's "
"budget, managing expenses and income\n"
"                    from fees and fundraising.<br/>"
msgstr ""
"<strong><b>Contabilidad</b>: </strong>Lleva el control del presupuesto de la "
"organización y gestiona gastos e ingresos\n"
"                por cuotas y recaudación de fondos.<br/>"

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong><b>Email Marketing App</b>: </strong>Engage the student body with "
"newsletters about upcoming events,\n"
"                    elections, and important announcements.<br/>"
msgstr ""
"<strong><b>Marketing por correo</b>: </strong>Involucra a la comunidad "
"estudiantil con boletines sobre los próximos eventos,\n"
"                elecciones y anuncios importantes.<br/>"

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong><b>Events App</b>:</strong> Create and promote student events, "
"handling registrations and ticket sales\n"
"                    online for everything from galas to workshops.<br/>"
msgstr ""
"<strong><b>Eventos</b>:</strong>Crea y promociona eventos estudiantiles, "
"gestiona registros y venta de boletos\n"
"                en línea para todo tipo de actividades, desde galas hasta "
"talleres.<br/>"

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong><b>Members App</b>: </strong>Manage your membership base "
"efficiently, tracking active status, dues\n"
"                    payments, and renewal dates.<br/>"
msgstr ""
"<strong><b>Miembros</b>: </strong>Gestiona tu base de membresías con "
"eficiencia, da seguimiento al estado activo,\n"
"                pagos de cuotas y fechas de renovación.<br/>"

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong><b>Website App</b>: </strong>Build a portal for your organization to "
"share news, host a calendar, and\n"
"                    allow members to sign up for activities.<br/>"
msgstr ""
"<strong><b>Sitio web</b>: </strong>Crea un portal para tu organización donde "
"compartas noticias, alojes un calendario\n"
"                y permitas que los miembros se inscriban a actividades.<br/>"

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong><b>eCommerce App</b>:</strong> Sell branded merchandise, event kits, "
"or study materials directly to your\n"
"                    members online."
msgstr ""
"<strong><b>Comercio electrónico</b>:</strong>Vende productos con tu marca, "
"kits para eventos o materiales de estudio de forma directa\n"
"                a tus miembros en línea."

#. module: student_organization
#: model_terms:event.event,description:student_organization.event_event_2
msgid "<strong>A Night to Remember – Celebrate, Connect, and Shine</strong>"
msgstr ""
"<strong>Una noche para recordar - Celebra, crea conexiones y brilla</strong>"

#. module: student_organization
#: model_terms:event.event,description:student_organization.event_event_4
msgid "<strong>Are you ready to take on the challenge?</strong>"
msgstr ""

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong>Automate reminders.</strong> SMS or email nudges cut no‑shows and\n"
"                            keep vaccinations on schedule."
msgstr ""
"<strong>Automatiza tus recordatorios.</strong> Los SMS y correos electrónico "
"hacen que menos personas falten a sus citas\n"
"                            y reciban sus vacunas en el momento correcto."

#. module: student_organization
#: model_terms:event.event,description:student_organization.event_event_4
msgid "<strong>Challenges may include:</strong>"
msgstr ""

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong>Dashboards</strong>: Create a visual overview of memberships, "
"ticket\n"
"                    sales, merchandise, and engagement stats."
msgstr ""
"<strong>Tableros</strong>: Crea un resumen visual de las membresías, los "
"boletos vendidos,\n"
"                    los productos y las estadísticas de las interacciones."

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong>Documents</strong>: Store meeting notes, budgets, and reports in "
"one\n"
"                    place — no more chasing files."
msgstr ""
"<strong>Documentos</strong>: Almacena las notas de tus reuniones, "
"presupuestos y reportes en un solo\n"
"                    lugar. Ya no tendrás que buscar tus archivos por todas "
