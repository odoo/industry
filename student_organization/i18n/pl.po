#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong>Documents</strong>: Store meeting notes, budgets, and reports in "
"one\n"
"                    place — no more chasing files."
msgstr ""
"<strong>Dokumenty</strong>: Przechowuj notatki ze spotkania, budżety i "
"raporty w jednym\n"
"                    miejscu - koniec z bałaganem w plikach."

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong>Email Marketing</strong>: Build campaigns with drag-and-drop "
"templates,\n"
"                    track opens and clicks."
msgstr ""
"<strong>Email Marketing</strong>: Stwórz kampanie z użyciem przeciąganych "
"szablonów,\n"
"                    śledź otwarcia i kliknięcia."

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong>Events</strong>: Configure events, assign ticket types, and track\n"
"                    attendance."
msgstr ""
"<strong>Wydarzenia</strong>: Konfiguruj wydarzenia, przypisuj typy biletów i "
"śledź\n"
"                    frekwencję."

#. module: student_organization
#: model_terms:ir.ui.view,arch_db:student_organization.welcome_article_body
msgid ""
"<strong>Expenses</strong>: Upload receipts, categorize spending, and follow "
"approval\n"
"            steps."
msgstr ""
"<strong>Wydatki</strong>: Przesyłaj paragony, kategoryzuj wydatki i "
"dotrzymuj etapów\n"
