<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The main image of both templates (white) becomes an extra image without
         attribute value on creation: restrict it to the white variants before
         the other images are created, as their creation recomputes which extra
         images each variant shows. -->
    <function model="product.image" name="write">
        <value model="product.image" search="[('product_tmpl_id', '=', ref('product_template_5')), ('has_attribute_value', '=', False)]"/>
        <value model="product.template.attribute.value" eval="{'attribute_value_ids': [(6, 0, obj().search([
            ('attribute_line_id', '=', ref('product_template_attribute_line_4')),
            ('product_attribute_value_id', '=', ref('product_attribute_value_14')),
        ]).ids)]}"/>
    </function>
    <function model="product.image" name="write">
        <value model="product.image" search="[('product_tmpl_id', '=', ref('product_template_6')), ('has_attribute_value', '=', False)]"/>
        <value model="product.template.attribute.value" eval="{'attribute_value_ids': [(6, 0, obj().search([
            ('attribute_line_id', '=', ref('product_template_attribute_line_5')),
            ('product_attribute_value_id', '=', ref('product_attribute_value_14')),
        ]).ids)]}"/>
    </function>
    <record id="product_image_1" model="product.image">
        <field name="name">Student Union T-Shirt - Light blue - Front</field>
        <field name="product_tmpl_id" ref="product_template_6"/>
        <field name="attribute_value_ids" model="product.template.attribute.value" eval="obj().search([
            ('attribute_line_id', '=', ref('product_template_attribute_line_5')),
            ('product_attribute_value_id', '=', ref('product_attribute_value_11')),
        ])"/>
        <field name="sequence" eval="1"/>
        <field name="image_1920" type="bytes" file="student_organization/static/src/binary/product_image/1-image_1920.jpg"/>
    </record>
