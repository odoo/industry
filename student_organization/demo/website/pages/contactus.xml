<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Join us</field>
        <field name="key">student_organization.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="student_organization.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{                 'email_to': res_company.email,                 'name': request.params.get('name', ''),                 'phone': request.params.get('phone', ''),                 'email_from': request.params.get('email_from', ''),                 'company': request.params.get('company', ''),                 'subject': request.params.get('subject', ''),             }"/>
                    <t t-set="contactus_form_values" t-value="dict(contactus_form_values, **{                     'contact_name': request.params.get('contact_name', ''),                     'partner_name': request.params.get('partner_name', ''),                     'description': request.params.get('description', ''),                 })"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block o_colored_level pt104 s_custom_snippet pb32" data-snippet="s_text_block" data-name="Custom Text">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="o_colored_level offset-lg-2 col-lg-8">
                                        <p style="text-align: center;">
                                            <span class="o_small-fs text-600"><strong><span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;"><span class="oi oi-filled text-o-color-2" data-icon="circle" style="padding-right: 6px;"/>MEMBERSHIP</span></strong></span>
                                        </p>
                                        <h1 style="text-align: center;">
                                            <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">JOINING TAKES<br/><span class="bg-o-color-1">TWO MINUTES</span></span>
                                            <br/>
                                        </h1>
                                        <p style="text-align: center;" class="lead">
                                            <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">No interview. No "sorry, we're full."<br/>If you're a student here, you're already welcome.</span>
                                            <br/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_manifesto pt64 pb64 o_colored_level o_cc o_cc2" data-snippet="s_manifesto" data-name="Manifesto" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Containers/03&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                            <div class="o_we_shape o_html_builder_Containers_03" style="background-image: url(&quot;/html_editor/shape/html_builder%2FContainers%2F03.svg?c5=%23FFFFFF&quot;);"/>
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-4 o_colored_level o_animate o_anim_fade_in pt16">
                                        <h2>WHY JOIN?</h2>
                                    </div>
                                    <div class="col-lg-4 o_colored_level o_animate o_anim_fade_in pt24">
                                        <p>01.</p>
                                        <h3 class="h5-fs">ACCESS TO ALL EVENTS</h3>
                                        <p>Priority registration for every workshop, talk, and social — including members-only sessions with industry guests.</p>
                                        <div class="s_hr pt32 pb32" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 o_colored_level o_animate o_anim_fade_in pt24">
                                        <p>02.</p>
                                        <h3 class="h5-fs">A REAL COMMUNITY</h3>
                                        <p>Join a network of 400+ students across 12 campuses who actually want to connect, collaborate, and cheer each other on.</p>
                                        <div class="s_hr pt32 pb32" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 offset-lg-4 o_colored_level o_animate o_anim_fade_in pt24">
                                        <p>03.</p>
                                        <h3 class="h5-fs">LEAD SOMETHING</h3>
                                        <p>Pitch and run your own project, workshop, or initiative with Unio&amp;nbsp;support, funding, and a room full of people ready to help.</p>
                                        <div class="s_hr pt32 pb32" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 o_colored_level o_animate o_anim_fade_in pt24">
                                        <p>04.</p>
                                        <h3 class="h5-fs">GROW FOR REAL</h3>
                                        <p>Skills, mentors, and experiences you cannot get from lectures alone — practical, personal, and genuinely career-defining.</p>
                                        <div class="s_hr pt32 pb32 d-lg-block d-none o_snippet_mobile_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level pb88 pt40" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns o_container_small">
                                <div class="row">
                                    <div class="o_colored_level border o_animate o_anim_fade_in pt0 col-lg-12" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; border-left-color: var(--o-color-5) !important; border-bottom-color: var(--o-color-5) !important; border-right-color: var(--o-color-5) !important; border-top-color: var(--o-color-5) !important;">
                                        <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container-fluid">
                                                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div class="s_website_form_inner_content o_no_direct_child_drop col-12 pb24">
                                                            <h2 style="text-align: center;">QUESTIONS ABOUT MEMBERSHIP?</h2>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="char" data-translated-name="Full name">
                                                            <label class="s_website_form_label" for="obhh918suyfu" style="width: 200px;"><span class="s_website_form_label_content">Full name</span><span class="s_website_form_mark">   *</span></label><input class="form-control s_website_form_input" type="text" name="Full name" required="" placeholder="e.g. Amara Osei" id="obhh918suyfu" data-fill-with="name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="email" data-translated-name="University email">
                                                            <label class="s_website_form_label" for="o3892cjgbwsp" style="width: 200px;"><span class="s_website_form_label_content">University email</span><span class="s_website_form_mark">   *</span></label><input class="form-control s_website_form_input" type="email" name="email_from" required="" placeholder="e.g. a.osei@university.example.com" id="o3892cjgbwsp" data-fill-with="email"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom" data-type="char" data-translated-name="Course / Degree">
                                                            <label class="s_website_form_label" for="on3vf0bb371m" style="width: 200px;"><span class="s_website_form_label_content">Course / Degree</span></label><input class="form-control s_website_form_input" type="text" name="Course / Degree" value="" placeholder="e.g. BA Design" id="on3vf0bb371m"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_custom" data-type="many2one" data-translated-name="Year of study">
                                                            <label class="s_website_form_label" for="omq81j7735gk" style="width: 200px;"><span class="s_website_form_label_content">Year of study</span></label>
                                                            <select class="form-select s_website_form_input" name="Year of study" id="omq81j7735gk">
                                                                <option id="omq81j7735gk0" value="Year 1" selected="selected">Year 1</option>
                                                                <option id="omq81j7735gk1" value="Year 2">Year 2</option>
                                                                <option id="omq81j7735gk2" value="Year 3">Year 3</option>
                                                                <option id="omq81j7735gk3" value="Year 4">Year 4</option>
                                                                <option id="omq81j7735gk4" value="Master">Master</option>
                                                                <option id="omq81j7735gk5" value="PhD">PhD</option>
                                                            </select>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required s_website_form_field_hidden" data-type="char" data-translated-name="Subject">
                                                            <label class="s_website_form_label" for="oiuwuhct6lg" style="width: 200px;"><span class="s_website_form_label_content">Subject</span><span class="s_website_form_mark">   *</span></label><input class="form-control s_website_form_input" type="text" name="subject" required="" value="" placeholder="" id="oiuwuhct6lg" data-fill-with="undefined"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="text" data-translated-name="Why do you want to join?">
                                                            <label class="s_website_form_label" for="obs8y34nhug" style="width: 200px;"><span class="s_website_form_label_content">Why do you want to join?</span><span class="s_website_form_mark">   *</span></label><textarea class="form-control s_website_form_input" name="Why do you want to join?" required="" placeholder="Tell us what excites you, what you want to build or simply why unio feels right for you." id="obs8y34nhug" rows="3"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 undefined s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px;"><span class="s_website_form_label_content"/></label>
                                                                <div class="col-sm">
                                                                    <input type="hidden" class="form-control s_website_form_input" name="email_to" value="hello@unio.example.com"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-center s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label">
                                                                <br/>
                                                            </div>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send o_translate_inline">Send My Question</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
