                                    <div class="col-lg-12 o_colored_level o-shadow-custom border p-0" style="--box-border-left-width: 10px; --box-border-bottom-width: 10px; --box-border-right-width: 10px; --box-border-top-width: 10px; border-left-color: var(--o-color-5) !important; border-bottom-color: var(--o-color-5) !important; border-right-color: var(--o-color-5) !important; border-top-color: var(--o-color-5) !important; box-shadow: rgb(167, 208, 235) 30px 26px 0px 0px !important;">
