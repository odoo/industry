        <field name="arch" type="xml">
            <t t-name="student_organization.page_about_us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block o_colored_level pt104 pb56" data-snippet="s_text_block" data-name="Text">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="o_colored_level offset-lg-2 col-lg-8">
                                        <p style="text-align: center;">
                                            <span class="o_small-fs text-600"><strong><span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;"><span class="oi oi-filled text-o-color-2" data-icon="circle" style="padding-right: 6px;"/>OUR STORY</span></strong></span>
                                        </p>
                                        <h1 style="text-align: center;">
                                            <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">WE ARE <span class="bg-o-color-1">UNIO</span></span>
                                        </h1>
                                        <p style="text-align: center;" class="lead">
                                            <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">A student-owned collective on a mission to make university life richer, wilder, and more connected than it has any right to be.</span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
