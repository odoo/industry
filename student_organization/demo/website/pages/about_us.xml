                        <section class="s_projects_list pt48 o_colored_level pb48 o_cc o_cc1" data-snippet="s_projects_list" data-name="Projects List" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Containers/03&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-4&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
