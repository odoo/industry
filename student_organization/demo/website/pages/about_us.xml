                                    </div>
                                    <div class="o_colored_level col-lg-12 pb24 pt32 border o_animate o_anim_fade_in" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;" data-name="Project">
                                        <div class="row s_col_no_bgcolor">
                                            <div class="col-6 col-lg-6">
                                                <h3>GROWTH</h3>
                                            </div>
                                            <div class="col-6 col-lg-6">
                                                <p style="text-align: end;">We measure success by how much our members learn, evolve, and come alive.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
