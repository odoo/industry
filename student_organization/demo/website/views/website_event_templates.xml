<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_index_topbar" model="ir.ui.view">
        <field name="name">Custom - Events Topbar</field>
        <field name="key">student_organization.event_index_topbar</field>
        <field name="inherit_id" ref="website_event.index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('o_wevent_index_topbar_filters')]//h1" position="replace">
                <h2 class="mb-0">Upcoming events</h2>
            </xpath>
        </field>
    </record>
    <record id="event_index" model="ir.ui.view">
        <field name="name">Custom - Events</field>
        <field name="key">student_organization.event_index</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_we_index_0']" position="replace">
                <div id="oe_structure_we_index_0" class="oe_structure oe_empty">
                    <section class="s_text_block o_colored_level pt104 pb56" data-snippet="s_text_block" data-name="Text">
                        <div class="container s_allow_columns">
                            <div class="row">
                                <div class="o_colored_level offset-lg-2 col-lg-8">
                                    <p class="text-center">
                                        <span class="o_small-fs text-600"><strong><span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;"><span class="oi oi-filled text-o-color-2" data-icon="circle" style="padding-right: 6px;"/>UPCOMING EVENTS</span></strong></span>
                                    </p>
                                    <h1 class="text-center">
                                        <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">SOMETHING'S <span class="bg-o-color-1">ALWAYS ON</span></span>
                                    </h1>
                                    <p class="text-center lead">
                                        <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">
                                            Everything here is free for members and open to newcomers.<br/>
                                            Turn up alone — you won't leave that way.
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
            <xpath expr="//div[@id='oe_structure_we_index_2']" position="replace">
                <div id="oe_structure_we_index_2" class="oe_structure oe_empty">
                    <div class="s_hr pb32 o_colored_level pt64 d-lg-block d-none o_snippet_mobile_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                        <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
