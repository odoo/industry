<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-right-width: 0px;">
                    <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="pb24 o_colored_level col-lg-2 pt16">
                                    <p>
                                        <img src="/web/image/student_organization.img_student_organization_image_08" alt="Unio" class="img img-fluid o_we_custom_image" loading="lazy" style="width: 50% !important;"/>
                                    </p>
                                    <p>A place for students to learn, share &amp; collaborate</p>
                                    <p>
                                        <br/>
                                    </p>
                                    <p>
                                        <a href="/contactus" class="o_translate_inline btn btn-primary">Join us</a>
                                    </p>
                                </div>
                                <div class="pb24 o_colored_level pt24 offset-lg-5 col-lg-2">
                                    <p>
                                        <span class="o_small-fs"><strong><span class="text-o-color-1">PAGES</span></strong></span>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li><a href="/">Home</a></li>
                                        <li><a href="/about-us">About</a></li>
                                        <li><a href="/event" class="o_translate_inline">Events</a></li>
                                        <li><a href="/shop" class="o_translate_inline">Shop</a></li>
                                        <li><a href="/contactus" class="o_translate_inline">Join us</a></li>
                                    </ul>
                                </div>
                                <div class="pb24 o_colored_level pt24 offset-lg-1 col-lg-2">
                                    <p>
                                        <span class="o_small-fs"><strong><span class="text-o-color-1">CONTACT</span></strong></span>
                                    </p>
                                    <p>
                                        <a href="mailto:hello@unio.example.com" class="o_translate_inline">hello@unio.example.com</a>
                                    </p>
                                    <p>
                                        <a href="tel:+15555555556" class="o_translate_inline">+1 555-555-5556</a>
                                    </p>
                                    <div>Weekdays 2–6pm, and every Thursday till late</div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - Footer Copyright</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">
                    <span class="o_small-fs">© UNIO - ALL RIGHTS RESERVED</span>
                </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
