#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.homepage
msgid "<a href=\"#\" class=\"btn o_translate_inline btn-primary\">Discover more</a>"
msgstr ""
"<a href=\"#\" class=\"btn o_translate_inline btn-primary\">Pelajari "
"selengkapnya</a>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">CRM:</font></b> Manage your customer "
"relationships and pipelines."
msgstr ""
"<b><font class=\"text-o-color-1\">CRM:</font></b> Kelola hubungan pelanggan "
"dan pipeline Anda."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Project:</font></b> Build your project "
"foundation for prototyping and reuse it for all subsequent stages."
msgstr ""
"<b><font class=\"text-o-color-1\">Project:</font></b> Bangun fondasi project "
"Anda untuk pembuatan prototipe dan gunakan kembali fondasi tersebut untuk "
"tahap-tahap selanjutnya."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Purchase:</font></b> Track supplier orders"
" and manage your entire procurement history."
msgstr ""
"<b><font class=\"text-o-color-1\">Purchase:</font></b> Lacak pesanan "
"supplier dan kelola seluruh riwayat pengadaan Anda."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Audit Trail:</b> Keep every modification visible to ensure full "
"transparency throughout the product's development cycle."
msgstr ""
"<b> Audit Trail:</b> Pastikan setiap modifikasi tetap terlihat agar siklus "
"pengembangan produk selalu transparan."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Automated MTO (Make to Order):</b> Enable the <b>MTO route</b> on semi-"
"finished products. This automatically triggers a linked secondary MO the "
"moment the main manufacturing order is confirmed."
msgstr ""
"<b>MTO (Make to Order) Otomatis:</b> Aktifkan <b>rute MTO</b> pada produk "
"setengah jadi. Hal ini secara otomatis memicu MO sekunder yang terhubung "
"begitu MO utama dikonfirmasi."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>BOM Integration:</b> If your project requires multiple Bills of Materials"
" (BOMs), create them directly using the dedicated BOM button."
msgstr ""
"<b>Integrasi BOM:</b> Jika project Anda memerlukan beberapa Bill of Material "
"(BOM), buatlah langsung menggunakan tombol khusus BOM."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid "<b>Batch Sizes:</b> Optimize production runs."
msgstr "<b>Ukuran Batch:</b> Optimalkan proses produksi."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>By-Products:</b> Manage secondary outputs during the manufacturing "
"process."
msgstr "<b>Produk Sampingan:</b> Kelola hasil sekunder selama proses produksi."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>By-products:</b> Manage leftovers from production and track them as "
"valuable inventory."
msgstr ""
"<b>Produk sampingan:</b> Kelola bahan sisa produksi dan lacak sebagai "
"inventaris yang berharga."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Centralized Hub:</b> Use the top menu to navigate effortlessly between "
"all elements linked to your project."
msgstr ""
"<b>Hub Terpusat:</b> Gunakan menu atas untuk mengakses semua elemen yang "
"terkait dengan project Anda."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Centralized Updates:</b> Manage all changes and approvals within a "
"single, dedicated interface."
msgstr ""
"<b>Pembaruan Terpusat:</b> Kelola semua perubahan dan persetujuan dalam satu "
"antarmuka khusus."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Client Collaboration:</b> Share specific folders with your clients, "
"providing them with a secure, central location to upload and access vital "
"project files."
msgstr ""
"<b>Kolaborasi Klien:</b> Bagikan folder tertentu dengan klien agar mereka "
"memiliki lokasi terpusat dan aman untuk mengunggah serta mengakses file-file "
"penting project."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Definition:</b> All billable, non-tangible offerings provided to the "
"client."
msgstr ""
"<b>Definisi:</b> Semua penawaran yang dapat ditagih dan tidak berwujud yang "
"diberikan kepada klien."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Definition:</b> All components and materials sourced directly from "
"external vendors."
msgstr ""
"<b>Definisi:</b> Semua komponen dan material diperoleh langsung dari vendor "
"eksternal."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Definition:</b> In-house manufactured items used as sub-assemblies for "
"larger builds rather than being sold individually."
msgstr ""
"<b>Definisi:</b> Barang-barang yang diproduksi secara internal dan digunakan "
"sebagai sub-rakitan untuk proyek yang lebih besar, bukan untuk dijual secara "
"terpisah."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Definition:</b> Sale-ready goods ranging from standardized items (fixed "
"BOMs) to fully customized solutions."
msgstr ""
"<b>Definisi:</b> Barang siap jual mulai dari barang standar (BOM tetap) "
"hingga solusi yang sepenuhnya kustom."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Detailed Work Orders:</b> For every operation, you can define precise "
"timings, step-by-step instructions, and mandatory <b>Quality Checks</b>."
msgstr ""
"<b>Perintah Kerja Mendetail:</b> Untuk setiap operasi, Anda dapat menentukan "
"waktu, petunjuk langkah demi langkah, dan <b>Pemeriksaan Kualitas</b> wajib."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Direct Manufacturing:</b> Launch Manufacturing Orders (MOs) from the "
"Manufacturing tab. Once confirmed, these will flow into your standard "
"manufacturing workflow. (see next section)"
msgstr ""
"<b>Produksi Langsung:</b> Luncurkan Manufacturing Order (MO) dari tab "
"Manufaktur. Setelah dikonfirmasi, pesanan ini akan masuk ke alur kerja "
"manufaktur standar Anda. (lihat bagian berikutnya)"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Easy Billing:</b> Generate a <b>Sales Order</b> directly from the repair "
"order to invoice your client for parts and labor."
msgstr ""
"<b>Penagihan Praktis:</b> Buat <b>Order Penjualan</b> langsung dari order "
"perbaikan untuk menagih klien atas suku cadang dan biaya tenaga kerja."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Either create a project :</b> From the CRM, create a new project by "
"clicking the <b>⚙️ icon</b> and selecting a template. This project will "
"allow you to manage all the pre-sales steps, such as:"
msgstr ""
"<b>Buat proyek:</b> Dari CRM, buat project baru dengan mengeklik <b>ikon ⚙️</"
"b> dan memilih template. Dengan project, Anda dapat mengelola semua langkah "
"prapenjualan, seperti:"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Either you create a Quotation from the opportunity and wait for a "
"confirmation.</b>"
msgstr ""
"<b>Anda dapat membuat Penawaran dari peluang dan menunggu konfirmasi.</b>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Engineering Review:</b> This proposal automatically generates an "
"<b>ECO</b> in the PLM app. Engineers can then review, test, and approve the "
"change before it is officially applied to the Bill of Materials."
msgstr ""
"<b>Tinjauan Engineering:</b> Proposal ini otomatis menghasilkan <b>ECO</b> "
"di aplikasi PLM. Engineer kemudian dapat meninjau, menguji, dan menyetujui "
"perubahan tersebut sebelum secara resmi diterapkan ke BOM."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Financial Forecasting &amp; Actuals:</b> Compare estimated costs against "
"real costs directly from the project overview to maintain control over your "
"budget."
msgstr ""
"<b>Perkiraan Keuangan &amp; Data Aktual:</b> Bandingkan biaya perkiraan "
"dengan biaya aktual langsung dari gambaran umum project agar anggaran Anda "
"tetap terkendali."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Flexible Timesheets:</b> Log time on individual tasks to monitor project "
"profitability or accurately bill clients for hours worked."
msgstr ""
"<b>Timesheet Fleksibel:</b> Catat waktu pada tugas-tugas individual untuk "
"memantau profitabilitas project atau menagih klien secara akurat berdasarkan "
"jam kerja."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>For example:</b> A client requests a specialized scanner capable of "
"multilingual package recognition. Within a single project, you can "
"centralize product specifications, vendor quotes, and BOM designs. You can "
"then generate an initial quotation for a <b>Proof of Concept (PoC)</b> "
"directly from the project. Once confirmed, you can continue iterating within"
" the same project—creating updated quotations and Manufacturing Orders by "
"building on previous data and new insights."
msgstr ""
"<b>Contoh:</b> Seorang klien meminta pemindai khusus yang mampu mengenali "
"kemasan dalam berbagai bahasa. Dalam satu project, Anda dapat memusatkan "
"spesifikasi produk, penawaran vendor, dan desain BOM. Anda kemudian dapat "
"membuat penawaran awal untuk <b>Proof of Concept (PoC)</b> langsung dari "
"proyek tersebut. Setelah dikonfirmasi, Anda dapat melanjutkan iterasi dalam "
"project yang sama—membuat penawaran terbaru dan Manufacturing Order dengan "
"memanfaatkan data sebelumnya dan wawasan baru."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Invoice Oversight:</b> Track all related outgoing and incoming invoices "
"directly within the project interface."
msgstr ""
"<b>Pengawasan Faktur:</b> Lacak semua faktur keluar dan masuk yang terkait "
"langsung dari antarmuka project."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid "<b>Key Benefits:</b>"
msgstr "<b>Manfaat Utama:</b>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>MTO (Make-to-Order) Route:</b> Use this to automatically trigger a "
"Manufacturing Order whenever a Sales Order is confirmed"
msgstr ""
"<b>Rute MTO (Make-to-Order):</b> Gunakan rute ini untuk memicu Manufacturing "
"Order secara otomatis setiap kali Order Penjualan dikonfirmasi"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Make to Stock (Reordering Rules):</b> Set a <b>minimum stock level</b> "
"for your sub-assemblies. The system will automatically trigger a new MO once"
" your inventory drops below this threshold, ensuring you always have enough "
"stock on hand for future production."
msgstr ""
"<b>Make to Stock (Aturan Order Ulang):</b> Tetapkan <b>tingkat stok minimum</"
"b> untuk sub-rakitan Anda. Sistem akan secara otomatis memicu MO baru begitu "
"inventaris Anda turun di bawah ambang batas ini untuk memastikan selalu ada "
"stok yang cukup untuk produksi pada masa mendatang."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Manual Creation:</b> Generate secondary MOs for sub-assemblies manually "
"as the need arises."
msgstr ""
"<b>Pembuatan Manual:</b> Buat MO sekunder untuk sub-rakitan secara manual "
"sesuai kebutuhan."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Miscellaneous Notes &amp; Integration:</b> Use the HTML field (note) in "
"the <b>Miscellaneous tab</b> for advanced instructions. You can embed links "
"to internal knowledge articles, 3D plans, or external software. Operators "
"can access these links directly from the <b>Shopfloor App</b> during "
"production."
msgstr ""
"<b>Catatan Lain-Lain &amp; Integrasi:</b> Gunakan field HTML (catatan) di <b>"
"tab Lain-lain</b> untuk petunjuk lanjutan. Anda dapat menyematkan tautan ke "
"artikel pengetahuan internal, denah 3D, atau software eksternal. Operator "
"dapat mengakses tautan ini langsung dari <b>Aplikasi Shopfloor</b> selama "
"produksi."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Monitor Progress:</b> Visit the <b>Overview Tab</b> to see a side-by-side"
" comparison of your sales, expected costs, and real costs (derived from "
"invoices and completed Manufacturing Orders)."
msgstr ""
"<b>Pantau Progres:</b> Kunjungi <b>Tab Gambaran Umum</b> untuk melihat "
"perbandingan antara penjualan, perkiraan biaya, dan biaya aktual (yang "
"diperoleh dari faktur dan Manufacturing Order yang telah diselesaikan)."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Note:</b> If you validate a transfer for a partial quantity, the system "
"will automatically create a <b>backorder</b> for the rest of the items."
msgstr ""
"<b>Catatan:</b> Jika Anda memvalidasi transfer untuk kuantitas parsial, "
"sistem akan otomatis membuat <b>backorder</b> untuk sisa barang."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Organized File Sharing:</b> Create custom folders (such as \"Internal\" "
"or \"Client-Facing\") via the Documents button."
msgstr ""
"<b>Pembagian File Terstruktur:</b> Buat folder khusus (seperti \"Internal\" "
"atau \"Client-Facing\") melalui tombol Dokumen."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid "<b>Pro Tip: Real-Time Margin Analysis</b>"
msgstr "<b>Pro Tip: Analisis Margin Real-Time</b>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Pro-Tip:</b> You can print and use barcode commands with a scanner to "
"automate and streamline your workflow."
msgstr ""
"<b>Tips Jitu:</b> Anda dapat mencetak dan menggunakan perintah barcode "
"dengan pemindai untuk mengotomatiskan dan memperlancar alur kerja."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Proactive Quality Checks:</b> These are predefined checks (created in the"
" Quality App) that trigger automatically at specific stages of production."
msgstr ""
"<b>Pemeriksaan Kualitas Proaktif:</b> Ini adalah pemeriksaan yang telah "
"disiapkan (dibuat di Aplikasi Kualitas) yang terpicu secara otomatis pada "
"tahap-tahap tertentu dalam proses produksi."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Propose BOM Updates:</b> If a worker discovers a more efficient method or"
" a necessary adjustment, they can propose adding a new step or component."
msgstr ""
"<b>Usulkan Pembaruan BOM:</b> Jika ada pekerja yang menemukan metode yang "
"lebih efisien atau penyesuaian yang diperlukan, ia dapat mengusulkan "
"penambahan langkah atau komponen baru."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Protocol:</b> Develop detailed <b>Bills of Materials (BOMs)</b> that "
"explicitly link components to their respective production stages and "
"operations."
msgstr ""
"<b>Protokol:</b> Kembangkan <b>Bill of Material (BOMs)</b> yang secara tegas "
"menghubungkan komponen dengan tahapan produksi dan operasi masing-masing."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Protocol:</b> For new clients or projects, create a <b>unique product "
"entry</b>. Map these to a <b>Master BOM Catalog</b> to pull in reusable "
"templates; this allows for distinct database tracking while leveraging "
"standardized production logic."
msgstr ""
"<b>Protokol:</b> Untuk klien atau project baru, buat <b>entri produk unik</b>"
". Petakan entri ini ke <b>Katalog BOM Master</b> untuk mengimpor template "
"yang dapat digunakan kembali; hal ini memungkinkan pelacakan database yang "
"terpisah sekaligus memanfaatkan logika produksi yang terstandardisasi."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Protocol:</b> Maintain up-to-date <b>vendor assignments</b> and "
"<b>purchase pricing</b> to ensure procurement accuracy."
msgstr ""
"<b>Protokol:</b> Pastikan <b>penugasan vendor</b> dan <b>harga pembelian</b> "
"tetap mutakhir agar pengadaan selalu akurat."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Reactive Quality Alerts:</b> If a worker identifies an issue on the fly, "
"they can trigger a <b>Quality Alert</b>. This creates a dedicated task in "
"the Quality App for the quality team to investigate."
msgstr ""
"<b>Peringatan Kualitas Reaktif:</b> Jika pekerja tiba-tiba menemukan masalah "
"saat bekerja, dia dapat memicu <b>Peringatan Kualitas</b>. Hal ini akan "
"membuat tugas khusus di Aplikasi Kualitas untuk diselidiki oleh tim kualitas."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Sales &amp; Purchase Orders:</b> Generate unlimited Sales Orders to "
"account for scope changes, and manage all project-specific Purchase Orders "
"in one place."
msgstr ""
"<b>Order Penjualan &amp; Pembelian:</b> Buat Order Penjualan tanpa batasan "
