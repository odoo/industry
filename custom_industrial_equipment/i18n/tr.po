msgstr ""
"<span class=\"h6-fs\">Üretim hattınızın bakımını planlamak ve izlemek için "
"Bakım uygulamasını kullanın.<b/></span><br/>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Use this app to manage your after-sales services</span>"
msgstr ""
