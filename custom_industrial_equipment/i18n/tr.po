#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_about_us
msgid ""
"<span style=\"font-size: 15px;\">\n"
"                                                <em>At Mecora, <strong>we "
"combine conveyor engineering expertise</strong>, <strong> industrial know-"
"how</strong>, <strong>and smart automation to develop custom belt solutions</"
"strong> that answer real material handling challenges. From initial belt "
"design and fabrication to site installation and commissioning, <strong>our "
"teams work closely with our customers</strong> to create reliable, high-"
"throughput, and future-ready conveyor lines.</em>\n"
"                                            </span>"
msgstr ""
"<span style=\"font-size: 15px;\">\n"
"                                                <em>Mecora olarak, <strong>"
"konveyör mühendisliği uzmanlığını</strong>, <strong> endüstriyel teknik "
"bilgiyi</strong>, <strong>ve özel bant çözümleri geliştirmek için akıllı "
"otomasyonu</strong> gerçek malzeme taşıma zorluklarına yanıt verecek şekilde "
"birleştiriyoruz. İlk bant tasarımından ve imalatından saha kurulumuna ve "
"devreye almaya kadar, <strong>ekiplerimiz müşterilerimizle yakın iş birliği "
"içinde çalışarak</strong> güvenilir, yüksek kapasiteli ve geleceğe hazır "
"konveyör hatları oluşturuyor.</em>\n"
"                                            </span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_about_us
msgid ""
"<span style=\"font-size: 15px;\">\n"
"                                                <em>What drives us is not "
"simply building hardware. It is understanding your production bottlenecks, "
"engineering the right automated flow, and building long-term partnerships "
"based on trust, technical expertise, and proven results.</em>\n"
"                                            </span>"
msgstr ""
"<span style=\"font-size: 15px;\">\n"
"                                                <em>Bizi motive eden sadece "
"donanım üretmek değil. Üretimdeki darboğazlarınızı anlamak, doğru otomatik "
"akışı tasarlamak ve güven, teknik uzmanlık ve kanıtlanmış sonuçlara dayalı "
"uzun vadeli ortaklıklar kurmaktır.</em>\n"
"                                            </span>"

