#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor analytics:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">Our conveyor systems are designed to "
"integrate seamlessly into your Manufacturing Execution Systems (MES). "
"Equipped with smart sensors and open communication protocols.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Analiza sistemelor de transportoare:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">Sistemele noastre de "
"transportoare se integrează perfect cu sistemele de execuție a producției "
"(MES). Sunt echipate cu senzori inteligenți și protocoale de comunicație "
"deschise.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor asset management:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">We streamline spare parts "
"inventory, belt replacement schedules, and service workflows to maximize "
"uptime while reducing maintenance costs.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Gestionarea activelor de transport:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">Optimizăm stocurile de piese "
"de schimb, programul de înlocuire a benzilor și fluxurile de service pentru "
"a maximiza timpul de funcționare și a reduce costurile de mentenanță.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor automation:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">We automate manual sorting and "
"conveyance using smart sensors, pneumatic diverters, and VFDs to ensure "
"precise material tracking and routing.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Automatizarea transportoarelor:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">Automatizăm sortarea manuală "
"și transportul cu senzori inteligenți, deviatoare pneumatice și variatoare "
"de frecvență, pentru urmărirea și rutarea precisă a materialelor.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor control panels:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">We design and build custom control "
"cabinets optimized for conveyor systems, ensuring robust power distribution "
"and seamless fieldbus integration.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Panouri de comandă pentru transportoare:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Proiectăm și "
"construim dulapuri de comandă personalizate pentru sistemele de "
"transportoare, cu distribuție sigură a energiei și integrare fluentă în "
"magistrala de teren.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor line optimization:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">Workflow analysis to eliminate "
"bottlenecks, jams, and buffering issues, boosting throughput while reducing "
"belt wear, downtime, and energy costs.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Optimizarea liniilor de transport:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">Analizăm fluxurile de lucru "
"pentru a elimina blocajele, aglomerările și problemele de acumulare, mărind "
"debitul și reducând uzura benzilor, timpii de oprire și costurile cu "
"energia.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor maintenance:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">We execute scheduled inspections, belt "
"tracking, and drive adjustments based on operating cycles to prevent costly "
"line stoppages.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Mentenanța transportoarelor:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">Efectuăm inspecții programate, "
"reglăm alinierea benzilor și ajustăm acționările în funcție de ciclurile de "
"operare, prevenind opririle costisitoare ale liniei.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor reliability engineering:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">We analyze belt wear, splice "
"failures, and bottleneck points to implement targeted modifications that "
"extend conveyor lifespan.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Ingineria fiabilității transportoarelor:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Analizăm uzura "
"benzilor, defectarea îmbinărilor și punctele de blocaj pentru a implementa "
"modificări precise care prelungesc durata de viață a transportoarelor.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor system modernization:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">We upgrade legacy conveyor "
"controls and obsolete drive systems to boost efficiency and reliability with "
"minimal operational downtime.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Modernizarea sistemelor de transportoare:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Modernizăm "
"comenzile vechi și sistemele de acționare depășite pentru a crește eficiența "
"și fiabilitatea, cu întreruperi minime ale activității.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Custom conveyor automation:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">Custom automation powered by high-"
"performance PLCs, HMIs, and SCADA delivering precise speed control, "
"tracking, and sorting for seamless conveyor operation.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Automatizare personalizată a "
"transportoarelor:</strong></span> <span style=\"color: rgb(89, 117, 145);\">"
"Automatizări personalizate cu PLC-uri, HMI-uri și sisteme SCADA performante, "
"pentru control precis al vitezei, urmărire și sortare, precum și "
"funcționarea fluentă a transportoarelor.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>On-site &amp;amp; Emergency support:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">We deliver fast technical "
"support, expert troubleshooting, and on-site servicing throughout your "
"system’s lifecycle to keep your lines running.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Asistență la fața locului și în regim de "
"urgență:</strong></span> <span style=\"color: rgb(89, 117, 145);\">Oferim "
"asistență tehnică promptă, diagnosticare specializată și service la fața "
"locului pe toată durata de viață a sistemului, pentru ca liniile tale să "
"funcționeze continuu.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>PLC &amp;amp; Control systems:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">We program reliable PLC systems "
"for conveyor lines, combining zero-pressure accumulation, motion control, "
"and intuitive HMIs to optimize material throughput</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>PLC-uri și sisteme de control:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">Programăm sisteme PLC fiabile "
"pentru liniile de transportoare, combinând acumularea fără presiune, "
"controlul mișcării și interfețe HMI intuitive pentru optimizarea debitului "
"de materiale</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Predictive conveyor monitoring:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">We use vibration, thermal, "
"and sensor data to detect roller wear and belt stretch early, fixing issues "
"before a breakdown occurs.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Monitorizare predictivă a transportoarelor:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Folosim date despre "
"vibrații, temperatură și senzori pentru a detecta din timp uzura rolelor și "
"întinderea benzilor și a remedia problemele înainte de avarie.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Robotic handling &amp;amp; Pick-and-place:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">We integrate robots "
"and cobots for automated sorting, loading, and palletizing, improving speed, "
"accuracy, and continuous product flow.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Manipulare robotică și preluare-plasare:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Integrăm roboți și "
"coboti pentru sortare, încărcare și paletizare automate, sporind viteza și "
"precizia și asigurând fluxul continuu al produselor.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>System integration &amp;amp; Connectivity:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Seamless Industry "
"4.0 integration with robotic cells, packaging stations, AS/RS, and smart "
"sensors for a unified material handling ecosystem.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Integrarea și conectivitatea sistemelor:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Integrare fluentă "
"în ecosistemul Industriei 4.0, cu celule robotizate, stații de ambalare, "
"sisteme automate de depozitare și senzori inteligenți pentru gestionarea "
"unitară a materialelor.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Technical consultancy:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">Full-service feasibility studies and "
"safety audits (CE/OSHA compliance, e-stops, risk assessments) to guarantee "
"maximum operational safety and compliance.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Consultanță tehnică:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">Studii de fezabilitate complete și "
"audituri de siguranță (conformitate CE/OSHA, opriri de urgență, evaluări de "
"risc) pentru a asigura siguranță și conformitate operațională maxime.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Apply the recurring fee from the Subscription app to "
"the maintenance agreement invoice</span> <br/>"
msgstr ""
"<span class=\"h6-fs\">Aplică taxa recurentă din aplicația Abonamente la "
"factura contractului de mentenanță</span> <br/>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_about_us
msgid ""
"<span class=\"h6-fs\">From custom conveyor design and belt fabrication to "
"installation and commissioning, we deliver material handling solutions built "
"for demanding industrial environments.</span>\n"
"                                            <br/>"
msgstr ""
"<span class=\"h6-fs\">De la proiectarea personalizată a transportoarelor și "
"fabricarea benzilor până la instalare și punere în funcțiune, oferim soluții "
"de manipulare a materialelor pentru medii industriale solicitante.</span>\n"
"                                            <br/>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
