#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.homepage
msgid "<a href=\"#\" class=\"btn o_translate_inline btn-primary\">Discover more</a>"
msgstr ""
"<a href=\"#\" class=\"btn o_translate_inline btn-primary\">Saiba mais</a>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">CRM:</font></b> Manage your customer "
"relationships and pipelines."
msgstr ""
"<b><font class=\"text-o-color-1\">CRM:</font></b> Gerencie seus "
"relacionamentos com clientes e seus funis de vendas."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Project:</font></b> Build your project "
"foundation for prototyping and reuse it for all subsequent stages."
msgstr ""
"<b><font class=\"text-o-color-1\">Projeto:</font></b> Crie a base do seu "
"projeto para a prototipagem e reutilize-a em todas as etapas subsequentes."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Purchase:</font></b> Track supplier orders"
" and manage your entire procurement history."
msgstr ""
"<b><font class=\"text-o-color-1\">Compras:</font></b> Acompanhe os pedidos "
"dos fornecedores e gerencie todo o seu histórico de aquisição."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Audit Trail:</b> Keep every modification visible to ensure full "
"transparency throughout the product's development cycle."
msgstr ""
"<b>Histórico de alterações:</b> Mantenha todas as modificações visíveis para "
"garantir total transparência ao longo do ciclo de desenvolvimento do produto."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Automated MTO (Make to Order):</b> Enable the <b>MTO route</b> on semi-"
"finished products. This automatically triggers a linked secondary MO the "
"moment the main manufacturing order is confirmed."
msgstr ""
"<b>MTO (Fabricação sob Encomenda) automatizada:</b> Ative a rota de MTO “ <b>"
"”</b> em produtos semiacabados. Isso aciona automaticamente uma ordem de "
"fabricação secundária vinculada no momento em que a ordem de fabricação "
"principal for confirmada."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>BOM Integration:</b> If your project requires multiple Bills of Materials"
" (BOMs), create them directly using the dedicated BOM button."
msgstr ""
"<b>Integração com a Lista de Materiais (LM):</b> Se o seu projeto exigir "
"várias Listas de Materiais, crie-as diretamente usando o botão dedicado à LM."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid "<b>Batch Sizes:</b> Optimize production runs."
msgstr "<b>Tamanhos de lote:</b> Otimize as execuções de produção."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>By-Products:</b> Manage secondary outputs during the manufacturing "
"process."
msgstr "<b>Subprodutos:</b> Gerenciar saídas secundárias durante a Fabricação."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>By-products:</b> Manage leftovers from production and track them as "
"valuable inventory."
msgstr ""
"<b>Subprodutos:</b> Gerencie as sobras da produção e rastreie-as como "
"estoque valorável."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Centralized Hub:</b> Use the top menu to navigate effortlessly between "
"all elements linked to your project."
msgstr ""
"<b>Central de recursos:</b> Use o menu superior para navegar facilmente "
"entre todos os elementos vinculados aos Projetos."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Centralized Updates:</b> Manage all changes and approvals within a "
"single, dedicated interface."
msgstr ""
"<b>Atualizações centralizadas:</b> Gerencie todas as alterações e aprovações "
"em uma única interface dedicada."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Client Collaboration:</b> Share specific folders with your clients, "
"providing them with a secure, central location to upload and access vital "
"project files."
msgstr ""
"<b>Colaboração com o cliente:</b> Compartilhe pastas específicas com seus "
"clientes, oferecendo a eles um local central e seguro para enviar e acessar "
"arquivos essenciais dos projetos."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Definition:</b> All billable, non-tangible offerings provided to the "
"client."
msgstr ""
"<b>Definição:</b> Todos os serviços faturáveis e intangíveis prestados ao "
"cliente."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Definition:</b> All components and materials sourced directly from "
"external vendors."
msgstr ""
"<b>Definição:</b> Todos os componentes e materiais são adquiridos "
"diretamente de fornecedores externos."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Definition:</b> In-house manufactured items used as sub-assemblies for "
"larger builds rather than being sold individually."
msgstr ""
"<b>Definição:</b> Itens de fabração interna, utilizados como subconjuntos "
"para montagens maiores, em vez de serem vendidos individualmente."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Definition:</b> Sale-ready goods ranging from standardized items (fixed "
"BOMs) to fully customized solutions."
msgstr ""
"<b>Definição:</b> Produtos prontos para vendas, que vão desde itens "
"padronizados (listas de materiais fixas) até soluções totalmente "
"personalizadas."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Detailed Work Orders:</b> For every operation, you can define precise "
"timings, step-by-step instructions, and mandatory <b>Quality Checks</b>."
msgstr ""
"<b>Ordens de trabalho detalhadas:</b> Para cada operação, você pode definir "
"tempos precisos, instruções passo a passo e <b>verificações de qualidade</b> "
"obrigatórias ."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Direct Manufacturing:</b> Launch Manufacturing Orders (MOs) from the "
"Manufacturing tab. Once confirmed, these will flow into your standard "
"manufacturing workflow. (see next section)"
msgstr ""
"<b>Fabricação direta:</b> Inicie as ordens de fabricação (MOs) na aba“"
"Fabricação”. Uma vez confirmadas, elas seguirão para o seu fluxo de trabalho "
"padrão de fabricação. (veja a próxima seção)"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Easy Billing:</b> Generate a <b>Sales Order</b> directly from the repair "
"order to invoice your client for parts and labor."
msgstr ""
"<b>Faturamento Fácil:</b> Gere um <b>pedido de venda</b> diretamente a "
"partir do pedido de reparo para faturar seu cliente pelas peças e pela mão "
"de obra."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Either create a project :</b> From the CRM, create a new project by "
"clicking the <b>⚙️ icon</b> and selecting a template. This project will "
"allow you to manage all the pre-sales steps, such as:"
msgstr ""
"<b>Crie um projeto:</b> No CRM, crie um novo projeto clicando no ícone <b>"
"⚙️</b> e selecionando um modelo. Esse projeto permitirá que você gerencie "
"todas as etapas de pré-venda, tais como:"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Either you create a Quotation from the opportunity and wait for a "
"confirmation.</b>"
msgstr ""
"<b>Você pode criar uma cotação a partir da oportunidade e aguardar uma "
"confirmação.</b>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Engineering Review:</b> This proposal automatically generates an "
"<b>ECO</b> in the PLM app. Engineers can then review, test, and approve the "
"change before it is officially applied to the Bill of Materials."
msgstr ""
"<b>Revisão de engenharia:</b> Esta proposta gera automaticamente uma<b> ECO</"
"b> no aplicativo PLM. Os engenheiros podem então revisar, testar e aprovar a "
"alteração antes que ela seja oficialmente aplicada à lista de materiais."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Financial Forecasting &amp; Actuals:</b> Compare estimated costs against "
"real costs directly from the project overview to maintain control over your "
"budget."
msgstr ""
"<b>Projeções financeiras &amp; Dados reais:</b> Compare os custos estimados "
"com os custos reais diretamente na visão geral do projeto para manter o "
"controle sobre seu orçamento."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Flexible Timesheets:</b> Log time on individual tasks to monitor project "
"profitability or accurately bill clients for hours worked."
msgstr ""
"<b>Planilhas de Horas flexíveis:</b> Registre o tempo gasto em tarefas "
"individuais para monitorar a rentabilidade dos projetos ou faturar com "
"precisão aos clientes pelas horas trabalhadas."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>For example:</b> A client requests a specialized scanner capable of "
"multilingual package recognition. Within a single project, you can "
"centralize product specifications, vendor quotes, and BOM designs. You can "
"then generate an initial quotation for a <b>Proof of Concept (PoC)</b> "
"directly from the project. Once confirmed, you can continue iterating within"
" the same project—creating updated quotations and Manufacturing Orders by "
"building on previous data and new insights."
msgstr ""
"<b>Por exemplo:</b> Um cliente solicita um scanner especializado capaz de "
"reconhecer embalagens em vários idiomas. Em um único projeto, você pode "
"centralizar especificações de produtos, cotações de fornecedores e projetos "
"de listas de materiais (LM). Em seguida, é possível gerar uma cotação "
"inicial para uma Prova de Conceito (PoC) do <b></b> diretamente a partir do "
"projeto. Uma vez confirmada, você pode continuar iterando dentro do mesmo "
"projeto — criando cotações atualizadas e Ordens de Fabricação com base em "
"dados anteriores e novos insights."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Invoice Oversight:</b> Track all related outgoing and incoming invoices "
"directly within the project interface."
msgstr ""
"<b>Controle de faturas:</b> Acompanhe todas as faturas emitidas e recebidas "
"diretamente na interface dos Projetos."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid "<b>Key Benefits:</b>"
msgstr "<b>Principais benefícios:</b>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>MTO (Make-to-Order) Route:</b> Use this to automatically trigger a "
"Manufacturing Order whenever a Sales Order is confirmed"
msgstr ""
"<b>Rota MTO (Make-to-Order):</b> Use isso para acionar automaticamente uma "
"Ordem de Fabricação sempre que um Pedido de venda for confirmado"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Make to Stock (Reordering Rules):</b> Set a <b>minimum stock level</b> "
"for your sub-assemblies. The system will automatically trigger a new MO once"
" your inventory drops below this threshold, ensuring you always have enough "
"stock on hand for future production."
msgstr ""
"<b>Produção para estoque (regras de reposição):</b> Defina um <b>nível "
"mínimo de estoque</b> para seus subconjuntos. O sistema acionará "
"automaticamente uma nova ordem de produção (MO) assim que seu inventário "
"ficar abaixo desse limite, garantindo que você sempre tenha estoque "
"suficiente disponível para a produção futura."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Manual Creation:</b> Generate secondary MOs for sub-assemblies manually "
"as the need arises."
msgstr ""
"<b>Criação manual:</b> Gere MOs secundários para subconjuntos manualmente, "
"conforme a necessidade."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Miscellaneous Notes &amp; Integration:</b> Use the HTML field (note) in "
"the <b>Miscellaneous tab</b> for advanced instructions. You can embed links "
"to internal knowledge articles, 3D plans, or external software. Operators "
"can access these links directly from the <b>Shopfloor App</b> during "
"production."
msgstr ""
"<b>Notas diversas e integração&amp;:</b> Use o campo HTML (nota) na aba“"
"Diversos” (Miscellaneous) do <b></b> para obter instruções avançadas. Você "
"pode incorporar links para artigos de conhecimento internos, plantas 3D ou "
"softwares externos. Os operadores podem acessar esses links diretamente pelo "
"aplicativo de <b>Chão de Fábrica </b> durante a produção."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Monitor Progress:</b> Visit the <b>Overview Tab</b> to see a side-by-side"
" comparison of your sales, expected costs, and real costs (derived from "
"invoices and completed Manufacturing Orders)."
msgstr ""
"<b>Acompanhe o progresso:</b> Acesse a aba <b>Visão geral</b> para ver uma "
"comparação lado a lado entre suas vendas, custos esperados e custos reais "
"(derivados de notas fiscais e ordens de produção concluídas)."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Note:</b> If you validate a transfer for a partial quantity, the system "
"will automatically create a <b>backorder</b> for the rest of the items."
msgstr ""
"<b>Observação:</b> Se você validar uma transferência para uma quantidade "
"parcial, o sistema criará automaticamente um <b>pedido em espera</b> para o "
"restante dos itens."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Organized File Sharing:</b> Create custom folders (such as \"Internal\" "
"or \"Client-Facing\") via the Documents button."
msgstr ""
"<b>Compartilhamento organizado de arquivos:</b> Crie pastas personalizadas "
"(como “Interno” ou “Para o cliente”) por meio do botão “Documentos”."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid "<b>Pro Tip: Real-Time Margin Analysis</b>"
msgstr "<b>Dica profissional: Análise de margem em tempo real</b>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Pro-Tip:</b> You can print and use barcode commands with a scanner to "
"automate and streamline your workflow."
msgstr ""
"<b>Dica de especialista:</b> Você pode imprimir e usar comandos de código de "
"barras com um scanner para automatizar e otimizar seu fluxo de trabalho."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Proactive Quality Checks:</b> These are predefined checks (created in the"
" Quality App) that trigger automatically at specific stages of production."
msgstr ""
"<b>Verificações proativas de qualidade:</b> Trata-se de verificações "
"predefinidas (criadas no aplicativo Qualidade) que são acionadas "
"automaticamente em etapas específicas da produção."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Propose BOM Updates:</b> If a worker discovers a more efficient method or"
" a necessary adjustment, they can propose adding a new step or component."
msgstr ""
"<b>Propor atualizações da lista de materiais (LM):</b> Se um funcionário "
"descobrir um método mais eficiente ou um ajuste necessário, ele pode propor "
"a adição de uma nova etapa ou componente."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Protocol:</b> Develop detailed <b>Bills of Materials (BOMs)</b> that "
"explicitly link components to their respective production stages and "
"operations."
msgstr ""
"<b>Protocolo:</b> Elabore listas de materiais (LMs) detalhadas <b></b> que "
"vinculem explicitamente os componentes às respectivas etapas de produção e "
"operações."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Protocol:</b> For new clients or projects, create a <b>unique product "
"entry</b>. Map these to a <b>Master BOM Catalog</b> to pull in reusable "
"templates; this allows for distinct database tracking while leveraging "
"standardized production logic."
msgstr ""
"<b>Protocolo:</b> Para novos clientes ou projetos, crie uma <b>entrada de "
"produto exclusiva </b> . Mapeie-as para um <b>Catálogo Mestre de Listas de "
"Materiais</b> para utilizar modelos reutilizáveis; isso permite um "
"rastreamento diferenciado na base de dados, ao mesmo tempo em que aproveita "
"a lógica de produção padronizada."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Protocol:</b> Maintain up-to-date <b>vendor assignments</b> and "
"<b>purchase pricing</b> to ensure procurement accuracy."
msgstr ""
"<b>Protocolo:</b> Mantenha atualizadas as atribuições de fornecedores <b>, "
"as atribuições de fornecedores</b> e os <b>preços de compras </b> para "
"garantir a precisão da aquisição."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Reactive Quality Alerts:</b> If a worker identifies an issue on the fly, "
"they can trigger a <b>Quality Alert</b>. This creates a dedicated task in "
"the Quality App for the quality team to investigate."
msgstr ""
"<b>Alertas de qualidade reativos:</b> Se um colaborador identificar um "
"problema em tempo real, ele pode acionar um <b>Alerta de Qualidade</b>. Isso "
"cria uma tarefa dedicada no aplicativo de qualidade para que a equipe de "
"qualidade investigue."

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
msgid ""
"<b>Sales &amp; Purchase Orders:</b> Generate unlimited Sales Orders to "
"account for scope changes, and manage all project-specific Purchase Orders "
"in one place."
msgstr ""
