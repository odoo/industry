#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor analytics:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">Our conveyor systems are designed to "
"integrate seamlessly into your Manufacturing Execution Systems (MES). "
"Equipped with smart sensors and open communication protocols.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Análise de transportadores:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">Nossos sistemas de transportadores "
"são projetados para se integrar perfeitamente aos seus Sistemas de Execução "
"de Fabricação (MES). Equipados com sensores inteligentes e protocolos de "
"comunicação abertos.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor asset management:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">We streamline spare parts "
"inventory, belt replacement schedules, and service workflows to maximize "
"uptime while reducing maintenance costs.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Gestão de ativos de transportadores:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">Otimizamos o inventário de "
"peças de reposição, cronogramas de substituição de correias e fluxos de "
"serviço para maximizar o tempo de atividade, reduzindo custos de "
"manutenção.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor automation:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">We automate manual sorting and "
"conveyance using smart sensors, pneumatic diverters, and VFDs to ensure "
"precise material tracking and routing.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Automação de transportadores:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">Automatizamos a triagem e o "
"transporte manual usando sensores inteligentes, desviadores pneumáticos e "
"VFDs para garantir rastreamento e roteamento precisos de materiais.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor control panels:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">We design and build custom control "
"cabinets optimized for conveyor systems, ensuring robust power distribution "
"and seamless fieldbus integration.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Painéis de controle de transportadores:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Projetamos e "
"construímos painéis de controle personalizados otimizados para sistemas de "
"transporte, garantindo uma distribuição de energia robusta e integração de "
"fieldbus contínua.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor line optimization:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">Workflow analysis to eliminate "
"bottlenecks, jams, and buffering issues, boosting throughput while reducing "
"belt wear, downtime, and energy costs.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Otimização de linha de transporte:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">Análise de fluxo de trabalho "
"para eliminar gargalos, travamentos e problemas de armazenamento, aumentando "
"a produtividade e reduzindo o desgaste da correia, tempo de inatividade e "
"custos de energia.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor maintenance:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">We execute scheduled inspections, belt "
"tracking, and drive adjustments based on operating cycles to prevent costly "
"line stoppages.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Manutenção de transportadores:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">Executamos inspeções agendadas, "
"rastreamento de correias e ajustes de acionamento com base nos ciclos "
"operacionais para evitar paradas de linha dispendiosas.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor reliability engineering:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">We analyze belt wear, splice "
"failures, and bottleneck points to implement targeted modifications that "
"extend conveyor lifespan.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Engenharia de confiabilidade de "
"transportadores:</strong></span> <span style=\"color: rgb(89, 117, 145);\">"
"Analisamos o desgaste da correia, falhas de emenda e pontos de gargalo para "
"implementar modificações direcionadas que prolongam a vida útil do "
"transportador.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Conveyor system modernization:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">We upgrade legacy conveyor "
"controls and obsolete drive systems to boost efficiency and reliability with "
"minimal operational downtime.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Modernização do sistema de transporte:</strong>"
"</span> <span style=\"color: rgb(89, 117, 145);\">Atualizamos controles de "
"transportadores legados e sistemas de acionamento obsoletos para aumentar a "
"eficiência e a confiabilidade com o mínimo de tempo de inatividade "
"operacional.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Custom conveyor automation:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">Custom automation powered by high-"
"performance PLCs, HMIs, and SCADA delivering precise speed control, "
"tracking, and sorting for seamless conveyor operation.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Automação personalizada de transportadores:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Automação "
"personalizada alimentada por CLPs, IHMs e SCADA de alto desempenho, "
"proporcionando controle de velocidade, rastreamento e triagem precisos para "
"uma operação de transporte contínua.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>On-site &amp;amp; Emergency support:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">We deliver fast technical "
"support, expert troubleshooting, and on-site servicing throughout your "
"system’s lifecycle to keep your lines running.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Suporte de emergência &amp;amp; no local:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Oferecemos suporte "
"técnico rápido, resolução de problemas por especialistas e manutenção no "
"local durante todo o ciclo de vida do seu sistema para manter suas linhas em "
"funcionamento.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>PLC &amp;amp; Control systems:</strong></span> "
"<span style=\"color: rgb(89, 117, 145);\">We program reliable PLC systems "
"for conveyor lines, combining zero-pressure accumulation, motion control, "
"and intuitive HMIs to optimize material throughput</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Sistemas de controle &amp;amp; CLP:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">Programamos sistemas CLP "
"confiáveis para linhas de transporte, combinando acumulação de pressão zero, "
"controle de movimento e IHMs intuitivas para otimizar a produtividade do "
"material</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Predictive conveyor monitoring:</strong></"
"span> <span style=\"color: rgb(89, 117, 145);\">We use vibration, thermal, "
"and sensor data to detect roller wear and belt stretch early, fixing issues "
"before a breakdown occurs.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Monitoramento preditivo de transportadores:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Usamos dados de "
"vibração, térmicos e de sensores para detectar o desgaste dos rolos e o "
"estiramento da correia precocemente, corrigindo problemas antes que ocorra "
"uma falha.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Robotic handling &amp;amp; Pick-and-place:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">We integrate robots "
"and cobots for automated sorting, loading, and palletizing, improving speed, "
"accuracy, and continuous product flow.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Manuseio robótico &amp;amp; Pick-and-place:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Integramos robôs e "
"cobots para triagem, carregamento e paletização automatizados, melhorando a "
"velocidade, a precisão e o fluxo contínuo de produtos.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>System integration &amp;amp; Connectivity:</"
"strong></span> <span style=\"color: rgb(89, 117, 145);\">Seamless Industry "
"4.0 integration with robotic cells, packaging stations, AS/RS, and smart "
"sensors for a unified material handling ecosystem.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Integração de sistemas &amp;amp; "
"Conectividade:</strong></span> <span style=\"color: rgb(89, 117, 145);\">"
"Integração perfeita da Indústria 4.0 com células robóticas, estações de "
"embalagem, AS/RS e sensores inteligentes para um ecossistema unificado de "
"manuseio de materiais.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.view_page_our_solutions
msgid ""
"<span class=\"h6-fs\"><strong>Technical consultancy:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">Full-service feasibility studies and "
"safety audits (CE/OSHA compliance, e-stops, risk assessments) to guarantee "
"maximum operational safety and compliance.</span>"
msgstr ""
"<span class=\"h6-fs\"><strong>Consultoria técnica:</strong></span> <span "
"style=\"color: rgb(89, 117, 145);\">Estudos de viabilidade e auditorias de "
"segurança (conformidade CE/OSHA, paradas de emergência, avaliações de risco) "
"de serviço completo para garantir máxima segurança e conformidade "
"operacional.</span>"

#. module: custom_industrial_equipment
#: model_terms:ir.ui.view,arch_db:custom_industrial_equipment.welcome_article_body
#, fuzzy
msgid ""
"<span class=\"h6-fs\">Apply the recurring fee from the Subscription app to "
