<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true"> Copyright © <t t-out="company.name"/> </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-outline-secondary">Contact</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="option_footer_scrolltop" model="ir.ui.view">
        <field name="name">Custom - option_footer_scrolltop</field>
        <field name="key">website.option_footer_scrolltop</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="after">
                <div id="o_footer_scrolltop_wrapper" class="container h-0 d-flex align-items-center justify-content-center">
                    <a id="o_footer_scrolltop" role="button" href="#top" title="Scroll To Top" class="d-flex align-items-center justify-content-center btn btn-custom bg-o-color-2 text-o-color-1" style="border: 0px solid rgb(255, 255, 255);">
                        <span class="oi" data-icon="keyboard_arrow_up"/>
                    </a>
                </div>
            </xpath>
        </field>
    </record>
    <record id="template_footer_mega" model="ir.ui.view">
        <field name="name">Custom - Mega</field>
        <field name="key">website.template_footer_mega</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt48 pb0" data-snippet="s_text_block" data-name="Top Part">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-2 order-lg-0 pb24 o_colored_level" style="order: 0;">
                                    <h5>Navigation</h5>
                                    <div class="s_hr pb32 o_colored_level pt0" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                    <ul class="list-unstyled">
                                        <li>
                                            <a class="o_translate_inline" href="/">Home</a>
                                        </li>
                                        <li>
                                            <a href="/services" class="o_translate_inline">Our Solutions</a>
                                        </li>
                                        <li>
                                            <a href="/about-us" class="o_translate_inline">About us</a>
                                        </li>
                                        <li>
                                            <a href="/contactus" class="o_translate_inline">Contact</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-lg-2 order-lg-0 pb24 o_colored_level" style="order: 1;">
                                    <h5>Services</h5>
                                    <div class="s_hr pb32 o_colored_level pt0" data-snippet="s_hr" data-name="Separator">
                                        <hr class="mx-auto w-100"/>
                                    </div>
                                    <ul class="list-unstyled">
                                        <li>
                                            <a href="/services#our-solutions" class="o_translate_inline">Engineering</a>
                                        </li>
                                        <li>
                                            <a href="/services#our-solutions" class="o_translate_inline">Automation</a>
                                        </li>
                                        <li>
                                            <a href="/services#our-solutions" class="o_translate_inline">MES &amp;amp; Data</a>
                                        </li>
                                        <li>
                                            <a href="/services#our-solutions" class="o_translate_inline">Maintenance</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="order-lg-0 pb24 o_colored_level col-lg-4" style="order: 2;">
                                    <h5>Contact</h5>
                                    <div class="s_hr pb32 o_colored_level pt0" data-snippet="s_hr" data-name="Separator">
                                        <hr class="mx-auto w-100"/>
                                    </div>
                                    <ul class="list-unstyled">
                                        <li>
                                            <img src="/web/image/custom_industrial_equipment.img_custom_industrial_equipment_image_50" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="padding: 5px;" loading="lazy"/><a href="mailto:info@mecora.example.com">info@mecora.example.com</a>
                                        </li>
                                        <li>
                                            <img src="/web/image/custom_industrial_equipment.img_custom_industrial_equipment_image_51" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="padding: 5px;" loading="lazy"/><a href="tel:003281813700" class="o_translate_inline">+32 81 81 37 00</a>
                                        </li>
                                        <li><img src="/web/image/custom_industrial_equipment.img_custom_industrial_equipment_image_52" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" style="padding: 5px;" loading="lazy"/>Rue des Bourlottes 9, 1367 Grand-Rosière-Hottomont</li>
                                    </ul>
                                </div>
                                <div class="order-lg-0 pt16 pb24 o_colored_level o-float-start-parent offset-lg-1 col-lg-3 col-11" style="order: 3;">
                                    <img src="/web/image/custom_industrial_equipment.img_custom_industrial_equipment_image_53" alt="" class="img-fluid float-start me-auto img o_we_custom_image o_attachment_pending_record_id" srcset="/web/image/custom_industrial_equipment.img_custom_industrial_equipment_image_53 750w, /web/image/custom_industrial_equipment.img_custom_industrial_equipment_image_53 900w, /web/image/custom_industrial_equipment.img_custom_industrial_equipment_image_53 1080w, /web/image/custom_industrial_equipment.img_custom_industrial_equipment_image_53 1280w, /web/image/custom_industrial_equipment.img_custom_industrial_equipment_image_53 1565w" loading="lazy"/><br/>
                                    <span style="font-size: 15px;">
                                        <br/><br/><br/>
                                        <strong>Your <span class="text-o-color-2">conveyor systems</span> for industry 4.0</strong>
                                    </span>
                                </div>
                                <div class="col-lg-12 order-lg-0 o_colored_level d-lg-block d-none o_snippet_mobile_invisible" style="order: 4;" data-invisible="1">
                                    <div class="s_hr pb24 d-lg-block d-none o_snippet_mobile_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="col-lg-12 order-lg-0 o_colored_level d-lg-block d-none o_snippet_mobile_invisible" style="order: 5;" data-invisible="1">
                                    <p>
                                        <span class="h4-fs">
                                            <b>
                                                <span class="text-o-color-4">Conveyor Engineering </span><span class="text-o-color-2">&amp;amp; Automation Solutions</span>
                                            </b>
                                        </span>
                                        <br/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_text_block o_footer_bottom_part pb8 o_colored_level pt0" style="position: relative; background-color: rgba(0, 0, 0, 0.05);" data-snippet="s_text_block" data-name="Bottom Part">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-6 pt8 pb8 o_colored_level">
                                    <div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <p class="s_social_media_title d-none">Follow us</p>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank">
                                            <i class="oi oi-stack o_editable_media text-o-color-2" data-icon="oi_x"/>
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank">
                                            <i class="oi oi-stack o_editable_media text-o-color-2" data-icon="oi_linkedin"/>
                                        </a>
                                        <a href="https://www.youtube.com/your-page" class="s_social_media_youtube" target="_blank">
                                            <i class="oi oi-stack o_editable_media text-o-color-2" data-icon="oi_youtube-play"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-6 pt8 pb8 o_colored_level">
                                    <nav class="nav justify-content-lg-end flex-column flex-lg-row">
                                        <a class="nav-link" href="#">Terms and Conditions</a>
                                        <a class="nav-link" href="#">Privacy Policy</a>
                                        <a class="nav-link" href="#">Cookies</a>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
            <xpath expr="//t[@t-call='web.brand_promotion']/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
