#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"<span class=\"display-4-fs\"><strong>Odoo for Personal Trainer</strong></"
"span>"
msgstr ""
"<span class=\"display-4-fs\"><strong>Odoo ສຳລັບຄູເຝິກສ່ວນຕົວ</strong></span>"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"<strong>Configure Appointment Types</strong>: In the Appointment app, create "
"types that match your services."
msgstr ""
"<strong>ກຳນົດຄ່າປະເພດການນັດໝາຍ</strong>: ໃນແອັບການນັດໝາຍ, ສ້າງປະເພດທີ່ກົງກັບການບໍລິການຂອງ"
"ທ່ານ."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"<strong>Create Client Profiles</strong>: As you get inquiries, add them to "
"your CRM and Contacts."
msgstr ""
"<strong>ສ້າງໂປຣໄຟລ໌ລູກຄ້າ</strong>: ເມື່ອໄດ້ຮັບການສອບຖາມຂໍ້ມູນ, ໃຫ້ເພີ່ມພວກເຂົາເຂົ້າໃນ CRM ແລ"
"ະ ລາຍຊື່ຜູ້ຕິດຕໍ່ຂອງທ່ານ."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"<strong>Invoice Your Clients</strong>: Use the Invoicing app to bill clients "
"for completed services."
msgstr ""
"<strong>ອອກໃບຮຽກເກັບເງິນໃຫ້ລູກຄ້າ</strong>: ໃຊ້ແອັບການອອກໃບຮຽກເກັບເງິນເພື່ອຮຽກເກັບເງິນລູກຄ້າ"
"ສຳລັບການບໍລິການທີ່ສຳເລັດແລ້ວ."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"<strong>Manage Your Calendar</strong>: Use the Calendar app to block off "
"your availability and personal time."
msgstr ""
"<strong>ຈັດການປະຕິທິນຂອງທ່ານ</strong>: ໃຊ້ແອັບປະຕິທິນເພື່ອກຳນົດເວລາຫວ່າງ ແລະ ເວລາສ່ວນຕົວຂອງ"
"ທ່ານ."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"<strong>Set Up Your Services</strong>: Navigate to Sales &gt; Products and "
"set up your coaching services."
msgstr ""
"<strong>ຕັ້ງຄ່າການບໍລິການຂອງທ່ານ</strong>: ໄປທີ່ ການຂາຍ &gt; ສິນຄ້າ ແລະ ຕັ້ງຄ່າການບໍລິການຝຶກສ"
"ອນຂອງທ່ານ."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"<strong>Start Tracking Projects</strong>: For services that require ongoing "
"management, create a project in the Project app."
msgstr ""
"<strong>ເລີ່ມຕິດຕາມໂຄງການ</strong>: ສຳລັບການບໍລິການທີ່ຕ້ອງການການຄຸ້ມຄອງຢ່າງຕໍ່ເນື່ອງ, ໃຫ້ສ້າງໂຄ"
"ງການຂຶ້ນໃນແອັບໂຄງການ."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Appointment Scheduling 📆"
msgstr "ການຈັດຕາຕະລາງນັດໝາຍ 📆"

#. module: personal_trainer
#: model:crm.stage,name:personal_trainer.stage_lead2
msgid "Assessment"
msgstr "ການປະເມີນ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Basics"
msgstr "ພື້ນຖານ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Client Management (CRM) 🎯"
msgstr "ການຈັດການລູກຄ້າ (CRM) 🎯"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Collaborate with clients on their goals"
msgstr "ຮ່ວມມືກັບລູກຄ້າກ່ຽວກັບເປົ້າໝາຍຂອງພວກເຂົາ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Convert leads into clients"
msgstr "ປ່ຽນລູກຄ້າຄາດຫວັງໃຫ້ເປັນລູກຄ້າຕົວຈິງ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"Create a stunning <strong>Website</strong> to showcase your coaching "
"services and allow clients to book sessions online."
msgstr ""
"ສ້າງ <strong>ເວັບໄຊທ໌</strong> ທີ່ສວຍງາມເພື່ອສະແດງການບໍລິການຝຶກສອນຂອງທ່ານ ແລະ ອະນຸຍາດໃຫ້ລູກ"
"ຄ້າຈອງຊົ່ວໂມງຮຽນຜ່ານທາງອອນລາຍ."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Create and manage your coaching services:"
msgstr "ສ້າງ ແລະ ຈັດການການບໍລິການຝຶກສອນຂອງທ່ານ:"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Create tasks for each stage of a client's journey"
msgstr "ສ້າງໜ້າວຽກສຳລັບແຕ່ລະຂັ້ນຕອນຂອງເສັ້ນທາງລູກຄ້າ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Define pricing and project tracking needs for each service"
msgstr "ກຳນົດລາຄາ ແລະ ຄວາມຕ້ອງການໃນການຕິດຕາມໂຄງການສຳລັບແຕ່ລະການບໍລິການ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Define your availability"
msgstr "ກຳນົດເວລາຫວ່າງຂອງທ່ານ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"Develop and sell online fitness courses with the <strong>eLearning</strong> "
"platform, expanding your reach beyond in-person training."
msgstr ""
"ພັດທະນາ ແລະ ຂາຍຄອສອອກກຳລັງກາຍອອນລາຍດ້ວຍແພລດຟອມ <strong>eLearning</strong>, ເພື່ອຂະ"
"ຫຍາຍການເຂົ້າເຖິງຂອງທ່ານໃຫ້ນອກເໜືອຈາກການຝຶກສອນຕົວຈິງ."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Do you want to go further?"
msgstr "ທ່ານຕ້ອງການຕໍ່ຍອດຕື່ມອີກບໍ່?"

#. module: personal_trainer
#: model:project.task.type,name:personal_trainer.project_task_type_12
msgid "Done"
msgstr "ສຳເລັດ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Easily bill clients for your services:"
msgstr "ຮຽກເກັບເງິນຄ່າບໍລິການຈາກລູກຄ້າໄດ້ຢ່າງງ່າຍດາຍ:"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"Encourage clients to book through your Appointment page to reduce scheduling "
"back-and-forth."
msgstr ""
"ແນະນຳໃຫ້ລູກຄ້າຈອງຜ່ານໜ້າການນັດໝາຍຂອງທ່ານເພື່ອຫຼຸດຜ່ອນຄວາມຫຍຸ້ງຍາກໃນການນັດເວລາໄປມາ."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"Engage clients with targeted campaigns using <strong>Email Marketing</"
"strong> and <strong>Social Marketing</strong>."
msgstr ""
"ສ້າງການມີສ່ວນຮ່ວມກັບລູກຄ້າດ້ວຍແຄມເປນທີ່ກົງເປົ້າໝາຍໂດຍໃຊ້ <strong>ການຕະຫຼາດຜ່ານອີເມວ (Email "
"Marketing)</strong> ແລະ <strong>ການຕະຫຼາດຜ່ານສື່ສັງຄົມອອນລາຍ (Social Marketing)</"
"strong>."

#. module: personal_trainer
#: model:product.template,name:personal_trainer.product_product_11_product_template
msgid "Fitness Assessment"
msgstr "ການປະເມີນສະມັດຖະພາບຮ່າງກາຍ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Follow up on inquiries"
msgstr "ຕິດຕາມການສອບຖາມຂໍ້ມູນ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"Gather valuable client feedback and track progress effortlessly using "
"<strong>Surveys</strong>."
msgstr ""
"ຮວບຮວມຄຳຕິຊົມທີ່ມີຄຸນຄ່າຈາກລູກຄ້າ ແລະ ຕິດຕາມຄວາມຄືບໜ້າໄດ້ຢ່າງງ່າຍດາຍໂດຍໃຊ້ <strong>ແບບສຳຫຼວດ "
"(Surveys)</strong>."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Generate invoices automatically from sales orders"
msgstr "ສ້າງໃບຮຽກເກັບເງິນໂດຍອັດຕະໂນມັດຈາກໃບສັ່ງຂາຍ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Getting Started"
msgstr "ເລີ່ມຕົ້ນການນຳໃຊ້"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"If you want to push your quotation building much further and add all the "
"power of Spreadsheet beneath any line of your Sales Orders, use the quote "
"calculation feature."
msgstr ""
"ຖ້າທ່ານຕ້ອງການສ້າງໃບສະເໜີລາຄາໃຫ້ກ້າວໜ້າຂຶ້ນໄປອີກ ແລະ ດຶງປະສິດທິພາບຂອງຕາຕະລາງຄຳນວນ "
"(Spreadsheet) ມາໄວ້ໃຕ້ແຕ່ລະແຖວຂອງໃບສັ່ງຂາຍຂອງທ່ານ, ໃຫ້ໃຊ້ຄຸນສົມບັດການຄຳນວນໃບສະເໜີລາຄາ."

#. module: personal_trainer
#: model:crm.stage,name:personal_trainer.stage_lead1
msgid "Initial Contact"
msgstr "ການຕິດຕໍ່ເບື້ອງຕົ້ນ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Invoicing 🧾"
msgstr "ການອອກໃບຮຽກເກັບເງິນ 🧾"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Let clients book directly through your booking page"
msgstr "ໃຫ້ລູກຄ້າຈອງໂດຍກົງຜ່ານໜ້າການຈອງຂອງທ່ານ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Manage leads and opportunities"
msgstr "ຈັດການລູກຄ້າຄາດຫວັງ ແລະ ໂອກາດທາງການຂາຍ"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Manage your services 👟"
msgstr "ຈັດການການບໍລິການຂອງທ່ານ 👟"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"Manage your team of coaches and staff efficiently with <strong>Employees</"
"strong>."
msgstr ""
"ຈັດການທີມງານຄູເຝິກ ແລະ ພະນັກງານຂອງທ່ານຢ່າງມີປະສິດທິພາບດ້ວຍ <strong>ພະນັກງານ (Employees)</"
"strong>."

#. module: personal_trainer
#: model:crm.stage,name:personal_trainer.crm_stage_5
msgid "Negotiation"
msgstr "ການເຈລະຈາຕໍ່ລອງ"

#. module: personal_trainer
#: model:project.task.type,name:personal_trainer.project_task_type_9
msgid "New"
msgstr "ໃໝ່"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Odoo offers you infinite possibilities, such as:"
msgstr "Odoo ມອບຄວາມເປັນໄປໄດ້ຢ່າງຫຼວງຫຼາຍໃຫ້ທ່ານ, ເຊັ່ນ:"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"Organize group classes, workshops, and fitness events easily with the "
"<strong>Events</strong> app."
msgstr ""
"ຈັດຫ້ອງຮຽນກຸ່ມ, ກອງປະຊຸມສຳມະນາ ແລະ ກິດຈະກຳອອກກຳລັງກາຍໄດ້ຢ່າງງ່າຍດາຍດ້ວຍແອັບ <strong>ກິດຈະກ"
"ຳ (Events)</strong>."

#. module: personal_trainer
#: model:ir.module.module,shortdesc:base.module_personal_trainer
msgid "Personal Trainer"
