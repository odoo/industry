msgid ""
"These all go free in your current subscription; feel free to explore! 🙃"
msgstr "Vse to je brezplačno v vaši trenutni naročnini; kar raziščite! 🙃"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Tips for Success"
msgstr "Nasveti za uspeh"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"Track fitness equipment and sell merchandise through your integrated "
"<strong>eCommerce</strong> store."
msgstr ""
"Spremljajte fitnes opremo in prodajajte izdelke prek svoje integrirane "
"trgovine <strong>eCommerce</strong>."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Track payments and send reminders"
msgstr "Spremljajte plačila in pošiljajte opomnike"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Track potential and current clients:"
msgstr "Spremljajte potencialne in trenutne stranke:"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Track progress and set milestones"
msgstr "Spremljajte napredek in določite mejnike"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Use the Appointment app to allow clients to book sessions easily:"
msgstr ""
"Z aplikacijo za rezervacijo terminov lahko stranke preprosto rezervirajo "
"vadbe:"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Use the Project app to manage longer-term client programs:"
msgstr ""
"Uporabite aplikacijo Projekti za upravljanje dolgoročnejših programov za "
"stranke:"

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Use the project templates for standardized programs to save time."
msgstr ""
"Za prihranek časa uporabite projektne predloge za standardizirane programe."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid "Utilize the invoicing reminders to ensure timely payments."
msgstr ""
"Uporabite opomnike za izdajanje računov, da zagotovite pravočasna plačila."

#. module: personal_trainer
#: model_terms:ir.ui.view,arch_db:personal_trainer.welcome_article_body
msgid ""
"Welcome to your new Odoo Personal Trainer package! This guide will help you "
"navigate the key features and get your coaching business up and running "
"efficiently."
msgstr ""
"Dobrodošli v vašem novem paketu Odoo za osebnega trenerja! Ta vodnik vam bo "
"pomagal spoznati ključne funkcije in učinkovito zagnati vaše trenersko "
"poslovanje."

