msgid "<span class=\"o_small-fs text-600\">Sales Director</span>"
msgstr "<span class=\"o_small-fs text-600\">Verkoopverantwoordelijke</span>"

#. module: electronic_refurbishment
#: model_terms:ir.ui.view,arch_db:electronic_refurbishment.view_page_our_company
msgid ""
"<span class=\"o_small-fs text-600\">You have 30 days to change your mind, no "
"questions asked. Free returns and a full refund within 5 business days. "
"That's our promise.</span>"
msgstr ""
"<span class=\"o_small-fs text-600\">Je hebt 30 dagen bedenktijd, zonder "
"vragen. Gratis retourneren en een volledige terugbetaling binnen 5 "
"werkdagen. Dat is onze belofte.</span>"

#. module: electronic_refurbishment
#: model_terms:ir.ui.view,arch_db:electronic_refurbishment.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-800\">Estimate the trade-in value of your old "
"electronics to fund your next purchase and extend their lifecycle.</span>"
msgstr ""
"<span class=\"o_small-fs text-800\">Schat de inruilwaarde van je oude "
"elektronica om je volgende inkoop te financieren en hun levenscyclus te "
"verlengen.</span>"

#. module: electronic_refurbishment
#: model_terms:ir.ui.view,arch_db:electronic_refurbishment.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-800\">Facing a technical issue? Our team "
"quickly handles your device under your warranty coverage.</span>"
msgstr ""
"<span class=\"o_small-fs text-800\">Ervaar je een technisch probleem? Ons "
"team behandelt je apparaat snel onder je garantiedekking.</span>"

#. module: electronic_refurbishment
#: model_terms:ir.ui.view,arch_db:electronic_refurbishment.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-800\">Get step-by-step guidance to set up your "
"new device and transfer your data with complete ease.</span>"
msgstr ""
"<span class=\"o_small-fs text-800\">Krijg stapsgewijze instructies voor het "
"instellen van je nieuwe apparaat en het moeiteloos overzetten van je "
"gegevens.</span>"

#. module: electronic_refurbishment
#: model_terms:ir.ui.view,arch_db:electronic_refurbishment.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-800\">Learn about your Grade-A coverage terms "
"and our hassle-free 30-day return process.</span>"
msgstr ""
"<span class=\"o_small-fs text-800\">Lees meer over de voorwaarden van onze "
"Score-A-dekking en ons eenvoudige retourproces van 30 dagen.</span>"

#. module: electronic_refurbishment
#: model_terms:ir.ui.view,arch_db:electronic_refurbishment.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-800\">Our experts will guide you in choosing "
"the refurbished device best suited to your needs and budget.</span>"
msgstr ""
"<span class=\"o_small-fs text-800\">Onze experts helpen je bij het kiezen "
"van het gereviseerde apparaat dat het beste past bij jouw behoeften en "
"budget.</span>"

#. module: electronic_refurbishment
#: model_terms:ir.ui.view,arch_db:electronic_refurbishment.view_page_contactus
msgid ""
"<span class=\"o_small-fs text-800\">Track your order status in real-time and "
"access details about your secure express delivery.</span>"
msgstr ""
"<span class=\"o_small-fs text-800\">Volg de status van je bestelling live op "
"en bekijk details over je beveiligde expreslevering.</span>"

#. module: electronic_refurbishment
#: model_terms:ir.ui.view,arch_db:electronic_refurbishment.view_page_our_company
msgid ""
"<span class=\"o_small-fs\" style=\"color: rgb(99, 99, 99);\">Each device "
"undergoes a series of 52 technical tests before receiving its rating: "
"battery, screen, connectivity, sensors, nothing is left to chance.</span>"
msgstr ""
"<span class=\"o_small-fs\" style=\"color: rgb(99, 99, 99);\">Elk apparaat "
"ondergaat een reeks van 52 technische tests voordat het een beoordeling "
"krijgt: batterij, scherm, connectiviteit, sensoren, niets wordt aan het "
"toeval overgelaten.</span>"

