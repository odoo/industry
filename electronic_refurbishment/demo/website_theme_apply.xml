<?xml version='1.0' encoding='UTF-8'?>
<odoo context="{'website_id': ref('base.default_website')}">
	<function name="button_choose_theme" model="ir.module.module" eval="[ref('base.module_theme_graphene', raise_if_not_found=False) or ref('base.module_theme_default')]"/>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().search([('key', '=', 'website.template_header_default')]).ids"/>
        <value eval="{'active': False}"/>
    </function>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().with_context(active_test=False).search([('key', '=', 'website.template_header_stretch')]).ids"/>
        <value eval="{'active': True}"/>
    </function>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().search([('key', '=', 'website.footer_custom')]).ids"/>
        <value eval="{'active': False}"/>
    </function>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().with_context(active_test=False).search([('key', '=', 'website.template_footer_centered')]).ids"/>
        <value eval="{'active': True}"/>
    </function>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().search([('key', '=', 'website_sale.products_attributes')]).ids"/>
        <value eval="{'active': False}"/>
    </function>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().with_context(active_test=False).search([('key', '=', 'website_sale.product_comment')]).ids"/>
        <value eval="{'active': True}"/>
    </function>

    <function model="website.assets" name="make_scss_customization">
        <value eval="'/website/static/src/scss/options/colors/user_color_palette.scss'"/>
        <value eval="{'o-color-2': '#E9E91C'}"/>
    </function>
        
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('base.default_website').id).viewref('website.homepage').id"/>
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('electronic_refurbishment.homepage').arch.replace(
            '*filter_newest_products_electronic_refurbishment*', str(obj().env.ref('website_sale.dynamic_filter_newest_products').id)
        )}"/>
    </function>

    <function name="write" model="ir.ui.view">
        <value model="ir.ui.view"
            eval="obj().env['website'].with_context(website_id=ref('base.default_website')).viewref('website.contactus').id" />
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('electronic_refurbishment.contactus').arch}" />
    </function>
</odoo>
