<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
  <!--Update sale order stages-->
  <function model="sale.order" name="action_confirm" eval="[[ref('sale_order_2'),ref('sale_order_1')]]"/>

  <function name="button_validate" model="stock.picking">
    <value model="stock.picking" eval="(
          obj().env.ref('electronic_refurbishment.sale_order_1') +
          obj().env.ref('electronic_refurbishment.sale_order_2')
        ).picking_ids.ids"/>
  </function>

  <record id="sale_advance_payment_inv_1" model="sale.advance.payment.inv">
    <field name="advance_payment_method">delivered</field>
    <field name="sale_order_ids" eval="[Command.set([ref('sale_order_1'), ref('sale_order_2')])]"/>
  </record>

  <function name="create_invoices" model="sale.advance.payment.inv" eval="[[ref('sale_advance_payment_inv_1')]]"/>

  <function name="action_post" model="account.move">
    <value model="sale.order" eval="(
          obj().env.ref('electronic_refurbishment.sale_order_1') +
          obj().env.ref('electronic_refurbishment.sale_order_2')
        ).invoice_ids.ids"/>
  </function>

</odoo>
