<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom RELOOP - footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.footer_copyright_company_name"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">
                    Copyright © <t t-out="company.name" />
                </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom RELOOP - Header Call to Action</field>
        <field name="inherit_id" ref="website.header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr=".//li" position="replace">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn rounded-circle btn-secondary">
                                    <span class="fa fa-envelope"/> Contact Us
                                </a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_mega" model="ir.ui.view">
        <field name="name">Custom RELOOP - Mega</field>
        <field name="key">website.template_footer_mega</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt48 pb0" data-snippet="s_text_block" data-name="Top Part">
                        <div class="container">
                            <div class="row">
                                <div class="order-lg-0 pb24 o_colored_level col-lg-3" style="order: 1;">
                                    <h5>
                                        <span class="o_text_highlight o_text_highlight_underline" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;">Navigation</span>
                                    </h5>
                                    <div class="s_hr pt0 pb16" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                    </div>
                                    <ul class="list-unstyled">
                                        <li><a href="/">Home</a></li>
                                        <li><a href="/shop" class="o_translate_inline">Shop</a></li>
                                        <li><a href="/our-company" class="o_translate_inline">Our company</a></li>
                                        <li><a href="/contactus">Contact</a><br/></li>
                                    </ul>
                                </div>

                                <div class="order-lg-0 pb24 o_colored_level col-lg-4" style="order: 2;">
                                    <h5>
                                        <span class="o_text_highlight o_text_highlight_underline" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 2px;">Get in touch</span>
                                    </h5>
                                    <div class="s_hr o_colored_level pt0 pb16" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                    </div>
                                    <ul class="list-unstyled">
                                        <li><a href="mailto:info@reloop.com">info@reloop.com</a></li>
                                        <li><a href="tel:+33499000001"><span class="o_force_ltr">+33 4 99 00 00 01</span></a></li>
                                    </ul>
                                    <p>
                                        14 rue de la République<br/>
                                        69001 Lyon
                                    </p>
                                </div>
                                <div class="col-5 order-lg-0 pb24 o_colored_level col-lg-2 offset-lg-3" style="order: 0;">
                                    <a href="/" class="o_footer_logo logo o-float-start-parent">
                                        <img src="/web/image/electronic_refurbishment.img_custom_reloop_image_31" alt="" class="img-fluid float-start me-auto img o_we_custom_image o_attachment_pending_record_id" style="width: 100% !important;" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="order-lg-0 o_colored_level col-lg-12 pb0" style="order: 3;">
                                    <div class="s_hr pb24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto"/>
                                    </div>
                                </div>
                                <div class="order-lg-0 o_colored_level col-lg-12 pb8" style="order: 4;">
                                    <p style="font-weight: normal;">
                                        <span class="h5-fs">
                                            <strong>The specialist in refurbished electronic equipment.</strong>
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_text_block o_footer_bottom_part pt8 pb8 o_colored_level o_cc o_cc2" style="position: relative;" data-snippet="s_text_block" data-name="Bottom Part">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-6 pt8 pb8 o_colored_level">
                                    <div class="s_social_media text-start o_not_editable" data-snippet="s_social_media" data-name="Social Media">
                                        <p class="s_social_media_title d-none">Follow us</p>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank">
                                            <i class="fa fa-twitter o_editable_media rounded shadow-sm"/>
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank">
                                            <i class="fa fa-linkedin o_editable_media rounded shadow-sm"/>
                                        </a>
                                        <a href="https://www.instagram.com/your-page" class="s_social_media_instagram" target="_blank">
                                            <i class="fa fa-instagram o_editable_media rounded shadow-sm"/>
                                        </a>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank">
                                            <i class="fa fa-facebook o_editable_media rounded shadow-sm"/>
                                        </a>
                                        <a href="https://www.youtube.com/your-page" class="s_social_media_youtube" target="_blank">
                                            <i class="fa fa-youtube-play o_editable_media rounded shadow-sm"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="pt8 pb8 o_colored_level col-lg-6">
                                    <nav class="nav justify-content-lg-end flex-column flex-lg-row">
                                        <a class="nav-link" href="#"><span style="color: rgb(8, 43, 97);"><span class="o_small-fs">Terms and Conditions</span></span></a>
                                        <a class="nav-link" href="#"><span style="color: rgb(8, 43, 97);"><span class="o_small-fs">Privacy Policy</span></span></a>
                                        <a class="nav-link" href="#"><span style="color: rgb(8, 43, 97);"><span class="o_small-fs">Cookies</span></span></a>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
            <xpath expr="//t[@t-call='web.brand_promotion']/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
