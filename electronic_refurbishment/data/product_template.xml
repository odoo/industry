    <field name="website_description"><![CDATA[<section class="s_table_of_content pt24 pb24 o_cc o_cc1 o_colored_level" data-snippet="s_table_of_content" data-name="Table of Content">
        <div class="container">
            <div class="row s_nb_column_fixed">
