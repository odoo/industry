#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
msgid "<span class=\"h1-fs\">Basics</span>"
msgstr "<span class=\"h1-fs\">Основи</span>"

#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
msgid ""
"<strong>Activities</strong>: Schedule activities directly within the CRM to "
"ensure timely follow-ups. Activities are actions users take on a document, "
"like making a call or organizing a meeting. Pending activities are visible "
"above\n"
"                the message history in the chatter widget."
msgstr ""
"<strong>Дейности</strong>: Планирайте дейности директно в CRM, за да "
"осигурите навременни последващи действия. Дейностите са действия, които "
"потребителите извършват върху документ, например обаждане или организиране "
"на среща. Предстоящите дейности се виждат над\n"
"                историята на съобщенията в чатъра."

#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
msgid "<strong>CRM for Opportunity Management</strong>"
msgstr "<strong>CRM за управление на възможностите</strong>"

#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
msgid ""
"<strong>CRM</strong>: Manages customer inquiries and tracks leads with "
"efficient follow-ups."
msgstr ""
"<strong>CRM</strong>: Управлява запитванията на клиентите и проследява "
"потенциалните клиенти с ефективни последващи действия."

#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
msgid ""
"<strong>Chatter</strong>: Use the chatter to communicate with team members, "
"log notes, and keep a record of all updates related to the opportunity. Tag "
"colleagues by typing @ followed by their name to send notifications."
msgstr ""
"<strong>Чатър</strong>: Използвайте чатъра, за да общувате с членовете на "
"екипа, да записвате бележки и да съхранявате история на всички промени по "
"възможността. Отбелязвайте колеги, като напишете @ и след това името им, за "
"да им изпратите известия."

#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
msgid ""
"<strong>Field Service Tasks</strong>: Dispatches on-site cleaning tasks "
"promptly upon order confirmation."
msgstr ""
"<strong>Задачи в „Обслужване на място“</strong>: Разпределя задачите за "
"почистване на място веднага след потвърждаване на поръчката."

#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
msgid "<strong>Field Service 🌱️</strong>"
msgstr "<strong>Обслужване на място 🌱️</strong>"

#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
msgid "<strong>Invoicing 💰</strong>"
msgstr "<strong>Счетоводно отчитане 💰</strong>"

#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
msgid ""
"<strong>Invoicing</strong>: Automates bill generation and tracks payments "
"for seamless financial management."
msgstr ""
"<strong>Счетоводно отчитане</strong>: Автоматизира създаването на фактури и "
"проследява плащанията за безпроблемно финансово управление."

#. module: cleaning_services
#: model_terms:ir.ui.view,arch_db:cleaning_services.welcome_article_body
