#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Audience Segmentation:</strong> Target specific groups—like VIP "
"members or recent joiners—for more personalized outreach."
msgstr ""
"<strong>Segmentacija občinstva:</strong> Usmerite se na določene skupine—na "
"primer člane VIP ali nedavno pridružene člane—za bolj prilagojeno "
"komunikacijo."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Automate Your Renewals</strong><br/>\n"
"                <br/>\n"
"                Set up automatic reminders and renewal workflows in the "
"Subscription app to avoid missed payments and lapses in membership. Combine "
"it with automated email marketing to re-engage members who haven't renewed."
msgstr ""
"<strong>Avtomatizirajte podaljšanja</strong><br/>\n"
"                <br/>\n"
"                V aplikaciji Naročnine nastavite samodejne opomnike in "
"poteke dela za podaljšanje, da se izognete zamujenim plačilom in prekinitvam "
"članstva. Združite to z avtomatiziranim e-poštnim trženjem, da znova "
"pritegnete člane, ki svojega članstva niso podaljšali."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Automated Billing &amp; Invoicing:</strong> Reduce administrative "
"overhead by automating invoicing and payment reminders."
msgstr ""
"<strong>Avtomatizirano obračunavanje in izdajanje računov:</strong> "
"Zmanjšajte administrativno breme z avtomatizacijo izdajanja računov in "
"opomnikov za plačilo."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Branded Products:</strong> Offer branded items like t-shirts, mugs, "
"or event tickets in your online shop."
msgstr ""
"<strong>Izdelki z blagovno znamko:</strong> V svoji spletni trgovini "
"ponudite izdelke z blagovno znamko, kot so majice, skodelice ali vstopnice "
"za dogodke."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid "<strong>Bundle Memberships with Exclusive Products or Events</strong>"
