#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Churn Reduction:</strong> Use metrics and automatic follow-ups to "
"reduce cancellations and boost renewals."
msgstr ""
"<strong>Zmanjšanje odliva:</strong> Uporabite metrike in samodejna nadaljnja "
"spremljanja za zmanjšanje odpovedi in povečanje obnovitev."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Coupons &amp; Promotions:</strong> Launch exclusive offers and "
"campaigns to drive traffic and sales."
msgstr ""
"<strong>Kuponi in promocije:</strong> Zaženite ekskluzivne ponudbe in "
"kampanje za povečanje obiska in prodaje."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Email Campaigns:</strong> Announce new events, welcome new members, "
"or send newsletters with beautifully designed emails."
msgstr ""
"<strong>E-poštne kampanje:</strong> Oznanite nove dogodke, pozdravite nove "
"člane ali pošljite glasila s čudovito oblikovanimi e-poštnimi sporočili."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Event Management:</strong> Plan and manage seminars, galas, "
"tournaments, or online webinars with ease."
msgstr ""
"<strong>Upravljanje dogodkov:</strong> Z lahkoto načrtujte in upravljajte "
"seminarje, gala prireditve, turnirje ali spletne seminarje."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Event Pages:</strong> Automatically create sleek event pages with "
