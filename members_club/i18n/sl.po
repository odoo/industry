msgstr ""
"<strong>Prilagodljivi načrti:</strong> Ustvarite različne modele naročnin – "
"mesečne, letne, družinske, študentske itd."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
#, fuzzy
msgid ""
"<strong>Follow-Ups and Reminders:</strong> Automate communications for "
