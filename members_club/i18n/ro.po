msgid "<strong class=\"h2-fs\">2,500.00 €</strong>"
msgstr "<strong class=\"h2-fs\">2.500,00 €</strong>"

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.view_page_home
msgid "<strong class=\"s_rating_title\">Rating</strong>"
msgstr "<strong class=\"s_rating_title\">Evaluare</strong>"

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.view_page_home
msgid ""
"<strong>500+</strong><br/>\n"
"                                        people on the waitlist."
msgstr ""
"<strong>500+</strong><br/>\n"
"                                        de persoane pe lista de așteptare."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Audience Segmentation:</strong> Target specific groups—like VIP "
"members or recent joiners—for more personalized outreach."
msgstr ""
"<strong>Segmentarea publicului:</strong> Adresează-te unor grupuri "
"specifice, precum membrii VIP sau cei înscriși recent, cu mesaje mai "
"personalizate."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Automate Your Renewals</strong><br/>\n"
"                <br/>\n"
"                Set up automatic reminders and renewal workflows in the "
"Subscription app to avoid missed payments and lapses in membership. Combine "
"it with automated email marketing to re-engage members who haven't renewed."
msgstr ""
"<strong>Automatizează reînnoirile</strong><br/>\n"
"                <br/>\n"
"                Configurează mementouri automate și fluxuri de lucru pentru "
"reînnoire în aplicația Abonamente, ca să eviți plățile ratate și "
"întreruperea abonamentelor. Combină-le cu marketingul automat prin e-mail "
"pentru a reactiva membrii care nu și-au reînnoit abonamentul."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Automated Billing &amp; Invoicing:</strong> Reduce administrative "
"overhead by automating invoicing and payment reminders."
msgstr ""
"<strong>Facturare și încasare automate:</strong> Redu sarcinile "
"administrative prin automatizarea facturării și a mementourilor de plată."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Branded Products:</strong> Offer branded items like t-shirts, mugs, "
"or event tickets in your online shop."
msgstr ""
"<strong>Produse personalizate:</strong> Vinde în magazinul online articole "
"cu brandul clubului, precum tricouri, căni sau bilete la evenimente."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid "<strong>Bundle Memberships with Exclusive Products or Events</strong>"
msgstr ""
"<strong>Asociază abonamentele cu produse sau evenimente exclusive</strong>"

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>CRM Integration:</strong> Capture new leads directly from event sign-"
"ups and follow up post-event."
msgstr ""
"<strong>Integrare CRM:</strong> Înregistrează piste noi direct din "
"înscrierile la evenimente și contactează participanții după eveniment."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Churn Reduction:</strong> Use metrics and automatic follow-ups to "
"reduce cancellations and boost renewals."
msgstr ""
"<strong>Reducerea renunțărilor:</strong> Folosește indicatori și urmăriri "
"automate pentru a reduce anulările și a crește numărul de reînnoiri."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Coupons &amp; Promotions:</strong> Launch exclusive offers and "
"campaigns to drive traffic and sales."
msgstr ""
"<strong>Cupoane și promoții:</strong> Lansează oferte și campanii exclusive "
"pentru a atrage vizitatori și a crește vânzările."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Email Campaigns:</strong> Announce new events, welcome new members, "
"or send newsletters with beautifully designed emails."
msgstr ""
"<strong>Campanii prin e-mail:</strong> Anunță evenimente noi, întâmpină "
"membrii noi sau trimite buletine informative cu un design atractiv."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Event Management:</strong> Plan and manage seminars, galas, "
"tournaments, or online webinars with ease."
msgstr ""
"<strong>Gestionarea evenimentelor:</strong> Planifică și gestionează cu "
"ușurință seminare, gale, turnee sau webinare."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Event Pages:</strong> Automatically create sleek event pages with "
"schedules, speaker bios, and registration forms."
msgstr ""
"<strong>Pagini de eveniment:</strong> Creează automat pagini elegante cu "
"programul, biografiile vorbitorilor și formularele de înscriere."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Flexible Plans:</strong> Create different subscription models—"
"monthly, annual, family, student, etc."
msgstr ""
"<strong>Abonamente flexibile:</strong> Creează diferite tipuri de "
"abonamente: lunar, anual, familial, pentru studenți și altele."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Follow-Ups and Reminders:</strong> Automate communications for "
"membership expirations, event invitations, and special announcements to keep "
"your community engaged."
msgstr ""
"<strong>Urmăriri și mementouri:</strong> Automatizează comunicările despre "
"expirarea abonamentelor, invitațiile la evenimente și anunțurile speciale, "
"pentru a menține comunitatea activă."

#. module: members_club
#: model_terms:event.event,description:members_club.event_event_1
msgid "<strong>Free for members | Guests €30</strong>"
msgstr "<strong>Gratuit pentru membri | 30 € pentru invitați</strong>"

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Integrated Contact Forms:</strong> Connect your forms directly to "
"your CRM pipeline to follow up with interest."
msgstr ""
"<strong>Formulare de contact integrate:</strong> Conectează formularele "
"direct la fluxul CRM pentru a urmări solicitările primite."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Lead Management:</strong> Track incoming requests, categorize "
"potential members, and nurture them through a personalized onboarding "
"journey."
msgstr ""
"<strong>Gestionarea pistelor:</strong> Urmărește solicitările primite, "
"clasifică potențialii membri și ghidează-i printr-un proces personalizat de "
"integrare."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Marketing Automation:</strong> Trigger actions based on user behavior"
"—for example, follow up with visitors who abandon their subscription cart."
msgstr ""
"<strong>Automatizarea marketingului:</strong> Declanșează acțiuni în funcție "
"de comportamentul utilizatorilor; de exemplu, contactează vizitatorii care "
"abandonează coșul de abonare."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Member Portal:</strong> Let members log in to view their "
"subscriptions, past orders, and upcoming events."
msgstr ""
"<strong>Portalul membrilor:</strong> Permite membrilor să se autentifice "
"pentru a-și vedea abonamentele, comenzile anterioare și evenimentele "
"viitoare."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Membership Database:</strong> Manage your current members in one "
"place—view statuses, membership levels, renewal dates, and more."
msgstr ""
"<strong>Baza de date a membrilor:</strong> Gestionează toți membrii într-un "
"singur loc — consultă starea abonamentelor, nivelurile, datele de reînnoire "
"și multe altele."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Memberships in the Shop:</strong> Sell memberships just like products"
"—visitors can sign up and pay online in minutes."
msgstr ""
"<strong>Abonamente în magazin:</strong> Vinde abonamente ca pe orice produs "
"— vizitatorii se pot înscrie și pot plăti online în câteva minute."

#. module: members_club
#: model_terms:blog.post,content:members_club.blog_post_1
msgid ""
"<strong>Next up:</strong> Stay tuned for our <em>Silent Mornings</em> pilot "
"sessions launching in June—quiet co-working, guided journaling, and "
"intentional starts to the day."
msgstr ""
"<strong>În curând:</strong> Urmărește lansarea din iunie a sesiunilor pilot "
"<em>Silent Mornings</em> — coworking în liniște, jurnal ghidat și un început "
"de zi conștient."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Opportunities &amp; Upsells:</strong> Identify and follow up on "
"upselling opportunities such as premium memberships or VIP event passes."
msgstr ""
"<strong>Oportunități și vânzări suplimentare:</strong> Identifică și "
"urmărește ocaziile de a vinde abonamente premium sau bilete VIP la "
"evenimente."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.view_page_home
msgid ""
"<strong>Plan, host, deliver</strong> <span class=\"text-o-"
"color-2\"><em>unforgettable</em></span> experiences"
msgstr ""
"<strong>Planifică, găzduiește și oferă</strong> experiențe <span "
"class=\"text-o-color-2\"><em>de neuitat</em></span>"

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>SEO &amp; Analytics:</strong> Optimize visibility and track visitor "
"behavior to keep improving."
msgstr ""
"<strong>SEO și analiză:</strong> Optimizează vizibilitatea și urmărește "
"comportamentul vizitatorilor pentru a îmbunătăți constant rezultatele."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Segment Your Community for Better Engagement</strong><br/>\n"
"                <br/>\n"
"                Use tags and filters in the <strong>CRM</strong> and "
"<strong>Email Marketing</strong> apps to segment your members based on "
"interests, membership tier, or activity. This lets you send targeted "
"campaigns and event invitations\n"
"                that feel personal."
msgstr ""
"<strong>Segmentează comunitatea pentru o implicare mai bună</strong><br/>\n"
"                <br/>\n"
"                Folosește etichetele și filtrele din aplicațiile <strong>"
"CRM</strong> și <strong>Marketing prin e-mail</strong> pentru a grupa "
"membrii după interese, nivelul abonamentului sau activitate. Astfel, poți "
"trimite campanii și invitații la evenimente personalizate."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Self-Service Portal:</strong> Let members manage their own accounts, "
"upgrade plans, or cancel via your website."
msgstr ""
"<strong>Portal de autoservire:</strong> Permite membrilor să își gestioneze "
"conturile, să își schimbe abonamentul sau să îl anuleze de pe site-ul web."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Social Media Dashboard:</strong> Schedule posts, track engagement, "
"and manage your platforms in one place."
msgstr ""
"<strong>Social Media Dashboard:</strong> Program posts, track engagement, "
"and manage your platforms in one place."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Ticketing System:</strong> Set up ticket tiers, early bird "
"discounts, and QR-code-based check-ins."
msgstr ""
"<strong>Sistem de ticketing:</strong> Configurează categorii de bilete, "
"reduceri pentru rezervări timpurii și acces pe bază de cod QR."

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid "<strong>Tips for success</strong>"
msgstr "<strong>Sfaturi pentru succes</strong>"

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid "<strong>Track Key Metrics in Real Time</strong>"
msgstr "<strong>Urmărește indicatorii principali în timp real</strong>"

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid "<strong>Use the Sign App for Smooth Onboarding</strong>"
msgstr ""
"<strong>Folosește aplicația Semnare pentru o integrare fără probleme</strong>"

#. module: members_club
#: model_terms:ir.ui.view,arch_db:members_club.welcome_article_body
msgid ""
"<strong>Website Builder:</strong> Easily build pages for your club’s "
"mission, events, blog, or gallery."
msgstr ""
"<strong>Creator de site-uri web:</strong> Creează cu ușurință pagini pentru "
"misiunea clubului, evenimente, blog sau galerie."

#. module: members_club
#: model:blog.post,name:members_club.blog_post_2
msgid "A Hidden Retreat Tucked Within the Quiet Heart of Brussels"
