<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="res_partner_grade_list_view_inherit" model="ir.ui.view">
    <field name="name">res.partner.grade.list.view.inherit</field>
    <field name="model">res.partner.grade</field>
    <field name="active" eval="True"/>
    <field name="inherit_id" ref="partner_commission.view_partner_grade_tree_inherit_partner_commission"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='default_commission_plan_id']" position="attributes">
        <attribute name="string">Commission Plan</attribute>
        <attribute name="optional">hide</attribute>
      </xpath>
      <xpath expr="//field[@name='default_commission_plan_id']" position="after">
        <field name="default_pricelist_id" string="Pricelist" optional="show"/>
      </xpath>
    </field>
  </record>
</odoo>
