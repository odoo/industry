<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="base.main_company" model="res.company" forcecreate="0">
        <field name="email">info@montgomery.example.com</field>
        <field name="logo" type="bytes" file="members_club/static/description/icon.png"/>
        <field name="partner_id" ref="base.main_partner"/>
        <field name="name">Montgomery</field>
        <field name="phone">+1 555-555-5556</field>
        <field name="street">Parc de Woluwe</field>
        <field name="zip">1150</field>
        <field name="city">Brussels</field>
        <field name="country_id" ref="base.be"/>
        <field name="currency_id" ref="base.EUR"/>
    </record>
    <!-- the pricelists were created in the previous company currency -->
    <function model="product.pricelist" name="write">
        <value model="product.pricelist" eval="obj().search(['|', ('id', '=', ref('product_pricelist_2')), ('name', '=', 'Default')]).ids"/>
        <value eval="{'currency_id': ref('base.EUR')}"/>
    </function>
</odoo>
