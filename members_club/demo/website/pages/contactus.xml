<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">members_club.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="members_club.page_contactus">
                <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'contact_name': request.params.get('contact_name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'partner_name': request.params.get('partner_name', ''), 'name': request.params.get('name', ''), 'description': request.params.get('description', '')}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title o_colored_level s_custom_snippet pb56 pt48" data-vcss="001" data-snippet="s_title" style="position: relative; background-color: transparent; background-image: linear-gradient(rgb(255, 255, 255) 0%, rgba(255, 255, 255, 0) 100%);" data-name="Custom Custom Title">
                            <div class="s_allow_columns container-fluid">
                                <p style="text-align: center; font-weight: normal;">
                                    <span class="text-o-color-2"><img src="/web/image/members_club.img_members_club_image_01" alt="" class="img img-fluid o_we_custom_image o_animate o_anim_slide_in o_anim_from_top" loading="eager" style="--wanim-intensity: 20;"/></span>
                                </p>
                                <p style="text-align: center; font-weight: normal;">
                                    <span class="text-o-color-2"><span class="o_animated_text o_animate o_anim_slide_in o_anim_from_bottom" style="--wanim-intensity: 20;">C O N T A C T&amp;nbsp; &amp;nbsp;U S</span></span>
                                </p>
                                <h1 style="text-align: center; font-weight: normal;">
                                    <span class="o_animated_text o_animate o_anim_slide_in o_anim_from_bottom" style="--wanim-intensity: 10; animation-delay: 0.1s;">
                                        <span class="text-o-color-1">Let's get in touch</span>
                                    </span>
                                </h1>
                            </div>
                        </section>
                        <section class="s_form_aside o_colored_level pt0 pb40" data-snippet="s_form_aside" data-name="Form Aside" style="position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/20&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#FFFFFF&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}">
                            <div class="o_we_shape o_html_builder_Connections_20" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F20.svg?c5=%23FFFFFF&quot;);"/>
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="12">
                                    <div class="col-12 order-lg-0 o_colored_level o_grid_item g-col-lg-6 g-height-12 col-lg-6 o_animate o_anim_fade_in" style="order: 1; grid-area: 1 / 1 / 13 / 7; z-index: 1;">
                                        <p>
                                            <br/>
                                        </p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px;" for="contact1">
                                                                <span class="s_website_form_label_content">Name</span> <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact1" type="text" placeholder="John Doe" class="form-control s_website_form_input" name="contact_name" required="" data-fill-with="name"/>
                                                        </div>
                                                        <div class="mb-3 col-lg-6 s_website_form_field" data-type="tel" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px;" for="contact2">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input id="contact2" type="tel" placeholder="+1 555-555-5555" class="form-control s_website_form_input" name="phone" data-fill-with="phone"/>
                                                        </div>
                                                        <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required" data-type="email" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px;" for="contact3">
                                                                <span class="s_website_form_label_content">Email</span> <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact3" type="email" placeholder="example@mail.com" class="form-control s_website_form_input" name="email_from" required="" data-fill-with="email"/>
                                                        </div>
                                                        <div class="mb-3 col-lg-6 s_website_form_field" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px;" for="contact4">
                                                                <span class="s_website_form_label_content">Company</span>
                                                            </label>
                                                            <input id="contact4" type="text" placeholder="ACME Corp" class="form-control s_website_form_input" name="partner_name" data-fill-with="commercial_company_name"/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px;" for="contact5">
                                                                <span class="s_website_form_label_content">Subject</span> <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input id="contact5" type="text" placeholder="Describe your request" class="form-control s_website_form_input" name="name" required=""/>
                                                        </div>
                                                        <div class="mb-3 col-12 s_website_form_field s_website_form_required" data-type="text" data-name="Field">
                                                            <label class="s_website_form_label" style="width: 200px;" for="contact6">
                                                                <span class="s_website_form_label_content">Message</span> <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea id="contact6" placeholder="Write down your message" class="form-control s_website_form_input" name="description" required="" rows="6"/>
                                                            <span class="s_website_form_field_description small form-text text-muted">We typically respond within 1-2 business days.</span>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label">
                                                                <br/>
                                                            </div>
                                                            <span id="s_website_form_result"/>
                                                            <a href="#" role="button" class="s_website_form_send btn btn-lg btn-primary">
                                                                <img src="/web/image/members_club.img_members_club_image_02" alt="" class="img img-fluid o_we_custom_image" loading="lazy"/>&amp;nbsp; Send Message
                                                            </a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="order-lg-0 o_colored_level o_grid_item o_grid_item_image g-col-lg-5 col-12 g-height-12 col-lg-5 border o_animate o_anim_fade_in" style="order: 0; grid-area: 1 / 8 / 13 / 13; z-index: 2; --box-border-left-width: 20px; --box-border-bottom-width: 20px; --box-border-right-width: 20px; --box-border-top-width: 20px; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; border-left-color: var(--o-color-3) !important; border-bottom-color: var(--o-color-3) !important; border-right-color: var(--o-color-3) !important; border-top-color: var(--o-color-3) !important; animation-delay: 0.1s;">
                                        <img src="/web/image/members_club.img_members_club_image_07" alt="" class="img img-fluid o_editable_media o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_company_team_card o_colored_level o_cc o_cc2 pt48 pb48" data-snippet="s_company_team_card" data-name="Card Team">
                            <div class="container">
                                <h2 style="text-align: center; font-weight: normal;">Our Team</h2>
                                <div class="row">
                                    <div data-name="Team Member" class="col-6 col-lg-3 o_animate o_anim_fade_in">
                                        <div class="s_card card o_cc o_colored_level o_cc2 rounded o_card_img_top" data-name="Card" data-snippet="s_card" data-vxml="001" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; border-left-color: var(--o-color-4); border-bottom-color: var(--o-color-4); border-right-color: var(--o-color-4); border-top-color: var(--o-color-4);">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                                                <img src="/web/image/members_club.img_members_club_image_08" alt="Portrait of Marco Ferrante" class="o_card_img o_editable_media card-img-top img img-fluid o_we_custom_image" style="padding: 20px;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp"/>
                                            </figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs" style="text-align: center;">Marco Ferrante</h3>
                                                <p class="card-text" style="text-align: center;">Member Relations Director</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Team Member" class="col-6 col-lg-3 o_animate o_anim_fade_in" style="animation-delay: 0.1s;">
                                        <div class="s_card card o_cc o_cc2 rounded o_colored_level o_card_img_top" data-name="Card" data-snippet="s_card" data-vxml="001" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; border-left-color: var(--o-color-4); border-bottom-color: var(--o-color-4); border-right-color: var(--o-color-4); border-top-color: var(--o-color-4);">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                                                <img src="/web/image/members_club.img_members_club_image_09" alt="Portrait of Julien Delacroix" class="o_card_img o_editable_media img img-fluid o_we_custom_image card-img-top" style="padding: 20px;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp"/>
                                            </figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs" style="text-align: center;">Julien Delacroix</h3>
                                                <p class="card-text" style="text-align: center;">Events Manager</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Team Member" class="col-6 col-lg-3 o_animate o_anim_fade_in" style="animation-delay: 0.2s;">
                                        <div class="s_card card o_cc o_cc2 rounded o_colored_level o_card_img_top" data-name="Card" data-snippet="s_card" data-vxml="001" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; border-left-color: var(--o-color-4); border-bottom-color: var(--o-color-4); border-right-color: var(--o-color-4); border-top-color: var(--o-color-4);">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                                                <img src="/web/image/members_club.img_members_club_image_10" alt="Portrait of Charlotte Verhoeven" class="o_card_img o_editable_media img img-fluid o_we_custom_image card-img-top" style="padding: 20px;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                            </figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs" style="text-align: center;">Charlotte Verhoeven</h3>
                                                <p class="card-text" style="text-align: center;">House Manager</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Team Member" class="col-6 col-lg-3 o_animate o_anim_fade_in" style="animation-delay: 0.3s;">
                                        <div class="s_card card o_cc o_cc2 rounded o_colored_level o_card_img_top" data-name="Card" data-snippet="s_card" data-vxml="001" style="--box-border-bottom-left-radius: 0px; --box-border-bottom-right-radius: 0px; --box-border-top-right-radius: 0px; --box-border-top-left-radius: 0px; border-left-color: var(--o-color-4); border-bottom-color: var(--o-color-4); border-right-color: var(--o-color-4); border-top-color: var(--o-color-4);">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                                                <img src="/web/image/members_club.img_members_club_image_11" alt="Portrait of Lucas Moreau" class="o_card_img o_editable_media img img-fluid o_we_custom_image card-img-top" style="padding: 20px;" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                            </figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs" style="text-align: center;">Lucas Moreau</h3>
                                                <p class="card-text" style="text-align: center;">Guest Relations Lead</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section data-map-type="m" data-map-zoom="12" data-vxml="001" class="s_map rounded-3 o_not_editable pt248 pb256" data-map-address="Woluwe park, Brussels" data-snippet="s_map" data-name="Map">
                            <div class="map_container">
                                <div class="css_non_editable_mode_hidden">
                                    <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">An address must be specified for a map to be embedded</div>
                                </div>
                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=Woluwe%20park%2C%20Brussels&amp;t=m&amp;z=12&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                <div class="s_map_color_filter"/>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
