                            </div>
                        </section>
                        <section class="o_cc o_colored_level o_cc1 pt0 pb56" data-snippet="s_donation" data-name="Donation" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/20&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#FFFFFF&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" style="position: relative;">
