                                                        <p class="s_donation_description mt-2 my-sm-auto text-muted fst-italic">A step towards a reduced-fee membership.</p>
                                                    </div>
                                                    <div class="d-sm-flex align-items-center my-3">
                                                        <span class="s_donation_btn s_donation_custom_btn btn btn-outline-primary btn-lg">
                                                            <span class="s_donation_currency pe-1">$</span>
                                                            <input id="s_donation_amount_input" type="number" placeholder="Custom Amount" aria-label="Amount" min="5"/>
