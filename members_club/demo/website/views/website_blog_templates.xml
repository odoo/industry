<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="blog_index" model="ir.ui.view">
        <field name="name">Custom - Blog Header</field>
        <field name="key">members_club.blog_index</field>
        <field name="inherit_id" ref="website_blog.index"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_blog_header']" position="replace">
                <div class="oe_structure oe_empty" id="oe_structure_blog_header" t-att-data-editor-message="editor_message">
                    <section class="s_title o_colored_level pt48 o_cc o_cc2 pb48" data-vcss="001" data-snippet="s_title" style="position: relative;" data-name="Title">
                        <div class="s_allow_columns container-fluid">
                            <p class="text-center" style="font-weight: normal;">
                                <span class="text-o-color-2"><img src="/web/image/members_club.img_members_club_image_01" alt="" class="img img-fluid o_we_custom_image o_animate o_anim_slide_in o_anim_from_top" loading="eager" style="--wanim-intensity: 20;"/></span>
                            </p>
                            <p class="text-center" style="font-weight: normal;">
                                <span class="text-o-color-2"><span class="o_animated_text o_animate o_anim_slide_in o_anim_from_bottom" style="--wanim-intensity: 20;">C L U B&amp;nbsp; &amp;nbsp;L&amp;nbsp;I&amp;nbsp;F&amp;nbsp;E</span></span>
                            </p>
                            <h1 class="text-center" style="font-weight: normal;">
                                <span class="o_animated_text o_animate o_anim_slide_in o_anim_from_bottom text-o-color-1" style="--wanim-intensity: 10; animation-delay: 0.1s;">Our latest news</span>
                            </h1>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
