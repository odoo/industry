<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_index_topbar" model="ir.ui.view">
        <field name="name">Custom - Events Topbar</field>
        <field name="key">members_club.event_index_topbar</field>
        <field name="inherit_id" ref="website_event.index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('o_wevent_index_topbar_filters')]//h1" position="replace">
                <h2 class="mb-0" style="font-weight: normal;">
                    <span class="h4-fs">Events</span>
                </h2>
            </xpath>
        </field>
    </record>
    <record id="event_index" model="ir.ui.view">
        <field name="name">Custom - Events</field>
        <field name="key">members_club.event_index</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_we_index_0']" position="replace">
                <div id="oe_structure_we_index_0" class="oe_structure oe_empty">
                    <section class="s_title o_colored_level pb56 pt48" data-vcss="001" data-snippet="s_title" style="position: relative; background-color: transparent; background-image: linear-gradient(rgb(255, 255, 255) 0%, rgba(255, 255, 255, 0) 100%);" data-name="Title">
                        <div class="s_allow_columns container-fluid">
                            <p class="text-center" style="font-weight: normal;">
                                <span class="text-o-color-2"><img src="/web/image/members_club.img_members_club_image_01" alt="" class="img img-fluid o_we_custom_image o_animate o_anim_slide_in o_anim_from_top" loading="eager" style="--wanim-intensity: 20;"/></span>
                            </p>
                            <p class="text-center" style="font-weight: normal;">
                                <span class="text-o-color-2"><span class="o_animated_text o_animate o_anim_slide_in o_anim_from_bottom" style="--wanim-intensity: 20;">O U R&amp;nbsp; &amp;nbsp;E V E N T S</span></span>
                            </p>
                            <h1 class="text-center" style="font-weight: normal;">
                                <span class="o_animated_text o_animate o_anim_slide_in o_anim_from_bottom text-o-color-1" style="--wanim-intensity: 10; animation-delay: 0.1s;">What's happening</span>
                            </h1>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
