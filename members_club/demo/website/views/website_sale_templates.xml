<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="products_oe_structure_1" model="ir.ui.view">
        <field name="name">Custom - Products Top</field>
        <field name="key">members_club.products_oe_structure_1</field>
        <field name="inherit_id" ref="website_sale.products"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_website_sale_products_1']" position="replace">
                <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_products_1">
                    <section class="s_title o_colored_level pb56 pt48" data-vcss="001" data-snippet="s_title" style="position: relative; background-color: transparent; background-image: linear-gradient(rgb(255, 255, 255) 0%, rgba(255, 255, 255, 0) 100%);" data-name="Title">
                        <div class="s_allow_columns container-fluid">
                            <p class="text-center" style="font-weight: normal;">
                                <span class="text-o-color-2"><img src="/web/image/members_club.img_members_club_image_01" alt="" class="img img-fluid o_we_custom_image o_animate o_anim_slide_in o_anim_from_top" loading="eager" style="--wanim-intensity: 20;"/></span>
                            </p>
                            <p class="text-center" style="font-weight: normal;">
                                <span class="text-o-color-2"><span class="o_animated_text o_animate o_anim_slide_in o_anim_from_bottom" style="--wanim-intensity: 20;">J O I N&amp;nbsp; &amp;nbsp;T H E&amp;nbsp; &amp;nbsp;C L U B</span></span>
                            </p>
                            <h1 class="text-center" style="font-weight: normal;">
                                <span class="o_animated_text o_animate o_anim_slide_in o_anim_from_bottom" style="--wanim-intensity: 10; animation-delay: 0.1s;">Choose your membership</span>
                            </h1>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="products_oe_structure_2" model="ir.ui.view">
        <field name="name">Custom - Products Bottom</field>
        <field name="key">members_club.products_oe_structure_2</field>
        <field name="inherit_id" ref="website_sale.products"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_website_sale_products_2']" position="replace">
                <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_products_2">
                    <section class="s_showcase pb80 o_colored_level pt40" data-vcss="003" data-snippet="s_showcase_square" data-name="Showcase Square" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/20&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-3&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                        <div class="o_we_shape o_html_builder_Connections_20" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F20.svg?c5=%23FFFFFF&quot;);"/>
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-6 o_colored_level o_animate o_anim_fade_in">
                                    <div class="row">
                                        <div class="col-lg-12 pb32 o_colored_level">
                                            <h2 style="font-weight: normal;">Our memberships</h2>
                                            <p class="lead">Discover the membership tiers designed to fit how you use the club, each offering its own level of access and privilege.</p>
                                        </div>
                                        <div class="col-lg-6 pt8 pb8 o_colored_level" data-name="Feature">
                                            <div class="d-flex flex-column">
                                                <p>01.</p>
                                                <h3 class="h5-fs">Tailored access</h3>
                                                <p>We offer distinct membership tiers, each designed around how often and how deeply you want to experience the club.</p>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 pt8 pb8 o_colored_level" data-name="Feature">
                                            <div class="d-flex flex-column">
                                                <p>02.</p>
                                                <h3 class="h5-fs">Exclusive privileges</h3>
                                                <p>We reserve certain rooms, events, and services for members only, protecting the privacy and comfort our community values.</p>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 pt8 pb8 o_colored_level" data-name="Feature">
                                            <div class="d-flex flex-column">
                                                <p>03.</p>
                                                <h3 class="h5-fs">A space that fits you</h3>
                                                <p>We designed each tier to match different lifestyles, from occasional visits to daily use of the club as a second home.</p>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 pt8 pb8 o_colored_level" data-name="Feature">
                                            <div class="d-flex flex-column">
                                                <p>04.</p>
                                                <h3 class="h5-fs">Simple to navigate</h3>
                                                <p>We laid out every benefit clearly, so you can compare tiers and choose the membership that suits you best.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 o_snippet_mobile_invisible d-lg-block d-none o-float-end-parent o_colored_level o_animate o_anim_fade_in" style="animation-delay: 0.1s;" data-invisible="1">
                                    <img src="/web/image/members_club.img_members_club_image_12" alt="" class="img img-fluid ms-auto float-end o_we_custom_image" data-format-mimetype="image/webp" data-resize-width="1024" data-mimetype="image/webp" loading="lazy"/>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
