<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container h-100">
                                <a href="/become-a-member" class="oe_unremovable d-flex align-items-center h-100 btn btn-secondary">Become a member</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_minimalist" model="ir.ui.view">
        <field name="name">Custom - Minimalist</field>
        <field name="key">website.template_footer_minimalist</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pt40 pb40" data-snippet="s_text_block" data-name="Container">
                        <div class="container-fluid">
                            <div class="row align-items-center">
                                <div class="offset-lg-0 col-8 offset-2 pt16 pb16 o_colored_level col-lg-2">
                                    <a href="/" class="o_footer_logo logo mx-auto">
                                        <img src="/web/image/members_club.img_members_club_image_13" alt="Montgomery" class="img-fluid img o_we_custom_image mx-auto d-block" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="col-lg-8 pt16 pb16 o_colored_level">
                                    <nav class="nav align-items-center justify-content-center flex-column flex-lg-row">
                                        <a class="nav-link" href="/">Home</a>
                                        <a class="nav-link" href="/shop">Memberships</a>
                                        <a class="nav-link" href="/event">Events</a>
                                        <a class="nav-link" href="__EXPORT_SLUG_XMLID__members_club.blog_blog_1__EXPORT_SLUG_XMLID__">News</a>
                                        <a class="btn btn-primary" href="/contactus">Get in touch</a>
                                    </nav>
                                </div>
                                <div class="col-lg-2 pt16 pb16 o_colored_level">
                                    <div class="s_social_media o_not_editable no_icon_color text-center" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="#" class="s_social_media_facebook" target="_blank">
                                            <i class="oi oi-stack o_editable_media" data-icon="oi_facebook"/>
                                        </a>
                                        <a href="#" class="s_social_media_instagram" target="_blank">
                                            <i class="oi oi-stack o_editable_media" data-icon="oi_instagram"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - Footer Copyright</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small text-center" t-ignore="true">
                    Copyright © <span t-out="res_company.name"/>
                </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
