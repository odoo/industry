<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_privacy_policy" model="ir.ui.view">
        <field name="name">Privacy Policy</field>
        <field name="key">library.page_privacy_policy</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Privacy Policy" t-name="library.page_privacy_policy">
                <t t-call="website.layout">
                    <div id="wrap">
                        <div class="oe_structure">
                            <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
                                <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/library.ir_attachment_3'); background-position: 50% 0;"/>
                                <div class="o_we_bg_filter bg-black-50"/>
                                <div class="container">
                                    <h1>Privacy Policy</h1>
                                </div>
                            </section>
                        </div>
                        <div class="oe_structure">
                            <section class="s_faq_collapse pt32 pb32" data-vcss="001" data-snippet="s_faq_collapse">
                                <div class="container">
                                    <div class="row align-items-start s_nb_column_fixed">
                                        <div class="col-lg-4 pt16">
                                            <h3>Frequently asked questions</h3>
                                            <p class="lead">Here are some common questions about our library.</p>
                                        </div>
                                        <div class="col-lg-7 offset-lg-1 s_col_no_bgcolor" data-name="Accordion Box">
                                            <div data-name="Accordion" class="s_accordion">
                                                <div id="myCollapse" class="accordion-flush accordion">
                                                    <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                        <button type="button" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none" data-bs-toggle="collapse" aria-expanded="true" id="accordion-button46508_1" data-bs-target="#myCollapseTab46508_1" aria-controls="myCollapseTab46508_1">
                                                            <span class="flex-grow-1">What services does your library offer?</span>
                                                        </button>
                                                        <div class="accordion-collapse collapse show" data-bs-parent="#myCollapse" role="region" id="myCollapseTab46508_1" aria-labelledby="accordion-button46508_1">
                                                            <div class="accordion-body">
                                                                <p>Our library specializes in providing access to a vast collection of books, digital resources, and community programs. We cater to the diverse needs of our patrons, fostering a love for reading and lifelong learning.</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                        <button type="button" class="accordion-header accordion-button collapsed justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none" data-bs-toggle="collapse" aria-expanded="false" id="accordion-button46508_2" data-bs-target="#myCollapseTab46508_2" aria-controls="myCollapseTab46508_2">
                                                            <span class="flex-grow-1">How can I contact library support?</span>
                                                        </button>
                                                        <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab46508_2" aria-labelledby="accordion-button46508_2">
                                                            <div class="accordion-body">
                                                                <p>You can reach our library support team by emailing info@ourlibrary.example.com, calling +1 555-555-5556, or using the live chat on our website. Our dedicated team is available during library hours to assist with any inquiries or issues.</p>
                                                                <p>We’re committed to providing prompt and effective solutions to ensure your library experience is enjoyable and fulfilling.</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                        <button type="button" class="accordion-header accordion-button collapsed justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none" data-bs-toggle="collapse" aria-expanded="false" id="accordion-button46508_3" data-bs-target="#myCollapseTab46508_3" aria-controls="myCollapseTab46508_3">
                                                            <span class="flex-grow-1">What are your borrowing policies?</span>
                                                        </button>
                                                        <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab46508_3" aria-labelledby="accordion-button46508_3">
                                                            <div class="accordion-body">
                                                                <p>We offer a borrowing policy that allows you to check out items for up to three weeks. Items must be returned in good condition, and late fees may apply for overdue items.</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_privacy_policy" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_privacy_policy"/>
            <field name="url">/privacy</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
