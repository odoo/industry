<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="website_sale_products_oe_structure_website_sale_products_1" model="ir.ui.view">
    <field name="name">Custom Art Book - Products (oe_structure_website_sale_products_1)</field>
    <field name="key">website_sale.products_oe_structure_website_sale_products_1</field>
    <field name="inherit_id" ref="website_sale.products"/>
    <field name="website_id" ref="website_industry"/>
    <field name="arch" type="xml">
      <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_sale_products_1']" position="replace">
        <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_products_1" data-editor-message-default="true" data-editor-message="Drag blocks here">
          <section class="s_manifesto o_colored_level pt32 pb32" data-snippet="s_manifesto" data-name="Manifesto">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-4 o_colored_level">
                    <h3 class="h5-fs">Discover our collection</h3>
                </div>
                <div class="col-lg-4 o_colored_level">
                    <p>01.</p>
                    <h3 class="h5-fs">Curated for creatives</h3>
                    <p>Every book in our shop is chosen for its artistic value,&amp;nbsp;from iconic monographs to hard-to-find design classics.</p>
                </div>
                <div class="col-lg-4 o_colored_level">
                    <p>02.</p>
                    <h3 class="h5-fs">Something for every eye</h3>
                    <p>Browse by artist, style, or subject to find books that speak to your taste, whether you collect or simply love beautiful pages.</p>
                </div>
                
                
            </div>
        </div>
    </section>
          <div class="s_hr o_colored_level pt0 pb40" data-snippet="s_hr" data-name="Separator">
        <hr class="w-100 mx-auto" style="border-top-color: var(--o-color-1);"/>
    </div>
        </div>
      </xpath>
    </field>
  </record>
  <record id="header_call_to_action" model="ir.ui.view">
    <field name="name">Custom Art Book - Header Call to Action</field>
    <field name="key">website.header_call_to_action</field>
    <field name="inherit_id" ref="website.header_call_to_action"/>
    <field name="website_id" ref="website_industry"/>
    <field name="arch" type="xml"><xpath expr=".//li" position="replace">
        <li t-attf-class="#{_item_class}">
            <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                    <div class="container">
                        <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta">Join Us</a>
                    </div>
                </section>
            </div>
        </li>
    </xpath>
</field>
  </record>
  <record id="header_text_element" model="ir.ui.view">
    <field name="name">Custom Art Book - Header Text element</field>
    <field name="key">website.header_text_element</field>
    <field name="inherit_id" ref="website.header_text_element"/>
    <field name="website_id" ref="website_industry"/>
    <field name="arch" type="xml"><xpath expr=".//li" position="replace">
        <li t-attf-class="#{_item_class}">
            <t t-if="_txt_elt_content == 'sentence'">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <small>Free Returns and Standard Shipping</small>
                </div>
            </t>
            <t t-elif="_txt_elt_content == 'list'">
                <div t-attf-class="s_text_block d-flex flex-column flex-lg-row gap-1 gap-lg-4 align-items-lg-center #{_div_class}" data-name="Text">
                    <small class="d-flex align-items-center">
                        <i class="fa fa-1x fa-fw fa-usd fa-stack me-1"/>
                        Low Price Guarantee
                    </small>
                    <small class="d-flex align-items-center">
                        <i class="fa fa-1x fa-fw fa-shopping-basket fa-stack me-1"/>
                        30 Days Online Returns
                    </small>
                    <small class="d-flex align-items-center">
                        <i class="fa fa-1x fa-fw fa-truck fa-stack me-1"/>
                        Standard Shipping
                    </small>
                </div>
            </t>
            <t t-elif="_txt_elt_content == 'phone_mail'">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <a href="tel:+1 555-555-5556" class="nav-link o_nav-link_secondary">
                        <small>
                            <i class="fa fa-1x fa-fw fa-phone me-1"/>͏ <!-- Empty character needed to be able to delete the icon. -->
                            <span class="o_force_ltr">+1 555-555-5556</span>
                        </small>
                    </a>
                    <a href="mailto:info@yourcompany.example.com" class="nav-link o_nav-link_secondary">
                        <small>
                            <i class="fa fa-1x fa-fw fa-envelope me-1"/>
                            info@yourcompany.example.com
                        </small>
                    </a>
                </div>
            </t>
            <t t-elif="_txt_elt_content == 'mail'">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <a href="mailto:info@yourcompany.example.com" class="nav-link o_nav-link_secondary">
                        <small><i class="fa fa-1x fa-fw fa-envelope me-1"/> info@yourcompany.example.com</small>
                    </a>
                </div>
            </t>
            <t t-elif="_txt_elt_content == 'mail_stretched'">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <a href="tel:+1 555-555-5556" class="nav-link o_nav-link_secondary p-2 o_navlink_background_hover d-flex align-items-center h-100 text-reset">
                        <i class="fa fa-1x fa-fw fa-phone me-1"/>
                        <span class="o_force_ltr"><small>+1 555-555-5556</small></span>
                    </a>
                </div>
            </t>
            <t t-else="">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text" class="s_text_block">
                    <a href="tel:+3226168002" class="nav-link o_nav-link_secondary p-2">
                        <i class="fa fa-1x fa-fw fa-phone me-1"/>
                        <span class="o_force_ltr"><small>+32 2 616 80 02</small></span>
                    </a>
                </div>
            </t>
        </li>
    </xpath>
</field>
  </record>
  <record id="template_footer_centered" model="ir.ui.view">
    <field name="name">Custom Art Book - Centered</field>
    <field name="key">website.template_footer_centered</field>
    <field name="inherit_id" ref="website.template_footer_centered"/>
    <field name="website_id" ref="website_industry"/>
    <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
        <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
            <section class="s_text_block pt32" data-snippet="s_text_block" data-name="Container">
                <div class="s_allow_columns container-fluid">
                    <div class="row">
                        <div class="col-lg-12 order-lg-0 o_colored_level" style="order: 0;">
                            <div class="s_social_media o_not_editable no_icon_color text-center" data-snippet="s_social_media" data-name="Social Media">
                                <h5 class="s_social_media_title d-none">Follow us</h5>
<a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                    <i class="fa fa-facebook o_editable_media fa-stack"/>
                                </a>
<a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank" aria-label="X">
                                    <i class="fa fa-twitter o_editable_media fa-stack"/>
                                </a>
<a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                    <i class="fa fa-linkedin o_editable_media fa-stack"/>
                                </a>
</div>
                            <div class="s_hr pt24 pb24" data-snippet="s_hr" data-name="Separator">
                                <hr class="w-100 mx-auto"/>
                            </div>
                        </div>
                        <div class="col-lg-4 order-lg-0 o_colored_level" style="order: 2;">
                            <p style="text-align: center;">Chau. de Namur 40,&amp;nbsp;<br/>1367 Ramillies</p>
                        </div>
                        <div class="col-lg-4 order-lg-0 pb24 o_colored_level" style="order: 1;">
                            <a href="/" class="o_footer_logo logo">
                                <img src="/web/image/website_custom_art_book.img_custom_art_book_image_20" alt="Art Book logo" class="img-fluid d-block mx-auto img o_we_custom_image o_attachment_pending_record_id" style="width: 35% !important;" loading="lazy"/>
                            </a>
                        </div>
                        <div class="col-lg-4 order-lg-0 o_colored_level" style="order: 3;">
                            <ul class="list-unstyled">
                                <li style="text-align: center;"><a href="tel:+3226168002" class="o_translate_inline">+32 2 616 80 02</a></li>
                                <li style="text-align: center;"><a href="mailto:info@artbook.com">info@artbook.com</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </xpath>
</field>
  </record>
</odoo>
