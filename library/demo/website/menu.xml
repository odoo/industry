<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Website menus - parent_id via search on root (url=#) -->
    <!-- Custom menu: Books -->
    <record id="menu_books" model="website.menu">
      <field name="name">Books</field>
      <field name="url">#</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('website_custom_art_book.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="1"/>
      <field name="is_visible" eval="True"/>
    </record>
    <!-- Custom menu: About Us -->
    <record id="menu_about_us" model="website.menu">
      <field name="name">About Us</field>
      <field name="url">/about-us</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('website_custom_art_book.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="55"/>
      <field name="is_visible" eval="True"/>
    </record>
    <!-- Default menu (rename/reorder): Home -->
    <function name="write" model="website.menu">
      <value model="website.menu" search="[('url', '=', '/'), ('website_id', '=', ref('website_custom_art_book.website_industry'))]"/>
      <value eval="{'name': 'Home', 'sequence': 10, 'is_visible': True}"/>
    </function>
    <!-- Custom menu: Events -->
    <record id="menu_events" model="website.menu">
      <field name="name">Events</field>
      <field name="url">/event</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('website_custom_art_book.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="2"/>
      <field name="is_visible" eval="True"/>
    </record>
  </data>
</odoo>
