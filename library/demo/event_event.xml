<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <record id="event_event_1" model="event.event">
        <field name="name">Literary Exchange Club</field>
        <field name="address_id" ref="base.main_partner"/>
        <field name="date_tz" model="res.users" eval="obj().env.ref('base.user_admin').tz or 'Europe/Brussels'"/>
        <field name="date_begin" model="res.users" eval="
        (DateTime.now().replace(hour=7, minute=30) + relativedelta(days=4)).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="date_end" model="res.users" eval="
        (DateTime.now().replace(hour=9, minute=30) + relativedelta(days=4)).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="description"><![CDATA[<section class="s_text_block o_colored_level">
            <h2>1 morning, 1 theme, 2 books, plenty of discussion.</h2>
            <p>Share your reading impressions with others around two books selected for the occasion.</p>
        </section>]]></field>
        <field name="cover_properties">{"background-image":
            "url(\"/web/image/library.ir_attachment_1448\")",
            "resize_class": "o_half_screen_height o_record_has_cover", "text_align_class": "",
            "opacity": "0.4", "background_color_class": "o_cc o_cc3", "background_color_style": ""}</field>
        <field name="is_published" eval="True"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="stage_id" ref="event.event_stage_announced"/>
    </record>
    <record id="event_event_2" model="event.event">
        <field name="name">Introduction to Poetry</field>
        <field name="address_id" ref="base.main_partner"/>
        <field name="date_tz" model="res.users" eval="obj().env.ref('base.user_admin').tz or 'Europe/Brussels'"/>
        <field name="date_begin" model="res.users" eval="
        (DateTime.now().replace(hour=4, minute=30) + relativedelta(days=6)).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="date_end" model="res.users" eval="
        (DateTime.now().replace(hour=6, minute=30) + relativedelta(days=6)).replace(tzinfo=pytz.timezone(obj().env.user.tz or 'UTC')).astimezone(pytz.UTC).replace(tzinfo=None)"/>
        <field name="description"><![CDATA[<section class="s_text_block o_colored_level">
            <p class="lead">Join us for a two-hour <b>Introduction to Poetry</b> event designed for anyone curious about the art form.
            </p>
            <p>Whether you're a seasoned reader or completely new to verse, this session offers a friendly and engaging exploration of what makes poetry tick. We'll cover the basics of poetic structure, imagery, and sound, and discover how to approach different types of poems. Get ready to unlock new ways of seeing and expressing the world around you!</p>
        </section>]]></field>
        <field name="cover_properties">{"background-image":"url(\"/web/image/library.ir_attachment_1451\")","resize_class":"o_half_screen_height o_record_has_cover","text_align_class":"","opacity":"0.4","background_color_class":"o_cc o_cc3","background_color_style":""}</field>
        <field name="is_published" eval="True"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="stage_id" ref="event.event_stage_announced"/>
    </record>
</odoo>
