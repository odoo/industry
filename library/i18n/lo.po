#. module: library
#: model:mail.template,body_html:library.mail_template_1
msgid ""
"<p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            Dear <t t-out=\"object.partner_id.name or '''Customer'''\"/>,\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            This email is a friendly reminder regarding the\n"
"            <t t-out=\"object.product_id.name or '''Product'''\"/> that was "
"due for return.\n"
"            Our records indicate that the product has not yet been "
"returned.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            As per our rental/return policy, a daily late fee will be "
"applied for each day the product is overdue.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            To avoid any additional charges, please return the product as "
"soon as possible.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            If you have already returned the product, please disregard this "
"email.\n"
"            However, if you believe there has been an error, or if you "
"require an extension,\n"
"            please contact us immediately so we can assist you.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            We appreciate your prompt attention to this matter.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            Sincerely,\n"
"        </p>\n"
"    \n"
"    "
msgstr ""
"<p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            ຮຽນ <t t-out=\"object.partner_id.name or '''Customer'''\"/>,\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            ອີເມວສະບັບນີ້ເປັນການແຈ້ງເຕືອນດ້ວຍຄວາມຫວັງດີກ່ຽວກັບ\n"
"            <t t-out=\"object.product_id.name or '''Product'''\"/> "
"ທີ່ຮອດກຳນົດເວລາສົ່ງຄືນແລ້ວ.\n"
"            ຕາມຂໍ້ມູນໃນລະບົບຂອງພວກເຮົາພົບວ່າ ສິນຄ້າດັ່ງກ່າວຍັງບໍ່ທັນໄດ້ຮັບການສົ່ງຄືນເທື່ອ.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            ອີງຕາມລະບຽບການເຊົ່າ/ການສົ່ງຄືນຂອງພວກເຮົາ, "
"ຄ່າປັບໃໝກາຍກຳນົດຈະຖືກຄິດໄລ່ເປັນລາຍວັນສຳລັບແຕ່ລະມື້ທີ່ກາຍກຳນົດສົ່ງ.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            ເພື່ອຫຼີກລ່ຽງຄ່າໃຊ້ຈ່າຍເພີ່ມເຕີມ, ກະລຸນານຳສົ່ງສິນຄ້າຄືນໃຫ້ໄວເທົ່າທີ່ຈະໄວໄດ້.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            ຫາກທ່ານໄດ້ສົ່ງສິນຄ້າຄືນຮຽບຮ້ອຍແລ້ວ, ກະລຸນາມອງຂ້າມອີເມວສະບັບນີ້ໄດ້ເລີຍ.\n"
"            ແນວໃດກໍຕາມ, ຖ້າທ່ານເຫັນວ່າມີຂໍ້ຜິດພາດ ຫຼື ຕ້ອງການຕໍ່ກຳນົດເວລາ,\n"
"            ກະລຸນາຕິດຕໍ່ພວກເຮົາທັນທີ ເພື່ອທີ່ພວກເຮົາຈະໄດ້ໃຫ້ການຊ່ວຍເຫຼືອທ່ານ.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            ພວກເຮົາຂໍຂອບໃຈເປັນຢ່າງຍິ່ງທີ່ທ່ານເອົາໃຈໃສ່ຕໍ່ເລື່ອງນີ້ຢ່າງວ່ອງໄວ.\n"
"        </p>\n"
"\n"
"        <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"            ດ້ວຍຄວາມນັບຖື,\n"
"        </p>\n"
"    \n"
"    "

