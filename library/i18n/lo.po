#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Confirm Access:</b> In the pop-up window, click \"<b>Grant Access</b>.\""
msgstr "<b>ຢັ້ງຢືນການເຂົ້າເຖິງ:</b> ໃນໜ້າຕ່າງປັອບອັບ, ໃຫ້ກົດ \"<b>ອະນຸຍາດການເຂົ້າເຖິງ</b>.\""

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Confirm all products at once</b> by clicking the <b>Validate</b> button."
msgstr "<b>ຢັ້ງຢືນສິນຄ້າທັງໝົດພ້ອມກັນໃນບາດດຽວ</b> ໂດຍການກົດປຸ່ມ <b>ຢັ້ງຢືນ</b>."

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid "<b>Confirm</b> the subscription."
msgstr "<b>ຢັ້ງຢືນ</b> ການສະໝັກສະມາຊິກ."

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid "<b>Create the invoice</b>."
msgstr "<b>ສ້າງໃບຮຽກເກັບເງິນ</b>."

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid "<b>Go to Website Settings.</b>"
msgstr "<b>ໄປທີ່ ການຕັ້ງຄ່າເວັບໄຊ.</b>"

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Grant Portal Access:</b> At the top of the page, click the <b>gear icon "
"⚙️</b> and choose \"<b>Grant portal access</b>.\""
msgstr ""
"<b>ອະນຸຍາດການເຂົ້າເຖິງຜ່ານພໍທັລ:</b> ຢູ່ເທິງສຸດຂອງໜ້າ, ໃຫ້ກົດ <b>ໄອຄອນຮູບເຟືອງ ⚙️</b> ແລ້ວເລືອກ "
"\"<b>ອະນຸຍາດການເຂົ້າເຖິງຜ່ານພໍທັລ</b>.\""

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid "<b>Open POS Session:</b> Start your Point of Sale (POS) session."
msgstr "<b>ເປີດຮອບການຂາຍ POS:</b> ເລີ່ມຕົ້ນຮອບການຂາຍໜ້າຮ້ານ (POS) ຂອງທ່ານ."

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Process as Usual:</b> Complete the transaction just like a regular rental "
"order."
msgstr "<b>ດຳເນີນການຕາມປົກກະຕິ:</b> ເຮັດທຸລະກຳໃຫ້ສຳເລັດຄືກັນກັບລາຍການເຊົ່າທົ່ວໄປ."

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Select the Customer:</b> In the <b>Contact app</b>, find and select the "
"customer you want to give website access to."
msgstr ""
"<b>ເລືອກລູກຄ້າ:</b> ໃນ <b>ແອັບລາຍຊື່ຜູ້ຕິດຕໍ່</b>, ຊອກຫາ ແລະ "
"ເລືອກລູກຄ້າທີ່ທ່ານຕ້ອງການອະນຸຍາດໃຫ້ເຂົ້າເຖິງເວັບໄຊ."

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Settle the Order:</b> Click the <b>three dots</b> (...), select "
"\"<b>Quotation/order</b>,\" then find the correct order and choose "
"\"<b>Settle the order</b>.\""
msgstr ""
"<b>ຊຳລະສະສາງລາຍການ:</b> ກົດ <b>ຈ້ຳສາມຈ້ຳ</b> (...), ເລືອກ \"<b>ໃບສະເໜີລາຄາ/ໃບສັ່ງຊື້</"
"b>,\" ຈາກນັ້ນຊອກຫາລາຍການທີ່ຖືກຕ້ອງ ແລ້ວເລືອກ \"<b>ຊຳລະສະສາງລາຍການ</b>.\""

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid "<b>Validate!</b>"
msgstr "<b>ຢັ້ງຢືນ!</b>"

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Verify Pricelist:</b> Make sure their <b>Sales parameters</b> show the "
"correct pricelist."
msgstr ""
"<b>ກວດສອບລາຍການລາຄາ:</b> ກວດເບິ່ງໃຫ້ແນ່ໃຈວ່າ <b>ຕົວກຳນົດການຂາຍ</b> "
"ຂອງພວກເຂົາສະແດງລາຍການລາຄາທີ່ຖືກຕ້ອງ."

