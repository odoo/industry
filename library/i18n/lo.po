#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Odoo offers a complete solution to enhance efficiency "
"and improve customer satisfaction across all your library services.</span>"
msgstr ""
"<span class=\"h6-fs\">Odoo ມອບໂຊລູຊັນທີ່ຄົບວົງຈອນ ເພື່ອເພີ່ມປະສິດທິພາບ ແລະ "
"ຍົກລະດັບຄວາມພໍໃຈຂອງລູກຄ້າໃນທຸກໆການບໍລິການຫ້ອງສະໝຸດຂອງທ່ານ.</span>"

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<span class=\"h6-fs\">This module optimizes your library's daily operations "
"by streamlining product rentals, customer subscriptions, and the management "
"of both in-house events and your website's online catalog.</span><br/>"
msgstr ""
