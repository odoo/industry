#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid "<b>Go to Website Settings.</b>"
msgstr "<b>Buka Pengaturan Website.</b>"

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Grant Portal Access:</b> At the top of the page, click the <b>gear icon "
"⚙️</b> and choose \"<b>Grant portal access</b>.\""
msgstr ""
"<b>Berikan Akses Portal:</b> Di bagian atas halaman, klik <b>ikon roda gigi "
"⚙️</b> dan pilih \"<b>Berikan akses portal</b>.\""

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid "<b>Open POS Session:</b> Start your Point of Sale (POS) session."
msgstr "<b>Buka Sesi POS:</b> Mulai sesi Point of Sale (POS) Anda."

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Process as Usual:</b> Complete the transaction just like a regular rental "
"order."
msgstr ""
"<b>Proses Seperti Biasa:</b> Selesaikan transaksi seperti rental order biasa."

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Select the Customer:</b> In the <b>Contact app</b>, find and select the "
"customer you want to give website access to."
msgstr ""
"<b>Pilih Pelanggan:</b> Di <b>aplikasi Kontak</b>, cari dan pilih pelanggan "
"yang ingin diberi akses ke website."

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid ""
"<b>Settle the Order:</b> Click the <b>three dots</b> (...), select "
"\"<b>Quotation/order</b>,\" then find the correct order and choose "
"\"<b>Settle the order</b>.\""
msgstr ""
"<b>Selesaikan Pesanan:</b> Klik <b>tiga titik</b> (...), pilih \"<b>"
"Penawaran/pesanan</b>,\" lalu temukan pesanan yang benar dan pilih \"<b>"
"Selesaikan pesanan</b>.\""

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
msgid "<b>Validate!</b>"
msgstr "<b>Validasi!</b>"

#. module: library
#: model_terms:ir.ui.view,arch_db:library.welcome_article_body
