"x = 100\n"
"\n"
"# Good\n"
"max_score = 100"
msgstr ""
"# Лошо\n"
"x = 100\n"
"\n"
"# Добре\n"
"max_score = 100"

#. module: elearning_platform
#: model_terms:slide.slide,html_content:elearning_platform.slide_slide_51
msgid ""
"# Calculate the area of a rectangle\n"
"area = length * width"
msgstr ""
"# Изчисляване на площта на правоъгълник\n"
"area = length * width"

#. module: elearning_platform
#: model_terms:slide.slide,html_content:elearning_platform.slide_slide_51
msgid ""
"# Easy to read\n"
"def calculate_area(length, width):\n"
"    return length * width"
msgstr ""
"# Лесно за четене\n"
"def calculate_area(length, width):\n"
"    return length * width"

#. module: elearning_platform
#: model_terms:slide.slide,html_content:elearning_platform.slide_slide_51
msgid ""
"# Overcomplicated\n"
"if not (score &lt; 50):\n"
"    print(\"You passed!\")\n"
"\n"
"# Simpler and clearer\n"
"if score &gt;= 50:\n"
"    print(\"You passed!\")"
msgstr ""
"# Прекалено сложно\n"
"if not (score &lt; 50):\n"
"    print(\"Издържахте!\")\n"
"\n"
"# По-просто и по-ясно\n"
"if score &gt;= 50:\n"
"    print(\"Издържахте!\")"

#. module: elearning_platform
#: model_terms:slide.slide,html_content:elearning_platform.slide_slide_51
msgid ""
"# Repetition\n"
"print(\"Hello, Alice!\")\n"
"print(\"Hello, Bob!\")\n"
"print(\"Hello, Carol!\")\n"
"\n"
"# DRY version\n"
"names = [\"Alice\", \"Bob\", \"Carol\"]\n"
"for name in names:\n"
"    print(\"Hello,\", name + \"!\")"
msgstr ""
"# Повторение\n"
"print(\"Здравей, Alice!\")\n"
"print(\"Здравей, Bob!\")\n"
"print(\"Здравей, Carol!\")\n"
"\n"
"# Вариант с DRY\n"
"names = [\"Alice\", \"Bob\", \"Carol\"]\n"
"for name in names:\n"
"    print(\"Здравей,\", name + \"!\")"

