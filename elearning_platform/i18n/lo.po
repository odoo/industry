#. module: elearning_platform
#: model_terms:slide.slide,html_content:elearning_platform.slide_slide_51
msgid "4. <strong>Follow Consistent Style</strong>"
msgstr "4. <strong>ຮັກສາຮູບແບບໃຫ້ສະม่ຳສະເໝີ</strong>"

#. module: elearning_platform
#: model_terms:slide.slide,html_content:elearning_platform.slide_slide_51
msgid "5. <strong>Keep Code Simple (Avoid Unnecessary Complexity)</strong>"
msgstr "5. <strong>ຂຽນໂຄ້ດໃຫ້ລຽບງ່າຍ (ຫຼີກລ່ຽງຄວາມສັບສົນທີ່ບໍ່ຈຳເປັນ)</strong>"

#. module: elearning_platform
#: model_terms:slide.slide,html_content:elearning_platform.slide_slide_51
msgid "6. <strong>Don’t Repeat Yourself (DRY Principle)</strong>"
msgstr "6. <strong>ຢ່າຂຽນໂຄ້ດຊ້ຳຊ້ອນ (ຫຼັກການ DRY)</strong>"

