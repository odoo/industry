#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong><span class=\"h2-fs\">Tips for Success<br/><br/></span></strong>"
msgstr "<strong><span class=\"h2-fs\">Tips Sukses<br/><br/></span></strong>"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Accounting</strong>: Automate invoices, reconcile payments, and "
"track profitability per tour type"
msgstr ""
"<strong>Akuntansi</strong>: Otomatiskan faktur, rekonsiliasi pembayaran, dan "
"lacak profitabilitas per jenis tur"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Activate the multilingual website setting to localize your website "
"to international audiences.</strong>"
msgstr ""
"<strong>Aktifkan pengaturan website multibahasa untuk melokalkan website "
"Anda bagi audiens internasional.</strong>"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Appointments</strong>: Allow customers to book private tours based "
"on availability and language preferences."
msgstr ""
"<strong>Appointment</strong>: Izinkan pelanggan untuk memesan tur privat "
"berdasarkan ketersediaan dan preferensi bahasa."

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Apps &amp; What They Do:</strong>"
msgstr "<strong>Aplikasi &amp; Kegunaannya:</strong>"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Create services</strong> for each destination &amp; language pair"
msgstr "<strong>Buat layanan</strong> untuk setiap pasangan bahasa &amp; tujuan"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Create visually rich pages</strong> with images, videos, and tour "
"descriptions"
msgstr ""
"<strong>Buat halaman yang sudah berisi beragam komponen visual</strong> "
"dengan gambar, video, dan deskripsi tur"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Customers book online</strong> and receive <strong>automated "
"reminders</strong>"
msgstr ""
"<strong>Pelanggan memesan online</strong> dan menerima <strong>pengingat "
"otomatis</strong>"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Customize layouts easily</strong> using drag-and-drop editor"
msgstr ""
"<strong>Sesuaikan layout dengan mudah</strong> menggunakan editor seret-lepas"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Dashboards</strong>: Visualize your KPIs—bookings per guide, top-"
"selling tours, revenue trends"
msgstr ""
"<strong>Dashboard</strong>: Visualisasikan KPI Anda—pemesanan per pemandu, "
"tur terlaris, tren pendapatan"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Define each tour</strong> as an event with time slots and capacities"
msgstr ""
"<strong>Tentukan setiap tur</strong> sebagai acara dengan slot waktu dan "
"kapasitas"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Define guide availability</strong> per service"
msgstr "<strong>Tentukan ketersediaan pemandu</strong> per layanan"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Digital tickets with QR codes</strong> for easy on-site check-in"
msgstr ""
"<strong>Tiket digital dengan kode QR</strong> untuk memudahkan proses check-"
"in di lokasi"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Enable online booking &amp; payment</strong>, no manual follow-up "
"needed"
msgstr ""
"<strong>Aktifkan pemesanan &amp; pembayaran online</strong>, tidak perlu "
"follow-up manual"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Events</strong>: Set up group tours with schedules and manage "
"bookings and attendance."
msgstr ""
"<strong>Acara</strong>: Atur tur kelompok dengan jadwal serta kelola "
"pemesanan dan kehadiran."

#. module: guided_tours
#: model_terms:event.event,description:guided_tours.event_event_2
msgid ""
"<strong>Ghent</strong> is the kind of city that sneaks up on you — and "
"steals your heart. A vibrant mix of gothic spires, canalside charm, artistic "
"rebellion, and youthful energy, Ghent is one of Belgium’s best-kept secrets… "
"though the word is definitely getting out."
msgstr ""
"<strong>Ghent</strong> adalah jenis kota yang diam-diam memikat dan mencuri "
"hati Anda. Perpaduan dinamis antara menara-menara bergaya gotik, tepi kanal "
"yang memesona, pemberontakan artistik, dan energi kaum muda, Ghent adalah "
"salah satu rahasia terbaik Belgia… meskipun kabar ini sudah mulai tersebar "
"luas."

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Handle walk-in traffic</strong> efficiently with synced stock"
msgstr ""
"<strong>Tangani lalu lintas pengunjung</strong> secara efisien dengan stok "
"yang tersinkronisasi"

#. module: guided_tours
#: model_terms:event.event,description:guided_tours.event_event_1
#: model_terms:event.event,description:guided_tours.event_event_2
#: model_terms:event.event,description:guided_tours.event_event_3
#: model_terms:event.event,description:guided_tours.event_event_4
msgid "<strong>Included</strong>"
msgstr "<strong>Sudah termasuk</strong>"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Integrate booking buttons</strong> directly with group or private "
"tour modules"
msgstr ""
"<strong>Integrasikan tombol pemesanan</strong> secara langsung dengan modul "
"tur kelompok atau tur privat"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.ir_ui_view_3841
msgid "<strong>Join Our Guided Group Tours — Discover More Together</strong>"
msgstr ""
"<strong>Bergabunglah dengan Tur Kami — Jelajahi Banyak Tempat Bersama-sama</"
"strong>"

#. module: guided_tours
#: model_terms:event.event,description:guided_tours.event_event_1
#: model_terms:event.event,description:guided_tours.event_event_2
#: model_terms:event.event,description:guided_tours.event_event_3
#: model_terms:event.event,description:guided_tours.event_event_4
msgid "<strong>Not included</strong>"
msgstr "<strong>Belum termasuk</strong>"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Open POS session</strong> and view tour availabilities"
msgstr "<strong>Buka sesi POS</strong> dan lihat ketersediaan tur"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Optimize SEO</strong> to attract tourists searching online"
msgstr ""
"<strong>Optimalkan SEO</strong> untuk menarik wisatawan yang mencari "
"informasi secara online"

#. module: guided_tours
#: model_terms:event.event,description:guided_tours.event_event_1
#: model_terms:event.event,description:guided_tours.event_event_2
#: model_terms:event.event,description:guided_tours.event_event_3
#: model_terms:event.event,description:guided_tours.event_event_4
msgid "<strong>Our offering</strong><br>"
msgstr "<strong>Penawaran kami</strong><br>"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Point of Sale</strong>: Sell tickets in person, print receipts, and "
"manage real-time tour availabilities."
msgstr ""
"<strong>POS</strong>: Jual tiket secara langsung, cetak tanda terima, dan "
"kelola ketersediaan tur secara real-time."

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Print receipts</strong> with booking details"
msgstr "<strong>Cetak tanda terima</strong> dengan rincian pemesanan"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Recruitment</strong>: Manage applications and onboarding for new "
"tour guides"
msgstr ""
"<strong>Rekrutmen</strong>: Kelola lamaran dan proses orientasi bagi pemandu "
"wisata baru"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Regularly update website content</strong> with new tours, seasonal "
"offerings, and high-quality visuals"
msgstr ""
"<strong>Perbarui konten website secara rutin</strong> dengan tur baru, "
"penawaran musiman, dan visual dengan kualitas tinggi"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Reminders &amp; confirmation emails</strong> reduce no-shows"
msgstr ""
"<strong>Pengingat &amp; email konfirmasi</strong> mengurangi ketidakhadiran"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Sell remaining spots</strong> for today’s tours or future ones"
msgstr "<strong>Jual sisa slot</strong> untuk tur hari ini atau tur mendatang"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Social Marketing</strong>: Schedule and post on social media to "
"boost tour visibility"
msgstr ""
"<strong>Social Marketing</strong>: Jadwalkan dan unggah postingan di media "
"sosial untuk meningkatkan visibilitas tur"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Surveys</strong>: Gather guest feedback after each tour to "
"continuously improve"
msgstr ""
"<strong>Survei</strong>: Kumpulkan masukan dari tamu setelah setiap tur "
"untuk terus meningkatkan kualitas layanan"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Track attendance live</strong> from a mobile device or the "
"attendances app"
msgstr ""
"<strong>Lacak kehadiran secara real-time</strong> dari perangkat seluler "
"atau aplikasi presensi"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Train staff</strong> on using POS for quick ticketing"
msgstr ""
"<strong>Latih staf</strong> menggunakan POS untuk pemrosesan tiket yang cepat"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "<strong>Use QR check-ins</strong> to save time and reduce human error"
msgstr ""
"<strong>Gunakan check-in QR</strong> untuk menghemat waktu dan mengurangi "
"kesalahan manusia"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Use automated emails</strong> to remind customers of their upcoming "
"tours"
msgstr ""
"<strong>Gunakan email otomatis</strong> untuk mengingatkan pelanggan tentang "
"tur mendatang"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Use dashboards:</strong> Track key metrics like most popular cities "
"and languages"
msgstr ""
"<strong>Gunakan dashboard:</strong> Lacak metrik utama seperti kota dan "
"bahasa terpopuler"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"<strong>Website</strong>: Build attractive pages to present your tours and "
"convert visitors into customers."
msgstr ""
"<strong>Website</strong>: Buat halaman yang menarik untuk mempresentasikan "
"tur dan mengubah pengunjung menjadi pelanggan."

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.ir_ui_view_3841
msgid "A relaxed pace with time for photos, fun facts, and local tips"
msgstr ""
"Kecepatan yang santai dengan waktu untuk berfoto, fakta menarik, dan tips "
"dari penduduk lokal"

#. module: guided_tours
#: model_terms:event.event,description:guided_tours.event_event_1
#: model_terms:event.event,description:guided_tours.event_event_2
#: model_terms:event.event,description:guided_tours.event_event_3
#: model_terms:event.event,description:guided_tours.event_event_4
