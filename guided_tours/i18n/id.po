#. module: guided_tours
#: model_terms:event.event,description:guided_tours.event_event_4
msgid "Antwerp — Diamond of the North, History and Style"
msgstr "Antwerpen — Berlian Utara, Sejarah, dan Gaya"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid "Appointments App Documentation"
msgstr "Dokumentasi Aplikasi Appointment"

#. module: guided_tours
#: model_terms:ir.ui.view,arch_db:guided_tours.welcome_article_body
msgid ""
"Appointments allow visitors to book private tours by date, language, or "
"guide availability."
