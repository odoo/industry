<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="website_industry" model="website" context="{'foreign_record_to_create': True}">
        <field name="name">Globe Guided Tours</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="user_id" ref="base.public_user"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="logo" type="bytes" file="guided_tours/static/src/img/content/website/logo.svg"/>
        <field name="favicon" type="bytes" file="guided_tours/static/description/favicon.png"/>
        <field name="show_line_subtotals_tax_selection">tax_excluded</field>
        <field name="cart_recovery_mail_template_id" eval="False"/>
        <field name="ecommerce_access">logged_in</field>
        <field name="product_page_image_roundness">medium</field>
        <field name="shop_opt_products_design_classes">o_wsale_products_opt_layout_catalog o_wsale_products_opt_design_thumbs o_wsale_products_opt_name_color_regular o_wsale_products_opt_thumb_cover o_wsale_products_opt_img_secondary_show o_wsale_products_opt_img_hover_zoom_out_light o_wsale_products_opt_has_cta o_wsale_products_opt_actions_onhover o_wsale_products_opt_has_wishlist o_wsale_products_opt_wishlist_fixed o_wsale_products_opt_cc1 o_wsale_products_opt_rounded_2 o_wsale_products_opt_has_comparison o_wsale_products_opt_actions_promote</field>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[
            ('name', '=', 'default_website'),
            ('module', '=', 'base'),
            ('model', '=', 'website')]"/>
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
</odoo>
