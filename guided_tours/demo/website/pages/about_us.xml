<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_about_us" model="ir.ui.view">
        <field name="name">About us</field>
        <field name="key">guided_tours.page_about_us</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="guided_tours.page_about_us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_title_split pt80 o_colored_level o_cc o_cc1 pb88" data-snippet="s_title_split" data-name="Title Split">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-6 o_colored_level">
                                        <h1 class="display-3-fs">About Us</h1>
                                    </div>
                                    <div class="col-lg-5 offset-lg-1 o_colored_level">
                                        <p class="lead">Founded by a team of lifelong travelers, Globe Guided Tours was born from a simple belief: the best way to experience a destination is through the eyes of someone who calls it home. We grew tired of crowded tour buses and surface-level sight-seeing. Instead, we set out to build intimate, immersive journeys that celebrate local culture, protect nature, and forge genuine human connections across borders.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_bold pt112 pb112 o_colored_level o_cc o_cc3" data-snippet="s_text_bold" data-name="Text Bold">
                            <div class="s_allow_columns container">
                                <h2 class="h1-fs" style="text-align: center;">Your trusted partner in navigating today's challenges. We provide reliable service and proven expertise.</h2>
                            </div>
                        </section>
                        <section class="s_numbers_lite o_cc o_cc1 o_colored_level pt96 pb72" data-snippet="s_numbers_lite" data-name="Numbers Lite">
                            <div class="container">
                                <div class="row s_nb_column_fixed o_grid_mode" style="row-gap: 16px; column-gap: 16px !important;" data-row-count="4">
                                    <div class="o_colored_level o_cc o_cc4 o_grid_item g-col-lg-3 rounded offset-1 offset-lg-0 g-height-4 col-lg-3 col-5" style="grid-area: 1 / 1 / 5 / 4; z-index: 1; --grid-item-padding-x: 15px; --box-border-bottom-left-radius: 24px; --box-border-bottom-right-radius: 24px; --box-border-top-right-radius: 24px; --box-border-top-left-radius: 24px; --grid-item-padding-y: 58px;">
                                        <h2 class="display-1-fs" style="text-align: center;">
                                            <span class="display-2-fs">50+</span>
                                        </h2>
                                        <p class="h5-fs" style="text-align: center;">Countries Covered</p>
                                    </div>
                                    <div class="o_colored_level o_cc o_cc2 o_grid_item g-col-lg-3 rounded g-height-4 col-lg-3 col-5" style="grid-area: 1 / 4 / 5 / 7; z-index: 2; --grid-item-padding-x: 15px; --box-border-bottom-left-radius: 24px; --box-border-bottom-right-radius: 24px; --box-border-top-right-radius: 24px; --box-border-top-left-radius: 24px; --grid-item-padding-y: 58px;">
                                        <h2 class="display-1-fs" style="text-align: center;">
                                            <span class="display-2-fs">250</span>
                                        </h2>
                                        <p class="h5-fs" style="text-align: center;">Certified Local Guides</p>
                                    </div>
                                    <div class="o_colored_level o_cc o_cc4 o_grid_item g-col-lg-3 rounded g-height-4 col-lg-3 col-5 offset-lg-0 offset-1" style="grid-area: 1 / 7 / 5 / 10; z-index: 3; --grid-item-padding-x: 15px; --box-border-bottom-left-radius: 24px; --box-border-bottom-right-radius: 24px; --box-border-top-right-radius: 24px; --box-border-top-left-radius: 24px; --grid-item-padding-y: 58px;">
                                        <h2 class="display-1-fs" style="text-align: center;">
                                            <span class="display-2-fs">4.9/5</span>
                                        </h2>
                                        <p class="h5-fs" style="text-align: center;">Average Tour Rating</p>
                                    </div>
                                    <div class="o_colored_level o_cc o_cc2 o_grid_item g-col-lg-3 rounded o_we_padding_highlight col-lg-3 g-height-4 col-5" style="grid-area: 1 / 10 / 5 / 13; z-index: 4; --grid-item-padding-x: 15px; --box-border-bottom-left-radius: 24px; --box-border-bottom-right-radius: 24px; --box-border-top-right-radius: 24px; --box-border-top-left-radius: 24px; --grid-item-padding-y: 58px;">
                                        <h2 class="display-1-fs" style="text-align: center;">
                                            <span class="display-2-fs">2500+</span>
                                        </h2>
                                        <p class="h5-fs" style="text-align: center;">Happy Travelers</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_manifesto pt64 o_colored_level pb56" data-snippet="s_manifesto" data-name="Manifesto">
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-4 o_colored_level">
                                        <h2>Our values</h2>
                                        <div class="s_hr pt0 pb40 d-lg-none o_snippet_desktop_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                            <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 o_colored_level">
                                        <p>01.</p>
                                        <h3 class="h5-fs">
                                            <span class="h4-fs">Authenticity First</span>
                                        </h3>
                                        <p>We skip the tourist traps to deliver genuine experiences, local stories, and meaningful culture.</p>
                                        <div class="s_hr pt32 pb32 d-lg-none o_snippet_desktop_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 o_colored_level">
                                        <p>02.</p>
                                        <h3 class="h5-fs">
                                            <span class="h4-fs">Responsible Travel</span>
                                        </h3>
                                        <p>We support local economies, respect wildlife, and minimize our footprint on every trip.</p>
                                    </div>
                                    <div class="col-lg-4 offset-lg-4 o_colored_level">
                                        <div class="s_hr pt32 pb32" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <p>03.</p>
                                        <h3 class="h5-fs">
                                            <span class="h4-fs">Small-Group Magic</span>
                                        </h3>
                                        <p>With a max of 12 guests per group, we prioritize personal connections, flexibility, and safety.</p>
                                    </div>
                                    <div class="col-lg-4 o_colored_level">
                                        <div class="s_hr pt32 pb32" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <p>04.</p>
                                        <h3 class="h5-fs">
                                            <span class="h4-fs">Safety &amp;amp; Peace of Mind</span>
                                        </h3>
                                        <p>Your safety is our top priority. We partner exclusively with certified, highly trained local experts and maintain rigorous safety standards on every route, so you can explore with complete confidence.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_company_team_spotlight o_colored_level o_cc o_cc1 pt48 pb160" data-snippet="s_company_team_spotlight" data-name="Team Spotlight">
                            <div class="container">
                                <h2>Our Team</h2>
                                <p>
                                    <br/>
                                </p>
                                <div class="row">
                                    <div data-name="Team Member" class="col-6 col-lg-4">
                                        <div class="s_card card o_cc o_colored_level rounded o_cc4 o_card_img_top border" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 12px; --box-border-bottom-right-radius: 12px; --box-border-top-right-radius: 12px; --box-border-top-left-radius: 12px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                                                <img class="o_card_img o_editable_media card-img-top" src="/web/image/guided_tours.img_guided_tours_image_14" alt="Portrait of Tony Fred" loading="lazy"/>
                                            </figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Tony Fred</h3>
                                                <p class="card-text">Chief Executive Officer</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Team Member" class="col-6 col-lg-4">
                                        <div class="s_card o_card_img_top card o_cc o_colored_level rounded border o_cc4" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 12px; --box-border-bottom-right-radius: 12px; --box-border-top-right-radius: 12px; --box-border-top-left-radius: 12px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                                                <img class="o_card_img card-img-top o_editable_media" src="/web/image/guided_tours.img_guided_tours_image_15" alt="Portrait of Mich Stark" loading="lazy"/>
                                            </figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Mich Stark</h3>
                                                <p class="card-text">Chief Technical Manager</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Team Member" class="col-6 col-lg-4">
                                        <div class="s_card o_card_img_top card o_cc o_colored_level rounded border o_cc4" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 12px; --box-border-bottom-right-radius: 12px; --box-border-top-right-radius: 12px; --box-border-top-left-radius: 12px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                                            <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                                                <img class="o_card_img card-img-top o_editable_media" src="/web/image/guided_tours.img_guided_tours_image_16" alt="Portrait of Aline Turner" loading="lazy"/>
                                            </figure>
                                            <div class="card-body">
                                                <h3 class="card-title h5-fs">Aline Turner</h3>
                                                <p class="card-text">Chief Financial Officer</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_call_to_action o_cc pt64 pb64 o_colored_level o_cc4" data-snippet="s_call_to_action" data-name="Call to Action">
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-9 o_colored_level">
                                        <h2 class="h3-fs">Have Questions? Let’s Plan Your Next Adventure Together.</h2>
                                        <p class="lead">Our travel experts are here to help you pick the perfect tour or customize your itinerary.</p>
                                    </div>
                                    <div class="col-lg-3 o_colored_level">
                                        <p style="text-align: right;">
                                            <a class="o_translate_inline btn btn-lg btn-primary" href="/contactus">Contact our team</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_about_us" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_about_us"/>
            <field name="url">/about-us</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
