<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_appointment_index_topbar" model="ir.ui.view">
        <field name="name">Custom - Topbar</field>
        <field name="key">guided_tours.website_calendar_index_topbar</field>
        <field name="inherit_id" ref="website_appointment.website_calendar_index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('d-flex')]/div[hasclass('flex-grow-1')]/h1" position="replace">
                <h1 class="h4 mb-0">Choose your destination</h1>
            </xpath>
        </field>
    </record>
</odoo>
