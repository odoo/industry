<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_event_navbar" model="ir.ui.view">
        <field name="name">Custom - Event Navbar</field>
        <field name="key">guided_tours.navbar</field>
        <field name="inherit_id" ref="website_event.navbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//li[@t-if='event.header_visible']//a[@href='/event']" position="replace">
                <a href="/event" title="Back to All Guided Tours">All Guided Tours</a>
            </xpath>
        </field>
    </record>
    <record id="website_event_index_topbar" model="ir.ui.view">
        <field name="name">Custom - Topbar</field>
        <field name="key">guided_tours.index_topbar</field>
        <field name="inherit_id" ref="website_event.index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('o_wevent_index_topbar_filters')]/div[hasclass('flex-grow-1')]/h1" position="replace">
                <h1 class="mb-0 h4-fs">Guided Tours</h1>
            </xpath>
        </field>
    </record>
    <record id="website_event_index" model="ir.ui.view">
        <field name="name">Custom - Guided Tours</field>
        <field name="key">guided_tours.index</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_we_index_2']" position="replace">
                <div id="oe_structure_we_index_2" class="oe_structure oe_empty">
                    <section class="s_text_block o_colored_level pt96 o_cc o_cc3 pb256" data-snippet="s_text_block" data-name="Text" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Nature/03&quot;,&quot;colors&quot;:{&quot;c1&quot;:&quot;o-color-5&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                        <div class="o_we_shape o_html_builder_Nature_03" style="background-image: url(&quot;/html_editor/shape/html_builder%2FNature%2F03.svg?c1=%231B1319&quot;);"/>
                        <div class="s_allow_columns o_container_small">
                            <h2>
                                <span class="h3-fs">
                                    <strong>Join Our Guided Group Tours: Discover More Together</strong>
                                </span>
                            </h2>
                            <p>
                                <br/>
                            </p>
                            <p>Experience the world like never before with our expertly led group tours through <strong>Sydney, New-York, Bali, and Rome</strong>. Whether you're traveling solo, with friends, or as part of a group, our guided tours offer the perfect balance of storytelling, sightseeing, and shared discovery.</p>
                            <p>Walk alongside fellow travelers as our passionate guides bring each city to life, from medieval alleyways and majestic cathedrals to modern neighborhoods full of local flavor. Our groups are <strong>small enough to stay personal</strong>, but <strong>big enough to share laughs and moments</strong> you'll remember long after the tour ends.</p>
                            <h3>
                                <span class="h4-fs">Expect:</span>
                            </h3>
                            <p>
                                <br/>
                            </p>
                            <ul class="s_icon_list" data-snippet="s_icon_list" data-name="Icon List">
                                <li>Friendly, knowledgeable guides who love questions</li>
                                <li>Carefully curated routes with iconic sights and hidden corners</li>
                                <li>A relaxed pace with time for photos, fun facts, and local tips</li>
                                <li>Great company, because exploring is better together</li>
                            </ul>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
