#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>1. Creation &amp; Initial Contact</b>"
msgstr "<b>1. Criação de um contato inicial n &amp;</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>2. Screening &amp; Data Enrichment</b>"
msgstr "<b>2. Triagem e Enriquecimento de Dados</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>3. Interview Scheduling</b>"
msgstr "<b>3. Agendamento de Entrevistas</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>4. Duplicate Management</b>"
