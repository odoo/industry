#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>1. Creation &amp; Initial Contact</b>"
msgstr "<b>1. Crearea și contactul inițial</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>2. Screening &amp; Data Enrichment</b>"
msgstr "<b>2. Selecția inițială și completarea datelor</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>3. Interview Scheduling</b>"
msgstr "<b>3. Programarea interviurilor</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>4. Duplicate Management</b>"
msgstr "<b>4. Gestionarea duplicatelor</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">CRM</font>:</b> Streamlines daily "
"discussions with potential clients."
msgstr ""
"<b><font class=\"text-o-color-1\">CRM</font>:</b> eficientizează discuțiile "
"zilnice cu potențialii clienți."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Recruitment App:</font></b> Tracks all "
"talent and their applications within a clear pipeline"
msgstr ""
"<b><font class=\"text-o-color-1\">Aplicația Recrutare:</font></b> urmărește "
"toți candidații și candidaturile acestora într-un flux clar."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Sales &amp; Invoicing App</font>:</b> "
"Maintains a clear, automated record of all\n"
"                financial transactions."
msgstr ""
"<b><font class=\"text-o-color-1\">Aplicațiile Vânzări și Facturare</font>:</"
"b> păstrează o evidență clară și automatizată a tuturor\n"
"                tranzacțiilor financiare."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Website App:</font></b> Drives visibility "
"about open positions"
msgstr ""
"<b><font class=\"text-o-color-1\">Aplicația Site web:</font></b> sporește "
"vizibilitatea posturilor vacante."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activate:</b> After the quotation is signed, update the Job Position "
"status to <b>Open</b>."
msgstr ""
"<b>Activare:</b> după semnarea ofertei, actualizați starea postului la <b>"
"Deschis</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activation:</b> Once the Sales Order is validated by the client, manually "
"update the status to\n"
"                    <b>\"Open\"</b> to begin active sourcing."
msgstr ""
"<b>Activare:</b> după ce clientul validează comanda de vânzare, actualizați "
"manual starea la\n"
"                    <b>„Deschis”</b> pentru a începe căutarea activă."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Add to Pool:</b> Select the application and click the <b>Add to Pool</b> "
"button."
msgstr ""
"<b>Adăugare în baza de talente:</b> selectați candidatura și faceți clic pe "
"butonul <b>Adaugă în baza de talente</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Applicants:</b> Track active candidates through the recruitment pipeline "
"for each job position."
msgstr ""
"<b>Candidați:</b> urmăriți candidații activi în fluxul de recrutare pentru "
"fiecare post."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automatic Tracking:</b> This action automatically creates a line for this "
"candidate into the\n"
"                    <b>\"Reporting / Cv sent Report.\"</b>"
msgstr ""
"<b>Urmărire automată:</b> această acțiune creează automat o înregistrare "
"pentru candidat în\n"
"                    <b>„Raportare / Raport CV-uri trimise”.</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automation:</b> Each pipeline stage can be configured to send automated "
"emails to maintain consistent\n"
"                    communication with candidates."
msgstr ""
"<b>Automatizare:</b> fiecare etapă a fluxului poate fi configurată să "
"trimită e-mailuri automate, pentru a menține\n"
"                    o comunicare constantă cu candidații."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Availability Tracking:</b> For every applicant, you can toggle their "
"status (Available/Unavailable) or\n"
"                    set a specific \"Available From\" date."
msgstr ""
"<b>Urmărirea disponibilității:</b> pentru fiecare candidat, puteți activa "
"sau dezactiva starea (Disponibil/Indisponibil) ori\n"
"                    puteți seta o dată specifică în câmpul „Disponibil de la"
"”."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Bill:</b> Once the successful candidates are hired, proceed to "
"<b>invoice</b> the Sales Order."
msgstr ""
"<b>Facturare:</b> după angajarea candidaților selectați, continuați cu <b>"
"facturarea</b> comenzii de vânzare."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Configure</b> client details and grant portal access to the hiring team."
msgstr ""
"<b>Configurați</b> datele clientului și acordați echipei de recrutare acces "
"la portal."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Convert to Talent:</b> The candidate is now a \"Talent.\" From their "
"profile, you can now instantly apply\n"
"                    them to any other open positions."
msgstr ""
"<b>Conversie în talent:</b> candidatul devine acum „talent”. Din profilul "
"său, îl puteți înscrie imediat\n"
"                    la orice alt post deschis."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Create</b> a new job position"
msgstr "<b>Creați</b> un post nou"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Define Requirements:</b> Input essential details such as target profile, "
"salary range, and job description."
msgstr ""
"<b>Definirea cerințelor:</b> introduceți detalii esențiale precum profilul "
"căutat, intervalul salarial și descrierea postului."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Define</b> key skills required for the job"
msgstr "<b>Definiți</b> competențele esențiale pentru post"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Document Management:</b>"
msgstr "<b>Gestionarea documentelor:</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Done:</b> Fulfilled or inactive job position; these are hidden from the "
"website and automatically\n"
"                            filtered out of your main view."
msgstr ""
"<b>Finalizat:</b> post ocupat sau inactiv; acesta este ascuns de pe site și "
"filtrat automat\n"
"                            din vizualizarea principală."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft Sales Order:</b> Once the details are finalized, generate a "
"<b>Quotation</b> from either\n"
"                            the Job Position or the Opportunity; both "
"methods will link the records correctly."
msgstr ""
"<b>Comandă de vânzare în ciornă:</b> după finalizarea detaliilor, generați o "
"<b>ofertă</b> fie din\n"
"                            postul vacant, fie din oportunitate; ambele "
"metode vor conecta corect înregistrările."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft:</b> Used for job position awaiting final client approval. You "
"cannot publish these or add\n"
"                            applicants yet."
msgstr ""
"<b>Ciornă:</b> pentru posturi care așteaptă aprobarea finală a clientului. "
"Acestea nu pot fi publicate și nu se pot adăuga\n"
"                            încă candidați."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>External Settings:</b> For client-based job positions, you can designate "
"the Customer and the\n"
"                    <b>Hiring Team Contact</b>. Members of the Hiring Team "
"Contact will receive emails whenever new CVs are\n"
"                    submitted."
msgstr ""
"<b>Setări externe:</b> pentru posturile gestionate pentru clienți, puteți "
"desemna clientul și\n"
"                    <b>persoana de contact a echipei de recrutare</b>. "
"Membrii echipei de contact vor primi e-mailuri ori de câte ori sunt trimise "
"CV-uri noi."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Flexible Billing:</b> Customize payment terms within the Sales Order "
"based on the specific contract type."
msgstr ""
"<b>Facturare flexibilă:</b> personalizați termenii de plată din comanda de "
"vânzare în funcție de tipul contractului."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Generate Job:</b> From the Opportunity, select <b>Create New Job</b>."
msgstr ""
"<b>Generarea postului:</b> din oportunitate, selectați <b>Creează post nou</"
"b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Go Live</b> by switching the status to \"Open.\""
msgstr "<b>Publicați</b> postul schimbând starea în „Deschis”."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Handling Duplicates:</b> On a regular basis, leverage the Data Cleaning "
"app running the de-duplication of applicants."
msgstr ""
"<b>Gestionarea duplicatelor:</b> folosiți periodic aplicația Curățare date "
"pentru a elimina candidaturile duplicate."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Independent Pipelines:</b> While core information is linked, each "
"application follows its own unique\n"
"                    recruitment journey, allowing you to track progress for "
"different roles simultaneously."
msgstr ""
"<b>Fluxuri independente:</b> deși informațiile principale sunt conectate, "
"fiecare candidatură urmează propriul\n"
"                    parcurs de recrutare, permițând urmărirea simultană a "
"progresului pentru roluri diferite."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Initiate:</b> Open the CRM app and create a new <b>Opportunity</b> for "
"your client."
msgstr ""
"<b>Inițiere:</b> deschideți aplicația CRM și creați o <b>oportunitate</b> "
"nouă pentru client."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Internal Files:</b> Documents attached to the <b>Chatter</b> are private "
"and for internal use\n"
"                            only."
msgstr ""
"<b>Fișiere interne:</b> documentele atașate la <b>Chatter</b> sunt private "
"și destinate exclusiv\n"
"                            utilizării interne."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Invoicing:</b> Once the Sales Order is signed, you can proceed to "
"generate the invoice according to the agreed-upon terms."
msgstr ""
"<b>Facturare:</b> după semnarea comenzii de vânzare, puteți genera factura "
"conform termenilor conveniți."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Job Positions:</b> Define your requirements, website listings, and "
"necessary skills."
msgstr ""
"<b>Posturi:</b> definiți cerințele, anunțurile de pe site și competențele "
"necesare."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Key Configuration Rules</b>"
msgstr "<b>Reguli esențiale de configurare</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Localisation:</b> To specify job localisation, create the desired address "
"as sub contact of your company and select it from the job offer"
msgstr ""
"<b>Localizare:</b> pentru a specifica locul de muncă, creați adresa dorită "
"ca persoană de contact asociată companiei și selectați-o în oferta de muncă."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Locate the Candidate:</b> Find the new application within that Job "
"Position in the back-end."
msgstr ""
"<b>Localizarea candidatului:</b> găsiți noua candidatură pentru postul "
"respectiv în interfața de administrare."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Login:</b> john.smith@fifth.example.com <b>Password:</b> john"
msgstr "<b>Autentificare:</b> john.smith@fifth.example.com <b>Parolă:</b> john"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Manual Entry:</b> Creating a record directly within the specific Job "
"Position pipeline."
msgstr ""
"<b>Introducere manuală:</b> creați o înregistrare direct în fluxul postului "
"respectiv."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Open:</b> Active roles that are ready for publication."
msgstr "<b>Deschis:</b> roluri active, pregătite pentru publicare."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Opportunity Creation → Quotation/Sales Order → Invoicing.</b>"
msgstr "<b>Creare oportunitate → Ofertă/Comandă de vânzare → Facturare.</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Public Sector:</b> Create, configure and select the appropriate price "
"list on a quote or directly assign it to a customer for all future quotes."
msgstr ""
"<b>Sector public:</b> creați și configurați lista de prețuri potrivită, apoi "
"selectați-o în ofertă sau atribuiți-o direct clientului pentru toate "
"ofertele viitoare."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Publish</b> and customize the job description on the website"
msgstr "<b>Publicați</b> și personalizați descrierea postului pe site."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Real-Time Synchronization:</b> This centralized view ensures that if you "
"update a candidate’s\n"
"                    availability (e.g., they are hired elsewhere), that "
"status updates instantly across all client portals where\n"
"                    that CV was shared."
msgstr ""
"<b>Sincronizare în timp real:</b> această vizualizare centralizată asigură "
"că, dacă actualizați\n"
"                    disponibilitatea unui candidat (de exemplu, dacă este "
"angajat în altă parte), starea se actualizează instantaneu în toate "
"portalurile clienților unde\n"
"                    a fost partajat CV-ul."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Recruit:</b> Your recruitment team can now begin their search."
msgstr "<b>Recrutare:</b> echipa dvs. poate începe căutarea."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Recruitment Type:</b> Distinguish between <b>Internal</b> (hiring for "
"your own firm) and\n"
"                    <b>External</b> (hiring on behalf of a client)."
msgstr ""
"<b>Tip de recrutare:</b> diferențiați între recrutarea <b>internă</b> "
"(angajare pentru propria companie) și cea\n"
"                    <b>externă</b> (angajare în numele unui client)."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Scheduling:</b> Ensure your Appointment app is synced to allow candidates "
"to book meetings based on your\n"
"                    real-time availability."
msgstr ""
"<b>Programare:</b> asigurați-vă că aplicația Programări este sincronizată, "
"astfel încât candidații să poată rezerva întâlniri în funcție de\n"
"                    disponibilitatea dvs. în timp real."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Seamless Application: </b>When a Talent is moved to a job position, the "
"system creates a linked duplicate\n"
"                    for that specific role, ensuring organized record-"
"keeping."
msgstr ""
"<b>Candidatură fără întreruperi: </b>când un talent este mutat într-un post, "
"sistemul creează o înregistrare duplicată conectată\n"
"                    pentru rolul respectiv, păstrând evidențele organizate."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>See It In Action!</b>"
msgstr "<b>Vedeți cum funcționează!</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Shared Files:</b> Documents uploaded to the <b>Shared CV</b> field are "
"customer-facing. These are\n"
"                            the files sent via email to clients and "
"published on the Customer Portal."
msgstr ""
"<b>Fișiere partajate:</b> documentele încărcate în câmpul <b>CV partajat</b> "
"sunt vizibile clienților. Acestea sunt\n"
"                            fișierele trimise clienților prin e-mail și "
"publicate în Portalul clienților."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Smart Syncing:</b> Most data is shared between the Talent profile and "
"their specific job applications.\n"
"                    For example, updating a candidate's <b>availability</b> "
"in the Talent Pool automatically updates it across\n"
"                    all their active applications."
msgstr ""
"<b>Sincronizare inteligentă:</b> majoritatea datelor sunt partajate între "
"profilul talentului și candidaturile sale la posturi.\n"
"                    De exemplu, actualizarea <b>disponibilității</b> unui "
"candidat din baza de talente se propagă automat\n"
"                    la toate candidaturile sale active."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Source</b> the perfect candidate from your existing talent pool or new "
"applicants."
msgstr ""
"<b>Identificați</b> candidatul potrivit în baza de talente existentă sau "
"printre noii candidați."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Status Indicators:</b>"
msgstr "<b>Indicatori de stare:</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Status Management:</b> New positions are created in <b>Draft</b> mode by "
"default, preventing premature\n"
"                    publication or applications."
msgstr ""
"<b>Gestionarea stărilor:</b> posturile noi sunt create implicit în starea <b>"
"Ciornă</b>, pentru a preveni\n"
"                    publicarea sau candidaturile premature."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Step-by-Step Recruitment Process</b>"
msgstr "<b>Procesul de recrutare, pas cu pas</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Submit an Entry:</b> Go to the website and apply for the <b>Open "
"Application</b> job."
msgstr ""
"<b>Trimiteți o candidatură:</b> accesați site-ul și înscrieți-vă la postul "
"<b>Candidatură spontană</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pool:</b> Promoting an existing talent record using the \"Apply "
"Job\" button."
msgstr ""
"<b>Baza de talente:</b> promovați o înregistrare de talent existentă "
"folosind butonul „Aplică la post”."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pools:</b> Maintain a database of qualified candidates ready for "
"future roles."
msgstr ""
"<b>Base de talente:</b> mențineți o bază de date cu candidați calificați, "
"pregătiți pentru roluri viitoare."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>The Customer Portal:</b> Clients can log into their Odoo portal to view "
"their Sales Orders, Invoices, and\n"
"                    the <b>Applications</b> you have shared from the "
"previous report."
msgstr ""
"<b>Portalul clienților:</b> clienții se pot conecta la portalul Odoo pentru "
"a vedea comenzile de vânzare, facturile și\n"
"                    <b>candidaturile</b> pe care le-ați partajat din "
"raportul anterior."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Website Integration:</b> Direct applications from your website’s job "
"board."
msgstr ""
"<b>Integrare cu site-ul:</b> candidaturi directe din pagina de posturi a "
"site-ului."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Website Integration:</b> Once a position is set to \"Open,\" ensure the "
"public listing is formatted\n"
"                    correctly for your website."
msgstr ""
"<b>Integrarea cu site-ul:</b> după ce un post este setat la „Deschis”, "
"asigurați-vă că anunțul public este formatat\n"
"                    corect pentru site."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.view_page_home
msgid ""
