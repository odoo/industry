#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>1. Creation &amp; Initial Contact</b>"
msgstr "<b>1. Création &amp; premier contact</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>2. Screening &amp; Data Enrichment</b>"
msgstr "<b>2. Présélection &amp; enrichissement des données</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>3. Interview Scheduling</b>"
msgstr "<b>3. Planification des entretiens</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>4. Duplicate Management</b>"
msgstr "<b>4. Gestion des doublons</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">CRM</font>:</b> Streamlines daily "
"discussions with potential clients."
msgstr ""
"<b><font class=\"text-o-color-1\">CRM</font> :</b> Simplifie les échanges "
"quotidiens avec les clients potentiels."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Recruitment App:</font></b> Tracks all "
"talent and their applications within a clear pipeline"
msgstr ""
"<b><font class=\"text-o-color-1\">Application Recrutement :</font></b> Suit "
"tous les talents et leurs candidatures dans un pipeline clair"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Sales &amp; Invoicing App</font>:</b> "
"Maintains a clear, automated record of all\n"
"                financial transactions."
msgstr ""
"<b><font class=\"text-o-color-1\">Application Ventes &amp; Facturation</"
"font> :</b> Assure un suivi clair et automatisé de toutes les\n"
"                transactions financières."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Website App:</font></b> Drives visibility "
"about open positions"
msgstr ""
"<b><font class=\"text-o-color-1\">Application Site Web :</font></b> Améliore "
"la visibilité des postes à pourvoir"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activate:</b> After the quotation is signed, update the Job Position "
"status to <b>Open</b>."
msgstr ""
"<b>Activer :</b> Après la signature du devis, passez le statut du poste à "
"<b>Ouvert</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activation:</b> Once the Sales Order is validated by the client, manually "
"update the status to\n"
"                    <b>\"Open\"</b> to begin active sourcing."
msgstr ""
"<b>Activation :</b> Une fois la commande client validée par le client, "
"passez manuellement le statut à\n"
"                    <b>\"Ouvert\"</b> pour commencer la recherche active."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Add to Pool:</b> Select the application and click the <b>Add to Pool</b> "
"button."
msgstr ""
"<b>Ajouter au vivier :</b> Sélectionnez la candidature et cliquez sur "
"<b>Ajouter au vivier</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Applicants:</b> Track active candidates through the recruitment pipeline "
"for each job position."
msgstr ""
"<b>Candidats :</b> Suivez les candidats actifs tout au long du pipeline de "
"recrutement pour chaque poste."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automatic Tracking:</b> This action automatically creates a line for this "
"candidate into the\n"
"                    <b>\"Reporting / Cv sent Report.\"</b>"
msgstr ""
"<b>Suivi automatique :</b> Cette action crée automatiquement une ligne pour "
"ce candidat dans le\n"
"                    <b>\"Rapports / Rapport des CV envoyés\".</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automation:</b> Each pipeline stage can be configured to send automated "
"emails to maintain consistent\n"
"                    communication with candidates."
msgstr ""
"<b>Automatisation :</b> Chaque étape du pipeline peut être configurée pour "
"envoyer des e-mails automatiques et assurer une communication régulière\n"
"                    avec les candidats."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Availability Tracking:</b> For every applicant, you can toggle their "
"status (Available/Unavailable) or\n"
"                    set a specific \"Available From\" date."
msgstr ""
"<b>Suivi des disponibilités :</b> Pour chaque candidat, vous pouvez modifier "
"son statut (Disponible/Indisponible) ou\n"
"                    définir une date \"Disponible à partir du\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Bill:</b> Once the successful candidates are hired, proceed to "
"<b>invoice</b> the Sales Order."
msgstr ""
"<b>Facturer :</b> Une fois les candidats recrutés, procédez à la "
"<b>facturation</b> de la commande client."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Configure</b> client details and grant portal access to the hiring team."
msgstr ""
"<b>Configurez</b> les coordonnées du client et accordez l'accès au portail à "
"l'équipe chargée du recrutement."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Convert to Talent:</b> The candidate is now a \"Talent.\" From their "
"profile, you can now instantly apply\n"
"                    them to any other open positions."
msgstr ""
"<b>Convertir en talent :</b> Le candidat devient désormais un \"Talent\". "
"Depuis son profil, vous pouvez immédiatement le proposer\n"
"                    pour tout autre poste ouvert."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Create</b> a new job position"
msgstr "<b>Créez</b> un nouveau poste"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Define Requirements:</b> Input essential details such as target profile, "
"salary range, and job description."
msgstr ""
"<b>Définir les exigences :</b> Saisissez les informations essentielles, "
"comme le profil recherché, la fourchette salariale et la description du "
"poste."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Define</b> key skills required for the job"
msgstr "<b>Définissez</b> les compétences clés requises pour le poste"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Document Management:</b>"
msgstr "<b>Gestion des documents :</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Done:</b> Fulfilled or inactive job position; these are hidden from the "
"website and automatically\n"
"                            filtered out of your main view."
msgstr ""
"<b>Terminé :</b> Poste pourvu ou inactif ; ces postes sont masqués sur le "
"site web et automatiquement\n"
"                            exclus de votre vue principale."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft Sales Order:</b> Once the details are finalized, generate a "
"<b>Quotation</b> from either\n"
"                            the Job Position or the Opportunity; both "
"methods will link the records correctly."
msgstr ""
"<b>Commande client provisoire :</b> Une fois les détails finalisés, générez "
"un <b>devis</b> depuis le\n"
"                            poste ou l'opportunité ; les deux méthodes "
"associent correctement les enregistrements."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft:</b> Used for job position awaiting final client approval. You "
"cannot publish these or add\n"
"                            applicants yet."
msgstr ""
"<b>Brouillon :</b> Utilisé pour les postes en attente de validation finale "
"du client. Vous ne pouvez pas encore les publier ni leur associer\n"
"                            des candidats."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>External Settings:</b> For client-based job positions, you can designate "
"the Customer and the\n"
"                    <b>Hiring Team Contact</b>. Members of the Hiring Team "
"Contact will receive emails whenever new CVs are\n"
"                    submitted."
msgstr ""
"<b>Paramètres externes :</b> Pour les postes liés à un client, vous pouvez "
"désigner le client et le\n"
"                    <b>contact de l'équipe de recrutement</b>. Les membres "
"de cette équipe recevront des e-mails chaque fois que de nouveaux CV seront\n"
"                    soumis."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Flexible Billing:</b> Customize payment terms within the Sales Order "
"based on the specific contract type."
msgstr ""
"<b>Facturation flexible :</b> Personnalisez les conditions de paiement dans "
"la commande client en fonction du type de contrat."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Generate Job:</b> From the Opportunity, select <b>Create New Job</b>."
msgstr ""
"<b>Créer un poste :</b> Depuis l'opportunité, sélectionnez <b>Créer un "
"nouveau poste</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Go Live</b> by switching the status to \"Open.\""
msgstr "<b>Publiez le poste</b> en passant son statut à \"Ouvert\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Handling Duplicates:</b> On a regular basis, leverage the Data Cleaning "
"app running the de-duplication of applicants."
msgstr ""
"<b>Gestion des doublons :</b> Utilisez régulièrement l'application Nettoyage "
"des données pour dédoublonner les candidatures."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Independent Pipelines:</b> While core information is linked, each "
"application follows its own unique\n"
"                    recruitment journey, allowing you to track progress for "
"different roles simultaneously."
msgstr ""
"<b>Pipelines indépendants :</b> Bien que les informations principales soient "
"liées, chaque candidature suit son propre\n"
"                    parcours de recrutement, ce qui permet de suivre "
"simultanément plusieurs postes."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Initiate:</b> Open the CRM app and create a new <b>Opportunity</b> for "
"your client."
msgstr ""
"<b>Commencer :</b> Ouvrez l'application CRM et créez une nouvelle "
"<b>opportunité</b> pour votre client."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Internal Files:</b> Documents attached to the <b>Chatter</b> are private "
"and for internal use\n"
"                            only."
msgstr ""
"<b>Fichiers internes :</b> Les documents joints au <b>chatter</b> sont "
"privés et réservés à un usage\n"
"                            interne."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Invoicing:</b> Once the Sales Order is signed, you can proceed to "
"generate the invoice according to the agreed-upon terms."
msgstr ""
"<b>Facturation :</b> Une fois la commande client signée, vous pouvez générer "
"la facture selon les conditions convenues."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Job Positions:</b> Define your requirements, website listings, and "
"necessary skills."
msgstr ""
"<b>Postes :</b> Définissez vos exigences, les annonces sur le site web et "
"les compétences nécessaires."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Key Configuration Rules</b>"
msgstr "<b>Principales règles de configuration</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Localisation:</b> To specify job localisation, create the desired address "
"as sub contact of your company and select it from the job offer"
msgstr ""

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Locate the Candidate:</b> Find the new application within that Job "
"Position in the back-end."
msgstr ""
"<b>Retrouver le candidat :</b> Repérez la nouvelle candidature dans le poste "
"concerné dans l'interface interne."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Login:</b> john.smith@fifth.example.com <b>Password:</b> john"
msgstr ""
"<b>Identifiant :</b> john.smith@fifth.example.com <b>Mot de passe :</b> john"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Manual Entry:</b> Creating a record directly within the specific Job "
"Position pipeline."
msgstr ""
"<b>Saisie manuelle :</b> Création d'un enregistrement directement dans le "
"pipeline du poste concerné."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Open:</b> Active roles that are ready for publication."
msgstr "<b>Ouvert :</b> Postes actifs prêts à être publiés."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Opportunity Creation → Quotation/Sales Order → Invoicing.</b>"
msgstr ""
"<b>Création de l'opportunité → Devis/Commande client → Facturation.</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Public Sector:</b> Create, configure and select the appropriate price "
"list on a quote or directly assign it to a customer for all future quotes."
msgstr ""

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Publish</b> and customize the job description on the website"
msgstr ""
"<b>Publiez</b> et personnalisez la description du poste sur le site web"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Real-Time Synchronization:</b> This centralized view ensures that if you "
"update a candidate’s\n"
"                    availability (e.g., they are hired elsewhere), that "
"status updates instantly across all client portals where\n"
"                    that CV was shared."
msgstr ""
"<b>Synchronisation en temps réel :</b> Cette vue centralisée garantit que, "
"si vous modifiez la\n"
"                    disponibilité d'un candidat (par exemple s'il est "
"recruté ailleurs), ce statut est immédiatement mis à jour sur tous les "
"portails clients où\n"
"                    son CV a été partagé."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Recruit:</b> Your recruitment team can now begin their search."
msgstr ""
"<b>Recruter :</b> Votre équipe de recrutement peut maintenant commencer ses "
"recherches."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Recruitment Type:</b> Distinguish between <b>Internal</b> (hiring for "
"your own firm) and\n"
"                    <b>External</b> (hiring on behalf of a client)."
msgstr ""
"<b>Type de recrutement :</b> Distinguez le recrutement <b>interne</b> (pour "
"votre propre cabinet) du recrutement\n"
"                    <b>externe</b> (pour le compte d'un client)."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Scheduling:</b> Ensure your Appointment app is synced to allow candidates "
"to book meetings based on your\n"
"                    real-time availability."
msgstr ""
"<b>Planification :</b> Assurez-vous que votre app Rendez-vous est "
"synchronisée afin de permettre aux candidats de réserver des réunions en "
"fonction de vos \n"
"                    rdisponibilités en temps réel."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Seamless Application: </b>When a Talent is moved to a job position, the "
"system creates a linked duplicate\n"
"                    for that specific role, ensuring organized record-"
"keeping."
msgstr ""
"<b>Candidature simplifiée : </b>Lorsqu'un talent est affecté à un poste, le "
"système crée une copie liée\n"
"                    pour ce poste précis, garantissant une bonne "
"organisation des enregistrements."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>See It In Action!</b>"
msgstr "<b>Découvrez-le en action !</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Shared Files:</b> Documents uploaded to the <b>Shared CV</b> field are "
"customer-facing. These are\n"
"                            the files sent via email to clients and "
"published on the Customer Portal."
msgstr ""
"<b>Fichiers partagés :</b> Les documents importés dans le champ <b>CV "
"partagé</b> sont visibles par les clients. Il s'agit\n"
"                            des fichiers envoyés par e-mail aux clients et "
"publiés sur le portail client."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Smart Syncing:</b> Most data is shared between the Talent profile and "
"their specific job applications.\n"
"                    For example, updating a candidate's <b>availability</b> "
"in the Talent Pool automatically updates it across\n"
"                    all their active applications."
msgstr ""
"<b>Synchronisation intelligente :</b> La plupart des données sont partagées "
"entre le profil Talent et ses différentes candidatures.\n"
"                    Par exemple, modifier la <b>disponibilité</b> d'un "
"candidat dans le vivier de talents la met automatiquement à jour dans\n"
"                    toutes ses candidatures actives."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Source</b> the perfect candidate from your existing talent pool or new "
"applicants."
msgstr ""
"<b>Recherchez</b> le candidat idéal parmi les talents de votre vivier ou les "
"nouveaux candidats."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Status Indicators:</b>"
msgstr "<b>Indicateurs de statut :</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Status Management:</b> New positions are created in <b>Draft</b> mode by "
"default, preventing premature\n"
"                    publication or applications."
msgstr ""
"<b>Gestion des statuts :</b> Les nouveaux postes sont créés en mode "
"<b>Brouillon</b> par défaut, ce qui empêche leur\n"
"                    publication prématurée ou le dépôt de candidatures."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Step-by-Step Recruitment Process</b>"
msgstr "<b>Processus de recrutement étape par étape</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Submit an Entry:</b> Go to the website and apply for the <b>Open "
"Application</b> job."
msgstr ""
"<b>Soumettre une candidature :</b> Rendez-vous sur le site web et postulez à "
"l'offre <b>Candidature spontanée</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pool:</b> Promoting an existing talent record using the \"Apply "
"Job\" button."
msgstr ""
"<b>Vivier de talents :</b> Promotion d'une fiche talent existante à l'aide "
"du bouton \"Postuler\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pools:</b> Maintain a database of qualified candidates ready for "
"future roles."
msgstr ""
"<b>Viviers de talents :</b> Conservez une base de données de candidats "
"qualifiés pour les futurs postes."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>The Customer Portal:</b> Clients can log into their Odoo portal to view "
"their Sales Orders, Invoices, and\n"
"                    the <b>Applications</b> you have shared from the "
"previous report."
msgstr ""
"<b>Le portail client :</b> Les clients peuvent se connecter à leur portail "
"Odoo pour consulter leurs commandes clients, factures et\n"
"                    les <b>candidatures</b> que vous avez partagées depuis "
"le rapport précédent."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Website Integration:</b> Direct applications from your website’s job "
