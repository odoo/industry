#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>1. Creation &amp; Initial Contact</b>"
msgstr "<b>1. Creazione e contatto iniziale</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>2. Screening &amp; Data Enrichment</b>"
msgstr "<b>2. Valutazione e arricchimento dati</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>3. Interview Scheduling</b>"
msgstr "<b>3. Pianificazione dei colloqui</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">CRM</font>:</b> Streamlines daily "
"discussions with potential clients."
msgstr ""
"<b><font class=\"text-o-color-1\">CRM</font>:</b> ottimizza le conversazioni "
"giornaliere con potenziali clienti."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Recruitment App:</font></b> Tracks all "
"talent and their applications within a clear pipeline"
msgstr ""
"<b><font class=\"text-o-color-1\">Assunzioni:</font></b> monitora tutti i "
"talenti e le candidature grazie a una pipeline chiara"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Sales &amp; Invoicing App</font>:</b> "
"Maintains a clear, automated record of all\n"
"                financial transactions."
msgstr ""
"<b><font class=\"text-o-color-1\">Vendite e Fatturazione</font>:</b> tiene "
"traccia di tutte le\n"
"                transazioni finanziarie."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Website App:</font></b> Drives visibility "
"about open positions"
msgstr ""
"<b><font class=\"text-o-color-1\">Sito web:</font></b> aumenta la visibilità "
"delle posizioni aperte"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activate:</b> After the quotation is signed, update the Job Position "
"status to <b>Open</b>."
msgstr ""
"<b>Attiva:</b> dopo aver firmato il preventivo, aggiorna lo stato della "
"posizione di lavoro e impostala su <b>Aperta</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activation:</b> Once the Sales Order is validated by the client, manually "
"update the status to\n"
"                    <b>\"Open\"</b> to begin active sourcing."
msgstr ""
"<b>Attivazione:</b> una volta che l'Ordine di vendita è stato convalidato "
"dal cliente, aggiorna manualmente lo stato e impostalo su\n"
"                   <b>Aperta</b> per avviare la ricerca."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Add to Pool:</b> Select the application and click the <b>Add to Pool</b> "
"button."
msgstr ""
"<b>Aggiungi al pool:</b> seleziona la candidatura e fai clic sul pulsante "
"<b>Aggiungi al pool</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Applicants:</b> Track active candidates through the recruitment pipeline "
"for each job position."
msgstr ""
"<b>Candidati:</b> tieni traccia dei candidati attivi attraverso il processo "
"di reclutamento per ciascuna posizione lavorativa."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automatic Tracking:</b> This action automatically creates a line for this "
"candidate into the\n"
"                    <b>\"Reporting / Cv sent Report.\"</b>"
msgstr ""
"<b>Tracciamento automatico:</b> questa azione crea automaticamente una riga "
"per questo candidato nel\n"
"                   <b> \"Rendiconti/Resoconto CV inviati.\"</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automation:</b> Each pipeline stage can be configured to send automated "
"emails to maintain consistent\n"
"                    communication with candidates."
msgstr ""
"<b>Automazione:</b> ogni fase della pipeline può essere configurata per "
"inviare e-mail automatiche al fine di mantenere una\n"
"                    comunicazione coerente con i candidati."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Availability Tracking:</b> For every applicant, you can toggle their "
"status (Available/Unavailable) or\n"
"                    set a specific \"Available From\" date."
msgstr ""
"<b>Monitoraggio disponibilità:</b> per ogni candidato, è possibile "
"modificare il suo stato (Disponibile/Non disponibile) o\n"
"                    impostare una data specifica \"Disponibile da\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Bill:</b> Once the successful candidates are hired, proceed to "
"<b>invoice</b> the Sales Order."
msgstr ""
"<b>Emissione fatture:</b> una volta assunti i candidati selezionati, procedi "
"con l'emissione della <b>fattura</b> dell'ordine di vendita."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Configure</b> client details and grant portal access to the hiring team."
msgstr ""
"<b>Configura</b> i dettagli del cliente e concedi l'accesso al portale al "
"team di reclutamento."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Convert to Talent:</b> The candidate is now a \"Talent.\" From their "
"profile, you can now instantly apply\n"
"                    them to any other open positions."
msgstr ""
"<b>Converti in talento:</b> il candidato è ora un \"Talento\". Dal suo "
"profilo, è ora possibile candidarlo istantaneamente\n"
"                    a qualsiasi altra posizione aperta."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Create</b> a new job position"
msgstr "<b>Crea</b> una nuova posizione lavorativa"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Define Requirements:</b> Input essential details such as target profile, "
"salary range, and job description."
msgstr ""
"<b>Definisci i requisiti:</b> inserisci dettagli essenziali quali il profilo "
"del candidato, la fascia salariale e la descrizione del lavoro."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Define</b> key skills required for the job"
msgstr "<b>Definisci</b> le competenze chiave richieste per il lavoro"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Document Management:</b>"
msgstr "<b>Gestione dei documenti:</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Done:</b> Fulfilled or inactive job position; these are hidden from the "
"website and automatically\n"
"                            filtered out of your main view."
msgstr ""
"<b>Fatto:</b> posizione lavorativa occupata o inattiva. Queste sono nascoste "
"dal sito web e automaticamente\n"
"                            filtrate dalla vista principale."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft Sales Order:</b> Once the details are finalized, generate a "
"<b>Quotation</b> from either\n"
"                            the Job Position or the Opportunity; both "
"methods will link the records correctly."
msgstr ""
"<b>Bozza ordine di vendita:</b> una volta definiti i dettagli, genera un "
"<b>Preventivo</b> dalla\n"
"                            posizione di lavoro o dall'opportunità. Entrambi "
"i metodi collegheranno correttamente i record."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft:</b> Used for job position awaiting final client approval. You "
"cannot publish these or add\n"
"                            applicants yet."
msgstr ""
"<b>Bozza:</b> utilizzata per le posizioni lavorative in attesa "
"dell'approvazione finale del cliente. Non è ancora possibile pubblicarle o "
"aggiungere\n"
"                            candidati."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>External Settings:</b> For client-based job positions, you can designate "
"the Customer and the\n"
"                    <b>Hiring Team Contact</b>. Members of the Hiring Team "
"Contact will receive emails whenever new CVs are\n"
"                    submitted."
msgstr ""
"<b>Impostazioni esterne:</b> per le posizioni lavorative basate sul cliente, "
"è possibile designare il Cliente e il\n"
"                   <b>Contatto del team di assunzione</b>. I membri del "
"Contatto del team di assunzione riceveranno e-mail ogni volta che vengono\n"
"                    inviati nuovi CV."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Flexible Billing:</b> Customize payment terms within the Sales Order "
"based on the specific contract type."
msgstr ""
"<b>Fatturazione flessibile:</b> personalizza i termini di pagamento "
"all'interno dell'Ordine di vendita in base al tipo di contratto specifico."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Generate Job:</b> From the Opportunity, select <b>Create New Job</b>."
msgstr ""
"<b>Generare un lavoro:</b>dall'Opportunità, seleziona <b>Crea nuovo lavoro</"
"b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Go Live</b> by switching the status to \"Open.\""
msgstr "<b>Effettua la pubblicazione</b> impostando lo stato su \"Aperta\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Independent Pipelines:</b> While core information is linked, each "
"application follows its own unique\n"
"                    recruitment journey, allowing you to track progress for "
"different roles simultaneously."
msgstr ""
"<b>Pipeline indipendenti:</b> sebbene le informazioni principali siano "
"collegate, ogni candidatura segue il proprio percorso di reclutamento "
"unico,\n"
"                    consentendoti di monitorare contemporaneamente i "
"progressi per diversi ruoli."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Initiate:</b> Open the CRM app and create a new <b>Opportunity</b> for "
"your client."
msgstr ""
"<b>Iniziare:</b> apri l'app CRM e crea una nuova <b>Opportunità</b> per il "
"tuo cliente."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Internal Files:</b> Documents attached to the <b>Chatter</b> are private "
"and for internal use\n"
"                            only."
msgstr ""
"<b>File interni:</b> i documenti allegati al <b>chatter</b> sono privati e "
"destinati esclusivamente all'uso interno\n"
"                            ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Invoicing:</b> Once the Sales Order is signed, you can proceed to "
"generate the invoice according to the agreed-upon terms."
msgstr ""
"<b>Fatturazione:</b> una volta firmato l'Ordine di vendita, è possibile "
"procedere alla generazione della fattura secondo i termini concordati."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Job Positions:</b> Define your requirements, website listings, and "
"necessary skills."
msgstr ""
"<b>Posizioni lavorative:</b> definisci i tuoi requisiti, gli annunci sul "
"sito web e le competenze necessarie."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Key Configuration Rules</b>"
msgstr "<b>Regole chiave di configurazione</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Locate the Candidate:</b> Find the new application within that Job "
"Position in the back-end."
msgstr ""
"<b>Individua il candidato:</b> trova la nuova candidatura all'interno di "
"quella posizione lavorativa nel back-end."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Login:</b> john.smith@fifth.example.com <b>Password:</b> john"
msgstr "<b>Login:</b> john.smith@fifth.example.com <b>Password:</b> john"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Manual Entry:</b> Creating a record directly within the specific Job "
"Position pipeline."
msgstr ""
"<b>Inserimento manuale:</b> creazione di un record direttamente all'interno "
"della pipeline specifica della posizione lavorativa."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Open:</b> Active roles that are ready for publication."
msgstr "<b>Aperti:</b> ruoli attivi pronti per la pubblicazione."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Opportunity Creation → Quotation/Sales Order → Invoicing.</b>"
msgstr ""
"<b>Creazione opportunità → Preventivo/Ordine di vendita → Fatturazione.</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Publish</b> and customize the job description on the website"
msgstr ""
"<b>Pubblica</b> e personalizza la descrizione della posizione lavorativa sul "
"sito web"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Real-Time Synchronization:</b> This centralized view ensures that if you "
"update a candidate’s\n"
"                    availability (e.g., they are hired elsewhere), that "
"status updates instantly across all client portals where\n"
"                    that CV was shared."
msgstr ""
"<b>Sincronizzazione in tempo reale:</b> questa vista centralizzata "
"garantisce che, se si aggiorna la disponibilità di un candidato\n"
"                    (ad esempio, se viene assunto altrove), tale stato venga "
"aggiornato istantaneamente su tutti i portali dei clienti in cui\n"
"                    è stato condiviso quel CV."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Recruit:</b> Your recruitment team can now begin their search."
msgstr ""
"<b>Assunzioni:</b> il tuo team di reclutamento può ora iniziare la ricerca."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Recruitment Type:</b> Distinguish between <b>Internal</b> (hiring for "
"your own firm) and\n"
"                    <b>External</b> (hiring on behalf of a client)."
msgstr ""
"<b>Tipo di reclutamento:</b> distingui tra <b>Interno</b> (assunzione per la "
"propria azienda) ed\n"
"                   <b> Esterno</b> (assunzione per conto di un cliente)."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Scheduling:</b> Ensure your Appointment app is synced to allow candidates "
"to book meetings based on your\n"
"                    real-time availability."
msgstr ""
"<b>Pianificazione:</b> assicurati che l'app Appuntamenti sia sincronizzata "
"per consentire ai candidati di prenotare incontri in base alla\n"
"                    disponibilità in tempo reale."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Seamless Application: </b>When a Talent is moved to a job position, the "
"system creates a linked duplicate\n"
"                    for that specific role, ensuring organized record-"
"keeping."
msgstr ""
"<b>Candidatura semplice: </b>quando un talento viene trasferito a una "
"posizione lavorativa, il sistema crea un duplicato collegato\n"
"                    per quel ruolo specifico, garantendo una tenuta dei "
"registri organizzata."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>See It In Action!</b>"
msgstr "<b>Guardalo in azione!</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Shared Files:</b> Documents uploaded to the <b>Shared CV</b> field are "
"customer-facing. These are\n"
"                            the files sent via email to clients and "
"published on the Customer Portal."
msgstr ""
"<b>File condivisi:</b> i documenti caricati nel campo <b>\"CV condiviso\"</"
"b> sono destinati ai clienti. Si tratta\n"
"                            dei file inviati via e-mail ai clienti e "
"pubblicati sul Portale clienti."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Smart Syncing:</b> Most data is shared between the Talent profile and "
"their specific job applications.\n"
"                    For example, updating a candidate's <b>availability</b> "
"in the Talent Pool automatically updates it across\n"
"                    all their active applications."
msgstr ""
"<b>Sincronizzazione intelligente:</b> la maggior parte dei dati è condivisa "
"tra il profilo del candidato e le sue specifiche candidature.\n"
"                    Ad esempio, l'aggiornamento della <b>disponibilità</b> "
"di un candidato nel pool di talenti la aggiorna automaticamente in\n"
"                    tutte le sue candidature attive."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Source</b> the perfect candidate from your existing talent pool or new "
"applicants."
msgstr ""
"<b>Trova</b> il candidato perfetto dal pool di talenti esistente o tra i "
"nuovi candidati."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Status Indicators:</b>"
msgstr "<b>Indicatori di stato:</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Status Management:</b> New positions are created in <b>Draft</b> mode by "
"default, preventing premature\n"
"                    publication or applications."
msgstr ""
"<b>Gestione stato:</b> le nuove posizioni vengono create di default in "
"modalità <b>Bozza</b>, impedendo la\n"
"                    pubblicazione o l'invio di candidature premature."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Step-by-Step Recruitment Process</b>"
msgstr "<b>Processo di reclutamento passo dopo passo</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Submit an Entry:</b> Go to the website and apply for the <b>Open "
"Application</b> job."
msgstr ""
"<b>Invia una candidatura:</b> vai al sito web e candidati per la posizione "
"<b>Candidatura aperta</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pool:</b> Promoting an existing talent record using the \"Apply "
"Job\" button."
msgstr ""
"<b>Pool di talenti:</b> promuovi un record talento esistente utilizzando il "
"pulsante \"Candida\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pools:</b> Maintain a database of qualified candidates ready for "
"future roles."
msgstr ""
"<b>Pool di talenti:</b> gestisci un database di candidati qualificati pronti "
"per ruoli futuri."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>The Customer Portal:</b> Clients can log into their Odoo portal to view "
"their Sales Orders, Invoices, and\n"
"                    the <b>Applications</b> you have shared from the "
"previous report."
msgstr ""
"<b>Portale clienti:</b> i clienti possono accedere al proprio portale Odoo "
"per visualizzare Ordini di vendita, Fatture e\n"
"                    <b>Candidature</b> che hai condiviso dal resoconto "
"precedente."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Website Integration:</b> Direct applications from your website’s job "
"board."
msgstr ""
"<b>Integrazione con il sito web:</b> candidature dirette dalla bacheca delle "
"offerte di lavoro del tuo sito web."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Website Integration:</b> Once a position is set to \"Open,\" ensure the "
"public listing is formatted\n"
"                    correctly for your website."
msgstr ""
"<b>Integrazione con il sito web:</b> una volta che una posizione è impostata "
"su \"Aperta\", assicurati che l'annuncio pubblico sia formattato\n"
"                    correttamente per il tuo sito web."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.view_page_home
msgid ""
"<br/>\n"
"                                            <span class=\"h5-fs\">Back to "
"what <strong>headhunting</strong> truly means.</span>\n"
"                                            <span class=\"o_text_highlight "
"o_text_highlight_underline\" style=\"--text-highlight-color: #3D5AFE; --text-"
"highlight-width: 3px; font-size: 20px;\">\n"
"                                                <strong>Zenith</strong>\n"
"                                            </span>\n"
"                                            <span class=\"h5-fs\"> connects "
"demanding organizations with exceptional executives the top 1% who won't "
"answer a job posting.</span>"
msgstr ""

