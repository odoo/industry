#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>1. Creation &amp; Initial Contact</b>"
msgstr "<b>1. Pembuatan &amp; Kontak Awal</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>2. Screening &amp; Data Enrichment</b>"
msgstr "<b>2. Screening &amp; Pengayaan Data</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>3. Interview Scheduling</b>"
msgstr "<b>3. Penjadwalan Wawancara</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">CRM</font>:</b> Streamlines daily "
"discussions with potential clients."
msgstr ""
"<b><font class=\"text-o-color-1\">CRM</font>:</b> Memperlancar diskusi "
"harian dengan calon klien."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Recruitment App:</font></b> Tracks all "
"talent and their applications within a clear pipeline"
msgstr ""
"<b><font class=\"text-o-color-1\">Aplikasi Rekrutmen:</font></b> Melacak "
"semua talenta beserta lamarannya dalam pipeline yang jelas"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Sales &amp; Invoicing App</font>:</b> "
"Maintains a clear, automated record of all\n"
"                financial transactions."
msgstr ""
"<b><font class=\"text-o-color-1\">Aplikasi Sales &amp; Faktur</font>:</b> "
"Menyimpan record yang jelas dan otomatis\n"
"                dari semua transaksi keuangan."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Website App:</font></b> Drives visibility "
"about open positions"
msgstr ""
"<b><font class=\"text-o-color-1\">Aplikasi Website:</font></b> Meningkatkan "
"visibilitas lowongan pekerjaan"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activate:</b> After the quotation is signed, update the Job Position "
"status to <b>Open</b>."
msgstr ""
"<b>Aktifkan:</b> Setelah penawaran harga ditandatangani, perbarui status "
"Posisi Kerja menjadi <b>Dibuka</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activation:</b> Once the Sales Order is validated by the client, manually "
"update the status to\n"
"                    <b>\"Open\"</b> to begin active sourcing."
msgstr ""
"<b>Aktivasi:</b> Setelah Sales Order divalidasi oleh klien, perbarui "
"statusnya secara manual menjadi\n"
"                   <b> \"Terbuka\"</b> untuk memulai pengadaan aktif."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Add to Pool:</b> Select the application and click the <b>Add to Pool</b> "
"button."
msgstr ""
"<b>Tambahkan ke Kelompok:</b> Pilih aplikasi dan klik tombol <b>Tambahkan ke "
"Kelompok</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Applicants:</b> Track active candidates through the recruitment pipeline "
"for each job position."
msgstr ""
"<b>Pelamar:</b> Lacak kandidat aktif melalui pipeline rekrutmen untuk setiap "
"posisi kerja."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automatic Tracking:</b> This action automatically creates a line for this "
"candidate into the\n"
"                    <b>\"Reporting / Cv sent Report.\"</b>"
msgstr ""
"<b>Pelacakan Otomatis:</b> Tindakan ini otomatis membuat baris untuk "
"kandidat ini ke dalam\n"
"                   <b> \"Laporan / Laporan CV Terkirim\".</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automation:</b> Each pipeline stage can be configured to send automated "
"emails to maintain consistent\n"
"                    communication with candidates."
msgstr ""
"<b>Otomatisasi:</b> Setiap pipeline dapat dikonfigurasi untuk mengirim email "
"otomatis guna menjaga\n"
"                    komunikasi yang konsisten dengan para kandidat."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Availability Tracking:</b> For every applicant, you can toggle their "
"status (Available/Unavailable) or\n"
"                    set a specific \"Available From\" date."
msgstr ""
"<b>Pelacakan Ketersediaan:</b> Untuk setiap pelamar, Anda dapat mengubah "
"statusnya (Tersedia/Tidak Tersedia) atau\n"
"                    menetapkan tanggal \"Tersedia dari\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Bill:</b> Once the successful candidates are hired, proceed to "
"<b>invoice</b> the Sales Order."
msgstr ""
"<b>Tagihan:</b> Setelah kandidat yang lolos direkrut, lanjutkan ke proses "
"<b>penagihan</b> Sales Order."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Configure</b> client details and grant portal access to the hiring team."
msgstr ""
"<b>Konfigurasikan</b> detail klien dan berikan akses portal kepada tim "
"perekrutan."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Convert to Talent:</b> The candidate is now a \"Talent.\" From their "
"profile, you can now instantly apply\n"
"                    them to any other open positions."
msgstr ""
"<b>Konversi ke Talenta:</b> Kandidat tersebut kini berstatus \"Talenta\". "
"Dari profilnya, Anda kini dapat langsung mengajukannya\n"
"                    ke lowongan lainnya."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Create</b> a new job position"
msgstr "<b>Buat</b> posisi kerja baru"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Define Requirements:</b> Input essential details such as target profile, "
"salary range, and job description."
msgstr ""
"<b>Tentukan Persyaratan:</b> Masukkan detail penting seperti profil target, "
"kisaran gaji, dan deskripsi pekerjaan."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Define</b> key skills required for the job"
msgstr "<b>Tentukan</b> keterampilan utama yang diperlukan untuk posisi ini"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Document Management:</b>"
msgstr "<b>Manajemen Dokumen:</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Done:</b> Fulfilled or inactive job position; these are hidden from the "
"website and automatically\n"
"                            filtered out of your main view."
msgstr ""
"<b>Selesai:</b> Posisi kerja yang telah terisi atau tidak aktif; "
"disembunyikan dari website dan otomatis\n"
"                            disaring dari tampilan utama Anda."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft Sales Order:</b> Once the details are finalized, generate a "
"<b>Quotation</b> from either\n"
"                            the Job Position or the Opportunity; both "
"methods will link the records correctly."
msgstr ""
"<b>Draft Sales Order:</b> Setelah detailnya diselesaikan, buat <b>Penawaran</"
"b> baik dari\n"
"                            Posisi Kerja maupun Peluang; kedua metode "
"tersebut akan menghubungkan record dengan benar."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft:</b> Used for job position awaiting final client approval. You "
"cannot publish these or add\n"
"                            applicants yet."
msgstr ""
"<b>Draft:</b> Digunakan untuk posisi kerja yang masih menunggu persetujuan "
"akhir dari klien. Anda belum dapat memublikasikannya atau menambahkan\n"
"                            pelamar."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>External Settings:</b> For client-based job positions, you can designate "
"the Customer and the\n"
"                    <b>Hiring Team Contact</b>. Members of the Hiring Team "
"Contact will receive emails whenever new CVs are\n"
"                    submitted."
msgstr ""
"<b>Pengaturan Eksternal:</b> Untuk posisi kerja berbasis klien, Anda dapat "
"menentukan Pelanggan dan\n"
"                    <b>Kontak Tim Perekrutan</b>. Anggota Kontak Tim "
"Perekrutan akan menerima email setiap kali ada CV baru\n"
"                    yang dikirimkan."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Flexible Billing:</b> Customize payment terms within the Sales Order "
"based on the specific contract type."
msgstr ""
"<b>Penagihan Fleksibel:</b> Sesuaikan termin pembayaran dalam Sales Order "
"berdasarkan jenis kontrak tertentu."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Generate Job:</b> From the Opportunity, select <b>Create New Job</b>."
msgstr ""
"<b>Buat Pekerjaan:</b> Dari halaman Peluang, pilih <b>Buat Pekerjaan Baru</"
"b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Go Live</b> by switching the status to \"Open.\""
msgstr "<b>Go Live</b> dengan mengubah statusnya menjadi \"Terbuka\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Independent Pipelines:</b> While core information is linked, each "
"application follows its own unique\n"
"                    recruitment journey, allowing you to track progress for "
"different roles simultaneously."
msgstr ""
"<b>Pipeline Mandiri:</b> Meskipun informasi inti saling terhubung, setiap "
"lamaran mengikuti\n"
"                    pipeline rekrutmen uniknya sendiri sehingga Anda dapat "
"melacak progres untuk berbagai posisi secara bersamaan."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Initiate:</b> Open the CRM app and create a new <b>Opportunity</b> for "
"your client."
msgstr ""
"<b>Memulai:</b> Buka aplikasi CRM dan buat <b>Peluang</b> baru untuk klien "
"Anda."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Internal Files:</b> Documents attached to the <b>Chatter</b> are private "
"and for internal use\n"
"                            only."
msgstr ""
"<b>File Internal:</b> Dokumen yang dilampirkan pada <b>Chatter</b> bersifat "
"pribadi dan hanya untuk penggunaan internal\n"
"                            saja."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Invoicing:</b> Once the Sales Order is signed, you can proceed to "
"generate the invoice according to the agreed-upon terms."
msgstr ""
"<b>Faktur:</b> Setelah Sales Order ditandatangani, Anda dapat melanjutkan ke "
"pembuatan faktur sesuai dengan ketentuan yang telah disepakati."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Job Positions:</b> Define your requirements, website listings, and "
"necessary skills."
msgstr ""
"<b>Posisi Kerja:</b> Tentukan persyaratan, deskripsi lowongan di website, "
"dan keterampilan yang diperlukan."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Key Configuration Rules</b>"
msgstr "<b>Aturan Konfigurasi Utama</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Locate the Candidate:</b> Find the new application within that Job "
"Position in the back-end."
msgstr ""
"<b>Temukan Kandidat:</b> Temukan lamaran baru untuk Posisi Kerja tersebut di "
"back-end."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Login:</b> john.smith@fifth.example.com <b>Password:</b> john"
msgstr "<b>Login:</b> john.smith@fifth.example.com <b>Password:</b> john"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Manual Entry:</b> Creating a record directly within the specific Job "
"Position pipeline."
msgstr ""
"<b>Entri Manual:</b> Membuat record langsung dari pipeline Posisi Kerja "
"tertentu."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Open:</b> Active roles that are ready for publication."
msgstr "<b>Dibuka:</b> Peran aktif yang siap dipublikasikan."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Opportunity Creation → Quotation/Sales Order → Invoicing.</b>"
msgstr "<b>Pembuatan Peluang → Penawaran/Sales Order → Faktur.</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Publish</b> and customize the job description on the website"
msgstr "<b>Publikasikan</b> dan sesuaikan deskripsi pekerjaan di website"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Real-Time Synchronization:</b> This centralized view ensures that if you "
"update a candidate’s\n"
"                    availability (e.g., they are hired elsewhere), that "
"status updates instantly across all client portals where\n"
"                    that CV was shared."
msgstr ""
"<b>Sinkronisasi Real-Time:</b> Tampilan terpusat ini memastikan bahwa jika "
"Anda memperbarui\n"
"                    ketersediaan kandidat (misalnya kandidat telah diterima "
"di tempat lain), pembaruan status tersebut langsung tercermin di semua "
"portal klien tempat\n"
"                    CV tersebut dibagikan."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Recruit:</b> Your recruitment team can now begin their search."
msgstr ""
"<b>Rekrutmen:</b> Tim rekrutmen Anda kini dapat memulai pencarian mereka."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Recruitment Type:</b> Distinguish between <b>Internal</b> (hiring for "
"your own firm) and\n"
"                    <b>External</b> (hiring on behalf of a client)."
msgstr ""
"<b>Jenis Rekrutmen:</b> Bedakan antara <b>Internal</b> (merekrut untuk "
"perusahaan sendiri) dan\n"
"                   <b> Eksternal</b> (merekrut atas nama klien)."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Scheduling:</b> Ensure your Appointment app is synced to allow candidates "
"to book meetings based on your\n"
"                    real-time availability."
msgstr ""
"<b>Penjadwalan:</b> Pastikan aplikasi Appointment Anda telah disinkronkan "
"agar kandidat dapat menjadwalkan pertemuan berdasarkan\n"
"                    ketersediaan Anda secara real-time."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Seamless Application: </b>When a Talent is moved to a job position, the "
"system creates a linked duplicate\n"
"                    for that specific role, ensuring organized record-"
"keeping."
msgstr ""
"<b>Lamaran Lancar: </b>Ketika Talenta dipindahkan ke suatu posisi kerja, "
"sistem akan membuat duplikat yang tertaut\n"
"                    untuk peran tersebut agar penyimpanan record tetap rapi."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>See It In Action!</b>"
msgstr "<b>Lihat Cara Kerjanya!</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Shared Files:</b> Documents uploaded to the <b>Shared CV</b> field are "
"customer-facing. These are\n"
"                            the files sent via email to clients and "
"published on the Customer Portal."
msgstr ""
"<b>File Bersama:</b> Dokumen yang diunggah ke field <b>CV yang Dibagikan</b> "
"adalah dokumen yang ditujukan kepada pelanggan. File-file\n"
"                            ini dikirim melalui email kepada klien dan "
"dipublikasikan di Portal Pelanggan."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Smart Syncing:</b> Most data is shared between the Talent profile and "
"their specific job applications.\n"
"                    For example, updating a candidate's <b>availability</b> "
"in the Talent Pool automatically updates it across\n"
"                    all their active applications."
msgstr ""
"<b>Sinkronisasi Cerdas:</b> Sebagian besar data dibagikan antara profil "
"Talenta dan lamaran kerja mereka.\n"
"                    Misalnya, jika <b>ketersediaan</b> kandidat di Talent "
"Pool diperbarui, data tersebut otomatis diperbarui juga di\n"
"                    semua lamaran aktif mereka."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Source</b> the perfect candidate from your existing talent pool or new "
"applicants."
msgstr ""
"<b>Dapatkan</b> kandidat yang tepat dari kelompok talenta yang sudah ada "
"atau pelamar baru."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Status Indicators:</b>"
msgstr "<b>Indikator Status:</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Status Management:</b> New positions are created in <b>Draft</b> mode by "
"default, preventing premature\n"
"                    publication or applications."
msgstr ""
"<b>Manajemen Status:</b> Posisi baru dibuat dalam mode <b>Draft</b> secara "
"default, untuk mencegah\n"
"                    publikasi atau lamaran yang belum final."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Step-by-Step Recruitment Process</b>"
msgstr "<b>Proses Rekrutmen Langkah demi Langkah</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Submit an Entry:</b> Go to the website and apply for the <b>Open "
"Application</b> job."
msgstr ""
"<b>Kirimkan Lamaran:</b> Kunjungi Website dan ajukan lamaran untuk "
"<b>Lowongan Aktif</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pool:</b> Promoting an existing talent record using the \"Apply "
"Job\" button."
msgstr ""
"<b>Kelompok Talenta:</b> Mempromosikan record talenta yang sudah ada "
"menggunakan tombol \"Lamar\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pools:</b> Maintain a database of qualified candidates ready for "
"future roles."
msgstr ""
"<b>Kelompok Talenta:</b> Kelola database kandidat yang memenuhi syarat dan "
"siap untuk mengisi peran mendatang."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>The Customer Portal:</b> Clients can log into their Odoo portal to view "
"their Sales Orders, Invoices, and\n"
"                    the <b>Applications</b> you have shared from the "
"previous report."
msgstr ""
"<b>Portal Pelanggan:</b> Klien dapat masuk ke portal Odoo miliknya untuk "
"melihat Sales Order, Faktur, dan\n"
"                    <b>Aplikasi</b> yang telah Anda bagikan dari laporan "
"sebelumnya."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Website Integration:</b> Direct applications from your website’s job "
"board."
msgstr ""
"<b>Integrasi Website:</b> Kirim lamaran langsung dari papan lowongan kerja "
"website Anda."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Website Integration:</b> Once a position is set to \"Open,\" ensure the "
"public listing is formatted\n"
"                    correctly for your website."
msgstr ""
"<b>Integrasi Website:</b> Setelah suatu posisi ditetapkan sebagai "
"\"Dibuka\", pastikan daftar publik diformat\n"
"                    dengan benar untuk website Anda."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.view_page_home
msgid ""
"<br/>\n"
"                                            <span class=\"h5-fs\">Back to "
"what <strong>headhunting</strong> truly means.</span>\n"
"                                            <span class=\"o_text_highlight "
"o_text_highlight_underline\" style=\"--text-highlight-color: #3D5AFE; --text-"
"highlight-width: 3px; font-size: 20px;\">\n"
"                                                <strong>Zenith</strong>\n"
"                                            </span>\n"
"                                            <span class=\"h5-fs\"> connects "
"demanding organizations with exceptional executives the top 1% who won't "
"answer a job posting.</span>"
msgstr ""

