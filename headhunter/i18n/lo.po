msgstr "<b>2. ການຄັດກອງ &amp; ການເພີ່ມຕື່ມຂໍ້ມູນ</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>3. Interview Scheduling</b>"
msgstr "<b>3. ການກຳນົດເວລາສຳພາດ</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">CRM</font>:</b> Streamlines daily "
"discussions with potential clients."
msgstr ""
"<b><font class=\"text-o-color-1\">CRM</font>:</b> "
"ຊ່ວຍໃຫ້ການຕິດຕໍ່ສື່ສານປະຈຳວັນກັບລູກຄ້າກຸ່ມເປົ້າໝາຍສະດວກ ແລະ ວ່ອງໄວຂຶ້ນ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Recruitment App:</font></b> Tracks all "
"talent and their applications within a clear pipeline"
msgstr ""
"<b><font class=\"text-o-color-1\">ແອັບການສັນຫາ (Recruitment):</font></b> "
"ຕິດຕາມຜູ້ມີຄວາມສາມາດທັງໝົດ ແລະ ໃບສະໝັກງານຕາມຂັ້ນຕອນຢ່າງຈະແຈ້ງ"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Sales &amp; Invoicing App</font>:</b> "
"Maintains a clear, automated record of all\n"
"                financial transactions."
msgstr ""
"<b><font class=\"text-o-color-1\">ແອັບການຂາຍ &amp; ການອອກໃບແຈ້ງໜີ້</font>:</b> "
"ບັນທຶກທຸກທຸລະກຳທາງການເງິນຢ່າງຈະແຈ້ງ\n"
"                ແລະ ເປັນລະບົບອັດຕະໂນມັດ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b><font class=\"text-o-color-1\">Website App:</font></b> Drives visibility "
"about open positions"
msgstr ""
"<b><font class=\"text-o-color-1\">ແອັບເວັບໄຊ:</font></b> ຊ່ວຍເພີ່ມການເຂົ້າເຖິງ ແລະ "
"ການເບິ່ງເຫັນຕຳແໜ່ງງານທີ່ເປີດຮັບ"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activate:</b> After the quotation is signed, update the Job Position "
"status to <b>Open</b>."
msgstr ""
"<b>ເປີດນຳໃຊ້:</b> ຫຼັງຈາກເຊັນໃບສະເໜີລາຄາແລ້ວ, ໃຫ້ປ່ຽນສະຖານະຂອງຕຳແໜ່ງງານເປັນ <b>ເປີດຮັບ</"
"b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Activation:</b> Once the Sales Order is validated by the client, manually "
"update the status to\n"
"                    <b>\"Open\"</b> to begin active sourcing."
msgstr ""
"<b>ການເປີດນຳໃຊ້:</b> ເມື່ອລູກຄ້າຢືນຢັນໃບສັ່ງຂາຍແລ້ວ, ໃຫ້ປ່ຽນສະຖານະດ້ວຍຕົນເອງເປັນ\n"
"                    <b>\"ເປີດຮັບ\"</b> ເພື່ອເລີ່ມຕົ້ນການຊອກຫາຜູ້ສະໝັກ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Add to Pool:</b> Select the application and click the <b>Add to Pool</b> "
"button."
msgstr "<b>ເພີ່ມໃສ່ຄັງ:</b> ເລືອກໃບສະໝັກ ແລ້ວກົດປຸ່ມ <b>ເພີ່ມໃສ່ຄັງ</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Applicants:</b> Track active candidates through the recruitment pipeline "
"for each job position."
msgstr "<b>ຜູ້ສະໝັກ:</b> ຕິດຕາມຜູ້ສະໝັກໃນແຕ່ລະຂັ້ນຕອນການສັນຫາຂອງແຕ່ລະຕຳແໜ່ງງານ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automatic Tracking:</b> This action automatically creates a line for this "
"candidate into the\n"
"                    <b>\"Reporting / Cv sent Report.\"</b>"
msgstr ""
"<b>ການຕິດຕາມອັດຕະໂນມັດ:</b> ການດຳເນີນການນີ້ຈະສ້າງລາຍການສຳລັບຜູ້ສະໝັກຄົນນີ້ເຂົ້າໃນ\n"
"                    <b>\"ລາຍງານ / ລາຍງານການສົ່ງ CV\"</b> ໂດຍອັດຕະໂນມັດ"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Automation:</b> Each pipeline stage can be configured to send automated "
"emails to maintain consistent\n"
"                    communication with candidates."
msgstr ""
"<b>ລະບົບອັດຕະໂນມັດ:</b> ແຕ່ລະຂັ້ນຕອນສາມາດຕັ້ງຄ່າໃຫ້ສົ່ງອີເມວອັດຕະໂນມັດ "
"ເພື່ອຮັກສາການສື່ສານກັບຜູ້ສະໝັກຢ່າງຕໍ່ເນື່ອງ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Availability Tracking:</b> For every applicant, you can toggle their "
"status (Available/Unavailable) or\n"
"                    set a specific \"Available From\" date."
msgstr ""
"<b>ການຕິດຕາມຄວາມພ້ອມ:</b> ສຳລັບຜູ້ສະໝັກທຸກຄົນ, ທ່ານສາມາດປັບປ່ຽນສະຖານະ (ວ່າງ/ບໍ່ວ່າງ) ຫຼື\n"
"                    ກຳນົດວັນທີທີ່ສະເພາະເຈາະຈົງໃນ \"ພ້ອມເລີ່ມວຽກຕັ້ງແຕ່\" ໄດ້."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Bill:</b> Once the successful candidates are hired, proceed to "
"<b>invoice</b> the Sales Order."
msgstr ""
"<b>ເກັບເງິນ:</b> ເມື່ອຮັບຜູ້ສະໝັກເຂົ້າເຮັດວຽກແລ້ວ, ໃຫ້ດຳເນີນການ <b>ອອກໃບແຈ້ງໜີ້</b> "
"ຈາກໃບສັ່ງຂາຍ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Configure</b> client details and grant portal access to the hiring team."
msgstr "<b>ກຳນົດຄ່າ</b> ລາຍລະອຽດຂອງລູກຄ້າ ແລະ ອະນຸຍາດການເຂົ້າເຖິງພອດທັລໃຫ້ແກ່ທີມງານຮັບສະໝັກ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Convert to Talent:</b> The candidate is now a \"Talent.\" From their "
"profile, you can now instantly apply\n"
"                    them to any other open positions."
msgstr ""
"<b>ປ່ຽນເປັນບຸກຄະລາກອນ:</b> ຕອນນີ້ຜູ້ສະໝັກໄດ້ກາຍເປັນ \"Talent\" ແລ້ວ. "
"ຈາກໂປຣໄຟລ໌ຂອງພວກເຂົາ, ທ່ານສາມາດນຳໄປສະໝັກໃນຕຳແໜ່ງອື່ນໆທີ່ເປີດຮັບໄດ້ທັນທີ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Create</b> a new job position"
msgstr "<b>ສ້າງ</b> ຕຳແໜ່ງງານໃໝ່"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Define Requirements:</b> Input essential details such as target profile, "
"salary range, and job description."
msgstr ""
"<b>ກຳນົດເງື່ອນໄຂ:</b> ປ້ອນລາຍລະອຽດທີ່ສຳຄັນ ເຊັ່ນ: ໂປຣໄຟລ໌ເປົ້າໝາຍ, ອັດຕາເງິນເດືອນ ແລະ "
"ຄຳອະທິບາຍໜ້າວຽກ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Define</b> key skills required for the job"
msgstr "<b>ກຳນົດ</b> ທັກສະຫຼັກທີ່ຈຳເປັນສຳລັບວຽກ"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Document Management:</b>"
msgstr "<b>ການຈັດການເອກະສານ:</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Done:</b> Fulfilled or inactive job position; these are hidden from the "
"website and automatically\n"
"                            filtered out of your main view."
msgstr ""
"<b>ສຳເລັດ:</b> ຕຳແໜ່ງງານທີ່ຮັບຄົນຄົບແລ້ວ ຫຼື ປິດການໃຊ້ງານ; ລາຍການເຫຼົ່ານີ້ຈະຖືກເຊື່ອງຈາກໜ້າເວັບໄຊ "
"ແລະ ຖືກກັ່ນຕອງອອກຈາກມຸມມອງຫຼັກໂດຍອັດຕະໂນມັດ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft Sales Order:</b> Once the details are finalized, generate a "
"<b>Quotation</b> from either\n"
"                            the Job Position or the Opportunity; both "
"methods will link the records correctly."
msgstr ""
"<b>ຮ່າງໃບສັ່ງຂາຍ:</b> ເມື່ອລາຍລະອຽດຄົບຖ້ວນແລ້ວ, ໃຫ້ສ້າງ <b>ໃບສະເໜີລາຄາ</b> ຈາກຕຳແໜ່ງງານ "
"ຫຼື ໂອກາດທາງການຂາຍ; ທັງສອງວິທີຈະເຊື່ອມໂຍງຂໍ້ມູນເຂົ້າຫາກັນຢ່າງຖືກຕ້ອງ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Draft:</b> Used for job position awaiting final client approval. You "
"cannot publish these or add\n"
"                            applicants yet."
msgstr ""
"<b>ສະບັບຮ່າງ:</b> ໃຊ້ສຳລັບຕຳແໜ່ງງານທີ່ລໍຖ້າການອະນຸມັດຂັ້ນສຸດທ້າຍຈາກລູກຄ້າ. ທ່ານຍັງບໍ່ສາມາດເຜີຍແຜ່ ຫຼື "
"ເພີ່ມຜູ້ສະໝັກໄດ້."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>External Settings:</b> For client-based job positions, you can designate "
"the Customer and the\n"
"                    <b>Hiring Team Contact</b>. Members of the Hiring Team "
"Contact will receive emails whenever new CVs are\n"
"                    submitted."
msgstr ""
"<b>ການຕັ້ງຄ່າພາຍນອກ:</b> ສຳລັບຕຳແໜ່ງງານຂອງລູກຄ້າ, ທ່ານສາມາດກຳນົດລູກຄ້າ ແລະ\n"
"                    <b>ຜູ້ຕິດຕໍ່ຂອງທີມງານຮັບສະໝັກ</b>. "
"ສະມາຊິກໃນທີມຈະໄດ້ຮັບອີເມວທຸກຄັ້ງທີ່ມີການສົ່ງ CV ໃໝ່."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Flexible Billing:</b> Customize payment terms within the Sales Order "
"based on the specific contract type."
msgstr ""
"<b>ການຄິດໄລ່ເງິນທີ່ຢືດຢຸ່ນ:</b> ກຳນົດເງື່ອນໄຂການຊຳລະເງິນໃນໃບສັ່ງຂາຍຕາມປະເພດສັນຍາສະເພາະ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Generate Job:</b> From the Opportunity, select <b>Create New Job</b>."
msgstr "<b>ສ້າງຕຳແໜ່ງງານ:</b> ຈາກໜ້າໂອກາດທາງການຂາຍ, ໃຫ້ເລືອກ <b>ສ້າງຕຳແໜ່ງງານໃໝ່</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Go Live</b> by switching the status to \"Open.\""
msgstr "<b>ເປີດໃຊ້ງານຕົວຈິງ</b> ໂດຍການປ່ຽນສະຖານະເປັນ \"ເປີດຮັບ.\""

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Independent Pipelines:</b> While core information is linked, each "
"application follows its own unique\n"
"                    recruitment journey, allowing you to track progress for "
"different roles simultaneously."
msgstr ""
"<b>ຂັ້ນຕອນການເຮັດວຽກທີ່ເປັນອິດສະຫຼະ:</b> ເຖິງວ່າຂໍ້ມູນຫຼັກຈະເຊື່ອມໂຍງກັນ, "
"ແຕ່ໃບສະໝັກແຕ່ລະສະບັບຈະມີຂັ້ນຕອນການສັນຫາສະເພາະຂອງຕົນເອງ "
"ເຮັດໃຫ້ທ່ານສາມາດຕິດຕາມຄວາມຄືບໜ້າຂອງຫຼາຍຕຳແໜ່ງໄປພ້ອມກັນໄດ້."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Initiate:</b> Open the CRM app and create a new <b>Opportunity</b> for "
"your client."
msgstr "<b>ເລີ່ມຕົ້ນ:</b> ເປີດແອັບ CRM ແລະ ສ້າງ <b>ໂອກາດ</b> ໃໝ່ສຳລັບລູກຄ້າຂອງທ່ານ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Internal Files:</b> Documents attached to the <b>Chatter</b> are private "
"and for internal use\n"
"                            only."
msgstr ""
"<b>ເອກະສານພາຍໃນ:</b> ເອກະສານທີ່ຕິດຄັດໃນ <b>Chatter</b> ແມ່ນເປັນຄວາມລັບ ແລະ "
"ສຳລັບການນຳໃຊ້ພາຍໃນເທົ່ານັ້ນ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Invoicing:</b> Once the Sales Order is signed, you can proceed to "
"generate the invoice according to the agreed-upon terms."
msgstr ""
"<b>ການອອກໃບແຈ້ງໜີ້:</b> ເມື່ອໃບສັ່ງຂາຍໄດ້ຮັບການເຊັນແລ້ວ, "
"ທ່ານສາມາດດຳເນີນການອອກໃບແຈ້ງໜີ້ຕາມເງື່ອນໄຂທີ່ຕົກລົງກັນໄວ້."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Job Positions:</b> Define your requirements, website listings, and "
"necessary skills."
msgstr "<b>ຕຳແໜ່ງງານ:</b> ກຳນົດຄວາມຕ້ອງການ, ການສະແດງເທິງເວັບໄຊ ແລະ ທັກສະທີ່ຈຳເປັນ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Key Configuration Rules</b>"
msgstr "<b>ກົດລະບຽບການກຳນົດຄ່າຫຼັກ</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Locate the Candidate:</b> Find the new application within that Job "
"Position in the back-end."
msgstr "<b>ຄົ້ນຫາຜູ້ສະໝັກ:</b> ຊອກຫາໃບສະໝັກໃໝ່ໃນຕຳແໜ່ງງານນັ້ນຜ່ານລະບົບຫຼັງບ້ານ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Login:</b> john.smith@fifth.example.com <b>Password:</b> john"
msgstr "<b>ເຂົ້າສູ່ລະບົບ:</b> john.smith@fifth.example.com <b>ລະຫັດຜ່ານ:</b> john"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Manual Entry:</b> Creating a record directly within the specific Job "
"Position pipeline."
msgstr "<b>ການປ້ອນຂໍ້ມູນດ້ວຍຕົນເອງ:</b> ສ້າງລາຍການໂດຍກົງໃນຂັ້ນຕອນການສັນຫາຂອງຕຳແໜ່ງງານນັ້ນໆ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Open:</b> Active roles that are ready for publication."
msgstr "<b>ເປີດຮັບ:</b> ຕຳແໜ່ງທີ່ກຳລັງເປີດຢູ່ ແລະ ພ້ອມສຳລັບການເຜີຍແຜ່."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Opportunity Creation → Quotation/Sales Order → Invoicing.</b>"
msgstr "<b>ການສ້າງໂອກາດ → ໃບສະເໜີລາຄາ/ໃບສັ່ງຂາຍ → ການອອກໃບແຈ້ງໜີ້.</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Publish</b> and customize the job description on the website"
msgstr "<b>ເຜີຍແຜ່</b> ແລະ ປັບແຕ່ງລາຍລະອຽດໜ້າວຽກເທິງເວັບໄຊ"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Real-Time Synchronization:</b> This centralized view ensures that if you "
"update a candidate’s\n"
"                    availability (e.g., they are hired elsewhere), that "
"status updates instantly across all client portals where\n"
"                    that CV was shared."
msgstr ""
"<b>ການເຊື່ອມໂຍງຂໍ້ມູນແບບທັນທີ:</b> ມຸມມອງສູນກາງນີ້ຊ່ວຍໃຫ້ໝັ້ນໃຈໄດ້ວ່າ "
"ຖ້າທ່ານອັບເດດຄວາມພ້ອມຂອງຜູ້ສະໝັກ (ເຊັ່ນ: ພວກເຂົາຖືກຈ້າງຢູ່ບ່ອນອື່ນແລ້ວ), "
"ສະຖານະນັ້ນຈະອັບເດດທັນທີໃນທຸກພອດທັລຂອງລູກຄ້າທີ່ CV ນັ້ນເຄີຍຖືກແບ່ງປັນ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Recruit:</b> Your recruitment team can now begin their search."
msgstr "<b>ສັນຫາ:</b> ຕອນນີ້ທີມງານສັນຫາຂອງທ່ານສາມາດເລີ່ມຕົ້ນການຊອກຫາໄດ້ແລ້ວ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Recruitment Type:</b> Distinguish between <b>Internal</b> (hiring for "
"your own firm) and\n"
"                    <b>External</b> (hiring on behalf of a client)."
msgstr ""
"<b>ປະເພດການສັນຫາ:</b> ແຍກຄວາມແຕກຕ່າງລະຫວ່າງ <b>ພາຍໃນ</b> "
"(ການຈ້າງງານສຳລັບບໍລິສັດຂອງທ່ານເອງ) ແລະ\n"
"                    <b>ພາຍນອກ</b> (ການຈ້າງງານໃນນາມລູກຄ້າ)."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Scheduling:</b> Ensure your Appointment app is synced to allow candidates "
"to book meetings based on your\n"
"                    real-time availability."
msgstr ""
"<b>ການນັດໝາຍ:</b> ກວດສອບໃຫ້ແນ່ໃຈວ່າແອັບການນັດໝາຍຂອງທ່ານຖືກເຊື່ອມໂຍງແລ້ວ "
"ເພື່ອໃຫ້ຜູ້ສະໝັກສາມາດຈອງເວລານັດພົບຕາມເວລາຫວ່າງຕົວຈິງຂອງທ່ານ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Seamless Application: </b>When a Talent is moved to a job position, the "
"system creates a linked duplicate\n"
"                    for that specific role, ensuring organized record-"
"keeping."
msgstr ""
"<b>ການສະໝັກແບບຕໍ່ເນື່ອງ: </b>ເມື່ອຍ້າຍບຸກຄະລາກອນໄປຍັງຕຳແໜ່ງງານໃດໜຶ່ງ, "
"ລະບົບຈະສ້າງຂໍ້ມູນຊ້ຳທີ່ເຊື່ອມໂຍງກັນສຳລັບຕຳແໜ່ງນັ້ນ ເພື່ອຄວາມເປັນລະບຽບຮຽບຮ້ອຍໃນການບັນທຶກ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>See It In Action!</b>"
msgstr "<b>ເບິ່ງການເຮັດວຽກຕົວຈິງ!</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Shared Files:</b> Documents uploaded to the <b>Shared CV</b> field are "
"customer-facing. These are\n"
"                            the files sent via email to clients and "
"published on the Customer Portal."
msgstr ""
"<b>ໄຟລ໌ທີ່ແບ່ງປັນ:</b> ເອກະສານທີ່ອັບໂຫຼດລົງໃນຊ່ອງ <b>Shared CV</b> ແມ່ນສຳລັບລູກຄ້າ. "
"ເຫຼົ່ານີ້ຄືໄຟລ໌ທີ່ຈະສົ່ງຜ່ານອີເມວຫາລູກຄ້າ ແລະ ເຜີຍແຜ່ເທິງ Customer Portal."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Smart Syncing:</b> Most data is shared between the Talent profile and "
"their specific job applications.\n"
"                    For example, updating a candidate's <b>availability</b> "
"in the Talent Pool automatically updates it across\n"
"                    all their active applications."
msgstr ""
"<b>ການຊິງຄ໌ຂໍ້ມູນອັດສະລິຍະ:</b> ຂໍ້ມູນສ່ວນໃຫຍ່ຈະເຊື່ອມໂຍງລະຫວ່າງໂປຣໄຟລ໌ບຸກຄະລາກອນ ແລະ "
"ໃບສະໝັກສະເພາະຕຳແໜ່ງ. ຕົວຢ່າງ: ການອັບເດດ <b>ຄວາມພ້ອມ</b> ຂອງຜູ້ສະໝັກໃນຄັງບຸກຄະລາກອນ "
"ຈະອັບເດດໄປຍັງທຸກໆໃບສະໝັກທີ່ຍັງເປີດຢູ່ໂດຍອັດຕະໂນມັດ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Source</b> the perfect candidate from your existing talent pool or new "
"applicants."
msgstr "<b>ສັນຫາ</b> ຜູ້ສະໝັກທີ່ເໝາະສົມທີ່ສຸດຈາກຄັງບຸກຄະລາກອນທີ່ມີຢູ່ ຫຼື ຈາກຜູ້ສະໝັກໃໝ່."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Status Indicators:</b>"
msgstr "<b>ຕົວບົ່ງບອກສະຖານະ:</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Status Management:</b> New positions are created in <b>Draft</b> mode by "
"default, preventing premature\n"
"                    publication or applications."
msgstr ""
"<b>ການຈັດການສະຖານະ:</b> ຕຳແໜ່ງໃໝ່ຈະຖືກສ້າງໃນຮູບແບບ <b>ສະບັບຮ່າງ</b> ໂດຍຄ່າເລີ່ມຕົ້ນ "
"ເພື່ອປ້ອງກັນການເຜີຍແຜ່ ຫຼື ການຮັບສະໝັກກ່ອນກຳນົດ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid "<b>Step-by-Step Recruitment Process</b>"
msgstr "<b>ຂັ້ນຕອນການສັນຫາແບບລະອຽດ</b>"

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Submit an Entry:</b> Go to the website and apply for the <b>Open "
"Application</b> job."
msgstr ""
"<b>ສົ່ງຂໍ້ມູນສະໝັກ:</b> ໄປທີ່ໜ້າເວັບໄຊ ແລະ ສະໝັກໃນຕຳແໜ່ງ <b>ເປີດຮັບທົ່ວໄປ (Open "
"Application)</b>."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pool:</b> Promoting an existing talent record using the \"Apply "
"Job\" button."
msgstr "<b>ຄັງບຸກຄະລາກອນ:</b> ສົ່ງຕໍ່ຂໍ້ມູນບຸກຄະລາກອນທີ່ມີຢູ່ໂດຍໃຊ້ປຸ່ມ \"ສະໝັກງານ\"."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Talent Pools:</b> Maintain a database of qualified candidates ready for "
"future roles."
msgstr "<b>ຄັງບຸກຄະລາກອນ:</b> ຮັກສາຖານຂໍ້ມູນຂອງຜູ້ສະໝັກທີ່ມີຄຸນນະວຸດທິພ້ອມສຳລັບຕຳແໜ່ງໃນອະນາຄົດ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>The Customer Portal:</b> Clients can log into their Odoo portal to view "
"their Sales Orders, Invoices, and\n"
"                    the <b>Applications</b> you have shared from the "
"previous report."
msgstr ""
"<b>Customer Portal:</b> ລູກຄ້າສາມາດເຂົ້າສູ່ລະບົບພອດທັລ Odoo ເພື່ອເບິ່ງໃບສັ່ງຂາຍ, ໃບແຈ້ງໜີ້ "
"ແລະ <b>ໃບສະໝັກ</b> ທີ່ທ່ານໄດ້ແບ່ງປັນຈາກລາຍງານກ່ອນໜ້ານີ້."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Website Integration:</b> Direct applications from your website’s job "
"board."
msgstr "<b>ການເຊື່ອມໂຍງເວັບໄຊ:</b> ຮັບໃບສະໝັກໂດຍກົງຈາກກະດານຮັບສະໝັກງານເທິງເວັບໄຊຂອງທ່ານ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.welcome_article_body
msgid ""
"<b>Website Integration:</b> Once a position is set to \"Open,\" ensure the "
"public listing is formatted\n"
"                    correctly for your website."
msgstr ""
"<b>ການເຊື່ອມໂຍງເວັບໄຊ:</b> ເມື່ອຕຳແໜ່ງຖືກຕັ້ງເປັນ \"ເປີດຮັບ\", "
"ໃຫ້ກວດສອບວ່າການສະແດງຜົນສາທາລະນະຖືກຈັດຮູບແບບຢ່າງຖືກຕ້ອງເທິງເວັບໄຊຂອງທ່ານ."

#. module: headhunter
#: model_terms:ir.ui.view,arch_db:headhunter.view_page_home
msgid ""
"<br/>\n"
"                                            <span class=\"h5-fs\">Back to "
"what <strong>headhunting</strong> truly means.</span>\n"
"                                            <span class=\"o_text_highlight "
"o_text_highlight_underline\" style=\"--text-highlight-color: #3D5AFE; --text-"
"highlight-width: 3px; font-size: 20px;\">\n"
"                                                <strong>Zenith</strong>\n"
"                                            </span>\n"
"                                            <span class=\"h5-fs\"> connects "
"demanding organizations with exceptional executives the top 1% who won't "
"answer a job posting.</span>"
msgstr ""
"<br/>\n"
"                                            <span class=\"h5-"
"fs\">ຫວນຄືນສູ່ຄວາມໝາຍທີ່ແທ້ຈິງຂອງ <strong>ການສັນຫາຜູ້ບໍລິຫານລະດັບສູງ</strong>.</span>\n"
"                                            <span class=\"o_text_highlight "
"o_text_highlight_underline\" style=\"--text-highlight-color: #3D5AFE; --text-"
"highlight-width: 3px; font-size: 20px;\">\n"
"                                                <strong>Zenith</strong>\n"
"                                            </span>\n"
"                                            <span class=\"h5-fs\"> "
"ເຊື່ອມໂຍງອົງກອນຊັ້ນນຳເຂົ້າກັບຜູ້ບໍລິຫານລະດັບຫົວກະທິ 1% ທີ່ບໍ່ສະໝັກວຽກຜ່ານການປະກາດທົ່ວໄປ.</span>"

