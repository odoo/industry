<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <record id="data_merge_model_hr_applicant" model="data_merge.model">
        <field name="name">Applicant</field>
        <field name="res_model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="domain">[("job_id", "=", False)]</field>
        <field name="similarity_threshold">50</field>
    </record>
    <record id="data_merge_field_applicant_partner_id" model="data_merge.rule">
        <field name="model_id" ref="data_merge_model_hr_applicant"/>
        <field name="field_id" ref="hr_recruitment.field_hr_applicant__partner_id"/>
    </record>
    <record id="data_merge_field_applicant_email_from" model="data_merge.rule">
        <field name="model_id" ref="data_merge_model_hr_applicant"/>
        <field name="field_id" ref="hr_recruitment.field_hr_applicant__email_from"/>
        <field name="match_mode">accent</field>
    </record>
    <record id="data_merge_field_applicant_partner_name" model="data_merge.rule">
        <field name="model_id" ref="data_merge_model_hr_applicant"/>
        <field name="field_id" ref="hr_recruitment.field_hr_applicant__partner_name"/>
        <field name="match_mode">accent</field>
    </record>
    <record id="data_merge_field_applicant_partner_phone" model="data_merge.rule">
        <field name="model_id" ref="data_merge_model_hr_applicant"/>
        <field name="field_id" ref="hr_recruitment.field_hr_applicant__partner_phone"/>
    </record>
    <record id="data_merge_field_applicant_linkedin_profile" model="data_merge.rule">
        <field name="model_id" ref="data_merge_model_hr_applicant"/>
        <field name="field_id" ref="hr_recruitment.field_hr_applicant__linkedin_profile"/>
    </record>
</odoo>
