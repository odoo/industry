<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="template_footer_mega" model="ir.ui.view">
        <field name="name">Zenith Hunting - Mega</field>
        <field name="key">website.template_footer_mega</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block oe_img_bg o_bg_img_center o_bg_img_origin_border_box pt32 pb0" data-snippet="s_text_block" data-name="Top Part" data-format-mimetype="image/webp" style="background-image: url(&quot;/web/image/headhunter.img_custom_zenith_image_22&quot;); position: relative;" data-resize-width="1920" data-mimetype="image/webp">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-2 pb24 o_colored_level pt0">
                                    <h5>Navigation</h5>
                                    <ul class="list-unstyled">
                                        <li><a href="/">Home</a></li>
                                        <li><a href="/our-services">Services</a></li>
                                        <li><a href="/jobs">Jobs</a></li>
                                        <li><a href="/about-us">About</a></li>
                                        <li><a href="/contactus">Contact</a></li>

                                    </ul>
                                </div>
                                <div class="col-lg-2 pb24 o_colored_level pt0">
                                    <h5>Services</h5>
                                    <ul class="list-unstyled">
                                        <li><a href="/our-services">C-Suite Executive Search</a></li>
                                        <li><a href="/our-services">Board Member Placement</a></li>
                                        <li><a href="/our-services">VP &amp; Director Level</a></li>
                                        <li><a href="/our-services">Confidential Succession</a></li>
                                    </ul>
                                </div>
                                <div class="col-lg-5 pb24 o_colored_level pt0">
                                    <h5>Get in touch</h5>
                                    <ul class="list-unstyled">
                                        <li><a href="mailto:info@zenith-hunting.com">info@zenith-hunting.com</a></li>
                                        <li><a href="tel:+1 650-691-3277"><span class="o_force_ltr">+1 650-691-3277</span></a></li>
                                    </ul>
                                    <div>250 Executive Park Blvd, Suite 3400</div><p>San Francisco, CA 94134</p>
                                </div>
                                <div class="col-lg-2 col-5 offset-lg-1 pb24 o_colored_level pt8">
                                    <a href="/" class="o_footer_logo logo o-float-start-parent">
                                        <img src="/web/image/headhunter.img_custom_zenith_image_23" alt="" class="img-fluid float-start me-auto img o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="690" data-mimetype="image/webp" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="col-lg-12 o_colored_level">
                                    <div class="s_hr pb24" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto" style="border-top-color: rgba(255, 255, 255, 0);"/>
                                    </div>
                                </div>
                                <div class="o_colored_level col-lg-5">
                                    <h5>
                                        <span class="h3-fs">Designed for <strong>demanding companies</strong></span>
                                    </h5>
                                    <p>Zenith connects demanding organizations with exceptional executives;&amp;nbsp;the top 1% who won't answer a job posting. Our network runs deep. Our process runs fast.</p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_text_block o_footer_bottom_part pt8 pb8 o_colored_level" style="position: relative; background-color: rgba(0, 0, 0, 0.05);" data-snippet="s_text_block" data-name="Bottom Part">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-6 pt8 pb8 o_colored_level">
                                    <div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <p class="s_social_media_title d-none">Follow us</p>
                                        <a href="https://www.twitter.com/your-page" class="s_social_media_twitter" target="_blank">
                                            <i class="fa fa-twitter fa-stack o_editable_media"/>
                                        </a>
                                        <a href="https://www.linkedin.com/your-page" class="s_social_media_linkedin" target="_blank">
                                            <i class="fa fa-linkedin fa-stack o_editable_media"/>
                                        </a>
                                        <a href="https://www.facebook.com/your-page" class="s_social_media_facebook" target="_blank">
                                            <i class="fa fa-facebook fa-stack o_editable_media"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-6 pt8 pb8 o_colored_level">
                                    <nav class="nav justify-content-lg-end flex-column flex-lg-row">
                                        <a class="nav-link" href="#">Terms and Conditions</a>
                                        <a class="nav-link" href="#">Privacy Policy</a>
                                        <a class="nav-link" href="#">Cookies</a>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
            <xpath expr="//t[@t-call='web.brand_promotion']/.." position="attributes">
                <attribute name="class" remove="text-center" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
