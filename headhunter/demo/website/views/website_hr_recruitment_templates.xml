<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="job_index_top" model="ir.ui.view">
        <field name="name">Zenith Hunting - Jobs Header</field>
        <field name="inherit_id" ref="website_hr_recruitment.index"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_hr_recruitment_index_top']" position="replace">
                <div class="oe_structure" id="oe_structure_hr_recruitment_index_top">
                    <section class="s_splash_intro o_colored_level o_cc o_cc5 pt56 pb88 parallax s_custom_snippet o_three_quarter_height" style="position: relative;" data-snippet="s_splash_intro" data-scroll-background-ratio="-1.2" data-format-mimetype="image/webp" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/01&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#ffffff&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:true,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:false}" data-name="Custom Custom Splash Intro (2)">
                        <span class="s_parallax_bg_wrap">
                            <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/headhunter.img_custom_zenith_image_24&quot;); background-size: cover;" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp"/>
                        </span>
                        <div class="o_we_bg_filter" style="background-color: transparent; background-image: linear-gradient(181deg, rgba(1, 6, 30, 0.45) 0%, rgba(1, 5, 20, 0.34) 56%, rgba(2, 8, 39, 0.71) 100%);"/><div class="o_we_shape o_html_builder_Connections_01 o_shape_show_mobile" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F01.svg?c5=%23ffffff&quot;);"/>
                        <div class="container">
                            <div class="row">
                                <div class="o_colored_level o_animate o_anim_fade_in o_visible o_anim_from_top col-lg-5 pt8 pb8 col-10 offset-1 offset-lg-0" data-scroll-background-ratio="0" style="--wanim-intensity: 3; animation-duration: 2s; animation-name: dummy;">
                                    <div class="s_hr pt32 pb32" data-snippet="s_hr" data-name="Separator">
                                        <hr class="w-100 mx-auto" style="border-top-color: rgba(255, 255, 255, 0);"/>
                                    </div>
                                    <h1 class="display-1">Opportunities</h1>
                                    <p class="lead">
                                        <strong>Our name says it all. Back to the roots of headhunting. Only top notch profiles and nothing else. Best profiles from the market guaranteed.</strong>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>

    <record id="job_index_title" model="ir.ui.view">
        <field name="name">Zenith Hunting - Jobs Title</field>
        <field name="inherit_id" ref="website_hr_recruitment.index"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[hasclass('mb-0')]" position="replace">
                <p class="mb-0"><br/></p>
            </xpath>
        </field>
    </record>

    <record id="job_right_side_bar" model="ir.ui.view">
        <field name="name">Zenith Hunting - Right Side Bar</field>
        <field name="key">website_hr_recruitment.job_right_side_bar</field>
        <field name="inherit_id" ref="website_hr_recruitment.index"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='jobs_grid']" position="after">
                <div class="col-lg-4 oe_structure oe_empty" id="jobs_grid_right" t-ignore="true">
                    <div class="s_hr pt32 pb32 o_colored_level" data-snippet="s_hr" data-name="Separator">
                        <hr class="w-100 mx-auto" style="border-top-color: rgba(34, 40, 40, 0);"/>
                    </div>
                    <section class="o_colored_level">
                        <div class="container">
                            <div class="row">
                                <div class="pb24 o_colored_level o_cc o_cc4 pt16 col-lg-12 rounded offset-1 offset-lg-0 col-10" style="--box-border-top-right-radius: 250px; --box-border-top-left-radius: 250px;">
                                    <img src="/web/image/headhunter.img_custom_zenith_image_25" alt="" class="img-fluid img o_we_custom_image o_attachment_pending_record_id rounded" data-shape="html_builder/geometric/geo_door" data-format-mimetype="image/webp" data-resize-width="690" data-aspect-ratio="1/1" data-mimetype="image/svg+xml" loading="lazy"/>
                                    <p class="mt24 mb8" style="text-align: center;">
                                        Zenith connects <strong>demanding</strong> organizations with exceptional executives the top 1% who won't answer a job posting. Our network runs deep. Our process runs fast.
                                    </p>
                                    <p class="mt24 mb8" style="text-align: center;">
                                        <a href="/contactus" class="o_translate_inline btn btn-outline-secondary">Contact us</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>

    <record id="job_detail_bottom" model="ir.ui.view">
        <field name="name">Zenith Hunting - Job Detail Call to Action</field>
        <field name="inherit_id" ref="website_hr_recruitment.detail"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_hr_recruitment_index_2']" position="replace">
                <div class="oe_structure oe_empty" id="oe_structure_hr_recruitment_index_2" data-editor-message="Drag blocks here to add them on all jobs"><section class="s_reviews_wall o_cc pt64 s_custom_snippet o_colored_level o_cc2 pb24 parallax" data-snippet="s_reviews_wall" data-format-mimetype="image/webp" data-scroll-background-ratio="0.2" style="position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/01&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#3D5AFE&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" data-parallax-type="zoomIn" data-name="Custom Custom Reviews Wall">
                    <span class="s_parallax_bg_wrap">
                        <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/headhunter.img_custom_zenith_image_03&quot;); background-size: cover;" data-format-mimetype="image/webp" data-resize-width="1920" data-mimetype="image/webp"/>
                    </span>
                    <div class="o_we_shape o_html_builder_Connections_01" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F01.svg?c5=%233D5AFE&quot;);"/>
                        <div class="container">
                            <div class="row o_grid_mode" data-row-count="7">
                                <div class="o_grid_item o_anim_from_top o_anim_fade_in o_animate_on_scroll o_animate g-col-lg-6 g-height-7 col-lg-6" style="--wanim-intensity: 8; z-index: 8; grid-area: 1 / 4 / 8 / 10; animation-name: dummy;" data-scroll-zone-end="100" data-scroll-zone-start="0">
                                    <p style="text-align: center;">
                                        <span class="o_text_highlight o_text_highlight_underline text-o-color-1" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: NaNpx;">NO NEED TO CONVINCE YOU</span>
                                    </p>
                                    <h2 class="card-title" style="text-align: center;">
                                        Dozens of organizations working with <span class="text-o-color-1">Zenith</span> for their top position openings.
                                    </h2>
                                    <p class="card-text" style="text-align: center;">Do the same - trust the best.</p>
                                    <p class="card-text" style="text-align: center;"><br/></p>
                                    <p style="text-align: center;">
                                        <a class="o_translate_inline btn btn-outline-primary" href="/contactus">Contact Us</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
