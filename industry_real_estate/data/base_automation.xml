<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="automation_confirm_subscription_order" model="base.automation">
        <field name="name">Confirm subscription order</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_add_tenant')])]"/>
        <field name="trigger">on_state_set</field>
        <field name="trg_selection_field_id" ref="sale.selection__sale_order__state__sale"/>
        <field name="filter_pre_domain" eval="[('state', 'in', ['draft', 'sent'])]"/>
        <field name="filter_domain" eval="[('state', '=', 'sale'), ('x_property_id', '!=', False), ('plan_id', '!=', False)]"/>
    </record>
    <record id="automation_update_stake_holders_dates" model="base.automation">
        <field name="name">Property Management: Update stake holders dates</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_update_stake_holders_dates')])]"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_domain">[("is_subscription", "=", True)]</field>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('sale_subscription.field_sale_order__end_date'), ref('sale_subscription.field_sale_order__start_date')])]"/>
    </record>
</odoo>
