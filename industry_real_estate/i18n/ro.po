#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.homepage
#: model_terms:ir.ui.view,arch_db:industry_real_estate.ir_ui_view_1416
msgid "<b>ABOUT US</b>"
msgstr "<b>DESPRE NOI</b>"

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid ""
"<b>Architectural Excellence:</b> A modern duplex layout that maximizes both "
"privacy and social space."
msgstr ""
"<b>Excelență arhitecturală:</b> Un duplex modern, proiectat pentru a "
"maximiza atât intimitatea, cât și spațiul de socializare."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid ""
"<b>Breathtaking Views:</b> Wide-angle vistas of the Burlington skyline from "
"your private balcony."
msgstr ""
"<b>Priveliști uimitoare:</b> Bucură-te de o panoramă largă asupra orașului "
"Burlington de pe balconul tău privat."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>CRM App</b>: Manage your leads efficiently, tracking ongoing buying and "
"selling opportunities in a visual\n"
"                pipeline."
msgstr ""
"<b>Aplicația CRM</b>: Gestionează eficient pistele și urmărește "
"oportunitățile de cumpărare și vânzare\n"
"                într-un flux vizual."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Contacts App: </b>Centralize all stakeholder data, managing the unique "
"relationships between property owners,\n"
"                tenants, and service providers within a single, searchable "
"directory with full communication history."
msgstr ""
"<b>Aplicația Contacte: </b>Centralizează datele tuturor părților interesate "
"și gestionează relațiile dintre proprietari,\n"
"                chiriași și furnizorii de servicii într-un director unic, "
"ușor de căutat, cu istoricul complet al comunicărilor."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_20
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_21
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_22
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_26
msgid "<b>Contemporary Heritage Living</b>"
msgstr "<b>Locuințe contemporane cu farmec istoric</b>"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Create a Contract:</b> Click \"New\" and select the tenant as the "
"\"Customer\" and add the Rental fee product."
msgstr ""
"<b>Creează un contract:</b> Apasă „Nou”, selectează chiriașul ca „Client” și "
"adaugă produsul pentru taxa de închiriere."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Create a Property:</b> Click \"New\" to create a unit. Fill in its "
"building, location and other details."
msgstr ""
"<b>Creează o proprietate:</b> Apasă „Nou” pentru a crea o unitate. "
"Completează clădirea, locația și celelalte detalii."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_20
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_21
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_22
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_26
msgid ""
"<b>Designer Interiors:</b> Each unit features unique, modern furniture "
"packages and high-quality flooring."
msgstr ""
"<b>Interioare de designer:</b> Fiecare unitate are mobilier modern, ales cu "
"grijă, și pardoseli de calitate superioară."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid ""
"<b>Diverse Space Options:</b> Whether you need a collaborative hub "
"(<b>Office M</b>), a focused executive suite (<b>Office S</b>), or a "
"spacious flagship floor (<b>Office T</b>), we have the right fit for your "
"team."
msgstr ""
"<b>Spații variate:</b> Fie că ai nevoie de un centru pentru colaborare "
"(<b>Biroul M</b>), de o suită executivă pentru concentrare (<b>Biroul S</b>) "
"sau de un etaj reprezentativ și spațios (<b>Biroul T</b>), avem spațiul "
"potrivit pentru echipa ta."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Documents App:</b> Store signed leases, property deeds, and insurance "
"certificates with expiration alerts."
msgstr ""
"<b>Aplicația Documente:</b> Păstrează contractele de închiriere semnate, "
"actele de proprietate și certificatele de asigurare, cu alerte înainte de "
"expirare."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid ""
"<b>Elite Location:</b> Situated in the prestigious <b>South Burlington area</"
"b>, providing immediate access to world-class dining, high-end retail, and "
"excellent transport links."
msgstr ""
"<b>Locație de excepție:</b> Situată în prestigioasa zonă <b>South "
"Burlington</b>, oferă acces imediat la restaurante de top, magazine premium "
"și legături excelente de transport."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid ""
"<b>Fully Equipped Amenities:</b> Access to premium lounges, designer meeting "
"rooms, and state-of-the-art infrastructure."
msgstr ""
"<b>Facilități complet echipate:</b> Acces la saloane premium, săli de "
"ședință de designer și infrastructură de ultimă generație."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_20
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_21
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_22
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_26
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid "<b>Key Highlights:</b>"
msgstr "<b>Caracteristici principale:</b>"

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid ""
"<b>Modern Industrial Aesthetic:</b> Features high ceilings, exposed "
"ductwork, and abundant natural light to foster creativity and productivity."
msgstr ""
"<b>Estetică industrială modernă:</b> Tavanele înalte, tubulatura vizibilă și "
"lumina naturală abundentă stimulează creativitatea și productivitatea."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Move-in Logs:</b> Utilize the dedicated property tab to record meter "
"readings (water, electricity) at the time of the tenant's entry and exit to "
"ensure accurate utility re-billing later."
msgstr ""
"<b>Evidența mutării:</b> Folosește fila dedicată proprietății pentru a "
"înregistra indexul contoarelor (apă, electricitate) la sosirea și plecarea "
"chiriașului, astfel încât utilitățile să poată fi refacturate corect."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Open the Availability</b>: Open the <strong>Leasing App</strong> and "
"navigate through the app menu Availability"
msgstr ""
"<b>Deschide disponibilitatea</b>: Open the <strong>Leasing App</strong> and "
"navigate through the app menu Availability"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Open the Contracts</b>: Open the <strong>Leasing App</strong> to reach "
"the Subscriptions."
msgstr ""
"<b>Deschide contractele</b>: Open the <strong>Leasing App</strong> to reach "
"the Subscriptions."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Open the Properties: </b>Open the <b>Leasing App </b>and navigate through "
"the app menu Infrastructure / Properties."
msgstr ""
"<b>Deschide proprietățile: </b>Open the <b>Leasing App </b>and navigate "
"through the app menu Infrastructure / Properties."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_20
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_21
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_22
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_26
msgid ""
"<b>Peaceful Setting:</b> Set within the quiet, green surroundings of a "
"beautifully repurposed farmhouse."
msgstr ""
"<b>Cadru liniștit:</b> Set within the quiet, green surroundings of a "
"beautifully repurposed farmhouse."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid ""
"<b>Prime Location:</b> Situated in one of South Burlington' most sought-"
"after residential districts."
msgstr ""
"<b>Locație excelentă:</b> Situată într-unul dintre cele mai căutate cartiere "
"rezidențiale din South Burlington."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Pro Tip:</b> You can create a new rental contract directly from this view "
"by clicking on an empty slot in\n"
"                    the timeline."
msgstr ""
"<b>Sfat util:</b> Poți crea un contract de închiriere direct din această "
"vizualizare, apăsând pe un interval liber din\n"
"                    cronologie."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Properties App: </b>Organize your portfolio with a dedicated app to "
"manage property listings, contracts, and\n"
"                availability status."
msgstr ""
"<b>Aplicația Proprietăți: </b>Organizează-ți portofoliul într-o aplicație "
"dedicată pentru gestionarea anunțurilor, contractelor și\n"
"                disponibilității proprietăților."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Sales App: </b>Handle offers, negotiations, and closing deals with "
"professional quotations and digital\n"
"                signatures."
msgstr ""
"<b>Aplicația Vânzări: </b>Gestionează ofertele, negocierile și încheierea "
"tranzacțiilor cu oferte profesionale și\n"
"                semnături digitale."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid "<b>Select the Property:</b> Select the \"Property\" to rent."
msgstr ""
"<b>Selectează proprietatea:</b> Alege proprietatea pe care dorești să o "
"închiriezi."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Sign App:</b> Send lease agreements for legally binding electronic "
"signatures."
msgstr ""
"<b>Aplicația Semnare:</b> Trimite contractele de închiriere pentru semnare "
"electronică cu valoare juridică."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid "<b>Sky-High Sophistication in Burlington</b>"
msgstr "<b>Rafinament la înălțime în Burlington</b>"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Subscriptions App: </b>Automate the collection of recurring rent and "
"service charges with flexible billing\n"
"                cycles, ensuring consistent cash flow and effortless lease "
"renewals."
msgstr ""
"<b>Aplicația Abonamente: </b>Automatizează încasarea chiriei recurente și a "
"taxelor de servicii cu cicluri flexibile de facturare,\n"
"                asigurând un flux de numerar constant și reînnoiri simple "
"ale contractelor."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid "<b>The Future of Work in the Heart of South Burlington</b>"
msgstr "<b>Viitorul muncii în inima South Burlington</b>"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Timeline:</b> Specify the start date, the recurring period (monthly, "
"quarterly, etc.) and the expiration of\n"
"                the contract."
msgstr ""
"<b>Cronologie:</b> Specify the start date, the recurring period (monthly, "
"quarterly, etc.) and the expiration of\n"
"                the contract."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_20
