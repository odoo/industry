msgid ""
"<span class=\"h5-fs\">Thank you for your request. To explore our sustainable "
"collection even sooner, book an appointment. Our team will get back to you "
"as soon as possible.</span>"
msgstr ""
"<span class=\"h5-fs\">Vă mulțumim pentru solicitare. Pentru a descoperi mai "
"repede colecția noastră sustenabilă, programați o întâlnire. Echipa noastră "
"vă va contacta cât mai curând.</span>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<span class=\"h6-fs\">From the <b>Inventory App</b>, you can effortlessly "
"manage your <b>stock levels</b>, handle <b>deliveries</b>, and process "
"<b>returns</b>.</span><span class=\"h2-fs\"/><br/>"
msgstr ""
"<span class=\"h6-fs\">Din aplicația <b>Stoc</b>, puteți gestiona cu ușurință "
"<b>nivelurile de stoc</b>, <b>livrările</b> și <b>retururile</b>.</span>"
"<span class=\"h2-fs\"/><br/>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<span class=\"h6-fs\">From the <b>Purchases App </b> you can define your "
"minimum stock level per product, process order make the follow up</"
"span><span class=\"h2-fs\"/><br/>"
msgstr ""
"<span class=\"h6-fs\">Din aplicația <b>Achiziții</b>, puteți defini nivelul "
"minim de stoc pentru fiecare produs, procesa comenzile și urmări livrările.</"
"span><span class=\"h2-fs\"/><br/>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
