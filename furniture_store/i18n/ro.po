#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b><span class=\"h4-fs\"><strong>Order preparation</strong></span></b><br/>"
msgstr ""
"<b><span class=\"h4-fs\"><strong>Pregătire comandă</strong></span></b><br/>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b><span class=\"h4-fs\"><strong>Processing a click and collect transaction</"
"strong></span></b>"
msgstr ""
"<b><span class=\"h4-fs\"><strong>Procesarea unei comenzi cu ridicare din "
"magazin</strong></span></b>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Accepted payment methods</b>."
msgstr "<b>Metode de plată acceptate</b>."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Add all necessary products</b> to the order."
msgstr "<b>Adăugați toate produsele necesare</b> la comandă."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Add specific locations</b> within your warehouse as needed. (You'll first "
"need to enable the \"Locations\" setting in your Inventory configurations to "
"use this feature.)"
msgstr ""
"<b>Adăugați locații specifice</b> în depozit, după cum este necesar. (Pentru "
"a folosi această funcționalitate, activați mai întâi setarea „Locații” din "
"configurarea Stoc.)"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Available delivery options</b>."
msgstr "<b>Opțiuni de livrare disponibile</b>."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Confirm it.</b> Odoo will automatically generate a <b>receipt</b> for the "
"incoming products."
msgstr ""
"<b>Confirmați.</b> Odoo va genera automat o <b>recepție</b> pentru produsele "
"primite."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Create a B2B webpage</b> to cater specifically to your business clients."
msgstr "<b>Creați o pagină web B2B</b> dedicată clienților dvs. de afaceri."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Define Vendors and Lead time on products</b><br/>"
msgstr "<b>Definiți furnizorii și termenul de livrare pentru produse</b><br/>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Gather all the products</b> for that order."
msgstr "<b>Strângeți toate produsele</b> pentru comanda respectivă."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Integrate WhatsApp</b> to send automatic reminders about deliveries, "
"keeping your customers informed effortlessly."
msgstr ""
"<b>Integrați WhatsApp</b> pentru a trimite automat mementouri despre livrări "
"și a vă ține clienții la curent."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Leverage Social Marketing</b> to effectively promote your new arrivals "
"and reach a wider audience."
msgstr ""
"<b>Folosiți Marketing social</b> pentru a promova eficient produsele noi și "
"a ajunge la un public mai larg."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Open the Inventory App</b> and go to <b>\"Replenishment.\"</b>"
msgstr "<b>Deschideți aplicația Stoc</b> și accesați <b>„Reaprovizionare”</b>."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Order all the products</b> you need to replenish."
msgstr "<b>Comandați toate produsele</b> pe care trebuie să le reaprovizionați."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Process the receipt</b> once the products arrive."
msgstr "<b>Procesați recepția</b> după sosirea produselor."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Select the order</b> you're starting."
msgstr "<b>Selectați comanda</b> pe care o procesați."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Send the purchase order</b> to your vendor."
msgstr "<b>Trimiteți comanda de achiziție</b> furnizorului."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Set up reordering rules</b> for your products to automatically maintain "
"minimum stock levels."
msgstr ""
"<b>Configurați reguli de reaprovizionare</b> pentru a menține automat "
"nivelurile minime de stoc."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Validate!</b>"
msgstr "<b>Validați!</b>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Validate</b> the preparation."
msgstr "<b>Validați</b> pregătirea."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Barcode App</b>:</font> Empower staff to "
"perform stock counts, receive goods,\n"
"                    and check prices on the shop floor using mobile scanners."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplicația Coduri de bare</b>:</font> "
"permite personalului să numere stocul, să recepționeze mărfuri\n"
"                    și să verifice prețurile în magazin folosind scanere "
"mobile."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Inventory App</b>: </font>Manage stock "
"with precision using\n"
"                    <b>Lots &amp; Serial Numbers</b> and <b>Expiration "
"Dates</b> to track perishables and automate removal\n"
"                    strategies."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplicația Stoc</b>: </font>gestionați cu "
"precizie stocul folosind\n"
"                    <b>loturi și numere de serie</b> și <b>date de expirare</"
"b> pentru a urmări produsele perisabile și a automatiza\n"
"                    strategiile de eliminare."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Invoicing App</b>:</font> Simplify your "
"financial workflows by integrating\n"
"                    supplier bills and customer invoices directly into your "
"accounting system."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplicația Facturare</b>:</font> "
"simplificați fluxurile financiare integrând\n"
"                    facturile furnizorilor și facturile clienților direct în "
"sistemul contabil."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Point of Sale App</b>:</font> Process "
"transactions rapidly with an interface\n"
"                    optimized for speed, supporting barcode scanners, "
"integrated scales, and customer loyalty cards."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplicația Punct de vânzare</b>:</font> "
"procesați rapid tranzacțiile printr-o interfață\n"
"                    optimizată pentru viteză, compatibilă cu scanere de "
"coduri de bare, cântare integrate și carduri de fidelitate."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Purchase App</b>:</font> Automate the "
"reordering of fast-moving goods based on\n"
"                    minimum stock rules, ensuring you never run out of milk "
"or bread."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplicația Achiziții</b>:</font> "
"automatizați reaprovizionarea produselor cu rulaj rapid pe baza\n"
"                    regulilor de stoc minim, astfel încât să nu rămâneți "
"niciodată fără lapte sau pâine."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>eCommerce App</b>:</font> Expand your "
"reach by offering online ordering for\n"
"                    \"click and collect\" or home delivery services."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplicația Comerț electronic</b>:</font> "
"extindeți-vă aria de acoperire oferind comenzi online cu\n"
"                    ridicare din magazin sau livrare la domiciliu."

