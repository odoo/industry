#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Barcode App</b>:</font> Empower staff to "
"perform stock counts, receive goods,\n"
"                    and check prices on the shop floor using mobile scanners."
msgstr ""
"<font class=\"text-o-color-1\"><b>Barcode App</b>:</font> Omogočite osebju "
"izvajanje popisov zaloge, prejemanje blaga,\n"
"                    in preverjanje cen na delavnici z mobilnimi skenerji."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Inventory App</b>: </font>Manage stock "
"with precision using\n"
"                    <b>Lots &amp; Serial Numbers</b> and <b>Expiration "
"Dates</b> to track perishables and automate removal\n"
"                    strategies."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija Zaloga</b>: </font>Upravljajte "
"zalogo natančno z uporabo\n"
"                    <b>Partij in serijskih številk</b> in <b>Rokov trajanja</"
"b> za sledenje pokvarljivim izdelkom in avtomatizacijo strategij\n"
"                    odstranjevanja."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Invoicing App</b>:</font> Simplify your "
"financial workflows by integrating\n"
"                    supplier bills and customer invoices directly into your "
"accounting system."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija za fakturiranje</b>:</font> "
"Poenostavite svoje finančne delovne tokove z vključevanjem\n"
"                    računov dobaviteljev in računov strank neposredno v vaš "
"računovodski sistem."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Point of Sale App</b>:</font> Process "
"transactions rapidly with an interface\n"
"                    optimized for speed, supporting barcode scanners, "
"integrated scales, and customer loyalty cards."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija prodajne točke</b>:</font> "
"Hitro obdelujte transakcije z vmesnikom,\n"
"                    optimiziranim za hitrost, ki podpira bralnike črtnih "
"kod, integrirane tehtnice in kartice zvestobe strank."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>Purchase App</b>:</font> Automate the "
"reordering of fast-moving goods based on\n"
"                    minimum stock rules, ensuring you never run out of milk "
"or bread."
msgstr ""
"<font class=\"text-o-color-1\"><b>Nakup</b>:</font> Avtomatizirajte ponovno "
"naročanje hitroobratujočih izdelkov na podlagi\n"
"                    pravil minimalne zaloge, s čimer zagotovite, da vam "
"nikoli ne zmanjka mleka ali kruha."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
#, fuzzy
msgid ""
"<font class=\"text-o-color-1\"><b>eCommerce App</b>:</font> Expand your "
"reach by offering online ordering for\n"
"                    \"click and collect\" or home delivery services."
msgstr ""
"<font class=\"text-o-color-1\"><b>Aplikacija e-trgovine</b>:</font> "
"Razširite svoj doseg z možnostjo spletnega naročanja za\n"
"                    storitve \"klikni in prevzemi\" ali dostave na dom."

