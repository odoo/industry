#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<span class=\"h6-fs\">From the <b>Inventory App</b>, you can effortlessly "
"manage your <b>stock levels</b>, handle <b>deliveries</b>, and process "
"<b>returns</b>.</span><span class=\"h2-fs\"/><br/>"
msgstr ""
"<span class=\"h6-fs\">Desde la aplicación <b>Inventario</b>, puede gestionar "
"los <b>niveles de stock</b>, encargarse de las <b>entregas</b> y procesar "
"<b>devoluciones</b> con facilidad.</span><span class=\"h2-fs\"/><br/>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<span class=\"h6-fs\">From the <b>Purchases App </b> you can define your "
"minimum stock level per product, process order make the follow up</"
"span><span class=\"h2-fs\"/><br/>"
msgstr ""
"<span class=\"h6-fs\">Desde la aplicación <b>Compras</b> , puede definir el "
"nivel mínimo de stock por producto, procesar pedidos y hacer su seguimiento</"
"span><span class=\"h2-fs\"/><br/>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Welcome to the <strong><font style=\"color: rgb(113, "
"75, 103);\">Odoo Furniture Store package</font></strong>!</span>"
msgstr ""
"<span class=\"h6-fs\">¡Bienvenido al <strong><font style=\"color: rgb(113, "
"75, 103);\">paquete de Odoo para tiendas de muebles</font></strong>!</span>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<span class=\"h6-fs\">Your <b>Point of Sale (PoS)</b> is your central hub "
"for handling all in-store transactions, managing order preparation and "
"display, and processing e-commerce click &amp; collect orders.</span><span "
"class=\"h2-fs\"/><br/>"
msgstr ""
"<span class=\"h6-fs\">La aplicación <b>Punto de venta (PdV)</b> es el lugar "
"desde el que podrá gestionar todas las transacciones de su tienda, así como "
"la preparación y visualización de pedidos, además de que le permitirá "
"procesar los pedidos de tipo «Clic y recoger» de su comercio electrónico.</"
"span><span class=\"h2-fs\"/><br/>"

