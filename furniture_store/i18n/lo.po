#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b><span class=\"h4-fs\"><strong>Order preparation</strong></span></b><br/>"
msgstr ""
"<b><span class=\"h4-fs\"><strong>ການກຽມລາຍການສັ່ງຊື້</strong></span></b><br/>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b><span class=\"h4-fs\"><strong>Processing a click and collect transaction</"
"strong></span></b>"
msgstr ""
"<b><span class=\"h4-fs\"><strong>ກຳລັງດຳເນີນທຸລະກຳ ສັ່ງຊື້ອອນລາຍແລ້ວຮັບຢູ່ຮ້ານ (Click "
"and Collect)</strong></span></b>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Accepted payment methods</b>."
msgstr "<b>ວິທີການຊຳລະເງິນທີ່ຮອງຮັບ</b>."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Add all necessary products</b> to the order."
msgstr "<b>ເພີ່ມສິນຄ້າທີ່ຈຳເປັນທັງໝົດ</b> ເຂົ້າໃນລາຍການສັ່ງຊື້."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Add specific locations</b> within your warehouse as needed. (You'll first "
"need to enable the \"Locations\" setting in your Inventory configurations to "
"use this feature.)"
msgstr ""
"<b>ເພີ່ມສະຖານທີ່ສະເພາະ</b> ພາຍໃນສາງຂອງທ່ານຕາມຄວາມຕ້ອງການ. (ກ່ອນອື່ນໝົດ ທ່ານຕ້ອງເປີດໃຊ້ "
"ການຕັ້ງຄ່າ \"ສະຖານທີ່\" ໃນການກຳນົດຄ່າສາງສິນຄ້າຂອງທ່ານ ເພື່ອໃຊ້ງານຄຸນສົມບັດນີ້.)"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Available delivery options</b>."
msgstr "<b>ຕົວເລືອກການຈັດສົ່ງທີ່ມີໃຫ້</b>."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Confirm it.</b> Odoo will automatically generate a <b>receipt</b> for the "
"incoming products."
msgstr ""
"<b>ຢືນຢັນ.</b> Odoo ຈະສ້າງ <b>ໃບຮັບສິນຄ້າ</b> ໂດຍອັດຕະໂນມັດສຳລັບ ສິນຄ້າທີ່ກຳລັງເຂົ້າມາ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Create a B2B webpage</b> to cater specifically to your business clients."
msgstr "<b>ສ້າງໜ້າເວັບ B2B</b> ເພື່ອຮອງຮັບລູກຄ້າລະດັບທຸລະກິດຂອງທ່ານໂດຍສະເພາະ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Define Vendors and Lead time on products</b><br/>"
msgstr "<b>ກຳນົດຜູ້ສະໜອງ ແລະ ໄລຍະເວລາດຳເນີນການສຳລັບສິນຄ້າ</b><br/>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Gather all the products</b> for that order."
msgstr "<b>ຮວບຮວມສິນຄ້າທັງໝົດ</b> ສຳລັບລາຍການສັ່ງຊື້ນັ້ນ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Integrate WhatsApp</b> to send automatic reminders about deliveries, "
"keeping your customers informed effortlessly."
msgstr ""
"<b>ເຊື່ອມໂຍງ WhatsApp</b> ເພື່ອສົ່ງການແຈ້ງເຕືອນອັດຕະໂນມັດກ່ຽວກັບການຈັດສົ່ງ, "
"ຊ່ວຍແຈ້ງຂໍ້ມູນໃຫ້ລູກຄ້າຂອງທ່ານຊາບໄດ້ຢ່າງງ່າຍດາຍ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Leverage Social Marketing</b> to effectively promote your new arrivals "
"and reach a wider audience."
msgstr ""
"<b>ນຳໃຊ້ການຕະຫຼາດຜ່ານສື່ສັງຄົມອອນລາຍ</b> ເພື່ອໂຄສະນາສິນຄ້າມາໃໝ່ຂອງທ່ານຢ່າງມີປະສິດທິຜົນ ແລະ "
"ເຂົ້າເຖິງກຸ່ມລູກຄ້າທີ່ກວ້າງຂວາງຂຶ້ນ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Open the Inventory App</b> and go to <b>\"Replenishment.\"</b>"
msgstr "<b>ເປີດແອັບສາງສິນຄ້າ</b> ແລ້ວໄປທີ່ <b>\"ການເຕີມເຕັມສິນຄ້າ\"</b>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Order all the products</b> you need to replenish."
msgstr "<b>ສັ່ງຊື້ສິນຄ້າທັງໝົດ</b> ທີ່ທ່ານຕ້ອງການເຕີມສະຕັອກ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Process the receipt</b> once the products arrive."
msgstr "<b>ດຳເນີນການຮັບສິນຄ້າ</b> ເມື່ອສິນຄ້າມາຮອດ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Select the order</b> you're starting."
msgstr "<b>ເລືອກລາຍການສັ່ງຊື້</b> ທີ່ທ່ານກຳລັງຈະເລີ່ມ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Send the purchase order</b> to your vendor."
msgstr "<b>ສົ່ງໃບສັ່ງຊື້</b> ໄປຍັງຜູ້ສະໜອງຂອງທ່ານ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<b>Set up reordering rules</b> for your products to automatically maintain "
"minimum stock levels."
msgstr ""
"<b>ຕັ້ງກົດເກນການສັ່ງຊື້ຄືນ</b> ສຳລັບສິນຄ້າຂອງທ່ານ ເພື່ອຮັກສາລະດັບສະຕັອກຂັ້ນຕ່ຳ ໂດຍອັດຕະໂນມັດ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Validate!</b>"
msgstr "<b>ຢືນຢັນ!</b>"

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid "<b>Validate</b> the preparation."
msgstr "<b>ຢືນຢັນ</b> ການກຽມສິນຄ້າ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Barcode App</b>:</font> Empower staff to "
"perform stock counts, receive goods,\n"
"                    and check prices on the shop floor using mobile scanners."
msgstr ""
"<font class=\"text-o-color-1\"><b>ແອັບບາໂຄດ</b>:</font> "
"ຊ່ວຍໃຫ້ພະນັກງານສາມາດກວດນັບສະຕັອກ, ຮັບສິນຄ້າ,\n"
"                    ແລະ ກວດສອບລາຄາຢູ່ໜ້າຮ້ານໄດ້ ໂດຍໃຊ້ເຄື່ອງສະແກນມືຖື."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Inventory App</b>: </font>Manage stock "
"with precision using\n"
"                    <b>Lots &amp; Serial Numbers</b> and <b>Expiration "
"Dates</b> to track perishables and automate removal\n"
"                    strategies."
msgstr ""
"<font class=\"text-o-color-1\"><b>ແອັບສາງສິນຄ້າ</b>: </"
"font>ຈັດການສະຕັອກຢ່າງຖືກຕ້ອງແມ່ນຍຳ ໂດຍໃຊ້\n"
"                    <b>ໝາຍເລກຊຸດ &amp; ເລກລຳດັບ</b> ແລະ <b>ວັນໝົດອາຍຸ</b> "
"ເພື່ອຕິດຕາມສິນຄ້າທີ່ເສຍງ່າຍ ແລະ ນຳໃຊ້ຍຸດທະສາດການນຳສິນຄ້າອອກຈາກສາງ\n"
"                    ແບບອັດຕະໂນມັດ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Invoicing App</b>:</font> Simplify your "
"financial workflows by integrating\n"
"                    supplier bills and customer invoices directly into your "
"accounting system."
msgstr ""
"<font class=\"text-o-color-1\"><b>ແອັບໃບແຈ້ງໜີ້</b>:</font> "
"ເຮັດໃຫ້ຂັ້ນຕອນການເງິນຂອງທ່ານງ່າຍຂຶ້ນ ໂດຍການເຊື່ອມໂຍງ\n"
"                    ໃບບິນຈາກຜູ້ສະໜອງ ແລະ ໃບແຈ້ງໜີ້ລູກຄ້າ ເຂົ້າໃນລະບົບບັນຊີຂອງທ່ານໂດຍກົງ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Point of Sale App</b>:</font> Process "
"transactions rapidly with an interface\n"
"                    optimized for speed, supporting barcode scanners, "
"integrated scales, and customer loyalty cards."
msgstr ""
"<font class=\"text-o-color-1\"><b>ແອັບຈຸດຂາຍ (POS)</b>:</font> "
"ດຳເນີນທຸລະກຳໄດ້ຢ່າງວ່ອງໄວ ດ້ວຍໜ້າຕ່າງການໃຊ້ງານ\n"
"                    ທີ່ອອກແບບມາເພື່ອຄວາມໄວ, ຮອງຮັບເຄື່ອງສະແກນບາໂຄດ, ຊິງຊັ່ງນ້ຳໜັກໃນຕົວ "
"ແລະ ບັດສະມາຊິກລູກຄ້າ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>Purchase App</b>:</font> Automate the "
"reordering of fast-moving goods based on\n"
"                    minimum stock rules, ensuring you never run out of milk "
"or bread."
msgstr ""
"<font class=\"text-o-color-1\"><b>ແອັບການຈັດຊື້</b>:</font> "
"ຕັ້ງຄ່າການສັ່ງຊື້ສິນຄ້າຂາຍດີຄືນແບບອັດຕະໂນມັດ ຕາມ\n"
"                    ກົດເກນສະຕັອກຂັ້ນຕ່ຳ, ເພື່ອຮັບປະກັນວ່າສິນຄ້າຂອງທ່ານ ເຊັ່ນ ນົມ ຫຼື ເຂົ້າຈີ່ "
"ຈະບໍ່ຂາດສະຕັອກ."

#. module: furniture_store
#: model_terms:ir.ui.view,arch_db:furniture_store.welcome_article_body
msgid ""
"<font class=\"text-o-color-1\"><b>eCommerce App</b>:</font> Expand your "
"reach by offering online ordering for\n"
"                    \"click and collect\" or home delivery services."
msgstr ""
"<font class=\"text-o-color-1\"><b>ແອັບອີຄອມເມີຊ</b>:</font> "
"ຂະຫຍາຍການເຂົ້າເຖິງຂອງທ່ານ ໂດຍການເປີດໃຫ້ສັ່ງຊື້ອອນລາຍສຳລັບ\n"
"                    ການບໍລິການ \"ສັ່ງແລ້ວຮັບຢູ່ຮ້ານ\" ຫຼື ການຈັດສົ່ງຮອດເຮືອນ."

