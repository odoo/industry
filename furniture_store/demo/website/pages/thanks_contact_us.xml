<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_thanks_contact_us" model="ir.ui.view">
        <field name="name">Thanks (Contact us)</field>
        <field name="key">furniture_store.page_thanks_contact_us</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Thanks (Contact us)" t-name="furniture_store.page_thanks_contact_us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_cover o_cc s_parallax_no_overflow_hidden o_cc1 o_colored_level pb40 s_custom_snippet pt48 o_three_quarter_height" data-scroll-background-ratio="0" data-snippet="s_cover" style="background-color: rgb(255, 249, 240);" data-name="Custom Custom Cover">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_animate o_anim_fade_in o_visible rounded border o_anim_from_bottom o_colored_level col-lg-12" style="--box-border-bottom-left-radius: 8px; --box-border-bottom-right-radius: 8px; --box-border-top-right-radius: 8px; --box-border-top-left-radius: 8px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; --wanim-intensity: 10; animation-name: dummy;">
                                        <p style="text-align: center;">
                                            <img src="/web/image/furniture_store.img_furniture_store_image_02" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" loading="lazy"/>
                                        </p>
                                        <h1 style="text-align: center;">
                                            <span class="o_rfs" style="font-size: clamp(8px, 1em + 3.1690vw, 400px);">Thank you</span>
                                        </h1>
                                    </div>
                                    <div class="o_animate o_anim_fade_in o_visible o_colored_level rounded border o_anim_from_bottom offset-lg-2 col-lg-8 pt24" style="--box-border-bottom-left-radius: 8px; --box-border-bottom-right-radius: 8px; --box-border-top-right-radius: 8px; --box-border-top-left-radius: 8px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; --wanim-intensity: 10; animation-name: dummy;">
                                        <p class="lead" style="text-align: center;">
                                            <span class="h5-fs">Thank you for your request. To explore our sustainable collection even sooner, book an appointment. Our team will get back to you as soon as possible.</span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <input t-if="website.plausible_shared_key" type="hidden" class="js_plausible_push" data-event-name="Lead Generation" data-event-params="{&quot;CTA&quot;: &quot;Contact Us&quot;}"/>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_thanks_contact_us" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_thanks_contact_us"/>
            <field name="url">/contactus-thank-you</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="False"/>
        </record>
    </data>
</odoo>
