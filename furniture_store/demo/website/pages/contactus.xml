<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">furniture_store.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="furniture_store.page_contactus">
                <t t-call="website.layout" logged_partner="request.env['ir.http']._get_visitor_from_request().partner_id">
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email, 'name': request.params.get('name', ''), 'phone': request.params.get('phone', ''), 'email_from': request.params.get('email_from', ''), 'company': request.params.get('company', ''), 'subject': request.params.get('subject', ''), 'contact_name': request.params.get('contact_name', ''), 'partner_name': request.params.get('partner_name', ''), 'description': request.params.get('description', '')}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_cover o_cc s_parallax_no_overflow_hidden o_cc1 pt16 o_colored_level pb40 s_custom_snippet" data-scroll-background-ratio="0" data-snippet="s_cover" style="background-color: rgb(255, 249, 240);" data-name="Custom Cover">
                            <div class="s_allow_columns container">
                                <div class="row o_grid_mode" data-row-count="12">
                                    <div class="o_grid_item o_grid_item_image rounded o_colored_level g-col-lg-12 g-height-12 col-lg-12" style="z-index: 6; --box-border-bottom-left-radius: 10px; --box-border-bottom-right-radius: 10px; --box-border-top-right-radius: 10px; --box-border-top-left-radius: 10px; grid-area: 1 / 1 / 13 / 13;">
                                        <img src="/web/image/furniture_store.img_furniture_store_image_01" alt="" class="img img-fluid o_we_custom_image o_animate o_anim_fade_in o_visible o_anim_from_bottom o_editable_media o_attachment_pending_record_id o_animated" style="visibility: visible; --wanim-intensity: 10; animation-play-state: running;" data-format-mimetype="image/webp" data-resize-width="1270" data-mimetype="image/webp" loading="eager" data-quality="80"/>
                                    </div>
                                    <div class="o_animate o_anim_fade_in o_visible o_colored_level o_grid_item o_cc o_cc1 rounded border g-height-4 g-col-lg-5 col-lg-5 o_anim_from_bottom" style="z-index: 7; --grid-item-padding-x: 40px; --grid-item-padding-y: 40px; --box-border-bottom-left-radius: 8px; --box-border-bottom-right-radius: 8px; --box-border-top-right-radius: 8px; --box-border-top-left-radius: 8px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; grid-area: 7 / 2 / 11 / 7; --wanim-intensity: 10; animation-name: dummy;">
                                        <h1 style="text-align: start;"><strong>Contact us</strong></h1>
                                        <p class="lead" style="text-align: start;">Get in touch with our team for expert assistance and personalized assistance and we'll be happy to assist you.<br/></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block pb40 o_colored_level pt0" data-snippet="s_text_block" data-name="Text">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-7 mt-4 mt-lg-0 o_colored_level">
                                        <p class="lead"><br/></p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Name">
                                                            <label class="s_website_form_label" for="ofk5npkl4vyn" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Name</span>
                                                                <span class="s_website_form_mark">
                                                                    *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="contact_name" required="" value="" placeholder="" id="ofk5npkl4vyn" data-fill-with="name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="tel" data-translated-name="Phone Number">
                                                            <label class="s_website_form_label" for="omrggnhi4pw" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="phone" value="" placeholder="" id="omrggnhi4pw" data-fill-with="phone"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required col-lg-6" data-type="email" data-translated-name="Your Email">
                                                            <label class="s_website_form_label" for="ocnrgini472n" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Email</span>
                                                                <span class="s_website_form_mark">
                                                                    *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="" value="" placeholder="" id="ocnrgini472n" data-fill-with="email"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Your Company">
                                                            <label class="s_website_form_label" for="oqctek9n1df" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Company</span>
                                                                <span class="s_website_form_mark">
                                                                    *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="partner_name" required="" value="" placeholder="" id="oqctek9n1df" data-fill-with="commercial_company_name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Subject">
                                                            <label class="s_website_form_label" for="o6g0yx4q0h32" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark">
                                                                    *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="name" required="" value="" placeholder="" id="o6g0yx4q0h32" data-fill-with="undefined"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="Your Question">
                                                            <label class="s_website_form_label" for="op7mtqseqs0c" style="width: 200px;">
                                                                <span class="s_website_form_label_content">Your Question</span>
                                                                <span class="s_website_form_mark">
                                                                    *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="" placeholder="" id="op7mtqseqs0c" rows="6"/>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 200px;" class="s_website_form_label"/>
                                                            <a href="#" role="button" class="btn btn-primary s_website_form_send">Send</a>
                                                            <span id="s_website_form_result"/>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                    <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0 o_colored_level pt40">
                                        <h2>
                                            <span class="h5-fs">Archetype Themes</span>
                                        </h2>
                                        <ul class="list-unstyled mb-0 ps-2">
                                            <li>
                                                <i class="oi oi-fw me-2" data-icon="location_on"/>
                                                <span class="o_force_ltr">
                                                    250 Executive Park Blvd, Suite 3400<br/>
                                                    San Francisco CA 94134
                                                </span>
                                            </li>
                                            <li>
                                                <i class="oi oi-filled oi-fw me-2" data-icon="phone"/>
                                                <span class="o_force_ltr">+1 555-555-5556</span>
                                            </li>
                                            <li>
                                                <i class="oi oi-filled oi-1x oi-fw me-2" data-icon="mail"/>
                                                <span>info@archetypethemes.example.com</span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
