<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- Recurring prices of the membership plans, monthly and yearly (2 months free).
       A recurring rule only applies within its own pricelist, hence one rule per pricelist
       reachable from the website: the generic one and the members one. -->
  <record id="product_pricelist_item_flex_month" model="product.pricelist.item">
    <field name="pricelist_id" model="product.pricelist" search="[('id', '!=', ref('product_pricelist_2'))]"/>
    <field name="plan_id" ref="sale_subscription.subscription_plan_month"/>
    <field name="product_tmpl_id" ref="product_template_5"/>
    <field name="applied_on">1_product</field>
    <field name="compute_price">fixed</field>
    <field name="fixed_price" eval="220.0"/>
  </record>
  <record id="product_pricelist_item_flex_year" model="product.pricelist.item">
