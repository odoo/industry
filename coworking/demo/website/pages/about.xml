<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_page_about" model="ir.ui.view">
        <field name="name">About</field>
        <field name="key">coworking.page_about</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <t t-name="coworking.page_about">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_image o_colored_level o_cc o_cc2 s_custom_snippet pb40 pt80" data-snippet="s_text_image" data-name="Custom Text - Image">
                            <div class="container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-8 offset-lg-2">
                                        <p style="text-align: center;">
                                            <span class="o_small-fs">
                                                <strong>
                                                    <span class="text-o-color-1">
                                                        <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">OUR STORY</span>
                                                    </span>
                                                </strong>
                                            </span>
                                            <br/>
                                        </p>
                                        <h1 style="text-align: center;">
                                            <strong>
                                                <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">We built a workday<br/>around the sun</span>
                                            </strong>
                                            <br/>
                                        </h1>
                                        <p style="text-align: center;" class="lead">
                                            <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">A coworking space built around the sun with big east-facing windows, plants,&amp;nbsp;<br/>and a floor that keeps time with the rhythm of your working day.</span>
                                        </p>
                                    </div>

                                </div>
                            </div>
                        </section>
                        <section class="s_image_frame o_colored_level o_cc pb64 o_cc2 pt0" data-snippet="s_image_frame" data-name="Image Frame">
                            <div class="container">
                                <div class="row o_grid_mode" data-row-count="11">
                                    <div class="o_grid_item o_grid_item_image g-height-11 order-lg-0 overflow-hidden o_colored_level rounded g-col-lg-10 col-lg-10" style="grid-area: 1 / 2 / 12 / 12; --grid-item-padding-x: 0px; --grid-item-padding-y: 0px; order: 0; --box-border-bottom-left-radius: 30px; --box-border-bottom-right-radius: 30px; --box-border-top-right-radius: 30px; --box-border-top-left-radius: 30px;">
                                        <img src="/web/image/coworking.img_custom_image_18" alt="Sunset in office" class="img img-fluid mx-auto o_we_custom_image o_editable_media o_animate o_visible o_anim_zoom_out o_animated" style="--wanim-intensity: 15; visibility: visible; animation-play-state: running;" data-format-mimetype="image/webp" data-resize-width="1290" data-mimetype="image/webp" loading="eager" data-aspect-ratio="0/0" data-y="91.15573770491804" data-width="1920" data-height="1188.844262295082" data-scale-x="1" data-scale-y="1"/>
                                    </div>

                                </div>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level o_cc o_cc2 pb112 pt56" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-5 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p>
                                            <span class="o_small-fs text-o-color-1">
                                                <strong>WHO WE ARE</strong>
                                            </span>
                                            <br/>
                                        </p>
                                        <h2>
                                            <strong>A coworking space,&amp;nbsp;<br/>minus the noise.</strong>
                                        </h2>
                                    </div>
                                    <div class="o_colored_level col-lg-6 offset-lg-1 pt48 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p class="lead">Daylight is a top-floor coworking space in the heart of Brussels, just a <strong>short walk from Central Station</strong>, designed around natural light and the rhythm of a working day.&amp;nbsp;</p>
                                        <p class="lead">It brings together a creative community that values connection, experimentation, and sustainability, with fast internet, well-designed shared areas, and quiet spots for focus.&amp;nbsp;</p>
                                        <p class="lead">Members can test new ideas, collaborate on projects, and enjoy flexible workspaces that adapt to how they like to work, all within a space that makes thoughtful, greener choices every day.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_numbers_list o_cc o_colored_level o_cc3 pt104 pb80 s_custom_snippet" data-snippet="s_numbers_list" style="position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Containers/03&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-3&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;}" data-name="Custom Numbers list">
                            <div class="o_we_shape o_html_builder_Containers_03" style="background-image: url(&quot;/html_editor/shape/html_builder%2FContainers%2F03.svg?c5=%23F2F3EE&quot;);"/>
                            <div class="container">
                                <div class="row s_nb_column_fixed">
                                    <div class="pb32 o_colored_level col-lg-4 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p>
                                            <span class="o_small-fs text-o-color-1">
                                                <strong>WHAT WE STAND FOR</strong>
                                            </span>
                                            <br/>
                                        </p>
                                        <h2>
                                            <strong>Our values</strong>
                                        </h2>
                                    </div>
                                    <div class="col-12 col-lg-3 offset-lg-1 o_colored_level pt16 pb16 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <h3>
                                            <img src="/web/image/coworking.img_custom_image_07" alt="" class="img img-fluid o_we_custom_image" style="padding-bottom: 10px;" loading="lazy" role="presentation"/>
                                            <br/>
                                            <span class="h5-fs">
                                                <strong>Community building</strong>
                                            </span>
                                        </h3>
                                        <p>A warm, light-filled coworking space where a creative community comes together to work, connect, and create.</p>
                                        <div class="s_hr pt16 pb40" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <h3>
                                            <img src="/web/image/coworking.img_custom_image_05" alt="" class="img img-fluid o_we_custom_image" style="padding-bottom: 10px;" loading="lazy" role="presentation" data-mimetype="undefined"/>
                                            <br/>
                                            <span class="h5-fs">
                                                <strong>Incubating innovations</strong>
                                            </span>
                                        </h3>
                                        <p>A place where ideas can be tested, shared, and refined, with the tools to turn experiments into&amp;nbsp;practice.</p>
                                    </div>
                                    <div class="col-12 col-lg-3 o_colored_level pt16 pb16 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <h3>
                                            <img src="/web/image/coworking.img_custom_image_07" alt="" class="img img-fluid o_we_custom_image" style="padding-bottom: 10px;" loading="lazy" role="presentation" data-mimetype="undefined"/>
                                            <br/>
                                            <span class="h5-fs">
                                                <strong>Sustainable actions</strong>
                                            </span>
                                        </h3>
                                        <p>A coworking space that chooses greener options, from low-waste amenities to energy-conscious design.</p>
                                        <div class="s_hr pt16 pb40" data-snippet="s_hr" data-name="Separator">
                                            <hr class="w-100 mx-auto"/>
                                        </div>
                                        <h3>
                                            <img src="/web/image/coworking.img_custom_image_08" alt="" class="img img-fluid o_we_custom_image" style="padding-bottom: 10px;" loading="lazy" role="presentation" data-mimetype="undefined"/>
                                            <br/>
                                            <span class="h5-fs">
                                                <strong>Room for flexibility</strong>
                                            </span>
                                        </h3>
                                        <p>Workspaces that adapt to your rhythm, from quiet focus corners to open areas for collaboration.</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level o_cc o_cc2 pb80 s_custom_snippet pt80" data-snippet="s_text_block" data-name="Custom Text">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="col-lg-4 o_colored_level o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p>
                                            <img src="/web/image/coworking.img_custom_image_02" alt="" class="img img-fluid o_we_custom_image mx-auto d-block" loading="lazy" data-mimetype="undefined" role="presentation"/>
                                        </p>
                                        <h3 style="text-align: center;">
                                            <strong>20+</strong>
                                            <br/>
                                        </h3>
                                        <p style="text-align: center;">Inclusive member benefits</p>
                                    </div>
                                    <div class="col-lg-4 o_colored_level o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p>
                                            <img src="/web/image/coworking.img_custom_image_02" alt="" class="img img-fluid o_we_custom_image mx-auto d-block" loading="lazy" data-mimetype="undefined" role="presentation"/>
                                        </p>
                                        <h3 style="text-align: center;">
                                            <strong>300m</strong>
                                            <br/>
                                        </h3>
                                        <p style="text-align: center;">From Brussels Central</p>
                                    </div>
                                    <div class="col-lg-4 o_colored_level o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p>
                                            <img src="/web/image/coworking.img_custom_image_02" alt="" class="img img-fluid o_we_custom_image mx-auto d-block" loading="lazy" data-mimetype="undefined" role="presentation"/>
                                        </p>
                                        <h3 style="text-align: center;">
                                            <strong>24/7</strong>
                                        </h3>
                                        <p style="text-align: center;">Member Access</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <record id="page_about" model="website.page">
        <field name="view_id" ref="view_page_about"/>
        <field name="url">/about</field>
        <field name="website_id" ref="website_industry"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>
</odoo>
