<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_page_pricing" model="ir.ui.view">
        <field name="name">Pricing</field>
        <field name="key">coworking.page_pricing</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <t t-name="coworking.page_pricing">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_cards_soft o_cc o_colored_level o_cc2 pt88 pb88 s_custom_snippet" data-snippet="s_cards_soft" style="position: relative;" data-name="Custom Cards Soft">
                            <div class="container">
                                <p>
                                    <span class="o_small-fs text-o-color-1">
                                        <strong>
                                            <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">MEMBERSHIP</span>
                                        </strong>
                                    </span>
                                    <br />
                                </p>
                                <h2>
                                    <strong>
                                        <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">Pay for the way you work</span>
                                    </strong>
                                </h2>
                                <div class="row">
                                    <div data-name="Card" class="col-lg-4 pt16 pb16 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <div class="s_card card o_cc o_colored_level o_cc1 rounded border h-100" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 20px; --box-border-bottom-right-radius: 20px; --box-border-top-right-radius: 20px; --box-border-top-left-radius: 20px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                                            <div class="card-body">
                                                <h3>
                                                    <span class="h4-fs">Day pass</span>
                                                </h3>
                                                <p>Drop in for the day, no commitment.</p>
                                                <p>
                                                    <span class="h4-fs">
                                                        <strong>$29/ day</strong>
                                                    </span>
                                                </p>
                                                <p>
                                                    <img style="padding-right: 10px;" class="img img-fluid o_we_custom_image" alt="" src="/web/image/coworking.img_custom_image_04" loading="lazy" data-mimetype="undefined" />Any open desk, 7am–8pm</p>
                                                <p>
                                                    <img style="padding-right: 10px;" class="img img-fluid o_we_custom_image" alt="" src="/web/image/coworking.img_custom_image_04" loading="lazy" data-mimetype="undefined" />Wifi, coffee &amp;amp; terrace</p>
                                                <p>
                                                    <img style="padding-right: 10px;" class="img img-fluid o_we_custom_image" alt="" src="/web/image/coworking.img_custom_image_04" loading="lazy" data-mimetype="undefined" />One booth booking</p>
                                                <p>
                                                    <br />
                                                </p>
                                                <p>
                                                    <a href="#top" class="o_translate_inline btn btn-secondary">Buy a day pass</a>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="col-lg-4 pt16 pb16 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <div class="s_card card o_cc o_colored_level o_cc3 rounded border h-100" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 20px; --box-border-bottom-right-radius: 20px; --box-border-top-right-radius: 20px; --box-border-top-left-radius: 20px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                                            <div class="card-body">
                                                <p>
                                                    <span class="s_badge badge o_animable text-bg-secondary" data-name="Badge" data-vxml="001" data-snippet="s_badge" style="font-weight: normal;">&amp;nbsp;MOST POPULAR&amp;nbsp;</span>
                                                </p>
                                                <h3>
                                                    <span class="h4-fs">Flex</span>
                                                </h3>
                                                <p>A few days a week, wherever you land.</p>
                                                <p>
                                                    <span class="h4-fs">
                                                        <strong>$220/ month</strong>
                                                    </span>
                                                </p>
                                                <p>
                                                    <img src="/web/image/coworking.img_custom_image_04" alt="" class="img img-fluid o_we_custom_image" style="padding-right: 10px;" loading="lazy" data-mimetype="undefined" />10 days a month</p>
                                                <p>
                                                    <img style="padding-right: 10px;" class="img img-fluid o_we_custom_image" alt="" src="/web/image/coworking.img_custom_image_04" loading="lazy" data-mimetype="undefined" />Any open desk</p>
                                                <p>
                                                    <img style="padding-right: 10px;" class="img img-fluid o_we_custom_image" alt="" src="/web/image/coworking.img_custom_image_04" loading="lazy" data-mimetype="undefined" />4 meeting-room credits</p>
                                                <p>
                                                    <br />
                                                </p>
                                                <p>
                                                    <a href="#top" class="o_translate_inline btn btn-primary">Choose Flex</a>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <div data-name="Card" class="col-lg-4 pt16 pb16 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <div class="s_card card o_cc o_cc1 o_colored_level rounded border h-100" data-vxml="001" data-snippet="s_card" data-name="Card" style="--box-border-bottom-left-radius: 20px; --box-border-bottom-right-radius: 20px; --box-border-top-right-radius: 20px; --box-border-top-left-radius: 20px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                                            <div class="card-body">
                                                <h3>
                                                    <span class="h4-fs">Resident</span>
                                                    <br />
                                                </h3>
                                                <p>Your own desk, in daily.</p>
                                                <p>
                                                    <span class="h4-fs">
                                                        <strong>$390/ month</strong>
                                                    </span>
                                                </p>
                                                <p>
                                                    <img style="padding-right: 10px;" class="img img-fluid o_we_custom_image" alt="" src="/web/image/coworking.img_custom_image_04" loading="lazy" data-mimetype="undefined" />Dedicated desk &amp;amp; locker</p>
                                                <p>
                                                    <img style="padding-right: 10px;" class="img img-fluid o_we_custom_image" alt="" src="/web/image/coworking.img_custom_image_04" loading="lazy" data-mimetype="undefined" />24/7 keycard access</p>
                                                <p>
                                                    <img style="padding-right: 10px;" class="img img-fluid o_we_custom_image" alt="" src="/web/image/coworking.img_custom_image_04" loading="lazy" data-mimetype="undefined" />Business mail &amp;amp; address</p>
                                                <p>
                                                    <img style="padding-right: 10px;" class="img img-fluid o_we_custom_image" alt="" src="/web/image/coworking.img_custom_image_04" loading="lazy" data-mimetype="undefined" />10 meeting-room credits</p>
                                                <p>
                                                    <br />
                                                </p>
                                                <p>
                                                    <a href="#top" class="o_translate_inline btn btn-secondary">Become a Resident</a>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_faq_collapse o_colored_level o_cc o_cc2 pt88 pb96" data-vcss="001" data-snippet="s_faq_collapse" data-name="FAQ Block">
                            <div class="container">
                                <div class="row s_nb_column_fixed align-items-start">
                                    <div class="col-lg-4 pt16 o_colored_level">
                                        <h2>
                                            <strong>Frequently asked questions</strong>
                                        </h2>
                                        <p class="lead">Here are some common questions about our company.</p>
                                    </div>
                                    <div class="col-lg-7 offset-lg-1 s_col_no_bgcolor" data-name="Accordion Box">
                                        <div data-name="Accordion" class="s_accordion">
                                            <div id="myCollapse" class="accordion-flush accordion">
                                                <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none" data-bs-toggle="collapse" aria-expanded="true" id="accordion-button207278_1" data-bs-target="#myCollapseTab207278_1" aria-controls="myCollapseTab207278_1">
                                                        <span class="flex-grow-1">What services does your company offer ?</span>
                                                    </button>
                                                    <div class="accordion-collapse collapse show" data-bs-parent="#myCollapse" role="region" id="myCollapseTab207278_1" aria-labelledby="accordion-button207278_1">
                                                        <div class="accordion-body">
                                                            <p>Our company specializes in consulting, product development, and customer support. We tailor our services to fit the unique needs of businesses across various sectors, helping them grow and succeed in a competitive market.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none collapsed" data-bs-toggle="collapse" aria-expanded="false" id="accordion-button207278_2" data-bs-target="#myCollapseTab207278_2" aria-controls="myCollapseTab207278_2">
                                                        <span class="flex-grow-1">How can I contact customer support ?</span>
                                                    </button>
                                                    <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab207278_2" aria-labelledby="accordion-button207278_2">
                                                        <div class="accordion-body">
                                                            <p>You can reach our customer support team by emailing info@yourcompany.example.com, calling +1 555-555-5556, or using the live chat on our website. Our dedicated team is available 24/7 to assist with any inquiries or issues.</p>
                                                            <p>We’re committed to providing prompt and effective solutions to ensure your satisfaction.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="accordion-item position-relative z-1" data-name="Accordion Item">
                                                    <button type="button" class="accordion-header accordion-button justify-content-between gap-2 bg-transparent h6-fs fw-bold text-decoration-none text-reset transition-none collapsed" data-bs-toggle="collapse" aria-expanded="false" id="accordion-button207278_3" data-bs-target="#myCollapseTab207278_3" aria-controls="myCollapseTab207278_3">
                                                        <span class="flex-grow-1">What is your return policy ?</span>
                                                    </button>
                                                    <div class="accordion-collapse collapse" data-bs-parent="#myCollapse" role="region" id="myCollapseTab207278_3" aria-labelledby="accordion-button207278_3">
                                                        <div class="accordion-body">
                                                            <p>We offer a 30-day return policy for all products. Items must be in their original condition, unused, and include the receipt or proof of purchase. Refunds are processed within 5-7 business days of receiving the returned item.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <record id="page_pricing" model="website.page">
        <field name="view_id" ref="view_page_pricing" />
        <field name="url">/pricing</field>
        <field name="website_id" ref="website_industry" />
        <field name="is_published" eval="True" />
        <field name="website_indexed" eval="True" />
    </record>
</odoo>