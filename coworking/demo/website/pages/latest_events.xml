<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_page_latest_events" model="ir.ui.view">
        <field name="name">Latest events</field>
        <field name="key">coworking.page_latest_events</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website_industry" />
        <field name="arch" type="xml">
            <t t-name="coworking.page_latest_events">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_image o_colored_level o_cc o_cc2 s_custom_snippet pt0 pb120" data-snippet="s_text_image" data-name="Custom Custom Text - Image">
                            <div class="container">
                                <div class="row o_grid_mode" style="gap: 30px 20px;" data-row-count="12">
                                    <div class="o_colored_level o_grid_item g-col-lg-10 g-height-3 col-lg-10" style="z-index: 1; grid-area: 2 / 2 / 5 / 12; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px;">
                                        <p style="text-align: center;">
                                            <span class="o_small-fs">
                                                <strong>
                                                    <span class="text-o-color-1">
                                                        <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">OUR COMMUNITY</span>
                                                    </span>
                                                </strong>
                                            </span>
                                            <br />
                                        </p>
                                        <h1 style="text-align: center;">
                                            <strong>
                                                <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">What’s Happening at Daylight</span>
                                            </strong>
                                            <br />
                                        </h1>
                                        <p style="text-align: center;" class="lead">
                                            <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">Moments that bring our sunlit community together for learning, connection, and a little celebration.</span>
                                            <br />
                                        </p>
                                    </div>
                                    <div class="o_colored_level o_grid_item o_grid_item_image rounded g-col-lg-10 col-lg-10 g-height-8" style="z-index: 2; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px; --box-border-bottom-left-radius: 30px; --box-border-bottom-right-radius: 30px; --box-border-top-right-radius: 30px; --box-border-top-left-radius: 30px; grid-area: 5 / 2 / 13 / 12;">
                                        <img src="/web/image/coworking.img_custom_image_24" alt="" class="img img-fluid mx-auto o_we_custom_image o_editable_media o_animate o_visible o_anim_zoom_out o_animated" style="--wanim-intensity: 15; visibility: visible; animation-play-state: running;" data-format-mimetype="image/webp" data-resize-width="1072" data-mimetype="image/webp" loading="eager" />
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_announcement_scroll s_announcement_scroll_hover_pause w-100 o_colored_level o_cc s_announcement_scroll_parallax s_custom_snippet pt40 pb40 o_cc4 s_announcement_scroll_direction_none" style="--marquee-animation-speed: 5s; --marquee-item-font-size: 40;" role="marquee" data-snippet="s_announcement_scroll" data-name="Custom Announcement Scroll">
                            <div class="s_announcement_scroll_marquee_container d-flex">
                                <div class="o_not_editable s_announcement_scroll_marquee_item lh-1">• Workshop • Talks • Social • Wellness</div>
                            </div>
                        </section>
                        <section data-snippet="s_events" class="s_events s_event_upcoming_snippet s_dynamic s_event_event_card o_colored_level o_cc o_cc2 pb112 pt104 o_dynamic_snippet_loading" data-custom-template-data="{&quot;events_event_time_active&quot;:false,&quot;events_event_location_active&quot;:true}" data-number-of-records="16" data-name="Events" data-filter-id="__EXPORT_FILTER_XMLID__website_event.website_snippet_filter_event_list__EXPORT_FILTER_XMLID__" data-template-key="website_event.dynamic_filter_template_event_event_card" data-extra-classes="g-3" data-column-classes="col-12 col-sm-6 col-lg-4 col-xxl-3">
                            <div class="s_dynamic_snippet_container container">
                                <div class="row s_nb_column_fixed">
                                    <section class="s_dynamic_snippet_holder d-none px-4 placeholder-glow o_colored_level">
                                        <div class="row">
                                            <span class="placeholder col-3 rounded" />
                                            <span class="placeholder col-2 offset-7 rounded" />
                                            <span class="placeholder mt-3 col-6 rounded" />
                                        </div>
                                        <div class="row mt-4">
                                            <span class="placeholder col-12 rounded" style="height: 250px;" />
                                        </div>
                                    </section>
                                    <section class="justify-content-between d-flex s_dynamic_snippet_title oe_unremovable oe_unmovable flex-column flex-md-row mb-lg-0 pb-3 pb-md-0 s_col_no_resize o_colored_level">
                                        <div>
                                            <p>
                                                <strong>
                                                    <span class="text-o-color-1">
                                                        <span style="--wanim-intensity: 15; animation-duration: 0.5s; visibility: visible; animation-play-state: running;" class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom o_small-fs o_animated">COMING SOON</span>
                                                    </span>
                                                </strong>
                                                <br />
                                            </p>
                                            <h2>
                                                <strong>Our latest events</strong>
                                            </h2>
                                            <p>
                                                <br />
                                            </p>
                                        </div>
                                    </section>
                                    <section class="s_dynamic_snippet_content oe_unremovable oe_unmovable o_not_editable col s_col_no_resize o_colored_level">
                                        <div class="css_non_editable_mode_hidden">
                                            <div class="missing_option_warning alert alert-info fade show d-none d-print-none rounded-0">
                                Your Dynamic Snippet will be displayed here... This message is displayed because you did not provide enough options to retrieve its content.<br />
                                            </div>
                                        </div>
                                        <div class="dynamic_snippet_template" />
                                    </section>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <record id="page_latest_events" model="website.page">
        <field name="view_id" ref="view_page_latest_events" />
        <field name="url">/latest-events</field>
        <field name="website_id" ref="website_industry" />
        <field name="is_published" eval="True" />
        <field name="website_indexed" eval="True" />
    </record>
</odoo>