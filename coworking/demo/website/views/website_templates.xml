<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo text-break border" t-ignore="true" t-if="not no_footer" style="border-color: rgba(41, 74, 58, 0.09) !important; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px;">
                    <section class="s_text_block pt48 s_parallax_no_overflow_hidden pb0" data-snippet="s_text_block" data-name="Container" style="position: relative;" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/14&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;o-color-3&quot;},&quot;flip&quot;:[&quot;y&quot;],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;}" data-scroll-background-ratio="0">
                        <div class="o_we_shape o_html_builder_Connections_14" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F14.svg?c5=%23F2F3EE&amp;flip=y&quot;); background-position: 50% 0%;"/>
                        <div class="container">
                            <div class="row">
                                <div class="pt24 o_colored_level col-lg-3 s_parallax_no_overflow_hidden pb48 o_animate o_anim_fade_in o_visible" data-scroll-background-ratio="0" style="animation-name: dummy;">
                                    <p>
                                        <img src="/web/image/coworking.img_custom_image_21" alt="" class="img img-fluid o_we_custom_image" loading="lazy" role="presentation"/>
                                    </p>
                                    <p>
                                        <font style="color: rgba(255, 255, 255, 0.66);">A top-floor coworking space built around natural light and the rhythm of a working day.</font>
                                    </p>
                                    <p>
                                        <font>
                                            <a href="/helpdesk" class="o_translate_inline">-&amp;gt; Report an issue</a>
                                        </font>
                                    </p>
                                </div>
                                <div class="pt24 o_colored_level s_parallax_no_overflow_hidden pb48 o_animate o_anim_fade_in o_visible offset-lg-4 col-lg-2" data-scroll-background-ratio="0" style="animation-name: dummy;">
                                    <p>
                                        <span class="o_small-fs">
                                            <strong>
                                                <font class="text-o-color-1">EXPLORE</font>
                                            </strong>
                                        </span>
                                        <br/>
                                    </p>
                                    <p>
                                        <a href="/" class="o_translate_inline">Home</a>
                                    </p>
                                    <p>
                                        <a href="/membership" class="o_translate_inline">Membership</a>
                                    </p>
                                    <p>
                                        <a href="/about" class="o_translate_inline">About</a>
                                    </p>
                                    <p>
                                        <a href="/latest-events" class="o_translate_inline">Events</a>
                                    </p>
                                    <p>
                                        <a class="o_translate_inline" href="/contactus">Contact</a>
                                    </p>
                                </div>
                                <div class="pt24 o_colored_level s_parallax_no_overflow_hidden pb48 o_animate o_anim_fade_in o_visible col-lg-3" data-scroll-background-ratio="0" style="animation-name: dummy;">
                                    <p>
                                        <span class="o_small-fs">
                                            <strong>
                                                <font class="text-o-color-1">CONTACT US</font>
                                            </strong>
                                        </span>
                                    </p>
                                    <p>Rue du Cardinal Mercier 8-2<br/>1000 Bruxelles<br/>Belgium</p>
                                    <p>
                                        <a class="o_translate_inline" href="mailto:hello@daylight.com">hello@daylight.com</a>
                                    </p>
                                    <p>
                                        <a class="o_translate_inline" href="tel:+3222903490">+32 2 290 34 90</a>
                                    </p>
                                </div>
                                <div class="pt24 s_parallax_no_overflow_hidden o_colored_level col-lg-12 border pb16 o_animate o_anim_fade_in o_visible" data-scroll-background-ratio="0" style="--box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; animation-name: dummy;">
                                    <p>
                                        <font style="color: rgba(255, 255, 255, 0.51);">© Copyright Daylight. All rights reserved.</font>
                                    </p>
                                </div>

                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="*tour_appointment*" class="oe_unremovable btn btn-primary btn_cta">Book a free tour</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
</odoo>
