<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Website menus - parent_id via search on root (url=#) -->
    <!-- Custom menu: Membership -->
    <record id="menu_membership" model="website.menu">
      <field name="name">Membership</field>
      <field name="url">/membership</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('coworking.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="1"/>
      <field name="is_visible" eval="True"/>
    </record>
    <!-- Custom menu: Events -->
    <record id="menu_events" model="website.menu">
      <field name="name">Events</field>
      <field name="url">/latest-events</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('coworking.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="3"/>
      <field name="is_visible" eval="True"/>
    </record>
    <!-- Default menu (rename/reorder): Contact -->
    <function name="write" model="website.menu">
      <value model="website.menu" search="[('url', '=', '/contactus'), ('website_id', '=', ref('coworking.website_industry'))]"/>
      <value eval="{'name': 'Contact', 'sequence': 4, 'is_visible': True}"/>
    </function>
    <!-- Custom menu: About -->
    <record id="menu_about" model="website.menu">
      <field name="name">About</field>
      <field name="url">/about</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('coworking.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="2"/>
      <field name="is_visible" eval="True"/>
    </record>
  </data>
</odoo>
