#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Appointment</font></strong>: Allow "
"prospects to book a free tour, shared desk, or meeting room online."
msgstr ""
"<strong><font class=\"text-o-color-1\">Appointment</font></strong>: Prospek "
"dapat secara mandiri menjadwalkan tur gratis, meja bersama, atau ruangan "
"meeting secara online."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">CRM &amp; Membership</font>: </"
"strong>Track and manage coworking opportunities, follow-up, and convert them "
"into active members."
msgstr ""
"<strong><font class=\"text-o-color-1\">CRM &amp; Keanggotaan</font>: </"
"strong>Lacak dan kelola peluang coworking, lakukan follow-up, dan ubah "
"menjadi anggota aktif."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Email Marketing</font></strong>: "
"Share news, updates, and promotions with your members."
msgstr ""
"<strong><font class=\"text-o-color-1\">Email Marketing</font></strong>: "
"Bagikan berita, kabar terbaru, dan promosi kepada anggota Anda."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Events</font>: </strong>Organize "
"networking sessions, workshops, and community-building activities."
msgstr ""
"<strong><font class=\"text-o-color-1\">Acara</font>: </strong>Selenggarakan "
"sesi jejaring, lokakarya, dan kegiatan pembinaan komunitas."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Helpdesk</font>: </strong>Handle "
"member requests and issues efficiently."
msgstr ""
"<strong><font class=\"text-o-color-1\">Helpdesk</font>: </strong>Tangani "
"permintaan dan masalah anggota secara efisien."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Planning</font>: </strong>Schedule "
"reception desk coverage and other staff shifts."
msgstr ""
"<strong><font class=\"text-o-color-1\">Perencanaan</font>: </"
"strong>Jadwalkan penugasan resepsionis dan shift staf lainnya."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Sales</font>: </strong>Generate and "
"manage quotations for memberships, room bookings, and services."
msgstr ""
"<strong><font class=\"text-o-color-1\">Sales</font>: </strong>Buat dan "
"kelola penawaran harga untuk keanggotaan, pemesanan ruangan, dan layanan."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Subscription</font>: </"
"strong>Automate recurring memberships such as Business Address or Unlimited "
"Monthly Access."
msgstr ""
"<strong><font class=\"text-o-color-1\">Langganan</font>: </"
"strong>Otomatiskan keanggotaan rutin seperti Alamat Bisnis atau Akses "
"Bulanan Tanpa Batas."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
