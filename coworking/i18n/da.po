#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Appointment</font></strong>: Allow "
"prospects to book a free tour, shared desk, or meeting room online."
msgstr ""
"<strong><font class=\"text-o-color-1\">Aftale</font></strong>: Tilbyd "
"interesserede en gratis rundvisning, et delt skrivebord eller et mødelokale "
"online."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">CRM &amp; Membership</font>: </"
"strong>Track and manage coworking opportunities, follow-up, and convert them "
"into active members."
msgstr ""
"<strong><font class=\"text-o-color-1\">CRM &amp; Medlemskab</font>: </"
"strong>Hold styr på samarbejdsmuligheder, bevar kontakten og gør dem til "
"aktive medlemmer."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Email Marketing</font></strong>: "
"Share news, updates, and promotions with your members."
msgstr ""
"<strong><font class=\"text-o-color-1\">E-mailmarketing</font></strong>: Del "
"nyheder, opdateringer og kampagner med dine medlemmer."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Events</font>: </strong>Organize "
"networking sessions, workshops, and community-building activities."
msgstr ""
"<strong><font class=\"text-o-color-1\">Arrangementer</font>: </"
"strong>Arrangér netværkssessioner, workshops og aktiviteter, der styrker "
"fællesskabet."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Helpdesk</font>: </strong>Handle "
"member requests and issues efficiently."
msgstr ""
"<strong><font class=\"text-o-color-1\">Kundeservice</font>: </"
"strong>Effektiv håndtering af medlemsanmodninger og problemer."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Planning</font>: </strong>Schedule "
"reception desk coverage and other staff shifts."
msgstr ""
"<strong><font class=\"text-o-color-1\">Planlægning</font>: </strong>Planlæg "
"bemandingen til receptionen samt øvrige personaleskift."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Sales</font>: </strong>Generate and "
"manage quotations for memberships, room bookings, and services."
msgstr ""
"<strong><font class=\"text-o-color-1\">Salg</font>: </strong>Generér og "
"håndtér tilbud på medlemskaber, lokaler og tjenester."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Subscription</font>: </"
"strong>Automate recurring memberships such as Business Address or Unlimited "
"Monthly Access."
msgstr ""
"<strong><font class=\"text-o-color-1\">Abonnement</font>: </"
"strong>Automatisér gentagne medlemskaber som f.eks. \"Forretningsadresser\" "
"eller \"Ubegrænset månedlig adgang\"."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Website</font>: </strong>Promote "
"coworking offers, showcase events, and provide member-exclusive tools and "
"support forms."
msgstr ""
"<strong><font class=\"text-o-color-1\">Hjemmeside</font>: </"
"strong>Markedsfør tilbud på kontorfællesskaber, og giv medlemmerne adgang "
"til eksklusive værktøjer og supportformularer."

