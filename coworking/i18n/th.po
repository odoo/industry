#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_membership
msgid ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">No lock-in, no setup fee. Move up or down a tier whenever your month "
"changes — billing catches up automatically.<br/>\n"
"                                    <br/>\n"
"                                    </span>"
msgstr ""

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_contactus
msgid ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">Whether you’re curious about memberships, booking a tour, or hosting an "
"event, we’d love to hear from you. Reach out with your questions and we’ll "
"help you find the right way to make Daylight part of your workday.</span>"
msgstr ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">ไม่ว่าคุณจะสนใจเรื่องการสมัครสมาชิก การจองทัวร์ หรือการจัดอีเวนต์ เราพร้อมรับฟังจากคุณเสมอ "
"ส่งคำถามของคุณมาให้เรา และเราจะช่วยคุณหาวิธีที่เหมาะสมเพื่อนำ Daylight "
"มาเป็นส่วนหนึ่งของวันทำงานของคุณ</span>"

