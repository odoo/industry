#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_about_us
msgid ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">A coworking space built around the sun with big east-facing windows, "
"plants,&amp;nbsp;<br/>and a floor that keeps time with the rhythm of your "
"working day.</span>"
msgstr ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">พื้นที่ทำงานร่วมกันที่ออกแบบให้สอดคล้องกับแสงแดด โดยมีหน้าต่างขนาดใหญ่หันไปทางทิศตะวันออก "
"พืชพรรณ&amp;nbsp;<br/>และพื้นที่ยืดหยุ่นตามจังหวะการทำงานของคุณ</span>"

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_home
msgid ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">A coworking space built around the sun — big east-facing windows, plants "
"everywhere, and a floor that keeps time with the rhythm of your working day."
"</span>"
msgstr ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">พื้นที่ทำงานร่วมกันที่ออกแบบมาเพื่อรับแสงแดด มีหน้าต่างขนาดใหญ่หันไปทางทิศตะวันออก "
"พืชพรรณอยู่ทุกหนทุกแห่ง และพื้นห้องที่ปรับจังหวะให้สอดคล้องกับจังหวะการทำงานของคุณตลอดทั้งวัน</"
"span>"

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_latest_events
