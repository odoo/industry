#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_about_us
msgid ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">A coworking space built around the sun with big east-facing windows, "
"plants,&amp;nbsp;<br/>and a floor that keeps time with the rhythm of your "
"working day.</span>"
msgstr ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">ພື້ນທີ່ Coworking ທີ່ອອກແບບມາເພື່ອຮັບແສງຕາເວັນ ພ້ອມປ່ອງຢ້ຽມຂະໜາດໃຫຍ່ຫັນໄປທາງທິດຕາເວັນອອກ, "
"ຕົ້ນໄມ້,&amp;nbsp;<br/>ແລະ ພື້ນທີ່ເຮັດວຽກທີ່ສອດຄ່ອງກັບຈັງຫວະຂອງມື້ເຮັດວຽກຂອງທ່ານ.</span>"

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_home
msgid ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">A coworking space built around the sun — big east-facing windows, plants "
"everywhere, and a floor that keeps time with the rhythm of your working day."
"</span>"
msgstr ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">ພື້ນທີ່ Coworking ທີ່ອອກແບບມາເພື່ອຮັບແສງຕາເວັນ — ປ່ອງຢ້ຽມຂະໜາດໃຫຍ່ຫັນໄປທາງທິດຕາເວັນອອກ, "
"ຕົ້ນໄມ້ຂຽວອຸ່ມທຸ່ມ, ແລະ ພື້ນທີ່ເຮັດວຽກທີ່ສອດຄ່ອງກັບຈັງຫວະຂອງມື້ເຮັດວຽກຂອງທ່ານ.</span>"

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_latest_events
msgid ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">Moments that bring our sunlit community together for learning, "
"connection, and a little celebration.</span>"
msgstr ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">ຊ່ວງເວລາທີ່ນຳພາຊຸມຊົນແຫ່ງແສງສະຫວ່າງຂອງພວກເຮົາ ມາພົບປະກັນເພື່ອຮຽນຮູ້, ສ້າງສາຍພົວພັນ ແລະ "
"ສະເຫຼີມສະຫຼອງຮ່ວມກັນ.</span>"

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_membership
msgid ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">No lock-in, no setup fee. Move up or down a tier whenever your month "
"changes — billing catches up automatically.<br/>\n"
"                                    <br/>\n"
"                                    </span>"
msgstr ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">ບໍ່ມີພັນທະຜູກມັດ, ບໍ່ມີຄ່າທຳນຽມເລີ່ມຕົ້ນ. ປັບຂຶ້ນ ຫຼື "
"ລົງລະດັບສະມາຊິກໄດ້ທຸກເມື່ອທີ່ຮູບແບບເດືອນຂອງທ່ານປ່ຽນແປງ — ລະບົບຈະຄິດໄລ່ເງິນຕາມຈິງໂດຍອັດຕະໂນມັດ."
"<br/>\n"
"                                    <br/>\n"
"                                    </span>"

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.view_page_contactus
msgid ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">Whether you’re curious about memberships, booking a tour, or hosting an "
"event, we’d love to hear from you. Reach out with your questions and we’ll "
"help you find the right way to make Daylight part of your workday.</span>"
msgstr ""
"<span class=\"o_animated_text o_animate o_anim_fade_in o_visible "
"o_anim_from_bottom\" style=\"--wanim-intensity: 15; animation-duration: 0.5s;"
"\">ບໍ່ວ່າທ່ານຈະສົນໃຈເລື່ອງສະມາຊິກ, ການຈອງເຂົ້າຊົມສະຖານທີ່, ຫຼື ການຈັດກິດຈະກຳ, "
"ພວກເຮົາພ້ອມສະເໝີທີ່ຈະຮັບຟັງ. ຕິດຕໍ່ສອບຖາມເຂົ້າມາໄດ້ເລີຍ ແລ້ວພວກເຮົາຈະຊ່ວຍແນະນຳວິທີທີ່ເໝາະສົມ ເພື່ອໃຫ້ "
"Daylight ເປັນສ່ວນໜຶ່ງໃນມື້ເຮັດວຽກຂອງທ່ານ.</span>"

