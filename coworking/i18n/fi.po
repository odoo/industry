#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Appointment</font></strong>: Allow "
"prospects to book a free tour, shared desk, or meeting room online."
msgstr ""
"<strong><font class=\"text-o-color-1\">Tapaaminen</font></strong>: Anna "
"potentiaalisten asiakkaiden varata ilmainen tutustumiskierros, jaettu "
"työpöytä tai kokoushuone verkossa."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">CRM &amp; Membership</font>: </"
"strong>Track and manage coworking opportunities, follow-up, and convert them "
"into active members."
msgstr ""
"<strong><font class=\"text-o-color-1\">CRM &amp; Jäsenyys</font>: </"
"strong>Seuraa ja hallinnoi yhteisöllisen työtilan potentiaalisia asiakkaita, "
"suorita seurantatoimia ja tee heistä aktiivisia jäseniä."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Email Marketing</font></strong>: "
"Share news, updates, and promotions with your members."
msgstr ""
"<strong><font class=\"text-o-color-1\">Sähköpostimarkkinointi</font></"
"strong>: Jaa uutisia, päivityksiä ja tarjouksia jäsenillesi."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Events</font>: </strong>Organize "
"networking sessions, workshops, and community-building activities."
msgstr ""
"<strong><font class=\"text-o-color-1\">Tapahtumat</font>: </strong>Järjestä "
"verkostoitumistilaisuuksia, työpajoja sekä yhteisöä vahvistavia tapahtumia."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Helpdesk</font>: </strong>Handle "
"member requests and issues efficiently."
msgstr ""
"<strong><font class=\"text-o-color-1\">Asiakaspalvelu</font>: </"
"strong>Käsittele jäsenten pyyntöjä ja ongelmia tehokkaasti."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Planning</font>: </strong>Schedule "
"reception desk coverage and other staff shifts."
msgstr ""
"<strong><font class=\"text-o-color-1\">Suunnittelu</font>: </"
"strong>Aikatauluta vastaanottotiskin sekä muun henkilöstön työvuorot."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Sales</font>: </strong>Generate and "
"manage quotations for memberships, room bookings, and services."
msgstr ""
"<strong><font class=\"text-o-color-1\">Myynti</font>: </strong>Luo ja "
"hallinnoi jäsenyyksien, huonevarausten ja palveluiden tarjouksia."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
msgid ""
"<strong><font class=\"text-o-color-1\">Subscription</font>: </"
"strong>Automate recurring memberships such as Business Address or Unlimited "
"Monthly Access."
msgstr ""
"<strong><font class=\"text-o-color-1\">Tilaus</font>: </strong>Automatisoi "
"toistuvat jäsenyydet, kuten Yrityksen osoite tai Rajaton kuukausikäyttö."

#. module: coworking
#: model_terms:ir.ui.view,arch_db:coworking.welcome_article_body
