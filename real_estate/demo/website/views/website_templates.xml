<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="priority">15</field>
        <field name="website_id" ref="property_listing.website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small">Copyright © Country</span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="property_listing.website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-right-width: 0px;">
                    <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="pt24 pb24 o_colored_level col-lg-3">
                                    <p>
                                        <img src="/web/image/real_estate.img_custom_image_21" alt="" class="img img-fluid o_we_custom_image" loading="lazy"/>
                                    </p>
                                    <p>
                                        <span class="o_small-fs">Buy, sell, and rent across the region's most livable neighborhoods, guided by advisors who know every street on the list.</span>
                                    </p>
                                </div>
                                <div class="pt24 pb24 o_colored_level offset-lg-1 col-lg-3">
                                    <p>
                                        <strong>
                                            <span class="text-o-color-1">Navigation</span>
                                        </strong>
                                        <br/>
                                    </p>
                                    <p>
                                        <a href="/" class="o_translate_inline">Home</a>
                                    </p>
                                    <p>
                                        <a href="/shop" class="o_translate_inline">Properties</a>
                                    </p>
                                    <p>
                                        <a href="/matchmaking" class="o_translate_inline">Matchmaking</a>
                                    </p>
                                </div>
                                <div class="pt24 pb24 o_colored_level col-lg-3 offset-lg-2">
                                    <p>
                                        <strong>
                                            <a href="/contactus" class="o_translate_inline btn btn-primary">Get a free estimate →</a>
                                        </strong>
                                        <br/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="property_listing.website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}" class="oe_structure oe_structure_solo">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-primary">Get a free estimate →</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
</odoo>
