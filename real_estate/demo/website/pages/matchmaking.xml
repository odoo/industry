<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The matchmaking form is generated with t-foreach over the matchmaking
        attributes, so it cannot sit inside an oe_structure: that would make the
        whole page non-editable. It stays outside instead, between an oe_structure
        holding the cover and an empty one below, so blocks can still be dropped
        above and under it.

        Every matchmaking widget posts under the same name, x_criteria_ids, and the
        server turns that into one id list ([(6, 0, ids)]). An empty value in that
        list breaks it, so the selects use value="_other" for their placeholder:
        form.js drops "_other" before submitting, whereas value="" would be sent
        as soon as another widget has already contributed a value.
    -->
    <record id="view_page_matchmaking" model="ir.ui.view">
        <field name="name">Matchmaking</field>
        <field name="key">real_estate.page_matchmaking</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="property_listing.website_industry"/>
        <field name="arch" type="xml">
            <t t-name="real_estate.page_matchmaking">
                <t t-call="website.layout">
                    <div id="wrap">
                        <div class="oe_structure oe_empty" id="oe_structure_page_matchmaking_1">
                            <section class="s_cover o_cc o_colored_level s_parallax_no_overflow_hidden oe_img_bg o_bg_img_center o_bg_img_origin_border_box o_cc1 s_custom_snippet pt112 pb128" data-scroll-background-ratio="0" data-snippet="s_cover" data-format-mimetype="image/webp" style="position: relative; background-image: url(&quot;/web/image/real_estate.img_custom_image_01&quot;);" data-name="Custom Custom Cover" data-resize-width="1920" data-mimetype="image/webp">
                                <div class="o_we_bg_filter " style="background-color: rgba(255, 255, 255, 0.96);"/>
                                <div class="s_allow_columns container">
                                    <div class="row">
                                        <div class="o_colored_level col-lg-8 offset-lg-2">
                                            <p style="text-align: center;">
                                                <span class="o_small-fs text-o-color-1">
                                                    <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">FILL IN THE FORM</span>
                                                </span>
                                                <br/>
                                            </p>
                                            <h1 style="text-align: center;">
                                                <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">
                                                    <span class="text-o-color-5">Be </span>
                                                    <span class="text-o-color-1">
                                                        <em>the first</em>
                                                    </span>
                                                    <span class="text-o-color-5"> to be notified</span>
                                                </span>
                                                <br/>
                                            </h1>
                                            <p class="lead" style="text-align: center;">
                                                <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">Don't miss our next opportunities</span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>
                        <section class="s_title_form o_cc pb48 o_colored_level pt48 o_cc1" data-snippet="s_title_form" data-name="Title - Form">
                            <div class="o_container_small">
                                <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                    <div class="container-fluid">
                                        <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="res.partner" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required col-lg-6" data-type="char" data-translated-name="Your Name">
                                                    <label class="s_website_form_label fw-bold mb-2" style="width: 600px;" for="otcqyb87y3zb">
                                                        <span class="s_website_form_label_content">Name</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="text" name="name" required="" placeholder="" id="otcqyb87y3zb" data-fill-with="name"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6 s_website_form_required" data-type="email" data-translated-name="Your Email">
                                                    <label class="s_website_form_label fw-bold mb-2" style="width: 600px;" for="oe36y3081le">
                                                        <span class="s_website_form_label_content">Email</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="email" name="email" required="" value="" placeholder="" id="oe36y3081le" data-fill-with="email"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="tel" data-translated-name="Phone Number">
                                                    <label class="s_website_form_label fw-bold mb-2" style="width: 600px;" for="omr724bsdzlk">
                                                        <span class="s_website_form_label_content">Phone Number</span>
                                                    </label>
                                                    <input class="form-control s_website_form_input" type="tel" name="phone" value="" placeholder="" id="omr724bsdzlk" data-fill-with="phone"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="many2many" data-translated-name="Categories">
                                                    <label class="s_website_form_label fw-bold mb-2" style="width: 600px" for="ocz1s97ohphe">
                                                        <span class="s_website_form_label_content">Categories</span>
                                                    </label>
                                                    <div class="row s_col_no_resize s_col_no_bgcolor s_website_form_multiple" data-name="x_categories_ids" data-display="horizontal">
                                                        <t t-set="category_values" t-value="request.env['product.public.category'].search([])"/>
                                                        <t t-foreach="category_values" t-as="category">
                                                            <div class="checkbox col-auto">
                                                                <div class="form-check">
                                                                    <input type="checkbox" class="s_website_form_input form-check-input" name="x_categories_ids" t-att-id="'category_' + str(category.id)" t-att-value="category.id"/>
                                                                    <label class="form-check-label s_website_form_check_label" t-att-for="'category_' + str(category.id)">
                                                                        <t t-out="category.name"/>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </div>
                                                <t t-set="attr_bathrooms" t-value="request.env.ref('real_estate.product_attribute_17', raise_if_not_found=False)"/>
                                                <t t-set="attr_rooms" t-value="request.env.ref('real_estate.product_attribute_16', raise_if_not_found=False)"/>
                                                <t t-set="attr_available" t-value="request.env.ref('real_estate.product_attribute_13', raise_if_not_found=False)"/>
                                                <t t-set="attr_pool" t-value="request.env.ref('real_estate.product_attribute_14', raise_if_not_found=False)"/>
                                                <t t-set="attr_others" t-value="request.env['product.attribute'].browse([a.id for a in [attr_available, attr_pool] if a and a.value_ids])"/>
                                                <t t-foreach="request.env['product.attribute'].search([('x_is_matchmaking', '!=', False)])" t-as="attr">
                                                    <t t-if="attr == attr_bathrooms or attr == attr_rooms">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="many2many" data-translated-name="Field">
                                                            <label class="s_website_form_label o-contenteditable-false fw-bold mb-2" style="width: 600px" t-attf-for="o_match_#{attr.id}">
                                                                <span class="s_website_form_label_content">
                                                                    <t t-out="attr.name"/>
                                                                </span>
                                                            </label>
                                                            <select class="form-select s_website_form_input" name="x_criteria_ids" t-attf-id="o_match_#{attr.id}">
                                                                <option value="_other" class="s_website_form_empty_option" selected="selected">Any</option>
                                                                <t t-foreach="attr.value_ids" t-as="att_value">
                                                                    <option t-att-value="att_value.id" t-out="att_value.name"/>
                                                                </t>
                                                            </select>
                                                        </div>
                                                    </t>
                                                    <t t-elif="attr not in attr_others">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="many2many" data-translated-name="Field">
                                                            <label class="s_website_form_label o-contenteditable-false fw-bold mb-2" style="width: 600px" t-attf-for="attrs_values#{attr.value_ids[:1].id}">
                                                                <span class="s_website_form_label_content">
                                                                    <t t-out="attr.name"/>
                                                                </span>
                                                            </label>
                                                            <div class="row s_col_no_resize s_col_no_bgcolor s_website_form_multiple" data-name="x_criteria_ids" data-display="horizontal">
                                                                <t t-foreach="attr.value_ids" t-as="att_value">
                                                                    <div class="checkbox col-12 col-md-2">
                                                                        <div class="form-check">
                                                                            <input type="checkbox" class="s_website_form_input form-check-input" name="x_criteria_ids" t-att-id="'attrs_values' + str(att_value.id)" t-att-value="att_value.id"/>
                                                                            <label class="form-check-label s_website_form_check_label" t-att-for="'attrs_values' + str(att_value.id)">
                                                                                <t t-out="att_value.name"/>
                                                                            </label>
                                                                        </div>
                                                                    </div>
                                                                </t>
                                                            </div>
                                                        </div>
                                                    </t>
                                                </t>
                                                <div t-if="attr_others" data-name="Field" class="s_website_form_field mb-3 col-12" data-type="many2many" data-translated-name="Field">
                                                    <label class="s_website_form_label o-contenteditable-false fw-bold mb-2" style="width: 600px" t-attf-for="o_match_#{attr_others[:1].id}">
                                                        <span class="s_website_form_label_content">Other</span>
                                                    </label>
                                                    <div class="row s_col_no_resize s_col_no_bgcolor s_website_form_multiple" data-name="x_criteria_ids" data-display="horizontal">
                                                        <t t-foreach="attr_others" t-as="attr">
                                                            <div class="checkbox col-auto">
                                                                <div class="form-check">
                                                                    <input type="checkbox" class="s_website_form_input form-check-input" name="x_criteria_ids" t-attf-id="o_match_#{attr.id}" t-att-value="attr.value_ids[:1].id"/>
                                                                    <label class="form-check-label s_website_form_check_label" t-attf-for="o_match_#{attr.id}">
                                                                        <t t-if="attr == attr_available">Available immediately</t>
                                                                        <t t-elif="attr == attr_pool">With a swimming pool</t>
                                                                        <t t-else="" t-out="attr.name"/>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="integer" data-translated-name="Field">
                                                    <label class="s_website_form_label fw-bold mb-2" style="width: 600px;" for="oo5b4p636tm">
                                                        <span class="s_website_form_label_content">Minimum price</span>
                                                    </label>
                                                    <input type="number" class="form-control s_website_form_input" step="1" name="x_min_price" placeholder="$0" id="oo5b4p636tm" data-fill-with="undefined"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="integer" data-translated-name="Field">
                                                    <label class="s_website_form_label fw-bold mb-2" style="width: 600px;" for="o5zl5q1ml68k">
                                                        <span class="s_website_form_label_content">Maximum price</span>
                                                    </label>
                                                    <input type="number" class="form-control s_website_form_input" step="1" name="x_max_price" placeholder="$0" id="o5zl5q1ml68k" data-fill-with="undefined"/>
                                                </div>
                                                <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-12 s_website_form_required" data-type="boolean" data-translated-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-sm-auto s_website_form_label d-none" style="width: 600px" for="opopfby60">
                                                            <span class="s_website_form_label_content">Notification</span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <div class="form-check">
                                                                <input type="checkbox" value="Yes" class="s_website_form_input form-check-input" name="x_subscribe" id="opopfby60" data-fill-with="undefined" required=""/>
                                                                <label class="form-check-label s_website_form_check_label" for="opopfby60">I want to be notified of each new property matching my criterias.</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                    <div style="width: 600px;" class="s_website_form_label">
                                                        <br/>
                                                    </div>
                                                    <span id="s_website_form_result"/>
                                                    <a href="#" role="button" class="btn btn-primary s_website_form_send o_translate_inline">Submit</a>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </section>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty" id="oe_structure_page_matchmaking_2"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_matchmaking" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_matchmaking"/>
            <field name="url">/matchmaking</field>
            <field name="website_id" ref="property_listing.website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
</odoo>
