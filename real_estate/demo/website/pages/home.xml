    <!-- Featured properties on the homepage -> /shop/<slug>-<product.template id> -->
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env.ref('real_estate.view_page_home').id"/>
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('real_estate.view_page_home').arch
            .replace('/shop/*cliff-house*', '/shop/cliff-house-%s' % obj().env.ref('real_estate.product_template_2').id)
            .replace('/shop/*yellow-bricks*', '/shop/yellow-bricks-%s' % obj().env.ref('real_estate.product_template_74').id)
            .replace('/shop/*river-side*', '/shop/river-side-%s' % obj().env.ref('real_estate.product_template_73').id)
            .replace('/shop/*old-roof*', '/shop/old-roof-%s' % obj().env.ref('real_estate.product_template_72').id)}"/>
    </function>
