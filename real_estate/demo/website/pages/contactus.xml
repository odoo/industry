<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_page_contactus" model="ir.ui.view">
        <field name="name">Contact Us</field>
        <field name="key">real_estate.page_contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="property_listing.website_industry"/>
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="real_estate.page_contactus">
                <t t-call="website.layout">
                    <t t-set="logged_partner" t-value="request.env['ir.http']._get_visitor_from_request().partner_id"/>
                    <t t-set="contactus_form_values" t-value="{'email_to': res_company.email,'name': request.params.get('name', ''),'phone': request.params.get('phone', ''),'email_from': request.params.get('email_from', ''),'company': request.params.get('company', ''),'subject': request.params.get('subject', ''),}"/>
                    <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values"/>
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_cover o_cc o_colored_level s_parallax_no_overflow_hidden oe_img_bg o_bg_img_center o_bg_img_origin_border_box o_cc1 s_custom_snippet pt112 pb128" data-scroll-background-ratio="0" data-snippet="s_cover" data-format-mimetype="image/webp" style="position: relative; background-image: url(&quot;/web/image/real_estate.img_custom_image_01&quot;);" data-resize-width="1920" data-mimetype="image/webp" data-name="Custom Custom Custom Cover">
                            <div class="o_we_bg_filter " style="background-color: rgba(255, 255, 255, 0.96);"/>
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="o_colored_level col-lg-8 offset-lg-2">
                                        <p style="text-align: center;">
                                            <span class="o_small-fs text-o-color-1">
                                                <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">FILL IN THE FORM</span>
                                            </span>
                                            <br/>
                                        </p>
                                        <h1 style="text-align: center;">
                                            <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom text-o-color-1" style="--wanim-intensity: 15; animation-duration: 0.5s;">
                                                <span style="color: #1c1c1c;">Get a&amp;nbsp;</span>
                                                <em>free estimate</em>
                                            </span>
                                            <br/>
                                        </h1>
                                        <p class="lead" style="text-align: center;">
                                            <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">Leave us your details and we'll reach you to organise an free visit&amp;nbsp;to estimate your property.</span>
                                            <br/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="s_text_block o_colored_level pt48 pb72" data-snippet="s_text_block" data-name="Text">
                            <div class="s_allow_columns container">
                                <div class="row">
                                    <div class="mt-4 mt-lg-0 o_colored_level col-lg-8 offset-lg-2 o_animate o_anim_fade_in o_visible" style="animation-name: dummy;">
                                        <p class="lead">
                                            <br/>
                                        </p>
                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <div class="container">
                                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="ovpa2ijswbe">
                                                                <span class="s_website_form_label_content">Your Name</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="contact_name" required="1" placeholder="" id="ovpa2ijswbe" data-fill-with="name"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required col-lg-6" data-type="email" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="objgkg613jm6">
                                                                <span class="s_website_form_label_content">Your Email</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="email" name="email_from" required="1" placeholder="" id="objgkg613jm6" data-fill-with="email"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 col-lg-6" data-type="tel" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="og5c4p9srdlh">
                                                                <span class="s_website_form_label_content">Phone Number</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="tel" name="phone" placeholder="" id="og5c4p9srdlh" data-fill-with="phone"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required col-lg-6" data-type="many2one" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="oslt4pk2b1cr">
                                                                <span class="s_website_form_label_content">Property Type</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <select class="form-select s_website_form_input" name="Property Type" required="1" id="oslt4pk2b1cr">
                                                                <option id="oslt4pk2b1cr0" value="House" selected="selected">House</option>
                                                                <option id="oslt4pk2b1cr1" value="Flat">Flat</option>
                                                                <option id="oslt4pk2b1cr2" value="Field">Field</option>
                                                                <option id="oslt4pk2b1cr3" value="Commercial Building">Commercial Building</option>
                                                                <option id="oslt4pk2b1cr4" value="Other">Other</option>
                                                            </select>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required col-lg-6" data-type="char" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="onpsl1dcwlyq">
                                                                <span class="s_website_form_label_content">Street &amp;amp; number</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="Street &amp; number" required="1" placeholder="" id="onpsl1dcwlyq" data-fill-with="undefined"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required col-lg-6" data-type="char" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="oc7j0q0njtn9">
                                                                <span class="s_website_form_label_content">City</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="City" required="1" placeholder="" id="oc7j0q0njtn9" data-fill-with="undefined"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required col-lg-6" data-type="char" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="ofx944tde2u7">
                                                                <span class="s_website_form_label_content">Zip Code</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="Zip Code" required="1" placeholder="" id="ofx944tde2u7" data-fill-with="undefined"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="many2one" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="oyb8mgm4h2db">
                                                                <span class="s_website_form_label_content">When do you want to sell ?</span>
                                                            </label>
                                                            <select class="form-select s_website_form_input" name="When do you want to sell ?" id="oyb8mgm4h2db">
                                                                <option id="oyb8mgm4h2db0" value="As soon as possible" selected="selected">As soon as possible</option>
                                                                <option id="oyb8mgm4h2db1" value="In less than 6 months">In less than 6 months</option>
                                                                <option id="oyb8mgm4h2db2" value="In less than 1 year">In less than 1 year</option>
                                                            </select>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="oy7pg7e0vg6c">
                                                                <span class="s_website_form_label_content">Subject</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <input class="form-control s_website_form_input" type="text" name="name" required="" placeholder="" id="oy7pg7e0vg6c" data-fill-with="undefined"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text" data-translated-name="Field">
                                                            <label class="s_website_form_label" style="width: 400px;" for="o5mtutqkqd9a">
                                                                <span class="s_website_form_label_content">Describe your goods in a few words</span>
                                                                <span class="s_website_form_mark"> *</span>
                                                            </label>
                                                            <textarea class="form-control s_website_form_input" name="description" required="1" placeholder="" id="o5mtutqkqd9a" rows="3"/>
                                                        </div>
                                                        <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 400px;">
                                                                    <span class="s_website_form_label_content"/>
                                                                </label>
                                                                <div class="col-sm">
                                                                    <input type="hidden" class="form-control s_website_form_input" name="team_id" value="*salesteam*"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                                                            <div style="width: 400px;" class="s_website_form_label"/>
                                                            <a href="#" role="button" class="s_website_form_send btn btn-primary">Get my estimate</a>
                                                            <span id="s_website_form_result"/>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <data noupdate="1">
        <record id="page_contactus" model="website.page" forcecreate="0">
            <field name="view_id" ref="view_page_contactus"/>
            <field name="url">/contactus</field>
            <field name="website_id" ref="property_listing.website_industry"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="True"/>
        </record>
    </data>
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().env.ref('real_estate.view_page_contactus').id"/>
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('real_estate.view_page_contactus').arch.replace(
            'value=&quot;*salesteam*&quot;', 'value=&quot;%s&quot;' % str(
                (team := obj().env.ref('sales_team.team_sales_department', raise_if_not_found=False)
                         or obj().env['crm.team'].search([], limit=1)) and team.id or 0))}"/>
    </function>
</odoo>
