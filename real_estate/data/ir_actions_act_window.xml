<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="owners_act_window" model="ir.actions.act_window">
        <field name="name">Owners</field>
        <field name="res_model">crm.lead</field>
        <field name="domain">[("x_interested_in_id", "=", False)]</field>
        <field name="view_mode">kanban,list,form,calendar,map,pivot,graph,activity,cohort</field>
    </record>
    <record id="sale.product_template_action" model="ir.actions.act_window" forcecreate="0">
        <field name="domain">[("sale_ok", "=", True), ("x_is_properties", "=", False)]</field>
    </record>
    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window" forcecreate="0">
        <field name="domain">[("x_interested_in_id", "=", False)]</field>
    </record>
    <record id="properties_act_window" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form,activity,map</field>
        <field name="domain">[("x_is_properties", "=", True)]</field>
        <field name="context" eval="{'default_categ_id': ref('property_listing.product_category_5', raise_if_not_found=False)}"/>
    </record>
    <record id="opportunities_act_window" model="ir.actions.act_window">
        <field name="name">Buyers</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,calendar,map,pivot,graph,activity,cohort</field>
        <field name="domain">[("x_interested_in_id", "!=", False)]</field>
    </record>
    <record id="staff_bookings_act_window" model="ir.actions.act_window">
        <field name="name">Staff Bookings</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">calendar,gantt,list,activity</field>
        <field name="view_id" ref="appointment.calendar_event_view_calendar"/>
    </record>
    <record id="attributes_act_window" model="ir.actions.act_window">
        <field name="name">Attributes</field>
        <field name="res_model">product.attribute</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="settings_act_window" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'brokerage'}</field>
    </record>
    <record id="crm_lead_sign_request_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">sign.request</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="sign.sign_request_view_search"/>
        <field name="domain">[('x_crm_lead_id', '=', active_id)]</field>
    </record>
    <record id="property_sign_request_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">sign.request</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="sign.sign_request_view_search"/>
        <field name="domain">[('x_property_id', '=', active_id)]</field>
    </record>
</odoo>
