#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.homepage
msgid "24/7 Property Search Assistance"
msgstr "Съдействие при търсене на имот 24/7"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
msgid ""
"<b>CRM App</b>: Manage your leads efficiently, tracking ongoing buying and "
"selling opportunities in a visual pipeline."
msgstr ""
"<b>Приложение CRM</b>: Управлявайте ефикасно потенциалните си клиенти, като "
"проследявате текущите възможности за покупка и продажба във визуален процес."

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.ir_ui_view_3154
msgid "<b>Designed</b> for companies"
msgstr "<b>Проектиран</b> за компании"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.ir_ui_view_3154
msgid ""
"<b>My Company</b><br/>250 Executive Park Blvd, Suite 3400 <br/> San "
"Francisco CA 94134 <br/>United States"
msgstr ""
"<b>Моята фирма</b><br/>250 Executive Park Blvd, Suite 3400 <br/> San "
"Francisco CA 94134 <br/>САЩ"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
msgid ""
"<b>Website App</b>: Drive qualified traffic by promoting your listings on a "
"beautiful, mobile-responsive real estate portal."
msgstr ""
"<b>Приложение Уебсайт</b>: Привличайте качествен трафик, като популяризирате "
"обявите си в красив портал за недвижими имоти, адаптиран за мобилни "
"устройства."

