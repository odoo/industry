msgid "24/7 Property Search Assistance"
msgstr "24/7 pomoč pri iskanju nepremičnin"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
#, fuzzy
msgid ""
"<b>CRM App</b>: Manage your leads efficiently, tracking ongoing buying and "
"selling opportunities in a visual pipeline."
msgstr ""
"<b>CRM aplikacija</b>: Učinkovito upravljajte svoje potencialne stranke in "
"spremljajte tekoče priložnosti za nakup in prodajo v vizualnem poteku."

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.ir_ui_view_3154
msgid "<b>Designed</b> for companies"
msgstr "<b>Zasnovan</b> za podjetja"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.ir_ui_view_3154
msgid ""
"<b>My Company</b><br/>250 Executive Park Blvd, Suite 3400 <br/> San "
"Francisco CA 94134 <br/>United States"
msgstr ""
"<b>Moje podjetje</b><br/>Slovenska cesta 1<br/> 1000 Ljubljana <br/>Slovenija"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
#, fuzzy
msgid ""
"<b>Website App</b>: Drive qualified traffic by promoting your listings on a "
"beautiful, mobile-responsive real estate portal."
msgstr ""
"<b>Spletna aplikacija</b>: Povečajte kakovosten promet z oglaševanjem svojih "
"oglasov na privlačnem, mobilno odzivnem nepremičninskem portalu."

