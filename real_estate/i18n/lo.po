#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.view_page_home
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.78);\">Browse verified listings "
"and flexible lease terms, with a smooth process from first viewing to move-"
"in day.</span>\n"
"                                            <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.78);"
"\">ເລືອກເບິ່ງລາຍການຊັບສິນທີ່ຜ່ານການກວດສອບແລ້ວ ແລະ ເງື່ອນໄຂການເຊົ່າທີ່ຍືດຫຍຸ່ນ "
"ພ້ອມຂັ້ນຕອນທີ່ສະດວກສະບາຍ ຕັ້ງແຕ່ການເຂົ້າຊົມຄັ້ງທຳອິດຈົນຮອດມື້ຍ້າຍເຂົ້າ.</span>\n"
"                                            <br/>"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.view_page_home
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.78);\">We match you with the "
"right home and negotiate transparent, competitive pricing — so you get real "
"value with no hidden costs or surprises.</span>\n"
"                                            <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.78);\">ພວກເຮົາຈັບຄູ່ທ່ານກັບເຮືອນທີ່ເໝາະສົມ "
"ແລະ ເຈລະຈາລາຄາທີ່ໂປ່ງໃສ, ສາມາດແຂ່ງຂັນໄດ້ — ເພື່ອໃຫ້ທ່ານໄດ້ຮັບຄຸນຄ່າທີ່ແທ້ຈິງ "
"ໂດຍບໍ່ມີຄ່າໃຊ້ຈ່າຍແອບແຝງ.</span>\n"
"                                            <br/>"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.view_page_home
msgid ""
"<span style=\"color: rgba(255, 255, 255, 0.78);\">We price your property "
"accurately and market it to serious buyers, helping you sell faster and for "
"the best possible return.</span>\n"
"                                            <br/>"
msgstr ""
"<span style=\"color: rgba(255, 255, 255, 0.78);"
"\">ພວກເຮົາກຳນົດລາຄາຊັບສິນຂອງທ່ານຢ່າງຊັດເຈນ ແລະ ເຮັດການຕະຫຼາດໄປຍັງຜູ້ຊື້ຕົວຈິງ, "
"ຊ່ວຍໃຫ້ທ່ານຂາຍໄດ້ໄວກວ່າເກົ່າ ແລະ ໄດ້ຮັບຜົນຕອບແທນທີ່ດີທີ່ສຸດ.</span>\n"
"                                            <br/>"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
msgid ""
"<strong><b>Appointments App</b>:</strong> Allow clients to book property "
"visits and consultations directly with agents, synchronizing calendars "
"automatically.<br/>"
msgstr ""
"<strong><b>ແອັບການນັດໝາຍ (Appointments)</b>:</strong> "
"ອະນຸຍາດໃຫ້ລູກຄ້ານັດໝາຍເຂົ້າເບິ່ງຊັບສິນ ແລະ ຂໍຄຳປຶກສາກັບຕົວແທນໄດ້ໂດຍກົງ, "
"ພ້ອມເຊື່ອມຕໍ່ປະຕິທິນໂດຍອັດຕະໂນມັດ.<br/>"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
msgid ""
"<strong><b>Properties App</b>:</strong> Organize your portfolio with a "
"dedicated app to manage property listings, details, and availability status."
"<br/>"
msgstr ""
"<strong><b>ແອັບອະສັງຫາລິມະຊັບ (Properties)</b>:</strong> "
"ຈັດລະບຽບລາຍການຊັບສິນຂອງທ່ານດ້ວຍແອັບສະເພາະ ເພື່ອຈັດການລາຍການປະກາດ, ລາຍລະອຽດ, ແລະ "
"ສະຖານະຄວາມພ້ອມ.<br/>"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
msgid ""
"<strong><b>Sales App</b>:</strong> Handle offers, negotiations, and closing "
"deals with professional quotations and digital signatures.<br/>"
msgstr ""
"<strong><b>ແອັບການຂາຍ (Sales)</b>:</strong> ຈັດການຂໍ້ສະເໜີ, ການເຈລະຈາ, ແລະ "
"ການປິດການຂາຍ ດ້ວຍໃບສະເໜີລາຄາແບບມືອາຊີບ ແລະ ລາຍເຊັນດິຈິຕອນ.<br/>"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
msgid "<strong><span class=\"h2-fs\">Tips for Success</span></strong>"
msgstr "<strong><span class=\"h2-fs\">ເຄັດລັບສູ່ຄວາມສຳເລັດ</span></strong>"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
msgid ""
"<strong>Automate your alerts:</strong> Matchmaking turns passive leads into "
"active buyers"
msgstr ""
"<strong>ຕັ້ງຄ່າການແຈ້ງເຕືອນອັດຕະໂນມັດ:</strong> "
"ລະບົບການຈັບຄູ່ຈະປ່ຽນລູກຄ້າມຸ່ງຫວັງທົ່ວໄປໃຫ້ກາຍເປັນຜູ້ຊື້ຕົວຈິງ"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
msgid ""
"<strong>Centralize documents:</strong> Use the Documents or Sign apps for "
"contracts and plans"
msgstr ""
"<strong>ລວມສູນເອກະສານ:</strong> ໃຊ້ແອັບ Documents ຫຼື Sign ສຳລັບສັນຍາ ແລະ ແຜນຜັງຕ່າງໆ"

#. module: real_estate
#: model_terms:ir.ui.view,arch_db:real_estate.welcome_article_body
msgid ""
"<strong>Commissions are managed in</strong> <em>Sales &gt; Commissions</em>. "
"You can add a commission plan and compute commissions for both the "
"<strong>Salesperson</strong> (the person who closed the deal) and the\n"
"                    <strong>Seller</strong> of the property."
msgstr ""
"<strong>ຄ່ານາຍໜ້າແມ່ນຖືກຈັດການຢູ່ໃນ</strong> <em>ການຂາຍ &gt; ຄ່ານາຍໜ້າ</em>. "
"ທ່ານສາມາດເພີ່ມແຜນຄ່ານາຍໜ້າ ແລະ ຄິດໄລ່ຄ່ານາຍໜ້າສຳລັບທັງ <strong>ພະນັກງານຂາຍ</strong> "
"(ຜູ້ທີ່ປິດການຂາຍ) ແລະ\n"
"                    <strong>ຜູ້ຂາຍ</strong> ຂອງອະສັງຫາລິມະຊັບດັ່ງກ່າວ."

